	passWall("W2", Vector3.new(ox + 140, 0, -486), NZ, 20, 6, "P10")
	pad("P10", 11, Vector3.new(ox + 140, 0.5, -500), NZ)
	-- 2일차 목표 깃발 셋 (22 v2 자유 스테이지): 그물 꼭대기 · 타잔 끝 · 낮은 벽 너머. 아무 순서, 다 밟으면 CP2 도착
	goalPoint("F_D2_NET", 2, Vector3.new(ox + 118, 14.6, -410), "그물")
	goalPoint("F_D2_TARZAN", 2, Vector3.new(ox + 132, 0, -468), "타잔")
