            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 퇴소 편지 (13_FINAL_LETTER): 칩 검증 + 자유 한 줄 필터(TextService). 필터 실패면 그 줄만 버리고 칩은 남긴다.
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CampScript = require(Shared:WaitForChild("CampScript"))

local LetterService = {}

local toIds: { [string]: boolean } = {}
for _, c in ipairs(CampScript.FinalLetter.toChips) do
	toIds[c.id] = true
end

export type Letter = { toId: string, chips: { string }, text: string? }

-- allowed: 이 플레이어에게 이번에 보여 준 칩 id (서버가 기록으로 만든 것만 받는다)
function LetterService.validate(toId: any, chips: any, allowed: { [string]: boolean }): (boolean, Letter?)
	if typeof(toId) ~= "string" or not toIds[toId] or typeof(chips) ~= "table" then
		return false, nil
	end
	local out = {}
	local seen: { [string]: boolean } = {}
	for _, c in ipairs(chips) do
		if typeof(c) ~= "string" or not allowed[c] or seen[c] then
			return false, nil
		end
		seen[c] = true
		table.insert(out, c)
		if #out > GameConfig.Letter.MaxChips then
			return false, nil
		end
	end
	if #out == 0 then
		return false, nil
	end
	return true, { toId = toId, chips = out, text = nil }
end

-- 자유 한 줄: 길이 제한 뒤 필터. 실패하면 (false, nil). 빈 문자열은 (true, nil)
function LetterService.filterFreeText(userId: number, text: any): (boolean, string?)
	if typeof(text) ~= "string" then
		return true, nil
	end
	local trimmed = string.gsub(text, "^%s+", "")
	trimmed = string.gsub(trimmed, "%s+$", "")
	if #trimmed == 0 then
		return true, nil
	end
	if utf8.len(trimmed) == nil or (utf8.len(trimmed) :: number) > GameConfig.Letter.FreeTextMaxChars then
		return false, nil
	end
	local ok, result = pcall(function()
		local r = TextService:FilterStringAsync(trimmed, userId)
		return r:GetNonChatStringForUserAsync(userId)
	end)
	if not ok or typeof(result) ~= "string" then
		return false, nil
	end
	-- 전부 #### 로 바뀐 경우는 쓰지 않는다
	if string.match(result, "^[#%s]+$") then
		return false, nil
	end
	return true, result
end

return LetterService
]]></string>
