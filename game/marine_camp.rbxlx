          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 소대 넷 + 교관. 수치는 1~3 (힘·박자·물·높이). 점수·호감도·성격 판정에 쓰지 않는다 (01_CONCEPT §4).
local Palette = require(script.Parent.Palette)

export type Member = {
	id: string,
	nameKo: string,
	emoji: string,
	power: number, -- 들기·밀기·노
	rhythm: number, -- NPC 박자 적중 확률
	water: number, -- 1 이면 파도에서 앞자리 힘 ×0.5
	height: number, -- 1 이면 그물벽에서 멈춤 (E 같이 가기)
	shirt: Color3,
	pants: Color3,
	scale: number,
}

local SquadCatalog = {}

SquadCatalog.Members = {
	ME = {
		id = "ME",
		nameKo = "나",
		emoji = "🧢",
		power = 2,
		rhythm = 2,
		water = 2,
		height = 2,
		shirt = Palette.Member.ME,
		pants = Palette.OliveDark,
		scale = 1,
	},
	DURI = {
		id = "DURI",
		nameKo = "두리",
		emoji = "🌊",
		power = 2,
		rhythm = 3,
		water = 1,
		height = 3,
		shirt = Palette.Member.DURI,
		pants = Palette.OliveDark,
		scale = 0.98,
	},
	SAN = {
		id = "SAN",
		nameKo = "산",
		emoji = "⛰️",
		power = 3,
		rhythm = 1,
		water = 3,
		height = 1,
		shirt = Palette.Member.SAN,
		pants = Palette.OliveDark,
		scale = 1.1,
	},
	MIR = {
		id = "MIR",
		nameKo = "미르",
		emoji = "🖍️",
		power = 1,
		rhythm = 3,
		water = 2,
		height = 3,
		shirt = Palette.Member.MIR,
		pants = Palette.OliveDark,
		scale = 0.94,
	},
} :: { [string]: Member }

SquadCatalog.NpcOrder = { "DURI", "SAN", "MIR" }
SquadCatalog.SeatKeys = { "FL", "FR", "BL", "BR" }
SquadCatalog.SeatNameKo = { FL = "앞왼", FR = "앞오", BL = "뒤왼", BR = "뒤오" }

SquadCatalog.Instructor = { id = "KANG", nameKo = "강찬 교관", emoji = "📣" }

function SquadCatalog.get(id: string): Member?
	return SquadCatalog.Members[id]
end

function SquadCatalog.isSeat(key: any): boolean
	return key == "FL" or key == "FR" or key == "BL" or key == "BR"
end

function SquadCatalog.isFront(key: string): boolean
	return key == "FL" or key == "FR"
end

function SquadCatalog.isLeft(key: string): boolean
	return key == "FL" or key == "BL"
end

-- 친구가 자리를 대신하면 그 친구의 수치는 플레이어처럼 입력으로 정해진다 (힘 2 기준)
function SquadCatalog.friendMember(slot: number): Member
	return {
		id = "FRIEND" .. slot,
		nameKo = "친구",
		emoji = "🤝",
		power = 2,
		rhythm = 2,
		water = 2,
		height = 2,
		shirt = Palette.Member.FRIEND,
		pants = Palette.OliveDark,
		scale = 1,
	}
end

return SquadCatalog
]]></string>
