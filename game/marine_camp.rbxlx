          <string name="Source"><![CDATA[--!strict
-- 극기캠프 팔레트: 올리브 천·모래 연병장·빨간 명찰·노란 구호·검은 유보트. 색만으로 정보를 주지 않는다 (글자·이모지 병기).
local Palette = {
	Olive = Color3.fromHex("5B6B3A"),
	OliveDark = Color3.fromHex("3E4A28"),
	Sand = Color3.fromHex("D9C79A"),
	Khaki = Color3.fromHex("B8A878"),
	Red = Color3.fromHex("C8373A"), -- 빨간 명찰
	Yellow = Color3.fromHex("F2C14E"), -- 구호·부표·현수막 글자
	Ink = Color3.fromHex("22262B"),
	Rubber = Color3.fromHex("1F2226"), -- 유보트
	Sea = Color3.fromHex("3C7FA6"),
	SeaFoam = Color3.fromHex("BFE3EE"),
	Mud = Color3.fromHex("6B5A43"),
	Fire = Color3.fromHex("F08A3C"),
	Cream = Color3.fromHex("F4ECD8"),
	Night = Color3.fromHex("141B2E"),
	Wood = Color3.fromHex("8B6A3F"),
	WoodDark = Color3.fromHex("5E4428"),
	Rope = Color3.fromHex("C9B18A"),
	Grass = Color3.fromHex("7FA35A"),
	Leaf = Color3.fromHex("4F7A3A"),
	Stone = Color3.fromHex("8E9299"),
	Skin = Color3.fromHex("F1C9A5"),
	Crab = Color3.fromHex("E0603C"),
	Firefly = Color3.fromHex("D7F56B"),
}

-- 분대원 셔츠 색 (이름·이모지와 함께 쓴다)
Palette.Member = {
	ME = Palette.Olive,
	DURI = Color3.fromHex("3F7FB5"),
	SAN = Color3.fromHex("8A5A36"),
	MIR = Color3.fromHex("9B6BB5"),
	FRIEND = Color3.fromHex("2E8B74"),
}

-- UI 제작값. 픽셀은 물리 크기가 아니므로 작은 화면에서 재확인한다.
-- 디자인 기준 (docs/design/19_UI_MAP_STYLE.md, 2026-10-19): 60 바탕(어두운 올리브 판·크림 글자) / 30 보조(나무·종이·모래)
-- / 10 강조(빨강 = 지금 누를 것 하나, 노랑 = 지금 볼 곳). 모서리: 큰 판 14 · 버튼·타일 12 · 알약 끝까지 둥글게.
Palette.UI = {
	BodyText = 20,
	SmallText = 16,
	TitleText = 28,
	ButtonMin = 56,
	Gap = 12,
	Padding = 16,
	Corner = 10,
	PanelCorner = 14,
	ButtonCorner = 12,
	Edge = 16, -- 화면 가장자리 여백
	Tile = 68, -- 오른쪽 위 아이콘 타일 한 변 (+8 = 76: 폰 최소 배율 0.58 에서도 44px)
	PanelTop = Color3.fromRGB(86, 101, 58),
	PanelBottom = Color3.fromRGB(54, 65, 36),
	PanelLine = Color3.fromRGB(38, 46, 25),
}

return Palette
]]></string>
