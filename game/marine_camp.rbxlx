	Boot = Color3.fromRGB(44, 40, 38),
}

-- ===== 결정적 난수 (멱등: 같은 seed → 같은 배치) =====
local function rng(seed: number): () -> number
	local s = math.floor(seed * 7919 + 17) % 2147483647
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

-- ===== 먼 언덕 (terrain 과 specs 가 같이 쓴다) =====
type Hill = { x: number, z: number, r: number, cy: number, rock: boolean? }
local HILLS: { Hill } = {
	-- 기지 뒤(남) · 양옆
	{ x = -210, z = 160, r = 70, cy = -40, rock = true },
	{ x = 215, z = 165, r = 65, cy = -38 },
	{ x = 0, z = 250, r = 60, cy = -30, rock = true },
	{ x = -130, z = 120, r = 35, cy = -26 },
	{ x = 140, z = 110, r = 35, cy = -26 },
	{ x = -230, z = -40, r = 60, cy = -34 },
	-- 동쪽(유격장 너머)
	{ x = 300, z = -120, r = 75, cy = -42, rock = true },
	{ x = 240, z = -280, r = 40, cy = -30 },
	{ x = 330, z = -430, r = 85, cy = -48, rock = true },
	{ x = 300, z = -720, r = 80, cy = -45 },
	{ x = 260, z = -1000, r = 90, cy = -55, rock = true },
	-- 바다 너머(남쪽 해안선)
	{ x = 60, z = -1190, r = 85, cy = -50, rock = true },
	{ x = -120, z = -1175, r = 80, cy = -46 },
	{ x = 160, z = -1100, r = 40, cy = -28 },
	-- 서쪽(숲 너머)
	{ x = -330, z = -900, r = 90, cy = -52, rock = true },
	{ x = -250, z = -700, r = 40, cy = -30 },
	{ x = -320, z = -560, r = 85, cy = -48 },
	{ x = -330, z = -400, r = 70, cy = -40, rock = true },
	{ x = -300, z = -250, r = 75, cy = -42 },
}

-- 언덕 위 표면 높이 추정 (복셀 양자화로 ±2 정도 틀릴 수 있다 → 줄기를 아래로 더 늘려 심는다)
local function hillY(x: number, z: number): number
	local best = 0
	for _, h in ipairs(HILLS) do
		local d = math.sqrt((x - h.x) ^ 2 + (z - h.z) ^ 2)
		if d < h.r then
			best = math.max(best, h.cy + math.sqrt(h.r ^ 2 - d ^ 2) + 1)
		end
	end
	return best
end

-- ===== 스펙 도우미 =====
local out: { Spec } = {}
local used: { [string]: boolean } = {}

-- 에셋 묶음 (에셋 1차): assetBegin ~ assetEnd 사이에 만든 파트 중 첫 파트가 앵커(AssetKey + 놓을 자리·크기),
-- 나머지는 AssetFallback = 앵커 id. LightingParts·속성으로 찾는 파트(Flag·Rope·WaveFoam…)는 묶지 않는다(늘 보임)
type AssetState = { anchor: string?, attrs: { [string]: any } }
local asset: AssetState? = nil
local function assetBegin(key: string, pos: Vector3, yawDeg: number, dims: { [string]: any })
	local a: { [string]: any } = { AssetKey = key, AssetPos = pos, AssetYaw = yawDeg }
	for k, v in pairs(dims) do
		a[k] = v
	end
	asset = { attrs = a }
end
local function assetEnd()
	asset = nil
end
-- 같은 id 는 늘 같은 변형·각도 (난수열을 쓰지 않아 기존 배치가 그대로)
local function variant(base: string, letters: string, id: string): string
	local i = CampAssets.pick(id, #letters) + 1
	return base .. "_" .. string.sub(letters, i, i)
end
local function yawOf(id: string): number
	return CampAssets.pick(id .. "#yaw", 360)
end
local function tagAsset(s: Spec, folder: string)
	local st = asset
	if not st or folder == "LightingParts" then
		return
	end
	local a: { [string]: any } = if s.attrs then table.clone(s.attrs) else {}
	if CampAssets.isLive(a) then
		return
	end
	if st.anchor == nil then
		st.anchor = s.id
		for k, v in pairs(st.attrs) do
			a[k] = v
		end
	else
		a.AssetFallback = st.anchor
	end
	s.attrs = a
end

local function part(
	id: string,
	folder: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	mat: Enum.Material,
	extra: { [string]: any }?
)
	local fid = "Art_" .. id
	if used[fid] then
		error("CampArt duplicate id " .. fid)
	end
	used[fid] = true
	local s: Spec = {
		id = fid,
		folder = folder,
		size = size,
		cframe = cf,
		color = color,
		material = mat,
		canCollide = false,
		clear = "drop",
	}
	if extra then
		for k, v in pairs(extra) do
			(s :: any)[k] = v
		end
	end
	tagAsset(s, folder)
	table.insert(out, s)
end

local function deco(id: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, extra: { [string]: any }?)
	part(id, "Decorations", size, cf, color, mat, extra)
end

local function yawCF(x: number, y: number, z: number, yawDeg: number): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yawDeg), 0)
end

local function rot(g: () -> number, amt: number): CFrame
	return CFrame.Angles((g() - 0.5) * amt, g() * math.pi * 2, (g() - 0.5) * amt)
end

-- ===== 자연물 =====
-- 바위 무더기 (3차): 크기 다른 각진 Block 2~3 을 각도 돌려 겹치고 큰 것 위에 작은 쐐기 하나. 2톤(Slate 청회 + 어두운 Basalt), 반쯤 묻음.
-- 공 모양은 쓰지 않는다 (멀리서 열매·회색 상자처럼 보였다 — 21_ride_03). 제일 큰 것만 충돌
local function rocksParts(id: string, x: number, z: number, scale: number, seed: number, collide: boolean?, y0: number?)
	local r = rng(seed)
	local n = 2 + (if r() < 0.5 then 1 else 0)
	local base = y0 or 0
	local bigTop = Vector3.new(x, base, z)
	local bigSize = Vector3.one
	local bigYaw = 0
	for i = 1, n do
		local big = i == 1
		local sx = scale * (if big then 3.0 + r() * 1.2 else 1.6 + r() * 1.4)
		local sy = scale * (if big then 1.9 + r() * 0.9 else 1.0 + r() * 0.8)
		local sz = scale * (if big then 2.4 + r() * 1.0 else 1.4 + r() * 1.2)
		local ang = r() * math.pi * 2
		local d = if big then 0 else scale * (1.6 + r() * 1.2)
		local yaw = r() * math.pi * 2
		-- 큰 판은 크게 기울여 깊이 묻는다 (땅에서 비스듬히 솟은 바위 — 반듯한 상자로 안 보이게)
		local pitch = if big then (0.32 + r() * 0.3) * (if r() < 0.5 then -1 else 1) else (r() - 0.5) * 0.7
		local cf = CFrame.new(x + math.cos(ang) * d, base + sy * (if big then 0.12 else 0.2), z + math.sin(ang) * d)
			* CFrame.Angles(0, yaw, 0)
			* CFrame.Angles(pitch, 0, (r() - 0.5) * 0.35)
		if big then
			bigTop = (cf * CFrame.new(0, sy / 2, 0)).Position
			bigSize = Vector3.new(sx, sy, sz)
			bigYaw = yaw
		end
		deco(
			string.format("%s_R%d", id, i),
			Vector3.new(sx, sy, sz),
			cf,
			if big then C.RockSlab else C.Basalt,
			if big then Enum.Material.Slate else Enum.Material.Basalt,
			{ canCollide = big and collide == true, class = if i == 2 then "WedgePart" else nil }
		)
	end
	-- 꼭대기 쐐기: 큰 덩어리 윗면에 비스듬히 (모서리가 깨진 실루엣)
	deco(
		id .. "_Cap",
		Vector3.new(bigSize.X * 0.8, bigSize.Y * 0.85, bigSize.Z * 0.7), -- 큰 쐐기로 판의 평평한 윗면을 깬다
		CFrame.new(bigTop - Vector3.new(0, bigSize.Y * 0.12, 0))
			* CFrame.Angles(0, bigYaw + math.rad(30 + r() * 60), 0)
			* CFrame.new(bigSize.X * 0.12, 0, 0),
		C.RockBlue,
		Enum.Material.Slate,
		{ class = "WedgePart" }
	)
end
-- 에셋: 바위 무더기 메시 (큰 판(R1)이 앵커 — 충돌은 그 기본 파트가 그대로 맡는다)
local function rocks(id: string, x: number, z: number, scale: number, seed: number, collide: boolean?, y0: number?)
	assetBegin(
		variant("RockCluster", "AB", id),
		Vector3.new(x, y0 or 0, z),
		yawOf(id),
		{ AssetWidth = 4.0 * scale, AssetSnap = true }
	)
	rocksParts(id, x, z, scale, seed, collide, y0)
	assetEnd()
end

-- 잔돌 하나
local function pebble(id: string, x: number, z: number, seed: number, y0: number?)
	local g = rng(seed)
	local s = 0.5 + g() * 0.7
	deco(
		id,
		Vector3.new(s * 1.4, s * 0.7, s),
		CFrame.new(x, (y0 or 0) + s * 0.2, z) * rot(g, 0.5),
		if g() < 0.5 then C.RockBlue else C.RockLight,
		Enum.Material.Slate
	)
end

-- 덤불: LeafyGrass 공 2~3
local function bushParts(id: string, x: number, z: number, scale: number, seed: number, y0: number?)
	local r = rng(seed)
	local n = 2 + math.floor(r() * 2)
	local base = y0 or 0
	for i = 1, n do
		local s = scale * (if i == 1 then 2.6 + r() * 0.8 else 1.6 + r() * 1.0)
		local ang = r() * math.pi * 2
		local d = if i == 1 then 0 else scale * (0.9 + r() * 0.8)
		deco(
			string.format("%s_B%d", id, i),
			Vector3.new(s, s * (0.75 + r() * 0.2), s),
			CFrame.new(x + math.cos(ang) * d, base + s * 0.3, z + math.sin(ang) * d) * rot(r, 0.4),
			if r() < 0.5 then C.Bush else C.LeafDeep,
			Enum.Material.LeafyGrass,
			{ shape = Enum.PartType.Ball }
		)
	end
end

-- 에셋: 덤불 메시 (첫 공이 앵커)
local function bush(id: string, x: number, z: number, scale: number, seed: number, y0: number?)
	assetBegin("Bush_A", Vector3.new(x, y0 or 0, z), yawOf(id), { AssetWidth = 4.6 * scale, AssetSnap = true })
	bushParts(id, x, z, scale, seed, y0)
	assetEnd()
end

-- 들풀 덩어리: 낮고 넓은 타원 1 (길 양옆·빈 땅 채우기)
local function tuftParts(id: string, x: number, z: number, scale: number, seed: number, y0: number?)
	local g = rng(seed)
	local s = scale * (2.2 + g() * 1.2)
	deco(
		id,
		Vector3.new(s, s * 0.38, s * (0.7 + g() * 0.3)),
		CFrame.new(x, (y0 or 0) + s * 0.08, z) * CFrame.Angles(0, g() * math.pi * 2, 0),
		if g() < 0.5 then C.Tuft else C.Tuft2,
		if g() < 0.6 then Enum.Material.LeafyGrass else Enum.Material.Grass,
		{ shape = Enum.PartType.Ball }
	)
end

-- 에셋: 풀 포기 메시
local function tuft(id: string, x: number, z: number, scale: number, seed: number, y0: number?)
	assetBegin("GrassTuft", Vector3.new(x, y0 or 0, z), yawOf(id), { AssetHeight = 1.5 * scale, AssetSnap = true })
	tuftParts(id, x, z, scale, seed, y0)
	assetEnd()
end

-- 그루터기: 밑동 + 밝은 단면
local function stumpParts(id: string, x: number, z: number, scale: number, y0: number?)
	local base = y0 or 0
	deco(
		id,
		Vector3.new(1.0 * scale, 1.6 * scale, 1.0 * scale),
		CFrame.new(x, base + 0.6 * scale, z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco(
		id .. "_Top",
		Vector3.new(0.1, 1.5 * scale, 1.5 * scale),
		CFrame.new(x, base + 1.1 * scale, z) * CFrame.Angles(0, 0, math.rad(90)),
		C.Driftwood,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder }
	)
end

-- 에셋: 그루터기 메시
local function stump(id: string, x: number, z: number, scale: number, y0: number?)
	assetBegin("Stump", Vector3.new(x, y0 or 0, z), yawOf(id), { AssetWidth = 1.9 * scale, AssetSnap = true })
	stumpParts(id, x, z, scale, y0)
	assetEnd()
end

-- 쓰러진 통나무: 기운 줄기 + 부러진 가지
local function fallenLogParts(id: string, x: number, z: number, len: number, yawDeg: number, y0: number?)
	local base = y0 or 0
	deco(
		id,
		Vector3.new(len, 1.3, 1.3),
		CFrame.new(x, base + 0.5, z) * CFrame.Angles(math.rad(4), math.rad(yawDeg), 0),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco(
		id .. "_Branch",
		Vector3.new(len * 0.3, 0.5, 0.5),
		CFrame.new(x, base + 1.2, z)
			* CFrame.Angles(0, math.rad(yawDeg), 0)
			* CFrame.new(len * 0.2, 0, 0)
			* CFrame.Angles(0, math.rad(40), math.rad(30)),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder }
	)
end

-- 에셋: 쓰러진 통나무 메시 (긴 축 X = 기본 파트 원통 축, 같은 yaw)
local function fallenLog(id: string, x: number, z: number, len: number, yawDeg: number, y0: number?)
	assetBegin("FallenLog", Vector3.new(x, y0 or 0, z), yawDeg, { AssetWidth = len * 1.05, AssetSnap = true })
	fallenLogParts(id, x, z, len, yawDeg, y0)
	assetEnd()
end

-- 원뿔 한 층: CornerWedgePart 4 장으로 사각뿔 (꼭짓점 = 로컬 (+X, 위, −Z) 모서리, Studio 실측 2026-10-21).
-- 넷의 꼭짓점을 가운데 축에 모으면 밑면 2r×2r 사각뿔 — 어느 쪽에서 봐도 삼각형 실루엣
-- (1차 시도 WedgePart 십자는 앞면이 직사각형으로 보여 윗면이 평평한 비석 같았다)
local function coneTier(
	id: string,
	cx: number,
	baseY: number,
	cz: number,
	r: number,
	h: number,
	yawOff: number,
	color: Color3
)
	for k = 1, 4 do
		local cf = CFrame.new(cx, baseY + h / 2, cz)
			* CFrame.Angles(0, yawOff + (k - 1) * (math.pi / 2), 0)
			* CFrame.new(-r / 2, 0, r / 2)
		deco(
			string.format("%s_%d", id, k),
			Vector3.new(r, h, r),
			cf,
			color,
			Enum.Material.LeafyGrass,
			{ class = "CornerWedgePart" }
		)
	end
end

-- 활엽수 (3차): 가늘고 어두운 줄기 2단(살짝 기움) + 가지 + 뿌리 혹 + 작은 잎 덩어리 6 (가장자리 울퉁불퉁, 아래 덩어리는 한 톤 어둡게).
-- far(언덕): 줄기 + 잎 2 = 3 파트
local function leafyTreeParts(id: string, x: number, z: number, s: number, seed: number, y0: number?, far: boolean?)
	local g = rng(seed)
	local base = y0 or 0
	local yaw = g() * math.pi * 2
	local tilt = (g() - 0.5) * 0.14
	local root = CFrame.new(x, base, z) * CFrame.Angles(0, yaw, 0)
	local lower = root * CFrame.Angles(tilt, 0, tilt * 0.6)
	local upper = root * CFrame.Angles(tilt * 2.4, 0, tilt * 1.5)
	local extra = if far then 5 else 0.6 -- 땅 아래로 (언덕 높이 오차)
	-- far 는 윗줄기(T2)가 없으므로 아랫줄기 하나가 잎까지 닿게 길게 (짧으면 언덕 위 잎이 떠 보였다 — 21_art_26)
	local t1h = if far then 6.6 * s else 3.4 * s
	part(
		id .. "_T1",
		"TerrainProps",
		Vector3.new(1.05 * s, t1h + extra, 1.05 * s),
		lower * CFrame.new(0, t1h / 2 - extra / 2, 0),
		C.Bark,
		Enum.Material.Wood,
		{ canCollide = not far }
	)
	local top = (upper * CFrame.new(0, 7.0 * s, 0)).Position
	if far then
		for i, l in ipairs({ { 5.6, 0, 0.6, 0, C.LeafDeep }, { 4.2, 1.6, 2.6, -0.9, C.Bush } }) do
			deco(
				string.format("%s_L%d", id, i),
				Vector3.new(l[1] * s, l[1] * s * 0.85, l[1] * s),
				CFrame.new(top + Vector3.new(l[2] * s, l[3] * s, l[4] * s)),
				l[5],
				Enum.Material.LeafyGrass,
				{ shape = Enum.PartType.Ball }
			)
		end
		return
	end
	part(
		id .. "_T2",
		"TerrainProps",
		Vector3.new(0.72 * s, 4.0 * s, 0.72 * s),
		upper * CFrame.new(0, 5.2 * s, 0),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	deco(
		id .. "_Br",
		Vector3.new(0.32 * s, 0.32 * s, 3.0 * s),
		upper
			* CFrame.new(0, 5.8 * s, 0)
			* CFrame.Angles(0, g() * math.pi * 2, 0)
			* CFrame.Angles(math.rad(-40), 0, 0)
			* CFrame.new(0, 0, -1.4 * s),
		C.Bark,
		Enum.Material.Wood
	)
	local a = g() * math.pi * 2
	deco(
		id .. "_Rt",
		Vector3.new(1.3 * s, 0.6 * s, 1.0 * s),
		CFrame.new(x + math.cos(a) * 0.7 * s, base + 0.15 * s, z + math.sin(a) * 0.7 * s) * CFrame.Angles(0, a, 0),
		C.Bark,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Ball }
	)
	-- 잎: 크기·높이 다르게 6 (x, y, z 오프셋은 꼭대기 기준 s 배). 아래 셋은 그림자 톤
	local leaves = {
		{ 3.8, 0, 1.5, 0.2, C.LeafBright },
		{ 3.4, 1.9, 0.6, 0.9, C.Bush },
		{ 3.2, -1.8, 0.5, -0.8, C.LeafBright },
		{ 3.0, 0.6, -0.6, -2.0, C.LeafShadow },
		{ 2.9, -0.8, -0.9, 1.9, C.LeafShadow },
		{ 2.6, 2.0, -1.0, -1.3, C.LeafDeep },
	}
	for i, l in ipairs(leaves) do
		deco(
			string.format("%s_L%d", id, i),
			Vector3.new(l[1] * s, l[1] * s * (0.8 + g() * 0.15), l[1] * s),
			CFrame.new(top + Vector3.new(l[2] * s, l[3] * s, l[4] * s)) * rot(g, 0.7),
			l[5],
			Enum.Material.LeafyGrass,
			{ shape = Enum.PartType.Ball }
		)
	end
end

-- 에셋: 활엽수 메시 2종 (줄기 T1 이 앵커 — 충돌은 그 기본 파트). 높이 = 기본 파트 잎 꼭대기
local function leafyTree(id: string, x: number, z: number, s: number, seed: number, y0: number?, far: boolean?)
	assetBegin(
		variant("TreeLeafy", "AB", id),
		Vector3.new(x, y0 or 0, z),
		yawOf(id),
		{ AssetHeight = (if far then 9.6 else 10.2) * s, AssetSnap = true }
	)
	leafyTreeParts(id, x, z, s, seed, y0, far)
	assetEnd()
end

-- 소나무 (3차): 원뿔 3층(쐐기 4장 십자, 층마다 45° 엇갈림, 아래 넓고 위 좁게) + 가는 줄기. 짙은 청록 2톤.
-- far(언덕): 줄기 + 쐐기 4장 한 층(긴 원뿔) = 5 파트
local function pineTreeParts(id: string, x: number, z: number, s: number, seed: number, y0: number?, far: boolean?)
	local g = rng(seed)
	local base = y0 or 0
	local extra = if far then 5 else 0.6
	local yaw0 = g() * math.pi
	part(
		id .. "_Trunk",
		"TerrainProps",
		Vector3.new(0.75 * s, 4.0 * s + extra, 0.75 * s),
		CFrame.new(x, base + 2.0 * s - extra / 2, z),
		C.Bark,
		Enum.Material.Wood,
		{ canCollide = not far }
	)
	if far then
		coneTier(id .. "_C", x, base + 1.6 * s, z, 2.4 * s, 9.0 * s, yaw0, C.PineA)
		return
	end
	-- { 밑면 반폭 r, 높이, 밑면 높이, 색 }
	local tiers = {
		{ 2.7, 4.6, 1.9, C.PineA },
		{ 2.1, 4.0, 4.6, C.PineB },
		{ 1.4, 3.8, 7.2, C.PineA },
	}
	for i, t in ipairs(tiers) do
		coneTier(
			string.format("%s_C%d", id, i),
			x,
			base + t[3] * s,
			z,
			t[1] * s,
			t[2] * s,
			yaw0 + (i - 1) * math.rad(45),
			t[4]
		)
	end
end

-- 에셋: 소나무 메시 2종 (줄기가 앵커)
local function pineTree(id: string, x: number, z: number, s: number, seed: number, y0: number?, far: boolean?)
	assetBegin(
		variant("TreePine", "AB", id),
		Vector3.new(x, y0 or 0, z),
		yawOf(id),
		{ AssetHeight = (if far then 10.6 else 11.0) * s, AssetSnap = true }
	)
	pineTreeParts(id, x, z, s, seed, y0, far)
	assetEnd()
end

-- 야자(해안): 휜 줄기 3단 + 잎 5 + 코코넛
local function palmTreeParts(id: string, x: number, z: number, s: number, seed: number, y0: number?)
	local g = rng(seed)
	local base = y0 or 0
	local yaw = g() * math.pi * 2
	local root = CFrame.new(x, base, z) * CFrame.Angles(0, yaw, 0)
	local topPos = Vector3.zero
	for i = 1, 3 do
		local lean = math.rad(5 + 7 * i)
		local cf = root
			* CFrame.new(0.32 * s * i * i * 0.5, 0.6 * s + 2.6 * s * (i - 1) + 1.3 * s, 0)
			* CFrame.Angles(0, 0, -lean)
		part(
			string.format("%s_T%d", id, i),
			"TerrainProps",
			Vector3.new((1.1 - 0.1 * i) * s, 2.9 * s, (1.1 - 0.1 * i) * s),
			cf,
			if i % 2 == 0 then C.BarkLight else Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = i == 1 }
		)
		topPos = (cf * CFrame.new(0, 1.45 * s, 0)).Position
	end
	for i = 1, 5 do
		local a = (i - 1) * (math.pi * 2 / 5) + g() * 0.5
		deco(
			string.format("%s_F%d", id, i),
			Vector3.new(0.7 * s, 0.22 * s, 5.0 * s),
			CFrame.new(topPos)
				* CFrame.Angles(0, a, 0)
				* CFrame.Angles(math.rad(-26 - g() * 10), 0, math.rad((g() - 0.5) * 20))
				* CFrame.new(0, 0, -2.3 * s),
			if i % 2 == 0 then C.LeafBright else Color3.fromRGB(96, 160, 70),
			Enum.Material.Grass
		)
	end
	deco(
		id .. "_Nut",
		Vector3.new(1.0 * s, 0.8 * s, 1.0 * s),
		CFrame.new(topPos + Vector3.new(0.3 * s, -0.5 * s, 0.2 * s)),
		C.Coconut,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Ball }
	)
end

-- 에셋: 야자 메시
local function palmTree(id: string, x: number, z: number, s: number, seed: number, y0: number?)
	assetBegin("TreePalm_A", Vector3.new(x, y0 or 0, z), yawOf(id), { AssetHeight = 9.8 * s, AssetSnap = true })
	palmTreeParts(id, x, z, s, seed, y0)
	assetEnd()
end

-- 군락: 나무 3~5(활엽·소나무 섞음) + 덤불 2 + 바위 1 + 들풀 3 (숲 가장자리·빈 땅 모서리)
local function grove(id: string, x: number, z: number, seed: number, n: number, pineRatio: number)
	local g = rng(seed)
	for i = 1, n do
		local a = g() * math.pi * 2
		local d = if i == 1 then 0 else 5 + g() * 9
		local px, pz = x + math.cos(a) * d, z + math.sin(a) * d
		local s = 0.9 + g() * 0.5
		if g() < pineRatio then
			pineTree(string.format("%s_P%d", id, i), px, pz, s, seed * 10 + i, hillY(px, pz))
		else
			leafyTree(string.format("%s_T%d", id, i), px, pz, s, seed * 10 + i, hillY(px, pz))
		end
	end
	for i = 1, 2 do
		local a = g() * math.pi * 2
		local d = 9 + g() * 6
		bush(
			string.format("%s_B%d", id, i),
			x + math.cos(a) * d,
			z + math.sin(a) * d,
			0.8 + g() * 0.4,
			seed * 10 + 7 + i
		)
	end
	local ra = g() * math.pi * 2
	rocks(id .. "_R", x + math.cos(ra) * 12, z + math.sin(ra) * 12, 0.9, seed * 10 + 9, true)
	for i = 1, 3 do
		local a = g() * math.pi * 2
		local d = 6 + g() * 10
		tuft(string.format("%s_G%d", id, i), x + math.cos(a) * d, z + math.sin(a) * d, 1, seed * 10 + 20 + i)
	end
end

-- ===== 사람이 만든 것 =====
-- 만국기 줄: 두 점 사이 처진 밧줄(8조각) + 작은 삼각천 (Flag → 클라이언트 펄럭임). 크림·빨강·크림·올리브 (빨강은 작게만)
local function pennantLine(id: string, a: Vector3, b: Vector3, sag: number, count: number)
	local n = 8
	local function pt(t: number): Vector3
		return a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
	end
	for i = 1, n do
		local p0, p1 = pt((i - 1) / n), pt(i / n)
		deco(
			string.format("%s_Rope%d", id, i),
			Vector3.new(0.08, 0.08, (p1 - p0).Magnitude + 0.05),
			CFrame.lookAt((p0 + p1) / 2, p1),
			Palette.Rope,
			Enum.Material.Fabric
		)
	end
	local flat = (b - a) * Vector3.new(1, 0, 1)
	local seq = { Palette.Cream, Palette.Red, Palette.Cream, Palette.Olive }
	for i = 1, count do
		local p = pt((i - 0.5) / count)
		deco(
			string.format("%s_Pennant%d", id, i),
			Vector3.new(0.06, 0.9, 0.7),
			CFrame.lookAt(p - Vector3.new(0, 0.5, 0), p - Vector3.new(0, 0.5, 0) + flat.Unit),
			seq[(i - 1) % 4 + 1],
			Enum.Material.Fabric,
			{ attrs = { Flag = true } }
		)
	end
end

-- 등 줄: 두 기둥 사이 처진 밧줄 + 작은 등 n (Lighting_Parts → 밤에만 켜짐)
local function lanternString(id: string, a: Vector3, b: Vector3, count: number)
	local function pt(t: number): Vector3
		return a:Lerp(b, t) - Vector3.new(0, 1.2 * 4 * t * (1 - t), 0)
	end
	for i = 1, 6 do
		local p0, p1 = pt((i - 1) / 6), pt(i / 6)
		deco(
			string.format("%s_Rope%d", id, i),
			Vector3.new(0.08, 0.08, (p1 - p0).Magnitude + 0.05),
			CFrame.lookAt((p0 + p1) / 2, p1),
			Palette.Rope,
			Enum.Material.Fabric
		)
	end
	for i = 1, count do
		local p = pt((i - 0.5) / count) - Vector3.new(0, 0.5, 0)
		part(
			string.format("%s_Lamp%d", id, i),
			"LightingParts",
			Vector3.new(0.5, 0.6, 0.5),
			CFrame.new(p),
			Palette.Yellow,
			Enum.Material.Neon,
			{ light = { color = C.LanternWarm, range = 9, brightness = 0.9 } }
		)
	end
end

-- 등불 기둥: 나무 기둥 + 팔 + 매단 등(Lighting_Parts → 낮엔 회색 유리, 밤엔 노란 네온 — CourseFx.setLamps)
local function lanternPost(id: string, x: number, z: number, h: number, yawDeg: number, y0: number?)
	local cf = yawCF(x, y0 or 0, z, yawDeg)
	part(
		id .. "_Post",
		"Buildings",
		Vector3.new(0.35, h, 0.35),
		cf * CFrame.new(0, h / 2, 0),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ clear = "push", group = "Art_" .. id }
	)
	deco(
		id .. "_Arm",
		Vector3.new(0.22, 0.22, 1.6),
		cf * CFrame.new(0, h - 0.25, 0.7),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ clear = "push", group = "Art_" .. id }
	)
	deco(
		id .. "_Cap",
		Vector3.new(1.0, 0.14, 1.0),
		cf * CFrame.new(0, h - 0.6, 1.35),
		Palette.Ink,
		Enum.Material.Metal,
		{ clear = "push", group = "Art_" .. id }
	)
	part(
		id .. "_Lamp",
		"LightingParts",
		Vector3.new(0.66, 0.9, 0.66),
		cf * CFrame.new(0, h - 1.15, 1.35),
		Palette.Yellow,
		Enum.Material.Neon,
		{
			light = { color = C.LanternWarm, range = 16, brightness = 1.3 },
			clear = "push",
			group = "Art_" .. id,
		}
	)
end

-- 밧줄 울타리: 말뚝 n + 밧줄 1 (구역 경계·길 안내)
local function ropeFence(id: string, a: Vector3, b: Vector3, posts: number)
	local dir = (b - a).Unit
	for i = 1, posts do
		local p = a:Lerp(b, (i - 1) / (posts - 1))
		deco(
			string.format("%s_P%d", id, i),
			Vector3.new(0.35, 2.3, 0.35),
			CFrame.new(p.X, p.Y + 1.15, p.Z),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	local mid = (a + b) / 2
	deco(
		id .. "_Rope",
		Vector3.new(0.14, 0.14, (b - a).Magnitude),
		CFrame.lookAt(Vector3.new(mid.X, mid.Y + 1.95, mid.Z), Vector3.new(mid.X, mid.Y + 1.95, mid.Z) + dir),
		Palette.Rope,
		Enum.Material.Fabric,
		{ attrs = { Rope = true } }
	)
end

local function crateParts(id: string, x: number, y: number, z: number, s: number, yawDeg: number)
	deco(id, Vector3.new(s, s, s), yawCF(x, y + s / 2, z, yawDeg), Palette.Wood, Enum.Material.WoodPlanks, {
		canCollide = y < 0.1,
	})
end

local function barrelParts(id: string, x: number, z: number, color: Color3?, y0: number?)
	local y = (y0 or 0) + 1.1
	deco(
		id,
		Vector3.new(2.2, 1.9, 1.9),
		CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)),
		color or Palette.Olive,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco(
		id .. "_Band",
		Vector3.new(0.6, 2.0, 2.0),
		CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Ink,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Cylinder }
	)
end

-- 에셋: 나무 상자·드럼통 메시 (파란 통은 물 드럼)
local function crate(id: string, x: number, y: number, z: number, s: number, yawDeg: number)
	-- 메시 상자는 세로로 긴 꼴(1.25×2×1.25) → 높이를 기본 정육면체에 맞춘다 (쌓인 상자가 겹치지 않게)
	assetBegin("Crate", Vector3.new(x, y, z), yawDeg, { AssetHeight = s, AssetSnap = y < 0.1 })
	crateParts(id, x, y, z, s, yawDeg)
	assetEnd()
end
local function barrel(id: string, x: number, z: number, color: Color3?, y0: number?)
	assetBegin(
		if color == Palette.Sea then "BarrelBlue" else "Barrel",
		Vector3.new(x, y0 or 0, z),
		yawOf(id),
		{ AssetHeight = 2.2, AssetSnap = true }
	)
	barrelParts(id, x, z, color, y0)
	assetEnd()
end

-- 통나무 더미 3 (한 곳에 정리)
local function woodpileParts(id: string, x: number, z: number, yawDeg: number, y0: number?)
	for i, o in ipairs({ { -0.7, 0.45 }, { 0.7, 0.45 }, { 0, 1.25 } }) do
		deco(
			string.format("%s_%d", id, i),
			Vector3.new(3.0, 0.9, 0.9),
			yawCF(x, (y0 or 0) + o[2], z, yawDeg) * CFrame.new(0, 0, o[1]),
			if i == 3 then Palette.Wood else Palette.WoodDark,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, canCollide = i < 3 }
		)
	end
end

-- 에셋: 장작 더미 메시 (통나무 축 X, 같은 yaw)
local function woodpile(id: string, x: number, z: number, yawDeg: number, y0: number?)
	-- 메시 더미는 통나무 축이 Z (긴 변 X 가 더미 폭) → 기본 파트(통나무 축 X)와 맞추려 90° 더 돌린다
	assetBegin("FirewoodPile", Vector3.new(x, y0 or 0, z), yawDeg + 90, { AssetWidth = 3.0, AssetSnap = true })
	woodpileParts(id, x, z, yawDeg, y0)
	assetEnd()
end

-- 삼각대 + 주전자 (모닥불 위. 의자는 1단계 CampfireService 가 FIRE 둘레 5.2 에 만든다 — 여기선 안 만든다)
local function tripod(id: string, x: number, z: number, y0: number?)
	local base = y0 or 0
	for i = 1, 3 do
		local a = math.rad(i * 120)
		deco(
			string.format("%s_Leg%d", id, i),
			Vector3.new(0.18, 3.6, 0.18),
			CFrame.new(x + math.cos(a) * 1.0, base + 1.7, z + math.sin(a) * 1.0)
				* CFrame.Angles(math.sin(a) * 0.32, 0, -math.cos(a) * 0.32),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	deco(id .. "_Kettle", Vector3.new(1.0, 0.9, 1.0), CFrame.new(x, base + 2.0, z), Palette.Ink, Enum.Material.Metal, {
		shape = Enum.PartType.Ball,
	})
end

-- 모래주머니 둑 (2단)
local function sandbagWall(id: string, x: number, z: number, yawDeg: number, cols: number)
	for r = 1, 2 do
		for c = 1, cols - (r - 1) do
			deco(
				string.format("%s_%d_%d", id, r, c),
				Vector3.new(2.1, 0.85, 1.25),
				yawCF(x, 0.42 + (r - 1) * 0.8, z, yawDeg)
					* CFrame.new((c - (cols - r + 2) / 2) * 2.2, 0, 0)
					* CFrame.Angles(0, math.rad((c + r) * 5), 0),
				if (c + r) % 2 == 0 then Palette.Khaki else Color3.fromRGB(172, 158, 114),
				Enum.Material.Fabric,
				{ canCollide = true }
			)
		end
	end
end

-- 천막 꾸밈 (Bootstrap tent(id,x,z,w,l,h) 위에 겹친다): 처진 능선 2, 지붕 겹침 2, 말뚝 4, 입구 돗자리 2, 신발 n켤레, 랜턴 걸이 2
local function tentDress(
	id: string,
	x: number,
	z: number,
	w: number,
	l: number,
	h: number,
	y0: number?,
	pairs_: number?,
	canvas: Color3?
)
	local base = y0 or 0
	local roofLen = math.sqrt((w / 2) ^ 2 + h ^ 2) + 0.6
	local ang = math.atan2(h, w / 2)
	-- 처진 능선: 양 끝(h+0.15)에서 가운데(h-0.35)로 내려오는 두 조각
	for i, sz in ipairs({ -1, 1 }) do
		local p0 = Vector3.new(x, base + h + 0.15, z + sz * (l / 2 + 0.4))
		local p1 = Vector3.new(x, base + h - 0.35, z)
		deco(
			string.format("%s_Sag%d", id, i),
			Vector3.new(0.5, 0.5, (p1 - p0).Magnitude),
			CFrame.lookAt((p0 + p1) / 2, p1),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	-- 지붕 겹침: 각 면 아래 절반에 한 톤 어두운 천 한 장(0.25 바깥으로)
	for i, sx in ipairs({ -1, 1 }) do
		local mid = CFrame.new(x + sx * w / 4, base + h / 2, z) * CFrame.Angles(0, 0, -sx * ang)
		deco(
			string.format("%s_Over%d", id, i),
			Vector3.new(roofLen * 0.52, 0.14, l + 0.3),
			mid * CFrame.new(sx * roofLen * 0.24, 0.26, 0),
			canvas or C.CanvasDark,
			Enum.Material.Fabric
		)
	end
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		deco(
			string.format("%s_Peg%d", id, i),
			Vector3.new(0.3, 0.7, 0.3),
			CFrame.new(x + c[1] * (w / 2 + 2.3), base + 0.3, z + c[2] * (l / 2 - 0.3))
				* CFrame.Angles(0, 0, math.rad(-c[1] * 25)),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	-- 입구 돗자리 (앞 = +z) + 줄무늬
	local fz = z + l / 2 + 1.6
	deco(
		id .. "_Mat",
		Vector3.new(w * 0.6, 0.08, 2.4),
		CFrame.new(x, base + 0.04, fz),
		Palette.Khaki,
		Enum.Material.Fabric
	)
	deco(
		id .. "_MatStripe",
		Vector3.new(w * 0.6, 0.09, 0.5),
		CFrame.new(x, base + 0.045, fz),
		Palette.Cream,
		Enum.Material.Fabric
	)
	-- 신발: 돗자리 앞줄에 나란히
	local n = pairs_ or 2
	for i = 1, n do
		local bx = x - (n - 1) * 0.8 + (i - 1) * 1.6
		for j, dx in ipairs({ -0.32, 0.32 }) do
			deco(
				string.format("%s_Boot%d_%d", id, i, j),
				Vector3.new(0.45, 0.38, 0.95),
				CFrame.new(bx + dx, base + 0.19, fz + 1.7) * CFrame.Angles(0, math.rad((i - 1) * 4), 0),
				C.Boot,
				Enum.Material.SmoothPlastic
			)
		end
	end
	-- 랜턴 걸이: 앞 오른쪽 기둥에 팔 + 등
	local px, pz = x + (w / 2 - 0.3), z + (l / 2 - 0.3)
	deco(
		id .. "_Hook",
		Vector3.new(0.18, 0.18, 1.1),
		CFrame.new(px, base + h - 0.6, pz + 0.55),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	part(
		id .. "_Lamp",
		"LightingParts",
		Vector3.new(0.5, 0.7, 0.5),
		CFrame.new(px, base + h - 1.25, pz + 1.0),
		Palette.Yellow,
		Enum.Material.Neon,
		{ light = { color = C.LanternWarm, range = 12, brightness = 1.0 } }
	)
end

-- 빨랫줄: 기둥 둘 + 줄 + 수건(Flag → 펄럭임)
local function clothesline(id: string, a: Vector3, b: Vector3, towels: number)
	for i, p in ipairs({ a, b }) do
		part(
			string.format("%s_Post%d", id, i),
			"Buildings",
			Vector3.new(0.3, 4.4, 0.3),
			CFrame.new(p.X, 2.2, p.Z),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	local mid = (a + b) / 2
	deco(
		id .. "_Line",
		Vector3.new(0.06, 0.06, (b - a).Magnitude),
		CFrame.lookAt(Vector3.new(mid.X, 4.1, mid.Z), Vector3.new(b.X, 4.1, b.Z)),
		Palette.Rope,
		Enum.Material.Fabric
	)
	local dir = (b - a).Unit
	local cols = { Palette.Cream, Palette.Olive, Palette.Khaki, Palette.Cream }
	for i = 1, towels do
		local p = a + (b - a) * ((i - 0.5) / towels)
		deco(
			string.format("%s_Towel%d", id, i),
			Vector3.new(0.08, 1.7, 1.1),
			CFrame.lookAt(Vector3.new(p.X, 3.25, p.Z), Vector3.new(p.X, 3.25, p.Z) + dir),
			cols[(i - 1) % 4 + 1],
			Enum.Material.Fabric,
			{ attrs = { Flag = true } }
		)
	end
end

-- 표지판: 기둥 + 화살표 판 (SignText 는 SquadPresence 가 그린다)
local function signpost(id: string, x: number, z: number, yawDeg: number, boards: { { text: string, left: boolean } })
	part(
		id .. "_Post",
		"Buildings",
		Vector3.new(0.4, 4.6, 0.4),
		CFrame.new(x, 2.3, z),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	for i, b in ipairs(boards) do
		deco(
			string.format("%s_Board%d", id, i),
			Vector3.new(3.6, 0.9, 0.18),
			yawCF(x, 4.2 - (i - 1) * 1.1, z, yawDeg) * CFrame.new(if b.left then -1.5 else 1.5, 0, 0.3),
			Palette.Cream,
			Enum.Material.Wood,
			{ attrs = { SignText = b.text, SignBothSides = true } }
		)
	end
end

-- 관중석 통나무 벤치 한 줄 (통나무 n 개, 반쯤 묻어 앉을 높이)
local function logRow(id: string, x: number, z: number, yawDeg: number, n: number, y0: number?)
	for i = 1, n do
		-- 에셋: 통나무 의자 메시 (한 개씩)
		local c = yawCF(x, y0 or 0, z, yawDeg) * CFrame.new((i - (n + 1) / 2) * 8.2, 0, 0)
		assetBegin("LogSeat", c.Position, yawDeg, { AssetHeight = 1.35, AssetSnap = true })
		deco(
			string.format("%s_%d", id, i),
			Vector3.new(7.5, 1.3, 1.3),
			yawCF(x, (y0 or 0) + 0.55, z, yawDeg) * CFrame.new((i - (n + 1) / 2) * 8.2, 0, 0),
			if i % 2 == 0 then Palette.Wood else Palette.WoodDark,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, canCollide = true }
		)
		assetEnd()
	end
end

-- 그늘막: 기둥 4 + 처진 천 2 장(가운데로 기울임) + 가운데 줄
local function canopy(id: string, x: number, z: number, w: number, l: number, yawDeg: number, y0: number?)
	local base = y0 or 0
	local cf = yawCF(x, base, z, yawDeg)
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		part(
			string.format("%s_Post%d", id, i),
			"Buildings",
			Vector3.new(0.35, 5.2, 0.35),
			cf * CFrame.new(c[1] * w / 2, 2.6, c[2] * l / 2),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	for i, sx in ipairs({ -1, 1 }) do
		deco(
			string.format("%s_Cloth%d", id, i),
			Vector3.new(w / 2 + 0.4, 0.12, l + 0.6),
			cf * CFrame.new(sx * w / 4, 4.75, 0) * CFrame.Angles(0, 0, sx * math.rad(9)),
			if i == 1 then Palette.Khaki else Palette.Cream,
			Enum.Material.Fabric
		)
	end
	deco(id .. "_Line", Vector3.new(0.1, 0.1, l + 1), cf * CFrame.new(0, 4.45, 0), Palette.Rope, Enum.Material.Fabric)
end

-- 물통 테이블: 나무 상판 + 물통 + 컵
local function waterTable(id: string, x: number, z: number, yawDeg: number, y0: number?)
	local base = y0 or 0
	local cf = yawCF(x, base, z, yawDeg)
	deco(id .. "_Top", Vector3.new(4.2, 0.3, 1.6), cf * CFrame.new(0, 1.9, 0), Palette.Wood, Enum.Material.WoodPlanks, {
		canCollide = true,
	})
	deco(id .. "_Leg", Vector3.new(3.6, 1.75, 1.0), cf * CFrame.new(0, 0.87, 0), Palette.WoodDark, Enum.Material.Wood)
	deco(
		id .. "_Jug",
		Vector3.new(1.1, 1.5, 1.1),
		cf * CFrame.new(-1.1, 2.8, 0),
		Palette.Sea,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder }
	)
	deco(
		id .. "_Cups",
		Vector3.new(1.4, 0.4, 0.7),
		cf * CFrame.new(0.9, 2.25, 0.2),
		Palette.Cream,
		Enum.Material.SmoothPlastic
	)
end

local function driftwood(id: string, x: number, z: number, len: number, yawDeg: number, y0: number?)
	deco(
		id,
		Vector3.new(len, 0.8, 0.8),
		CFrame.new(x, (y0 or 0) + 0.25, z) * CFrame.Angles(math.rad(6), math.rad(yawDeg), math.rad(4)),
		C.Driftwood,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder }
	)
	deco(
		id .. "_Branch",
		Vector3.new(len * 0.35, 0.4, 0.4),
		CFrame.new(x, (y0 or 0) + 0.5, z)
			* CFrame.Angles(0, math.rad(yawDeg + 50), math.rad(20))
			* CFrame.new(len * 0.2, 0, 0),
		C.Driftwood,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder }
	)
end

local function shell(id: string, x: number, z: number, seed: number, y0: number?)
	local g = rng(seed)
	deco(
		id,
		Vector3.new(0.7, 0.35, 0.55),
		CFrame.new(x, (y0 or 0) + 0.15, z) * CFrame.Angles(0, g() * math.pi * 2, 0),
		if g() < 0.6 then C.Shell else Color3.fromRGB(226, 206, 186),
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Ball }
	)
end

-- 물웅덩이(갯바위 틈): 유리 원판 + 조개 2 + 해초
local function tidePool(id: string, x: number, z: number, r: number, seed: number, y0: number?)
	local g = rng(seed)
	local base = y0 or 0
	deco(
		id .. "_Water",
		Vector3.new(0.12, r * 2, r * 1.5),
		CFrame.new(x, base + 0.08, z) * CFrame.Angles(0, g() * math.pi, math.rad(90)),
		C.WaterVivid,
		Enum.Material.Glass,
		{ shape = Enum.PartType.Cylinder, transparency = 0.3 }
	)
	for i = 1, 2 do
		local a = g() * math.pi * 2
		shell(string.format("%s_Shell%d", id, i), x + math.cos(a) * r * 0.8, z + math.sin(a) * r * 0.6, seed + i, y0)
	end
	for i = 1, 2 do
		local a = g() * math.pi * 2
		deco(
			string.format("%s_Weed%d", id, i),
			Vector3.new(0.25, 1.2 + g() * 0.8, 0.5),
			CFrame.new(x + math.cos(a) * r * 1.1, base + 0.6, z + math.sin(a) * r * 0.8)
				* CFrame.Angles(math.rad((g() - 0.5) * 30), a, math.rad((g() - 0.5) * 30)),
			C.Seaweed,
			Enum.Material.Grass
		)
	end
end

-- 바위 주변 거품 띠 (WaveFoam → 출렁임)
local function foamRing(id: string, x: number, z: number, r: number)
	deco(
		id,
		Vector3.new(0.1, r * 2, r * 2),
		CFrame.new(x, -0.85, z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.SeaFoam,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, transparency = 0.55, attrs = { WaveFoam = true } }
	)
end

-- 반딧불 무리 (Firefly → 떠다님 + 초록 빛)
local function fireflies(id: string, x: number, z: number, n: number, seed: number)
	local g = rng(seed)
	for i = 1, n do
		deco(
			string.format("%s_%d", id, i),
			Vector3.new(0.3, 0.3, 0.3),
			CFrame.new(x + (g() - 0.5) * 10, 2.5 + g() * 3, z + (g() - 0.5) * 10),
			Palette.Firefly,
			Enum.Material.Neon,
			{ shape = Enum.PartType.Ball, attrs = { Firefly = true } }
		)
	end
end

-- 들꽃 무더기: 잎 + 크림 꽃 3 (노랑·빨강은 신호색이라 안 쓴다)
local function flowers(id: string, x: number, z: number, seed: number)
	local g = rng(seed)
	deco(
		id .. "_Leaf",
		Vector3.new(1.6, 0.5, 1.6),
		CFrame.new(x, 0.2, z),
		C.LeafBright,
		Enum.Material.LeafyGrass,
		{ shape = Enum.PartType.Ball }
	)
	for i = 1, 3 do
		local a = g() * math.pi * 2
		deco(
			string.format("%s_F%d", id, i),
			Vector3.new(0.35, 0.35, 0.35),
			CFrame.new(x + math.cos(a) * 0.5, 0.55 + g() * 0.2, z + math.sin(a) * 0.5),
			if i == 2 then Palette.Member.MIR else Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Ball }
		)
	end
end

-- 발자국 자국: 어두운 타원 (길 위 다져진 느낌)
local function footprints(id: string, a: Vector3, b: Vector3, n: number, seed: number)
	local g = rng(seed)
	local dir = (b - a).Unit
	local right = dir:Cross(Vector3.yAxis)
	for i = 1, n do
		local p = a:Lerp(b, (i - 0.5) / n) + right * ((g() - 0.5) * 3)
		deco(
			string.format("%s_%d", id, i),
			Vector3.new(2.2 + g() * 1.4, 0.05, 1.3 + g() * 0.8),
			CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, g() * math.pi, 0),
			C.DirtDark,
			Enum.Material.Ground,
			{ shape = Enum.PartType.Ball, transparency = 0.35 }
		)
	end
end

-- 길 양옆 채우기: a→b 선을 따라 양쪽 off 만큼 떨어져 들풀·잔돌 번갈아
local function roadside(id: string, a: Vector3, b: Vector3, off: number, n: number, seed: number, y0: number?)
	local g = rng(seed)
	local dir = (b - a).Unit
	local right = dir:Cross(Vector3.yAxis)
	for i = 1, n do
		local side = if i % 2 == 0 then 1 else -1
		local p = a:Lerp(b, (i - 0.5) / n) + right * (side * (off + g() * 3))
		if g() < 0.65 then
			tuft(string.format("%s_G%d", id, i), p.X, p.Z, 0.8 + g() * 0.5, seed + i, y0)
		else
			pebble(string.format("%s_S%d", id, i), p.X, p.Z, seed + i, y0)
		end
	end
end

