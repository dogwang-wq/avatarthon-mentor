        </Item>
        <Item class="ModuleScript" referent="6215">
          <Properties>
            <string name="Name">RateLimiter</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{B1D46854-0E48-4CEA-A243-0DA7534603BE}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 토큰 버킷. 초과는 드롭과 집계부터 시작하고 곧바로 제재하지 않는다.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Bucket = { tokens: number, last: number, perSec: number, burst: number, dropped: number }

function RateLimiter.newBucket(perSec: number, burst: number): Bucket
	return { tokens = burst, last = os.clock(), perSec = perSec, burst = burst, dropped = 0 }
end

function RateLimiter.take(b: Bucket): boolean
	local now = os.clock()
	b.tokens = math.min(b.burst, b.tokens + (now - b.last) * b.perSec)
	b.last = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	b.dropped += 1
	return false
end

return RateLimiter
]]></string>
            <int64 name="SourceAssetId">-1</int64>
