	local function trainTrigger(id: string, pos: Vector3, dir: Vector3)
		add({
			id = "TRAIN_" .. id,
			folder = "Triggers",
			size = Vector3.new(6, 6, 6),
			cframe = facing(pos + Vector3.new(0, 3, 0), dir),
			transparency = 1,
			canCollide = false,
			attrs = { Kind = K.TRAIN or "TRAIN", TrainId = id }, -- Edit 모드 require 캐시로 옛 SceneBindings 가 잡히면 K.TRAIN 이 nil (Studio 2026-10-19)
		})
		deco(
			"TrainMark_" .. id,
			Vector3.new(0.2, 4.5, 4.5),
			CFrame.new(pos.X, pos.Y + 0.33, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Palette.Yellow,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, transparency = 0.45 }
		)
	end
	-- 철봉 3단 (높이 다름) — 플레이어는 가운데 봉 앞에 선다
	for i, h in ipairs({ 5.5, 6.5, 7.5 }) do
		local x = 78 + (i - 1) * 4
		box(
			"Gym_PullPost" .. i .. "a",
			"TerrainProps",
			Vector3.new(0.4, h, 0.4),
			at(x - 1.6, h / 2, 34),
			Palette.Stone,
			Enum.Material.Metal
		)
		box(
			"Gym_PullPost" .. i .. "b",
			"TerrainProps",
			Vector3.new(0.4, h, 0.4),
			at(x + 1.6, h / 2, 34),
			Palette.Stone,
			Enum.Material.Metal
		)
		box(
			"Gym_PullBar" .. i,
			"TerrainProps",
			Vector3.new(3.6, 0.25, 0.25),
			at(x, h, 34),
			Palette.Ink,
