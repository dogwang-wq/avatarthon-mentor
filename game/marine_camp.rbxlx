              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 퇴소식: n기 수료 카드, 유보트 흔적·배지 모두 보기, "🧢 다시 입소 / 🏕️ 기지에서 놀기".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local EndingPanel = {}
local C2S = ProtocolTypes.ClientToServer
local S = ProtocolTypes.SessionState

local gui = UiKit.screen("CampEnding", 36)
gui.Enabled = false
local modal = UiKit.modal(gui, "Ending", 460)
UiKit.pad(modal, 18)
UiKit.list(modal, nil, 10)
local title = UiKit.label(modal, "", 28, true, Palette.Red)
title.TextXAlignment = Enum.TextXAlignment.Center
title.LayoutOrder = 1
local motto = UiKit.label(modal, CampScript.Motto, 22, true)
motto.TextXAlignment = Enum.TextXAlignment.Center
motto.LayoutOrder = 2
local photoHint = UiKit.label(modal, CampScript.Graduate.photoHint, 15, false, Palette.WoodDark)
photoHint.TextXAlignment = Enum.TextXAlignment.Center
photoHint.LayoutOrder = 3
local stickers = UiKit.label(modal, "", 16)
stickers.LayoutOrder = 4
local badgesTitle = UiKit.label(modal, "🏅 뱃지", 16, true)
badgesTitle.LayoutOrder = 5
-- 뱃지 아이템 칸 (21 6단계, M061): 얻은 것은 메달(ViewportFrame 3D)과 이름, 못 얻은 것은 빈칸 + "어떻게" 한 줄 (23_BADGES)
local grid = Instance.new("Frame")
grid.Name = "BadgeGrid"
grid.BackgroundTransparency = 1
grid.Size = UDim2.fromScale(1, 0)
grid.AutomaticSize = Enum.AutomaticSize.Y
grid.LayoutOrder = 6
grid.Parent = modal
local gridLayout = Instance.new("UIGridLayout")
gridLayout.CellSize = UDim2.new(0.5, -6, 0, 64)
gridLayout.CellPadding = UDim2.fromOffset(12, 8)
gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
gridLayout.Parent = grid

-- 메달 하나를 ViewportFrame 에 그린다: 금색 원판 + 빨간 리본 (Part 로 만든 모델 — 이미지 자산 없이)
local function medal(parent: Instance, earned: boolean): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromOffset(56, 56)
	vp.Position = UDim2.fromOffset(4, 4)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(190, 190, 190)
	vp.LightColor = Color3.new(1, 1, 1)
	vp.LightDirection = Vector3.new(-1, -2, -1)
	vp.Parent = parent
	local cam = Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam
	local wm = Instance.new("WorldModel")
	wm.Parent = vp
	local disc = Instance.new("Part")
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.3, 2, 2)
	disc.Color = if earned then Color3.fromRGB(230, 184, 70) else Color3.fromRGB(150, 150, 150)
	disc.Material = if earned then Enum.Material.Metal else Enum.Material.SmoothPlastic
	disc.Transparency = if earned then 0 else 0.6
	disc.Anchored = true
	disc.CFrame = CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(90))
	disc.Parent = wm
	local rim = Instance.new("Part")
	rim.Shape = Enum.PartType.Cylinder
	rim.Size = Vector3.new(0.2, 1.3, 1.3)
	rim.Color = if earned then Color3.fromRGB(255, 220, 120) else Color3.fromRGB(170, 170, 170)
	rim.Material = Enum.Material.SmoothPlastic
	rim.Transparency = disc.Transparency
	rim.Anchored = true
	rim.CFrame = disc.CFrame * CFrame.new(0.12, 0, 0)
	rim.Parent = wm
	local ribbon = Instance.new("Part")
	ribbon.Size = Vector3.new(0.9, 1.4, 0.15)
	ribbon.Color = if earned then Palette.Red else Color3.fromRGB(160, 160, 160)
	ribbon.Material = Enum.Material.Fabric
	ribbon.Transparency = disc.Transparency
	ribbon.Anchored = true
	ribbon.CFrame = CFrame.new(0, 1.5, -0.1)
	ribbon.Parent = wm
	cam.CFrame = CFrame.lookAt(Vector3.new(0.6, 0.9, 4.6), Vector3.new(0, 0.5, 0))
	return vp
end

local tiles: { [string]: Frame } = {}
local function buildTiles(have: { [string]: boolean })
	for _, t in pairs(tiles) do
		t:Destroy()
	end
	tiles = {}
	for i, id in ipairs(CampScript.BadgeOrder) do
		local earned = have[id] == true
		local tile = Instance.new("Frame")
		tile.BackgroundColor3 = if earned then Palette.Cream else Palette.Sand
		tile.BackgroundTransparency = if earned then 0 else 0.35
		tile.BorderSizePixel = 0
		tile.LayoutOrder = i
		tile.Parent = grid
		UiKit.corner(tile, 10)
		UiKit.stroke(tile, if earned then Palette.WoodDark else Palette.Olive, 1.5, if earned then 0.2 else 0.6)
		medal(tile, earned)
		local name = UiKit.label(
			tile,
			if earned then (CampScript.Badges :: any)[id] or id else "□ " .. ((CampScript.Badges :: any)[id] or id),
			14,
			true,
			if earned then Palette.Ink else Palette.WoodDark
		)
		name.Position = UDim2.fromOffset(66, 8)
		name.Size = UDim2.new(1, -72, 0, 20)
		name.AutomaticSize = Enum.AutomaticSize.None
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local how = UiKit.label(
			tile,
			if earned then "얻었다!" else "어떻게: " .. ((CampScript.BadgeHow :: any)[id] or ""),
			12,
			false,
			if earned then Palette.Olive else Palette.WoodDark
		)
		how.Position = UDim2.fromOffset(66, 30)
		how.Size = UDim2.new(1, -72, 0, 30)
		how.AutomaticSize = Enum.AutomaticSize.None
		how.TextWrapped = true
		how.TextYAlignment = Enum.TextYAlignment.Top
		tiles[id] = tile
	end
end
local reenter = UiKit.button(modal, CampScript.Graduate.reenter, function()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.GRADUATE_DONE, choiceId = "REENTER" })
end, true)
reenter.LayoutOrder = 7
local stay = UiKit.button(modal, CampScript.Graduate.stay, function()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.GRADUATE_DONE, choiceId = "STAY" })
end)
stay.LayoutOrder = 8

local shownFor = -1

local function show(snap: ProtocolTypes.StateSnapshot)
	title.Text = string.format("🎓 %d기 수료", snap.entryCount)
	local s = {}
	for _, id in ipairs(snap.stickers) do
		local meta = (CampScript.Stickers :: any)[id]
		table.insert(s, if meta then meta.emoji .. " " .. meta.nameKo else id)
	end
	stickers.Text = "🛶 유보트에 남은 것\n" .. (if #s > 0 then table.concat(s, "\n") else "—")
	local have: { [string]: boolean } = {}
	for _, id in ipairs(snap.badges) do
		have[id] = true
	end
	local n = 0
	for _, id in ipairs(CampScript.BadgeOrder) do
		if have[id] then
			n += 1
		end
	end
	badgesTitle.Text = string.format("🏅 뱃지 %d / %d", n, #CampScript.BadgeOrder)
	buildTiles(have)
	gui.Enabled = true
end

function EndingPanel.start()
	Net.SnapshotChanged:Connect(function(snap)
		if snap.state == S.GRADUATE then
			if shownFor ~= snap.entryCount then
				shownFor = snap.entryCount
				task.delay(6, function()
					if Net.state() == S.GRADUATE then
						show(snap)
					end
				end)
			end
		else
			gui.Enabled = false
		end
	end)
end

return EndingPanel
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003fd</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6139">
            <Properties>
              <string name="Name">InputController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{E4664B15-239A-47B6-A1EF-66C1061F7850}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 입력 (27 §1 조작 셋 · 6단계): 걷기(WASD·스틱) + 점프(Space·Ⓐ·점프 버튼) + E(상호작용 — ProximityPrompt, 폰은 탭 버튼).
-- 그 밖에: 6일차 사격 문·기지 사격장은 클릭/탭 하나(RangeController), 기지 체력단련장 박자 기구에서만 Space·A·D 박자(BeatHud), 일지 J.
-- 탑승(RIDE)은 자리에 앉아 W(·스틱 위) = 노 젓기, A/D(·스틱 좌우) = 방향 (서버로 move·steer). Shift·박자 낮 작전·손전등 F·악! 키는 없다.
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Net = require(script.Parent.Net)

local InputController = {}
local C2S = ProtocolTypes.ClientToServer
local S = ProtocolTypes.SessionState

InputController.BeatPressed = Signal.new() :: Signal.Signal<> -- 체력단련장 박자 기구 연출용
InputController.InteractRequested = Signal.new() :: Signal.Signal<> -- E (기지: 체력단련장 등)
InputController.JournalPressed = Signal.new() :: Signal.Signal<>
InputController.InputTypeChanged = Signal.new() :: Signal.Signal<string>
InputController.CurrentInputType = "KBM"
-- 체력단련장 박자 기구: 지금 눌린 키 (HUD 키캡이 눌린 모양을 그린다)
local heldSpace = false
local heldA = false
local heldD = false
local lastMove = false
local sendAcc = 0

local function detectInputType(): string
	-- Studio 검수용: workspace 속성 Camp_ForceTouch = true 면 터치 배치로 본다
	if RunService:IsStudio() and workspace:GetAttribute("Camp_ForceTouch") == true then
		return "TOUCH"
	end
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "TOUCH"
	elseif string.find(last.Name, "Gamepad") then
		return "GAMEPAD"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "TOUCH"
	end
	return "KBM"
end

local function updateInputType()
	local t = detectInputType()
	if t ~= InputController.CurrentInputType then
		InputController.CurrentInputType = t
		InputController.InputTypeChanged:Fire(t)
	end
end

-- ===== 체력단련장 박자 기구 (TRAINING) =====
local function training(): boolean
	local snap = Net.Snapshot
	return snap ~= nil
		and snap.state == S.TRAINING
		and snap.training ~= nil
		and snap.training.kind ~= "RANGE"
		and Net.allowed("BEAT")
end

-- 박자 한 번: key = SPACE | A | D. 누른 순간의 서버 시각을 함께 보낸다 (판정은 서버)
function InputController.beat(key: string)
	if not training() then
		return
	end
	Net.fire(C2S.BeatInput, { t = workspace:GetServerTimeNow(), key = key })
	InputController.BeatPressed:Fire()
end

-- 폰 박자 버튼 (BeatHud): 키보드와 같은 길
function InputController.press(key: string, down: boolean)
	if key == "A" then
		heldA = down
	elseif key == "D" then
		heldD = down
	else
		heldSpace = down
	end
	if down then
		InputController.beat(key)
	end
end

function InputController.held(): { space: boolean, a: boolean, d: boolean }
	return { space = heldSpace, a = heldA, d = heldD }
end

-- 패드 X 로 쏘기 (20_DAYS_UNIFY): 사격 문·사격장 표적이 있을 때 RangeController 가 화면 가운데에 가장 가까운 것을 맞힌다
InputController.padShoot = nil :: (() -> boolean)?

-- E: 사격(패드) → 서버 INTERACT(넘어진·언 분대원·산·매달린 분대원 — 프롬프트와 같은 일). 할 게 없으면 아무 일 없음 (옛 "악!" 없음)
function InputController.interact()
	InputController.InteractRequested:Fire()
	local shoot = InputController.padShoot
	if shoot and shoot() then
		return
	end
	if Net.allowed("INTERACT") then
		Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.INTERACT })
	end
end

-- ===== 탑승: 앉아서 직접 젓기 (2026-10-21 플레이테스트 뒤 — Build a Boat·보트 게임 꼴) =====
-- 배 위에선 자리에 앉아 있다(Seat — 걷지 않음). 기본 조작(PlayerModule ControlModule)의 입력 벡터를 그대로 읽는다:
-- 앞(−Z: W·↑·스틱 위·폰 막대 위) = 노 젓기(move), 좌우(X: A/D·←/→·스틱·막대) = 방향(steer −1..1). 앉아 있으면 Humanoid.MoveDirection 은 0 이라 쓰지 않는다.
-- 바뀔 때만, 10Hz 까지 서버로 (CarryInput {move, steer}). 점프는 RIDE 동안 끈다(자리에서 튀어 나가지 않게).
local ROW_FORWARD = 0.35 -- 앞 성분이 이보다 크면 젓기
local STEER_DEAD = 0.2 -- 좌우가 이보다 작으면 0
local controls: any = nil
local lastSteer = 0

local function getControls(): any
	if controls then
		return controls
	end
	local ps = Players.LocalPlayer:FindFirstChild("PlayerScripts")
	local pm = ps and ps:FindFirstChild("PlayerModule")
	if not pm or not pm:IsA("ModuleScript") then
		return nil
	end
	local ok, mod = pcall(require, pm)
	if not ok or not mod then
		return nil
	end
	local okC, c = pcall(function()
		return (mod :: any):GetControls()
	end)
	if okC and c then
		controls = c
	end
	return controls
end

-- 지금 젓기·방향 (RideCrew 도 내 노를 바로 젓게 읽는다 — 서버 왕복을 기다리지 않음)
function InputController.rideInput(): (boolean, number)
	if Net.state() ~= S.RIDE then
		return false, 0
	end
	local mv = Vector3.zero
	local c = getControls()
	if c then
		local ok, v = pcall(function()
			return c:GetMoveVector()
		end)
		if ok and typeof(v) == "Vector3" then
			mv = v
		end
	end
	local fwd = -mv.Z
	local steer = mv.X
	-- 키 직접 (ControlModule 이 꺼져 있어도)
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		fwd = 1
	end
	local kl = UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)
	local kr = UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)
	if kl ~= kr then
		steer = if kl then -1 else 1
	end
	if math.abs(steer) < STEER_DEAD then
		steer = 0
	end
	steer = math.clamp(math.floor(steer * 10 + 0.5) / 10, -1, 1)
	return fwd > ROW_FORWARD, steer
end

local function sendMove(force: boolean)
	local move, steer = InputController.rideInput()
	if force or move ~= lastMove or steer ~= lastSteer then
		lastMove = move
		lastSteer = steer
		Net.fire(C2S.CarryInput, { move = move, steer = steer })
	end
end

-- RIDE 동안 점프 끔 (앉은 자리에서 튀어 나가지 않게). 끝나면 다시 켬
local jumpOff = false
local function rideJump()
	local want = Net.state() == S.RIDE
	local ch = Players.LocalPlayer.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if want and (not jumpOff or hum:GetStateEnabled(Enum.HumanoidStateType.Jumping)) then
		jumpOff = true
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	elseif not want and jumpOff then
		jumpOff = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end
end

function InputController.start()
	updateInputType()
	UserInputService.LastInputTypeChanged:Connect(updateInputType)
	workspace:GetAttributeChangedSignal("Camp_ForceTouch"):Connect(updateInputType)

	local function bind(name: string, fn: () -> (), ...: Enum.KeyCode | Enum.UserInputType)
		ContextActionService:BindAction(name, function(_, state)
			if state == Enum.UserInputState.Begin then
				fn()
			end
			return Enum.ContextActionResult.Pass
		end, false, ...)
	end
	-- 체력단련장 박자 기구: Space·Ⓐ = 박자, A·D·LB·RB = 트랙 발. 그 밖에서는 아무것도 안 한다 (Space 는 점프로 그대로 지나간다 — Pass)
	ContextActionService:BindAction(
		"CampBeat",
		function(_, state, input)
			local key = if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.ButtonL1
				then "A"
				elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.ButtonR1 then "D"
				else "SPACE"
			if state == Enum.UserInputState.Begin then
				InputController.press(key, true)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				InputController.press(key, false)
			end
			return Enum.ContextActionResult.Pass
		end,
		false,
		Enum.KeyCode.Space,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.A,
		Enum.KeyCode.D,
		Enum.KeyCode.ButtonL1,
		Enum.KeyCode.ButtonR1
	)
	RunService.Heartbeat:Connect(function(dt)
		sendAcc += dt
		if sendAcc >= 0.1 then
			sendAcc = 0
			if Net.state() == S.RIDE or lastMove or lastSteer ~= 0 then
				sendMove(false)
			end
			rideJump()
		end
	end)
	bind("CampInteract", function()
		InputController.interact()
	end, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	bind("CampJournal", function()
		InputController.JournalPressed:Fire()
	end, Enum.KeyCode.J)

	-- 폰: Roblox 이동 막대·점프 버튼은 걸어 다니는 곳에서만 (모닥불 허브도 걸어서 불·의자로 간다 — 6단계)
	local GuiService = game:GetService("GuiService")
	Net.SnapshotChanged:Connect(function(snap)
		local walking = snap.state == S.CAMP
			or snap.state == S.OBBY
			or snap.state == S.BUILD -- 꾸미기 마당은 걸어 다닌다 (3단계)
			or snap.state == S.RIDE -- 배 위: 막대 위 = 노 젓기, 좌우 = 방향 (앉아서 직접 젓기)
			or snap.state == S.NIGHT -- 모닥불: 넣기·나누기·앉기 (1단계 — 옛 밤 창이 덮던 때는 숨겼다)
		if snap.state ~= S.RIDE and (lastMove or lastSteer ~= 0) then
			sendMove(true)
		end
		rideJump()
		if GuiService.TouchControlsEnabled ~= walking then
			GuiService.TouchControlsEnabled = walking
		end
	end)
end

return InputController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003fe</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6140">
            <Properties>
              <string name="Name">LetterPanel</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{B2929AE6-08A7-4000-AE07-453775A91F45}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 퇴소 편지 (13_FINAL_LETTER): 6일차 무대에서 한 장. 받는 사람(분대원·교관·가족·나) + 이번 입소에서 실제로 한 일 칩(서버가 만듦, 3개까지) + 자유 한 줄.
-- 봉하거나 "안 쓸래" 를 누르면 퇴소식으로 간다 (서버가 진행).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Palette = require(Shared:WaitForChild("Palette"))
local Signal = require(Shared:WaitForChild("Signal"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local LetterPanel = {}
LetterPanel.Closed = Signal.new() :: Signal.Signal<>
LetterPanel.IsOpen = false
local C2S = ProtocolTypes.ClientToServer
local S = ProtocolTypes.SessionState
local FL = CampScript.FinalLetter

local gui = UiKit.screen("CampLetter", 39)
gui.Enabled = false
local modal = UiKit.modal(gui, "Letter", 500)
UiKit.pad(modal, 18)
UiKit.list(modal, nil, 10)

local title = UiKit.label(modal, FL.title, 22, true)
title.LayoutOrder = 1
local toLabel = UiKit.label(modal, FL.toLabel, 15, true, Palette.WoodDark)
toLabel.LayoutOrder = 2
toLabel.Visible = false -- v2 (M061): 받는 사람 없음 — 친구들에게

local function chipGrid(order: number, cellW: number): Frame
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y -- 칩 수가 기록마다 달라 높이를 자동으로
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(cellW, 40)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	f.Parent = modal
	return f
end
local toRow = chipGrid(3, 112)
toRow.Visible = false
local lineLabel = UiKit.label(modal, FL.lineLabel, 15, true, Palette.WoodDark)
lineLabel.LayoutOrder = 4
local lineRow = chipGrid(5, 228)
local freeLabel = UiKit.label(modal, FL.freeHint, 15, false, Palette.WoodDark)
freeLabel.LayoutOrder = 6
local box = Instance.new("TextBox")
box.Size = UDim2.new(1, 0, 0, 44)
box.BackgroundColor3 = Color3.new(1, 1, 1)
box.BorderSizePixel = 0
box.Font = UiKit.Font
box.TextSize = 18
box.TextColor3 = Palette.Ink
box.PlaceholderText = "여기에 한 줄…"
box.Text = ""
box.ClearTextOnFocus = false
box.TextXAlignment = Enum.TextXAlignment.Left
box.LayoutOrder = 7
UiKit.corner(box, 8)
UiKit.stroke(box, Palette.WoodDark, 1.5, 0.4)
local bp = Instance.new("UIPadding")
bp.PaddingLeft = UDim.new(0, 10)
bp.PaddingRight = UDim.new(0, 10)
bp.Parent = box
box.Parent = modal
local btns = Instance.new("Frame")
btns.Size = UDim2.new(1, 0, 0, 52)
btns.BackgroundTransparency = 1
btns.LayoutOrder = 8
UiKit.list(btns, Enum.FillDirection.Horizontal, 8)
btns.Parent = modal
local sealBtn = UiKit.button(btns, "✉️ 봉하기", function() end, true)
sealBtn.Size = UDim2.new(0.62, -4, 0, 52)
local skipBtn = UiKit.button(btns, FL.skip, function()
	gui.Enabled = false
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.LETTER_SKIP })
end)
skipBtn.Size = UDim2.new(0.38, -4, 0, 52)

local selectedTo: string? = nil
local selectedLines: { string } = {}
local toChips: { [string]: TextButton } = {}
local lineChips: { [string]: TextButton } = {}

local function refreshChips()
	for id, c in pairs(toChips) do
		UiKit.setChipSelected(c, selectedTo == id)
	end
	for id, c in pairs(lineChips) do
		UiKit.setChipSelected(c, table.find(selectedLines, id) ~= nil)
	end
	UiKit.setEnabled(sealBtn, #selectedLines > 0)
end

local function clearRow(row: Frame, map: { [string]: TextButton })
	for id, b in pairs(map) do
		b:Destroy()
		map[id] = nil
	end
	for _, ch in ipairs(row:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
end

local function open(to: { any }, lines: { any })
	clearRow(toRow, toChips)
	clearRow(lineRow, lineChips)
	selectedTo = "FRIENDS" -- v2: 받는 사람은 늘 친구들
	selectedLines = {}
	box.Text = ""
	for i, c in ipairs(to) do
		local id = tostring(c.id)
		local b = UiKit.chip(toRow, tostring(c.label), function()
			selectedTo = id
			refreshChips()
		end)
		b.LayoutOrder = i
		toChips[id] = b
	end
	for i, c in ipairs(lines) do
		local id = tostring(c.id)
		local b = UiKit.chip(lineRow, tostring(c.label), function()
			local k = table.find(selectedLines, id)
			if k then
				table.remove(selectedLines, k)
			elseif #selectedLines < GameConfig.Letter.MaxChips then
				table.insert(selectedLines, id)
			else
				UiKit.toast("3개까지만!")
			end
			refreshChips()
		end)
		b.LayoutOrder = i
		lineChips[id] = b
	end
	refreshChips()
	gui.Enabled = true
end

sealBtn.Activated:Connect(function()
	if not selectedTo or #selectedLines == 0 then
		return
	end
	local text = box.Text
	if utf8.len(text) and (utf8.len(text) :: number) > GameConfig.Letter.FreeTextMaxChars then
		UiKit.toast(string.format("한 줄은 %d자까지!", GameConfig.Letter.FreeTextMaxChars))
		return
	end
	UiKit.setEnabled(sealBtn, false)
	Net.request(C2S.LetterRequest, { toId = selectedTo, chips = selectedLines, freeText = text }, function(res)
		if res.accepted then
			gui.Enabled = false
		else
			UiKit.toast(Net.errorText(res.code), 3)
			UiKit.setEnabled(sealBtn, true)
		end
	end)
end)

function LetterPanel.start()
	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		LetterPanel.IsOpen = gui.Enabled
		if not gui.Enabled then
			LetterPanel.Closed:Fire()
		end
	end)
	Net.StoryCue:Connect(function(c)
		if c.kind == "LETTER_WRITE" then
			open(c.toChips or {}, c.lineChips or {})
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		if snap.state ~= S.LETTER then
			gui.Enabled = false
		end
	end)
end

return LetterPanel
]]></string>
              <int64 name="SourceAssetId">-1</int64>
