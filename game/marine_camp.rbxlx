	SFX_PICKUP = cue("rbxassetid://9120891270", "SFX", 0.5, false, true, 0.12), -- PSE "Wood Hits Wood 2" 0.91초 (봉우리 276): 장작 딱
	-- PSE "Comet Pass By Fiery Whoosh" 3.72초 (봉우리 308, 지글지글 이어짐): 장작 넣으면 불길 화르륵
	SFX_FIRE_WHOOSH = cut(cue("rbxassetid://9125445726", "SFX", 0.4, false, true, 0.25), 0, 1.6),
	SFX_FIRE_UP = cut(cue("rbxassetid://9125445726", "SFX", 0.6, false, true, 1.0), 0, 2.8), -- 불 단계 올라감: 같은 음원 길게
	SFX_GIVE = cue("rbxassetid://9113819689", "SFX", 0.6, false, true, 0.2), -- PSE "Cloth Flap 12" 0.59초 (봉우리 196): 건네기 툭
	-- ===== 살리기 (RescueService) =====
	SFX_NPC_FALL = cue("rbxassetid://9113638074", "SFX", 0.45, false, true, 0.3), -- PSE "Bump Desk 5" 1.29초 (봉우리 334): 쿵
	-- APM "Red Handed - Hit3" 피치카토 코믹 한 방 2.48초 (봉우리 459, 0.6초면 끝): 넘어짐·내가 미끄러짐 "어이쿠"
	SFX_COMIC_OOPS = cut(cue("rbxassetid://9045131605", "SFX", 0.35, false, false, 0.6), 0, 1.4),
