            <string name="ScriptGuid">{122C5411-D009-4B4C-8382-957CF34BE60C}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 서버 전용 저장. UpdateAsync + 세션 임대(jobId + token + epoch). Rob_mind ProfileStoreService 와 같은 계약.
-- 로드 실패와 "키 없음"을 구분한다. 미래 schemaVersion 은 초기화하지 않고 쓰기를 중단한다. 테스트용 store 주입 가능.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))

local ProfileStoreService = {}

local SCHEMA_VERSION = 1
local STORE_NAME = if RunService:IsStudio() then "Camp_Profile_Dev" else "Camp_Profile_Test"
local LEASE_SEC = GameConfig.Save.LeaseSec

export type Lease = { jobId: string, token: string, epoch: number, expiresAt: number }
export type Profile = {
	schemaVersion: number,
	revision: number,
	lease: Lease?,
	progress: {
		day: number, -- 다음에 시작할 날 (0 = 입소 전/기지)
		highestCp: string,
		resumeCp: string,
		entryCount: number, -- 입소 횟수 (n기)
		graduated: boolean,
		tutorialDone: boolean,
		loadout: ProtocolTypes.Loadout,
		loadoutByDay: { [string]: ProtocolTypes.Loadout }, -- "1".."6" 그날 출발 배치
		lastEntryLoadout: ProtocolTypes.Loadout?, -- 지난 입소의 마지막 배치 (다시 입소 때 기억)
		stickers: { string },
		badges: { string },
		letters: { { toId: string, chips: { string }, text: string? } },
		journal: { { day: number, text: string } },
		seenBeats: { string },
		drops: number, -- 이번 입소 급류·바다에서 물에 빠진 수 (옛 칸 이름 그대로 — 편지 칩 DROP/NODR)
		friendMarks: { [string]: string }, -- "N1" → 친구의 일지 한 줄 id (이름·ID 저장 안 함)
		stats: { strength: number, speed: number, stamina: number, aim: number }, -- 체력단련·사격장 능력치 0..5 (07_PHASE2, 14)
		trainedDay: { [string]: number }, -- 기구 id → 마지막으로 한 "입소×100+day" (하루 1회)
		-- 기록 (15_RECORDS): 1/100초. "1".."6" 작전별
		bestTimes: { [string]: number }, -- 작전별 내 최고 (모든 입소)
		runTimes: { [string]: number }, -- 이번 입소의 작전별 최고 (수료 기록 = 합)
		bestTotal: number?, -- 수료 기록 내 최고
	},
	settings: { [string]: any },
	updatedAt: number,
}

export type Store = {
	UpdateAsync: (self: any, key: string, fn: (any) -> any) -> any,
	GetAsync: (self: any, key: string) -> any,
}

export type Handle = {
	userId: number,
	key: string,
	profile: Profile,
	mode: string,
	token: string,
	epoch: number,
	lastSavedRevision: number,
	dirty: boolean,
	saving: boolean,
	lastSaveOk: boolean?,
	lastError: string?,
	closed: boolean,
}

local store: Store? = nil
local jobId = if game.JobId == "" then "studio-" .. HttpService:GenerateGUID(false) else game.JobId

function ProfileStoreService.setStore(s: Store?)
	store = s
end

local function getStore(): Store?
	if store then
		return store
	end
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = ds :: any
		return store
	end
	warn("[ProfileStore] GetDataStore failed")
	return nil
end

function ProfileStoreService.defaultProfile(): Profile
	return {
		schemaVersion = SCHEMA_VERSION,
		revision = 0,
		lease = nil,
		progress = {
			day = 0,
			highestCp = "CP0",
			resumeCp = "CP0",
			entryCount = 1,
			graduated = false,
			tutorialDone = false,
			loadout = BoatLoadout.default(),
			loadoutByDay = {},
			lastEntryLoadout = nil,
			stickers = {},
			badges = {},
			letters = {},
			journal = {},
			seenBeats = {},
			drops = 0,
			friendMarks = {},
			stats = { strength = 0, speed = 0, stamina = 0, aim = 0 },
			trainedDay = {},
			bestTimes = {},
			runTimes = {},
			bestTotal = nil,
		},
		settings = {
			captions = true,
			reducedMotion = false,
			masterVolume = 0.75,
			sfxVolume = 0.65,
			musicVolume = 0.35,
			quietHud = false,
		},
		updatedAt = 0,
	}
end

local function stringList(src: any, maxLen: number, limit: number, allowed: { [string]: any }?): { string }
	local out = {}
	if typeof(src) ~= "table" then
		return out
	end
	local seen: { [string]: boolean } = {}
	for _, v in ipairs(src) do
		if typeof(v) == "string" and #v <= maxLen and not seen[v] and (allowed == nil or allowed[v] ~= nil) then
			seen[v] = true
			table.insert(out, v)
			if #out >= limit then
				break
			end
		end
	end
	return out
end

local ALL_MEMBERS = { ME = true, DURI = true, SAN = true, MIR = true }

-- 저장 데이터 검증·정리. 깨진 부분만 기본값으로 고치고 나머지는 보존한다.
function ProfileStoreService.sanitize(p: any): Profile
	local d = ProfileStoreService.defaultProfile()
	if typeof(p) ~= "table" then
		return d
	end
	local out: any = d
	out.revision = if typeof(p.revision) == "number" then math.floor(p.revision) else 0
	out.lease = if typeof(p.lease) == "table" then p.lease else nil
	if typeof(p.progress) == "table" then
		local pr = p.progress
		if typeof(pr.day) == "number" and pr.day >= 0 and pr.day <= StationCatalog.LastDay then
			out.progress.day = math.floor(pr.day)
			-- 갯벌(3일차) 제거 전 저장(M057): 목록에 없는 날이면 그 앞 날(2)로 (검수 2026-10-20)
			if not StationCatalog.forDay(out.progress.day) then
				out.progress.day = 2
			end
		end
		-- 옛 CP3 는 유효하지 않아 CP0 로 떨어지던 것 → 그 날의 자리(CP2)로
		local function cpOrPrev(id: any): string?
			if StationCatalog.isValidId(id) then
				return id
			end
			if id == "CP3" then
				return "CP2"
			end
			return nil
		end
		local hi = cpOrPrev(pr.highestCp)
		if hi then
			out.progress.highestCp = hi
		end
		local rs = cpOrPrev(pr.resumeCp)
		if rs then
			out.progress.resumeCp = rs
		end
		if StationCatalog.indexOf(out.progress.resumeCp) > StationCatalog.indexOf(out.progress.highestCp) then
			out.progress.resumeCp = out.progress.highestCp
		end
		if typeof(pr.entryCount) == "number" and pr.entryCount >= 1 and pr.entryCount < 1000 then
			out.progress.entryCount = math.floor(pr.entryCount)
		end
		out.progress.graduated = pr.graduated == true
		out.progress.tutorialDone = pr.tutorialDone == true
		if BoatLoadout.validate(pr.loadout, ALL_MEMBERS) then
			out.progress.loadout = BoatLoadout.clone(pr.loadout)
		end
		if typeof(pr.loadoutByDay) == "table" then
			for k, v in pairs(pr.loadoutByDay) do
				if typeof(k) == "string" and #k <= 2 and BoatLoadout.validate(v, ALL_MEMBERS) then
					out.progress.loadoutByDay[k] = BoatLoadout.clone(v)
				end
			end
		end
		if BoatLoadout.validate(pr.lastEntryLoadout, ALL_MEMBERS) then
			out.progress.lastEntryLoadout = BoatLoadout.clone(pr.lastEntryLoadout)
		end
		out.progress.stickers = stringList(pr.stickers, 24, 40)
		-- 뱃지 이름 개정(23_BADGES 2026-10-21): 옛 id(FIRST_LIFT·LOGS·NO_DROP)를 새 id 로 바꾼 뒤 거른다 (겹치면 하나만)
		local badgeSrc = {}
		if typeof(pr.badges) == "table" then
			for _, v in ipairs(pr.badges) do
				table.insert(badgeSrc, if typeof(v) == "string" then (CampScript.BadgeRenames[v] or v) else v)
			end
		end
		out.progress.badges = stringList(badgeSrc, 16, 40, CampScript.Badges)
		out.progress.seenBeats = stringList(pr.seenBeats, 40, 200)
		if typeof(pr.drops) == "number" and pr.drops >= 0 then
			out.progress.drops = math.floor(pr.drops)
		end
		if typeof(pr.letters) == "table" then
			for _, l in ipairs(pr.letters) do
				if typeof(l) == "table" and typeof(l.toId) == "string" and #l.toId <= 12 then
					local chips = stringList(l.chips, 4, GameConfig.Letter.MaxChips)
					local text = if typeof(l.text) == "string" and #l.text <= 200 then l.text else nil
					table.insert(out.progress.letters, { toId = l.toId, chips = chips, text = text })
					if #out.progress.letters >= GameConfig.Save.LettersLimit then
						break
					end
				end
			end
		end
		if typeof(pr.journal) == "table" then
			for _, j in ipairs(pr.journal) do
				if
					typeof(j) == "table"
					and typeof(j.day) == "number"
					and typeof(j.text) == "string"
					and #j.text <= 120
				then
					table.insert(out.progress.journal, { day = math.floor(j.day), text = j.text })
					if #out.progress.journal >= GameConfig.Save.JournalLimit then
						break
					end
				end
			end
		end
		if typeof(pr.friendMarks) == "table" then
			for k, v in pairs(pr.friendMarks) do
				if typeof(k) == "string" and #k <= 8 and typeof(v) == "string" and #v <= 24 then
					out.progress.friendMarks[k] = v
				end
			end
		end
		if typeof(pr.stats) == "table" then
			for _, k in ipairs({ "strength", "speed", "stamina", "aim" }) do
				local v = pr.stats[k]
				if typeof(v) == "number" and v >= 0 and v <= 5 then
					out.progress.stats[k] = math.floor(v)
				end
			end
		end
		if typeof(pr.trainedDay) == "table" then
			for k, v in pairs(pr.trainedDay) do
				if typeof(k) == "string" and #k <= 12 and typeof(v) == "number" then
					out.progress.trainedDay[k] = math.floor(v)
				end
			end
		end
		for _, field in ipairs({ "bestTimes", "runTimes" }) do
			local src = pr[field]
			if typeof(src) == "table" then
				for k, v in pairs(src) do
					if typeof(k) == "string" and #k <= 2 and typeof(v) == "number" and v > 0 and v < 1e7 then
						out.progress[field][k] = math.floor(v)
					end
				end
			end
		end
		if typeof(pr.bestTotal) == "number" and pr.bestTotal > 0 and pr.bestTotal < 1e8 then
			out.progress.bestTotal = math.floor(pr.bestTotal)
		end
	end
	if typeof(p.settings) == "table" then
		for k, v in pairs(p.settings) do
			if out.settings[k] ~= nil and typeof(v) == typeof(out.settings[k]) then
				out.settings[k] = v
			end
		end
	end
	out.updatedAt = if typeof(p.updatedAt) == "number" then p.updatedAt else 0
	return out
end

local function now(): number
	return os.time()
end

local function leaseValid(lease: any): boolean
	return typeof(lease) == "table" and typeof(lease.expiresAt) == "number" and lease.expiresAt > now()
end

local function tryUpdate(s: Store, key: string, fn: (any) -> any): (boolean, any)
	local attempts = 0
	while attempts < 3 do
		attempts += 1
		local ok, result = pcall(function()
			return s:UpdateAsync(key, fn)
		end)
		if ok then
			return true, result
		end
		task.wait(0.5 * attempts + math.random() * 0.3)
	end
	return false, nil
end

function ProfileStoreService.load(userId: number): Handle
	local key = "u:" .. userId
	local token = HttpService:GenerateGUID(false)
	local handle: Handle = {
		userId = userId,
		key = key,
		profile = ProfileStoreService.defaultProfile(),
		mode = ProtocolTypes.PersistenceMode.UNAVAILABLE,
		token = token,
		epoch = 0,
		lastSavedRevision = -1,
		dirty = false,
		saving = false,
		lastSaveOk = nil,
		lastError = nil,
		closed = false,
	}
	local s = getStore()
	if not s then
		handle.lastError = "NO_STORE"
		return handle
	end
	local outcome = "NONE"
	local loaded: any = nil
	local ok = tryUpdate(s, key, function(old)
		if old == nil then
			local fresh = ProfileStoreService.defaultProfile()
			fresh.lease = { jobId = jobId, token = token, epoch = 1, expiresAt = now() + LEASE_SEC }
			fresh.updatedAt = now()
			outcome = "CREATED"
			loaded = fresh
			return fresh
		end
		if typeof(old) ~= "table" or typeof(old.schemaVersion) ~= "number" then
			outcome = "CORRUPT"
			loaded = old
			return nil
		end
		if old.schemaVersion > SCHEMA_VERSION then
			outcome = "FUTURE_SCHEMA"
			loaded = old
			return nil
		end
		if leaseValid(old.lease) and not (old.lease.jobId == jobId and old.lease.token == token) then
			outcome = "LOCKED"
			loaded = old
			return nil
		end
		local p = ProfileStoreService.sanitize(old)
		local epoch = (
			if typeof(old.lease) == "table" and typeof(old.lease.epoch) == "number" then old.lease.epoch else 0
		) + 1
		p.lease = { jobId = jobId, token = token, epoch = epoch, expiresAt = now() + LEASE_SEC }
		outcome = "ACQUIRED"
		loaded = p
		return p
	end)
	if not ok then
		handle.lastError = "LOAD_FAILED"
		return handle
	end
	if outcome == "CREATED" or outcome == "ACQUIRED" then
		handle.profile = loaded
		handle.epoch = loaded.lease.epoch
		handle.mode = ProtocolTypes.PersistenceMode.SAVING
		handle.lastSavedRevision = loaded.revision
	elseif outcome == "LOCKED" then
		handle.profile = ProfileStoreService.sanitize(loaded)
		handle.mode = ProtocolTypes.PersistenceMode.LOCKED
		handle.lastError = "LOCKED"
	else
		if outcome == "FUTURE_SCHEMA" and typeof(loaded) == "table" then
			handle.profile = ProfileStoreService.sanitize(loaded)
		end
		handle.lastError = outcome
	end
	return handle
end

local function serializedSize(p: any): number
	local ok, json = pcall(HttpService.JSONEncode, HttpService, p)
	return if ok then #json else math.huge
end

local function trimForSize(p: Profile)
	while #p.progress.journal > GameConfig.Save.JournalLimit do
		table.remove(p.progress.journal, 1)
	end
	while serializedSize(p) > GameConfig.Save.ProfileBytesMax and #p.progress.journal > 0 do
		table.remove(p.progress.journal, 1)
	end
end

function ProfileStoreService.save(handle: Handle, releaseLease: boolean?): boolean
	if handle.mode ~= ProtocolTypes.PersistenceMode.SAVING then
		return false
	end
	local s = getStore()
	if not s then
		handle.lastSaveOk = false
		return false
	end
	while handle.saving do
		task.wait(0.05)
	end
	handle.saving = true
	local p = handle.profile
	trimForSize(p)
	local ourRevision = handle.lastSavedRevision + 1
	p.revision = ourRevision
	p.updatedAt = now()
	local rejected = false
	local ok = tryUpdate(s, handle.key, function(old)
		if typeof(old) == "table" and typeof(old.lease) == "table" then
			local l = old.lease
			if (l.token ~= handle.token or l.epoch ~= handle.epoch) and leaseValid(l) then
				rejected = true
				return nil
			end
		end
		if typeof(old) == "table" and typeof(old.schemaVersion) == "number" and old.schemaVersion > SCHEMA_VERSION then
			rejected = true
			return nil
		end
		local out = table.clone(p)
		out.lease = if releaseLease
			then nil
			else { jobId = jobId, token = handle.token, epoch = handle.epoch, expiresAt = now() + LEASE_SEC }
		return out
	end)
	handle.saving = false
	if not ok then
		handle.lastSaveOk = false
		handle.lastError = "SAVE_FAILED"
		return false
	end
	if rejected then
		handle.lastSaveOk = false
		handle.lastError = "LEASE_LOST"
		handle.mode = ProtocolTypes.PersistenceMode.LOCKED
		return false
	end
	handle.lastSavedRevision = ourRevision
	handle.dirty = false
	handle.lastSaveOk = true
	handle.lastError = nil
	return true
end

-- 테스트용 인메모리 저장소 (UpdateAsync 의미 유지, 실패 주입 가능)
function ProfileStoreService.newMockStore(): any
	local data: { [string]: any } = {}
	local mock = { failNext = 0, calls = 0 }
	function mock:GetAsync(key: string)
		return data[key]
	end
	function mock:RawSet(key: string, value: any)
		data[key] = value
	end
	function mock:UpdateAsync(key: string, fn: (any) -> any)
		self.calls += 1
		if self.failNext > 0 then
			self.failNext -= 1
			error("mock failure")
		end
		local current = data[key]
		local copy = if current ~= nil then HttpService:JSONDecode(HttpService:JSONEncode(current)) else nil
		local result = fn(copy)
		if result ~= nil then
			data[key] = HttpService:JSONDecode(HttpService:JSONEncode(result))
		end
		return data[key]
	end
	return mock
end

ProfileStoreService.SchemaVersion = SCHEMA_VERSION
ProfileStoreService.jobId = jobId

return ProfileStoreService
]]></string>
