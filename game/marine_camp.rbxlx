		material = Enum.Material.WoodPlanks,
	})
	pad("P3", 3, Vector3.new(ox + 22, 0.5, -341), PX)
	-- 통나무 징검다리 (+X 방향), 아래 물
	deco(
		"D2_StepPuddle",
		Vector3.new(44, 0.3, 14),
		at(ox + 50, 0.1, -341),
		Palette.Sea,
		Enum.Material.Glass,
		{ transparency = 0.35 }
	)
	fall("Steps", Vector3.new(ox + 50, 1, -341), Vector3.new(42, 1.6, 14))
	local heights = { 3, 4.2, 3.4, 5, 3.8, 4.4 }
	for i, h in ipairs(heights) do
