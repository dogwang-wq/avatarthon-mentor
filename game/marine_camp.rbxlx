          <string name="Name">TrainingCatalog</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{5F557B09-64BC-447B-B8E6-A7CF0FA7D781}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 체력단련장 미니게임 4종 (07_PHASE2 §3). 능력치 3종: strength(근력)·speed(스피드)·stamina(체력), 상한 5, 기구마다 하루 1회.
local TrainingCatalog = {}

export type Station = {
	id: string,
	nameKo: string,
	emoji: string,
	stat: string, -- strength | speed | stamina | aim
	kind: string?, -- nil = 박자 미니게임, "RANGE" = 모의 사격(표적 누르기, 14)
	seconds: number?, -- RANGE 시간
	patternId: string,
	bpm: number,
	beats: number,
	passGood: number, -- GOOD 이 이만큼이면 +1
	whyKo: string,
}

TrainingCatalog.Stations = {
	PULLUP = {
		id = "PULLUP",
		nameKo = "철봉",
		emoji = "💪",
		stat = "strength",
		patternId = "PULLUP",
		bpm = 70,
		beats = 16,
		passGood = 6,
		whyKo = "근력이 오르면 탈출 시간이 조금 늘어요",
	},
	TRACK = {
		id = "TRACK",
		nameKo = "트랙 달리기",
		emoji = "🏃",
		stat = "speed",
		patternId = "TRACK",
		bpm = 150,
		beats = 24,
		passGood = 14,
		whyKo = "스피드가 오르면 탈출 시간이 조금 늘어요",
	},
	ROPE = {
		id = "ROPE",
		nameKo = "로프 오르기",
		emoji = "🧗",
		stat = "stamina",
		patternId = "ROPE",
		bpm = 100,
		beats = 16,
		passGood = 8,
		whyKo = "체력이 오르면 탈출 시간이 조금 늘어요",
	},
	TIRE = {
		id = "TIRE",
		nameKo = "타이어 뒤집기",
		emoji = "🏋️",
		stat = "strength",
		patternId = "TIRE",
		bpm = 80,
		beats = 20,
		passGood = 8,
		whyKo = "근력이 오르면 탈출 시간이 조금 늘어요",
	},
	RANGE = {
		id = "RANGE",
		nameKo = "모의 사격",
		emoji = "🎯",
		stat = "aim",
		kind = "RANGE",
		seconds = 30,
		patternId = "FLAT",
		bpm = 100,
		beats = 0,
		passGood = 8,
		whyKo = "사격이 오르면 탈출 문 표적이 줄어요",
	},
} :: { [string]: Station }

TrainingCatalog.Order = { "PULLUP", "TRACK", "ROPE", "TIRE", "RANGE" }
TrainingCatalog.StatMax = 5
TrainingCatalog.StatNameKo = { strength = "힘", speed = "속", stamina = "체", aim = "사" }
TrainingCatalog.StatLongKo = { strength = "근력", speed = "스피드", stamina = "체력", aim = "사격" }

-- 능력치 → 규칙 (SessionService 가 쓴다 — 6단계: 옛 운반 효과(들기 힘·받치기·모서리·기어가기)는 지웠다. 급류·바다 속도는 능력치와 무관)
TrainingCatalog.Effects = {
	EscapeSecPerStat = 1.5, -- 6일차 탈출 시간 + 1.5초 × (능력치 합) (14). 4 였을 때 능력치 5·5·5·5 면 +80초라 무엇을 해도 제시간 (16 §3)
	TargetsLessPerAim = 1, -- 탈출 문 표적 5 − 사격 (최소 2) (14)
}

function TrainingCatalog.get(id: string): Station?
	return TrainingCatalog.Stations[id]
end

function TrainingCatalog.isStat(s: any): boolean
	return s == "strength" or s == "speed" or s == "stamina" or s == "aim"
end

return TrainingCatalog
]]></string>
