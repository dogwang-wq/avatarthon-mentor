              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{6A0465AA-F0E7-49D4-A312-6152850DDB15}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 유보트 배치판 (가설 1): 자리 4 × 멤버, 짐 3칸, 노. 느낌 한 줄(BoatLoadout.feelKo — 수치 없음). 서버가 검증하고 스냅샷으로 돌려준다.
-- 밤 작은 카드의 "자리 바꾸기"·📒 일지·🛶 타일에서 연다. 1일차 꾸미기 마당(E)과 같은 배치를 바꾼다 (27 §6 "지난번과 견주기")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local CampHud = require(script.Parent.CampHud)

local LoadoutPanel = {}
local C2S = ProtocolTypes.ClientToServer
local L = ProtocolTypes.LoadoutOp

local gui = UiKit.screen("CampLoadout", 40)
gui.Enabled = false
local modal = UiKit.modal(gui, "Loadout", 520)
UiKit.pad(modal, 16)
UiKit.list(modal, nil, 10)

local title = UiKit.label(modal, CampScript.UI.loadout, 26, true)
title.LayoutOrder = 1
local help = UiKit.label(modal, CampScript.Loadout.help, 15, false, Palette.WoodDark)
help.LayoutOrder = 2

-- 유보트 그림: 2×2 자리
local boat = Instance.new("Frame")
boat.Name = "Boat"
boat.Size = UDim2.new(1, 0, 0, 190)
boat.BackgroundColor3 = Palette.Rubber
boat.BorderSizePixel = 0
boat.LayoutOrder = 3
UiKit.corner(boat, 60)
UiKit.stroke(boat, Palette.Ink, 3, 0.2)
boat.Parent = modal
local bowLabel = UiKit.label(boat, "▲ 앞", 14, true, Palette.Yellow)
bowLabel.AnchorPoint = Vector2.new(0.5, 0)
bowLabel.Position = UDim2.new(0.5, 0, 0, 6)
bowLabel.Size = UDim2.fromOffset(60, 18)
bowLabel.AutomaticSize = Enum.AutomaticSize.None
bowLabel.TextXAlignment = Enum.TextXAlignment.Center
local seatButtons: { [string]: TextButton } = {}
local SEAT_POS = {
	FL = UDim2.fromScale(0.28, 0.32),
	FR = UDim2.fromScale(0.72, 0.32),
	BL = UDim2.fromScale(0.28, 0.72),
	BR = UDim2.fromScale(0.72, 0.72),
}
local selectedSeat: string? = nil
local memberRow: Frame

local function send(payload: { [string]: any })
	Net.request(C2S.LoadoutRequest, payload, function(res)
		if not res.accepted then
			UiKit.toast(Net.errorText(res.code))
		elseif res.data and res.data.feel then
			UiKit.toast("🛶 " .. tostring(res.data.feel), 3)
		end
	end)
end

for _, key in ipairs(SquadCatalog.SeatKeys) do
	local b = Instance.new("TextButton")
	b.Name = key
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = SEAT_POS[key]
	b.Size = UDim2.fromOffset(150, 56)
	b.Font = UiKit.FontBold
	b.TextSize = 17
	b.TextColor3 = Palette.Ink
	b.BackgroundColor3 = Palette.Sand
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	UiKit.corner(b, 12)
	local s = UiKit.stroke(b, Palette.WoodDark, 2, 0.3)
	s.Name = "SeatStroke"
	b.Activated:Connect(function()
		selectedSeat = if selectedSeat == key then nil else key
		LoadoutPanel.refresh()
	end)
	b.Parent = boat
	seatButtons[key] = b
end

-- 멤버 고르기 줄
memberRow = Instance.new("Frame")
memberRow.Name = "Members"
memberRow.Size = UDim2.new(1, 0, 0, 44)
memberRow.BackgroundTransparency = 1
memberRow.LayoutOrder = 4
memberRow.Visible = false
UiKit.list(memberRow, Enum.FillDirection.Horizontal, 8)
memberRow.Parent = modal
local memberChips: { TextButton } = {}

-- 멤버 안내 (27 §3 "수치 안 보임", 마감 패스 M069): 이름·이모지만, 힘센 사람은 숫자 대신 말 한 줄
local statsLabel = UiKit.label(modal, "", 14, false, Palette.WoodDark)
statsLabel.LayoutOrder = 5
do
	local parts = {}
	local top, topPower = nil :: string?, -1
	for _, id in ipairs({ "ME", "DURI", "SAN", "MIR" }) do
		local m = SquadCatalog.Members[id]
		table.insert(parts, m.emoji .. " " .. m.nameKo)
		if m.power > topPower then -- 힘 = 급류에서 그쪽으로 기우는 정도 (RideService) — 화면엔 숫자 없이
			top, topPower = m.emoji .. " " .. m.nameKo, m.power
		end
	end
	statsLabel.Text = table.concat(parts, " · ")
		.. (if top then "  —  " .. string.format(CampScript.Loadout.heavy, top) else "")
end

-- 짐
local cargoTitle = UiKit.label(modal, "🎒 짐 (3개까지)", 18, true)
cargoTitle.LayoutOrder = 6
local cargoRow = Instance.new("Frame")
cargoRow.Size = UDim2.new(1, 0, 0, 44)
cargoRow.BackgroundTransparency = 1
cargoRow.LayoutOrder = 7
UiKit.list(cargoRow, Enum.FillDirection.Horizontal, 8)
cargoRow.Parent = modal
local cargoChips: { [string]: TextButton } = {}
for _, id in ipairs(BoatLoadout.CargoOrder) do
	local c = BoatLoadout.Cargo[id]
	cargoChips[id] = UiKit.chip(
		cargoRow,
		c.emoji .. " " .. c.nameKo,
		function() -- 무게 숫자는 안 보인다 (27 §3)
			local snap = Net.Snapshot
			if not snap then
				return
			end
			local has = table.find(snap.loadout.cargo, id) ~= nil
			send({ op = if has then L.CARGO_REMOVE else L.CARGO_ADD, cargoId = id })
		end
	)
end
local cargoWhy = UiKit.label(modal, "", 14, false, Palette.WoodDark)
cargoWhy.LayoutOrder = 8
do
	local parts = {}
	for _, id in ipairs(BoatLoadout.CargoOrder) do
		local c = BoatLoadout.Cargo[id]
		table.insert(parts, c.emoji .. " " .. c.whyKo)
	end
	cargoWhy.Text = table.concat(parts, " · ")
end

-- 노
local oarTitle = UiKit.label(modal, "🥢 노", 18, true)
oarTitle.LayoutOrder = 9
local oarRow = Instance.new("Frame")
oarRow.Size = UDim2.new(1, 0, 0, 44)
oarRow.BackgroundTransparency = 1
oarRow.LayoutOrder = 10
UiKit.list(oarRow, Enum.FillDirection.Horizontal, 8)
oarRow.Parent = modal
local oarChips: { [string]: TextButton } = {}
for _, id in ipairs({ "SHORT", "LONG" }) do
	local o = (BoatLoadout.Oars :: any)[id]
	oarChips[id] = UiKit.chip(oarRow, string.format("%s %s · %s", o.emoji, o.nameKo, o.whyKo), function()
		send({ op = L.OAR, oar = id })
	end)
end

-- 급류·바다에서의 느낌 한 줄 (수치 없음)
local feel = UiKit.label(modal, "", 16, true, Palette.Olive)
feel.LayoutOrder = 11

local btnRow = Instance.new("Frame")
btnRow.Size = UDim2.new(1, 0, 0, 56)
btnRow.BackgroundTransparency = 1
btnRow.LayoutOrder = 12
UiKit.list(btnRow, Enum.FillDirection.Horizontal, 10)
btnRow.Parent = modal
-- ↺ 는 Roblox 기본 글꼴에서 □ 로 나와 🔄 (2026-10-19)
local resetBtn = UiKit.button(btnRow, "🔄 처음대로", function()
	send({ op = L.RESET })
end)
resetBtn.Size = UDim2.new(0.45, 0, 0, 56)
local closeBtn = UiKit.button(btnRow, "✅ 됐어", function()
	LoadoutPanel.close()
end, true)
closeBtn.Size = UDim2.new(0.5, 0, 0, 56)

function LoadoutPanel.refresh()
	local snap = Net.Snapshot
	if not snap then
		return
	end
	local lo = snap.loadout
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		local b = seatButtons[key]
		local mid = lo.seats[key]
		local m = SquadCatalog.get(mid)
		local isFriend = false
		for _, mv in ipairs(snap.members) do
			if mv.id == mid and mv.isFriend then
				isFriend = true
			end
		end
		b.Text = string.format(
			"%s\n%s %s",
			SquadCatalog.SeatNameKo[key],
			if isFriend then "🤝" elseif m then m.emoji else "?",
			if isFriend then "친구" elseif m then m.nameKo else mid
		)
		local s = b:FindFirstChild("SeatStroke") :: UIStroke?
		if s then
			s.Color = if selectedSeat == key then Palette.Red else Palette.WoodDark
			s.Thickness = if selectedSeat == key then 3.5 else 2
			s.Transparency = if selectedSeat == key then 0 else 0.3
		end
		b.BackgroundColor3 = if selectedSeat == key then Palette.Yellow else Palette.Sand
	end
	-- 멤버 칩
	for _, c in ipairs(memberChips) do
		c:Destroy()
	end
	memberChips = {}
	memberRow.Visible = selectedSeat ~= nil
	if selectedSeat then
		for _, id in ipairs({ "ME", "DURI", "SAN", "MIR" }) do
			local m = SquadCatalog.Members[id]
			local chip = UiKit.chip(memberRow, m.emoji .. " " .. m.nameKo, function()
				send({ op = L.SEAT, seatKey = selectedSeat, memberId = id })
				selectedSeat = nil
				LoadoutPanel.refresh()
			end)
			UiKit.setChipSelected(chip, lo.seats[selectedSeat :: string] == id)
			table.insert(memberChips, chip)
		end
	end
	for id, chip in pairs(cargoChips) do
		UiKit.setChipSelected(chip, table.find(lo.cargo, id) ~= nil)
	end
	for id, chip in pairs(oarChips) do
		UiKit.setChipSelected(chip, lo.oar == id)
	end
	feel.Text = "🔎 " .. BoatLoadout.feelKo(lo)
	local can = snap.allowed.LOADOUT
	for _, b in pairs(seatButtons) do
		b.Active = can
	end
	help.Text = if can then CampScript.Loadout.help else CampScript.Loadout.locked
end

function LoadoutPanel.open()
	selectedSeat = nil
	LoadoutPanel.refresh()
	gui.Enabled = true
end

function LoadoutPanel.close()
	UiKit.closeThen(modal, function()
		gui.Enabled = false
	end)
end

function LoadoutPanel.start()
	CampHud.OpenLoadout:Connect(LoadoutPanel.open)
	Net.SnapshotChanged:Connect(function(snap)
		if gui.Enabled then
			LoadoutPanel.refresh()
			if not snap.allowed.LOADOUT then
				gui.Enabled = false
			end
		end
	end)
end

return LoadoutPanel
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000400</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6142">
            <Properties>
              <string name="Name">Net</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{8E782448-4DDE-4E9D-834C-0F556F087DE0}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 리모트 접근, requestId 생성, 서버 스냅샷 공유. 모든 컨트롤러는 여기서 상태를 읽는다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local Signal = require(Shared:WaitForChild("Signal"))

local Net = {}

local folder = ReplicatedStorage:WaitForChild(ProtocolTypes.RemotesFolderName, 30)
assert(folder, "Remotes folder missing (server not running?)")

local function remote(name: string): RemoteEvent
	return folder:WaitForChild(name, 30) :: RemoteEvent
end

Net.Snapshot = nil :: ProtocolTypes.StateSnapshot?
Net.SnapshotChanged = Signal.new() :: Signal.Signal<ProtocolTypes.StateSnapshot, ProtocolTypes.StateSnapshot?>
Net.ActionResult = Signal.new() :: Signal.Signal<ProtocolTypes.ActionResult>
Net.StoryCue = Signal.new() :: Signal.Signal<any>
Net.FxCue = Signal.new() :: Signal.Signal<any>
Net.DayReport = Signal.new() :: Signal.Signal<any>
Net.CoopCue = Signal.new() :: Signal.Signal<any>

local pending: { [string]: (ProtocolTypes.ActionResult) -> () } = {}

remote(ProtocolTypes.ServerToClient.StateSnapshot).OnClientEvent:Connect(function(snap: ProtocolTypes.StateSnapshot)
	local old = Net.Snapshot
	Net.Snapshot = snap
	Net.SnapshotChanged:Fire(snap, old)
end)
remote(ProtocolTypes.ServerToClient.ActionResult).OnClientEvent:Connect(function(res: ProtocolTypes.ActionResult)
	local cb = pending[res.requestId]
	if cb then
		pending[res.requestId] = nil
		cb(res)
	end
	Net.ActionResult:Fire(res)
end)
remote(ProtocolTypes.ServerToClient.StoryCue).OnClientEvent:Connect(function(c)
	Net.StoryCue:Fire(c)
end)
remote(ProtocolTypes.ServerToClient.FxCue).OnClientEvent:Connect(function(c)
	Net.FxCue:Fire(c)
end)
remote(ProtocolTypes.ServerToClient.DayReport).OnClientEvent:Connect(function(c)
	Net.DayReport:Fire(c)
end)
remote(ProtocolTypes.ServerToClient.CoopCue).OnClientEvent:Connect(function(c)
	Net.CoopCue:Fire(c)
end)

function Net.newRequestId(): string
	return string.sub(HttpService:GenerateGUID(false), 1, 12)
end

-- 요청 전송. 응답은 콜백 1회 (8초 안에 없으면 INTERNAL)
function Net.request(name: string, payload: { [string]: any }, cb: ((ProtocolTypes.ActionResult) -> ())?): string
	local id = Net.newRequestId()
	payload.requestId = id
	if cb then
		pending[id] = cb
		task.delay(8, function()
			if pending[id] then
				pending[id] = nil
				cb({ requestId = id, accepted = false, code = ProtocolTypes.ErrorCode.INTERNAL })
			end
		end)
	end
	remote(name):FireServer(payload)
	return id
end

function Net.fire(name: string, payload: any)
	remote(name):FireServer(payload)
end

function Net.state(): string
	return if Net.Snapshot then Net.Snapshot.state else ProtocolTypes.SessionState.LOADING
end

function Net.allowed(action: string): boolean
	return Net.Snapshot ~= nil and Net.Snapshot.allowed[action] == true
end

function Net.setting(key: string): any
	return if Net.Snapshot then Net.Snapshot.settings[key] else nil
end

function Net.errorText(code: string): string
	return (ProtocolTypes.ErrorTextKo :: any)[code] or ProtocolTypes.ErrorTextKo.INTERNAL
end

-- 내가 탄 유보트의 주인 (친구 자리면 호스트)
function Net.boatOwnerId(): number
	local snap = Net.Snapshot
	if snap and snap.coop and snap.coop.role == "GUEST" then
		return snap.coop.partnerUserId
	end
	return game:GetService("Players").LocalPlayer.UserId
end

function Net.isGuest(): boolean
	local snap = Net.Snapshot
	return snap ~= nil and snap.coop ~= nil and snap.coop.role == "GUEST"
end

return Net
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000401</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6143">
            <Properties>
              <string name="Name">NightPanel</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{413338FB-F8F2-4915-8EDB-C73A7C81D604}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 밤 (모닥불 허브, 6단계 정리): 도착해도 소대 일지 창을 띄우지 않는다 — 불·분대원이 보여야 넣기·나누기·앉기를 한다.
--   · 도착: 오른쪽 위 한 줄 알림 "📒 일지에 한 줄 적었어요" (일지는 📒 타일 뒤에)
--   · 오른쪽 아래 작은 카드: "내일로"가 켜지면(camp.nextIn 0 = 서버 allowed.NEXT_DAY) 또는 일지를 한 번 열었으면 —
--     ☀️ 아침, 기지로 · 🔁 한 번 더 · 🛶 자리 바꾸기 · 🔥 조금 더(카드 접기)
--   · 📒 소대 일지 창: 오늘 밤 한 줄·오늘의 발견·⏱ 기록·오늘/어제 배치(작게, 가설 1)·지난 날들·배지·유보트 흔적. 점수 없음.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local CampHud = require(script.Parent.CampHud)
local LoadoutPanel = require(script.Parent.LoadoutPanel)
local InputController = require(script.Parent.InputController)

local NightPanel = {}
local C2S = ProtocolTypes.ClientToServer
local S = ProtocolTypes.SessionState
local UI = CampScript.UI

local lastReport: any = nil -- 오늘 밤 일지 (DayReport)
local openedTonight = false -- 오늘 밤 일지를 한 번 열었나 (열었으면 작은 카드가 바로 보인다)
local foldedTonight = false -- "🔥 조금 더" 로 카드를 접었나 (일지를 다시 열면 펼친다)
local nextInVal, nextInAt = 0, 0 -- 서버가 알려 준 "내일로까지 남은 초"와 받은 때 (카드 숫자는 그 사이를 센다)

local function requestNextDay()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.NEXT_DAY }, function(res)
		if not res.accepted then
			UiKit.toast(Net.errorText(res.code))
		end
	end)
end
local function requestReplay()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.REPLAY_DAY })
end

-- ===================== 오른쪽 아래 작은 카드 =====================
local cardGui = UiKit.screen("CampNightCard", 36)
cardGui.Enabled = false
local card = UiKit.panel(cardGui, "NightCard", UDim2.fromOffset(236, 0), UDim2.new(1, -16, 1, -16), Vector2.new(1, 1))
card.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(card, 12)
UiKit.list(card, nil, 6)
local cardTitle = UiKit.label(card, "", 17, true, Palette.Cream)
cardTitle.LayoutOrder = 1
local cardSub = UiKit.label(card, "", 13, false, Palette.Sand)
cardSub.LayoutOrder = 2
local nextBtn = UiKit.button(card, UI.nextDay, requestNextDay, true)
nextBtn.Size = UDim2.new(1, 0, 0, 46)
nextBtn.LayoutOrder = 3
local replayBtn = UiKit.button(card, UI.replay, requestReplay)
replayBtn.Size = UDim2.new(1, 0, 0, 40)
replayBtn.LayoutOrder = 4
local swapBtn = UiKit.button(card, "🛶 " .. UI.swapSeat, function()
	LoadoutPanel.open()
end)
swapBtn.Size = UDim2.new(1, 0, 0, 40)
swapBtn.LayoutOrder = 5
local stayBtn = UiKit.button(card, UI.stayNight, function()
	foldedTonight = true
	cardGui.Enabled = false
end)
stayBtn.Size = UDim2.new(1, 0, 0, 34)
stayBtn.LayoutOrder = 6
stayBtn.TextSize = 15
UiKit.popOnShow(card)

-- ===================== 📒 소대 일지 창 =====================
local jgui = UiKit.screen("CampJournal", 37)
jgui.Enabled = false
local jmodal = UiKit.modal(jgui, "Journal", 480)
UiKit.pad(jmodal, 16)
UiKit.list(jmodal, nil, 8)
local jtitle = UiKit.label(jmodal, UI.journal, 24, true)
jtitle.LayoutOrder = 1
-- 오늘 밤 (도착한 밤에만 보인다)
local tonight = Instance.new("Frame")
tonight.Name = "Tonight"
tonight.Size = UDim2.fromScale(1, 0)
tonight.AutomaticSize = Enum.AutomaticSize.Y
tonight.BackgroundTransparency = 1
tonight.LayoutOrder = 2
UiKit.list(tonight, nil, 6)
tonight.Parent = jmodal
local slow = UiKit.label(tonight, "", 17, false)
slow.LayoutOrder = 1
-- 오늘의 발견: 오늘 실제로 일어난 일에서 고른 한 줄 (다음에 바꿔 볼 거리, 정답 아님)
local discover = UiKit.label(tonight, "", 16, true, Palette.Olive)
discover.LayoutOrder = 2
-- ⏱ 오늘 작전 기록 (15)
local stageLbl = UiKit.label(tonight, "", 15, true, Palette.Red)
stageLbl.LayoutOrder = 3
-- 오늘 배치 / 어제 배치 (가설 1 — 작게)
local sideTitle = UiKit.label(tonight, "", 13, true, Palette.WoodDark)
sideTitle.LayoutOrder = 4
local side = Instance.new("Frame")
side.Size = UDim2.new(1, 0, 0, 78)
side.BackgroundTransparency = 1
side.LayoutOrder = 5
UiKit.list(side, Enum.FillDirection.Horizontal, 12)
side.Parent = tonight

local function miniBoat(parent: Instance): (Frame, { [string]: TextLabel })
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(0.5, -6, 1, 0)
	wrap.BackgroundColor3 = Palette.Rubber
	wrap.BorderSizePixel = 0
	UiKit.corner(wrap, 26)
	wrap.Parent = parent
	local cells: { [string]: TextLabel } = {}
	local pos = {
		FL = UDim2.fromScale(0.27, 0.3),
		FR = UDim2.fromScale(0.73, 0.3),
		BL = UDim2.fromScale(0.27, 0.72),
		BR = UDim2.fromScale(0.73, 0.72),
	}
	for key, p in pairs(pos) do
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = p
		l.Size = UDim2.new(0.44, 0, 0, 24)
		l.BackgroundColor3 = Palette.Sand
		l.BorderSizePixel = 0
		l.Font = UiKit.FontBold
		l.TextSize = 12
		l.TextColor3 = Palette.Ink
		l.Text = ""
		UiKit.corner(l, 6)
		l.Parent = wrap
		cells[key] = l
	end
	return wrap, cells
end
local _, todayCells = miniBoat(side)
local prevWrap, prevCells = miniBoat(side)
local diff = UiKit.label(tonight, "", 13, false, Palette.Olive)
diff.LayoutOrder = 6
-- 지난 날들 · 배지 · 흔적
local jbody = UiKit.label(jmodal, "", 15)
jbody.LayoutOrder = 3
local jbadges = UiKit.label(jmodal, "", 14, false, Palette.Olive)
jbadges.LayoutOrder = 4
local jstickers = UiKit.label(jmodal, "", 14, false, Palette.Olive)
jstickers.LayoutOrder = 5
local jclose = UiKit.button(jmodal, "닫기", function()
	UiKit.closeThen(jmodal, function()
		jgui.Enabled = false
	end)
end, true)
jclose.LayoutOrder = 6

local function fillCells(cells: { [string]: TextLabel }, lo: any)
	for key, l in pairs(cells) do
		local id = if lo then lo.seats[key] else nil
		local m = if id then SquadCatalog.get(id) else nil
		l.Text = if m then m.emoji .. " " .. m.nameKo elseif id then "🤝 친구" else "—"
	end
end

local function renderTonight(r: any?)
	local snap = Net.Snapshot
	local show = r ~= nil and snap ~= nil and snap.state == S.NIGHT
	tonight.Visible = show
	if not show or not r then
		return
	end
	jtitle.Text = string.format("📒 %d박 · 소대 일지", StationCatalog.nightNo(r.day))
	slow.Text = "✏️ " .. tostring(r.slowText)
	discover.Text = if r.discover then UI.discoverHead .. tostring(r.discover) else ""
	discover.Visible = r.discover ~= nil
	local sg = r.stage
	stageLbl.Visible = sg ~= nil
	if sg then
		stageLbl.Text = string.format(
			"⏱ %s%s · 내 최고 %s",
			KoreanText.clock(sg.cs),
			if sg.newBest then " 새 최고!" else "",
			KoreanText.clock(sg.best)
		)
	end
	fillCells(todayCells, r.today)
	fillCells(prevCells, r.prev)
	prevWrap.Visible = r.prev ~= nil
	local prevLabel = tostring(r.prevLabel or "어제")
	sideTitle.Text = if r.prev then UI.todayLabel .. " / " .. prevLabel .. " 배치" else UI.todayLabel
	diff.Text = "바뀐 것: " .. tostring(r.diffText)
end

local function openJournal()
	local snap = Net.Snapshot
	if not snap then
		return
	end
	jtitle.Text = UI.journal
	renderTonight(lastReport)
	local lines = {}
	local journal = if lastReport and lastReport.journal then lastReport.journal else {}
	for _, j in ipairs(journal) do
		table.insert(lines, string.format("%d일차 · %s", j.day, j.text))
	end
	jbody.Text = if #lines > 0
		then table.concat(lines, "\n")
		else "아직 한 줄도 없어요. 첫날을 다녀오면 생겨요!"
	local b = {}
	for _, id in ipairs(snap.badges) do
		table.insert(b, (CampScript.Badges :: any)[id] or id)
	end
	jbadges.Text = "🏅 " .. (if #b > 0 then table.concat(b, " · ") else "아직 없음")
	local s = {}
	for _, id in ipairs(snap.stickers) do
		local meta = (CampScript.Stickers :: any)[id]
		table.insert(s, if meta then meta.emoji .. " " .. meta.nameKo else id)
	end
	jstickers.Text = "🛶 유보트 흔적: " .. (if #s > 0 then table.concat(s, " · ") else "아직 없음")
	jgui.Enabled = true
	if snap.state == S.NIGHT then
		openedTonight = true
		foldedTonight = false
	end
end

-- 작은 카드: 밤에만, 가운데 창이 없을 때, "내일로" 가 켜졌거나 일지를 열어 봤을 때 (접었으면 다시 열 때까지 숨김)
local function refreshCard()
	local snap = Net.Snapshot
	if not snap or snap.state ~= S.NIGHT then
		cardGui.Enabled = false
		return
	end
	local ready = snap.allowed.NEXT_DAY == true
	local want = (ready or openedTonight) and not foldedTonight and not UiKit.anyModalOpen()
	if want and not cardGui.Enabled then
		UiKit.pop(card, 0.85)
	end
	cardGui.Enabled = want
	if not want then
		return
	end
	cardTitle.Text = string.format(UI.nightCard, StationCatalog.nightNo(snap.day))
	local left = math.max(0, nextInVal - (os.clock() - nextInAt))
	cardSub.Text = if ready then UI.nightCardSub else string.format(UI.nightCardWait, math.ceil(left))
	nextBtn.Visible = ready
	replayBtn.Visible = snap.allowed.REPLAY_DAY == true and (lastReport == nil or lastReport.canReplay == true)
	swapBtn.Visible = snap.allowed.LOADOUT == true
	-- 폰: 오른쪽 아래는 점프·탭 버튼 자리 → 그 위로
	card.Position = if InputController.CurrentInputType == "TOUCH"
		then UDim2.new(1, -16, 1, -210)
		else UDim2.new(1, -16, 1, -16)
end

function NightPanel.start()
	Net.DayReport:Connect(function(r)
		lastReport = r
		openedTonight = false
		foldedTonight = false
		-- 불을 가리지 않게 창 대신 한 줄 알림 (6단계). 일지는 📒 타일 뒤에
		UiKit.toast(UI.journalToast, 3)
		refreshCard()
	end)
	CampHud.OpenJournal:Connect(openJournal)
	Net.SnapshotChanged:Connect(function(snap)
		local ni = if snap.camp then snap.camp.nextIn else nil
		if ni then
			nextInVal, nextInAt = ni, os.clock()
		end
		if snap.state ~= S.NIGHT and snap.state ~= S.CAMP and snap.state ~= S.LETTER and snap.state ~= S.GRADUATE then
			jgui.Enabled = false
		end
		if jgui.Enabled and tonight.Visible and snap.state ~= S.NIGHT then
			tonight.Visible = false
		end
		refreshCard()
	end)
	UiKit.ModalChanged:Connect(refreshCard)
	InputController.InputTypeChanged:Connect(refreshCard)
	-- nextIn 카운트다운을 1초마다 (스냅샷이 안 와도)
	task.spawn(function()
		while true do
			task.wait(1)
			if cardGui.Enabled then
				refreshCard()
			end
		end
	end)
end

return NightPanel
]]></string>
