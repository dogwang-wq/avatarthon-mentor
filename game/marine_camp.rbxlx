		Enum.Material.Metal,
		{ shape = Enum.PartType.Ball }
	)
	pad("P_NET_TOP", 7, Vector3.new(ox + 110, 14.9, -410), NZ)
	pad("P7", 8, Vector3.new(ox + 110, 0.5, -422), NZ)
	deco(
		"D2_SanSign",
		Vector3.new(4, 1.6, 0.2),
		at(ox + 98, 2, -400),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "🤝 같이 가기", SignSub = "산 옆으로 가면 버튼이 떠요" } } -- 20: 기기마다 Prompt 가 맞는 입력을 보여 준다
	)
	-- 타잔 로프: 두 높은 단 사이 5 stud 뛰기 (밧줄은 장식, 아래 매트 = 추락). Studio 2026-10-18: 8 stud 는 기본 점프(JumpPower 50)로 못 넘어 단 B 를 3 stud 당김
	add({
		id = "D2_TarzanStairs",
		folder = "TerrainProps",
		class = "WedgePart",
		size = Vector3.new(6, 12, 16),
		cframe = CFrame.new(ox + 125, 6, -424) * CFrame.Angles(0, math.rad(180), 0),
