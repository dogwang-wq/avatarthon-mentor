              <string name="Source"><![CDATA[--!strict
-- 친구 태우기: 같은 서버의 로블록스 친구 목록 + 어느 분대원 자리인지 → 초대. 초대받으면 수락/거절 카드.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Palette = require(Shared:WaitForChild("Palette"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local CampHud = require(script.Parent.CampHud)

local CoopController = {}
local C2S = ProtocolTypes.ClientToServer
local Op = ProtocolTypes.CoopOp
local player = Players.LocalPlayer

local gui = UiKit.screen("CampCoop", 41)
gui.Enabled = false
local modal = UiKit.modal(gui, "Coop", 420)
UiKit.pad(modal, 16)
UiKit.list(modal, nil, 8)
local title = UiKit.label(modal, CampScript.UI.coopInvite, 24, true)
title.LayoutOrder = 1
local help = UiKit.label(
	modal,
	"같은 서버에 있는 로블록스 친구만 탈 수 있어요. 친구가 분대원 한 명 자리를 맡아요!",
	15,
	false,
	Palette.WoodDark
)
help.LayoutOrder = 2
local memberLabel = UiKit.label(modal, "누구 자리?", 15, true, Palette.WoodDark)
memberLabel.LayoutOrder = 3
local memberRow = Instance.new("Frame")
memberRow.Size = UDim2.new(1, 0, 0, 44)
memberRow.BackgroundTransparency = 1
memberRow.LayoutOrder = 4
UiKit.list(memberRow, Enum.FillDirection.Horizontal, 8)
memberRow.Parent = modal
local selectedMember = "DURI"
local memberChips: { [string]: TextButton } = {}
for _, id in ipairs(SquadCatalog.NpcOrder) do
	local m = SquadCatalog.Members[id]
	memberChips[id] = UiKit.chip(memberRow, m.emoji .. " " .. m.nameKo, function()
		selectedMember = id
		for k, c in pairs(memberChips) do
			UiKit.setChipSelected(c, k == id)
		end
	end)
end
UiKit.setChipSelected(memberChips.DURI, true)
local friendsLabel = UiKit.label(modal, "친구", 15, true, Palette.WoodDark)
friendsLabel.LayoutOrder = 5
local friendList = Instance.new("Frame")
friendList.Size = UDim2.fromScale(1, 0)
friendList.AutomaticSize = Enum.AutomaticSize.Y
friendList.BackgroundTransparency = 1
friendList.LayoutOrder = 6
UiKit.list(friendList, nil, 6)
friendList.Parent = modal
local none = UiKit.label(friendList, "지금 서버에 친구가 없어요", 15, false, Palette.WoodDark)
local closeBtn = UiKit.button(modal, "닫기", function()
	UiKit.closeThen(modal, function()
		gui.Enabled = false
	end)
end)
closeBtn.LayoutOrder = 7

local function refreshFriends()
	for _, c in ipairs(friendList:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p == player then
			continue
		end
		local ok, isFriend = pcall(function()
			return player:IsFriendsWith(p.UserId)
		end)
		if ok and isFriend then
			count += 1
			UiKit.button(friendList, "👋 " .. p.DisplayName, function()
				Net.request(
					C2S.CoopRequest,
					{ op = Op.INVITE, targetUserId = p.UserId, memberId = selectedMember },
					function(res)
						if res.accepted then
							UiKit.toast("초대 보냈어요! " .. p.DisplayName)
							gui.Enabled = false
						else
							UiKit.toast(Net.errorText(res.code))
						end
					end
				)
			end)
		end
	end
	none.Visible = count == 0
end

-- 초대 카드
local inviteGui = UiKit.screen("CampCoopInvite", 42)
inviteGui.Enabled = false
local card =
	UiKit.paper(inviteGui, "Invite", UDim2.fromOffset(360, 0), UDim2.fromScale(0.5, 0.35), Vector2.new(0.5, 0.5))
card.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(card, 14)
UiKit.list(card, nil, 8)
local inviteText = UiKit.label(card, "", 18, true)
local acceptBtn = UiKit.button(card, "🛶 타기", function()
	Net.request(C2S.CoopRequest, { op = Op.ACCEPT })
	inviteGui.Enabled = false
end, true)
local declineBtn = UiKit.button(card, "다음에", function()
	Net.request(C2S.CoopRequest, { op = Op.DECLINE })
	inviteGui.Enabled = false
end)
local _ = acceptBtn
local _2 = declineBtn

function CoopController.start()
	CampHud.OpenCoop:Connect(function()
		refreshFriends()
		gui.Enabled = true
	end)
	Net.CoopCue:Connect(function(c)
		if c.kind == "INVITE" then
			inviteText.Text = string.format(
				"%s %s 자리에 태워 준대요!",
				KoreanText.josa(tostring(c.hostName), "이/가"),
				tostring(c.memberNameKo)
			)
			inviteGui.Enabled = true
			task.delay(60, function()
				inviteGui.Enabled = false
			end)
		elseif c.kind == "JOINED" then
			UiKit.toast(string.format("🤝 %s 탔어요!", tostring(c.guestName)), 3)
		elseif c.kind == "RIDING" then
			UiKit.toast(tostring(c.text), 4)
		elseif c.kind == "LEFT" then
			UiKit.toast("친구 자리가 비었어요. 분대원이 돌아와요", 3)
		elseif c.kind == "DECLINED" then
			UiKit.toast("친구가 다음에 탄대요", 3)
		elseif c.kind == "INVITED" then
			UiKit.toast("초대 중… " .. tostring(c.targetName), 3)
		end
	end)
end

return CoopController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003fb</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6137">
            <Properties>
              <string name="Name">CourseFx</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{B2BCB304-E069-4AC4-A437-B9D989CFB25C}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 코스 연출 (전부 클라이언트, 서버 상태 없음): 깃발 펄럭임·게 종종걸음(장식)·반딧불·모닥불·촛불·파도 거품·밤 안개·손전등·FxCue 파티클.
-- 생성기/유보트가 둔 속성(Flag/Crab/Firefly/CampFlame/Candle/WaveFoam/FireRing)으로 찾는다. 움직임 줄이기 설정을 따른다.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)

local CourseFx = {}
local S = ProtocolTypes.SessionState
local player = Players.LocalPlayer
local reduced = false

type Anim = { part: BasePart, base: CFrame, phase: number, kind: string }
local anims: { Anim } = {}
local seen: { [BasePart]: boolean } = {}
local fires: { [BasePart]: boolean } = {}
-- 밤 모닥불 (1단계, 28 §6): FIRE 트리거의 FireLevel 0..3 속성을 보고 불·불티·연기·빛·바닥 빛무리를 세 단계로 그린다
type NightFire = {
	part: BasePart,
	core: BasePart,
	glow: BasePart,
	fire: Fire,
	embers: ParticleEmitter,
	smoke: ParticleEmitter,
	light: PointLight,
	level: number,
	flareUntil: number,
	phase: number,
}
local nightFires: { [BasePart]: NightFire } = {}
local candles: { [BasePart]: boolean } = {}
local candlesLit = false
local flashlight: SpotLight? = nil

local function myBoat(): Model?
	local f = SceneBindings.getFolder("Runtime")
	local m = f and f:FindFirstChild("Boat_" .. Net.boatOwnerId())
	return if m and m:IsA("Model") then m else nil
end

local function emitter(
	parent: BasePart,
	color: Color3,
	size: number,
	rate: number,
	life: number,
	speed: number
): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(life * 0.7, life)
	e.Rate = rate
	e.Speed = NumberRange.new(speed * 0.6, speed)
	e.SpreadAngle = Vector2.new(35, 35)
	e.LightEmission = 0.4
	e.Parent = parent
	return e
end

local function burst(pos: Vector3, color: Color3, count: number, size: number)
	if reduced then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = workspace
	local e = emitter(p, color, size, 0, 0.9, 8)
	e:Emit(count)
	task.delay(1.5, function()
		p:Destroy()
	end)
end

-- 바닥에 퍼지는 노란 고리 (붙이기·내밀기 "톡", 3단계): 얇은 원판이 0.35초에 커지며 사라진다
local function popRing(pos: Vector3, color: Color3)
	if reduced then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.25
	p.Size = Vector3.new(0.08, 0.6, 0.6)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TweenService:Create(
		p,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.08, 4.2, 4.2), Transparency = 1 }
	):Play()
	task.delay(0.45, function()
		p:Destroy()
	end)
end

-- 내 유보트가 0.3초 노랗게 번쩍 (붙였다는 손맛 — 서버가 움직이는 유보트는 건드리지 않고 하이라이트만)
local function bumpBoat()
	local boat = myBoat()
	if not boat then
		return
	end
	local old = boat:FindFirstChild("CampAttachFlash")
	if old then
		old:Destroy()
	end
	local h = Instance.new("Highlight")
	h.Name = "CampAttachFlash"
	h.FillColor = Palette.Yellow
	h.OutlineColor = Palette.Cream
	h.FillTransparency = 0.55
	h.OutlineTransparency = 0.1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = boat
	TweenService:Create(h, TweenInfo.new(0.35), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	task.delay(0.4, function()
		h:Destroy()
	end)
end

-- 꾸미기 마당 출발 깃발 빛남 (오래 가만히 있을 때, build.idleHint): 생성기 BD_Go_* 파트에 노란 하이라이트
local goGlow: Highlight? = nil
local function setGoGlow(on: boolean)
	if not on then
		if goGlow then
			goGlow:Destroy()
			goGlow = nil
		end
		return
	end
	if goGlow then
		return
	end
	local folder = SceneBindings.getFolder("Decorations")
	local flagPart = folder and folder:FindFirstChild("BD_Go_Flag")
	if not flagPart then
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "CampGoGlow"
	h.FillColor = Palette.Yellow
	h.OutlineColor = Palette.Yellow
	h.FillTransparency = 0.35
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Adornee = flagPart
	h.Parent = flagPart
	goGlow = h
	-- 숨 쉬듯 깜빡
	task.spawn(function()
		while goGlow == h and h.Parent do
			TweenService:Create(h, TweenInfo.new(0.6), { FillTransparency = 0.75 }):Play()
			task.wait(0.6)
			if goGlow ~= h then
				break
			end
			TweenService:Create(h, TweenInfo.new(0.6), { FillTransparency = 0.3 }):Play()
			task.wait(0.6)
		end
	end)
end

local function attachFire(part: BasePart)
	if fires[part] then
		return
	end
	fires[part] = true
	local fire = emitter(part, Palette.Fire, 1.6, 18, 1.1, 3)
	fire.Acceleration = Vector3.new(0, 6, 0)
	fire.LightEmission = 1
	local smoke = emitter(part, Color3.fromRGB(90, 90, 90), 2.2, 4, 2.5, 2)
	smoke.Acceleration = Vector3.new(0, 4, 0)
	smoke.LightEmission = 0
	local light = Instance.new("PointLight")
	light.Color = Palette.Fire
	light.Range = 22
	light.Brightness = 2
	light.Parent = part
end

local function attachCandle(part: BasePart)
	if candles[part] then
		return
	end
	candles[part] = true
	local light = Instance.new("PointLight")
	light.Name = "CandleLight"
	light.Color = Palette.Yellow
	light.Range = 8
	light.Brightness = 1.2
	light.Enabled = candlesLit
	light.Parent = part
	local e = emitter(part, Palette.Yellow, 0.5, 6, 0.8, 1)
	e.Name = "CandleFlame"
	e.LightEmission = 1
	e.Enabled = candlesLit
end

-- 불 크기 3단계: 불 높이·불티 수·빛 범위·바닥 빛무리 반지름 (0 = 낮, 전부 끔)
local FIRE_LEVELS = {
	-- 마감 패스: 노을 빛(DUSK)에서 네온 심·바닥 빛무리가 번져 불이 노란 덩어리로 보였다 → 심·빛무리를 줄이고 불꽃 파티클이 보이게
	[1] = { core = 0.9, fireSize = 4, heat = 7, embers = 6, smoke = 2, range = 11, bright = 1.3, glow = 3.8 },
	[2] = { core = 1.25, fireSize = 7, heat = 10, embers = 14, smoke = 4, range = 17, bright = 1.9, glow = 5.2 },
	[3] = { core = 1.7, fireSize = 10, heat = 14, embers = 28, smoke = 7, range = 25, bright = 2.6, glow = 6.6 },
}
local function applyFireLevel(f: NightFire, level: number)
	f.level = level
	local L = FIRE_LEVELS[level]
	local on = L ~= nil
	f.core.Transparency = if on then 0.35 else 1
	f.glow.Transparency = if on then 0.72 else 1
	f.fire.Enabled = on
	f.embers.Enabled = on and not reduced
	f.smoke.Enabled = on and not reduced
	f.light.Enabled = on
	if not L then
		return
	end
	local base = f.part.Position
	TweenService:Create(f.core, TweenInfo.new(0.35, Enum.EasingStyle.Back), {
		Size = Vector3.new(L.core, L.core * 1.25, L.core),
		CFrame = CFrame.new(base + Vector3.new(0, L.core * 0.35 - 0.4, 0)),
	}):Play()
	TweenService:Create(f.glow, TweenInfo.new(0.45), { Size = Vector3.new(0.12, L.glow * 2, L.glow * 2) }):Play()
	f.fire.Size = L.fireSize
	f.fire.Heat = L.heat
	f.embers.Rate = L.embers
	f.smoke.Rate = L.smoke
	f.light.Range = L.range
	f.light.Brightness = L.bright
end

local function attachNightFire(part: BasePart)
	if nightFires[part] then
		return
	end
	local base = part.Position
	local core = Instance.new("Part")
	core.Name = "CampFireCore"
	core.Shape = Enum.PartType.Ball
	core.Material = Enum.Material.Neon
	core.Color = Palette.Fire
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Size = Vector3.new(1, 1, 1)
	core.CFrame = CFrame.new(base)
	core.Transparency = 1
	core.Parent = workspace
	local glow = Instance.new("Part")
	glow.Name = "CampFireGlow"
	glow.Shape = Enum.PartType.Cylinder
	glow.Material = Enum.Material.Neon
	glow.Color = Color3.fromRGB(255, 150, 70)
	glow.Anchored = true
	glow.CanCollide = false
	glow.CanQuery = false
	glow.CanTouch = false
	glow.CastShadow = false
	glow.Size = Vector3.new(0.12, 8, 8)
	glow.CFrame = CFrame.new(base.X, base.Y - 1.1, base.Z) * CFrame.Angles(0, 0, math.rad(90))
	glow.Transparency = 1
	glow.Parent = workspace
	local fire = Instance.new("Fire")
	fire.Color = Palette.Fire
	fire.SecondaryColor = Palette.Yellow
	fire.Size = 4
	fire.Heat = 7
	fire.Enabled = false
	fire.Parent = core
	local embers = emitter(core, Palette.Yellow, 0.22, 10, 1.8, 5)
	embers.Name = "Embers"
	embers.Color = ColorSequence.new(Palette.Yellow, Palette.Fire)
	embers.LightEmission = 1
	embers.Acceleration = Vector3.new(0, 7, 0)
	embers.Drag = 1.5
	embers.SpreadAngle = Vector2.new(50, 50)
	embers.Enabled = false
	local smoke = emitter(core, Color3.fromRGB(80, 78, 74), 2.4, 3, 3.2, 2)
	smoke.Name = "Smoke"
	smoke.Acceleration = Vector3.new(0.5, 4, 0)
	smoke.LightEmission = 0
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	smoke.Enabled = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = 11
	light.Brightness = 1.3
	light.Shadows = true
	light.Enabled = false
	light.Parent = core
	local f: NightFire = {
		part = part,
		core = core,
		glow = glow,
		fire = fire,
		embers = embers,
		smoke = smoke,
		light = light,
		level = 0,
		flareUntil = 0,
		phase = math.random() * 6,
	}
	nightFires[part] = f
	applyFireLevel(f, tonumber(part:GetAttribute("FireLevel")) or 0)
	part:GetAttributeChangedSignal("FireLevel"):Connect(function()
		applyFireLevel(f, tonumber(part:GetAttribute("FireLevel")) or 0)
	end)
end

-- 빛 깜빡임 (Heartbeat — 창이 안 그릴 때도 멈추지 않게)
local function flickerFires(t: number)
	for part, f in pairs(nightFires) do
		if not part.Parent then
			f.core:Destroy()
			f.glow:Destroy()
			nightFires[part] = nil
			continue
		end
		local L = FIRE_LEVELS[f.level]
		if not L then
			continue
		end
		local n = 0.5 + 0.5 * math.sin(t * 9.1 + f.phase) * math.sin(t * 5.3 + f.phase * 2)
		local flare = if t < f.flareUntil then 1 + 0.7 * ((f.flareUntil - t) / 0.6) else 1
		f.light.Brightness = L.bright * (0.86 + 0.28 * n) * flare
		f.light.Range = L.range * (0.95 + 0.08 * n) * math.min(flare, 1.25)
		f.glow.Transparency = 0.86 - 0.07 * n - (flare - 1) * 0.12
		f.core.Size = Vector3.new(L.core, L.core * (1.2 + 0.12 * n) * math.min(flare, 1.2), L.core)
	end
end

-- 넣기: 불꽃이 확 일고 불티가 터진다
local function flareFire(pos: Vector3?)
	local best: NightFire? = nil
	local bestD = 30
	for _, f in pairs(nightFires) do
		if f.level > 0 then
			local d = if pos then (f.part.Position - pos).Magnitude else 0
			if d < bestD then
				best, bestD = f, d
			end
		end
	end
	if best then
		best.flareUntil = os.clock() + 0.6
		if not reduced then
			best.embers:Emit(18)
		end
	end
end

local function setCandles(on: boolean)
	candlesLit = on
	for part in pairs(candles) do
		local l = part:FindFirstChild("CandleLight") :: PointLight?
		local e = part:FindFirstChild("CandleFlame") :: ParticleEmitter?
		if l then
			l.Enabled = on
		end
		if e then
			e.Enabled = on
		end
	end
end

local function scan()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if not inst:IsA("BasePart") or seen[inst] then
			continue
		end
		local kind: string? = nil
		if inst:GetAttribute("Flag") == true or string.find(inst.Name, "_Flag") then
			kind = "FLAG"
		elseif inst:GetAttribute("Crab") == true then
			kind = "CRAB"
		elseif inst:GetAttribute("Firefly") == true then
			kind = "FIREFLY"
		elseif inst:GetAttribute("WaveFoam") == true then
			kind = "FOAM"
		elseif inst:GetAttribute("Buoy") == true then
			kind = "BUOY"
		elseif inst:GetAttribute("Rope") == true then
			kind = "ROPE"
		end
		if inst:GetAttribute("CampFlame") == true or inst:GetAttribute("FireRing") == true then
			seen[inst] = true
			attachFire(inst)
			continue
		end
		if inst:GetAttribute("Kind") == "FIRE" and inst:GetAttribute("FireId") ~= nil then
			seen[inst] = true
			attachNightFire(inst) -- 밤 모닥불 (1단계): FireLevel 속성으로 켜고 끈다
			continue
		end
		if inst:GetAttribute("Candle") == true then
			seen[inst] = true
			attachCandle(inst)
			continue
		end
		if kind then
			seen[inst] = true
			table.insert(anims, { part = inst, base = inst.CFrame, phase = (#anims % 9) * 0.7, kind = kind })
			if kind == "FIREFLY" then
				local l = Instance.new("PointLight")
				l.Color = Palette.Firefly
				l.Range = 6
				l.Brightness = 0.8
				l.Parent = inst
			end
		end
	end
	-- 사라진 파트 정리
	for i = #anims, 1, -1 do
		if not anims[i].part.Parent then
			seen[anims[i].part] = nil
			table.remove(anims, i)
		end
	end
end

local function step(t: number)
	if reduced then
		return
	end
	for _, a in ipairs(anims) do
		local p = a.part
		if a.kind == "FLAG" then
			p.CFrame = a.base * CFrame.Angles(0, math.sin(t * 2.2 + a.phase) * 0.18, math.sin(t * 3.1 + a.phase) * 0.06)
		elseif a.kind == "CRAB" then
			local s = math.sin(t * 1.3 + a.phase)
			p.CFrame = a.base * CFrame.new(s * 4, math.abs(math.sin(t * 9 + a.phase)) * 0.15, 0)
		elseif a.kind == "FIREFLY" then
			p.CFrame = a.base
				* CFrame.new(
					math.sin(t * 0.7 + a.phase) * 3,
					math.sin(t * 1.1 + a.phase) * 1.2,
					math.cos(t * 0.5 + a.phase) * 3
				)
			p.Transparency = 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 2.5 + a.phase * 3))
		elseif a.kind == "FOAM" then
			p.CFrame = a.base * CFrame.new(0, math.sin(t * 1.5 + a.phase) * 0.25, 0)
			p.Transparency = 0.5 + 0.3 * math.sin(t * 1.5 + a.phase)
		elseif a.kind == "BUOY" then
			p.CFrame = a.base
				* CFrame.new(0, math.sin(t * 1.4 + a.phase) * 0.3, 0)
				* CFrame.Angles(math.sin(t + a.phase) * 0.08, 0, math.cos(t * 0.9 + a.phase) * 0.08)
		elseif a.kind == "ROPE" then
			p.CFrame = a.base * CFrame.Angles(math.sin(t * 0.8 + a.phase) * 0.06, 0, math.sin(t * 1.1 + a.phase) * 0.05)
		end
	end
end

-- ===== 밤·손전등 (Lighting 은 클라이언트에서만 바꾼다) =====
local savedLighting: { [string]: any }? = nil
-- 가로등·등불: 밤에만 켠다 (Lighting_Parts 의 PointLight + 네온 전구 밝기)
local lampsOn: boolean? = nil
local lampFolderHooked = false
local function applyLamp(p: Instance, on: boolean)
	if not p:IsA("BasePart") then
		return
	end
	for _, l in ipairs(p:GetChildren()) do
		if l:IsA("PointLight") then
			l.Enabled = on
		end
	end
	p.Material = if on then Enum.Material.Neon else Enum.Material.Glass
	p.Color = if on then Palette.Yellow else Color3.fromRGB(190, 186, 170) -- 낮에는 회백색 유리 (켜진 듯 보이지 않게)
	p.Transparency = if on then 0 else 0.1
end
-- StreamingEnabled: 첫 스냅샷 때 폴더/전구가 아직 없을 수 있다 → 폴더가 없으면 상태를 남기지 않고, 뒤에 들어오는 전구에도 적용 (Studio 2026-10-18 3차: 낮에도 34개 켜져 있던 원인)
local function setLamps(on: boolean)
	local folder = SceneBindings.getFolder("LightingParts")
	if not folder then
		lampsOn = nil
		return
	end
	if not lampFolderHooked then
		lampFolderHooked = true
		folder.ChildAdded:Connect(function(c)
			if lampsOn ~= nil then
				applyLamp(c, lampsOn :: boolean)
			end
			-- 스트리밍은 파트가 먼저 오고 PointLight 자식이 뒤따라온다
			c.ChildAdded:Connect(function(l)
				if l:IsA("PointLight") and lampsOn ~= nil then
					l.Enabled = lampsOn :: boolean
				end
			end)
		end)
	end
	if lampsOn == on then
		return
	end
	lampsOn = on
	for _, p in ipairs(folder:GetChildren()) do
		applyLamp(p, on)
	end
end
local lastNight = false
-- 빛 세 가지 (마감 패스 M069): 낮(생성기·CampArt LOOK 그대로) · 노을(1·2·3박 모닥불 — 불빛이 보이게 따뜻한 해 질 녘) · 밤(5일차 야간 침투·5박 촛불 광장)
-- 낮이 아닐 때 처음 들어가면 지금 값을 저장해 두고, 낮으로 돌아오면 그 값으로 되돌린다. 같은 빛이면 아무것도 안 한다(스냅샷마다 트윈 다시 걸지 않게)
type LookPreset = { lighting: { [string]: any }, air: { [string]: { [string]: any } } }
local LOOKS: { [string]: LookPreset } = {
	DUSK = {
		lighting = {
			ClockTime = 18.3,
			Brightness = 1.75,
			OutdoorAmbient = Color3.fromRGB(140, 116, 116),
			Ambient = Color3.fromRGB(100, 82, 78),
			FogColor = Color3.fromRGB(200, 150, 124),
			FogEnd = 100000,
		},
		air = {
			Atmosphere = {
				Color = Color3.fromRGB(220, 160, 126),
				Decay = Color3.fromRGB(98, 78, 116),
				Haze = 1.9,
				Density = 0.34,
			},
			ColorCorrectionEffect = { TintColor = Color3.fromRGB(255, 234, 214), Saturation = 0.08, Contrast = 0.1 },
		},
	},
	NIGHT = {
		lighting = {
			ClockTime = 20.5,
			FogEnd = 220,
			FogColor = Palette.Night,
			Brightness = 0.6,
			OutdoorAmbient = Color3.fromRGB(40, 48, 70),
			Ambient = Color3.fromRGB(36, 40, 56),
		},
		air = {
			Atmosphere = {
				Color = Color3.fromRGB(40, 48, 72),
				Decay = Color3.fromRGB(20, 24, 40),
				Haze = 0.6,
				Density = 0.36,
			},
			ColorCorrectionEffect = { TintColor = Color3.fromRGB(214, 224, 255), Saturation = -0.08, Contrast = 0.04 },
		},
	},
}
-- 낮 공기·색 보정 저장값 (생성기 LOOK, 19_UI_MAP_STYLE §4)
local savedAir: { [Instance]: { [string]: any } } = {}
local currentLook = "DAY"
local function setLook(kind: string)
	if kind == currentLook then
		return
	end
	currentLook = kind
	lastNight = kind ~= "DAY"
	setLamps(kind ~= "DAY")
	local preset = LOOKS[kind]
	-- 공기·색 보정: Atmosphere 가 있으면 옛 FogEnd 는 무시된다
	for className in pairs(LOOKS.NIGHT.air) do
		local e = Lighting:FindFirstChildOfClass(className :: any)
		if not e then
			continue
		end
		if preset then
			local goal = preset.air[className]
			if not savedAir[e] then
				local keep = {}
				for k in pairs(goal) do
					keep[k] = (e :: any)[k]
				end
				savedAir[e] = keep
			end
			TweenService:Create(e, TweenInfo.new(2), goal :: any):Play()
		elseif savedAir[e] then
			TweenService:Create(e, TweenInfo.new(2), savedAir[e] :: any):Play()
			savedAir[e] = nil
		end
	end
	if preset then
		if not savedLighting then
			local keep = {}
			for k in pairs(preset.lighting) do
				keep[k] = (Lighting :: any)[k]
			end
			savedLighting = keep
		end
		TweenService:Create(Lighting, TweenInfo.new(2), preset.lighting :: any):Play()
	elseif savedLighting then
		TweenService:Create(Lighting, TweenInfo.new(2), savedLighting :: any):Play()
		savedLighting = nil
	end
end

local function setFlashlight(on: boolean)
	local ch = player.Character
	local head = ch and ch:FindFirstChild("Head")
	if flashlight then
		flashlight:Destroy()
		flashlight = nil
	end
	if on and head then
		local l = Instance.new("SpotLight")
		l.Range = 60
		l.Angle = 55
		l.Brightness = 1.8 -- 마감 패스: 3 은 흙길을 회색 판처럼 하얗게 태웠다
		l.Color = Color3.fromRGB(255, 238, 205)
		l.Face = Enum.NormalId.Front
		l.Parent = head
		flashlight = l
	end
end

local function boatPos(): Vector3?
	local b = myBoat()
	return if b then b:GetPivot().Position else nil
end

-- ===== 살리기 (2단계, 28 §4): 넘어짐 흙먼지 · 일으키기 반짝 · 얼음 덩어리(반투명 유리, 서리) · 땡 조각 =====
local ICE_COLOR = Color3.fromRGB(186, 228, 255)
local ice: { [string]: BasePart } = {}

local function characterOfWho(who: string): Model?
	if who == "ME" then
		return player.Character
	end
	local folder = SceneBindings.getFolder("Runtime")
	local holder = folder and folder:FindFirstChild("CampSquads")
	local mine = holder and holder:FindFirstChild("Squad_" .. Net.boatOwnerId())
	local model = mine and mine:FindFirstChild("Npc_" .. who)
	return if model and model:IsA("Model") then model else nil
end

local function thawIce(who: string, quiet: boolean)
	local block = ice[who]
	if not block then
		return
	end
	ice[who] = nil
	local pos = block.Position
	for _, e in ipairs(block:GetChildren()) do
		if e:IsA("ParticleEmitter") then
			e.Enabled = false
		end
	end
	TweenService:Create(block, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Transparency = 1,
		Size = block.Size * 1.15,
	}):Play()
	if not quiet then
		burst(pos, ICE_COLOR, 26, 0.7)
		burst(pos + Vector3.new(0, 1, 0), Palette.Cream, 12, 0.45)
	end
	task.delay(0.3, function()
		block:Destroy()
	end)
end

local function freezeIce(who: string, pos: Vector3)
	thawIce(who, true)
	local ch = characterOfWho(who)
	local size = Vector3.new(3.6, 6.2, 2.8)
	local center = pos
	if ch then
		local cf, ext = ch:GetBoundingBox()
		size = Vector3.new(math.max(3.2, ext.X + 1.2), math.max(5.6, ext.Y + 0.8), math.max(2.6, ext.Z + 1.2))
		center = cf.Position
	end
	local block = Instance.new("Part")
	block.Name = "CampIce_" .. who
	block.Anchored = true
	block.CanCollide = false
	block.CanQuery = false
	block.CanTouch = false
	block.CastShadow = false
	block.Material = Enum.Material.Glass
	block.Color = ICE_COLOR
	block.Reflectance = 0.15
	block.Transparency = 1
	block.Size = size * 0.8
	block.CFrame = CFrame.new(center) * CFrame.Angles(0, math.rad(8), math.rad(-4))
	block.Parent = workspace
	local light = Instance.new("PointLight")
	light.Color = ICE_COLOR
	light.Range = 9
	light.Brightness = 0.9
	light.Parent = block
	-- 서리: 위로 천천히 날리는 흰 조각
	local frost = emitter(block, Palette.Cream, 0.35, 8, 1.6, 1.2)
	frost.Acceleration = Vector3.new(0, 0.6, 0)
	frost.LightEmission = 0.6
	if reduced then
		block.Transparency = 0.45
		block.Size = size
	else
		TweenService:Create(block, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Transparency = 0.45,
			Size = size,
		}):Play()
		burst(center, ICE_COLOR, 18, 0.6)
	end
	ice[who] = block
	-- 안전장치: 풀림 큐가 안 와도 사라진다
	task.delay(7, function()
		if ice[who] == block then
			thawIce(who, true)
		end
	end)
end

local function onFx(c: any)
	-- 탑승(4·5단계) 연출은 RideFx 가 그린다: 같은 이름(SPLASH·WAVE·WAVE_WARN)을 여기서 또 그리지 않는다
	if Net.state() == S.RIDE and (c.kind == "SPLASH" or c.kind == "WAVE" or c.kind == "WAVE_WARN") then
		return
	end
	local pos = boatPos()
	if c.kind == "SPLASH" and pos then
		burst(pos, Palette.SeaFoam, 40, 1.5)
	elseif c.kind == "WAVE" and pos then
		burst(pos + Vector3.new(0, -0.5, 0), Palette.SeaFoam, 12, 1)
	elseif c.kind == "CP" and pos then
		burst(pos + Vector3.new(0, 3, 0), Palette.Yellow, 60, 1.2)
		burst(pos + Vector3.new(0, 3, 0), Palette.Red, 40, 1)
	elseif c.kind == "FLAG" and typeof(c.pos) == "Vector3" then
		-- 자유 스테이지 깃발 찍음 (22 v2): 깃발 꼭대기에서 노란·초록 조각
		burst(c.pos + Vector3.new(0, 8, 0), Palette.Yellow, 40, 1.1)
		burst(c.pos + Vector3.new(0, 6, 0), Color3.fromHex("8EE59A"), 24, 0.9)
	elseif c.kind == "STICKER" and pos then
		burst(pos + Vector3.new(-3, 1, 0), Palette.Cream, 15, 0.6)
	elseif c.kind == "BELL" and c.pos then
		burst(c.pos + Vector3.new(0, 4, 0), Palette.Yellow, 30, 1)
	elseif c.kind == "CANDLES" then
		setCandles(true)
	elseif c.kind == "GRADUATE" and pos then
		for i = 1, 5 do
			task.delay(i * 0.4, function()
				burst(pos + Vector3.new((i - 3) * 4, 6, 0), if i % 2 == 0 then Palette.Yellow else Palette.Red, 40, 1.2)
			end)
		end
	elseif c.kind == "FLASHLIGHT" then
		setFlashlight(c.on == true)
	elseif c.kind == "SEALED" and pos then
		burst(pos + Vector3.new(0, 2, 0), Palette.Cream, 25, 0.8)
	-- 모닥불 허브 (1단계, 28 §4): 줍기 나무 부스러기 · 넣기 불꽃 확 · 나누기 따뜻한 톡 (하트 없음)
	elseif c.kind == "PICKUP" and typeof(c.pos) == "Vector3" then
		burst(c.pos + Vector3.new(0, 0.8, 0), if c.pickType == "WATER" then Palette.SeaFoam else Palette.Wood, 10, 0.5)
		burst(c.pos + Vector3.new(0, 0.5, 0), Palette.Sand, 6, 0.4)
	elseif c.kind == "FIRE_FEED" then
		local p = if typeof(c.pos) == "Vector3" then c.pos else nil
		flareFire(p)
		if p and not c.mime then
			burst(p + Vector3.new(0, 1.2, 0), Palette.Yellow, 22, 0.45)
			burst(p + Vector3.new(0, 1.6, 0), Palette.Fire, 14, 0.7)
		end
	elseif c.kind == "FIRE_LEVEL" and typeof(c.pos) == "Vector3" then
		flareFire(c.pos)
		if tonumber(c.level) == 3 then
			burst(c.pos + Vector3.new(0, 2.5, 0), Palette.Yellow, 40, 0.6)
		end
	elseif c.kind == "GIVE" and typeof(c.pos) == "Vector3" then
		burst(c.pos + Vector3.new(0, 2.4, 0), Palette.Cream, 14, 0.7)
		burst(c.pos + Vector3.new(0, 2.6, 0), Palette.Yellow, 8, 0.5)
	-- 살리기 (2단계): 넘어짐 흙먼지 · 일으키기 반짝(하트 없음) · 얼음 덩어리 · 땡
	elseif c.kind == "FALL_NPC" and typeof(c.pos) == "Vector3" then
		burst(c.pos + Vector3.new(0, 0.6, 0), Palette.Sand, 16, 0.9)
		burst(c.pos + Vector3.new(0, 0.4, 0), Palette.Mud, 6, 0.6)
	elseif c.kind == "REVIVE" and typeof(c.pos) == "Vector3" then
		burst(c.pos, Palette.Yellow, 26, 0.5)
		burst(c.pos + Vector3.new(0, 0.6, 0), Palette.Cream, 14, 0.4)
	elseif c.kind == "FREEZE" and typeof(c.pos) == "Vector3" then
		freezeIce(tostring(c.who or "ME"), c.pos)
	elseif c.kind == "THAW" then
		thawIce(tostring(c.who or "ME"), c.quiet == true)
	-- 유보트 꾸미기 (3단계): 붙이기 = 톡 터지는 고리 + 나무 부스러기 + 노란 반짝 · 집기 = 작은 먼지 · 내밀기 = 머리 위 반짝
	elseif c.kind == "ATTACH" and typeof(c.pos) == "Vector3" then
		popRing(c.pos, if c.sticker then Palette.Cream else Palette.Yellow)
		burst(c.pos + Vector3.new(0, 0.4, 0), Palette.Wood, 16, 0.5)
		burst(c.pos + Vector3.new(0, 0.8, 0), Palette.Yellow, 12, 0.4)
		bumpBoat()
	elseif c.kind == "PICK" and typeof(c.pos) == "Vector3" then
		burst(c.pos + Vector3.new(0, 0.6, 0), Palette.Sand, 8, 0.5)
		burst(c.pos + Vector3.new(0, 1.0, 0), Palette.Cream, 5, 0.35)
	elseif c.kind == "OFFER" and typeof(c.pos) == "Vector3" then
		burst(c.pos, Palette.Yellow, 14, 0.35)
		popRing(c.pos - Vector3.new(0, 2.4, 0), Palette.Yellow)
	end
end

function CourseFx.start()
	scan()
	task.spawn(function()
		while true do
			task.wait(4)
			scan()
			if lampsOn == nil then
				setLamps(lastNight)
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		step(os.clock())
	end)
	RunService.Heartbeat:Connect(function()
		flickerFires(os.clock())
	end)
	Net.FxCue:Connect(onFx)
	Net.SnapshotChanged:Connect(function(snap)
		reduced = snap.settings.reducedMotion == true
		setGoGlow(snap.state == S.BUILD and snap.build ~= nil and snap.build.idleHint) -- 꾸미기: 출발 깃발 빛남 (3단계)
		local night = snap.state == S.OBBY and snap.day == 5 -- 5일차 야간 침투 (손전등은 서버가 저절로 켠다, 6단계)
		-- 5박 모닥불(촛불 광장)은 밤, 퇴소 편지(6일차 무대)는 낮 (13_FINAL_LETTER)
		local fireNight = snap.state == S.NIGHT and snap.day == 5
		-- 1·2·3박(안 날 1·2·4) 모닥불은 노을 — 불빛·등이 보이고 얼굴도 보인다 (마감 패스 M069; 19 §7 의 "밤도 낮빛" 을 바꿈)
		local dusk = snap.state == S.NIGHT and not fireNight
		setLook(if night or fireNight then "NIGHT" elseif dusk then "DUSK" else "DAY")
		if fireNight then
			setCandles(true)
		elseif snap.state == S.CAMP or snap.state == S.OBBY then
			setCandles(false)
		end
		if not snap.flashlight and flashlight then
			setFlashlight(false)
		end
	end)
end

return CourseFx
]]></string>
              <int64 name="SourceAssetId">-1</int64>
