          <string name="Source"><![CDATA[--!strict
-- 클라이언트 진입점 (유일한 시작 스크립트). 컨트롤러를 순서대로 시작한다.
-- 순서: Net → 입력 → 분대원 표시 → HUD → 박자 → 이야기 → 배치 → 밤·편지·퇴소 → 연출·카메라 → 친구 → 소리 → 설정
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local Controllers = script:WaitForChild("Controllers")

local function start(name: string)
	local ok, err = pcall(function()
		local mod = require(Controllers:WaitForChild(name)) :: any
		if typeof(mod.start) == "function" then
			mod.start()
		end
	end)
	if not ok then
		warn("[Camp] controller failed: " .. name .. " — " .. tostring(err))
	end
end

local Net = require(Controllers:WaitForChild("Net"))
start("InputController")
start("IntroCard")
start("SquadPresence")
start("CampHud")
start("BeatHud")
start("StoryController")
start("LoadoutPanel")
start("NightPanel")
start("LetterPanel")
start("EndingPanel")
start("TrainingController")
start("RangeController")
start("LeaderboardPanel")
start("PhotoController")
start("CourseFx")
start("RideFx") -- 탑승 물결·물보라·갑판 빛·밧줄·폭포 "붕" (4·5단계)
start("PromptController")
start("WayFx") -- 첫 1분: 스폰 → 꾸미기 마당 바닥 화살표·발판·▼ (28 §7)
start("CameraController")
start("CoopController")
start("AudioController")
start("SettingsController")

Net.fire(ProtocolTypes.ClientToServer.ClientReady, {})
print("[Camp] client ready")
]]></string>
          <int64 name="SourceAssetId">-1</int64>
