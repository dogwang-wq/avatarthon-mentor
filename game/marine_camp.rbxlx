            <string name="Source"><![CDATA[--!strict
-- 플레이어별 세션: 소대·유보트·진행·이야기·저장. 모든 판정은 여기(서버)에서 한다.
-- 상태 흐름은 docs/design/03_FLOW_AND_RULES.md §1. 세그먼트 규칙 §3. 밤 §6. 편지 §7. 퇴소식 §8.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local ProfileStoreService = require(script.Parent.ProfileStoreService)
local BoatService = require(script.Parent.BoatService)
local RhythmService = require(script.Parent.RhythmService)
local SquadNpcService = require(script.Parent.SquadNpcService)
local LetterService = require(script.Parent.LetterService)
local TelemetryService = require(script.Parent.TelemetryService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local CampfireService = require(script.Parent.CampfireService) -- 모닥불 허브 (28 §2, 1단계): 낮 줍기·밤 불·E 셋
local RescueService = require(script.Parent.RescueService) -- 살리기 (28 §2, 2단계): 분대원 넘어짐·얼음(나·분대원)·E 일으키기/풀기
local BoatBuildService = require(script.Parent.BoatBuildService) -- 유보트 꾸미기 (28 §2, 3단계): 1일차 1-A 연병장 E 집기·싣기·자리 발판·분대원 내밀기
local WelcomeService = require(script.Parent.WelcomeService) -- 첫 1분 (28 §7): 1일차 전 기지 → 꾸미기 마당 (분대원이 먼저 달려감·걸어 들어가면 시작)
local RideService = require(script.Parent.RideService) -- 탑승 (28 §2, 4·5단계): 1일차 급류 · 4일차 바다 노 젓기 (물리 배·무게 이동·낙수·끌어올리기)
local BeatPatterns = require(Shared:WaitForChild("BeatPatterns"))
local TrainingCatalog = require(Shared:WaitForChild("TrainingCatalog"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local Palette = require(Shared:WaitForChild("Palette"))

local SessionService = {}

local S = ProtocolTypes.SessionState
local E = ProtocolTypes.ErrorCode
local S2C = ProtocolTypes.ServerToClient
local R = GameConfig.Rhythm

export type Member = {
	id: string,
	def: SquadCatalog.Member,
	rig: SquadNpcService.Rig?,
	friendUserId: number?,
	morale: number,
	waiting: boolean,
}

-- 6일차 사격 문 하나: 표적 group·필요 수·맞힌 수(그중 내가 맞힌 수)·서 있는 표적·열림·막는 벽
export type GateState = {
	group: string,
	need: number,
	hits: number,
	mine: number,
	up: { [number]: boolean },
	open: boolean,
	part: BasePart,
}

export type Obby = {
	pads: { SceneBindings.Pad },
	padIdx: number,
	falls: number,
	bellRung: boolean,
	lastFallAt: number, -- 팔다리 여러 파트가 같은 프레임에 닿아도 추락 1번만 센다
	sanHelpedAt: number?, -- 산 돕기(E·Prompt) 시각: E 한 번에 두 경로가 같이 와도 안내가 겹치지 않게
	fallsByPad: { [number]: number }, -- 같은 발판에서 떨어진 횟수 (FallHelpAfter 도움 사다리, 20)
	sanStopped: boolean, -- 밤 일지 흔적 (20): 산이 그물 앞에서 멈췄나
	cpBlockedAt: number?, -- 깃발을 덜 찍고 도착점에 왔을 때 안내한 시각 (21)
	-- 자유 이동 스테이지 (22 v2): 깃발(아무 순서)·발각·사격 문·탈출 시간·분대 응원
	flags: { [string]: boolean },
	flagsDone: number,
	flagsNeed: number,
	respawn: Vector3?, -- 떨어지면 돌아갈 자리 (마지막 발판 또는 깃발)
	gates: { [string]: GateState },
	gateAt: string?, -- 지금 내가 서 있는 사격 문 (분대원이 옆에 섰나)
	gateSquadNext: { [string]: number }, -- 분대원 id → 다음에 쏘는 시각 (6단계)
	escapeDeadline: number?,
	spotCount: number,
	lastSpotAt: number,
	lastPos: Vector3?, -- 지난 틱 내 자리 (빛 안에서 움직였는지는 자리 변화로 잰다 — 클라이언트 소유 캐릭터의 속도는 서버에서 믿기 어렵다)
	cheerAt: number,
	cheerIdx: number,
}

export type Training = {
	stationId: string,
	startBeat: number,
	beatsTotal: number,
	good: number,
	ok: number,
	miss: number,
	judged: { [number]: boolean },
	lastBeat: number,
	-- 모의 사격 (14 §5)
	kind: string?,
	endAt: number?,
	up: { [number]: number }?, -- 표적 번호 → 내려가는 시각
	nextPopAt: number?,
}

-- 오늘 탄 기록 (4·5단계): 빠진 수·바위 쿵/비껴감·누가 누구를 끌어올렸나 (점수 아님 — 밤 일지에 사실만)
export type RideLog = {
	kind: string,
	falls: number,
	bumps: number,
	dodges: number,
	fellBy: { [string]: number }, -- 빠진 사람 id → 횟수
	pulledByMe: { [string]: number }, -- 내가 끌어올린 분대원
	pulledMe: { [string]: number }, -- 나를 끌어올린 분대원
	ledByMe: number, -- 급류 2차: 내가 먼저 맞는 쪽으로 움직인 바위·파도 (점수 아님 — 밤 일지 한 줄)
	wood: number, -- 물 위에서 건진 장작
	water: number, -- 물 위에서 건진 물통
}

export type Session = {
	player: Player,
	userId: number,
	handle: ProfileStoreService.Handle,
	state: string,
	day: number,
	loadout: ProtocolTypes.Loadout,
	members: { [string]: Member },
	boat: BoatService.BoatHandle,
	beat: RhythmService.Clock, -- 체력단련장 박자 미니게임 시계 (TRAINING 에서만 쓴다)
	obby: Obby?,
	ride: RideService.Handle?, -- 탑승 물리 배 (4·5단계): RIDE 상태 동안만
	rideLog: RideLog?, -- 오늘 탄 기록 (밤 일지·오늘의 발견). 다음 startDay 에서 비운다
	rideDirtyAt: number, -- 진행 막대용 스냅샷 갱신 시각
	flashlight: boolean, -- 5일차 야간: 손전등이 저절로 켜진다 (6단계 — F 키 없음)
	bubbleHold: { [string]: number }, -- 인물의 말이 떠 있는 동안(멤버 id → os.clock) 잡음 말풍선을 덮지 않는다
	pattern: BeatPatterns.Pattern, -- 체력단련장 박자 기구의 기대 키 패턴 (07_PHASE2)
	lastAttempt: ProtocolTypes.Loadout?, -- 한 번 더(재도전) 직전 배치: 밤 일지에서 "지난 번" 과 비교
	rel: { helped: { [string]: number }, helpedMe: { [string]: number } }, -- 이번 입소 동안 내가 도운 사람(일으키기·땡·끌어올리기)·나를 도운 사람 (퇴소식 한 줄·편지 칩)
	rec: {
		sanNet: boolean,
		gateMine: number?, -- 6일차 사격 문에서 내가 맞힌 표적 수 (6단계, 편지 칩 — 점수 아님)
		fireFed: number?, -- 모닥불에 내가 넣은 장작 (1단계, 기록만)
		gaveTo: number?, -- 밤에 나눠 준 횟수 (1단계, 기록만)
		ridePulls: number?, -- 급류·바다에서 내가 끌어올린 분대원 수 (4·5단계, 기록만)
		rideFalls: number?, -- 급류·바다에서 빠진 수 (나 + 분대원, 기록만)
		revives: number?, -- 넘어진 분대원을 일으킨 수 (2단계, 기록만 — 점수 아님)
		autoUps: number?, -- 스스로 일어난 수 (2단계)
		thaws: number?, -- 언 분대원을 풀어 준 수 (2단계)
	}, -- 이번 입소 기록 (퇴소 편지 칩)
	letterChipSet: { [string]: boolean }, -- 이번 퇴소 편지에 보여 준 칩 (검증용)
	-- 작전 기록 (15_RECORDS)
	stageDay: number?, -- 지금 재는 작전 (nil = 안 잼)
	stageStartAt: number, -- os.clock
	stageStartServer: number, -- 서버 시각 (클라이언트 타이머)
	stagePaused: number, -- 도착 환호 등 뺄 시간
	timingInvalid: boolean, -- Studio DevApi 로 건너뛴 작전은 기록하지 않는다
	lastStage: { day: number, cs: number, best: number, newBest: boolean, rank: number? }?,
	training: Training?,
	snapshotDirty: boolean,
	rng: Random,
	letterDone: boolean,
	coop: { role: string, partnerUserId: number, memberId: string? }?,
	inputCount: number,
	inputWindowAt: number,
	currentCp: string,
}

SessionService.Sessions = {} :: { [number]: Session }

local scene: SceneBindings.Scene? = nil
local remotes: { [string]: RemoteEvent } = {}
local npcFolder: Folder? = nil

function SessionService.setScene(s: SceneBindings.Scene)
	scene = s
	-- 낮 줍기(PICKUP)는 세상 공유: 프롬프트를 한 번 달고, 누른 사람의 세션을 찾아 준다 (1단계)
	CampfireService.setScene(s, function(userId: number)
		return SessionService.Sessions[userId]
	end)
	RescueService.setScene(s) -- 넘어질 자리(깃발·추락 영역·탐조등)·언 분대원 자리 (2단계)
	BoatBuildService.setScene(s) -- 거치대·부품 더미·자리 발판 (3단계)
end

function SessionService.setRemotes(r: { [string]: RemoteEvent })
	remotes = r
end

function SessionService.get(userId: number): Session?
	return SessionService.Sessions[userId]
end

local function fire(session: Session, name: string, payload: any)
	local r = remotes[name]
	if r then
		r:FireClient(session.player, payload)
	end
end

local function result(session: Session, requestId: string, accepted: boolean, code: string, data: any?)
	fire(session, S2C.ActionResult, { requestId = requestId, accepted = accepted, code = code, data = data })
end

local function cue(session: Session, kind: string, payload: { [string]: any })
	payload.kind = kind
	fire(session, S2C.StoryCue, payload)
end

local function lines(session: Session, list: { CampScript.Line })
	-- 조용한 분대원 (GameConfig.Quiet): 두리·산·미르 줄은 그 사람에게 말이 열려 있을 때만 (모닥불 이야기·고마움)
	if GameConfig.Quiet.Enabled then
		local kept = {}
		for _, l in ipairs(list) do
			local m = session.members[l.who]
			if not (m and m.rig and not SquadNpcService.speechAllowed(m.rig)) then
				table.insert(kept, l)
			end
		end
		if #kept == 0 then
			return
		end
		list = kept
	end
	cue(session, "LINES", { lines = list })
end

local function fx(session: Session, kind: string, extra: { [string]: any }?)
	local p: { [string]: any } = extra or {}
	p.kind = kind
	fire(session, S2C.FxCue, p)
end

local function markDirty(session: Session)
	session.snapshotDirty = true
	session.handle.dirty = true
end

-- ===== 멤버·리그 =====
local function allMembersAllowed(session: Session): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for id in pairs(session.members) do
		out[id] = true
	end
	return out
end

local function memberAtSeat(session: Session, key: string): Member?
	return session.members[session.loadout.seats[key]]
end

local function npcMembers(session: Session): { Member }
	local out = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m = session.members[id]
		if m and m.rig and not m.friendUserId then
			table.insert(out, m)
		end
	end
	return out
end

-- 통나무 앞에서 "하나! 둘!" 을 세는 사람: 두리(땅에서는 남을 챙긴다, 01 §4). 두리 자리를 친구가 맡았으면 다른 분대원
local function counterOf(session: Session): string?
	local duri = session.members.DURI
	if duri and duri.rig and not duri.friendUserId then
		return "DURI"
	end
	local first = npcMembers(session)[1]
	return if first then first.id else nil
end

-- 말풍선. filler = 박자 놓침 "앗"·악! 같은 잡음 — 인물의 말(갈림길 바람·산 "무거운 건 내가 먼저!" 등)이 떠 있는 동안은 덮지 않는다
-- (2026-10-19 Studio: 갈림길 세 사람 말이 1~2초 만에 "앗"·"어어" 로 덮였다, roblox-action-storytelling 점검)
local function bubble(session: Session, memberId: string, text: string, sec: number?, filler: boolean?)
	local now = os.clock()
	if filler then
		if now < (session.bubbleHold[memberId] or 0) then
			return
		end
	else
		session.bubbleHold[memberId] = now + (sec or 2)
	end
	local m = session.members[memberId]
	if m and m.rig then
		SquadNpcService.bubble(m.rig, text, sec)
	end
end

-- 리그를 유보트 옆에 세운다 (기지·유격)
local function standSquadBeside(session: Session)
	local i = 0
	-- 마감 패스: 내 앞쪽 왼편에 한 줄로 서서 나를 본다 (전엔 내 바로 뒤 — 카메라와 나 사이에 서서 첫 화면을 머리로 가렸다)
	local ch = session.player.Character
	local me = ch and ch:FindFirstChild("HumanoidRootPart")
	for _, m in ipairs(npcMembers(session)) do
		i += 1
		local rig = m.rig :: SquadNpcService.Rig
		local right = session.boat.root.CFrame.RightVector
		local fwd = session.boat.root.CFrame.LookVector
		local base = session.boat.root.Position + right * 9.5 + fwd * (6 + (i - 1) * 2.6)
		local face = -right
		if me and me:IsA("BasePart") then
			local to = Vector3.new(me.Position.X - base.X, 0, me.Position.Z - base.Z)
			if to.Magnitude > 1 then
				face = to.Unit
			end
		end
		SquadNpcService.standAt(rig, base, face)
		SquadNpcService.setSitting(rig, false)
	end
end

-- 모닥불 둘레에 앉힌다
local function sitSquadAroundFire(session: Session)
	local center = session.boat.root.Position - session.boat.root.CFrame.LookVector * 5
	local i = 0
	for _, m in ipairs(npcMembers(session)) do
		i += 1
		local ang = math.rad(100 + i * 70)
		local p = center + Vector3.new(math.cos(ang) * 4, 0, math.sin(ang) * 4)
		SquadNpcService.standAt(m.rig :: SquadNpcService.Rig, p, center - p)
		SquadNpcService.setSitting(m.rig :: SquadNpcService.Rig, true)
	end
end

-- 유보트에 남은 Weld·자세를 풀고 사람·분대원을 유보트 옆에 세운다 (밤·기지·퇴소 — 장면을 옮기기 전에)
local function detachSquad(session: Session)
	BoatService.detachAll(session.boat)
	if session.player.Character then
		BoatService.detach(session.boat, session.player.Character)
	end
	for _, m in pairs(session.members) do
		if m.rig then
			SquadNpcService.afterDetach(m.rig)
			SquadNpcService.setSitting(m.rig, false)
		end
	end
	local ch = session.player.Character
	if ch then
		BoatService.standBeside(session.boat, ch, 0)
	end
	for _, m in pairs(session.members) do
		if m.friendUserId then
			local fp = Players:GetPlayerByUserId(m.friendUserId)
			if fp and fp.Character then
				BoatService.standBeside(session.boat, fp.Character, 1)
			end
		end
	end
	standSquadBeside(session)
end

-- ===== 위치 =====
local function cpSpot(cpId: string): (Vector3, Vector3)
	local sc = scene
	local cp = sc and sc.cps[cpId]
	if cp then
		return cp.part.Position, cp.part.CFrame.LookVector
	end
	return Vector3.new(0, 5, 0), Vector3.new(0, 0, -1)
end

-- 첫 1분 (28 §7, WelcomeService): 다음 날이 1일차면 기지의 첫 목적지는 꾸미기 마당 — 유보트는 거치대, 나는 스폰 앞에서 마당을 본다
local function yardNext(session: Session): boolean
	return GameConfig.Welcome.Enabled and StationCatalog.nextDay(session.handle.profile.progress.day) == 1
end

local function placeAtCamp(session: Session, cpId: string, flip: boolean)
	if cpId == "CP0" and not flip and yardNext(session) then
		local rack = BoatBuildService.rackCFrame()
		BoatService.setMode(session.boat, "PARK")
		BoatService.place(session.boat, rack.Position + Vector3.new(0, 1, 0), rack.LookVector)
		session.currentCp = cpId
		local ch0 = session.player.Character
		if ch0 then
			BoatService.detach(session.boat, ch0)
			WelcomeService.placeMe(session, ch0)
		end
		WelcomeService.begin(session, not session.handle.profile.progress.tutorialDone)
		return
	end
	local pos, look = cpSpot(cpId)
	-- 밤에도 유보트는 바로 세워 둔다 (마감 패스 M069): 모닥불은 CampfireService 의 진짜 불이고, 꾸민 배(짐·노·깃발·스티커)가
	-- 불 옆에 그대로 보여야 흔적이 된다(규칙 ②). 뒤집은 메시 선체는 바닥 면이 주황 판처럼 보였다. flip 은 분대원 자리(밤)만 가른다
	BoatService.setMode(session.boat, "PARK")
	BoatService.place(session.boat, pos, look)
	session.currentCp = cpId
	local ch = session.player.Character
	if ch then
		BoatService.standBeside(session.boat, ch, 0)
	end
	if flip then
		sitSquadAroundFire(session)
	else
		standSquadBeside(session)
	end
end

-- ===== 프로필 조각 =====
local function progress(session: Session)
	return session.handle.profile.progress
end

local function addBadge(session: Session, id: string)
	local p = progress(session)
	if not table.find(p.badges, id) and CampScript.Badges[id] then
		table.insert(p.badges, id)
		cue(session, "BADGE", { text = CampScript.Badges[id] })
		TelemetryService.log("badge", { id = id })
		markDirty(session)
	end
end

local function addSticker(session: Session, id: string)
	local p = progress(session)
	if not table.find(p.stickers, id) then
		table.insert(p.stickers, id)
		BoatService.setStickers(session.boat, p.stickers)
		fx(session, "STICKER", { id = id })
		markDirty(session)
	end
end

local function addJournal(session: Session, day: number, text: string)
	local p = progress(session)
	table.insert(p.journal, { day = day, text = text })
	while #p.journal > GameConfig.Save.JournalLimit do
		table.remove(p.journal, 1)
	end
	markDirty(session)
end

-- 모닥불 허브가 쓰는 손 (28 §2, 1단계): 말·연출·말풍선·흔적·스티커·일지·저장 표시 — 상태 기계는 건드리지 않는다
CampfireService.setHooks({
	lines = lines,
	fx = fx,
	bubble = bubble,
	cue = cue,
	addSticker = addSticker,
	addJournal = addJournal,
	markDirty = markDirty,
})
-- 살리기가 쓰는 손 (28 §2, 2단계): 말·연출·말풍선·저장 표시
RescueService.setHooks({ lines = lines, fx = fx, bubble = bubble, markDirty = markDirty })
-- 유보트 꾸미기가 쓰는 손 (28 §2, 3단계): 말·연출·말풍선·뱃지·스티커·일지·저장 표시·배치 바꾸기(handleLoadout 과 같은 길)
local changeLoadoutRef: (session: any, op: string, args: { [string]: any }) -> string -- 아래 changeLoadout (정의 순서)
BoatBuildService.setHooks({
	lines = lines,
	fx = fx,
	bubble = bubble,
	addBadge = addBadge,
	addSticker = addSticker,
	addJournal = addJournal,
	markDirty = markDirty,
	changeLoadout = function(s: any, op: string, args: { [string]: any }): string
		return changeLoadoutRef(s, op, args)
	end,
})

-- ===== 스냅샷 =====
-- 조작은 걷기·점프·E 셋 (27 §1, 6단계): 박자(BEAT)는 체력단련장 기구에서만, 사격은 6일차 문·기지 사격장에서 클릭/탭만
local function allowed(session: Session): { [string]: boolean }
	local st = session.state
	local p = progress(session)
	local calm = st == S.CAMP or st == S.NIGHT -- 퇴소 편지(LETTER) 중에는 배치·친구 버튼 없음 (13)
	return {
		START_DAY = st == S.CAMP and p.day < StationCatalog.LastDay,
		BUILD_GO = st == S.BUILD, -- 꾸미기 건너뛰고 바로 출발 (플레이테스트 2026-10-21)
		-- 밤: 90초가 지났거나 모닥불 동사(넣기·나누기·앉기) 하나를 했으면 "내일로" (1단계, GameConfig.Campfire.MinNightSec)
		NEXT_DAY = (st == S.NIGHT or st == S.LETTER)
			and p.day < StationCatalog.LastDay
			and (st ~= S.NIGHT or CampfireService.nightReady(session)),
		REPLAY_DAY = st == S.NIGHT and p.day >= 1 and p.day <= 4 and session.coop == nil,
		LOADOUT = calm,
		TRAIN = st == S.CAMP,
		BEAT = st == S.TRAINING,
		-- E: 넘어진·언 분대원 / 산 같이 가기 (OBBY) · 매달린 분대원 끌어올리기 (RIDE). 다른 E 는 전부 ProximityPrompt
		INTERACT = st == S.OBBY or st == S.RIDE,
		REENTER = st == S.CAMP and p.graduated,
		RETURN_CAMP = st == S.OBBY or st == S.RIDE,
		LETTER = st == S.LETTER and not session.letterDone,
		COOP = calm,
	}
end

-- 마지막 퇴소 편지를 한 줄로 (칩 · 자유 글) — 퇴소식 사진 밑 (v2, M061)
function SessionService.letterNote(session: Session): string?
	local p = progress(session)
	local l = p.letters[#p.letters]
	if not l then
		return nil
	end
	local parts = {}
	for _, id in ipairs(l.chips) do
		local t = (CampScript.FinalLetter.chip :: { [string]: string })[id]
		if t then
			table.insert(parts, t)
		end
	end
	if l.text and l.text ~= "" then
		table.insert(parts, l.text)
	end
	return if #parts > 0 then table.concat(parts, " · ") else nil
end

function SessionService.buildSnapshot(session: Session): ProtocolTypes.StateSnapshot
	local p = progress(session)
	-- 친구 자리(RIDING)면 분대·유보트·배치는 호스트 세션 것을 보여 준다 (클라이언트는 coop.hostState 를 읽는다)
	local view = session
	local coopView = session.coop
	if session.coop and session.coop.role == "GUEST" then
		local host = SessionService.Sessions[session.coop.partnerUserId]
		if host then
			view = host
			coopView = {
				role = "GUEST",
				partnerUserId = session.coop.partnerUserId,
				memberId = session.coop.memberId,
				hostState = host.state,
			}
		end
	end
	local members: { ProtocolTypes.MemberView } = {}
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		local m = memberAtSeat(view, key)
		if m then
			table.insert(members, {
				id = m.id,
				nameKo = if m.friendUserId then "친구" else m.def.nameKo,
				emoji = if m.friendUserId then "🤝" else m.def.emoji,
				seat = key,
				isFriend = m.friendUserId ~= nil,
				waiting = m.waiting,
			})
		end
	end
	local trainingView: ProtocolTypes.TrainingView? = nil
	local tr = session.training
	if tr and session.state == S.TRAINING then
		local st = TrainingCatalog.get(tr.stationId)
		trainingView = {
			stationId = tr.stationId,
			patternId = if st then st.patternId else "FLAT",
			beatsTotal = tr.beatsTotal,
			beatsDone = math.clamp(RhythmService.currentBeat(session.beat) - tr.startBeat, 0, tr.beatsTotal),
			good = tr.good,
			ok = tr.ok,
			miss = tr.miss,
			kind = tr.kind,
			timeLeft = if tr.endAt then math.max(0, tr.endAt - os.clock()) else nil,
			seconds = if st then st.seconds else nil,
		}
	end
	local trainedToday: { [string]: boolean } = {}
	local dayKey = p.entryCount * 100 + session.day
	for id, d in pairs(p.trainedDay) do
		trainedToday[id] = d == dayKey
	end
	local o = session.obby
	local nearGate = if o and o.gateAt then o.gates[o.gateAt] else nil
	return {
		state = session.state,
		day = view.day,
		highestCp = p.highestCp,
		resumeCp = p.resumeCp,
		entryCount = p.entryCount,
		loadout = view.loadout,
		members = members,
		beat = view.beat,
		training = trainingView,
		obby = if o and session.state == S.OBBY
			then {
				flags = o.flagsDone,
				need = o.flagsNeed,
				escapeLeft = if o.escapeDeadline then o.escapeDeadline - os.clock() else nil,
				gateHint = next(o.gates) ~= nil,
				-- 지금 서 있는 사격 문 (6단계): 맞힌 수 / 필요 수 · 그중 내가 맞힌 수 (점수 아님 — 문이 얼마나 남았나)
				gate = if nearGate and not nearGate.open
					then { hits = nearGate.hits, need = nearGate.need, mine = nearGate.mine }
					else nil,
			}
			else nil,
		stats = p.stats,
		trainedToday = trainedToday,
		flashlight = session.flashlight,
		stickers = p.stickers,
		badges = p.badges,
		letters = #p.letters,
		letterNote = SessionService.letterNote(session),
		persistence = session.handle.mode,
		tutorialDone = p.tutorialDone,
		allowed = allowed(session),
		settings = session.handle.profile.settings,
		coop = coopView,
		patternId = view.pattern.id, -- 체력단련장 박자 기구 패턴
		-- 기록 (15_RECORDS)
		records = { best = p.bestTimes, run = p.runTimes, bestTotal = p.bestTotal },
		camp = CampfireService.view(session), -- 모닥불 허브 (1단계): 오늘 주운 것·불 크기·내일로 남은 초
		rescue = RescueService.view(session), -- 살리기 (2단계): 넘어진·언 분대원, 내가 언 남은 초
		build = BoatBuildService.view(session), -- 유보트 꾸미기 (3단계): 든 것·짐·노·내 자리·내미는 분대원·출발 깃발 빛남
		-- 탑승 (4·5단계): 급류/바다 · 진행 · 미르가 부르는 쪽 · 빠진 수 · 매달린 사람 · 내 상태
		ride = if session.ride and session.state == S.RIDE
			then RideService.view(session.ride :: RideService.Handle) :: any
			else nil,
		stage = if session.stageDay
			then {
				day = session.stageDay :: number,
				startedAt = session.stageStartServer,
				paused = session.stagePaused,
				best = p.bestTimes[tostring(session.stageDay)],
			}
			else nil,
	}
end

function SessionService.pushSnapshot(session: Session)
	session.snapshotDirty = false
	fire(session, S2C.StateSnapshot, SessionService.buildSnapshot(session))
end

-- ===== 날 시작 =====
-- 패턴·템포 바꾸기: 체력단련장 박자 기구 시작·끝 때. 새 시계라 박자 번호가 0 부터 다시 센다
local function setPattern(session: Session, pattern: BeatPatterns.Pattern, baseBpm: number)
	session.pattern = pattern
	session.beat = RhythmService.newClock(baseBpm * pattern.tempo)
	markDirty(session)
end

-- 능력치 효과 (TrainingCatalog.Effects)
local function stats(session: Session)
	return session.handle.profile.progress.stats
end

-- 탑승 정리 (4·5단계): 갑판·난간·정렬 기구·프롬프트를 지우고 배를 앵커, 분대원은 모터를 떼고 세운다. 멱등
local function stopRide(session: Session)
	local h = session.ride
	if not h then
		return
	end
	session.ride = nil
	local ok, err = pcall(RideService.stop, h)
	if not ok then
		warn("[Camp] ride stop failed: " .. tostring(err))
	end
end

local function setState(session: Session, st: string)
	local prev = session.state
	session.state = st
	-- 유격을 떠나면 살리기 정리: 누운 사람 세우고 프롬프트 지우고 내 걸음 되돌림 (2단계 — 밤·기지·다시 어디로 가든).
	-- 5일차 손전등도 끈다 (6단계: 저절로 켜졌던 것)
	if prev == S.OBBY and st ~= S.OBBY then
		RescueService.clear(session)
		if session.flashlight then
			session.flashlight = false
			fx(session, "FLASHLIGHT", { on = false })
		end
	end
	-- 꾸미기를 떠나면 프롬프트·든 소품·지난번 판 정리 (출발이든 다른 길이든, 3단계)
	if prev == S.BUILD and st ~= S.BUILD then
		BoatBuildService.stop(session)
	end
	-- 탑승을 떠나면 갑판·난간·정렬 기구·프롬프트 정리, 배는 앵커 (도착은 그 전에 정리돼 여기선 아무 일 없음, 4·5단계)
	if prev == S.RIDE and st ~= S.RIDE then
		stopRide(session)
	end
	markDirty(session)
end

-- ===== 모의 사격 표적 (14 §5) =====
-- 표적은 맵 파트(Kind=TARGET). 서 있는지(Up)는 속성으로 알리고 클라이언트가 세우고 눕힌다. 판정은 서버.
local function targetPart(group: string, index: number): BasePart?
	local sc = scene
	local list = sc and sc.targets[group]
	if not list then
		return nil
	end
	for _, t in ipairs(list) do
		if t.index == index then
			return t.part
		end
	end
	return nil
end
local function setTargetUp(group: string, index: number, up: boolean)
	local part = targetPart(group, index)
	if part then
		part:SetAttribute("Up", up)
	end
end
-- 탈출 문 표적 하나 맞힘 (내가 눌렀든 분대원이 같이 쐈든 같은 결과). by = "ME" | 분대원 id → 표적 속성 HitBy (구멍 색)
local function gateHitTarget(session: Session, g: GateState, index: number, by: string, group: string?)
	local grp = group or "GATE"
	g.up[index] = nil
	g.hits += 1
	if by == "ME" then
		g.mine += 1
		session.rec.gateMine = (session.rec.gateMine or 0) + 1
	end
	local part = targetPart(grp, index)
	if part then
		part:SetAttribute("HitBy", by)
		part:SetAttribute("Up", false)
	end
	fx(session, "TARGET_HIT", { group = grp, index = index, by = by })
	markDirty(session)
end
local function targetCount(group: string): number
	local sc = scene
	local list = sc and sc.targets[group]
	return if list then #list else 0
end
local function rangeUpSec(session: Session): number
	return 1.7 + (progress(session).stats.aim or 0) * 0.12 -- 사격이 오르면 표적이 조금 더 오래 선다
end
-- 자유 이동 스테이지인 날 (22 v2): 깃발이 심긴 날. 유보트는 기지에 두고, 분대는 앞서 가 응원한다
local function freeDay(session: Session): boolean
	local sc = scene
	return sc ~= nil and #(sc.flagsByDay[session.day] or {}) > 0
end

local function startObby(session: Session)
	local sc = scene :: SceneBindings.Scene
	local pads = sc.padsByDay[session.day] or {} -- 자유 스테이지(22 v2)는 날마다 출발 발판이 있다
	session.obby = {
		pads = pads,
		padIdx = 1,
		falls = 0,
		bellRung = false,
		lastFallAt = 0,
		fallsByPad = {},
		sanStopped = false,
		cpBlockedAt = nil,
		flags = {},
		flagsDone = 0,
		flagsNeed = GameConfig.Free.FlagsNeed[session.day] or #(sc.flagsByDay[session.day] or {}),
		respawn = nil,
		gates = {},
		gateAt = nil,
		gateSquadNext = {},
		escapeDeadline = nil,
		spotCount = 0,
		lastSpotAt = 0,
		cheerAt = os.clock() + 3,
		cheerIdx = 0,
	}
	local o = session.obby :: Obby
	-- 깃발 되돌리기 (다시 하기·다시 입소): 찍은 표시(초록 천·Taken)를 지운다
	for _, fl in ipairs(sc.flagsByDay[session.day] or {}) do
		fl.part:SetAttribute("Taken", false)
		local cloth = workspace:FindFirstChild(fl.id .. "_Cloth", true)
		if cloth and cloth:IsA("BasePart") then
			cloth.Color = Palette.Red
		end
	end
	-- 사격 문 (5일차 탈출): 길목마다 표적 n개(사격 능력치만큼 줄어듦, 최소 2)
	for _, z in ipairs(sc.zonesByDay[session.day] or {}) do
		if z.zoneType == "GATE" and z.gateGroup then
			local need = math.max(
				2,
				targetCount(z.gateGroup) - (stats(session).aim or 0) * TrainingCatalog.Effects.TargetsLessPerAim
			)
			local up = {}
			for i = 1, targetCount(z.gateGroup) do
				up[i] = true
				local tp = targetPart(z.gateGroup, i)
				if tp then
					tp:SetAttribute("HitBy", nil) -- 지난 판 구멍 지우기 (다시 하기·다시 입소)
				end
				setTargetUp(z.gateGroup, i, true)
			end
			o.gates[z.id] =
				{ group = z.gateGroup, need = need, hits = 0, mine = 0, up = up, open = false, part = z.part }
			z.part.CanCollide = true
			z.part:SetAttribute("Open", false)
		end
	end
	if session.day == StationCatalog.LastDay then
		local st = stats(session)
		local sum = st.strength + st.speed + st.stamina + (st.aim or 0)
		o.escapeDeadline = os.clock() + GameConfig.Free.EscapeBaseSec + sum * TrainingCatalog.Effects.EscapeSecPerStat
	end
	local first = pads[1]
	if first then
		local pos = first.part.Position
		-- 혹시 남은 Weld 를 먼저 떼고, Weld 를 푼 직후 위치가 되돌아갈 수 있어 0.5초 뒤 한 번 더 놓는다 (20, Studio 확인)
		BoatService.detachAll(session.boat)
		BoatService.setMode(session.boat, "PARK")
		if freeDay(session) then
			-- 유보트는 기지에 두고 간다 (22 v2: 운반은 1일차뿐 — "2일차는 왜 보트가 따라다니냐", 21 §1-3)
			local cpos, clook = cpSpot(progress(session).resumeCp)
			BoatService.place(session.boat, cpos, clook)
		else
			BoatService.place(session.boat, pos + first.part.CFrame.RightVector * 8, first.part.CFrame.LookVector)
		end
		o.respawn = pos
		if next(o.gates) ~= nil then
			lines(session, { { who = "SYSTEM", text = CampScript.Obby.ESCAPE_HINT, sec = 4 } })
		end
		local ch = session.player.Character
		if ch then
			local spot = CFrame.new(pos + Vector3.new(0, 3.5, 0))
			ch:PivotTo(spot)
			task.delay(0.5, function()
				local ob = session.obby
				if session.state == S.OBBY and ob and ob.padIdx == 1 and session.player.Character == ch then
					ch:PivotTo(spot)
				end
			end)
		end
		local i = 0
		for _, m in ipairs(npcMembers(session)) do
			i += 1
			m.waiting = false
			local oldPrompt = m.rig and m.rig.hrp:FindFirstChild("CampSanPrompt")
			if oldPrompt then
				oldPrompt:Destroy()
			end
			SquadNpcService.setMood(m.rig :: SquadNpcService.Rig, "IDLE")
			SquadNpcService.standAt(
				m.rig :: SquadNpcService.Rig,
				pos + first.part.CFrame.RightVector * (2 + i * 1.5),
				first.part.CFrame.LookVector
			)
		end
	end
	setState(session, S.OBBY)
	RescueService.beginDay(session) -- 살리기 (2단계): 오늘 넘어질 횟수·탐조등 걸림 되돌림
	-- 5일차 야간: 손전등은 저절로 켜진다 (6단계 — F 키·🔦 버튼 없음, 조작은 걷기·점프·E 셋)
	if session.day == 5 then
		session.flashlight = true
		fx(session, "FLASHLIGHT", { on = true })
	end
end

local arriveCheckpointRef: (Session, string) -> () -- 아래 arriveCheckpoint 를 startDay 의 닫힘에서 쓰려고 (정의 순서)

-- ===== 탑승 (27 §3 1-B 급류 · 4일차 바다 노 젓기, 28 §2 4·5단계) =====
-- RideService 는 세션을 모른다: 핸들 + 손(cbs)만. 여기서 상태 RIDE·도착(CP)·뱃지·밤 일지 기록으로 잇는다.
local function rideLines(session: Session, list: { any })
	local out: { CampScript.Line } = {}
	for _, l in ipairs(list) do
		if typeof(l) == "string" then
			table.insert(out, { who = "SYSTEM", text = l, sec = 2 })
		elseif typeof(l) == "table" then
			table.insert(out, l :: CampScript.Line)
		end
	end
	if #out > 0 then
		lines(session, out)
	end
end

-- 도착 (RideService 가 모래 위에 배를 세우고 분대원이 환호한 순간): 기록 → 뱃지 → 환호·교관 한 줄을 본 뒤 CP 도착(밤)
local function onRideFinish(session: Session, h: RideService.Handle)
	if session.ride ~= h then
		return
	end
	local ev = h.events
	local log: RideLog = {
		kind = h.kind,
		falls = ev.falls,
		bumps = ev.bumps,
		dodges = ev.dodges,
		fellBy = {},
		pulledByMe = {},
		pulledMe = {},
		ledByMe = ev.ledByMe,
		wood = h.itemsGot.WOOD or 0,
		water = h.itemsGot.WATER or 0,
	}
	for _, r in ipairs(h.riders) do
		if r.falls > 0 then
			log.fellBy[r.id] = r.falls
		end
	end
	local myPulls = 0
	for _, e in ipairs(h.pullLog) do
		if e.by == "ME" and e.who ~= "ME" then
			log.pulledByMe[e.who] = (log.pulledByMe[e.who] or 0) + 1
			myPulls += 1
			-- 이번 입소에서 서로 도운 일 (퇴소식 한 줄·편지 칩 — 일으키기·땡과 같은 칸, 6단계)
			session.rel.helped[e.who] = (session.rel.helped[e.who] or 0) + 1
		elseif e.who == "ME" and e.by ~= "SELF" and e.by ~= "ME" then
			log.pulledMe[e.by] = (log.pulledMe[e.by] or 0) + 1
			session.rel.helpedMe[e.by] = (session.rel.helpedMe[e.by] or 0) + 1
		end
	end
	session.rideLog = log
	local p = progress(session)
	p.drops += ev.falls -- 옛 칸 이름 그대로: 이번 입소에 물에 빠진 수 (기록만)
	session.rec.rideFalls = (session.rec.rideFalls or 0) + ev.falls
	session.rec.ridePulls = (session.rec.ridePulls or 0) + myPulls
	-- 뱃지 (27 §6): 급류 도착 = RAPIDS, 급류에서 아무도(나+분대원) 안 빠짐 = NO_FALL — 도착 순간에 준다 (수료 때 drops 로 다시 보지 않는다)
	if h.kind == "RAPIDS" then
		addBadge(session, "RAPIDS")
		if ev.falls == 0 then
			addBadge(session, "NO_FALL")
		end
	end
	TelemetryService.log("ride_finish", {
		kind = h.kind,
		falls = ev.falls,
		bumps = ev.bumps,
		dodges = ev.dodges,
		myPulls = myPulls,
		npcPulls = ev.npcPulls,
		selfClimbs = ev.selfClimbs,
		ledByMe = ev.ledByMe,
		scrapes = ev.scrapes,
		items = ev.items,
		sec = math.floor(os.clock() - h.startAt),
	})
	markDirty(session)
	-- 환호·교관 한 줄을 보는 동안은 작전 시간에 넣지 않는다 (15_RECORDS)
	local delay = GameConfig.Ride.ArriveDelaySec
	session.stagePaused += delay
	local day = session.day
	task.delay(delay, function()
		if session.ride ~= h or SessionService.Sessions[session.userId] ~= session or session.state ~= S.RIDE then
			return
		end
		stopRide(session) -- 갑판·난간을 먼저 지우고 (배는 이미 모래 위에 앵커)
		arriveCheckpointRef(session, StationCatalog.idForDay(day))
	end)
end

-- 배에 태우고 출발 (급류 RAPIDS · 바다 SEA). 분대원 = 지금 배치의 자리 순서 (친구 자리는 아직 안 태움 — 28 §7 남긴 것)
local function beginRide(session: Session, kind: RideService.Kind, day: number)
	stopRide(session)
	session.obby = nil
	session.rideLog = nil
	local members = {}
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		local m = memberAtSeat(session, key)
		if m and m.id ~= "ME" and m.rig and not m.friendUserId then
			SquadNpcService.setSitting(m.rig, false)
			SquadNpcService.setMood(m.rig, "IDLE")
			table.insert(members, { id = m.id, rig = m.rig :: SquadNpcService.Rig })
		end
	end
	local s = session
	local h: RideService.Handle
	h = RideService.start({
		userId = session.userId,
		character = session.player.Character,
		boat = session.boat,
		members = members,
		kind = kind,
		day = day,
		loadout = session.loadout,
		cbs = {
			lines = function(list)
				rideLines(s, list)
			end,
			fx = function(k, extra)
				fx(s, k, extra)
			end,
			bubble = function(id, text, sec)
				bubble(s, id, text, sec)
			end,
			finish = function()
				onRideFinish(s, h)
			end,
			dirty = function()
				markDirty(s)
			end,
			-- 급류 2차: 물 위에서 건진 장작·물통 → 오늘 밤 모닥불 주머니
			item = function(itemKind, n)
				if itemKind == "WATER" then
					CampfireService.addWater(s, n, "RIDE")
				else
					CampfireService.addWood(s, n, "RIDE")
				end
			end,
		},
	})
	session.ride = h
	session.rideDirtyAt = 0
	setState(session, S.RIDE)
	TelemetryService.log("ride_start", { kind = kind, day = day })
end

-- 꾸미기 "출발!" 뒤 1일차 급류 (3단계 → 4단계 통합 지점)
local function beginDay1Ride(session: Session)
	-- DAY_START 연출은 꾸미기 시작 때 이미 보냈다 (다시 보내면 StoryController 가 교관의 "그 배로 간다" 줄을 지운다)
	lines(session, CampScript.Ride.dayStart[1] or {})
	beginRide(session, "RAPIDS", 1)
	markDirty(session)
end

-- 날 시작 (27 §3 · 6단계 정리): 1일차 = 유보트 꾸미기(BUILD) → 급류(RIDE) · 2·5·6일차 = 자유 스테이지(OBBY) · 4일차 = 바다 노 젓기(RIDE)
function SessionService.startDay(session: Session, day: number)
	local sc = scene
	if not sc then
		return
	end
	local station = StationCatalog.forDay(day)
	if not station then
		return
	end
	WelcomeService.stop(session) -- 첫 1분: 분대원 달리기·부르기를 끊는다 (버튼으로 출발해도, 걸어 들어와도)
	stopRide(session) -- 타는 중에 다시 시작(DevApi·한 번 더)해도 물리 배·갑판이 남지 않게 (4·5단계)
	session.rideLog = nil
	session.day = day
	session.flashlight = false
	CampfireService.beginDay(session, day) -- 모닥불 허브 (1단계): 오늘 주운 것 0 (밤에서 바로 한 번 더면 밤 정리도)
	-- 날마다 분대원 기분을 새로 (20_DAYS_UNIFY: 4일차 겁먹음 아이콘이 6일차까지 남아 있었다)
	for _, m in ipairs(npcMembers(session)) do
		if m.rig then
			SquadNpcService.setMood(m.rig, "IDLE")
		end
	end
	-- 작전 기록 시작 (15_RECORDS)
	session.stageDay = day
	session.stageStartAt = os.clock()
	session.stageStartServer = workspace:GetServerTimeNow()
	session.stagePaused = 0
	session.timingInvalid = false
	session.letterDone = false
	local p = progress(session)
	p.tutorialDone = true -- 첫 출발을 눌렀으면 조작 카드는 다 본 것 (6단계: 첫 들기 연습 없음)
	p.loadoutByDay[tostring(day)] = BoatLoadout.clone(session.loadout)
	for _, m in pairs(session.members) do
		m.morale = math.max(m.morale, GameConfig.Morale.Start)
	end
	if station.mode == "SEA" then
		-- 4일차 바다 노 젓기 (27 §3 · 28, 5단계): 1일차 급류와 같은 탑승 물리 배. W 를 누르는 동안 간다
		fx(session, "DAY_START", { day = day, mode = "RIDE" }) -- 먼저: StoryController 가 DAY_START 에 줄을 비운다
		-- 능력치 한 줄(StatToday)은 넣지 않는다: 배 속도는 능력치가 아니라 배치(노·짐)와 탄 사람 수로 정해진다 (사실과 다른 안내 금지)
		lines(session, CampScript.Ride.dayStart[day] or {})
		beginRide(session, "SEA", day)
		TelemetryService.log("day_start", { day = day, ride = "SEA" })
		markDirty(session)
		return
	elseif station.mode ~= "OBBY" then
		-- 1일차 1-A 유보트 꾸미기 (27 §3 · 28, 3단계): 연병장 거치대에서 꾸미고 "출발!" → 급류 (4단계 통합)
		session.obby = nil
		setState(session, S.BUILD)
		-- 첫 1분: DAY_START 를 먼저 — StoryController 가 DAY_START 에 자막 줄을 비우므로, 뒤에 보내면 꾸미기 시작 줄
		-- ("🎖️ 작전 1"·교관 "출발 전에 배부터 꾸며!")이 뜨자마자 지워졌다 (Studio 2026-10-21 캡처에 자막 없음)
		fx(session, "DAY_START", { day = day, mode = "BUILD" })
		local s = session
		BoatBuildService.start(session, {
			depart = function()
				-- 꾸미는 동안은 작전 시간에 넣지 않는다: 출발 순간부터 잰다 (15_RECORDS)
				s.stageDay = 1
				s.stageStartAt = os.clock()
				s.stageStartServer = workspace:GetServerTimeNow()
				s.stagePaused = 0
				beginDay1Ride(s)
			end,
		})
		TelemetryService.log("day_start", { day = day, build = true })
		markDirty(session)
		return
	end
	startObby(session)
	local start = table.clone(CampScript.DayStart[day] or {})
	-- 오늘 능력치가 무엇을 쉽게 하는지 한 줄 (14 §4: 단련이 작전과 이어진다 — 탈출 시간·문 표적 수)
	local st = stats(session)
	if st.strength + st.speed + st.stamina + (st.aim or 0) > 0 then
		table.insert(start, {
			who = "SYSTEM",
			text = string.format(CampScript.StatToday, st.strength, st.speed, st.stamina, st.aim or 0),
			sec = 3,
		})
	end
	if #start > 0 then
		lines(session, start)
	end
	fx(session, "DAY_START", { day = day, mode = station.mode })
	TelemetryService.log("day_start", { day = day })
	markDirty(session)
end

-- ===== 밤·편지·퇴소 =====
local function slowText(session: Session): string
	-- 탄 날 (4·5단계): 빠진 수 한 줄 (메모체)
	local rl = session.rideLog
	if rl then
		local RT = CampScript.Ride
		local J = RT.journal
		local base = if rl.falls == 0
			then (J[rl.kind .. "_CLEAN"] or J.RAPIDS_CLEAN)
			else string.format(J[rl.kind] or J.RAPIDS, rl.falls)
		-- 급류 2차: 내가 먼저 움직인 바위(파도) · 건진 장작·물통 (있을 때만, 점수 아님)
		if rl.ledByMe > 0 then
			base ..= string.format(RT.journalLed[rl.kind] or RT.journalLed.RAPIDS, rl.ledByMe)
		end
		if rl.wood > 0 then
			base ..= string.format(RT.journalItems, rl.wood)
		end
		if rl.water > 0 then
			base ..= string.format(RT.journalWater, rl.water)
		end
		return base
	end
	-- 자유 스테이지 날 (2·5·6일차): 찍은 깃발·떨어진 수
	local o = session.obby
	if o then
		return string.format(CampScript.JournalSlow.OBBY, o.flagsDone, o.falls)
	end
	return CampScript.JournalSlow.NONE
end

-- 탄 날의 발견 (4·5단계): 내가 끌어올린 사람 > 나를 끌어올린 사람 > 빠진 사람 > 바위 비껴감/쿵 > 넷이 끝까지. 정답 배치를 말하지 않는다
local function rideNames(session: Session, map: { [string]: number }): string?
	local parts = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local n = map[id]
		if n and n > 0 then
			local m = session.members[id]
			local nm = if m then m.def.nameKo else id
			table.insert(parts, if n > 1 then string.format("%s ×%d", nm, n) else nm)
		end
	end
	if map.ME and map.ME > 0 then
		local m = session.members.ME
		local nm = if m then m.def.nameKo else "ME"
		table.insert(parts, if map.ME > 1 then string.format("%s ×%d", nm, map.ME) else nm)
	end
	return if #parts > 0 then table.concat(parts, " · ") else nil
end

local function rideDiscover(session: Session, rl: RideLog): string
	local RT = CampScript.Ride
	local byMe = rideNames(session, rl.pulledByMe)
	local toMe = rideNames(session, rl.pulledMe)
	if byMe and toMe then
		return string.format(RT.discoverPulled, byMe) .. " · " .. string.format(RT.discoverPulledMe, toMe)
	elseif byMe then
		return string.format(RT.discoverPulled, byMe)
	elseif toMe then
		return string.format(RT.discoverPulledMe, toMe)
	end
	local fell = rideNames(session, rl.fellBy)
	if fell then
		return string.format(RT.discoverFell, fell)
	end
	if rl.bumps + rl.dodges > 0 then
		return string.format(RT.discoverDodge, rl.dodges, rl.bumps)
	end
	return RT.discoverClean
end

-- 오늘의 발견 한 줄: 오늘 실제로 일어난 일에서 고른다 (메모체, 사실과 그 사람의 말만). 정답 배치를 알려 주지 않는다
local function discoverText(session: Session): string?
	local D = CampScript.Discover
	-- 탄 날 (4·5단계, 가설 2): 누가 빠졌고 누가 누구를 끌어올렸나 — 이름과 횟수만 (해석 없음)
	local rl = session.rideLog
	if rl then
		return rideDiscover(session, rl)
	end
	-- 2일차 유격 (20, roblox-action-storytelling 흔적 점검): 산이 그물 앞에서 멈췄나·같이 갔나 — 사실과 산의 말만
	local o = session.obby
	if not o then
		return nil
	end
	return if o.sanHelpedAt then D.SanNetWith elseif o.sanStopped then D.SanNetLeft else nil
end

local function sendDayReport(session: Session, day: number)
	local p = progress(session)
	local today = p.loadoutByDay[tostring(day)] or session.loadout
	local replayPrev = session.lastAttempt
	session.lastAttempt = nil
	local prev = replayPrev or p.loadoutByDay[tostring(day - 1)]
	local text = slowText(session)
	addJournal(session, day, text)
	fire(session, S2C.DayReport, {
		day = day,
		slowText = text,
		discover = discoverText(session),
		canReplay = session.coop == nil and day >= 1 and day <= 4,
		stage = if session.lastStage and session.lastStage.day == day then session.lastStage else nil,
		prevLabel = if replayPrev then "지난 번" else "어제",
		today = today,
		prev = prev,
		diffText = BoatLoadout.diffKo(prev, today),
		drops = if session.rideLog then session.rideLog.falls else 0,
		journal = p.journal,
		stickers = p.stickers,
	})
end

-- 밤 (마감 패스): 나를 모닥불 앞(유보트 쪽 8 stud)에 불을 보고 세운다. 전엔 유보트 옆(빈 통나무 의자 위)에 떨어져 바로 앉아 버렸다
local function standAtFire(session: Session, day: number)
	local sc = scene
	local campFire = sc and sc.firesByDay and sc.firesByDay[day]
	local ch = session.player.Character
	if not campFire or not ch then
		return
	end
	local fp = campFire.part.Position
	local rp = session.boat.root.Position
	local toBoat = Vector3.new(rp.X - fp.X, 0, rp.Z - fp.Z)
	local dir = if toBoat.Magnitude > 0.5 then toBoat.Unit else Vector3.new(0, 0, 1)
	local base = fp + dir * 8
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = true
	local hit = workspace:Raycast(base + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
	local gy = if hit then hit.Position.Y else fp.Y - 1.3
	local cf = CFrame.lookAt(Vector3.new(base.X, gy + 3.2, base.Z), Vector3.new(fp.X, gy + 3.2, fp.Z))
	ch:PivotTo(cf)
	-- 클라이언트가 물리 소유권을 되찾으며 옛 자리로 되돌리는 것 막기 (BoatService.standBeside 와 같은 요령)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			task.wait(0.1)
			if not ch.Parent then
				return
			end
			if (ch:GetPivot().Position - cf.Position).Magnitude > 3 then
				ch:PivotTo(cf)
			end
		end
	end)
end

local function enterNight(session: Session, day: number)
	detachSquad(session)
	placeAtCamp(session, StationCatalog.idForDay(day), true)
	standAtFire(session, day)
	setState(session, S.NIGHT)
	fx(session, "NIGHT", { n = day })
	-- 모닥불 허브 (27 §3, 1단계): 밤 대사는 자동 재생 대신 앉아서 듣는다(교관 한 줄만 바로). 미르의 스티커·흔적은 미르가 그림을 그리는 25초에.
	-- 불 크기·넣기/나누기 프롬프트·분대원 역할(두리 불·산 짐·미르 그림)은 CampfireService 가 맡는다
	CampfireService.enterNight(session, day)
	if not BoatLoadout.hasCargo(session.loadout, "SNACK") then
		for _, mem in pairs(session.members) do
			mem.morale = math.max(0.3, mem.morale - 0.15)
		end
	end
	sendDayReport(session, day)
end

-- ===== 퇴소 편지 (13_FINAL_LETTER) =====
-- 이번 입소에서 실제로 한 일로 문장 칩을 만든다. 안 한 일은 칩이 없다. 늘 있는 칩 셋(무거웠어·또 들고 싶어·집 밥).
function SessionService.letterChips(session: Session): { { id: string, label: string } }
	local p = progress(session)
	local L = CampScript.FinalLetter.chip
	local out: { { id: string, label: string } } = {}
	local function add(id: string)
		table.insert(out, { id = id, label = L[id] })
	end
	-- v2 (M061): 친구들에게 하는 말 셋은 늘 먼저
	add("FRND1")
	add("FRND2")
	add("FRND3")
	for _, pair in ipairs({ { "DURI", "HDUR", "BDUR" }, { "SAN", "HSAN", "BSAN" }, { "MIR", "HMIR", "BMIR" } }) do
		if (session.rel.helped[pair[1]] or 0) > 0 then
			add(pair[2])
		end
		if (session.rel.helpedMe[pair[1]] or 0) > 0 then
			add(pair[3])
		end
	end
	if session.rec.sanNet then
		add("SNET")
	end
	local lo4 = p.loadoutByDay["4"]
	local duriSeat = if lo4 then BoatLoadout.seatOf(lo4, "DURI") else nil
	if duriSeat then
		add(if SquadCatalog.isFront(duriSeat) then "DFRT" else "DBCK")
	end
	-- 6일차 사격 문: 내가 맞힌 표적이 하나라도 있으면 (분대원과 같이 연 문)
	if (session.rec.gateMine or 0) > 0 then
		add("GHIT")
	end
	add(if p.drops > 0 then "DROP" else "NODR") -- drops = 이번 입소 급류·바다에서 물에 빠진 수
	add("HEVY")
	add("AGIN")
	add("FOOD")
	return out
end

-- 답장: 받는 사람이 분대원·교관이면 그 사람과 있었던 일로 한 줄
local function replyFor(session: Session, toId: string): CampScript.Line?
	local RP = CampScript.FinalLetter.reply
	local p = progress(session)
	if toId == "DURI" then
		local lo4 = p.loadoutByDay["4"]
		local seat = if lo4 then BoatLoadout.seatOf(lo4, "DURI") else nil
		local text = if seat and SquadCatalog.isFront(seat)
			then RP.DURI_FRONT
			elseif (session.rel.helped.DURI or 0) > 0 then RP.DURI_HELPED
			else RP.DURI_PLAIN
		return { who = "DURI", text = text, sec = 3.5 }
	elseif toId == "SAN" then
		local text = if session.rec.sanNet
			then RP.SAN_NET
			elseif (session.rel.helped.SAN or 0) > 0 then RP.SAN_HELPED
			else RP.SAN_PLAIN
		return { who = "SAN", text = text, sec = 3.5 }
	elseif toId == "MIR" then
		local text = if (session.rel.helped.MIR or 0) > 0
			then RP.MIR_HELPED
			elseif (session.rel.helpedMe.MIR or 0) > 0 then RP.MIR_HELPEDME
			else RP.MIR_PLAIN
		return { who = "MIR", text = text, sec = 3.5 }
	elseif toId == "KANG" then
		return { who = "KANG", text = RP.KANG, sec = 4 }
	end
	return nil
end

local function relRecap(session: Session): string?
	local function list(t: { [string]: number }): string
		local parts = {}
		for _, id in ipairs(SquadCatalog.NpcOrder) do
			local n = t[id]
			if n and n > 0 then
				table.insert(parts, string.format("%s %d", SquadCatalog.Members[id].nameKo, n))
			end
		end
		return table.concat(parts, " · ")
	end
	local a, b = list(session.rel.helped), list(session.rel.helpedMe)
	if a == "" and b == "" then
		return nil
	end
	local out = {}
	if a ~= "" then
		table.insert(out, string.format(CampScript.Graduate.recapHelped, a))
	end
	if b ~= "" then
		table.insert(out, string.format(CampScript.Graduate.recapHelpedMe, b))
	end
	return table.concat(out, " / ")
end

local function enterGraduate(session: Session)
	detachSquad(session)
	placeAtCamp(session, "CP6", false)
	setState(session, S.GRADUATE)
	local p = progress(session)
	p.graduated = true
	local sc = scene :: SceneBindings.Scene
	local i = 0
	for _, m in ipairs(npcMembers(session)) do
		i += 1
		local spot = sc.gradSpots[i]
		if spot then
			SquadNpcService.standAt(m.rig :: SquadNpcService.Rig, spot.Position, spot.CFrame.LookVector)
			SquadNpcService.playOnce(m.rig :: SquadNpcService.Rig, "cheer")
		end
	end
	local gl = {}
	for _, l in ipairs(CampScript.Graduate.lines) do
		table.insert(gl, { who = l.who, text = string.format(l.text, p.entryCount), sec = l.sec })
	end
	-- 이번 입소에서 실제로 서로 받친 일 (점수 아님, 있었던 일만)
	local recap = relRecap(session)
	if recap then
		table.insert(gl, { who = "SYSTEM", text = recap, sec = 5 })
	end
	lines(session, gl)
	addBadge(session, "GRAD")
	SessionService.recordGraduation(session)
	-- NO_FALL 은 1일차 급류 도착 순간에 준다 (onRideFinish, 4·5단계). 수료 때 이번 입소 drops 로 다시 주지 않는다 — 급류에서 빠졌는데 수료 때 받으면 말이 안 맞는다
	addSticker(session, "GRAD")
	fx(session, "GRADUATE", { entry = p.entryCount })
	TelemetryService.log("graduate", { entry = p.entryCount, drops = p.drops })
end

-- 6일차 도착: 무대에서 편지 한 장 → 봉하면(또는 안 쓰면) 퇴소식
local function enterFinalLetter(session: Session)
	detachSquad(session)
	placeAtCamp(session, "CP6", false)
	local p = progress(session)
	p.graduated = true -- 편지 도중 나가도 다시 들어오면 다시 입소를 고를 수 있게
	session.letterDone = false
	local chips = SessionService.letterChips(session)
	session.letterChipSet = {}
	for _, c in ipairs(chips) do
		session.letterChipSet[c.id] = true
	end
	setState(session, S.LETTER)
	fx(session, "CANDLES")
	lines(session, CampScript.FinalLetter.open)
	task.delay(2.5, function()
		if session.state == S.LETTER then
			cue(session, "LETTER_WRITE", { toChips = CampScript.FinalLetter.toChips, lineChips = chips })
		end
	end)
end

-- ===== 작전 기록 (15_RECORDS) =====
-- 도착 순간 시간을 멈추고: 이번 입소 최고(runTimes), 내 최고(bestTimes), 기록판(D1~D6, 더 빠를 때만) 순서로 남긴다.
local function recordStage(session: Session, day: number)
	if session.stageDay ~= day or session.timingInvalid then
		session.stageDay = nil
		return
	end
	session.stageDay = nil
	local elapsed = os.clock() - session.stageStartAt - session.stagePaused
	local cs = math.max(1, math.floor(elapsed * 100))
	local p = progress(session)
	local key = tostring(day)
	local prevBest = p.bestTimes[key]
	local newBest = prevBest == nil or cs < prevBest
	if newBest then
		p.bestTimes[key] = cs
	end
	if not p.runTimes[key] or cs < p.runTimes[key] then
		p.runTimes[key] = cs
	end
	session.lastStage = {
		day = day,
		cs = cs,
		best = p.bestTimes[key],
		newBest = newBest,
	}
	markDirty(session)
	local text = string.format(
		if newBest then CampScript.Records.stageNewBest else CampScript.Records.stage,
		day,
		KoreanText.clock(cs),
		KoreanText.clock(p.bestTimes[key])
	)
	cue(session, "LINE", { who = "SYSTEM", text = text, sec = 3.5 })
	TelemetryService.log("stage_time", { day = day, cs = cs, best = newBest })
	local userId = session.userId
	task.spawn(function()
		-- 순위는 이번 기록이 기록판을 새로 바꿨을 때만 말한다 (느린 판에 "1위" 라고 하지 않게)
		local improved = LeaderboardService.submit("D" .. day, userId, cs)
		local rank = if improved then LeaderboardService.rankOf("D" .. day, userId) else nil
		if rank and SessionService.Sessions[userId] == session then
			cue(session, "LINE", { who = "SYSTEM", text = string.format(CampScript.Records.rank, day, rank), sec = 3 })
			if session.lastStage and session.lastStage.day == day then
				session.lastStage.rank = rank
			end
		end
	end)
end

-- 수료 기록 = 이번 입소 작전 1~6 최고의 합 (하나라도 없으면 기록 없음)
function SessionService.recordGraduation(session: Session)
	local p = progress(session)
	local total = 0
	for _, st in ipairs(StationCatalog.List) do
		if st.day < 1 then
			continue
		end
		-- 목록에 있는 날만 (3일차 갯벌 제거 M057: 1~6 으로 돌면 3일차 기록이 없어 수료 기록이 영영 안 남는다 — 검수 2026-10-20)
		local t = p.runTimes[tostring(st.day)]
		if not t then
			return
		end
		total += t
	end
	local newBest = p.bestTotal == nil or total < (p.bestTotal :: number)
	if newBest then
		p.bestTotal = total
	end
	markDirty(session)
	lines(session, {
		{
			who = "SYSTEM",
			text = string.format(
				if newBest then CampScript.Records.gradNewBest else CampScript.Records.grad,
				KoreanText.clock(total),
				KoreanText.clock(p.bestTotal :: number)
			),
			sec = 4,
		},
	})
	local userId = session.userId
	task.spawn(function()
		local improved = LeaderboardService.submit("GRAD", userId, total)
		local rank = if improved then LeaderboardService.rankOf("GRAD", userId) else nil
		if rank and SessionService.Sessions[userId] == session then
			cue(session, "LINE", { who = "SYSTEM", text = string.format(CampScript.Records.gradRank, rank), sec = 3.5 })
		end
	end)
end

local function arriveCheckpoint(session: Session, cpId: string)
	local p = progress(session)
	local day = session.day
	recordStage(session, day)
	if StationCatalog.indexOf(cpId) > StationCatalog.indexOf(p.highestCp) then
		p.highestCp = cpId
	end
	p.resumeCp = cpId
	p.day = day
	local station = StationCatalog.get(cpId)
	if station and station.badge then
		for id, text in pairs(CampScript.Badges) do
			if text == station.badge then
				addBadge(session, id)
			end
		end
	end
	local line = CampScript.Arrive[cpId]
	if line then
		lines(session, { line, { who = "SYSTEM", text = CampScript.Saved, sec = 2 } })
	end
	if day == 5 and session.obby and session.obby.spotCount == 0 and freeDay(session) then
		addBadge(session, "SHADOW") -- 탐조등에 한 번도 안 들킴 (23_BADGES). 저장 전에
	end
	fx(session, "CP", { id = cpId })
	TelemetryService.log("checkpoint", { id = cpId, day = day })
	markDirty(session)
	task.spawn(ProfileStoreService.save, session.handle)
	if day >= 1 and day <= 5 then
		enterNight(session, day) -- 5박도 모닥불 밤 (편지는 퇴소날)
	elseif day == 6 then
		local deadline = session.obby and session.obby.escapeDeadline
		if deadline then
			if os.clock() <= deadline then
				addBadge(session, "ESCAPE")
				lines(session, { CampScript.Obstacle.escapeOnTime })
			else
				lines(session, { CampScript.Obstacle.escapeLate })
			end
		end
		enterFinalLetter(session)
	end
end
arriveCheckpointRef = arriveCheckpoint

-- Studio 시험 (DevApi "finishDay"): 자유 스테이지를 깃발 다 찍은 것으로 하고 오늘 도착점에 닿는다 (탈출 문은 그대로 — 시간만)
function SessionService.devArrive(session: Session)
	local o = session.obby
	if session.state ~= S.OBBY or not o then
		return
	end
	o.flagsDone = math.max(o.flagsDone, o.flagsNeed)
	arriveCheckpoint(session, StationCatalog.idForDay(session.day))
end

-- ===== 체력단련장 미니게임 (07_PHASE2 §3) =====

local tickTraining
local function trainDayKey(session: Session): number
	return progress(session).entryCount * 100 + session.day
end

local function finishTraining(session: Session, completed: boolean)
	local tr = session.training
	if not tr then
		return
	end
	if tr.kind == "RANGE" and tr.up then
		for i in pairs(tr.up) do
			setTargetUp("RANGE", i, false)
		end
	end
	local station = TrainingCatalog.get(tr.stationId)
	local p = progress(session)
	local gained = false
	local before = if station then p.stats[station.stat] else 0
	if completed and station and tr.good >= station.passGood then
		p.trainedDay[station.id] = trainDayKey(session)
		if p.stats[station.stat] < TrainingCatalog.StatMax then
			p.stats[station.stat] += 1
			gained = true
		end
	end
	session.training = nil
	local ch = session.player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
	end
	setPattern(session, BeatPatterns.Patterns.FLAT, 100)
	setState(session, S.CAMP)
	if station then
		cue(session, "TRAIN_RESULT", {
			stationId = station.id,
			stat = station.stat,
			before = before,
			after = p.stats[station.stat],
			good = tr.good,
			ok = tr.ok,
			miss = tr.miss,
			passGood = station.passGood,
			gained = gained,
			completed = completed,
		})
		fx(session, if gained then "TRAIN_UP" else "TRAIN_END", { stationId = station.id })
		TelemetryService.log("train", { id = station.id, good = tr.good, gained = gained })
	end
	markDirty(session)
end

local function startTraining(session: Session, stationId: string): string
	local station = TrainingCatalog.get(stationId)
	local sc = scene
	if not station or not sc then
		return E.BAD_REQUEST
	end
	if session.state ~= S.CAMP then
		return E.WRONG_STATE
	end
	local p = progress(session)
	if p.trainedDay[station.id] == trainDayKey(session) then
		return E.BUSY -- 오늘은 이미 함 (클라이언트가 "내일 또!" 로 바꿔 보여 준다)
	end
	local part = sc.trains[station.id]
	local ch = session.player.Character
	if not part or not ch then
		return E.WRONG_STATE
	end
	if (ch:GetPivot().Position - part.Position).Magnitude > 14 then
		return E.WRONG_STATE
	end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	local stand = part.Position + Vector3.new(0, 3.2, 0)
	ch:PivotTo(CFrame.lookAt(stand, stand + part.CFrame.LookVector))
	if hum then
		hum.PlatformStand = true
	end
	if station.kind == "RANGE" then
		-- 모의 사격: 30초 동안 표적이 일어나면 눌러서 맞힌다 (사람·동물 모양 없음)
		for _, other in pairs(SessionService.Sessions) do
			if other ~= session and other.training and other.training.kind == "RANGE" then
				if hum then
					hum.PlatformStand = false
				end
				return E.BUSY -- 사격장은 한 번에 한 사람 (표적이 맵에 하나뿐)
			end
		end
		local now = os.clock()
		session.training = {
			stationId = station.id,
			startBeat = 0,
			beatsTotal = 0,
			good = 0,
			ok = 0,
			miss = 0,
			judged = {},
			lastBeat = -1,
			kind = "RANGE",
			endAt = now + (station.seconds or 30),
			up = {},
			nextPopAt = now + 1.5,
		}
		setState(session, S.TRAINING)
		cue(session, "LINE", { who = "KANG", text = CampScript.Range.start, sec = 3 })
		fx(session, "TRAIN_START", { stationId = station.id })
		return E.OK
	end
	local pattern = BeatPatterns.get(station.patternId) or BeatPatterns.Patterns.FLAT
	setPattern(session, pattern, station.bpm)
	session.training = {
		stationId = station.id,
		startBeat = RhythmService.currentBeat(session.beat) + 2, -- 두 박자 준비
		beatsTotal = station.beats,
		good = 0,
		ok = 0,
		miss = 0,
		judged = {},
		lastBeat = -1,
	}
	setState(session, S.TRAINING)
	cue(session, "LINE", { who = "SYSTEM", text = pattern.hintKo, sec = 3 })
	fx(session, "TRAIN_START", { stationId = station.id })
	return E.OK
end

tickTraining = function(session: Session)
	local tr = session.training
	if not tr then
		setState(session, S.CAMP)
		return
	end
	if tr.kind == "RANGE" then
		local now = os.clock()
		local up = tr.up :: { [number]: number }
		for i, untilT in pairs(up) do
			if now >= untilT then
				up[i] = nil
				tr.miss += 1
				setTargetUp("RANGE", i, false)
				markDirty(session)
			end
		end
		if now >= (tr.endAt :: number) then
			for i in pairs(up) do
				setTargetUp("RANGE", i, false)
			end
			finishTraining(session, true)
			return
		end
		if now >= (tr.nextPopAt :: number) then
			local n = targetCount("RANGE")
			local free = {}
			for i = 1, n do
				if not up[i] then
					table.insert(free, i)
				end
			end
			if #free > 0 then
				local i = free[session.rng:NextInteger(1, #free)]
				up[i] = now + rangeUpSec(session)
				setTargetUp("RANGE", i, true)
			end
			tr.nextPopAt = now + session.rng:NextNumber(0.75, 1.25)
			markDirty(session)
		end
		return
	end
	local b = RhythmService.currentBeat(session.beat)
	if b ~= tr.lastBeat then
		tr.lastBeat = b
		-- 지난 박자에 아무 입력도 없었고 눌러야 하는 박자였다면 MISS 로 센다
		local prev = b - 1
		if prev >= tr.startBeat and prev < tr.startBeat + tr.beatsTotal and not tr.judged[prev] then
			local expected = BeatPatterns.expected(session.pattern, prev)
			if expected ~= "REST" then
				tr.judged[prev] = true
				tr.miss += 1
			end
		end
		markDirty(session)
	end
	if b >= tr.startBeat + tr.beatsTotal + 1 then
		finishTraining(session, true)
	end
end

-- ===== 자유 이동 스테이지 틱 (22 v2): 탐조등 켜짐/꺼짐·발각·분대 응원 =====
local lightRings: { [string]: { BasePart } }? = nil
local function ringsOf(zoneId: string): { BasePart }
	if not lightRings then
		local map: { [string]: { BasePart } } = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") then
				local z = d:GetAttribute("LightRing")
				if typeof(z) == "string" then
					map[z] = map[z] or {}
					table.insert(map[z], d)
					-- 빛이 켜지면 바닥만 밝아지는 게 아니라 주변이 환해야 "탐조등" 으로 읽힌다 (검수 2026-10-20)
					if not d:FindFirstChildOfClass("PointLight") then
						local light = Instance.new("PointLight")
						light.Range = 40
						light.Brightness = 3
						light.Color = Color3.fromRGB(255, 244, 200)
						light.Enabled = false
						light.Parent = d
					end
				end
			end
		end
		lightRings = map
	end
	return (lightRings :: { [string]: { BasePart } })[zoneId] or {}
end

local function insideZone(part: BasePart, pos: Vector3): boolean
	local rel = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size / 2
	return math.abs(rel.X) <= h.X and math.abs(rel.Z) <= h.Z and rel.Y >= -h.Y - 2 and rel.Y <= h.Y + 4
end

local function tickFree(session: Session, _dt: number)
	local o = session.obby
	local sc = scene
	if not o or not sc then
		return
	end
	local now = os.clock()
	local ch = session.player.Character
	local hrpI = ch and ch:FindFirstChild("HumanoidRootPart")
	local hrp: BasePart? = if hrpI and hrpI:IsA("BasePart") then hrpI else nil
	local F = GameConfig.Free
	local speed = 0
	if hrp then
		if o.lastPos then
			local d = hrp.Position - o.lastPos
			speed = Vector3.new(d.X, 0, d.Z).Magnitude / math.max(_dt, 1 / 60)
		end
		o.lastPos = hrp.Position
	end
	for _, z in ipairs(sc.zonesByDay[session.day] or {}) do
		if z.zoneType == "SEARCH" then
			local period = z.onSec + z.offSec
			local phase = (now + z.phase) % period
			local on = phase < z.onSec
			if z.part:GetAttribute("LightOn") ~= on then
				z.part:SetAttribute("LightOn", on)
				for _, r in ipairs(ringsOf(z.id)) do
					r.Transparency = if on then 0.25 else 0.85
					local light = r:FindFirstChildOfClass("PointLight")
					if light then
						light.Enabled = on
					end
				end
				if on then
					RescueService.lightOn(session, z) -- 빛 안에 선 분대원이 언다 (2단계, 탐조등마다 하루 한 번)
				end
			end
			if on and ch and hrp and insideZone(z.part, hrp.Position) and now - o.lastSpotAt > 2.5 then
				if speed > F.SpotMoveSpeed and speed < 60 then -- 60 이상은 순간이동(복귀·시험)
					-- 발각: 뒤로 밀리는 대신 제자리 얼음 (27 §3 얼음땡, 2단계) — 분대원이 달려와 "땡!", 아무도 없어도 5초면 풀린다.
					-- 빛 안에서 멈춰 있으면 안 들킨다. 얼어 있는 동안·풀린 직후엔 다시 안 센다 (freezeMe 가 false)
					if RescueService.freezeMe(session, z) then
						o.lastSpotAt = now
						o.spotCount += 1
						fx(session, "SPOTTED")
						markDirty(session)
					end
				end
			end
		end
	end
	-- 분대원 응원 (유보트 없는 날): 돌아가며 한 마디·손 흔들기 — 지시가 아니라 같이 가는 말
	if now >= o.cheerAt and (GameConfig.Quiet.ObbyCheer or not GameConfig.Quiet.Enabled) then
		o.cheerAt = now + F.CheerEverySec
		local list = npcMembers(session)
		if #list > 0 then
			o.cheerIdx = o.cheerIdx % #list + 1
			local m = list[o.cheerIdx]
			local pool = (CampScript.Obby.Cheer :: { [string]: { string } })[m.id]
			if m.rig and pool and not m.friendUserId and not m.waiting and not RescueService.busy(session, m.id) then
				bubble(session, m.id, pool[math.random(#pool)], 2)
				SquadNpcService.playOnce(m.rig, if m.id == "DURI" then "cheer" else "wave")
			end
		end
	end
end

-- ===== 6일차 사격 문: 분대원도 쏜다 (27 §3 6일차 · 6단계) =====
-- 표적을 다 맞히면 문(보이지 않는 벽)이 열린다. 내가 맞히든 분대원이 맞히든 같은 결과 — 아이가 못 맞혀도 문은 열린다(규칙 ① 막지 않음).
-- 누가 맞혔는지는 표적 속성 HitBy 로 남긴다(ME = 기본 구멍색, 분대원 id = 다른 색 — RangeController 가 구멍을 그린다)
local function gateOpenIfDone(session: Session, id: string, g: GateState)
	if g.open or g.hits < g.need then
		return
	end
	g.open = true
	for i in pairs(g.up) do
		setTargetUp(g.group, i, false)
	end
	g.up = {}
	g.part.CanCollide = false
	g.part:SetAttribute("Open", true)
	fx(session, "GATE_OPEN", { id = id })
	lines(session, { CampScript.Obby.GATE_OPENED })
	TelemetryService.log("gate_open", { id = id, me = g.mine, squad = g.hits - g.mine })
	markDirty(session)
end

-- 내가 문 앞(GateSquadRadius 안, 문 앞쪽)에 오면 분대원이 내 옆에 서고, 처음 GateSquadFirstSec 은 아이가 먼저 쏘게 기다린 뒤
-- 저마다 GateSquadEverySec 마다 남은 표적 하나를 맞힌다 (넘어진·언 사람은 빼고). 맞힌 사람은 "point" 몸짓 + 말풍선
local function tickGateSquad(session: Session, now: number)
	local o = session.obby
	local ch = session.player.Character
	if not o or not ch or next(o.gates) == nil then
		return
	end
	local here = ch:GetPivot().Position
	local F = GameConfig.Free
	for id, g in pairs(o.gates) do
		if g.open then
			continue
		end
		local look = g.part.CFrame.LookVector
		local rel = here - g.part.Position
		local flatD = Vector3.new(rel.X, 0, rel.Z).Magnitude
		if flatD > F.GateSquadRadius then
			if o.gateAt == id then
				o.gateAt = nil
			end
			continue
		end
		-- 분대원은 내가 선 쪽(문 앞)에 선다
		local side = if rel:Dot(look) >= 0 then 1 else -1
		local face = -look * side -- 문을 바라보는 쪽
		local right = Vector3.new(-face.Z, 0, face.X)
		if o.gateAt ~= id then
			o.gateAt = id
			o.gateSquadNext = {}
			local i = 0
			for _, m in ipairs(npcMembers(session)) do
				if m.rig and not m.waiting and not RescueService.busy(session, m.id) then
					i += 1
					-- 내 왼쪽 옆으로 한 줄 (내 앞에 서면 카메라와 표적 사이를 가렸다 — Studio 6단계 캡처). 문(벽)에서는 StandBack 이상 떨어져
					local spot = here - right * (3 + (i - 1) * 2.6) - face * 0.5
					local toWall = (spot - g.part.Position):Dot(face)
					if toWall > -F.GateSquadStandBack then
						spot -= face * (toWall + F.GateSquadStandBack)
					end
					SquadNpcService.standAt(m.rig, spot, face)
					o.gateSquadNext[m.id] = now + F.GateSquadFirstSec + (i - 1) * F.GateSquadStaggerSec
				end
			end
			if i > 0 then
				local first = npcMembers(session)[1]
				if first then
					bubble(session, first.id, CampScript.Obby.GATE_SQUAD_CALL, 2)
				end
			end
		end
		for _, m in ipairs(npcMembers(session)) do
			local due = o.gateSquadNext[m.id]
			if not due or now < due or not m.rig or RescueService.busy(session, m.id) then
				continue
			end
			o.gateSquadNext[m.id] = now + F.GateSquadEverySec
			local left = {}
			for idx in pairs(g.up) do
				table.insert(left, idx)
			end
			if #left == 0 then
				break
			end
			local idx = left[session.rng:NextInteger(1, #left)]
			local tp = targetPart(g.group, idx)
			if tp then
				tp:SetAttribute("HitBy", m.id)
				SquadNpcService.standAt(m.rig, m.rig.hrp.Position, tp.Position - m.rig.hrp.Position)
			end
			SquadNpcService.playOnce(m.rig, "point")
			fx(session, "SQUAD_SHOT", {
				memberId = m.id,
				from = m.rig.hrp.Position + Vector3.new(0, 1.2, 0),
				to = if tp then tp.Position else g.part.Position,
			})
			gateHitTarget(session, g, idx, m.id, g.group)
			local pool = (CampScript.Obby.GATE_SQUAD_HIT :: { [string]: string })[m.id]
			if pool then
				bubble(session, m.id, pool, 1.4, true)
			end
			gateOpenIfDone(session, id, g)
			if g.open then
				break
			end
		end
	end
end

function SessionService.tick(session: Session, dt: number)
	CampfireService.tick(session, dt) -- 모닥불 허브 (1단계): 주운 것 되돌리기·분대원 줍기(유격·밤)·밤 역할·내일로 (낮에도 싸다)
	if session.state == S.TRAINING then
		tickTraining(session)
	elseif session.state == S.CAMP then
		-- 첫 1분 (28 §7): 분대원 구호·달려가기·부르기, 마당 입구에 들어서면 1일차 시작
		WelcomeService.tick(session, yardNext(session) and allowed(session).START_DAY == true)
	elseif session.state == S.OBBY then
		tickFree(session, dt)
		tickGateSquad(session, os.clock()) -- 6일차 사격 문: 분대원도 쏜다 (6단계)
		RescueService.tick(session, dt) -- 살리기 (2단계): 넘어짐 일정·자동 회복·얼음 풀림·분대원 달려오기
	elseif session.state == S.BUILD then
		BoatBuildService.tick(session, dt) -- 유보트 꾸미기 (3단계): 분대원 내밀기·가만히 60초 힌트·120초 출발
	elseif session.state == S.RIDE then
		-- 탑승 (4·5단계): 물리 배 목표 자세·무게 이동·장애물·낙수·끌어올리기. 진행 막대는 DirtyEverySec 마다
		local h = session.ride
		if h then
			RideService.tick(h, dt)
			local now = os.clock()
			if now - session.rideDirtyAt >= GameConfig.Ride.DirtyEverySec then
				session.rideDirtyAt = now
				session.snapshotDirty = true
			end
		end
	end
end

-- ===== 요청 처리 =====
local function rateOk(session: Session): boolean
	local now = os.clock()
	if now - session.inputWindowAt >= 1 then
		session.inputWindowAt = now
		session.inputCount = 0
	end
	session.inputCount += 1
	return session.inputCount <= R.MaxInputsPerSec
end

-- 박자 입력: 이제 기지 체력단련장 미니게임(TRAINING, 박자 기구)에서만 쓴다. 낮 작전·밤에는 박자가 없다 (27 §1 조작 셋, 6단계)
function SessionService.handleBeat(session: Session, tRaw: any, keyRaw: any)
	if session.state ~= S.TRAINING or not rateOk(session) then
		return
	end
	local tr = session.training
	if not tr or tr.kind == "RANGE" then
		return
	end
	local key: string = if keyRaw == "A" or keyRaw == "D" then keyRaw else "SPACE"
	local t = RhythmService.sanitizeTime(tRaw)
	local windowDelta = if session.loadout.oar == "LONG" then R.OarLongWindowDelta else R.OarShortWindowDelta
	local quality, beatN = RhythmService.judge(session.beat, t, windowDelta)
	local expected = BeatPatterns.expected(session.pattern, beatN)
	if not RhythmService.keyMatches(expected, key, false) then
		quality = "MISS"
	end
	if beatN < tr.startBeat or beatN >= tr.startBeat + tr.beatsTotal or tr.judged[beatN] then
		return
	end
	tr.judged[beatN] = true
	if quality == "GOOD" then
		tr.good += 1
	elseif quality == "OK" then
		tr.ok += 1
	else
		tr.miss += 1
	end
	fx(session, "HIT", { memberId = "ME", quality = quality })
	markDirty(session)
end

-- 배치 바꾸기 한 번 (밤 LoadoutPanel·꾸미기 마당 E 가 같은 길: 검증·저장·외형). ErrorCode 를 돌려준다
local function changeLoadout(session: Session, op: string, args: { [string]: any }): string
	local L = ProtocolTypes.LoadoutOp
	local lo = BoatLoadout.clone(session.loadout)
	if op == L.SEAT then
		local key, memberId = args.seatKey, args.memberId
		if not SquadCatalog.isSeat(key) then
			return E.INVALID_SEAT
		end
		if typeof(memberId) ~= "string" or not session.members[memberId] then
			return E.INVALID_MEMBER
		end
		local oldSeat = BoatLoadout.seatOf(lo, memberId)
		local displaced = lo.seats[key]
		lo.seats[key] = memberId
		if oldSeat and displaced then
			lo.seats[oldSeat] = displaced
		end
	elseif op == L.CARGO_ADD then
		local id = args.cargoId
		if typeof(id) ~= "string" or not BoatLoadout.Cargo[id] then
			return E.INVALID_CARGO
		end
		if table.find(lo.cargo, id) then
			return E.OK
		end
		if #lo.cargo >= GameConfig.Cargo.MaxSlots then
			return E.CARGO_FULL
		end
		table.insert(lo.cargo, id)
	elseif op == L.CARGO_REMOVE then
		local idx = table.find(lo.cargo, args.cargoId)
		if not idx then
			return E.INVALID_CARGO
		end
		table.remove(lo.cargo, idx)
	elseif op == L.OAR then
		if args.oar ~= "LONG" and args.oar ~= "SHORT" then
			return E.BAD_REQUEST
		end
		lo.oar = args.oar
	elseif op == L.RESET then
		lo = BoatLoadout.default()
	else
		return E.BAD_REQUEST
	end
	if not BoatLoadout.validate(lo, allMembersAllowed(session)) then
		return E.BAD_REQUEST
	end
	lo.revision = session.loadout.revision + 1
	session.loadout = lo
	progress(session).loadout = BoatLoadout.clone(lo)
	-- 꾸미는 중(3단계)이면 오늘 배치도 같이 (출발 때 한 번 더 남긴다)
	if session.state == S.BUILD then
		progress(session).loadoutByDay[tostring(session.day)] = BoatLoadout.clone(lo)
	end
	-- 유보트 모양: 실은 짐·노 길이·뱃머리 깃발 (3단계 — 밤에 패널로 바꿔도 기지 유보트가 바뀐다)
	BoatService.applyLoadoutVisual(session.boat, lo)
	-- 기지·밤에서 자리를 바꾸면 리그가 새 자리 순서로 다시 선다
	if session.state == S.CAMP then
		standSquadBeside(session)
	end
	fx(session, "LOADOUT")
	TelemetryService.log("loadout", { op = op })
	markDirty(session)
	return E.OK
end
changeLoadoutRef = changeLoadout

function SessionService.handleLoadout(session: Session, requestId: string, op: string, args: { [string]: any })
	if not allowed(session).LOADOUT then
		return result(session, requestId, false, E.WRONG_STATE)
	end
	local code = changeLoadout(session, op, args)
	if code ~= E.OK then
		return result(session, requestId, false, code)
	end
	result(session, requestId, true, E.OK, { feel = BoatLoadout.feelKo(session.loadout) })
end

local function returnToCamp(session: Session)
	stopRide(session) -- 타는 중 "기지로": 갑판·물리를 먼저 정리 (4·5단계)
	detachSquad(session)
	session.obby = nil
	local p = progress(session)
	session.day = p.day
	placeAtCamp(session, p.resumeCp, false)
	setState(session, S.CAMP)
end

-- 그물벽 앞 산 돕기 (2일차): E 키(INTERACT)와 산 머리 위 ProximityPrompt 가 같은 일을 한다.
-- Prompt 는 기기마다 맞는 입력을 스스로 보여 준다(PC E · 폰 탭 · 패드 X) — 폰에는 E 가 없어 산을 도울 수 없었다 (19 §9, 2026-10-19)
local function helpSan(session: Session): boolean
	if session.state ~= S.OBBY then
		return false
	end
	local san = session.members.SAN
	local ch = session.player.Character
	if not (san and san.waiting and san.rig and ch) then
		return false
	end
	local d = (san.rig.hrp.Position - ch:GetPivot().Position).Magnitude
	if d > GameConfig.Obby.SanHelpDistance then
		return false
	end
	san.waiting = false
	(session.obby :: Obby).sanHelpedAt = os.clock()
	local prompt = san.rig.hrp:FindFirstChild("CampSanPrompt")
	if prompt then
		prompt:Destroy()
	end
	session.rec.sanNet = true
	SquadNpcService.setMood(san.rig, "HAPPY")
	lines(session, { CampScript.Obby.SAN_GOES })
	local pad = (session.obby :: Obby).pads[(session.obby :: Obby).padIdx]
	if pad then
		SquadNpcService.standAt(
			san.rig,
			pad.part.Position + pad.part.CFrame.RightVector * 3,
			pad.part.CFrame.LookVector
		)
	end
	fx(session, "SAN_GOES")
	markDirty(session)
	return true
end

local function sanPrompt(session: Session, on: boolean)
	local san = session.members.SAN
	local rig = san and san.rig
	if not rig then
		return
	end
	local old = rig.hrp:FindFirstChild("CampSanPrompt")
	if not on then
		if old then
			old:Destroy()
		end
		return
	end
	if old then
		return
	end
	local p = Instance.new("ProximityPrompt")
	p.Name = "CampSanPrompt"
	p.ActionText = CampScript.Obby.SAN_PROMPT
	p.ObjectText = CampScript.Obby.SAN_PROMPT_WHO
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = 0
	p.MaxActivationDistance = GameConfig.Obby.SanHelpDistance
	p.RequiresLineOfSight = false
	p.Triggered:Connect(function(player)
		if player == session.player then
			helpSan(session)
		end
	end)
	p.Parent = rig.hrp
end

function SessionService.handleFlow(session: Session, requestId: string, op: string, choiceId: string?)
	local F = ProtocolTypes.FlowOp
	local a = allowed(session)
	local p = progress(session)
	if op == F.START_DAY then
		if not a.START_DAY then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		SessionService.startDay(session, StationCatalog.nextDay(p.day))
		return result(session, requestId, true, E.OK)
	elseif op == F.BUILD_GO then
		if not a.BUILD_GO or not BoatBuildService.skip(session) then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		return result(session, requestId, true, E.OK)
	elseif op == F.NEXT_DAY then
		if not a.NEXT_DAY then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		-- 아침마다 기지로 (14_INFILTRATION_CAMP §1): 체력단련·사격장·배치 자유시간 뒤 출발
		CampfireService.leaveNight(session) -- 모닥불 정리 + 밤 일지 한 줄 (1단계)
		stopRide(session) -- 혹시 남은 탑승 정리 (4·5단계, 멱등)
		detachSquad(session)
		session.obby = nil
		session.day = p.day
		placeAtCamp(session, "CP0", false)
		setState(session, S.CAMP)
		lines(session, CampScript.Morning)
		fx(session, "MORNING", { day = StationCatalog.nextDay(p.day) })
		return result(session, requestId, true, E.OK)
	elseif op == F.LETTER_SKIP then
		if session.state ~= S.LETTER or session.letterDone then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		session.letterDone = true
		enterGraduate(session)
		return result(session, requestId, true, E.OK)
	elseif op == F.REPLAY_DAY then
		-- 밤에 배치를 바꾸고 같은 코스를 한 번 더 (재도전). 저장 진행(p.day)은 그대로
		if not a.REPLAY_DAY then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		TelemetryService.log("replay_day", { day = p.day })
		local before = p.loadoutByDay[tostring(p.day)]
		session.lastAttempt = if before then BoatLoadout.clone(before) else nil
		SessionService.startDay(session, p.day)
		return result(session, requestId, true, E.OK)
	elseif op == F.RETURN_CAMP then
		if not a.RETURN_CAMP then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		returnToCamp(session)
		return result(session, requestId, true, E.OK)
	elseif op == F.INTERACT then
		-- E 의 서버 길 (ProximityPrompt 가 못 잡는 "가까운 사람" 판정). 할 게 없으면 조용히 받는다 — E 가 다른 일(옛 악!)로 새지 않게 (6단계)
		-- 탑승 (4·5단계): 가까운(9) 매달린 분대원 끌어올리기. 머리 위 프롬프트(Hold 0.6)와 같은 일 — 없으면 조용히 받는다 (잘못 눌렀다는 안내 없이)
		if session.state == S.RIDE then
			if session.ride then
				RideService.interact(session.ride, session.player)
			end
			return result(session, requestId, true, E.OK)
		end
		if session.state ~= S.OBBY then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		-- 가까운 넘어진/언 분대원이 먼저 (2단계) → 그물벽 앞 산. 둘 다 아니면 아무 일 없음 (E 는 프롬프트 동사 하나 — 27 §1 규칙 ④)
		if not RescueService.interact(session) then
			helpSan(session)
		end
		return result(session, requestId, true, E.OK)
	elseif op == F.GRADUATE_DONE then
		if session.state ~= S.GRADUATE and not a.REENTER then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		if choiceId == "REENTER" then
			p.entryCount += 1
			p.lastEntryLoadout = BoatLoadout.clone(session.loadout)
			p.day = 0
			p.resumeCp = "CP0"
			p.drops = 0
			p.loadoutByDay = {}
			session.day = 0
			session.obby = nil
			CampfireService.leaveNight(session) -- 1단계: 밤에서 바로 다시 입소해도 모닥불 프롬프트가 남지 않게
			detachSquad(session)
			placeAtCamp(session, "CP0", false)
			setState(session, S.CAMP)
			addBadge(session, "REENTER")
			session.rel = { helped = {}, helpedMe = {} } -- 새 입소는 새 기록
			session.rec = { sanNet = false }
			p.runTimes = {} -- 새 입소는 수료 기록을 새로 잰다
			local list = table.clone(CampScript.Reentry)
			local last = p.lastEntryLoadout
			if last then
				local who = SquadCatalog.get(last.seats.FL)
				if who and who.id ~= "ME" then
					table.insert(list, {
						who = "DURI",
						text = string.format(
							CampScript.RememberSeat,
							KoreanText.josa(who.nameKo, "이/가"),
							SquadCatalog.SeatNameKo.FL
						),
						sec = 3,
					})
				end
			end
			lines(session, list)
			fx(session, "REENTER")
			TelemetryService.log("reenter", { entry = p.entryCount })
		else
			detachSquad(session)
			placeAtCamp(session, "CP6", false)
			setState(session, S.CAMP)
		end
		markDirty(session)
		task.spawn(ProfileStoreService.save, session.handle)
		return result(session, requestId, true, E.OK)
	elseif op == F.TRAIN_START then
		local code = startTraining(session, tostring(choiceId))
		return result(session, requestId, code == E.OK, code)
	elseif op == F.TRAIN_STOP then
		if session.state ~= S.TRAINING then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		finishTraining(session, false)
		return result(session, requestId, true, E.OK)
	elseif op == F.SKIP_TUTORIAL then
		p.tutorialDone = true
		markDirty(session)
		return result(session, requestId, true, E.OK)
	elseif op == F.STORY_CHOICE then
		-- 선택 비트 id 는 기록만 (지금은 쓰는 곳 없음 — 갈림길(FORK)은 6단계에서 지움)
		if typeof(choiceId) == "string" and #choiceId <= 16 then
			table.insert(p.seenBeats, "CHOICE:" .. choiceId)
			markDirty(session)
		end
		return result(session, requestId, true, E.OK)
	end
	return result(session, requestId, false, E.BAD_REQUEST)
end

function SessionService.handleLetter(session: Session, requestId: string, toId: any, chips: any, freeText: any)
	if not allowed(session).LETTER then
		return result(session, requestId, false, E.WRONG_STATE)
	end
	local ok, letter = LetterService.validate(toId, chips, session.letterChipSet)
	if not ok or not letter then
		return result(session, requestId, false, E.BAD_REQUEST)
	end
	local textOk, filtered = LetterService.filterFreeText(session.userId, freeText)
	if not textOk then
		return result(session, requestId, false, E.TEXT_FILTERED)
	end
	letter.text = filtered
	local p = progress(session)
	table.insert(p.letters, letter)
	while #p.letters > GameConfig.Save.LettersLimit do
		table.remove(p.letters, 1)
	end
	session.letterDone = true
	addSticker(session, "LETTER")
	addBadge(session, "LETTER")
	-- 분대원·교관에게 쓰면 그 사람이 이번 입소 기록으로 한 줄 답한다. 그다음 퇴소식
	local reply = replyFor(session, letter.toId)
	local seq: { CampScript.Line } = { { who = "SYSTEM", text = CampScript.FinalLetter.sealed, sec = 2.5 } }
	if reply then
		table.insert(seq, reply)
	end
	lines(session, seq)
	fx(session, "SEALED")
	TelemetryService.log("letter", { chips = #letter.chips, hasText = letter.text ~= nil, to = letter.toId })
	markDirty(session)
	result(session, requestId, true, E.OK)
	local wait = 2.8 + (if reply then (reply.sec or 3) + 0.5 else 0)
	task.delay(wait, function()
		if session.state == S.LETTER then
			enterGraduate(session)
		end
	end)
end

function SessionService.handleSettings(session: Session, requestId: string, key: string, value: any)
	local settings = session.handle.profile.settings
	if settings[key] == nil or typeof(value) ~= typeof(settings[key]) then
		return result(session, requestId, false, E.BAD_REQUEST)
	end
	if typeof(value) == "number" then
		value = math.clamp(value, 0, 1)
	end
	settings[key] = value
	markDirty(session)
	result(session, requestId, true, E.OK)
end

-- 탑승 입력 (리모트 이름 CarryInput 은 옛 그대로): 앉아서 직접 젓기 — move = W 노 젓기, steer = A/D 방향 −1..1 (판정은 RideService).
-- 친구 자리(RIDING)는 아직 배에 안 탄다 (28 §7 남긴 것)
function SessionService.handleCarryInput(session: Session, move: any, steer: any)
	if session.state == S.RIDE and session.ride then
		local st = if typeof(steer) == "number" and steer == steer then math.clamp(steer, -1, 1) else 0
		RideService.setInput(session.ride :: RideService.Handle, move == true, st)
	end
end

-- 기록판 요청 (15_RECORDS): 상위 10 + 모드. 이름은 "○○의 소대" 로 클라이언트가 붙인다
function SessionService.handleLeaderboard(session: Session, requestId: string, board: any)
	if not LeaderboardService.isBoard(board) then
		return result(session, requestId, false, E.BAD_REQUEST)
	end
	local rows, mode = LeaderboardService.top(board)
	local out = {}
	for _, r in ipairs(rows) do
		table.insert(out, { rank = r.rank, name = r.name, cs = r.cs, isMe = r.userId == session.userId })
	end
	result(session, requestId, true, E.OK, { board = board, mode = mode, rows = out })
end

-- 자유 스테이지 사격 문 (22 v2 · 6단계): 길목 표적 n개를 다 맞히면 문이 열린다(막는 벽 CanCollide 끔).
-- 분대원도 옆에서 같이 쏜다 (tickGateSquad) — 내가 맞힌 구멍은 기본 색, 분대원 구멍은 다른 색
local function freeGateShot(session: Session, group: string, index: number)
	local o = session.obby
	if not o then
		return
	end
	for id, g in pairs(o.gates) do
		if g.group == group then
			if g.open or not g.up[index] then
				fx(session, "TARGET_MISS", { group = group })
				return
			end
			gateHitTarget(session, g, index, "ME", group)
			gateOpenIfDone(session, id, g)
			return
		end
	end
	fx(session, "TARGET_MISS", { group = group })
end

-- 모의 사격: 표적을 누름 (기지 사격장 또는 6일차 탈출 문). 서 있는 표적만 맞는다
function SessionService.handleRangeShot(session: Session, group: any, index: any)
	if typeof(group) ~= "string" or typeof(index) ~= "number" or index ~= index then
		return
	end
	index = math.floor(index)
	local now = os.clock()
	-- 서버 거리 검사 (검수 2026-10-20): 클라이언트 조준 반경은 손맛일 뿐이라, 표적에서 너무 멀면 맞힘으로 치지 않는다
	if index >= 1 then
		local tp = targetPart(group, index)
		local ch = session.player.Character
		if tp and ch and (tp.Position - ch:GetPivot().Position).Magnitude > GameConfig.Range.AimRadius + 15 then
			fx(session, "TARGET_MISS", { group = group })
			return
		end
	end
	if group == "RANGE" then
		local tr = session.training
		if session.state ~= S.TRAINING or not tr or tr.kind ~= "RANGE" or not tr.up then
			return
		end
		if tr.up[index] and now <= tr.up[index] then
			tr.up[index] = nil
			tr.good += 1
			setTargetUp("RANGE", index, false)
			fx(session, "TARGET_HIT", { group = group, index = index })
		else
			fx(session, "TARGET_MISS", { group = group })
		end
		markDirty(session)
	elseif string.sub(group, 1, 4) == "GATE" and session.state == S.OBBY then
		freeGateShot(session, group, index)
	end
end

-- ===== 유격 터치 =====
local function touchedPlayer(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return if model then Players:GetPlayerFromCharacter(model) else nil
end

-- 다음 발판을 노랗게 빛낸다 (FallHelpAfter 2단계): 눈에 보이는 발판(PADV_id)에 Highlight. 그 발판에 닿으면 끈다
local function padGlow(pad: SceneBindings.Pad, on: boolean)
	local folder = SceneBindings.getFolder("TerrainProps")
	local v = folder and folder:FindFirstChild("PADV_" .. pad.id)
	if not v then
		return
	end
	local old = v:FindFirstChild("CampPadGlow")
	if not on then
		if old then
			old:Destroy()
		end
		return
	end
	if old then
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "CampPadGlow"
	h.FillColor = Palette.Yellow
	h.FillTransparency = 0.45
	h.OutlineColor = Palette.Yellow
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = v
end

local function onPadTouched(pad: SceneBindings.Pad, hit: BasePart)
	local player = touchedPlayer(hit)
	if not player then
		return
	end
	local session = SessionService.Sessions[player.UserId]
	if not session or session.state ~= S.OBBY then
		return
	end
	local o = session.obby :: Obby
	if pad.index <= o.padIdx then
		return
	end
	if pad.index > o.padIdx then
		o.padIdx = pad.index
	end
	padGlow(pad, false)
	local pos = pad.part.Position
	local look = pad.part.CFrame.LookVector
	local i = 0
	for _, m in ipairs(npcMembers(session)) do
		i += 1
		local rig = m.rig :: SquadNpcService.Rig
		if m.id == "SAN" and pad.sanWaits and m.def.height == 1 then
			-- 산은 그물벽 앞에서 멈춘다 (E 같이 가기)
			if not m.waiting then
				SquadNpcService.standAt(rig, pos + pad.part.CFrame.RightVector * (2 + i * 1.5), look)
				m.waiting = true
				o.sanStopped = true
				SquadNpcService.setMood(rig, "WAIT")
				sanPrompt(session, true)
				lines(
					session,
					{ CampScript.Obby.SAN_WAITS, { who = "SYSTEM", text = CampScript.Obby.SAN_HELP_HINT, sec = 3 } }
				)
			end
			continue
		end
		if m.id == "SAN" and m.waiting then
			continue
		end
		if RescueService.busy(session, m.id) then
			continue -- 넘어져 있거나 언 사람은 그 자리에 (2단계)
		end
		SquadNpcService.standAt(rig, pos + pad.part.CFrame.RightVector * (2 + i * 1.5), look)
	end
	o.respawn = pos
	-- 유보트도 발판 옆으로 (분대원이 옮긴 것으로 연출) — 자유 스테이지 날엔 기지에 둔 채 (22 v2)
	if not freeDay(session) then
		BoatService.setMode(session.boat, "PARK")
		BoatService.place(session.boat, pos + pad.part.CFrame.RightVector * 9, look)
	end
	if pad.id == "P_NET_TOP" and not o.bellRung then
		o.bellRung = true
		addBadge(session, "NET")
		fx(session, "BELL", { pos = pos })
		lines(session, { CampScript.Obby.BELL })
	end
	fx(session, "PAD", { id = pad.id })
	markDirty(session)
end

local function onFallTouched(hit: BasePart)
	local player = touchedPlayer(hit)
	if not player then
		return
	end
	local session = SessionService.Sessions[player.UserId]
	if not session or session.state ~= S.OBBY then
		return
	end
	local o = session.obby :: Obby
	local now = os.clock()
	if now - o.lastFallAt < 1 then
		return
	end
	o.lastFallAt = now
	local pad = o.pads[o.padIdx]
	if pad and player.Character then
		o.falls += 1
		-- 도움 사다리 (FallHelpAfter, 20_DAYS_UNIFY): 같은 발판에서 거듭 떨어지면 한 마디 → 다음 발판 빛남 → 산이 손 잡아 같이
		local k = o.padIdx
		o.fallsByPad[k] = (o.fallsByPad[k] or 0) + 1
		local nf = o.fallsByPad[k]
		local H = GameConfig.Obby.FallHelpAfter
		local nextPad = o.pads[o.padIdx + 1]
		local OBY = CampScript.Obby
		if nf >= H[3] and nextPad and GameConfig.Obby.SquadDoesIt then
			if session.members.SAN and session.members.SAN.rig then
				bubble(session, "SAN", OBY.FALL_ASSIST, 2)
			end
			player.Character:PivotTo(CFrame.new(nextPad.part.Position + Vector3.new(0, 3.5, 0)))
			fx(session, "FALL_ASSIST")
			markDirty(session)
			return
		end
		player.Character:PivotTo(CFrame.new((o.respawn or pad.part.Position) + Vector3.new(0, 3.5, 0)))
		lines(session, { CampScript.Obby.FALL })
		fx(session, "FALL")
		local counter = counterOf(session)
		if nf >= H[2] and nextPad then
			padGlow(nextPad, true)
			if counter then
				bubble(session, counter, OBY.FALL_GLOW, 2)
			end
		elseif nf >= H[1] and counter then
			bubble(session, counter, OBY.FALL_HINT, 2)
		end
		markDirty(session)
	end
end

local function onCpTouched(cp: SceneBindings.Checkpoint, hit: BasePart)
	local player = touchedPlayer(hit)
	if not player then
		return
	end
	local session = SessionService.Sessions[player.UserId]
	if not session or session.state ~= S.OBBY then
		return
	end
	if cp.id == StationCatalog.idForDay(session.day) then
		-- 깃발을 덜 찍었으면 도착이 아니다 — 한 줄만 알린다 ("완료 안 했는데 넘어갔다" 로 느껴지지 않게, 21 §1-4)
		local o = session.obby :: Obby
		if o.flagsDone < o.flagsNeed then
			if os.clock() - (o.cpBlockedAt or -99) > 4 then
				o.cpBlockedAt = os.clock()
				lines(session, {
					{
						who = "KANG",
						text = string.format(CampScript.Obby.CP_FLAGS_LEFT, o.flagsNeed - o.flagsDone),
						sec = 2.5,
					},
				})
			end
			return
		end
		arriveCheckpoint(session, cp.id)
	end
end

-- 분대는 다음 깃발(다 밟았으면 도착점) 앞에 서서 나를 보며 응원한다 (22 v2 "친구들이 응원해 주는 걸로")
local function freeSquadAhead(session: Session)
	local sc = scene :: SceneBindings.Scene
	local o = session.obby :: Obby
	local target: Vector3? = nil
	if o.flagsDone < o.flagsNeed then
		for _, fl in ipairs(sc.flagsByDay[session.day] or {}) do
			if not o.flags[fl.id] then
				target = fl.part.Position
				break
			end
		end
	end
	if not target then
		local cp = sc.cps[StationCatalog.idForDay(session.day)]
		target = if cp then cp.part.Position else nil
	end
	if not target then
		return
	end
	local ch = session.player.Character
	local from = if ch then ch:GetPivot().Position else target
	local toward = Vector3.new(from.X - target.X, 0, from.Z - target.Z)
	local look = if toward.Magnitude > 0.5 then toward.Unit else Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local i = 0
	for _, m in ipairs(npcMembers(session)) do
		if m.rig and not m.waiting then
			i += 1
			if not RescueService.busy(session, m.id) then -- 넘어져 있거나 언 사람은 그 자리에 (2단계)
				SquadNpcService.standAt(m.rig, target + look * 5 + right * ((i - 2) * 2.5), look)
			end
		end
	end
	RescueService.maybeFall(session) -- 달려가다 하나가 넘어진다 (곧 넘어질 차례일 때만, 2단계)
end

-- 깃발 (자유 이동 스테이지, 22 v2): 아무 순서로 밟는다. 밟은 깃발이 다음 추락 복귀 자리
local function onFlagTouched(fl: SceneBindings.Flag, hit: BasePart)
	local player = touchedPlayer(hit)
	if not player then
		return
	end
	local session = SessionService.Sessions[player.UserId]
	if not session or session.state ~= S.OBBY or session.day ~= fl.day then
		return
	end
	local o = session.obby :: Obby
	if o.flags[fl.id] then
		return
	end
	o.flags[fl.id] = true
	o.flagsDone += 1
	o.respawn = fl.part.Position
	fl.part:SetAttribute("Taken", true)
	local cloth = workspace:FindFirstChild(fl.id .. "_Cloth", true)
	if cloth and cloth:IsA("BasePart") then
		cloth.Color = Color3.fromHex("8EE59A") -- 찍은 깃발은 초록
	end
	local OBY = CampScript.Obby
	fx(session, "FLAG", { id = fl.id, pos = fl.part.Position })
	if o.flagsDone >= o.flagsNeed then
		lines(session, { OBY.FLAGS_DONE })
	else
		lines(session, {
			{
				who = "KANG",
				text = string.format(OBY.FLAG_TAKEN.text, o.flagsDone, o.flagsNeed),
				sec = OBY.FLAG_TAKEN.sec,
			},
		})
	end
	freeSquadAhead(session)
	markDirty(session)
end

function SessionService.bindSceneTouches()
	local sc = scene
	if not sc then
		return
	end
	for _, list in pairs(sc.padsByDay) do
		for _, pad in ipairs(list) do
			pad.part.Touched:Connect(function(hit)
				onPadTouched(pad, hit)
			end)
		end
	end
	for _, f in ipairs(sc.falls) do
		f.Touched:Connect(onFallTouched)
	end
	for _, cp in pairs(sc.cps) do
		cp.part.Touched:Connect(function(hit)
			onCpTouched(cp, hit)
		end)
	end
	for _, list in pairs(sc.flagsByDay) do
		for _, fl in ipairs(list) do
			fl.part.Touched:Connect(function(hit)
				onFlagTouched(fl, hit)
			end)
		end
	end
end

-- ===== 친구 자리 (CoopService 가 호출) =====
function SessionService.mountFriend(host: Session, guest: Session, memberId: string): boolean
	local m = host.members[memberId]
	if not m or m.id == "ME" or m.friendUserId then
		return false
	end
	m.friendUserId = guest.userId
	if m.rig then
		-- 분대원은 유보트 옆에서 걷는다 (사라지지 않음)
		BoatService.detach(host.boat, m.rig.model)
		SquadNpcService.afterDetach(m.rig)
		SquadNpcService.standAt(
			m.rig,
			host.boat.root.Position + host.boat.root.CFrame.RightVector * 7,
			host.boat.root.CFrame.LookVector
		)
	end
	guest.coop = { role = "GUEST", partnerUserId = host.userId, memberId = memberId }
	host.coop = { role = "HOST", partnerUserId = guest.userId, memberId = memberId }
	setState(guest, S.RIDING)
	if guest.player.Character then
		BoatService.standBeside(host.boat, guest.player.Character, 1)
	end
	markDirty(host)
	markDirty(guest)
	return true
end

function SessionService.unmountFriend(host: Session, guest: Session)
	for _, m in pairs(host.members) do
		if m.friendUserId == guest.userId then
			m.friendUserId = nil
			if guest.player.Character then
				BoatService.detach(host.boat, guest.player.Character)
			end
		end
	end
	host.coop = nil
	guest.coop = nil
	if guest.state == S.RIDING then
		local p = progress(guest)
		placeAtCamp(guest, p.resumeCp, false)
		setState(guest, S.CAMP)
	end
	markDirty(host)
	markDirty(guest)
end

-- ===== 생명주기 =====
local function onCharacter(session: Session, character: Model)
	task.wait(0.2)
	if session.state == S.RIDE and session.ride then
		RideService.onCharacter(session.ride :: RideService.Handle, character) -- 리셋·리스폰: 갑판 가운데로 (4·5단계)
		return
	end
	if session.state == S.OBBY then
		local o = session.obby
		local pad = o and o.pads[o.padIdx]
		-- 마지막으로 찍은 깃발(respawn)이 있으면 거기로 — 깃발 둘 찍고 리셋하면 출발로 돌아가던 것 (검수 2026-10-20)
		local pos = if o and o.respawn then o.respawn elseif pad then pad.part.Position else nil
		if pos then
			character:PivotTo(CFrame.new(pos + Vector3.new(0, 3.5, 0)))
		end
	elseif session.state == S.RIDING and session.coop then
		local host = SessionService.Sessions[session.coop.partnerUserId]
		if host then
			BoatService.standBeside(host.boat, character, 1)
		end
	elseif session.state == S.CAMP and session.currentCp == "CP0" and yardNext(session) then
		WelcomeService.placeMe(session, character) -- 첫 1분: 스폰 앞에서 꾸미기 마당을 본다 (유보트는 거치대)
	else
		BoatService.standBeside(session.boat, character, 0)
	end
end

-- 첫 1분이 쓰는 손 (28 §7): 말·말풍선·카드, 마당 입구에 들어서면 출발 버튼과 같은 길로 1일차
WelcomeService.setHooks({
	lines = lines,
	bubble = function(s: any, memberId: string, text: string, sec: number?)
		bubble(s, memberId, text, sec)
	end,
	cue = cue,
	arrive = function(s: any)
		if s.state == S.CAMP and allowed(s).START_DAY then
			SessionService.startDay(s, StationCatalog.nextDay(progress(s).day))
		end
	end,
})

function SessionService.onPlayerAdded(player: Player)
	if not npcFolder then
		local f = Instance.new("Folder")
		f.Name = "CampSquads"
		f.Parent = SceneBindings.ensureRuntimeFolder()
		npcFolder = f
	end
	local handle = ProfileStoreService.load(player.UserId)
	local p = handle.profile.progress
	local members: { [string]: Member } = {}
	for id, def in pairs(SquadCatalog.Members) do
		members[id] = {
			id = id,
			def = def,
			rig = nil,
			friendUserId = nil,
			morale = GameConfig.Morale.Start,
			waiting = false,
		}
	end
	local squadHolder = Instance.new("Folder")
	squadHolder.Name = "Squad_" .. player.UserId
	squadHolder.Parent = npcFolder
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		members[id].rig = SquadNpcService.createRig(SquadCatalog.Members[id], squadHolder)
	end
	local boat = BoatService.create(player.UserId, string.format("%d기 · %s", p.entryCount, player.DisplayName))
	local session: Session = {
		player = player,
		userId = player.UserId,
		handle = handle,
		state = S.LOADING,
		day = p.day,
		loadout = BoatLoadout.clone(p.loadout),
		members = members,
		boat = boat,
		beat = RhythmService.newClock(100),
		obby = nil,
		ride = nil,
		rideLog = nil,
		rideDirtyAt = 0,
		flashlight = false,
		bubbleHold = {},
		pattern = BeatPatterns.Patterns.FLAT,
		lastAttempt = nil,
		rel = { helped = {}, helpedMe = {} },
		rec = { sanNet = false },
		letterChipSet = {},
		stageDay = nil,
		stageStartAt = 0,
		stageStartServer = 0,
		stagePaused = 0,
		timingInvalid = false,
		lastStage = nil,
		training = nil,
		snapshotDirty = true,
		rng = Random.new(player.UserId),
		letterDone = false,
		coop = nil,
		inputCount = 0,
		inputWindowAt = 0,
		currentCp = p.resumeCp,
	}
	SessionService.Sessions[player.UserId] = session
	BoatService.setStickers(boat, p.stickers)
	BoatService.applyLoadoutVisual(boat, session.loadout) -- 꾸민 유보트 모양 (짐·노·깃발, 3단계)
	placeAtCamp(session, p.resumeCp, false)
	setState(session, S.CAMP)
	addBadge(session, "ENTER")
	player.CharacterAdded:Connect(function(ch)
		onCharacter(session, ch)
	end)
	if player.Character then
		task.spawn(onCharacter, session, player.Character)
	end
	-- 첫 입소 (6단계: 첫 들기 연습 없음): 교관 구호 → 조작 셋 카드 한 장 (걷기·점프·E). 첫 출발을 누르면 끝 (tutorialDone)
	-- 첫 1분(28 §7): 1일차 전이면 WelcomeService 가 구호·"악!"·분대원 달려가기·조작 카드를 맡는다 (placeAtCamp 에서 시작)
	if not p.tutorialDone and not yardNext(session) then
		task.delay(1.0, function()
			if SessionService.Sessions[player.UserId] == session then
				lines(session, CampScript.Intro)
			end
		end)
		task.delay(3.6, function() -- 입소 카드(IntroCard 3.2초)가 걷힌 뒤
			if SessionService.Sessions[player.UserId] == session and not p.tutorialDone then
				cue(session, "TUTORIAL", { cards = CampScript.Tutorial })
			end
		end)
	end
	SessionService.pushSnapshot(session)
	TelemetryService.log("join", { mode = handle.mode })
end

function SessionService.onPlayerRemoving(player: Player)
	local session = SessionService.Sessions[player.UserId]
	if not session then
		return
	end
	session.state = S.DISCONNECTING
	-- 친구 자리 정리
	if session.coop then
		local other = SessionService.Sessions[session.coop.partnerUserId]
		if other then
			if session.coop.role == "GUEST" then
				SessionService.unmountFriend(other, session)
			else
				SessionService.unmountFriend(session, other)
			end
		end
	end
	SessionService.Sessions[player.UserId] = nil
	CampfireService.onPlayerRemoving(session) -- 밤 프롬프트·소품 정리 (1단계)
	RescueService.onPlayerRemoving(session) -- 프롬프트·걸음 정리 (2단계)
	BoatBuildService.onPlayerRemoving(session) -- 꾸미기 프롬프트·소품 정리 (3단계)
	WelcomeService.onPlayerRemoving(session) -- 첫 1분 달리기 정리
	stopRide(session) -- 갑판·프롬프트·분대원 모터 정리 (4·5단계, 유보트를 지우기 전에)
	ProfileStoreService.save(session.handle, true)
	for _, m in pairs(session.members) do
		if m.rig then
			SquadNpcService.destroy(m.rig)
		end
	end
	if npcFolder then
		local holder = npcFolder:FindFirstChild("Squad_" .. player.UserId)
		if holder then
			holder:Destroy()
		end
	end
	BoatService.destroy(session.boat)
end

function SessionService.saveAll(final: boolean)
	for _, session in pairs(SessionService.Sessions) do
		if session.handle.dirty or final then
			ProfileStoreService.save(session.handle, false)
		end
	end
end

function SessionService.renewLeases()
	for _, session in pairs(SessionService.Sessions) do
		if session.handle.mode == ProtocolTypes.PersistenceMode.SAVING then
			ProfileStoreService.save(session.handle, false)
		end
	end
end

SessionService.cpSpot = cpSpot

return SessionService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003ef</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6219">
          <Properties>
            <string name="Name">SquadNpcService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{65E5EDAE-1ABE-41BE-BD1E-B2F7E66C816D}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 분대원 셋(두리·산·미르)과 강찬 교관의 R15 리그. 로블록스 기본 R15 애니 자산만 쓴다 (존재하는 ID).
-- 리그는 유보트에 붙거나(들기/노), 발판 옆에 서거나(유격), 모닥불 둘레에 앉는다. 말풍선은 속성(Bubble)으로 클라이언트가 그린다.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local UniformService = require(script.Parent:WaitForChild("UniformService"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local SquadNpcService = {}

-- 로블록스 기본 R15 애니메이션 (Rob_mind RoomFactory 에서 Studio 재생 확인된 idle/wave/cheer/point + 기본 sit)
local ANIM_IDS = {
	idle = "rbxassetid://507766666",
	wave = "rbxassetid://507770239",
	cheer = "rbxassetid://507770677",
	point = "rbxassetid://507770453",
	sit = "rbxassetid://2506281703",
}

export type Rig = {
	memberId: string,
	model: Model,
	humanoid: Humanoid,
	hrp: BasePart,
	animator: Animator,
	idleTrack: AnimationTrack?,
	sitTrack: AnimationTrack?,
	runTrack: AnimationTrack?, -- 달려올 때 (2단계 살리기: 플레이어 Animate 의 run 애니 id 를 읽어 쓴다 — 새 자산 id 없음)
	onceTracks: { [string]: AnimationTrack }?, -- playOnce 손짓 (마감 패스: 매번 LoadAnimation 하면 30분 플레이에 리그당 트랙 64개 한도를 넘어 손짓·달리기가 멈췄다)
}

local function makeDescription(member: SquadCatalog.Member): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = Palette.Skin
	desc.TorsoColor = member.shirt
	desc.LeftArmColor = member.shirt
	desc.RightArmColor = member.shirt
	desc.LeftLegColor = member.pants
	desc.RightLegColor = member.pants
	desc.HeightScale = member.scale
	desc.WidthScale = member.scale
	desc.DepthScale = member.scale
	desc.HeadScale = member.scale * 1.05
	return desc
end

-- 명찰(빨간 판)·팔각모(짙은 올리브 원판)를 파트로 붙인다
local function dressUp(model: Model, member: SquadCatalog.Member)
	local torso = model:FindFirstChild("UpperTorso") :: BasePart?
	local head = model:FindFirstChild("Head") :: BasePart?
	if torso then
		local tag = Instance.new("Part")
		tag.Name = "NameTag"
		tag.Size = Vector3.new(0.9, 0.3, 0.08)
		tag.Color = Palette.Red
		tag.Material = Enum.Material.SmoothPlastic
		tag.CanCollide = false
		tag.CanQuery = false
		tag.CanTouch = false
		tag.Massless = true
		tag.CFrame = torso.CFrame * CFrame.new(-0.35, 0.35, -0.55)
		tag:SetAttribute("SignText", member.nameKo)
		tag.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = torso
		w.Part1 = tag
		w.Parent = tag
	end
	if head then
		local cap = Instance.new("Part")
		cap.Name = "Cap"
		cap.Shape = Enum.PartType.Cylinder
		cap.Size = Vector3.new(0.35, 1.35, 1.35)
		cap.Color = Palette.OliveDark
		cap.Material = Enum.Material.Fabric
		cap.CanCollide = false
		cap.CanQuery = false
		cap.CanTouch = false
		cap.Massless = true
		cap.CFrame = head.CFrame * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90))
		cap.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = cap
		w.Parent = cap
		local brim = Instance.new("Part")
		brim.Name = "CapBrim"
		brim.Size = Vector3.new(1.3, 0.1, 0.6)
		brim.Color = Palette.OliveDark
		brim.Material = Enum.Material.Fabric
		brim.CanCollide = false
		brim.CanQuery = false
		brim.CanTouch = false
		brim.Massless = true
		brim.CFrame = head.CFrame * CFrame.new(0, 0.42, -0.75)
		brim.Parent = model
		local w2 = Instance.new("WeldConstraint")
		w2.Part0 = head
		w2.Part1 = brim
		w2.Parent = brim
	end
end

function SquadNpcService.createRig(member: SquadCatalog.Member, parent: Instance): Rig
	local model = Players:CreateHumanoidModelFromDescription(makeDescription(member), Enum.HumanoidRigType.R15)
	model.Name = "Npc_" .. member.id
	model:SetAttribute("MemberId", member.id)
	model:SetAttribute("NameKo", member.nameKo)
	model:SetAttribute("ProjectId", SceneBindings.ProjectId)
	for _, s in ipairs(model:GetChildren()) do
		if s:IsA("LuaSourceContainer") then
			s:Destroy()
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.AutoRotate = false
	hum.EvaluateStateMachine = false
	hum.PlatformStand = true
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Massless = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
		end
	end
	-- 입소 훈련복은 플레이어와 같게, 사람 구분은 왼팔 완장 색(옛 셔츠 색)으로 (M025)
	UniformService.applyClothes(model)
	UniformService.attachBackRifle(model)
	local arm = model:FindFirstChild("LeftUpperArm") :: BasePart?
	if arm then
		local band = Instance.new("Part")
		band.Name = "Armband"
		band.Size = Vector3.new(arm.Size.X + 0.08, 0.32, arm.Size.Z + 0.08)
		band.Color = member.shirt
		band.Material = Enum.Material.SmoothPlastic
		band.CanCollide = false
		band.CanQuery = false
		band.CanTouch = false
		band.Massless = true
		band.CFrame = arm.CFrame * CFrame.new(0, 0.1, 0)
		band.Parent = model
		local bw = Instance.new("WeldConstraint")
		bw.Part0 = arm
		bw.Part1 = band
		bw.Parent = band
	end
	dressUp(model, member)
	-- 급류 2차: 클라이언트 RideCrew 가 노 젓기·몸 기울이기를 C0 로 그린다 — 원래 C0 를 속성으로 남긴다 (서버 포즈 트윈 중에 재면 틀어진다)
	for _, d in ipairs(model:GetDescendants()) do
		if
			d:IsA("Motor6D")
			and (d.Name == "RightShoulder" or d.Name == "LeftShoulder" or d.Name == "Waist" or d.Name == "Root")
		then
			d:SetAttribute("BaseC0", d.C0)
		end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	hrp.Anchored = true
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		local a = Instance.new("Animator")
		a.Parent = hum
		animator = a
	end
	model.Parent = parent
	local rig: Rig = {
		memberId = member.id,
		model = model,
		humanoid = hum,
		hrp = hrp,
		animator = animator :: Animator,
		idleTrack = nil,
		sitTrack = nil,
		runTrack = nil,
	}
	local idle = Instance.new("Animation")
	idle.AnimationId = ANIM_IDS.idle
	local track = rig.animator:LoadAnimation(idle)
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Idle
	track:Play()
	rig.idleTrack = track
	return rig
end

function SquadNpcService.destroy(rig: Rig)
	rig.model:Destroy()
end

-- 서 있기 / 앉기 자세
function SquadNpcService.setSitting(rig: Rig, sitting: boolean)
	if sitting then
		if not rig.sitTrack then
			local a = Instance.new("Animation")
			a.AnimationId = ANIM_IDS.sit
			local t = rig.animator:LoadAnimation(a)
			t.Looped = true
			t.Priority = Enum.AnimationPriority.Movement
			rig.sitTrack = t
		end
		if rig.sitTrack and not rig.sitTrack.IsPlaying then
			rig.sitTrack:Play()
		end
	elseif rig.sitTrack and rig.sitTrack.IsPlaying then
		rig.sitTrack:Stop()
	end
end

-- 달리기 애니: 플레이어 캐릭터의 기본 Animate 스크립트에서 run id 를 읽는다 (BoatService.setWalking 과 같은 방식 — 존재하는 기본 R15 애니만)
local runAnim: Animation? = nil
local function findRunAnim(): Animation?
	if runAnim then
		return runAnim
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		local animate = ch and ch:FindFirstChild("Animate")
		local holder = animate and animate:FindFirstChild("run")
		local a = holder and holder:FindFirstChildOfClass("Animation")
		if a and a.AnimationId ~= "" then
			local copy = Instance.new("Animation")
			copy.AnimationId = a.AnimationId
			runAnim = copy
			return copy
		end
	end
	return nil
end

-- 달려오기/돌아가기 동안 켠다 (자리 이동은 호출하는 쪽이 standAt 으로 한 걸음씩)
function SquadNpcService.setRunning(rig: Rig, on: boolean)
	if on then
		if not rig.runTrack then
			local a = findRunAnim()
			if not a then
				return
			end
			local ok, t = pcall(function()
				return rig.animator:LoadAnimation(a)
			end)
			if not ok or not t then
				return
			end
			t.Looped = true
			t.Priority = Enum.AnimationPriority.Movement
			rig.runTrack = t
		end
		local t = rig.runTrack :: AnimationTrack
		if not t.IsPlaying then
			t:Play(0.1)
		end
	elseif rig.runTrack and rig.runTrack.IsPlaying then
		rig.runTrack:Stop(0.15)
	end
end

function SquadNpcService.playOnce(rig: Rig, name: string)
	local id = ANIM_IDS[name]
	if not id then
		return
	end
	-- 이름마다 트랙 하나를 만들어 다시 쓴다 (LoadAnimation 을 부를 때마다 트랙이 쌓여 64개 한도에 걸렸다 — Studio 전 날 봇 판)
	local cache = rig.onceTracks
	if not cache then
		cache = {}
		rig.onceTracks = cache
	end
	local t = (cache :: { [string]: AnimationTrack })[name]
	if not t then
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, loaded = pcall(function()
			return rig.animator:LoadAnimation(a)
		end)
		if not ok or not loaded then
			return
		end
		t = loaded
		t.Priority = Enum.AnimationPriority.Action;
		(cache :: { [string]: AnimationTrack })[name] = t
	end
	local track = t :: AnimationTrack
	if track.IsPlaying then
		track:Stop(0)
	end
	track:Play()
end

-- 땅 위 한 점에 세운다 (발 높이 보정)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
function SquadNpcService.standAt(rig: Rig, pos: Vector3, look: Vector3?)
	rayParams.FilterDescendantsInstances = { rig.model }
	local r = workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), rayParams)
	local gy = if r then r.Position.Y else pos.Y
	local hip = rig.humanoid.HipHeight + rig.hrp.Size.Y / 2
	local p = Vector3.new(pos.X, gy + hip, pos.Z)
	local l = look or Vector3.new(0, 0, -1)
	local flat = Vector3.new(l.X, 0, l.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	rig.hrp.Anchored = true
	rig.model:PivotTo(CFrame.lookAt(p, p + flat.Unit))
end

-- 유보트에서 뗀 뒤 리그를 다시 앵커 (서 있는 자리에 고정 — standAt 이 옮긴다)
function SquadNpcService.afterDetach(rig: Rig)
	rig.hrp.Anchored = true
end

-- 말풍선: 속성만 바꾼다 (클라이언트 SquadPresence 가 그림). 같은 글을 연속으로 보내도 토큰으로 갱신
-- 조용한 분대원 (GameConfig.Quiet): 두리·산·미르는 allowSpeech 로 열어 준 동안만 말한다 (교관은 그대로)
local SQUAD_TALKERS = { DURI = true, SAN = true, MIR = true }
local speechUntil: { [Rig]: number } = setmetatable({}, { __mode = "k" }) :: any
function SquadNpcService.allowSpeech(rig: Rig, seconds: number)
	speechUntil[rig] = math.max(speechUntil[rig] or 0, os.clock() + seconds)
end
function SquadNpcService.speechAllowed(rig: Rig): boolean
	if not GameConfig.Quiet.Enabled or not SQUAD_TALKERS[rig.memberId] then
		return true
	end
	return os.clock() <= (speechUntil[rig] or 0)
end

local bubbleToken = 0
function SquadNpcService.bubble(rig: Rig, text: string, seconds: number?)
	if not SquadNpcService.speechAllowed(rig) then
		return
	end
	bubbleToken += 1
	rig.model:SetAttribute("Bubble", text)
	rig.model:SetAttribute("BubbleToken", bubbleToken)
	rig.model:SetAttribute("BubbleSec", seconds or 2)
end

function SquadNpcService.setMood(rig: Rig, mood: string)
	rig.model:SetAttribute("Mood", mood) -- IDLE | WAIT | HAPPY | SCARED (얼굴은 아바타, 클라이언트가 아이콘으로)
end

return SquadNpcService
]]></string>
