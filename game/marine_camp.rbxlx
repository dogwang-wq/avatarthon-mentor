  <Item class="ServerScriptService" referent="6201">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <BinaryString name="AttributesSerialize"></BinaryString>
      <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
      <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
      <bool name="LoadStringEnabled">false</bool>
      <bool name="DefinesCapabilities">false</bool>
      <BinaryString name="SerializedOverrides">
      </BinaryString>
      <int64 name="SourceAssetId">-1</int64>
      <BinaryString name="Tags"></BinaryString>
      <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003b8</UniqueId>
    </Properties>
    <Item class="Script" referent="6202">
      <Properties>
        <string name="Name">Server</string>
        <BinaryString name="AttributesSerialize"></BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <bool name="Disabled">false</bool>
        <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
        <ContentId name="LinkedSource">
          <null>
          </null>
        </ContentId>
        <token name="RunContext">0</token>
        <bool name="DefinesCapabilities">false</bool>
        <string name="ScriptGuid">{D7CD1803-AD92-407E-B434-AB89555A54D1}</string>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
        <string name="Source"><![CDATA[--!strict
-- 서버 진입점 (유일한 시작 스크립트). 맵 검증 → 리모트 → 서비스 → 플레이어 생명주기 → 종료 저장.
-- 맵이 없으면 무기한 대기하지 않고 누락 경로를 출력한다 (운영 서버에서 맵을 자동 생성해 숨기지 않음).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local Services = script:WaitForChild("Services")
local SessionService = require(Services:WaitForChild("SessionService"))
local RemoteRouter = require(Services:WaitForChild("RemoteRouter"))
local WorldLoop = require(Services:WaitForChild("WorldLoop"))

print(string.format("[Camp] 한 배 타자 server boot. design v%s", GameConfig.designVersion))

-- 1. 맵 검증 (최대 10초)
local scene = SceneBindings.resolve()
local deadline = os.clock() + 10
while not scene.ok and os.clock() < deadline do
	task.wait(0.5)
	scene = SceneBindings.resolve()
end
if not scene.ok then
	warn("[Camp] 맵 누락. Studio 편집 모드에서 CampSceneBootstrap.apply() 를 실행하세요:")
	for _, m in ipairs(scene.missing) do
		warn("  - " .. m)
	end
end
SessionService.setScene(scene)
SessionService.bindSceneTouches()

-- 2. 리모트 (멱등)
local remotes = RemoteRouter.ensureRemotes()
SessionService.setRemotes(remotes)
RemoteRouter.bind(remotes)

-- 3. 명찰·팔각모, 강찬 교관 (서버에 하나) + 루프
local okUni, errUni = pcall(function()
	require(Services:WaitForChild("UniformService")).start()
end)
if not okUni then
	warn("[Camp] UniformService failed: " .. tostring(errUni))
end
local okInst, errInst = pcall(function()
	require(Services:WaitForChild("InstructorService")).start()
end)
if not okInst then
	warn("[Camp] InstructorService failed: " .. tostring(errInst))
end
WorldLoop.start()

-- 4. 플레이어
Players.PlayerAdded:Connect(function(player)
	local ok, err = pcall(SessionService.onPlayerAdded, player)
	if not ok then
		warn("[Camp] onPlayerAdded failed: " .. tostring(err))
	end
end)
Players.PlayerRemoving:Connect(function(player)
	local ok, err = pcall(SessionService.onPlayerRemoving, player)
	if not ok then
		warn("[Camp] onPlayerRemoving failed: " .. tostring(err))
	end
	RemoteRouter.clearPlayer(player.UserId)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(SessionService.onPlayerAdded, player)
end

-- 5. 종료 저장 (최선 노력)
game:BindToClose(function()
	if RunService:IsStudio() and next(SessionService.Sessions) == nil then
		return
	end
	SessionService.saveAll(true)
end)

-- 6. Studio 전용 개발 API
if RunService:IsStudio() then
	if workspace:GetAttribute("Camp_DevMute") == nil then
		workspace:SetAttribute("Camp_DevMute", true)
	end
	local ok, err = pcall(function()
		require(script:WaitForChild("Dev"):WaitForChild("DevApi")).install()
	end)
	if not ok then
		warn("[Camp] DevApi install failed: " .. tostring(err))
	else
		print("[Camp] DevApi installed at ServerStorage.CampDevApi")
	end
end
]]></string>
