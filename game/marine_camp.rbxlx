end)
leaveTile.Name = "Leave"
leaveTile.LayoutOrder = 6

-- ===================== 지금 할 일 고르기 =====================
type Goal = { icon: string, text: string, sub: string, progress: number? }
local function goalOf(snap: ProtocolTypes.StateSnapshot): Goal
	local st = snap.state
	local station = StationCatalog.forDay(math.max(snap.day, 0))
	local daySub = if station
		then string.format(G.subDay, StationCatalog.dayNo(snap.day), station.emoji, station.nameKo)
		else ""
	-- 낮에 주운 장작은 보조 줄 끝에 조용히 (주우라는 말 없음 — 1단계)
	if snap.camp and snap.camp.wood > 0 and st ~= S.NIGHT and st ~= S.LETTER and st ~= S.GRADUATE then
		daySub ..= string.format(CampScript.Campfire.goalDaySuffix, snap.camp.wood)
	end
	if st == S.CAMP then
		local nextSt = StationCatalog.forDay(StationCatalog.nextDay(snap.day))
		if snap.allowed.START_DAY and nextSt and nextSt.day == 1 then
			-- 첫 1분 (28 §7): 1일차 전 첫 목적지 = 꾸미기 마당 (걸어 들어가면 시작, 아래 출발 버튼도 같은 길)
			return { icon = G.campYard.icon, text = G.campYard.text, sub = G.campYard.sub }
		elseif snap.allowed.START_DAY and nextSt then
			return {
				icon = G.camp.icon,
				text = string.format(G.camp.text, StationCatalog.dayNo(nextSt.day), nextSt.emoji, nextSt.nameKo),
				sub = G.subBase,
			}
		end
		return { icon = G.campRest.icon, text = G.campRest.text, sub = G.subBase }
	elseif st == S.NIGHT then
		-- 모닥불 허브 (1단계): "n박 모닥불 · 🌲 장작 n · 넣기·나누기·앉기"
		local CF = CampScript.Campfire
		local camp = snap.camp
		return {
			icon = CF.goalNight.icon,
			text = string.format(CF.goalNight.text, StationCatalog.nightNo(snap.day)),
			sub = string.format(CF.goalNightSub, if camp then camp.wood else 0),
		}
	elseif st == S.BUILD then
		-- 유보트 꾸미기 (3단계): "🛠️ 유보트 꾸미기 · 짐 n/3 · 긴 노 · 출발 깃발" / 들고 있으면 "물통 들었어요 · 유보트에 E"
		local BT = CampScript.Build
		local bv = snap.build
		local sub = daySub
		if bv then
			local oar = if bv.oar == "LONG" then BT.partName.OAR_LONG else BT.partName.OAR_SHORT
			sub = string.format(BT.goalSub, #bv.cargo, GameConfig.Cargo.MaxSlots, oar)
			if bv.holding then
				sub = string.format(
					BT.goalHolding,
					(BT.partIcon[bv.holding] or "") .. " " .. (BT.partName[bv.holding] or "")
				)
			elseif bv.offers then
				for id, part in pairs(bv.offers) do
					local who = SquadCatalog.get(id)
					sub = string.format(
						BT.goalOffer,
						KoreanText.josa(if who then who.nameKo else id, "이/가") .. " " .. (BT.partName[part] or part)
					)
					break
				end
			elseif bv.idleHint then
				sub = BT.goalIdle
			end
		end
		-- 첫 1분: 폰에는 E 가 없다 — "E 받기" → "탭 받기" (화면의 받기 버튼), 패드는 Ⓧ (폰 시뮬 캡처 2026-10-21)
		local it = InputController.CurrentInputType
		if it == "TOUCH" then
			sub = (string.gsub(sub, "%f[%w]E%f[%W]", "탭"))
		elseif it == "GAMEPAD" then
			sub = KoreanText.padKeys(sub)
		end
		return { icon = BT.goal.icon, text = BT.goal.text, sub = sub }
	elseif st == S.RIDE then
		-- 탑승 (4·5단계): "🌊 급류 IBS" / "⛵ 바다 IBS" · 보조 줄 = 미르가 부르는 쪽 > 매달린 사람(E) > 내 상태 > 안내, 진행 막대
		local RT = CampScript.Ride
		local rv = snap.ride
		local kind = if rv then rv.kind else "RAPIDS"
		local head = RT.goal[kind] or RT.goal.RAPIDS
		local sub = daySub
		if rv then
			if rv.phase == "BOARD" or rv.phase == "COUNT" then
				sub = RT.goalBoard
			elseif rv.phase == "FINISH" or rv.phase == "DONE" then
				sub = RT.goalFinish
			elseif rv.meState == "WATER" then
				sub = RT.goalMeWater
			elseif rv.meState == "HANGING" then
				sub = RT.goalMeHanging
			elseif rv.cue and RT.goalCue[rv.cue] then
				sub = RT.goalCue[rv.cue]
			elseif rv.hanging and #rv.hanging > 0 then
				local who = SquadCatalog.get(rv.hanging[1])
				sub = string.format(RT.goalHanging, if who then who.nameKo else rv.hanging[1])
			else
				-- 앉아서 직접 젓기: 조작 한 줄 (W 젓기 · A/D 방향 — 입력 기기별)
				local keys = RT.goalKeys[InputController.CurrentInputType] or RT.goalKeys.KBM
				if kind == "SEA" then
					sub = if rv.moving
						then string.format(RT.goalSea, rv.riders)
						else string.format(RT.goalSeaIdle, keys, rv.riders)
				elseif rv.moving then
					sub = string.format(RT.goalRapids, keys)
				else
					sub = keys
				end
			end
		end
		-- 급류 2차: 오늘 밤 장작 주머니를 머리 줄에 (물 위에서 건지면 바로 늘어난다)
		local text = head.text
		if snap.camp and snap.camp.wood > 0 then
			text ..= string.format(RT.goalWood, snap.camp.wood)
		end
		-- 바위에 쿵 수 (못 피했을 때가 보이게 — 점수 아님)
		if rv and (rv.bumps or 0) > 0 then
			text ..= string.format(RT.goalBumps, rv.bumps or 0)
		end
		return { icon = head.icon, text = text, sub = sub, progress = if rv then rv.progress else 0 }
	elseif st == S.LETTER then
		return { icon = G.letter.icon, text = G.letter.text, sub = daySub }
	elseif st == S.GRADUATE then
		return { icon = G.graduate.icon, text = G.graduate.text, sub = daySub }
	elseif st == S.TRAINING then
		local tr = snap.training
		local stn = tr and TrainingCatalog.get(tr.stationId)
		return {
			icon = if stn then stn.emoji else G.training.icon,
			text = string.format(G.training.text, if stn then stn.nameKo else ""),
			sub = G.subBase,
		}
	elseif st == S.OBBY then
		-- 살리기 (2단계): 내가 얼었으면 판 전체가 얼음, 누가 넘어졌거나 얼었으면 보조 줄에 "🤝 두리 넘어짐 · E 일으키기"
		local rs = snap.rescue
		local RS = CampScript.Rescue
		if rs and rs.meFrozenLeft then
			return { icon = RS.goalFrozenMe.icon, text = RS.goalFrozenMe.text, sub = RS.goalFrozenMe.sub }
		end
		local sub = daySub
		local ob = snap.obby
		if rs and rs.downId then
			local who = SquadCatalog.get(rs.downId)
			sub = string.format(RS.goalDown, if who then who.nameKo else rs.downId)
		elseif rs and rs.frozenId then
			local who = SquadCatalog.get(rs.frozenId)
			sub = string.format(RS.goalFrozenNpc, if who then who.nameKo else rs.frozenId)
		elseif ob and ob.gate then
			-- 6일차 사격 문 앞 (6단계): 맞힌 수 / 필요 수 (분대원도 같이 쏜다)
			sub =
				KoreanText.keysFor(string.format(G.gate, ob.gate.hits, ob.gate.need), InputController.CurrentInputType)
		end
		-- 자유 이동 스테이지 (22 v2): "깃발 n/N · 어디"
		local fr = (G.free :: { [number]: { icon: string, text: string } })[snap.day]
		if fr and ob then
			return { icon = fr.icon, text = string.format(fr.text, ob.flags, ob.need), sub = sub }
		end
		return { icon = G.obby.icon, text = G.obby.text, sub = sub }
	elseif st == S.RIDING then
		return { icon = G.riding.icon, text = G.riding.text, sub = daySub }
	end
	return { icon = G.campRest.icon, text = G.campRest.text, sub = daySub }
end

local lastGoalText = ""
local lastRideCue: string? = nil
local ctaShown = false
local function refresh(snap: ProtocolTypes.StateSnapshot)
	local st = snap.state
	local modal = UiKit.anyModalOpen()

	-- ① 할 일: 바뀌면 판이 톡 (새 할 일이 생겼다는 것만, 계속 움직이지 않음)
	-- 가운데 창(밤·편지·일지·배치)이 열리면 판을 숨긴다: 창 제목과 같은 말이고, 키 큰 창 윗부분과 겹쳤다 (2026-10-19 편지 창)
	goal.Visible = not modal
	local g = goalOf(snap)
	goalIcon.Text = g.icon
	goalText.Text = g.text
	goalSub.Text = g.sub
	-- 지금 몸으로 할 일(오른쪽으로!·점프!)은 노랑 = 지금 볼 곳 (19 §60/30/10)
	goalSub.TextColor3 = if st == S.RIDE and snap.ride and snap.ride.cue then Palette.Yellow else Palette.Cream
	progBg.Visible = g.progress ~= nil
	if g.progress then
		-- 스냅샷(4~8Hz) 사이를 부드럽게 (급류 진행 막대가 뚝뚝 끊기지 않게, 4·5단계)
		TweenService
			:Create(progFill, TweenInfo.new(0.25, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(g.progress, 1) })
			:Play()
	end
	-- 탑승: 미르가 새로 부르면(오른쪽!·가운데로!) 판이 한 번 톡 — 글을 안 읽어도 "지금" 을 느끼게
	local cueNow = if st == S.RIDE and snap.ride then snap.ride.cue else nil
	if cueNow and cueNow ~= lastRideCue then
		UiKit.pop(goal, 0.92)
	end
	lastRideCue = cueNow
	if g.text ~= lastGoalText then
		if lastGoalText ~= "" then
			UiKit.pop(goal, 0.9)
		end
		lastGoalText = g.text
	end

	-- ② 큰 버튼 하나: 기지는 출발, 편지 뒤는 아침. 밤(모닥불)의 내일로·한 번 더·자리 바꾸기는 NightPanel 오른쪽 아래 작은 카드 (6단계 — 불을 가리지 않게)
	local startOk = (st == S.CAMP and snap.allowed.START_DAY)
		or (st == S.LETTER and snap.allowed.NEXT_DAY)
		or (st == S.BUILD and snap.allowed.BUILD_GO) -- 꾸미기 중: 바로 출발 (플레이테스트 2026-10-21)
	startBtn.Visible = startOk == true
	startBtn.Text = if st == S.BUILD
		then CampScript.Build.skipBtn
		elseif st == S.CAMP then string.format(
			CampScript.UI.startDay,
			StationCatalog.dayNo(StationCatalog.nextDay(snap.day))
		)
		else CampScript.UI.nextDay
	reenterBtn.Visible = snap.allowed.REENTER == true and not startBtn.Visible
	local showCta = not modal and (startBtn.Visible or reenterBtn.Visible)
	cta.Visible = showCta
	if showCta and not ctaShown then
		UiKit.pop(cta, 0.8) -- 할 일이 생김: 한 번 톡
	end
	ctaShown = showCta

	-- ③ 오른쪽 위
	local stats = snap.stats
	-- 첫 1분 (28 §7 · 19 §3 "첫 화면의 할 일은 하나"): 첫 입소 기지에서는 능력치 숫자·타일을 숨긴다 (첫 출발 뒤 tutorialDone)
	local firstVisit = st == S.CAMP and not snap.tutorialDone
	local restful = (st == S.CAMP or st == S.NIGHT or st == S.TRAINING or st == S.GRADUATE) and not firstVisit
	profile.Text = string.format("%d기 · 🏅 %d", snap.entryCount, #snap.badges)
		.. (
			if restful
				then string.format(
					" · 💪%d 🏃%d 💚%d 🎯%d",
					stats.strength,
					stats.speed,
					stats.stamina,
					stats.aim or 0
				)
				else ""
		)
	loadoutTile.Visible = snap.allowed.LOADOUT == true
	journalTile.Visible = st == S.CAMP or st == S.NIGHT or st == S.LETTER or st == S.GRADUATE
	boardTile.Visible = st == S.CAMP or st == S.NIGHT or st == S.GRADUATE
	coopTile.Visible = snap.allowed.COOP == true and snap.coop == nil
	returnTile.Visible = snap.allowed.RETURN_CAMP == true
	leaveTile.Visible = snap.coop ~= nil
	local anyTile = loadoutTile.Visible
		or journalTile.Visible
		or boardTile.Visible
		or coopTile.Visible
		or returnTile.Visible
		or leaveTile.Visible
	tiles.Visible = not modal and anyTile and not firstVisit
end

function CampHud.start()
	RunService.RenderStepped:Connect(tickTimer)
	Net.SnapshotChanged:Connect(refresh)
	if Net.Snapshot then
		refresh(Net.Snapshot)
	end
	UiKit.ModalChanged:Connect(function()
		if Net.Snapshot then
			refresh(Net.Snapshot)
		end
	end)
	InputController.JournalPressed:Connect(function()
		if journalTile.Visible then
			CampHud.OpenJournal:Fire()
		end
	end)
	Net.ActionResult:Connect(function(res)
		if not res.accepted and res.code ~= ProtocolTypes.ErrorCode.RATE_LIMITED then
			UiKit.toast(Net.errorText(res.code))
		end
	end)
	Net.StoryCue:Connect(function(c)
		if c.kind == "BADGE" then
			UiKit.toast("🏅 배지! " .. tostring(c.text), 3, true)
		end
	end)
end

return CampHud
