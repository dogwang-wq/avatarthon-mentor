            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 1일차 급류 수로 + 4일차 바다 경로 (27 §3 1-B·4일차, 28 §3 4단계): CampSceneBootstrap 이 스펙을 다 만든 뒤 호출한다.
-- specs(): 수로 스펙(id 접두 R1_, 4일차 R4_) / terrain(): 수로 파기·물 채우기 (FillBlock·FillCylinder·FillWedge 만, Clear 없음)
-- 자리: 옛 1일차 코스(x 0) **동쪽** x 28~140 · z −74~−262. 지시된 서쪽(x −30~−140)은 5일차(안 번호 6) 탈출 길
-- (−130,−200)→(−50,−120)→(0,−84)·통나무 길·표적 문이 가로질러 수로를 팔 수 없었다 (2026-10-21, 28 §7 인계).
-- 물 두 층: 윗물 y −1 (출발·바위 2·가지 1) → 폭포 턱(3 stud, 6 stud 동안) → 아랫물 y −4 협곡(바위 4·가지 1·U 턴) → 해변 모래에 밀려 올라 멈춤.
-- 경로점: 보이지 않는 파트 Kind="RIDE" Day Index (y = 수면). 장애물: Kind="RIDE" RideType ROCK(Side)|BRANCH|FALLS|WAVE(Side)|FINISH.
-- RideService 가 경로점으로 Catmull-Rom 스플라인을 만들고 장애물 위치를 스플라인에 투영한다 (여기선 꺾은선 거리로 놓는다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Palette = require(Shared:WaitForChild("Palette"))
-- 에셋 1차: 장식 헬퍼(바위·소나무·작은 나무·덤불·갈대·들풀)가 앵커/대체 속성을 단다 (CampAssets.dress 가 메시를 입힘). 경로점·장애물 트리거는 그대로
local CampAssets = require(
	game:GetService("ServerScriptService")
		:WaitForChild("Server")
		:WaitForChild("Editor")
		:WaitForChild("CampAssets")
		:Clone()
)

local CampRideCourse = {}

export type Spec = {
	id: string,
	folder: string,
	class: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	attrs: { [string]: any }?,
	shape: Enum.PartType?,
	light: { color: Color3, range: number, brightness: number }?,
	onPath: boolean?,
	clear: string?,
	group: string?,
}

-- ===== 수치 (전부 CANDIDATE) =====
local WIDTH = 12 -- 수로 폭
local HALF = WIDTH / 2
local UPPER_Y = -1 -- 윗물 수면
local LOWER_Y = -4 -- 아랫물 수면 (협곡)
local FALLS_S = 124 -- 폭포 턱 시작 (꺾은선 거리)
local FALLS_LEN = 6 -- 턱 길이 (이 동안 3 stud 내려간다)

-- 수로 중심선 (x, z). 윗물 → 동쪽으로 굽음 → 폭포 → U 턴(협곡) → 북서로 해변
