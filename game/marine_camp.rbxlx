            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 유보트 꾸미기·싣기 (27 §3 1-A · 28 §1·§2, 2026-10-21 3단계) — 가설 1(배치)의 주 무대, Build a Boat 의 "집어서 붙이기" 틀.
-- 연병장 동쪽 마당: 거치대 위 내 유보트, 둘레 부품 더미(PILE: 긴 노·짧은 노·물통·깃발·구급상자·간식·스티커 셋)·자리 발판(SEATPAD)·출발 깃발(PILE GO).
--   더미에서 E "집기" → 손에 든다(오른손 소품 + 캐릭터 속성 CampHolding). 하나만 — 다른 걸 집으면 든 것은 조용히 제자리로.
--   유보트에서 E "싣기/붙이기/노 바꾸기" → session.loadout(짐 3칸·노)·스티커. 빈손이면 "빼기" — 마지막에 실은 짐을 내린다(되돌리기).
--   자리 발판에서 E "내 자리" → 그 자리가 내 자리, 거기 있던 분대원은 내 옛 자리로(SessionService 의 SEAT 경로 그대로 — 검증·저장 같이).
--   출발 깃발 E "출발!" → 오늘 배치 기록·BUILD 뱃지(하나라도 바꿨으면)·일지 한 줄 → cbs.depart() (SessionService 가 급류 RIDE 로 잇는다).
-- 분대원 셋은 각자 바라는 것을 더미에서 집어 와 내민다(가설 2): 두리 구급상자 · 산 물통 · 미르 깃발. 받으면 실리고, 안 받거나(멀어짐·20초)
--   꽉 찼으면 "응, 다음에" 하고 제자리에 둔다 — 서운해하지 않는다. 다 하면 제 자리 발판에 가서 선다(자리가 눈에 보이게).
-- 막지 않는다: 아무것도 안 해도 기본 배로 출발. 60초 가만히 있으면 두리 "출발할까?" + 출발 깃발 빛남, 120초면 교관 "출발!" 하고 간다.
-- 세션 상태 기계는 SessionService 것 — 여기는 start·tick·stop·view 와 동사(pick·attach·seat·accept·go)로만 붙는다(순환 require 없음).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local Palette = require(Shared:WaitForChild("Palette"))
local SquadNpcService = require(script.Parent.SquadNpcService)
local AssetLibrary = require(script.Parent.AssetLibrary) -- 마감 패스: 손 소품 메시 (없으면 기본 파트)
local BoatService = require(script.Parent.BoatService)
local TelemetryService = require(script.Parent.TelemetryService)

local BoatBuildService = {}

local B = GameConfig.Build
local T = CampScript.Build
local S = ProtocolTypes.SessionState

type Line = CampScript.Line
type Rig = SquadNpcService.Rig
type Member = {
	id: string,
	def: SquadCatalog.Member,
	rig: Rig?,
	friendUserId: number?,
	morale: number,
	waiting: boolean,
}
-- SessionService.Session 중 여기서 읽는 것만
export type SessionLike = {
	userId: number,
	player: Player,
	day: number,
	state: string,
	loadout: ProtocolTypes.Loadout,
	members: { [string]: Member },
	boat: BoatService.BoatHandle,
	lastAttempt: ProtocolTypes.Loadout?,
	handle: {
		profile: {
			progress: {
				loadoutByDay: { [string]: ProtocolTypes.Loadout },
				lastEntryLoadout: ProtocolTypes.Loadout?,
				stickers: { string },
			},
		},
	},
}
-- SessionService 가 주는 손
export type Hooks = {
	lines: (session: any, list: { Line }) -> (),
	fx: (session: any, kind: string, extra: { [string]: any }?) -> (),
	bubble: (session: any, memberId: string, text: string, sec: number?) -> (),
	addBadge: (session: any, id: string) -> (),
	addSticker: (session: any, id: string) -> (),
	addJournal: (session: any, day: number, text: string) -> (),
	markDirty: (session: any) -> (),
	-- 배치 바꾸기 (SessionService.handleLoadout 과 같은 길: 검증·저장·외형). ErrorCode 를 돌려준다 ("OK" 면 됨)
	changeLoadout: (session: any, op: string, args: { [string]: any }) -> string,
}
-- 출발할 때 SessionService 가 이어 갈 것 (급류 RideService.start — beginDay1Ride)
export type Callbacks = { depart: () -> () }

type Offer = {
	memberId: string,
	part: string,
	line: string,
	phase: string, -- WAIT | FETCH | OFFER | RETURN | DONE
	at: number, -- WAIT: 가지러 가는 때 / OFFER: 내밀기 시작한 때
	prompt: ProximityPrompt?,
	prop: Model?,
}

type Build = {
	session: SessionLike,
	cbs: Callbacks,
	startAt: number,
	lastActAt: number,
	idleSaid: boolean,
	idleHint: boolean,
	departed: boolean,
	changed: boolean,
	holding: string?,
	heldProp: Model?,
	added: { string }, -- 이번에 실은 짐 순서 (빼기 = 마지막 것부터)
	rackCF: CFrame,
	prompts: { [string]: ProximityPrompt }, -- 더미 id / "BOAT" / "GO" / "PAD_FL" …
	conns: { RBXScriptConnection },
	offers: { [string]: Offer },
	moving: { [string]: number }, -- 달리는 분대원 → 이동 토큰
	ghost: Instance?,
	stickersAdded: number,
	pickedSelf: boolean, -- 더미에서 직접 집어 봤나 (첫 1분: 그러면 hintPick 안 함)
	hintSaid: boolean,
}

local scene: SceneBindings.Scene? = nil
local hooks: Hooks? = nil
local builds: { [number]: Build } = {}
local glideToken = 0

local OFFER_ORDER = { "DURI", "SAN", "MIR" }
-- 내밀 때 내 앞에서 비켜 서는 각 (+ = 오른쪽). 첫 1분: 카메라가 보는 쪽 앞에, 셋이 겹치지 않게
local OFFER_DEG = { DURI = 32, SAN = -32, MIR = 64 } :: { [string]: number }
local STICKER_OF =
	{ STICKER_A = "BUILD_STAR", STICKER_B = "BUILD_WAVE", STICKER_C = "BUILD_WHALE" } :: { [string]: string }
local CARGO_OF = { WATER = "WATER", FLAG = "FLAG", AID = "AID", SNACK = "SNACK" } :: { [string]: string }

-- ===== 공통 =====
local function H(): Hooks
	return hooks :: Hooks
end

function BoatBuildService.setScene(sc: SceneBindings.Scene)
	scene = sc
end

function BoatBuildService.setHooks(h: Hooks)
	hooks = h
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function npcOf(session: SessionLike, memberId: string): (Member?, Rig?)
	local m = session.members[memberId]
	if m and m.rig and not m.friendUserId then
		return m, m.rig
	end
	return nil, nil
end

local function myHrp(session: SessionLike): BasePart?
	local ch = session.player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	return if hrp and hrp:IsA("BasePart") then hrp else nil
end

local function partName(pt: string): string
	return T.partName[pt] or pt
end

local function isOar(pt: string): boolean
	return pt == "OAR_LONG" or pt == "OAR_SHORT"
end

local function oarOf(pt: string): string
	return if pt == "OAR_LONG" then "LONG" else "SHORT"
end

local function pileOf(pt: string): SceneBindings.Pile?
	local sc = scene
	if not sc then
		return nil
	end
	for _, p in ipairs(sc.piles) do
		if p.partType == pt then
			return p
		end
	end
	return nil
end

-- 더미 앞(아이가 서는 쪽)에 선 자리
local function pileFront(p: SceneBindings.Pile): Vector3
	return p.part.Position + flat(p.part.CFrame.LookVector) * 1.9
end

-- 자리 발판 위 (분대원이 서는 곳)
local function padSpot(b: Build, key: string): (Vector3, Vector3)
	local sc = scene
	local pad = sc and sc.seatPads[key]
	local center = b.rackCF.Position
	if pad then
		local p = pad.part.Position
		return p, flat(center - p)
	end
	local sx = if SquadCatalog.isLeft(key) then -1 else 1
	local dz = if SquadCatalog.isFront(key) then -1.5 else 4.0
	local p = (b.rackCF * CFrame.new(sx * 5.8, 0, dz)).Position
	return p, flat(center - p)
end

local function newPrompt(action: string, object: string, dist: number, icon: string?, userId: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = B.PromptHold
	p.MaxActivationDistance = dist
	p.RequiresLineOfSight = false
	p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	if GameConfig.Campfire.PromptCustom then
		p.Style = Enum.ProximityPromptStyle.Custom -- PromptController 가 그린다 (28 §4)
	end
	p:SetAttribute("ForUserId", userId) -- 더미는 세상 공유라 사람마다 프롬프트 하나 (남의 것은 PromptController 가 숨긴다)
	if icon then
		p:SetAttribute("PromptIcon", icon)
	end
	return p
end

-- 캐릭터가 잠깐 몸을 낮췄다가 편다 (집기·싣기 손맛)
local function bend(character: Model?, sec: number)
	if not character then
		return
	end
	BoatService.pose(character, "READY2")
	task.delay(sec, function()
		if character.Parent then
			BoatService.pose(character, "NONE")
		end
	end)
end

-- 클라이언트 소유 캐릭터를 서버에서 옮기면 되돌아올 수 있다 → 잠깐 서버 소유로 옮긴 뒤 돌려준다 (DevApi.teleport 와 같은 요령)
local function teleport(ch: Model, cf: CFrame)
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	local player = Players:GetPlayerFromCharacter(ch)
	if hrp and hrp:IsA("BasePart") and player then
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
		hrp.AssemblyLinearVelocity = Vector3.zero
		ch:PivotTo(cf)
		task.delay(0.4, function()
			if hrp.Parent and player.Parent then
				pcall(function()
					hrp:SetNetworkOwner(player)
				end)
			end
		end)
	else
		ch:PivotTo(cf)
	end
end

-- ===== 손에 드는 소품 (부품마다 작은 모델, 오른손에 붙인다) =====
type PropPart = { name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType? }
local function propLook(pt: string): { PropPart }
	if pt == "OAR_LONG" or pt == "OAR_SHORT" then
		local long = pt == "OAR_LONG"
		local len = if long then 5.2 else 3.6
		local blade = if long then Vector3.new(0.12, 1.9, 1.05) else Vector3.new(0.12, 1.3, 0.8)
		local mid = if long then 0.7 else 0.5
		return {
			{
				name = "Shaft",
				size = Vector3.new(0.2, len, 0.2),
				cf = CFrame.new(0, mid, 0),
				color = Palette.Wood,
				mat = Enum.Material.Wood,
			},
			{
				name = "Blade",
				size = blade,
				cf = CFrame.new(0, mid + len / 2 - blade.Y / 2 + 0.1, 0),
				color = Palette.Ink,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Grip",
				size = Vector3.new(0.27, 0.45, 0.27),
				cf = CFrame.new(0, 0, 0),
				color = if long then Palette.Yellow else Palette.Cream,
				mat = Enum.Material.Fabric,
			},
		}
	elseif pt == "WATER" then
		return {
			{
				name = "Can",
				size = Vector3.new(0.55, 0.95, 0.75),
				cf = CFrame.new(0, -0.75, 0),
				color = Palette.OliveDark,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Cap",
				size = Vector3.new(0.22, 0.16, 0.22),
				cf = CFrame.new(0, -0.2, 0.22),
				color = Palette.Ink,
				mat = Enum.Material.SmoothPlastic,
			},
		}
	elseif pt == "AID" then
		return {
			{
				name = "Box",
				size = Vector3.new(0.85, 0.6, 0.7),
				cf = CFrame.new(0, -0.65, 0),
				color = Palette.Cream,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Band",
				size = Vector3.new(0.89, 0.16, 0.74),
				cf = CFrame.new(0, -0.62, 0),
				color = Palette.Olive,
				mat = Enum.Material.Fabric,
			},
		}
	elseif pt == "SNACK" then
		return {
			{
				name = "Crate",
				size = Vector3.new(0.8, 0.45, 0.65),
				cf = CFrame.new(0, -0.6, 0),
				color = Palette.Wood,
				mat = Enum.Material.WoodPlanks,
			},
			{
				name = "Ball",
				size = Vector3.new(0.42, 0.4, 0.42),
				cf = CFrame.new(0, -0.25, 0),
				color = Palette.Cream,
				mat = Enum.Material.SmoothPlastic,
				shape = Enum.PartType.Ball,
			},
		}
	elseif pt == "FLAG" then
		return {
			{
				name = "Pole",
				size = Vector3.new(0.1, 3.0, 0.1),
				cf = CFrame.new(0, 0.9, 0),
				color = Palette.WoodDark,
				mat = Enum.Material.Wood,
			},
			{
				name = "Cloth",
				size = Vector3.new(1.2, 0.7, 0.05),
				cf = CFrame.new(0.62, 2.0, 0),
				color = Palette.Red,
				mat = Enum.Material.Fabric,
			},
		}
	end
	-- 스티커: 둥근 판 (이모지는 StickerEmoji 속성 → 클라이언트)
	local color = if pt == "STICKER_A"
		then Palette.Yellow
		elseif pt == "STICKER_B" then Palette.SeaFoam
		else Color3.fromHex("9ED0E8")
	return {
		{
			name = "Disk",
			size = Vector3.new(0.1, 1.0, 1.0),
			cf = CFrame.new(0, -0.6, 0) * CFrame.Angles(0, math.rad(90), 0),
			color = color,
			mat = Enum.Material.SmoothPlastic,
			shape = Enum.PartType.Cylinder,
		},
	}
end

-- 손 소품 메시 (마감 패스 2026-10-21): 손 기준 상자 가운데 CFrame·모델 축 상자 크기. nil 이면 기본 파트 모양만
-- 노: 모델 +X(날) → 손 +Y(위로), 날 너비(모델 Y) → 손 X. 물통·구급상자·간식 상자는 손 아래에 매단다
local HELD_MESH = {
	OAR_LONG = {
		key = "OarLong",
		cf = CFrame.new(0, 0.9, 0) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(1, 0, 0)),
		size = Vector3.new(5.6, 1.1, 0.24),
	},
	OAR_SHORT = {
		key = "OarLong",
		cf = CFrame.new(0, 0.6, 0) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(1, 0, 0)),
		size = Vector3.new(3.9, 0.85, 0.22),
	},
	WATER = { key = "Jerrycan", cf = CFrame.new(0, -0.8, 0), size = Vector3.new(0.64, 1.0, 0.6) },
	AID = { key = "FirstAidBox", cf = CFrame.new(0, -0.7, 0), size = Vector3.new(0.9, 0.8, 0.6) },
	SNACK = { key = "Crate", cf = CFrame.new(0, -0.65, 0), size = Vector3.new(0.8, 0.5, 0.65) },
} :: { [string]: { key: string, cf: CFrame, size: Vector3 } }

local function weldTo(hand: BasePart, p: BasePart)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = p
	w.Parent = p
end

local function attachProp(character: Model, pt: string): Model?
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "CampHeld"
	model:SetAttribute("PartType", pt)
	local hm = HELD_MESH[pt]
	local meshed = false
	if hm then
		local m = AssetLibrary.cloneFit(hm.key, hand.CFrame * hm.cf, hm.size)
		if m then
			for _, p in ipairs(AssetLibrary.parts(m)) do
				p.CastShadow = true
				weldTo(hand, p)
				p.Parent = model
				meshed = true
			end
			m:Destroy()
		end
	end
	for _, v in ipairs(propLook(pt)) do
		-- 메시가 있으면 간식 주먹밥만 얹고 나머지 기본 파트는 뺀다
		if meshed and not (pt == "SNACK" and v.name == "Ball") then
			continue
		end
		local p = Instance.new("Part")
		p.Name = v.name
		p.Size = v.size
		p.Color = v.color
		p.Material = v.mat
		if v.shape then
			p.Shape = v.shape
		end
		p.CastShadow = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = hand.CFrame * v.cf
		if v.name == "Disk" then
			local sticker = CampScript.Stickers[STICKER_OF[pt] or ""]
			p:SetAttribute("StickerEmoji", if sticker then sticker.emoji else "⭐")
		end
		weldTo(hand, p)
		p.Parent = model
	end
	model.Parent = character
	return model
end

local function dropProp(prop: Model?)
	if prop and prop.Parent then
		prop:Destroy()
	end
end

-- ===== 분대원 달리기 (RescueService.glide 와 같은 요령: Heartbeat 마다 standAt 보간 + run 애니) =====
local function glide(b: Build, rig: Rig, to: Vector3, look: Vector3?, onDone: (() -> ())?)
	glideToken += 1
	local tok = glideToken
	b.moving[rig.memberId] = tok
	local from = rig.hrp.Position
	local dir = flat(to - from)
	local dist = dir.Magnitude
	local sec = math.clamp(dist / B.NpcRunSpeed, 0.3, B.NpcRunMaxSec)
	local moveLook = if dist > 0.3 then dir.Unit else (look or Vector3.new(0, 0, -1))
	if dist > 1 then
		SquadNpcService.setRunning(rig, true)
	end
	task.spawn(function()
		local t0 = os.clock()
		while rig.model.Parent and b.moving[rig.memberId] == tok do
			local a = math.clamp((os.clock() - t0) / sec, 0, 1)
			SquadNpcService.standAt(rig, from:Lerp(to, a), moveLook)
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if b.moving[rig.memberId] ~= tok then
			return -- 다른 이동이 가로챘다
		end
		b.moving[rig.memberId] = nil
		SquadNpcService.setRunning(rig, false)
		if rig.model.Parent then
			SquadNpcService.standAt(rig, to, look or moveLook)
		end
		if onDone then
			onDone()
		end
	end)
end

-- 이 분대원이 지금 내밀기 일을 하는 중인가 (자리로 보내면 안 되는 사람)
local function offerBusy(b: Build, memberId: string): boolean
	local o = b.offers[memberId]
	return o ~= nil and (o.phase == "FETCH" or o.phase == "OFFER" or o.phase == "RETURN")
end

-- 분대원을 제 자리 발판으로 (내밀기 중인 사람은 빼고)
local function sendToPad(b: Build, memberId: string)
	local _, rig = npcOf(b.session, memberId)
	if not rig or offerBusy(b, memberId) or b.departed then
		return
	end
	local key = BoatLoadout.seatOf(b.session.loadout, memberId)
	if not key then
		return
	end
	local pos, look = padSpot(b, key)
	if flat(rig.hrp.Position - pos).Magnitude < 0.6 then
		SquadNpcService.standAt(rig, pos, look)
		return
	end
	glide(b, rig, pos, look)
end

local function sendAllToPads(b: Build)
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		sendToPad(b, id) -- 내밀기 중(가지러·내밀기·되돌리기)인 사람은 sendToPad 가 건너뛴다
	end
end

-- ===== 프롬프트 =====
local function boatAction(b: Build): (string?, string?)
	local held = b.holding
	local lo = b.session.loadout
	if held then
		if isOar(held) then
			return if oarOf(held) == lo.oar then T.promptLoad else T.promptOar, partName(held)
		elseif STICKER_OF[held] then
			return T.promptStick, partName(held)
		end
		return T.promptLoad, partName(held)
	end
	local last = lo.cargo[#lo.cargo]
	if last then
		local c = BoatLoadout.Cargo[last]
		return T.promptUnload, if c then c.nameKo else last
	end
	return nil, nil
end

local function refreshPrompts(b: Build)
	if b.departed then
		return
	end
	local held = b.holding
	local mySeat = BoatLoadout.seatOf(b.session.loadout, "ME")
	for id, p in pairs(b.prompts) do
		if id == "BOAT" then
			local action, object = boatAction(b)
			p.Enabled = action ~= nil
			p.ActionText = action or T.promptLoad
			p.ObjectText = T.promptBoat .. (if object then " · " .. object else "")
			p:SetAttribute("PromptIcon", if held then T.partIcon[held] else "🛶")
			p:SetAttribute("PromptAccent", if held then "YELLOW" else nil)
		elseif id == "GO" then
			p.Enabled = held == nil
			p:SetAttribute("PromptAccent", if b.idleHint then "YELLOW" else nil)
		elseif string.sub(id, 1, 4) == "PAD_" then
			local key = string.sub(id, 5)
			p.Enabled = held == nil and key ~= mySeat
		else
			local pt = tostring(p:GetAttribute("PartType") or "")
			p.Enabled = pt ~= held
			p.ActionText = if held then T.promptSwap else T.promptPick
		end
	end
end

local function touched(b: Build)
	b.lastActAt = os.clock()
	if b.idleHint then
		b.idleHint = false
	end
	b.idleSaid = false
	H().markDirty(b.session)
end

local function setHolding(b: Build, pt: string?)
	dropProp(b.heldProp)
	b.heldProp = nil
	b.holding = pt
	local ch = b.session.player.Character
	if ch then
		ch:SetAttribute("CampHolding", pt)
		if pt then
			b.heldProp = attachProp(ch, pt)
		end
	end
end

-- ===== 동사 =====
-- 더미에서 집기. 다른 걸 들고 있으면 조용히 제자리에 두고 바꿔 든다
function BoatBuildService.pick(session: SessionLike, pt: string): boolean
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD or pt == "GO" or pt == "RACK" then
		return false
	end
	if not (isOar(pt) or CARGO_OF[pt] or STICKER_OF[pt]) then
		return false
	end
	if b.holding == pt then
		return true
	end
	b.pickedSelf = true
	setHolding(b, pt)
	bend(session.player.Character, 0.3)
	local pile = pileOf(pt)
	H().fx(session, "PICK", { pos = if pile then pile.part.Position else nil, part = pt })
	TelemetryService.log("build_pick", { part = pt })
	touched(b)
	refreshPrompts(b)
	return true
end

-- 부품 하나를 유보트에 (손에 든 것이든 분대원이 내민 것이든). "OK" | "FULL" | "ALREADY" | "SAME" | "BAD"
local function applyPart(b: Build, pt: string, by: string): string
	local session = b.session
	local lo = session.loadout
	local root = session.boat.root
	if isOar(pt) then
		local oar = oarOf(pt)
		if lo.oar == oar then
			return "SAME"
		end
		if H().changeLoadout(session, "OAR", { oar = oar }) ~= "OK" then
			return "BAD"
		end
		H().fx(session, "ATTACH", { pos = root.Position + Vector3.new(0, 1.6, 0), part = pt, by = by })
	elseif STICKER_OF[pt] then
		local id = STICKER_OF[pt]
		if table.find(session.handle.profile.progress.stickers, id) then
			return "ALREADY"
		end
		H().addSticker(session, id)
		b.stickersAdded += 1
		local slot = session.boat.stickerSlots[#session.handle.profile.progress.stickers]
		H().fx(
			session,
			"ATTACH",
			{ pos = if slot then slot.WorldPosition else root.Position, part = pt, by = by, sticker = true }
		)
	else
		local cargo = CARGO_OF[pt]
		if not cargo then
			return "BAD"
		end
		if table.find(lo.cargo, cargo) then
			return "ALREADY"
		end
		if #lo.cargo >= GameConfig.Cargo.MaxSlots then
			return "FULL"
		end
		if H().changeLoadout(session, "CARGO_ADD", { cargoId = cargo }) ~= "OK" then
			return "BAD"
		end
		table.insert(b.added, cargo)
		local pos: Vector3
		if cargo == "FLAG" then
			pos = (root.CFrame * CFrame.new(0, 3.2, -5.5)).Position
		else
			local n = 0
			for _, c in ipairs(session.loadout.cargo) do
				if c ~= "FLAG" then
					n += 1
				end
			end
			pos = BoatService.cargoSlotWorld(session.boat, n)
		end
		H().fx(session, "ATTACH", { pos = pos, part = pt, by = by })
	end
	b.changed = true
	-- 분대원 반응 (수치 없이 한마디)
	local react = T.react[if STICKER_OF[pt] then "STICKER" else pt]
	if react and by == "ME" then
		local _, rig = npcOf(session, react.who)
		if rig then
			H().bubble(session, react.who, react.text, 2)
		end
	end
	TelemetryService.log("build_attach", { part = pt, by = by })
	return "OK"
end

-- 유보트에 E: 든 것을 싣는다/붙인다. 빈손이면 마지막에 실은 짐을 뺀다
function BoatBuildService.attach(session: SessionLike): boolean
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD then
		return false
	end
	local held = b.holding
	if not held then
		-- 빼기: 이번에 실은 것 중 마지막(아직 실려 있는 것), 없으면 짐 칸의 마지막
		local lo = session.loadout
		local target: string? = nil
		for i = #b.added, 1, -1 do
			if table.find(lo.cargo, b.added[i]) then
				target = b.added[i]
				table.remove(b.added, i)
				break
			end
		end
		target = target or lo.cargo[#lo.cargo]
		if not target then
			return false
		end
		if H().changeLoadout(session, "CARGO_REMOVE", { cargoId = target }) ~= "OK" then
			return false
		end
		b.changed = true
		H().bubble(session, "DURI", T.unload, 1.6)
		H().fx(session, "PICK", { pos = session.boat.root.Position + Vector3.new(0, 1.5, 0), part = target })
		TelemetryService.log("build_unload", { cargo = target })
		touched(b)
		refreshPrompts(b)
		return true
	end
	local res = applyPart(b, held, "ME")
	if res == "FULL" then
		H().bubble(session, "SAN", T.full, 2)
	elseif res == "ALREADY" then
		if STICKER_OF[held] then
			H().bubble(session, "MIR", T.stickerAgain, 2)
		else
			H().bubble(session, "DURI", T.already, 2)
		end
	end
	-- 실었든 못 실었든 손은 빈다 (못 실은 것은 조용히 제자리로 — 막히지 않게)
	setHolding(b, nil)
	bend(session.player.Character, 0.3)
	touched(b)
	refreshPrompts(b)
	return res == "OK" or res == "SAME"
end

-- 자리 발판에 E: 그 자리가 내 자리 (거기 있던 분대원은 내 옛 자리로 달려간다)
function BoatBuildService.seat(session: SessionLike, key: string): boolean
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD or not SquadCatalog.isSeat(key) then
		return false
	end
	local before = session.loadout.seats[key]
	if before == "ME" then
		return true
	end
	if H().changeLoadout(session, "SEAT", { seatKey = key, memberId = "ME" }) ~= "OK" then
		return false
	end
	b.changed = true
	local pos = padSpot(b, key)
	H().fx(session, "PICK", { pos = pos + Vector3.new(0, 1, 0), part = "SEAT" })
	if before then
		local line = T.seatMove[before]
		if line then
			H().bubble(session, before, line, 1.8)
		end
		sendToPad(b, before)
	end
	TelemetryService.log("build_seat", { key = key })
	touched(b)
	refreshPrompts(b)
	return true
end

-- ===== 분대원이 내민다 (가설 2) =====
local function offerCleanup(b: Build, o: Offer)
	if o.prompt then
		o.prompt:Destroy()
		o.prompt = nil
	end
	local _, rig = npcOf(b.session, o.memberId)
	if rig and rig.model:GetAttribute("Mood") == "OFFER" then
		SquadNpcService.setMood(rig, "IDLE")
	end
end

-- 되돌려 놓기: 더미로 달려가 내려놓고 제 자리 발판으로
local function offerReturn(b: Build, o: Offer)
	offerCleanup(b, o)
	o.phase = "RETURN"
	local _, rig = npcOf(b.session, o.memberId)
	local pile = pileOf(o.part)
	if not rig or not pile then
		dropProp(o.prop)
		o.prop = nil
		o.phase = "DONE"
		sendToPad(b, o.memberId)
		return
	end
	glide(b, rig, pileFront(pile), flat(pile.part.Position - pileFront(pile)), function()
		BoatService.pose(rig.model, "READY2")
		task.delay(0.35, function()
			dropProp(o.prop)
			o.prop = nil
			if rig.model.Parent then
				BoatService.pose(rig.model, "NONE")
			end
			o.phase = "DONE"
			sendToPad(b, o.memberId)
		end)
	end)
	H().markDirty(b.session)
end

function BoatBuildService.accept(session: SessionLike, memberId: string): boolean
	local b = builds[session.userId]
	local o = b and b.offers[memberId]
	if not b or not o or b.departed or o.phase ~= "OFFER" then
		return false
	end
	local res = applyPart(b, o.part, memberId)
	if res ~= "OK" then
		-- 꽉 찼거나 이미 있다: "응, 다음에" — 서운해하지 않고 제자리에
		H().bubble(session, memberId, T.later, 1.8)
		offerReturn(b, o)
		touched(b)
		refreshPrompts(b)
		return false
	end
	offerCleanup(b, o)
	dropProp(o.prop)
	o.prop = nil
	o.phase = "DONE"
	H().bubble(session, memberId, T.offerThanks[memberId] or T.later, 1.8)
	local _, rig = npcOf(session, memberId)
	if rig then
		H().fx(session, "GIVE", { pos = rig.hrp.Position })
		SquadNpcService.playOnce(rig, "cheer")
	end
	task.delay(0.6, function()
		sendToPad(b, memberId)
	end)
	touched(b)
	refreshPrompts(b)
	return true
end

-- 무엇을 내밀까: 제 것이 이미 실려 있으면 다른 것, 그것도 있으면 안 내민다
-- 이 부품을 아직 실을 수 있나 (짐이면 안 실렸고, 스티커면 안 붙었다)
local function partFree(b: Build, pt: string): boolean
	if CARGO_OF[pt] then
		return not table.find(b.session.loadout.cargo, CARGO_OF[pt])
	elseif STICKER_OF[pt] then
		return not table.find(b.session.handle.profile.progress.stickers, STICKER_OF[pt])
	end
	return false
end

local function chooseOffer(b: Build, memberId: string): (string?, string?)
	for _, opt in ipairs({ T.offer[memberId], T.offerAlt[memberId] }) do
		if opt and partFree(b, opt.part) and pileOf(opt.part) then
			return opt.part, opt.line
		end
	end
	return nil, nil
end

local function offerSpot(b: Build, rig: Rig): (Vector3?, Vector3?)
	local hrp = myHrp(b.session)
	if not hrp then
		return nil, nil
	end
	local me = hrp.Position
	-- 첫 1분: 내가 보는 쪽(카메라가 보는 쪽) 앞, 분대원이 온 쪽으로 30° 비켜 선다.
	-- 예전엔 분대원이 온 쪽 그대로라 뒤에서 오면 카메라와 나 사이에 서서 화면을 가렸다 (Studio 2026-10-21 첫 1분 캡처)
	local fwd = flat(hrp.CFrame.LookVector)
	fwd = if fwd.Magnitude > 0.1 then fwd.Unit else Vector3.new(0, 0, -1)
	local right = fwd:Cross(Vector3.yAxis)
	-- 사람마다 자리 각을 달리한다 (둘이 같이 내밀면 한 자리에 겹쳐 서로 머리 위에 섰다 — Studio 2026-10-21)
	local deg = OFFER_DEG[rig.memberId] or 30
	local dir = (fwd * math.cos(math.rad(deg)) + right * math.sin(math.rad(deg))).Unit
	return me + dir * B.OfferStandStuds, -dir
end

local function beginOffer(b: Build, o: Offer)
	local session = b.session
	local _, rig = npcOf(session, o.memberId)
	local m = session.members[o.memberId]
	if not rig or not m then
		o.phase = "DONE"
		return
	end
	-- 마지막 확인: 그사이 아이가 먼저 실었으면 조용히 제자리로
	local part, line = chooseOffer(b, o.memberId)
	if part ~= o.part then
		if part and line then
			o.part, o.line = part, line
		else
			offerReturn(b, o)
			return
		end
	end
	o.phase = "OFFER"
	o.at = os.clock()
	SquadNpcService.setMood(rig, "OFFER")
	H().bubble(session, o.memberId, o.line, 3.5)
	H().fx(session, "OFFER", { pos = rig.hrp.Position + Vector3.new(0, 2.6, 0), who = o.memberId })
	local prompt = newPrompt(
		T.promptTake,
		string.format(T.offerWhat, m.def.nameKo .. "의", partName(o.part)),
		B.OfferDistance,
		"🎁",
		session.userId
	)
	prompt.Name = "CampBuildOffer"
	prompt:SetAttribute("PromptAccent", "YELLOW")
	prompt:SetAttribute("PromptOffset", Vector3.new(0, 2.4, 0))
	prompt.Parent = rig.hrp
	o.prompt = prompt
	local memberId = o.memberId
	table.insert(
		b.conns,
		prompt.Triggered:Connect(function(player: Player)
			if player == session.player then
				BoatBuildService.accept(session, memberId)
			end
		end)
	)
	H().markDirty(session)
end

local function fetchOffer(b: Build, o: Offer)
	local session = b.session
	local _, rig = npcOf(session, o.memberId)
	local pile = pileOf(o.part)
	if not rig or not pile then
		o.phase = "DONE"
		return
	end
	o.phase = "FETCH"
	local front = pileFront(pile)
	glide(b, rig, front, flat(pile.part.Position - front), function()
		if b.departed then
			return
		end
		BoatService.pose(rig.model, "READY2")
		task.delay(0.45, function()
			if b.departed or not rig.model.Parent then
				return
			end
			BoatService.pose(rig.model, "NONE")
			o.prop = attachProp(rig.model, o.part)
			H().fx(session, "PICK", { pos = pile.part.Position, part = o.part, by = o.memberId })
			local spot, look = offerSpot(b, rig)
			if not spot then
				offerReturn(b, o)
				return
			end
			glide(b, rig, spot, look, function()
				if not b.departed and o.phase == "FETCH" then
					beginOffer(b, o)
				end
			end)
		end)
	end)
end

local function tickOffers(b: Build, now: number)
	local hrp = myHrp(b.session)
	for _, id in ipairs(OFFER_ORDER) do
		local o = b.offers[id]
		if not o then
			continue
		end
		if o.phase == "WAIT" and now >= o.at then
			fetchOffer(b, o)
		elseif o.phase == "OFFER" then
			local _, rig = npcOf(b.session, id)
			local far = hrp ~= nil
				and rig ~= nil
				and flat(hrp.Position - rig.hrp.Position).Magnitude > B.OfferLeaveStuds
			if not partFree(b, o.part) then
				-- 그사이 아이가 같은 것을 먼저 실었다: 말없이 제자리로
				offerReturn(b, o)
				refreshPrompts(b)
			elseif far or now - o.at > B.OfferWaitSec then
				-- 안 받았다: "응, 다음에" (서운해하지 않는다)
				H().bubble(b.session, id, T.later, 1.8)
				offerReturn(b, o)
				refreshPrompts(b)
			elseif rig and hrp and not b.moving[id] then
				-- 나를 본다
				local d = flat(hrp.Position - rig.hrp.Position)
				if d.Magnitude > 0.5 then
					local cur = flat(rig.hrp.CFrame.LookVector)
					if (cur - d.Unit).Magnitude > 0.35 then
						SquadNpcService.standAt(rig, rig.hrp.Position, d)
					end
				end
			end
		end
	end
end

-- ===== 지난번 배치 판 (두 번째 입소 · 한 번 더) =====
local function ghostText(lo: ProtocolTypes.Loadout): string
	local oar = BoatLoadout.Oars[lo.oar]
	local emojis = {}
	for _, c in ipairs(lo.cargo) do
		local cg = BoatLoadout.Cargo[c]
		if cg then
			table.insert(emojis, cg.emoji)
		end
	end
	local seat = BoatLoadout.seatOf(lo, "ME")
	return string.format(
		T.ghost,
		if oar then oar.nameKo else lo.oar,
		if #emojis > 0 then table.concat(emojis, "") else T.ghostNone,
		if seat then (T.seatName[seat] or seat) else "-"
	)
end

local function makeGhost(b: Build, lo: ProtocolTypes.Loadout)
	local folder = Instance.new("Model")
	folder.Name = "BuildGhost_" .. b.session.userId
	folder:SetAttribute("ProjectId", SceneBindings.ProjectId)
	folder:SetAttribute("ForUserId", b.session.userId)
	local base = b.rackCF * CFrame.new(-10.5, 0, 11.5)
	local function mk(name: string, size: Vector3, cf: CFrame, color: Color3, alpha: number): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Transparency = alpha
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		return p
	end
	for i, sx in ipairs({ -1, 1 }) do
		mk("Post" .. i, Vector3.new(0.25, 3.8, 0.25), base * CFrame.new(sx * 3.7, 1.9, 0), Palette.WoodDark, 0.3).Parent =
			folder
	end
	-- 반투명 크림 판 (보이는 쪽 = 남쪽, 아이가 마당으로 들어오는 쪽)
	local board = mk(
		"Board",
		Vector3.new(7.4, 2.3, 0.12),
		CFrame.lookAt((base * CFrame.new(0, 2.9, 0)).Position, (base * CFrame.new(0, 2.9, 1)).Position),
		Palette.Cream,
		0.35
	)
	board:SetAttribute("SignText", T.ghostTitle)
	board:SetAttribute("SignSub", ghostText(lo))
	board:SetAttribute("SignBothSides", true)
	board.Parent = folder
	folder.Parent = SceneBindings.ensureRuntimeFolder()
	b.ghost = folder
end

-- ===== 시작·끝 =====
local function rackCFrame(): CFrame
	local sc = scene
	local rack = sc and sc.buildRack
	if rack then
		local p = rack.Position
		local look = flat(rack.CFrame.LookVector)
		return CFrame.lookAt(p, p + (if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)))
	end
	return CFrame.lookAt(B.RackPos + Vector3.new(0, 2, 0), B.RackPos + Vector3.new(0, 2, -1))
end
-- 첫 1분 (WelcomeService·SessionService.placeAtCamp): 1일차 전 기지에서도 유보트를 거치대에 둔다
BoatBuildService.rackCFrame = rackCFrame

local function cleanup(b: Build)
	for _, c in ipairs(b.conns) do
		c:Disconnect()
	end
	table.clear(b.conns)
	for _, p in pairs(b.prompts) do
		p:Destroy()
	end
	table.clear(b.prompts)
	for _, o in pairs(b.offers) do
		offerCleanup(b, o)
		dropProp(o.prop)
		o.prop = nil
		o.phase = "DONE"
	end
	for id in pairs(b.moving) do
		b.moving[id] = nil
		local _, rig = npcOf(b.session, id)
		if rig then
			SquadNpcService.setRunning(rig, false)
		end
	end
	dropProp(b.heldProp)
	b.heldProp = nil
	b.holding = nil
	local ch = b.session.player.Character
	if ch then
		ch:SetAttribute("CampHolding", nil)
	end
	if b.ghost then
		b.ghost:Destroy()
		b.ghost = nil
	end
end

-- 1일차 시작(SessionService.startDay): 유보트를 거치대에, 나를 마당 입구에, 분대원은 내 옆에. 상태 BUILD 는 SessionService 가 정한다
function BoatBuildService.start(session: SessionLike, cbs: Callbacks)
	local old = builds[session.userId]
	if old then
		old.departed = true
		cleanup(old)
	end
	local sc = scene
	local rackCF = rackCFrame()
	local b: Build = {
		session = session,
		cbs = cbs,
		startAt = os.clock(),
		lastActAt = os.clock(),
		idleSaid = false,
		idleHint = false,
		departed = false,
		changed = false,
		holding = nil,
		heldProp = nil,
		added = {},
		rackCF = rackCF,
		prompts = {},
		conns = {},
		offers = {},
		moving = {},
		ghost = nil,
		stickersAdded = 0,
		pickedSelf = false,
		hintSaid = false,
	}
	builds[session.userId] = b
	-- 유보트: 거치대 위 (PARK — BoatService.place 가 거치대 용골 받침을 땅으로 읽는다)
	local boat = session.boat
	BoatService.detachAll(boat)
	BoatService.setMode(boat, "PARK")
	BoatService.place(boat, rackCF.Position + Vector3.new(0, 1, 0), rackCF.LookVector)
	BoatService.applyLoadoutVisual(boat, session.loadout)
	-- 나: 마당 입구(유보트 꼬리 쪽 12.5)에서 유보트를 본다
	local entry = (rackCF * CFrame.new(0, 0, 12.5)).Position
	local ch = session.player.Character
	if ch then
		BoatService.detach(boat, ch)
		-- 첫 1분: 노란 화살표를 따라 걸어 들어온 아이는 그 자리 그대로 (순간이동하면 걸어온 길이 끊긴다). 버튼으로 오면 입구로
		local hrp = ch:FindFirstChild("HumanoidRootPart")
		local near = hrp ~= nil and hrp:IsA("BasePart") and flat(hrp.Position - entry).Magnitude <= B.EntryKeepStuds
		if not near then
			local spot = CFrame.lookAt(
				Vector3.new(entry.X, entry.Y + 2, entry.Z),
				Vector3.new(rackCF.Position.X, entry.Y + 2, rackCF.Position.Z)
			)
			teleport(ch, spot)
		end
		ch:SetAttribute("CampHolding", nil)
	end
	-- 분대원: 내 양옆에 섰다가 하나씩 더미로
	for i, id in ipairs(SquadCatalog.NpcOrder) do
		local _, rig = npcOf(session, id)
		if rig then
			SquadNpcService.afterDetach(rig)
			SquadNpcService.setSitting(rig, false)
			SquadNpcService.setMood(rig, "IDLE")
			BoatService.pose(rig.model, "NONE")
			local p = (rackCF * CFrame.new((i - 2) * 3.2, 0, 10.2 - math.abs(i - 2) * 0.8)).Position
			SquadNpcService.standAt(rig, p, flat(rackCF.Position - p))
			local part, line = nil, nil
			if GameConfig.Quiet.BuildOffers or not GameConfig.Quiet.Enabled then
				part, line = chooseOffer(b, id)
			end
			if part and line then
				local idx = table.find(OFFER_ORDER, id) or i
				b.offers[id] = {
					memberId = id,
					part = part,
					line = line,
					phase = "WAIT",
					at = os.clock() + B.OfferStartSec + (idx - 1) * B.OfferGapSec,
					prompt = nil,
					prop = nil,
				}
			end
		end
	end
	-- 프롬프트: 더미마다 · 출발 깃발 · 자리 발판 · 유보트
	local uid = session.userId
	local function bindPrompt(key: string, p: ProximityPrompt, fn: () -> ())
		b.prompts[key] = p
		table.insert(
			b.conns,
			p.Triggered:Connect(function(player: Player)
				if player.UserId == uid and builds[uid] == b and not b.departed then
					fn()
				end
			end)
		)
	end
	if sc then
		for _, pile in ipairs(sc.piles) do
			local pt = pile.partType
			if pt == "GO" then
				local p = newPrompt(T.promptGo, T.promptGoWhat, B.GoDistance, "🚩", uid)
				p.HoldDuration = B.GoHold
				p.Name = "CampBuildGo"
				p.Parent = pile.part
				bindPrompt("GO", p, function()
					BoatBuildService.go(session, false)
				end)
			elseif isOar(pt) or CARGO_OF[pt] or STICKER_OF[pt] then
				local p = newPrompt(T.promptPick, partName(pt), B.PileDistance, T.partIcon[pt], uid)
				p.Name = "CampBuildPick"
				p:SetAttribute("PartType", pt)
				p.Parent = pile.part
				bindPrompt(pile.id, p, function()
					BoatBuildService.pick(session, pt)
				end)
			end
		end
		for key, pad in pairs(sc.seatPads) do
			local p = newPrompt(T.promptSeat, T.seatName[key] or key, B.SeatPadDistance, "🪑", uid)
			p.Name = "CampBuildSeat"
			p:SetAttribute("PromptOffset", Vector3.new(0, 0.4, 0))
			-- 거리는 프롬프트 부모 위치에서 잰다: 발판(땅 높이)에 달면 옆 더미(허리 높이)가 이긴다 → 허리 높이 Attachment 에 단다
			local at = pad.part:FindFirstChild("CampBuildSeatAt") :: Attachment?
			if not at then
				local a = Instance.new("Attachment")
				a.Name = "CampBuildSeatAt"
				a.Position = Vector3.new(0, 2.8, 0)
				a.Parent = pad.part
				at = a
			end
			p.Parent = at
			bindPrompt("PAD_" .. key, p, function()
				BoatBuildService.seat(session, key)
			end)
		end
	end
	local bp = newPrompt(T.promptLoad, T.promptBoat, B.BoatDistance, "🛶", uid)
	bp.Name = "CampBuildBoat"
	bp:SetAttribute("PromptOffset", Vector3.new(0, 3.2, 0))
	bp.Parent = boat.root
	bindPrompt("BOAT", bp, function()
		BoatBuildService.attach(session)
	end)
	-- 지난번 배치 (한 번 더면 직전 판, 두 번째 입소면 지난 입소의 마지막 배치)
	local prev = session.lastAttempt or session.handle.profile.progress.lastEntryLoadout
	if prev then
		makeGhost(b, prev)
	end
	refreshPrompts(b)
	H().lines(session, T.start)
	-- 1초 뒤 분대원은 제 자리 발판으로 달려간다 (누가 어디 앉는지가 먼저 보이게) — 차례가 되면 거기서 더미로
	task.delay(1.0, function()
		if builds[session.userId] == b and not b.departed then
			sendAllToPads(b)
		end
	end)
	TelemetryService.log("build_start", { ghost = prev ~= nil })
	H().markDirty(session)
end

-- 출발: 오늘 배치를 남기고 뱃지·일지 → 이어 가기(cbs.depart). auto = 교관이 시간 돼서 출발시킴
function BoatBuildService.go(session: SessionLike, auto: boolean): boolean
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD then
		return false
	end
	b.departed = true
	local p = session.handle.profile.progress
	p.loadoutByDay[tostring(session.day)] = BoatLoadout.clone(session.loadout)
	if b.changed then
		H().addBadge(session, "BUILD")
	end
	local lo = session.loadout
	local oar = BoatLoadout.Oars[lo.oar]
	local emojis = {}
	for _, c in ipairs(lo.cargo) do
		local cg = BoatLoadout.Cargo[c]
		if cg then
			table.insert(emojis, cg.emoji)
		end
	end
	local seat = BoatLoadout.seatOf(lo, "ME")
	H().addJournal(
		session,
		session.day,
		string.format(
			T.journal,
			if oar then oar.nameKo else lo.oar,
			if #emojis > 0 then table.concat(emojis, "") else T.ghostNone,
			if seat then (T.seatName[seat] or seat) else "-"
		)
	)
	H().lines(session, { if auto then T.autoGo elseif b.changed then T.go else T.goPlain })
	local gopile = pileOf("GO")
	H().fx(session, "PICK", { pos = if gopile then gopile.part.Position + Vector3.new(0, 4, 0) else nil, part = "GO" })
	TelemetryService.log("build_go", {
		auto = auto,
		changed = b.changed,
		cargo = table.concat(lo.cargo, ","),
		oar = lo.oar,
		seat = seat,
		sec = math.floor(os.clock() - b.startAt),
	})
	cleanup(b)
	H().markDirty(session)
	b.cbs.depart()
	return true
end

-- 바로 출발 (플레이테스트 2026-10-21 "꾸미기 의미없는 듯, 스킵"): 짐이 비어 있으면 분대원이 제 짐(두리 구급상자·산 물통·미르 깃발)을 싣고 떠난다.
-- 꾸민 것은 그대로 둔다. 뱃지 BUILD 는 아이가 직접 바꾼 게 있을 때만 (go 가 판단)
function BoatBuildService.skip(session: SessionLike): boolean
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD then
		return false
	end
	local changedBefore = b.changed
	if #session.loadout.cargo == 0 then
		local packed = false
		for _, memberId in ipairs({ "DURI", "SAN", "MIR" }) do
			local opt = T.offer[memberId]
			if opt and CARGO_OF[opt.part] and partFree(b, opt.part) then
				if applyPart(b, opt.part, memberId) == "OK" then
					packed = true
				end
			end
		end
		b.changed = changedBefore -- 분대원이 실은 것은 아이의 꾸미기로 세지 않는다
		if packed then
			H().lines(session, { T.skipPacked })
		end
	end
	return BoatBuildService.go(session, false)
end
-- 상태가 BUILD 를 떠날 때(SessionService.setState) · 나갈 때: 프롬프트·소품·판 정리 (출발하지 않고 떠나도 남지 않게)
function BoatBuildService.stop(session: SessionLike)
	local b = builds[session.userId]
	if not b then
		return
	end
	b.departed = true
	cleanup(b)
	builds[session.userId] = nil
end

function BoatBuildService.onPlayerRemoving(session: SessionLike)
	BoatBuildService.stop(session)
end

function BoatBuildService.tick(session: SessionLike, _dt: number)
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD then
		return
	end
	local now = os.clock()
	-- 리셋·리스폰으로 손의 소품이 사라졌으면 빈손으로
	if b.holding and (not b.heldProp or not b.heldProp:IsDescendantOf(workspace)) then
		b.heldProp = nil
		b.holding = nil
		refreshPrompts(b)
		H().markDirty(session)
	end
	tickOffers(b, now)
	-- 첫 1분: 더미에서 직접 집는 법은 두리 내밀기가 끝난 뒤 한 줄 (그 전에 집어 봤으면 말하지 않는다 — 할 일이 둘로 겹치지 않게)
	if not b.hintSaid and not b.pickedSelf then
		local duri = b.offers.DURI
		local duriDone = duri == nil or duri.phase == "DONE" or duri.phase == "RETURN"
		local offering = false -- 누가 내미는 중이면 기다린다 ("E 받기" 와 "더미에서 집어" 가 한 화면에 겹쳤다)
		for _, o in pairs(b.offers) do
			if o.phase == "OFFER" then
				offering = true
			end
		end
		if not offering and ((duriDone and now - b.startAt >= 3) or now - b.startAt >= B.HintPickAfterSec) then
			b.hintSaid = true
			H().lines(session, { T.hintPick })
		end
	elseif b.pickedSelf then
		b.hintSaid = true
	end
	local idle = now - b.lastActAt
	if idle >= B.IdleHintSec and not b.idleSaid then
		b.idleSaid = true
		b.idleHint = true
		H().bubble(session, "DURI", T.idle, 2.5)
		refreshPrompts(b)
		H().markDirty(session)
	end
	if idle >= B.AutoDepartSec then
		BoatBuildService.go(session, true)
	end
end

function BoatBuildService.view(session: SessionLike): ProtocolTypes.BuildView?
	local b = builds[session.userId]
	if not b or b.departed or session.state ~= S.BUILD then
		return nil
	end
	local offers: { [string]: string } = {}
	local any = false
	for id, o in pairs(b.offers) do
		if o.phase == "OFFER" then
			offers[id] = o.part
			any = true
		end
	end
	return {
		holding = b.holding,
		cargo = table.clone(session.loadout.cargo),
		oar = session.loadout.oar,
		mySeat = BoatLoadout.seatOf(session.loadout, "ME") or "FL",
		offers = if any then offers else nil,
		idleHint = b.idleHint,
		changed = b.changed,
	}
end

-- ===== 검증 (DevApi "build") =====
function BoatBuildService.debug(session: SessionLike): { [string]: any }
	local b = builds[session.userId]
	if not b then
		return { active = false, state = session.state }
	end
	local offers = {}
	for _, id in ipairs(OFFER_ORDER) do
		local o = b.offers[id]
		if o then
			table.insert(offers, string.format("%s:%s:%s", id, o.part, o.phase))
		end
	end
	local prompts = {}
	for k, p in pairs(b.prompts) do
		if p.Enabled then
			table.insert(prompts, k .. "=" .. p.ActionText)
		end
	end
	table.sort(prompts)
	local hrp = myHrp(session)
	return {
		active = not b.departed,
		state = session.state,
		holding = b.holding,
		heldProp = b.heldProp ~= nil and b.heldProp.Parent ~= nil,
		cargo = table.concat(session.loadout.cargo, ","),
		oar = session.loadout.oar,
		seats = string.format(
			"FL=%s FR=%s BL=%s BR=%s",
			session.loadout.seats.FL,
			session.loadout.seats.FR,
			session.loadout.seats.BL,
			session.loadout.seats.BR
		),
		changed = b.changed,
		idle = os.clock() - b.lastActAt,
		idleHint = b.idleHint,
		offers = table.concat(offers, " "),
		prompts = table.concat(prompts, " | "),
		ghost = b.ghost ~= nil,
		me = if hrp then hrp.Position else nil,
		boat = session.boat.root.Position,
		stickers = table.concat(session.handle.profile.progress.stickers, ","),
	}
end

-- 부품 더미 / 자리 발판 / 분대원의 월드 자리 (DevApi 순간이동·진짜 E 시험)
function BoatBuildService.spotOf(session: SessionLike, what: string): Vector3?
	local b = builds[session.userId]
	if what == "BOAT" then
		return session.boat.root.Position
	end
	if SquadCatalog.isSeat(what) and b then
		return (padSpot(b, what))
	end
	local _, rig = npcOf(session, what)
	if rig then
		return rig.hrp.Position
	end
	local pile = pileOf(what)
	return if pile then pileFront(pile) else nil
end

return BoatBuildService
]]></string>
