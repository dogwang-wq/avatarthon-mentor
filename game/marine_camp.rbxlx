            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 살리기 (27 §3 · 28 §1·§2, 2026-10-21 2단계).
-- 넘어짐(2·6일차 유격): 분대가 앞서 달려가다 하나가 넘어진다(두리 > 미르 > 산). 나와 다음 깃발 사이 길가에 누워 있고 머리 위 🤝.
--   옆에서 E(일으키기, 0.8초)면 일어나며 한마디. 안 가면 10초 뒤 스스로 일어나 뒤따라간다 — 원망 없음 (규칙 ①).
-- 얼음(5일차 탐조등): 빛 안에서 움직이면 뒤로 밀리는 대신 제자리 얼음(❄️). 가까운 분대원이 달려와 "땡!"(약 2.5초), 친구(coop)도 E 로 풀어 준다,
--   아무도 없어도 5초면 풀린다. 분대원도 빛에 걸려 언다(미르 > 두리 > 산) → 내가 E(풀어 주기, 0.5초). 역시 5초면 스스로.
-- 밤: 오늘 내가 일으켜/풀어 준 사람은 모닥불 옆에 앉으면 한 줄 더 (thanksTonight — CampfireService.sit 이 묻는다).
-- 막지 않는다: 깃발·도착·문은 누가 누워 있든 그대로 된다. 점수·벌 없음. 세션 상태 기계는 SessionService 것 — 여기는 훅으로만 붙는다.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local SquadNpcService = require(script.Parent.SquadNpcService)
local TelemetryService = require(script.Parent.TelemetryService)

local RescueService = {}

local R = GameConfig.Rescue
local T = CampScript.Rescue
local S = ProtocolTypes.SessionState

type Line = CampScript.Line
type Rig = SquadNpcService.Rig
-- SessionService.Session 중 여기서 읽는 것만 (순환 require 를 피한다)
type Member = {
	id: string,
	def: SquadCatalog.Member,
	rig: Rig?,
	friendUserId: number?,
	morale: number,
	waiting: boolean,
}
type ObbyLike = {
	flags: { [string]: boolean },
	flagsDone: number,
	flagsNeed: number,
	respawn: Vector3?,
}
export type SessionLike = {
	userId: number,
	player: Player,
	day: number,
	state: string,
	members: { [string]: Member },
	rec: { revives: number?, autoUps: number?, thaws: number? },
	rel: { helped: { [string]: number }, helpedMe: { [string]: number } },
	obby: ObbyLike?,
}
export type Hooks = {
	lines: (session: any, list: { Line }) -> (),
	fx: (session: any, kind: string, extra: { [string]: any }?) -> (),
	bubble: (session: any, memberId: string, text: string, sec: number?) -> (),
	markDirty: (session: any) -> (),
}

type Down = {
	id: string,
	rig: Rig,
	prompt: ProximityPrompt,
	at: number,
	autoAt: number,
	pos: Vector3, -- 누운 자리(땅)
	yaw: number,
}
type NpcFrozen = {
	id: string,
	rig: Rig,
	prompt: ProximityPrompt,
	at: number,
	autoAt: number,
}
type MeFrozen = {
	char: Model,
	hum: Humanoid,
	walk: number,
	jumpPower: number,
	jumpHeight: number,
	at: number,
	untilAt: number,
	prompt: ProximityPrompt?,
	helperId: string?, -- 달려오는 분대원
	helperReturn: CFrame?, -- 그 사람이 돌아갈 자리
	helperSaid: boolean,
	zoneId: string,
}
type Rescue = {
	day: number,
	startAt: number,
	fallsLeft: number,
	nextFallAt: number,
	down: Down?,
	npcFrozen: NpcFrozen?,
	me: MeFrozen?,
	lastThawAt: number,
	zonesUsed: { [string]: boolean }, -- 분대원이 걸린 탐조등 (하루 한 번씩)
	helpedToday: { [string]: number }, -- 오늘 내가 살린 사람 → 밤 한 줄
	helpedHow: { [string]: string }, -- REVIVE | THAW (마지막)
	thankedTonight: { [string]: boolean },
	thanksIdx: { [string]: number },
	hintSaid: boolean,
	moving: { [string]: number }, -- 달려오는/돌아가는 중인 분대원 → 이동 토큰 (busy)
	rng: Random,
}

local scene: SceneBindings.Scene? = nil
local hooks: Hooks? = nil
local rescues: { [number]: Rescue } = {}
local glideToken = 0

-- ===== 공통 =====
local function H(): Hooks
	return hooks :: Hooks
end

function RescueService.setScene(sc: SceneBindings.Scene)
	scene = sc
end

function RescueService.setHooks(h: Hooks)
	hooks = h
end

local function ensure(session: SessionLike): Rescue
	local r = rescues[session.userId]
	if not r then
		r = {
			day = session.day,
			startAt = os.clock(),
			fallsLeft = 0,
			nextFallAt = math.huge,
			down = nil,
			npcFrozen = nil,
			me = nil,
			lastThawAt = 0,
			zonesUsed = {},
			helpedToday = {},
			helpedHow = {},
			thankedTonight = {},
			thanksIdx = {},
			hintSaid = false,
			moving = {},
			rng = Random.new(),
		}
		rescues[session.userId] = r
	end
	return r
end

local function npcOf(session: SessionLike, memberId: string): (Member?, Rig?)
	local m = session.members[memberId]
	if m and m.rig and not m.friendUserId then
		return m, m.rig
	end
	return nil, nil
end

local function nameOf(session: SessionLike, memberId: string): string
	local m = session.members[memberId]
	return if m then m.def.nameKo else memberId
end

local function myPos(session: SessionLike): Vector3?
	local ch = session.player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	return if hrp and hrp:IsA("BasePart") then hrp.Position else nil
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- 지금 이 사람을 다른 코드(freeSquadAhead·발판·응원·줍기)가 옮기면 안 되나
function RescueService.busy(session: SessionLike, memberId: string): boolean
	local r = rescues[session.userId]
	if not r then
		return false
	end
	if r.down and r.down.id == memberId then
		return true
	end
	if r.npcFrozen and r.npcFrozen.id == memberId then
		return true
	end
	if r.me and r.me.helperId == memberId then
		return true
	end
	return r.moving[memberId] ~= nil
end

local function newPrompt(action: string, object: string, dist: number, hold: number, icon: string): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = hold
	p.MaxActivationDistance = dist
	p.RequiresLineOfSight = false
	p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	if GameConfig.Campfire.PromptCustom then
		p.Style = Enum.ProximityPromptStyle.Custom -- PromptController 가 그린다 (28 §4)
	end
	p:SetAttribute("PromptIcon", icon)
	p:SetAttribute("PromptAccent", "YELLOW")
	return p
end

-- 돌아가며 고르는 한마디
local function pick(r: Rescue, pool: { string }?, key: string): string
	if not pool or #pool == 0 then
		return "…"
	end
	local i = (r.thanksIdx[key] or 0) % #pool + 1
	r.thanksIdx[key] = i
	return pool[i]
end

local function weighted(r: Rescue, weights: { [string]: number }, allowed: { string }): string?
	local total = 0
	for _, id in ipairs(allowed) do
		total += weights[id] or 0
	end
	if total <= 0 then
		return allowed[1]
	end
	local x = r.rng:NextNumber() * total
	for _, id in ipairs(allowed) do
		x -= weights[id] or 0
		if x <= 0 then
			return id
		end
	end
	return allowed[#allowed]
end

-- 분대가 서 있는 목표 (freeSquadAhead 와 같은 규칙): 안 밟은 깃발 중 첫 것, 다 밟았으면 오늘 도착점
local function squadTarget(session: SessionLike): Vector3?
	local sc = scene
	local o = session.obby
	if not sc or not o then
		return nil
	end
	if o.flagsDone < o.flagsNeed then
		for _, fl in ipairs(sc.flagsByDay[session.day] or {}) do
			if not o.flags[fl.id] then
				return fl.part.Position
			end
		end
	end
	local cp = sc.cps[StationCatalog.idForDay(session.day)]
	return if cp then cp.part.Position else nil
end

-- 그 사람의 대형 자리 (freeSquadAhead 와 같은 줄: 목표 앞 5, 옆으로 2.5 간격)
local function squadSpot(session: SessionLike, memberId: string): (Vector3?, Vector3?)
	local target = squadTarget(session)
	local from = myPos(session)
	if not target or not from then
		return nil, nil
	end
	local toward = flat(from - target)
	local look = if toward.Magnitude > 0.5 then toward.Unit else Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local i = table.find(SquadCatalog.NpcOrder, memberId) or 2
	return target + look * 5 + right * ((i - 2) * 2.5), look
end

-- 서 있는 피벗 (SquadNpcService.standAt 과 같은 계산)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = false

local function groundOf(pos: Vector3, exclude: { Instance }): RaycastResult?
	rayParams.FilterDescendantsInstances = exclude
	return workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), rayParams)
end

local function standCFrame(rig: Rig, pos: Vector3, look: Vector3): CFrame
	local r = groundOf(pos, { rig.model })
	local gy = if r then r.Position.Y else pos.Y
	local hip = rig.humanoid.HipHeight + rig.hrp.Size.Y / 2
	local p = Vector3.new(pos.X, gy + hip, pos.Z)
	local l = flat(look)
	if l.Magnitude < 0.01 then
		l = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(p, p + l.Unit)
end

-- 피벗을 부드럽게 (리그는 앵커라 트윈 대신 Heartbeat 로 보간). 끝나면 onDone
local function tweenPivot(rig: Rig, to: CFrame, sec: number, onDone: (() -> ())?)
	local from = rig.model:GetPivot()
	task.spawn(function()
		local t0 = os.clock()
		while rig.model.Parent do
			local a = math.clamp((os.clock() - t0) / math.max(sec, 0.05), 0, 1)
			-- Back-out 느낌 (일어날 때 살짝 튕김)
			local e = 1 - (1 - a) * (1 - a)
			rig.model:PivotTo(from:Lerp(to, e))
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if onDone then
			onDone()
		end
	end)
end

-- 달려가기: 땅을 따라 한 걸음씩(standAt) + run 애니. 끝에 look 쪽을 본다. 같은 사람에게 새 이동이 오면 앞 것은 멈춘다
local function glide(r: Rescue, rig: Rig, to: Vector3, look: Vector3?, sec: number, onDone: (() -> ())?)
	glideToken += 1
	local tok = glideToken
	r.moving[rig.memberId] = tok
	local from = rig.hrp.Position
	local dir = flat(to - from)
	local moveLook = if dir.Magnitude > 0.3 then dir.Unit else (look or Vector3.new(0, 0, -1))
	SquadNpcService.setRunning(rig, true)
	task.spawn(function()
		local t0 = os.clock()
		while rig.model.Parent and r.moving[rig.memberId] == tok do
			local a = math.clamp((os.clock() - t0) / math.max(sec, 0.05), 0, 1)
			local p = from:Lerp(to, a)
			SquadNpcService.standAt(rig, p, moveLook)
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if r.moving[rig.memberId] ~= tok then
			return -- 다른 이동이 가로챘다
		end
		r.moving[rig.memberId] = nil
		SquadNpcService.setRunning(rig, false)
		if rig.model.Parent then
			SquadNpcService.standAt(rig, to, look or moveLook)
		end
		if onDone then
			onDone()
		end
	end)
end

local function runSec(dist: number): number
	return math.clamp(dist / R.NpcRunSpeed, 0.4, R.NpcRunMaxSec)
end

-- 제 대형 자리로 달려간다
local function runBackToSquad(session: SessionLike, r: Rescue, rig: Rig)
	local spot, look = squadSpot(session, rig.memberId)
	if not spot then
		return
	end
	local d = flat(spot - rig.hrp.Position).Magnitude
	if d < 1.5 then
		SquadNpcService.standAt(rig, spot, look)
		return
	end
	glide(r, rig, spot, look, runSec(d))
end

local function countHelp(session: SessionLike, r: Rescue, memberId: string, how: string)
	session.rel.helped[memberId] = (session.rel.helped[memberId] or 0) + 1
	r.helpedToday[memberId] = (r.helpedToday[memberId] or 0) + 1
	r.helpedHow[memberId] = how
	local m = session.members[memberId]
	if m then
		m.morale = math.min(1, m.morale + 0.1)
	end
end

-- ===== 넘어짐 =====
local function insideFlat(part: BasePart, pos: Vector3, yPad: number): boolean
	local rel = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size / 2
	return math.abs(rel.X) <= h.X and math.abs(rel.Z) <= h.Z and rel.Y >= -h.Y - yPad and rel.Y <= h.Y + yPad
end

-- 누울 자리: 나 → 목표 직선의 40~60%, 옆으로 3. 땅에 붙이고 물·추락 영역·탐조등은 피한다. 못 찾으면 nil (이번엔 안 넘어짐)
local function fallSpot(session: SessionLike, r: Rescue, from: Vector3, target: Vector3): Vector3?
	local sc = scene
	if not sc then
		return nil
	end
	local line = flat(target - from)
	if line.Magnitude < R.FallMinFromMe + 4 then
		return nil
	end
	local dir = line.Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local exclude: { Instance } = {}
	local ch = session.player.Character
	if ch then
		table.insert(exclude, ch)
	end
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local _, rig = npcOf(session, id)
		if rig then
			table.insert(exclude, rig.model)
		end
	end
	local side = if r.rng:NextNumber() < 0.5 then 1 else -1
	local floor = math.min(from.Y, target.Y) - 6 -- 양끝보다 한참 아래(구덩이·물가)는 안 됨
	local topY = math.max(from.Y, target.Y)
	for attempt = 1, 6 do
		local t = R.FallAlong[1] + r.rng:NextNumber() * (R.FallAlong[2] - R.FallAlong[1])
		local s = if attempt % 2 == 0 then -side else side
		-- 깃발이 멀면(100 stud 넘게) 비율 자리는 안 보인다 → 내 앞 FallMinFromMe+2 ~ FallMaxFromMe 안에서
		local along = math.clamp(line.Magnitude * t, R.FallMinFromMe + 2, R.FallMaxFromMe)
		local base = from + dir * along + right * (R.FallSide * s)
		local hit = groundOf(Vector3.new(base.X, topY, base.Z), exclude)
		if hit and hit.Material ~= Enum.Material.Water and hit.Position.Y >= floor then
			local ok = flat(hit.Position - from).Magnitude >= R.FallMinFromMe
			if ok then
				for _, fp in ipairs(sc.falls) do
					if insideFlat(fp, hit.Position, 3) then
						ok = false
						break
					end
				end
			end
			if ok then
				for _, z in ipairs(sc.zonesByDay[session.day] or {}) do
					if z.zoneType == "SEARCH" and insideFlat(z.part, hit.Position, 6) then
						ok = false
						break
					end
				end
			end
			if ok then
				return hit.Position
			end
		end
	end
	return nil
end

-- 누운 피벗: 발은 달리던 쪽, 등을 대고 머리가 살짝 들린 채 (LieAngle 80 — 90 이면 완전히 눕는다)
local function lieCFrame(ground: Vector3, yaw: number): CFrame
	local base = CFrame.new(ground + Vector3.new(0, R.LieHeight, 0)) * CFrame.Angles(0, yaw, 0)
	return base * CFrame.Angles(math.rad(R.LieAngle), 0, 0)
end

local function standUp(session: SessionLike, r: Rescue, d: Down, byMe: boolean)
	if r.down ~= d then
		return
	end
	r.down = nil
	d.prompt:Destroy()
	local rig = d.rig
	local me = myPos(session)
	local look = if me then flat(me - d.pos) else Vector3.new(0, 0, -1)
	if look.Magnitude < 0.5 then
		look = Vector3.new(0, 0, -1)
	end
	SquadNpcService.setMood(rig, if byMe then "HAPPY" else "IDLE")
	tweenPivot(rig, standCFrame(rig, d.pos, look), 0.4, function()
		if not rig.model.Parent then
			return
		end
		SquadNpcService.standAt(rig, d.pos, look)
		if byMe then
			SquadNpcService.playOnce(rig, "wave")
		end
		-- 잠깐 서서 한마디 하고 제 자리로 달려간다
		task.delay(if byMe then 1.6 else 0.9, function()
			if rig.model.Parent and session.state == S.OBBY and not RescueService.busy(session, d.id) then
				SquadNpcService.setMood(rig, "IDLE")
				runBackToSquad(session, r, rig)
			end
		end)
	end)
	if byMe then
		SquadNpcService.allowSpeech(rig, 2.6) -- 조용한 분대원: 일으켜 준 고마움은 남긴다
		H().bubble(session, d.id, pick(r, T.thanks[d.id], "thanks_" .. d.id), 2.2)
		H().fx(session, "REVIVE", { pos = d.pos + Vector3.new(0, 1.5, 0), memberId = d.id })
		session.rec.revives = (session.rec.revives or 0) + 1
		countHelp(session, r, d.id, "REVIVE")
		TelemetryService.log("rescue_revive", { who = d.id, after = os.clock() - d.at })
	else
		H().bubble(session, d.id, (T.autoUp :: { [string]: string })[d.id] or "…", 1.8)
		session.rec.autoUps = (session.rec.autoUps or 0) + 1
		TelemetryService.log("rescue_autoup", { who = d.id })
	end
	H().markDirty(session)
end

-- 분대원 하나를 넘어뜨린다 (memberId 없으면 가중치로). 자리를 못 찾으면 false
function RescueService.fall(session: SessionLike, memberId: string?): boolean
	local r = ensure(session)
	if session.state ~= S.OBBY or r.down or r.npcFrozen or r.me then
		return false
	end
	local from = myPos(session)
	local target = squadTarget(session)
	if not from or not target then
		return false
	end
	local allowed: { string } = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig and not m.waiting and not RescueService.busy(session, id) then
			table.insert(allowed, id)
		end
	end
	local id = memberId or weighted(r, R.FallWeights, allowed)
	if not id or not table.find(allowed, id) then
		return false
	end
	local _, rig = npcOf(session, id)
	if not rig then
		return false
	end
	local spot = fallSpot(session, r, from, target)
	if not spot then
		return false
	end
	local yaw = r.rng:NextNumber(-0.5, 0.5) + math.atan2(-(target.X - from.X), -(target.Z - from.Z))
	local prompt = newPrompt(T.promptRevive, nameOf(session, id), R.ReviveDistance, R.ReviveHoldSec, "🤝")
	prompt.Name = "CampRevivePrompt"
	prompt:SetAttribute("ForUserId", session.userId)
	prompt:SetAttribute("PromptOffset", Vector3.new(0, 2.2, 0))
	local d: Down = {
		id = id,
		rig = rig,
		prompt = prompt,
		at = os.clock(),
		autoAt = os.clock() + R.AutoUpSec,
		pos = spot,
		yaw = yaw,
	}
	r.down = d
	-- 넘어지는 자리로 한 걸음 옮겨(달려오다 넘어진 것) 눕는다
	SquadNpcService.setRunning(rig, false)
	SquadNpcService.standAt(rig, spot, flat(target - spot))
	tweenPivot(rig, lieCFrame(spot, yaw), 0.3)
	SquadNpcService.setMood(rig, "DOWN")
	prompt.Triggered:Connect(function(player: Player)
		if player == session.player then
			RescueService.revive(session)
		end
	end)
	prompt.Parent = rig.hrp
	H().bubble(session, id, (T.fall :: { [string]: string })[id] or "…", 2)
	H().fx(session, "FALL_NPC", { pos = spot, memberId = id })
	if not r.hintSaid then
		r.hintSaid = true
		H().lines(session, { { who = "SYSTEM", text = T.hint, sec = 3 } })
	end
	TelemetryService.log("rescue_fall", { who = id, day = session.day })
	H().markDirty(session)
	return true
end

-- E 일으키기 (프롬프트·INTERACT·DevApi). 가까이 있을 때만
function RescueService.revive(session: SessionLike, ignoreDistance: boolean?): boolean
	local r = rescues[session.userId]
	local d = r and r.down
	if not r or not d then
		return false
	end
	if not ignoreDistance then
		local me = myPos(session)
		if not me or (me - d.rig.hrp.Position).Magnitude > R.ReviveDistance + 1 then
			return false
		end
	end
	standUp(session, r, d, true)
	return true
end

-- 분대가 앞으로 옮겨 갈 때 (freeSquadAhead): 곧 넘어질 차례면 지금 넘어진다 (달려가다 넘어지는 그림)
function RescueService.maybeFall(session: SessionLike)
	local r = rescues[session.userId]
	if not r or r.fallsLeft <= 0 or r.down or r.npcFrozen or r.me then
		return
	end
	local now = os.clock()
	if now - r.startAt < R.FallNotBeforeSec or r.nextFallAt - now > 6 then
		return
	end
	task.delay(0.35, function()
		if rescues[session.userId] == r and session.state == S.OBBY and not r.down then
			if RescueService.fall(session, nil) then
				r.fallsLeft -= 1
				r.nextFallAt = os.clock() + R.FallMinGapSec + r.rng:NextNumber(0, 10)
			end
		end
	end)
end

-- ===== 얼음: 나 =====
local function restoreMe(r: Rescue, me: MeFrozen)
	if me.hum.Parent then
		me.hum.WalkSpeed = me.walk
		me.hum.JumpPower = me.jumpPower
		me.hum.JumpHeight = me.jumpHeight
	end
	if me.char.Parent then
		me.char:SetAttribute("CampFrozen", false)
	end
	if me.prompt then
		me.prompt:Destroy()
	end
	r.lastThawAt = os.clock()
end

local function thawMe(session: SessionLike, r: Rescue, me: MeFrozen, by: string)
	if r.me ~= me then
		return
	end
	r.me = nil
	restoreMe(r, me)
	local pos = myPos(session)
	H().fx(session, "THAW", { pos = pos, who = "ME", by = by })
	TelemetryService.log("rescue_thaw_me", { by = by, after = os.clock() - me.at })
	H().markDirty(session)
end

-- 가까운 분대원이 달려와 "땡!"
local function dispatchHelper(session: SessionLike, r: Rescue, me: MeFrozen)
	local pos = myPos(session)
	if not pos then
		return
	end
	local best: Rig? = nil
	local bestD = math.huge
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig and not m.waiting and not RescueService.busy(session, id) then
			local d = (rig.hrp.Position - pos).Magnitude
			if d < bestD then
				best, bestD = rig, d
			end
		end
	end
	if not best then
		return
	end
	local rig = best :: Rig
	me.helperId = rig.memberId
	me.helperReturn = rig.model:GetPivot()
	local away = flat(rig.hrp.Position - pos)
	local dir = if away.Magnitude > 0.5 then away.Unit else Vector3.new(1, 0, 0)
	-- 멀리 있으면 가까운 데서 나타나 달려온다 (깃발 앞은 보통 30 stud 넘게 멀다)
	if bestD > R.HelperAppearStuds then
		SquadNpcService.standAt(rig, pos + dir * (R.HelperAppearStuds - 2), -dir)
	end
	local dest = pos + dir * 2.5
	local dist = flat(dest - rig.hrp.Position).Magnitude
	glide(r, rig, dest, -dir, math.clamp(dist / R.NpcRunSpeed, 0.6, R.FreezeFreedSec - R.FreezeHelpAtSec), function()
		if r.me ~= me then
			return
		end
		SquadNpcService.playOnce(rig, "point")
		SquadNpcService.allowSpeech(rig, 1.8) -- "땡!" 은 남긴다 (얼음을 푸는 순간)
		H().bubble(session, rig.memberId, T.thawCall, 1.6)
		me.helperSaid = true
		thawMe(session, r, me, rig.memberId)
		-- 잠깐 뒤 제 자리로
		task.delay(1.2, function()
			if rig.model.Parent and rescues[session.userId] == r and session.state == S.OBBY then
				local back = me.helperReturn
				if back then
					local d = flat(back.Position - rig.hrp.Position).Magnitude
					glide(r, rig, back.Position, back.LookVector, runSec(d))
				end
			end
		end)
	end)
end

-- 발각: 제자리 얼음 (뒤로 밀림 대신). 이미 얼었거나 풀린 직후면 false (tickFree 가 spotCount 를 세지 않게)
function RescueService.freezeMe(session: SessionLike, zone: SceneBindings.Zone?): boolean
	local r = ensure(session)
	local now = os.clock()
	if r.me or now - r.lastThawAt < R.FreezeCooldownSec or session.state ~= S.OBBY then
		return false
	end
	local ch = session.player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not ch or not hum or not hrp or not hrp:IsA("BasePart") then
		return false
	end
	local me: MeFrozen = {
		char = ch,
		hum = hum,
		walk = hum.WalkSpeed,
		jumpPower = hum.JumpPower,
		jumpHeight = hum.JumpHeight,
		at = now,
		untilAt = now + R.FreezeSec,
		prompt = nil,
		helperId = nil,
		helperReturn = nil,
		helperSaid = false,
		zoneId = if zone then zone.id else "",
	}
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
	ch:SetAttribute("CampFrozen", true)
	-- 친구(coop)가 풀어 주는 프롬프트: 내 캐릭터에 달고 나에게는 숨긴다 (HideForUserId). 서버는 누른 사람이 내가 아닌지 확인
	local p = newPrompt(T.promptThaw, session.player.DisplayName, R.ThawDistance, R.ThawHoldSec, "❄️")
	p.Name = "CampThawMePrompt"
	p:SetAttribute("HideForUserId", session.userId)
	p.Triggered:Connect(function(player: Player)
		if player ~= session.player and player.Parent == Players and r.me == me then
			thawMe(session, r, me, "FRIEND")
		end
	end)
	p.Parent = hrp
	me.prompt = p
	r.me = me
	H().lines(session, { T.frozenMe })
	H().bubble(session, "MIR", T.frozenMeMir, 1.8)
	H().fx(session, "FREEZE", { pos = hrp.Position, who = "ME" })
	TelemetryService.log("rescue_freeze_me", { zone = me.zoneId })
	H().markDirty(session)
	return true
end

-- ===== 얼음: 분대원 =====
local function thawNpc(session: SessionLike, r: Rescue, f: NpcFrozen, byMe: boolean)
	if r.npcFrozen ~= f then
		return
	end
	r.npcFrozen = nil
	f.prompt:Destroy()
	local rig = f.rig
	SquadNpcService.setMood(rig, if byMe then "HAPPY" else "IDLE")
	H().fx(session, "THAW", { pos = rig.hrp.Position, who = f.id })
	if byMe then
		SquadNpcService.playOnce(rig, "wave")
		SquadNpcService.allowSpeech(rig, 2.6) -- 조용한 분대원: 풀어 준 고마움은 남긴다
		H().bubble(session, f.id, pick(r, T.thawThanks[f.id], "thaw_" .. f.id), 2.2)
		session.rec.thaws = (session.rec.thaws or 0) + 1
		countHelp(session, r, f.id, "THAW")
		TelemetryService.log("rescue_thaw_npc", { who = f.id, after = os.clock() - f.at })
	else
		H().bubble(session, f.id, (T.autoThaw :: { [string]: string })[f.id] or "…", 1.6)
		TelemetryService.log("rescue_autothaw", { who = f.id })
	end
	task.delay(if byMe then 1.6 else 0.8, function()
		if
			rig.model.Parent
			and session.state == S.OBBY
			and rescues[session.userId] == r
			and not RescueService.busy(session, f.id)
		then
			SquadNpcService.setMood(rig, "IDLE")
			runBackToSquad(session, r, rig)
		end
	end)
	H().markDirty(session)
end

-- 분대원 하나를 얼린다 (지금 자리에서). memberId 없으면 가중치
function RescueService.freezeNpc(session: SessionLike, memberId: string?): boolean
	local r = ensure(session)
	if session.state ~= S.OBBY or r.npcFrozen or r.down then
		return false
	end
	local allowed: { string } = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig and not m.waiting and not RescueService.busy(session, id) then
			table.insert(allowed, id)
		end
	end
	local id = memberId or weighted(r, R.NpcFreezeWeights, allowed)
	if not id or not table.find(allowed, id) then
		return false
	end
	local _, rig = npcOf(session, id)
	if not rig then
		return false
	end
	local prompt = newPrompt(T.promptThaw, nameOf(session, id), R.ThawDistance, R.ThawHoldSec, "❄️")
	prompt.Name = "CampThawPrompt"
	prompt:SetAttribute("ForUserId", session.userId)
	local f: NpcFrozen = { id = id, rig = rig, prompt = prompt, at = os.clock(), autoAt = os.clock() + R.NpcFreezeSec }
	r.npcFrozen = f
	SquadNpcService.setMood(rig, "FROZEN")
	prompt.Triggered:Connect(function(player: Player)
		if player == session.player then
			RescueService.thaw(session)
		end
	end)
	prompt.Parent = rig.hrp
	H().bubble(session, id, (T.frozenNpc :: { [string]: string })[id] or "…", 2)
	H().fx(session, "FREEZE", { pos = rig.hrp.Position, who = id })
	TelemetryService.log("rescue_freeze_npc", { who = id })
	H().markDirty(session)
	return true
end

-- E 풀어 주기 (프롬프트·INTERACT·DevApi)
function RescueService.thaw(session: SessionLike, ignoreDistance: boolean?): boolean
	local r = rescues[session.userId]
	local f = r and r.npcFrozen
	if not r or not f then
		return false
	end
	if not ignoreDistance then
		local me = myPos(session)
		if not me or (me - f.rig.hrp.Position).Magnitude > R.ThawDistance + 1 then
			return false
		end
	end
	thawNpc(session, r, f, true)
	return true
end

-- 탐조등이 켜지는 순간 (tickFree): 빛 안에 선 분대원이 있으면 언다. 없으면 내가 빛 가장자리 가까이 있을 때 앞서 달리던 하나가 걸린다.
-- 탐조등마다 하루 한 번, 한 번에 한 사람
function RescueService.lightOn(session: SessionLike, zone: SceneBindings.Zone)
	local r = rescues[session.userId]
	if not r or r.zonesUsed[zone.id] or r.npcFrozen or r.down or r.me then
		return
	end
	if session.state ~= S.OBBY or os.clock() - r.lastThawAt < R.FreezeCooldownSec then
		return
	end
	local me = myPos(session)
	if not me then
		return
	end
	-- 빛 안에 선 사람
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig and not RescueService.busy(session, id) and insideFlat(zone.part, rig.hrp.Position, 6) then
			r.zonesUsed[zone.id] = true
			RescueService.freezeNpc(session, id)
			return
		end
	end
	-- 내가 빛 가장자리 근처에 있고(보이는 거리) 분대가 멀리 앞에 있으면: 앞서 달리던 하나가 빛 안에서 걸린다
	local half = math.max(zone.part.Size.X, zone.part.Size.Z) / 2
	local dMe = flat(me - zone.part.Position).Magnitude
	if dMe > half + R.NpcFreezeNearStuds or insideFlat(zone.part, me, 6) then
		return
	end
	local allowed: { string } = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig and not m.waiting and not RescueService.busy(session, id) then
			table.insert(allowed, id)
		end
	end
	local id = weighted(r, R.NpcFreezeWeights, allowed)
	if not id then
		return
	end
	local _, rig = npcOf(session, id)
	if not rig then
		return
	end
	r.zonesUsed[zone.id] = true
	-- 빛 안, 내 쪽 가장자리에서 3 안쪽 (내가 가는 길 위에서 걸린 그림)
	local toMe = flat(me - zone.part.Position)
	local dir = if toMe.Magnitude > 0.5 then toMe.Unit else zone.part.CFrame.LookVector
	local spot = zone.part.Position + dir * math.max(1, half - 3)
	local hit = groundOf(spot, { rig.model })
	if hit and hit.Material ~= Enum.Material.Water then
		spot = hit.Position
	end
	SquadNpcService.standAt(rig, spot, -dir)
	RescueService.freezeNpc(session, id)
end

-- ===== E (INTERACT): 가까운 넘어진/언 사람 =====
function RescueService.interact(session: SessionLike): boolean
	local r = rescues[session.userId]
	if not r then
		return false
	end
	if RescueService.revive(session, false) then
		return true
	end
	return RescueService.thaw(session, false)
end

-- ===== 날 시작·정리·틱 =====
function RescueService.beginDay(session: SessionLike)
	RescueService.clear(session)
	local r = ensure(session)
	r.day = session.day
	r.startAt = os.clock()
	r.zonesUsed = {}
	r.helpedToday = {}
	r.helpedHow = {}
	r.thankedTonight = {}
	if R.FallDays[session.day] then
		r.fallsLeft = r.rng:NextInteger(R.FallsPerDay[1], R.FallsPerDay[2])
		r.nextFallAt = r.startAt + R.FallNotBeforeSec + r.rng:NextNumber(0, 8)
	else
		r.fallsLeft = 0
		r.nextFallAt = math.huge
	end
	H().markDirty(session)
end

-- 유격을 떠날 때(밤·기지·다시·나감): 누운 사람 세우고, 프롬프트 지우고, 내 걸음 되돌린다
function RescueService.clear(session: SessionLike)
	local r = rescues[session.userId]
	if not r then
		return
	end
	for id in pairs(r.moving) do
		r.moving[id] = nil
		local _, rig = npcOf(session, id)
		if rig then
			SquadNpcService.setRunning(rig, false)
		end
	end
	local d = r.down
	if d then
		r.down = nil
		d.prompt:Destroy()
		if d.rig.model.Parent then
			SquadNpcService.setMood(d.rig, "IDLE")
			SquadNpcService.standAt(d.rig, d.pos, Vector3.new(0, 0, -1))
		end
	end
	local f = r.npcFrozen
	if f then
		r.npcFrozen = nil
		f.prompt:Destroy()
		if f.rig.model.Parent then
			SquadNpcService.setMood(f.rig, "IDLE")
		end
		H().fx(session, "THAW", { pos = f.rig.hrp.Position, who = f.id, quiet = true })
	end
	local me = r.me
	if me then
		r.me = nil
		restoreMe(r, me)
		r.lastThawAt = 0
		H().fx(session, "THAW", { pos = myPos(session), who = "ME", quiet = true })
	end
	r.fallsLeft = 0
	r.nextFallAt = math.huge
end

function RescueService.onPlayerRemoving(session: SessionLike)
	local r = rescues[session.userId]
	if r then
		local me = r.me
		if me then
			r.me = nil
			restoreMe(r, me)
		end
		if r.down then
			r.down.prompt:Destroy()
		end
		if r.npcFrozen then
			r.npcFrozen.prompt:Destroy()
		end
	end
	rescues[session.userId] = nil
end

function RescueService.tick(session: SessionLike, _dt: number)
	local r = rescues[session.userId]
	if not r then
		return
	end
	local now = os.clock()
	-- 나: 리셋·리스폰이면 그냥 끝, 아니면 분대원 보내기 → 5초 자동 풀림
	local me = r.me
	if me then
		if me.char ~= session.player.Character or not me.char.Parent then
			r.me = nil
			restoreMe(r, me)
			H().markDirty(session)
		elseif now >= me.untilAt then
			thawMe(session, r, me, "AUTO")
		elseif not me.helperId and now - me.at >= R.FreezeHelpAtSec then
			dispatchHelper(session, r, me)
		end
	end
	local d = r.down
	if d and now >= d.autoAt then
		standUp(session, r, d, false)
	end
	local f = r.npcFrozen
	if f and now >= f.autoAt then
		thawNpc(session, r, f, false)
	end
	-- 넘어짐 일정 (2·6일차): 때가 되면 하나 넘어진다. 자리를 못 찾으면 4초 뒤 다시
	if
		r.fallsLeft > 0
		and session.state == S.OBBY
		and not r.down
		and not r.npcFrozen
		and not r.me
		and now >= r.nextFallAt
	then
		if RescueService.fall(session, nil) then
			r.fallsLeft -= 1
			r.nextFallAt = now + R.FallMinGapSec + r.rng:NextNumber(0, 10)
		else
			r.nextFallAt = now + 4
		end
	end
end

-- ===== 밤 고마움 (CampfireService.sit 이 묻는다): 오늘 내가 살린 사람이면 한 번만 =====
function RescueService.thanksTonight(session: { userId: number }, memberId: string): Line?
	local r = rescues[session.userId]
	if not r or (r.helpedToday[memberId] or 0) <= 0 or r.thankedTonight[memberId] then
		return nil
	end
	r.thankedTonight[memberId] = true
	local pool = if r.helpedHow[memberId] == "THAW" then T.tonightThaw else T.tonight
	local text = (pool :: { [string]: string })[memberId]
	if not text then
		return nil
	end
	return { who = memberId, text = text, sec = 2.4 }
end

-- ===== 스냅샷 =====
function RescueService.view(session: SessionLike): ProtocolTypes.RescueView?
	local r = rescues[session.userId]
	if not r or session.state ~= S.OBBY then
		return nil
	end
	return {
		downId = if r.down then r.down.id else nil,
		frozenId = if r.npcFrozen then r.npcFrozen.id else nil,
		meFrozenLeft = if r.me then math.max(0, r.me.untilAt - os.clock()) else nil,
		revives = (session.rec.revives or 0) + (session.rec.thaws or 0),
	}
end

-- Studio 검증용 (DevApi "rescue")
function RescueService.debug(session: SessionLike): { [string]: any }
	local r = rescues[session.userId]
	local out: { [string]: any } = { state = session.state, day = session.day }
	if not r then
		out.rescue = "none"
		return out
	end
	out.fallsLeft = r.fallsLeft
	out.nextFallIn = if r.nextFallAt == math.huge then nil else r.nextFallAt - os.clock()
	out.down = if r.down
		then string.format("%s autoIn=%.1f pos=%s", r.down.id, r.down.autoAt - os.clock(), tostring(r.down.pos))
		else nil
	out.frozen = if r.npcFrozen
		then string.format("%s autoIn=%.1f", r.npcFrozen.id, r.npcFrozen.autoAt - os.clock())
		else nil
	out.me = if r.me
		then string.format(
			"left=%.1f helper=%s walk=%.0f",
			r.me.untilAt - os.clock(),
			tostring(r.me.helperId),
			r.me.hum.WalkSpeed
		)
		else nil
	local helped = {}
	for id, n in pairs(r.helpedToday) do
		table.insert(helped, id .. "=" .. n)
	end
	out.helpedToday = table.concat(helped, ",")
	local moving = {}
	for id in pairs(r.moving) do
		table.insert(moving, id)
	end
	out.moving = table.concat(moving, ",")
	local used = {}
	for id in pairs(r.zonesUsed) do
		table.insert(used, id)
	end
	out.zonesUsed = table.concat(used, ",")
	out.recRevives = session.rec.revives
	out.recAutoUps = session.rec.autoUps
	out.recThaws = session.rec.thaws
	out.relHelped = session.rel.helped
	out.lastThawAgo = os.clock() - r.lastThawAt
	return out
end

-- 넘어진/언 사람 자리 (DevApi "rescue","near": 옆으로 순간이동해 진짜 E 시험)
function RescueService.targetPosition(session: SessionLike): Vector3?
	local r = rescues[session.userId]
	if not r then
		return nil
	end
	if r.down then
		return r.down.rig.hrp.Position
	elseif r.npcFrozen then
		return r.npcFrozen.rig.hrp.Position
	end
	return nil
end

return RescueService
]]></string>
