	-- 트랙: 타원 트랙(길 8개 조각으로 고리) + 출발선
	for i = 1, 8 do
		local a = (i - 1) / 8 * math.pi * 2
		local cx, cz = 96 + math.cos(a) * 7, 8 + math.sin(a) * 14
		box(
			"Gym_Track" .. i,
			"Roads",
			Vector3.new(4, 0.12, 12),
			CFrame.new(cx, 0.36, cz) * CFrame.Angles(0, -a, 0),
			Color3.fromHex("B04A3A"),
			Enum.Material.Sand,
			{ canCollide = false }
		)
	end
	deco("Gym_TrackLine", Vector3.new(4, 0.05, 0.4), at(103, 0.45, 8), Palette.Cream, Enum.Material.SmoothPlastic)
	deco(
