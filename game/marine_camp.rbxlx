	rocks("IslandRock1", -28, -1028, 1.0, 920, true, 1)
	rocks("IslandRock2", 28, -1066, 1.2, 921, true, 1)
	tidePool("IslandPool", 26, -1026, 2.0, 922, 1)
	crate("DockCrate1", 16, 1, -1034, 2.2, 15)
	crate("DockCrate2", 18.6, 1, -1035.5, 1.8, -20)
	barrel("DockBarrel", 18.8, -1031, Palette.Sea, 1)
	deco(
		"DockCoil",
		Vector3.new(0.5, 1.4, 1.4),
		CFrame.new(14, 1.3, -1037.5) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Rope,
		Enum.Material.Fabric,
		{ shape = Enum.PartType.Cylinder }
	)
	for i, p in ipairs({ { -26, -1056 }, { 24, -1046 }, { -8, -1064 } }) do
		bush("IslandBush" .. i, p[1], p[2], 0.7, 930 + i, 1)
	end
	tentDress("D4_Shelter_Tent", 20, -1055, 8, 10, 5, 1, 2, C.Canvas2)
	for i, p in ipairs({ { -24, -1050 }, { 14, -1062 }, { 26, -1036 } }) do
		shell("IslandShell" .. i, p[1], p[2], 935 + i, 1)
	end
	-- 해안 뒤 바위 곶 둘 (육지, 바다 양 끝 모서리) + 야자
	rocks("Headland1", -128, -1092, 2.2, 940, true)
	rocks("Headland2", 134, -1088, 2.0, 941, true)
	palmTree("HeadPalm1", -136, -1098, 1.3, 942)
	palmTree("HeadPalm2", 142, -1096, 1.2, 943)
	palmTree("BeachPalm1", -118, -690, 1.1, 944)
	palmTree("BeachPalm2", 122, -688, 1.0, 945)
end

local function nightArea()
	-- 두 길 사이 이끼 바위 (SHORT x≈-176~-190, LANTERN x≈-130~-158 사이 x≈-156~-160)
	rocks("ForestRock1", -156, -640, 1.0, 1000, true)
	rocks("ForestRock2", -160, -560, 1.1, 1001, true)
	rocks("ForestRock3", -153, -760, 0.9, 1002, true)
	bush("ForestBush1", -152, -600, 1.0, 1010)
	bush("ForestBush2", -162, -500, 0.9, 1011)
	bush("ForestBush3", -118, -680, 1.0, 1012)
	bush("ForestBush4", -205, -760, 1.0, 1013)
	-- 반딧불: 등불 길 쪽에만 (지름길은 어둡게 둔다) + 광장
	fireflies("ForestFly1", -118, -700, 5, 1020)
	fireflies("ForestFly2", -116, -560, 5, 1021)
	fireflies("ForestFly3", -146, -440, 4, 1022)
	fireflies("PlazaFly", -222, -282, 6, 1023)
	-- 촛불 광장: 등불 기둥 5 (진입 -90°·출구 52° 를 비움) + 등 줄 3 + 삼각대 주전자. 촛불 묶음은 restyle 이 D5_Candle 마다 받침·곁촛불을 덧붙인다
	local function postPos(a: number): Vector3
		return Vector3.new(-200 + math.cos(math.rad(a)) * 19, 0, -300 + math.sin(math.rad(a)) * 19)
	end
	for i, a in ipairs({ 8, 100, 165, 195, 330 }) do
		local p = postPos(a)
		lanternPost("PlazaLantern" .. i, p.X, p.Z, 5.6, a + 90)
	end
	lanternString("PlazaString1", postPos(100) + Vector3.new(0, 5.5, 0), postPos(165) + Vector3.new(0, 5.5, 0), 4)
	lanternString("PlazaString2", postPos(165) + Vector3.new(0, 5.5, 0), postPos(195) + Vector3.new(0, 5.5, 0), 3)
	lanternString("PlazaString3", postPos(8) + Vector3.new(0, 5.5, 0), postPos(330) + Vector3.new(0, 5.5, 0), 3)
	tripod("PlazaTripod", -200, -300)
	-- 통나무 더미는 광장 밖 서쪽(편지함 남쪽)으로
	woodpile("PlazaWood", -226, -298, 80)
	-- 5일차(탈출) 길: 갈림길 삼각형 안 바위·덤불, 바깥 소나무·활엽
	rocks("EscRock1", -85, -175, 1.2, 1040, true)
	bush("EscBush1", -98, -150, 1.0, 1041)
	bush("EscBush2", -78, -182, 0.9, 1042)
	pineTree("EscPine1", -172, -238, 1.2, 1050)
	pineTree("EscPine2", -112, -252, 1.1, 1051)
	leafyTree("EscTree3", -30, -150, 1.0, 1052)
	pineTree("EscPine4", -150, -150, 1.3, 1053)
	rocks("EscRock2", -150, -165, 0.9, 1043, true)
end

-- 중경(기지 ±115 밖 ~ 언덕 사이)·유격장 둘레·바다 뒤: 나무·덤불·바위 흩뿌리기. 길(SEG)·유격장 동선·사격장은 피한 좌표
local SCATTER: { { number } } = { -- x, z, kind(1 pine 2 leafy 3 bush 4 rock), scale
	{ -60, 165, 2, 1.4 },
	{ 30, 185, 1, 1.5 },
	{ 100, 150, 2, 1.3 },
	{ -120, 180, 1, 1.6 },
	{ 160, 125, 2, 1.2 },
	{ -150, 85, 1, 1.4 },
	{ 165, 30, 2, 1.3 },
	{ -140, -10, 1, 1.5 },
	{ -165, 40, 2, 1.2 },
	{ -150, -84, 2, 1.4 },
	{ 170, -70, 1, 1.5 },
	{ 190, -20, 3, 1.2 },
	{ -135, 60, 3, 1.1 },
	{ 70, 170, 3, 1.3 },
	{ -90, 150, 4, 1.4 },
	{ 130, 170, 4, 1.2 },
	{ -175, -60, 4, 1.1 },
	-- 유격장 둘레(동선 x 60~200 밖·사이 큰 빈 땅)
	{ 20, -330, 2, 1.3 },
	{ 10, -400, 1, 1.4 },
	{ 30, -470, 2, 1.2 },
	{ 120, -270, 1, 1.3 },
	{ 230, -330, 2, 1.4 },
	{ 245, -400, 1, 1.5 },
	{ 250, -520, 2, 1.3 },
	{ 215, -580, 1, 1.4 },
	{ 110, -300, 3, 1.1 },
	{ 100, -480, 3, 1.3 },
	{ 60, -420, 4, 1.3 },
	{ 240, -460, 4, 1.4 },
	-- 옛 갯벌 자리(바다 북쪽 벌판 x -25~105, z -520~-700)
	{ 40, -560, 2, 1.5 },
	{ 90, -610, 1, 1.4 },
	{ -10, -640, 2, 1.3 },
	{ 70, -670, 3, 1.3 },
	{ 20, -600, 4, 1.5 },
	{ 110, -660, 3, 1.1 },
	{ -60, -560, 1, 1.3 },
	{ -90, -640, 2, 1.4 },
	-- 바다 동·서 해안 뒤
	{ 165, -760, 1, 1.4 },
	{ 170, -880, 2, 1.3 },
	{ 160, -960, 1, 1.5 },
	{ 172, -820, 3, 1.2 },
	{ -184, -1000, 1, 1.3 }, -- 야간 길 x≈-156(z -1000) 에서 25 이상
	{ -202, -940, 2, 1.4 }, -- 야간 길(-150,-1040)→(-170,-900) 과 지름길 x≈-172 를 피한다 (길 위면 부품 단위로 빠져 잎만 뜬다)
	{ -206, -820, 3, 1.2 },
	-- 5일차(탈출) 길 바깥
	{ -40, -200, 2, 1.3 },
	{ -20, -240, 1, 1.2 },
	{ -100, -300, 1, 1.4 },
	{ -150, -120, 3, 1.2 },
	{ -170, -200, 4, 1.3 },
	{ -10, -170, 3, 1.1 },
}

local function scatter()
	for i, s in ipairs(SCATTER) do
		local id = "Scat" .. i
		local y = hillY(s[1], s[2])
		if s[3] == 1 then
			pineTree(id, s[1], s[2], s[4], 3200 + i, y)
		elseif s[3] == 2 then
			leafyTree(id, s[1], s[2], s[4], 3300 + i, y)
		elseif s[3] == 3 then
			bush(id, s[1], s[2], s[4], 3000 + i, y)
		else
			rocks(id, s[1], s[2], s[4], 3100 + i, true, y)
		end
	end
end

-- 군락 (숲 가장자리·유격장 모서리·기지 바깥 — 균일 산포 대신 모여 있게)
local function groves()
	grove("GroveA", -100, -660, 5001, 4, 0.5) -- 등불 길 동쪽 30
	grove("GroveB", -222, -600, 5002, 5, 0.7) -- 지름길 서쪽 숲 가장자리
	grove("GroveC", 12, -362, 5003, 4, 0.3) -- 유격장 남서 모서리
	grove("GroveD", 248, -372, 5004, 5, 0.6) -- 유격장 동쪽
	grove("GroveE", -140, 96, 5005, 4, 0.4) -- 기지 서남 언덕 발치
	grove("GroveF", 150, -600, 5006, 4, 0.5) -- 옛 갯벌 동쪽
	grove("GroveG", -36, -242, 5007, 3, 0.4) -- 탈출 길 바깥 (1일차 옛 길 x 0 에서 20 이상)
	grove("GroveH", -225, -1000, 5008, 5, 0.8) -- 다리 서쪽 끝 숲
end

-- 먼 언덕 실루엣: 바위 봉우리 + 나무 2~3 (큰 비율, far = 3~4 파트)
local function hillProps()
	for i, h in ipairs(HILLS) do
		local g = rng(2000 + i)
		local n = if h.r >= 60 then 3 else 2
		for j = 1, n do
			local a = g() * math.pi * 2
			local d = h.r * (0.35 + g() * 0.3)
			local x, z = h.x + math.cos(a) * d, h.z + math.sin(a) * d
			if j == 2 then
				leafyTree(
					string.format("Hill%d_Tree%d", i, j),
					x,
					z,
					1.8 + g() * 0.6,
					2200 + i * 10 + j,
					hillY(x, z),
					true
				)
			else
				pineTree(
					string.format("Hill%d_Pine%d", i, j),
					x,
					z,
					2.0 + g() * 0.8,
					2200 + i * 10 + j,
					hillY(x, z),
					true
				)
			end
		end
		if h.rock then
			rocks(string.format("Hill%d_Rock", i), h.x + 4, h.z - 3, 2.6, 2100 + i, false, hillY(h.x + 4, h.z - 3) - 1)
		end
	end
end

function CampArt.specs(): { Spec }
	table.clear(out)
	table.clear(used)
	baseArea()
	obbyArea()
	seaArea()
	nightArea()
	scatter()
	groves()
	hillProps()
	return table.clone(out)
end

-- ===== 기존 스펙 되살리기 (재질·색·투명도만. 크기·위치·Triggers·Spawns·Kind 는 건드리지 않는다) =====
-- + 생성기가 만든 나무(`*_Trunk`, 길 밖으로 민 뒤의 최종 위치)와 촛불(D5_Candle)에 Art_ 덩어리를 덧붙인다 (원래 파트는 그대로)
local SKIP_FOLDER = { Triggers = true, Spawns = true }
local TENT_CANVAS = { Palette.Olive, C.Canvas2, C.Canvas3, C.Canvas4 }

local function addSpec(
	list: { Spec },
	id: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	mat: Enum.Material,
	extra: { [string]: any }?
)
	local s: Spec = {
		id = "Art_" .. id,
		folder = "Decorations",
		size = size,
		cframe = cf,
		color = color,
		material = mat,
		canCollide = false,
	}
	if extra then
		for k, v in pairs(extra) do
			(s :: any)[k] = v
		end
	end
	table.insert(list, s)
end

-- 생성기 나무(줄기 1.4s × 7s, 잎 7s@8.5s + 5s@11s)에 잎 2 덧붙임. 야자는 잎 4장
local function dressTree(list: { Spec }, trunk: Spec)
	local s = trunk.size.Y / 7 -- (줄기 굵기는 restyle 이 줄이므로 높이로)
	local p = trunk.cframe.Position
	local base = p.Y - 3.5 * s
	local name = string.match(trunk.id, "^(.-)_Trunk$") :: string
	local g = rng(#name * 131 + math.floor(p.X) + math.floor(p.Z) * 3)
	if string.match(name, "^D4_Palm") then
		for i = 1, 4 do
			local a = (i - 1) * math.pi / 2 + g() * 0.6
			addSpec(
				list,
				string.format("%s_Frond%d", name, i),
				Vector3.new(0.7 * s, 0.22 * s, 5.0 * s),
				CFrame.new(p.X, base + 9.6 * s, p.Z)
					* CFrame.Angles(0, a, 0)
					* CFrame.Angles(math.rad(-30), 0, 0)
					* CFrame.new(0, 0, -2.4 * s),
				if i % 2 == 0 then C.LeafBright else Color3.fromRGB(96, 160, 70),
				Enum.Material.Grass,
				{ attrs = { AssetFallback = trunk.id } }
			)
		end
		return
	end
	-- 3차: 원래 잎 2 를 0.85 로 줄이고(restyle) 작은 덩어리 2~3 을 가장자리에 — 큰 공 둘(브로콜리) 대신 울퉁불퉁한 가장자리.
	-- 아래 덩어리는 그림자 톤. 밤 숲(D5_, 57그루)은 2 개만 (파트 예산)
	local dark = string.match(name, "^D5_") ~= nil
	local toneA = if dark then C.LeafPine3 else C.LeafBright
	local toneB = if dark then C.LeafPine2 else C.Bush
	local clumps = {
		{ "_L3", 3.6, -2.3, 7.2, 1.5, if dark then C.LeafPine else C.LeafShadow },
		{ "_L4", 3.4, 2.4, 8.6, 1.6, toneB },
		{ "_L5", 2.8, -0.9, 12.0, -1.6, toneA },
	}
	for i, c in ipairs(clumps) do
		if dark and i == 2 then -- 밤 숲 57그루는 하나만 (파트 예산 +600, 3차)
			break
		end
		addSpec(
			list,
			name .. c[1],
			Vector3.new(c[2] * s, c[2] * s * 0.85, c[2] * s),
			CFrame.new(p.X + c[3] * s, base + c[4] * s, p.Z + c[5] * s) * rot(g, 0.7),
			c[6],
			Enum.Material.LeafyGrass,
			{ shape = Enum.PartType.Ball, attrs = { AssetFallback = trunk.id } }
		)
	end
end

-- 촛불(0.5×1.2 원기둥) → 어두운 받침 원판 + 곁촛불 2 (Candle → 5박에 같이 켜짐)
local function dressCandle(list: { Spec }, candle: Spec)
	local p = candle.cframe.Position
	local n = tonumber(string.match(candle.id, "(%d+)$")) or 1
	local g = rng(7000 + n)
	addSpec(
		list,
		candle.id .. "_Base",
		Vector3.new(0.14, 2.0, 2.0),
		CFrame.new(p.X, 0.07, p.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Ink,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Cylinder }
	)
	for i = 1, 2 do
		local a = g() * math.pi * 2
		local h = 0.7 + g() * 0.5
		addSpec(
			list,
			string.format("%s_S%d", candle.id, i),
			Vector3.new(0.4, h, 0.4),
			CFrame.new(p.X + math.cos(a) * 0.6, h / 2 + 0.14, p.Z + math.sin(a) * 0.6),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, attrs = { Candle = true } }
		)
	end
end

-- 스펙 attrs 에 더하기 (공유 표를 건드리지 않게 복제)
local function withAttrs(s: Spec, add: { [string]: any })
	local a: { [string]: any } = if s.attrs then table.clone(s.attrs) else {}
	for k, v in pairs(add) do
		a[k] = v
	end
	s.attrs = a
end

-- 에셋 1차: 생성기(Bootstrap) 나무·모닥불 의자에 앵커/대체 속성 (최종 위치를 아는 곳이 restyle 뿐)
local function tagGeneratorAssets(specs: { Spec })
	local trunks: { [string]: Spec } = {}
	local dark: { [string]: boolean } = {}
	local logs: { [string]: boolean } = {}
	for _, s in ipairs(specs) do
		local pre = string.sub(s.id, 1, 4)
		if pre == "Art_" or SKIP_FOLDER[s.folder] then
			continue
		end
		local tn = string.match(s.id, "^(.-)_Trunk$")
		if
			tn
			and s.folder == "TerrainProps"
			and string.sub(s.id, 1, 3) ~= "R1_"
			and string.sub(s.id, 1, 3) ~= "R4_"
		then
			trunks[tn] = s
		end
		local ln = string.match(s.id, "^(.-)_Leaf1$")
		if ln and s.color == Palette.OliveDark then
			dark[ln] = true
		end
		if string.match(s.id, "_SeatLog%d+$") and s.folder == "Decorations" then
			logs[s.id] = true
		end
	end
	for name, s in pairs(trunks) do
		local sc = s.size.Y / 7
		local p = s.cframe.Position
		local palm = string.match(name, "^D4_Palm") ~= nil
		withAttrs(s, {
			AssetKey = if palm
				then "TreePalm_A"
				elseif dark[name] then variant("TreePine", "AB", name)
				else variant("TreeLeafy", "AB", name),
			AssetPos = Vector3.new(p.X, p.Y - 3.5 * sc, p.Z),
			AssetYaw = yawOf(name),
			AssetHeight = (if palm then 11.0 elseif dark[name] then 12.4 else 12.0) * sc,
			AssetSnap = true,
		})
	end
	for _, s in ipairs(specs) do
		local ln = string.match(s.id, "^(.-)_Leaf[12]$")
		if ln and trunks[ln] then
			withAttrs(s, { AssetFallback = ln .. "_Trunk" })
		end
		-- 모닥불 통나무 의자 (밤: _SeatLogN 5.4 + 받침돌 2 / 기지: _SeatN 3.4 장식 원통). 앉는 Seat 트리거는 Triggers 라 안 닿는다
		local isLog = logs[s.id] or (s.folder == "Decorations" and string.match(s.id, "_Fire%d*_Seat%d+$") ~= nil)
		if isLog and s.shape == Enum.PartType.Cylinder then
			local p = s.cframe.Position
			local _, ry, _ = s.cframe:ToEulerAnglesYXZ()
			withAttrs(s, {
				AssetKey = "LogSeat",
				AssetPos = Vector3.new(p.X, p.Y - s.size.Y / 2, p.Z),
				AssetYaw = math.deg(ry),
				AssetHeight = 1.15, -- 메시 통나무는 굵기:길이 1:3 → 굵기를 맞추면 길이 ≈3.4 (Seat 두 자리 ±1.5 를 덮는다)
				AssetSnap = true,
			})
		end
		local fire, i = string.match(s.id, "^(.-)_SeatRock(%d+)_%d+$")
		if fire and logs[fire .. "_SeatLog" .. i] then
			withAttrs(s, { AssetFallback = fire .. "_SeatLog" .. i })
		end
	end
end

function CampArt.restyle(specs: { Spec })
	tagGeneratorAssets(specs)
	local extra: { Spec } = {}
	for _, s in ipairs(specs) do
		if SKIP_FOLDER[s.folder] or (s.attrs and s.attrs.Kind ~= nil) then
			continue
		end
		local id = s.id
		-- Art_ 는 이미 때깔, R1_/R4_ 는 CampRideCourse 가 직접 꾸민다 (2차까지 R1 소나무 줄기에 잎을 덧붙여 눈사람처럼 보였다 — 21_ride_03)
		local pre = string.sub(id, 1, 3)
		if string.sub(id, 1, 4) == "Art_" or pre == "R1_" or pre == "R4_" then
			continue
		end
		if id == "Parade_Slab" then
			s.material = Enum.Material.Sand
			s.color = Color3.fromRGB(212, 192, 148)
		elseif id == "Road_Gate" then
			s.material = Enum.Material.Ground
			s.color = Color3.fromRGB(188, 168, 120) -- Ground 재질은 어두워 보여 한 톤 밝게
		elseif string.match(id, "^Parade_Line") or id == "Parade_Center" then
			s.color = Color3.fromRGB(250, 246, 232) -- 흰 선 또렷하게
			s.material = Enum.Material.SmoothPlastic
			if id ~= "Parade_Center" then
				s.transparency = 0
			end
		elseif string.match(id, "^Barracks%d_Roof") then
			local n = tonumber(string.match(id, "^Barracks(%d)")) or 1
			s.color = TENT_CANVAS[n]
		elseif string.match(id, "_Shelter_Tent_Roof%d$") then
			s.color = C.Canvas2
		elseif string.match(id, "^Road_") or string.match(id, "^D5_Path") or string.match(id, "^D6_Path") then
			s.material = Enum.Material.Ground
		elseif string.match(id, "_Leaf1$") then
			s.material = Enum.Material.LeafyGrass
			s.color = if s.color == Palette.OliveDark then C.LeafPine else C.LeafDeep
			if string.match(id, "^D4_Palm") then
				s.color = C.LeafBright
			else
				s.size *= 0.85 -- 큰 공 하나가 덮던 것을 줄이고 dressTree 덩어리로 가장자리를 만든다 (장식, 충돌 없음)
			end
		elseif string.match(id, "_Leaf2$") then
			s.material = Enum.Material.LeafyGrass
			s.color = if s.color == Palette.OliveDark then C.LeafPine2 else C.Bush
			if string.match(id, "^D4_Palm") then
				s.color = Color3.fromRGB(96, 160, 70)
			else
				s.size *= 0.85
			end
		elseif string.match(id, "_Trunk$") and s.folder == "TerrainProps" then
			dressTree(extra, s)
			if not string.match(id, "^D4_Palm") then
				-- 가늘고 어둡게 (나무 줄기는 길 밖으로 밀린 장식 — 길 판정과 무관)
				s.size = Vector3.new(s.size.X * 0.72, s.size.Y, s.size.Z * 0.72)
				s.color = C.Bark
			end
		elseif string.match(id, "^D5_Candle%d+$") then
			dressCandle(extra, s)
		elseif string.match(id, "^D4_Rock") or string.match(id, "^D1_Stone") or string.match(id, "_Stone%d+$") then
			s.material = Enum.Material.Slate
			s.color = C.RockBlue
		elseif id == "D1_Creek" or string.match(id, "^D1_Puddle") or id == "D2_StepPuddle" then
			s.color = C.WaterVivid
			s.transparency = 0.3
		elseif string.match(id, "^Fence_Post") then
			s.material = Enum.Material.Wood
		elseif string.match(id, "^Sandbag%d_") then
			local n = tonumber(string.match(id, "_(%d)$")) or 1
			s.color = if n % 2 == 0 then Palette.Khaki else Color3.fromRGB(172, 158, 114)
		elseif id == "Gym_Slab" then
			s.color = Color3.fromRGB(198, 182, 138)
		elseif id == "Range_Berm" then
			s.material = Enum.Material.Ground
			s.color = C.Dirt
		elseif id == "Range_Slab" then
			s.color = C.SandWarm
		end
	end
	for _, s in ipairs(extra) do
		table.insert(specs, s)
	end
end

-- ===== Terrain 추가 채움 (FillBlock/FillBall 만. 길 위·연병장 ±115 안은 표면 y=0 유지) =====
-- 땅 표면은 채움 윗면 +2 (Bootstrap 실측) → 재질만 바꾸는 패치는 윗면 -2(y 중심 -4, 높이 4)로 채운다
local function patch(T: Terrain, x: number, z: number, w: number, d: number, mat: Enum.Material)
	T:FillBlock(CFrame.new(x, -4, z), Vector3.new(w, 4, d), mat)
end

-- 길을 따라 좁은 흙 띠 (길 파트보다 넓게 → 가장자리 톤 변화)
local function trail(T: Terrain, a: Vector3, b: Vector3, w: number, mat: Enum.Material?, ext: number?)
	local mid = (a + b) / 2
	T:FillBlock(
		CFrame.lookAt(Vector3.new(mid.X, -4, mid.Z), Vector3.new(b.X, -4, b.Z)),
		Vector3.new(w, 4, (b - a).Magnitude + (ext or w)),
		mat or Enum.Material.Ground
	)
end

function CampArt.terrain()
	local T = workspace.Terrain
	-- 1) 풀 무늬: 기지 둘레(모래 ±115 바깥)와 숲 가장자리에 LeafyGrass 조각
	for _, p in ipairs({
		{ -150, 40, 50, 36 },
		{ -140, -70, 40, 40 },
		{ 150, 60, 44, 40 },
		{ 165, -60, 40, 48 },
		{ -40, 150, 60, 30 },
		{ 60, 150, 50, 36 },
		{ 30, -300, 40, 60 },
		{ 240, -340, 40, 60 },
		{ 230, -480, 36, 40 },
		{ -90, -300, 50, 50 },
		{ -100, -600, 40, 70 },
		{ -215, -800, 24, 80 },
		{ -224, -520, 22, 90 },
		{ -60, -950, 60, 60 },
		{ 190, -900, 50, 70 },
		{ 100, -400, 40, 30 },
		{ 190, -450, 30, 50 },
	}) do
		patch(T, p[1], p[2], p[3], p[4], Enum.Material.LeafyGrass)
	end
	-- 2) 모래 ↔ 풀 경계 깨기: 모래 가장자리에 흙·풀 손가락
	for _, p in ipairs({
		{ -118, 60, 20, 30, Enum.Material.Ground },
		{ -118, -50, 16, 26, Enum.Material.LeafyGrass },
		{ 118, 30, 18, 34, Enum.Material.Ground },
		{ 118, -80, 16, 24, Enum.Material.LeafyGrass },
		{ 50, 118, 30, 16, Enum.Material.Ground },
		{ -60, 118, 26, 14, Enum.Material.LeafyGrass },
		{ -108, 104, 24, 24, Enum.Material.Sand },
		{ 104, -108, 22, 22, Enum.Material.Sand },
	}) do
		patch(T, p[1], p[2], p[3], p[4], p[5])
	end
	-- 3) 유격장: 물웅덩이 둘레 진흙, 타잔 매트 밑 흙, 동선 따라 다져진 흙 길(파트 없는 땅길)
	patch(T, 110, -341, 54, 22, Enum.Material.Mud)
	patch(T, 185, -443, 20, 20, Enum.Material.Ground)
	for _, s in ipairs({
		{ Vector3.new(60, 0, -262), Vector3.new(70, 0, -280) },
		{ Vector3.new(82, 0, -341), Vector3.new(88, 0, -341) },
		{ Vector3.new(123, 0, -341), Vector3.new(134, 0, -341) },
		{ Vector3.new(134, 0, -341), Vector3.new(150, 0, -362) },
		{ Vector3.new(150, 0, -368), Vector3.new(150, 0, -380) },
		{ Vector3.new(150, 0, -380), Vector3.new(170, 0, -398) },
		{ Vector3.new(170, 0, -422), Vector3.new(185, 0, -424) },
		{ Vector3.new(185, 0, -467), Vector3.new(200, 0, -484) },
		{ Vector3.new(200, 0, -488), Vector3.new(200, 0, -524) },
	}) do
		trail(T, s[1], s[2], 6)
	end
	-- 4) 해변: 북쪽 해안 모래띠 + 수면 아래 얕은 모래 선반(물빛이 밝아진다) + 양옆·남쪽 모래띠 + 모래톱 섬
	T:FillBlock(CFrame.new(0, -4, -700), Vector3.new(330, 4, 22), Enum.Material.Sand)
	T:FillBlock(CFrame.new(0, -5, -718), Vector3.new(284, 2.4, 14), Enum.Material.Sand)
	T:FillBlock(CFrame.new(-150, -4, -890), Vector3.new(22, 4, 362), Enum.Material.Sand)
	T:FillBlock(CFrame.new(150, -4, -890), Vector3.new(22, 4, 362), Enum.Material.Sand)
	T:FillBlock(CFrame.new(0, -4, -1080), Vector3.new(330, 4, 22), Enum.Material.Sand)
	T:FillBlock(CFrame.new(0, -5, -1062), Vector3.new(284, 2.4, 14), Enum.Material.Sand)
	T:FillBlock(CFrame.new(105, -3.5, -1010), Vector3.new(28, 5, 22), Enum.Material.Sand) -- 모래톱 섬 (표면 y≈1)
	-- 4-1) 옛 갯벌 자리(M057 로 뺌) 풀 무늬 (마감 패스: Bootstrap 이 더는 Mud 를 채우지 않아 풀 덮기 줄은 지움)
	patch(T, 20, -580, 50, 40, Enum.Material.LeafyGrass)
	patch(T, 80, -650, 40, 50, Enum.Material.LeafyGrass)
	-- 5) 먼 언덕 (FillBall, 풀) + 비탈 풀 무늬·흙 자국(민둥산으로 보이지 않게) + 바위 봉우리
	for i, h in ipairs(HILLS) do
		T:FillBall(Vector3.new(h.x, h.cy, h.z), h.r, Enum.Material.Grass)
		local g = rng(4000 + i)
		for _ = 1, 2 do
			local a = g() * math.pi * 2
			local d = h.r * (0.3 + g() * 0.4)
			local px, pz = h.x + math.cos(a) * d, h.z + math.sin(a) * d
			local py = h.cy + math.sqrt(math.max(0, h.r ^ 2 - d ^ 2))
			T:FillBall(Vector3.new(px, py - h.r * 0.12, pz), h.r * (0.2 + g() * 0.12), Enum.Material.LeafyGrass)
		end
		local a2 = g() * math.pi * 2
		local d2 = h.r * 0.55
		T:FillBall(
			Vector3.new(
				h.x + math.cos(a2) * d2,
				h.cy + math.sqrt(h.r ^ 2 - d2 ^ 2) - h.r * 0.1,
				h.z + math.sin(a2) * d2
			),
			h.r * 0.12,
			Enum.Material.Ground
		)
		if h.rock then
			T:FillBall(Vector3.new(h.x, h.cy + h.r * 0.72, h.z), h.r * 0.34, Enum.Material.Rock)
			T:FillBall(
				Vector3.new(h.x + h.r * 0.25, h.cy + h.r * 0.55, h.z - h.r * 0.2),
				h.r * 0.22,
				Enum.Material.Slate
			)
		end
	end
	-- 6) 숲 바닥: 광장 둘레 흙 다짐 + 갈림길 흙 + 흙길 가장자리 띠(길 파트 10 보다 넓은 16)
	patch(T, -200, -300, 44, 44, Enum.Material.Ground)
	patch(T, -170, -890, 40, 30, Enum.Material.Ground)
	trail(T, Vector3.new(-189, 0, -286), Vector3.new(-130, 0, -200), 16)
	trail(T, Vector3.new(-130, 0, -200), Vector3.new(-50, 0, -120), 16)
	trail(T, Vector3.new(-130, 0, -200), Vector3.new(-60, 0, -206), 16)
	trail(T, Vector3.new(-60, 0, -206), Vector3.new(-50, 0, -120), 16)
	trail(T, Vector3.new(-50, 0, -120), Vector3.new(0, 0, -84), 16)
	trail(T, Vector3.new(-170, 0, -880), Vector3.new(-132, 0, -760), 14)
	trail(T, Vector3.new(-132, 0, -760), Vector3.new(-130, 0, -600), 14)
	trail(T, Vector3.new(-130, 0, -600), Vector3.new(-158, 0, -470), 14)
	trail(T, Vector3.new(-158, 0, -470), Vector3.new(-200, 0, -318), 14)
	trail(T, Vector3.new(0, 0, 74), Vector3.new(0, 0, 130), 18, Enum.Material.Ground, 0) -- 아치(z 70) 안쪽으로 번지지 않게(21_art_12)
end

-- ===== 빛·공기·물·구름·바람 (Bootstrap LOOK 뒤에 덮어쓴다. check() 의 LOOK 비교는 Bootstrap 값 기준이라 "다름" 이 뜰 수 있다 — 28 §7 인계) =====
local LIGHT = {
	ClockTime = 15.4, -- 늦은 오후: 긴 그림자, 따뜻한 역광
	Brightness = 2.15, -- 2.6 은 모래가 하얗게 날아갔다 (21_art 1차)
	ExposureCompensation = 0,
	Ambient = Color3.fromRGB(96, 92, 88),
	OutdoorAmbient = Color3.fromRGB(136, 140, 152), -- 하늘 반사(푸른 기) — 햇빛의 따뜻함과 대비
	ColorShift_Top = Color3.fromRGB(255, 236, 204),
	ColorShift_Bottom = Color3.fromRGB(118, 138, 170),
	EnvironmentDiffuseScale = 0.6,
	EnvironmentSpecularScale = 0.45,
	GlobalShadows = true,
	ShadowSoftness = 0.18,
	FogEnd = 100000,
} :: { [string]: any }
local ATMOS = {
	Density = 0.34,
	Offset = 0.3,
	Color = Color3.fromRGB(214, 206, 190),
	Decay = Color3.fromRGB(104, 124, 160), -- 먼 해안선이 푸르게 가라앉는다
	Glare = 0.15,
	Haze = 1.6,
} :: { [string]: any }
local GRADE = {
	Brightness = 0.02,
	Contrast = 0.14,
	Saturation = 0.14,
	TintColor = Color3.fromRGB(255, 249, 238),
} :: { [string]: any }
local BLOOM = { Intensity = 0.4, Size = 28, Threshold = 1.35 } :: { [string]: any }
local SUNRAYS = { Intensity = 0.08, Spread = 0.7 } :: { [string]: any }
local WATER = {
	WaterColor = Color3.fromRGB(34, 128, 190),
	WaterTransparency = 0.45,
	WaterReflectance = 0.45,
	WaterWaveSize = 0.18,
	WaterWaveSpeed = 12,
} :: { [string]: any }
local CLOUDS =
	{ Cover = 0.5, Density = 0.55, Color = Color3.fromRGB(255, 250, 244), Enabled = true } :: { [string]: any }
-- Terrain 재질 색 (SetMaterialColor): 풀은 조금 더 싱싱하게, 모래는 한 톤 눌러 햇빛에 날아가지 않게, 돌은 푸른 회색
-- (이 place 의 Slate 는 청록(63,127,107)으로 남아 있었다 — 옛 설정)
local TERRAIN_COLORS: { [Enum.Material]: Color3 } = {
	[Enum.Material.Grass] = Color3.fromRGB(104, 144, 66),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(124, 158, 72),
	[Enum.Material.Sand] = Color3.fromRGB(202, 184, 140),
	[Enum.Material.Ground] = Color3.fromRGB(158, 134, 94),
	[Enum.Material.Mud] = Color3.fromRGB(104, 88, 64),
	[Enum.Material.Rock] = Color3.fromRGB(130, 134, 140),
	[Enum.Material.Slate] = Color3.fromRGB(110, 118, 130),
}

local function setAll(inst: Instance, props: { [string]: any }): { string }
	local failed = {}
	for k, v in pairs(props) do
		local ok = pcall(function()
			(inst :: any)[k] = v
		end)
		if not ok then
			table.insert(failed, k)
		end
	end
	return failed
end

local function ensure(parent: Instance, className: string, name: string): Instance
	local e = parent:FindFirstChild(name)
	if e and e.ClassName == className then
		return e
	end
	local any = parent:FindFirstChildOfClass(className :: any)
	if any then
		any.Name = name
		return any
	end
	local n = Instance.new(className :: any)
	n.Name = name
	n.Parent = parent
	return n
end

-- 굽는 효과(Edit 에서 인스턴스로 심어 두면 클라이언트 코드 없이 보인다): 식당 굴뚝 연기
local function bakeEmitters(): number
	local count = 0
	local buildings = SceneBindings.getFolder("Buildings")
	local chimney = buildings and buildings:FindFirstChild("Mess_Chimney")
	if chimney and chimney:IsA("BasePart") then
		local e = chimney:FindFirstChild("ArtFx_Smoke") :: ParticleEmitter?
		if not e then
			e = Instance.new("ParticleEmitter")
			e.Name = "ArtFx_Smoke"
			e.Parent = chimney
		end
		local em = e :: ParticleEmitter
		em.Color = ColorSequence.new(Color3.fromRGB(226, 222, 214), Color3.fromRGB(160, 160, 164))
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4.5) })
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
		em.Lifetime = NumberRange.new(3, 4.5)
		em.Rate = 3
		em.Speed = NumberRange.new(1.5, 2.5)
		em.Acceleration = Vector3.new(1.2, 1.6, 0.6)
		em.SpreadAngle = Vector2.new(12, 12)
		em.Rotation = NumberRange.new(0, 360)
		em.RotSpeed = NumberRange.new(-20, 20)
		em.LightEmission = 0
		em.LightInfluence = 1
		em.EmissionDirection = Enum.NormalId.Top
		em:SetAttribute("ProjectId", PROJECT)
		count += 1
	end
	return count
end

function CampArt.lighting(): string
	local failed = setAll(Lighting, LIGHT)
	for _, f in ipairs(setAll(ensure(Lighting, "Atmosphere", "CampAtmosphere"), ATMOS)) do
		table.insert(failed, "Atmosphere." .. f)
	end
	for _, f in ipairs(setAll(ensure(Lighting, "ColorCorrectionEffect", "CampGrade"), GRADE)) do
		table.insert(failed, "Grade." .. f)
	end
	for _, f in ipairs(setAll(ensure(Lighting, "BloomEffect", "Bloom"), BLOOM)) do
		table.insert(failed, "Bloom." .. f)
	end
	local rays = ensure(Lighting, "SunRaysEffect", "CampSunRays")
	setAll(rays, SUNRAYS)
	for _, e in ipairs({ rays, Lighting:FindFirstChild("CampAtmosphere"), Lighting:FindFirstChild("CampGrade") }) do
		if e then
			e:SetAttribute("ProjectId", PROJECT)
		end
	end
	-- 피사계 심도는 끈다 (아이·폰)
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("DepthOfFieldEffect") then
			e.Enabled = false
		end
	end
	-- 물·풀·구름·바람·재질 색
	local T = workspace.Terrain
	for _, f in ipairs(setAll(T, WATER)) do
		table.insert(failed, "Terrain." .. f)
	end
	for m, c in pairs(TERRAIN_COLORS) do
		local ok = pcall(function()
			T:SetMaterialColor(m, c)
		end)
		if not ok then
			table.insert(failed, "Terrain색." .. m.Name)
		end
	end
	local okDeco = pcall(function()
		(T :: any).Decoration = true
	end)
	if not okDeco then
		table.insert(failed, "Terrain.Decoration(권한)")
	end
	local clouds = ensure(T, "Clouds", "CampClouds")
	setAll(clouds, CLOUDS)
	clouds:SetAttribute("ProjectId", PROJECT)
	workspace.GlobalWind = Vector3.new(6, 0, 3)
	local baked = bakeEmitters()
	return string.format(
		"CampArt 빛 %.1f시·공기·물·구름·바람 + 효과 %d%s",
		LIGHT.ClockTime,
		baked,
		if #failed > 0 then " (못 바꿈: " .. table.concat(failed, ", ") .. ")" else ""
	)
end

-- Bootstrap.check() 의 lookStatus 가 이 값을 기준으로 본다 (마감 패스: "LOOK 다름" 거짓 경보 없애기)
CampArt.LIGHT = LIGHT

return CampArt
]]></string>
