              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 설정: 자막, 움직임 줄이기, 소리(전체/효과/음악). 톱니 버튼(왼쪽 위). 서버에 저장.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local SettingsController = {}
local C2S = ProtocolTypes.ClientToServer

local gui = UiKit.screen("CampSettings", 45)
local gear = Instance.new("TextButton")
gear.Size = UDim2.fromOffset(48, 48)
-- Roblox 메뉴·채팅 버튼 바로 오른쪽, 위 막대 높이 가운데 (UiKit.topbar)
local function placeGear()
	local tb = UiKit.topbar()
	gear.Position = UDim2.fromOffset(tb.leftX + 8, math.max(4, math.floor((tb.height - 48) / 2)))
end
placeGear()
UiKit.LayoutChanged:Connect(placeGear)
gear.Text = "⚙️"
gear.TextSize = 24
gear.Font = UiKit.FontBold
gear.BackgroundColor3 = Palette.Olive
gear.TextColor3 = Palette.Cream
gear.BorderSizePixel = 0
UiKit.corner(gear, 12)
UiKit.stroke(gear, Palette.OliveDark, 2, 0.2)
gear.Parent = gui

local modal = UiKit.modal(gui, "Settings", 380)
modal.Visible = false
UiKit.pad(modal, 16)
UiKit.list(modal, nil, 8)
local title = UiKit.label(modal, "⚙️ 설정", 24, true)
title.LayoutOrder = 1

local function set(key: string, value: any)
	Net.request(C2S.SettingsRequest, { key = key, value = value })
end

local function toggle(label: string, key: string, order: number): TextButton
	local b = UiKit.button(modal, label, function()
		set(key, not (Net.setting(key) == true))
	end)
	b.LayoutOrder = order
	return b
end
local captions = toggle("", "captions", 2)
local reduced = toggle("", "reducedMotion", 3)
local quiet = toggle("", "quietHud", 4)

local function volumeRow(label: string, key: string, order: number): TextLabel
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 48)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	UiKit.list(row, Enum.FillDirection.Horizontal, 6)
	row.Parent = modal
	local l = UiKit.label(row, label, 16, true)
	l.Size = UDim2.fromScale(0.5, 1)
	l.AutomaticSize = Enum.AutomaticSize.None
	local minus = UiKit.button(row, "−", function()
		set(key, math.max(0, (tonumber(Net.setting(key)) or 0.5) - 0.1))
	end)
	minus.Size = UDim2.new(0.22, 0, 0, 48)
	local plus = UiKit.button(row, "+", function()
		set(key, math.min(1, (tonumber(Net.setting(key)) or 0.5) + 0.1))
	end)
	plus.Size = UDim2.new(0.22, 0, 0, 48)
	return l
end
local master = volumeRow("", "masterVolume", 5)
local sfx = volumeRow("", "sfxVolume", 6)
local mus = volumeRow("", "musicVolume", 7)
local closeBtn = UiKit.button(modal, "닫기", function()
	UiKit.closeThen(modal, function()
		modal.Visible = false
	end)
end, true)
closeBtn.LayoutOrder = 8

local function refresh()
	local function onOff(v: any): string
		return if v == true then "켬 ✅" else "끔"
	end
	captions.Text = "자막: " .. onOff(Net.setting("captions"))
	reduced.Text = "움직임 줄이기: " .. onOff(Net.setting("reducedMotion"))
	quiet.Text = "조용한 화면: " .. onOff(Net.setting("quietHud"))
	master.Text = string.format("🔊 전체 %d", math.floor((tonumber(Net.setting("masterVolume")) or 0) * 10 + 0.5))
	sfx.Text = string.format("🥁 효과 %d", math.floor((tonumber(Net.setting("sfxVolume")) or 0) * 10 + 0.5))
	mus.Text = string.format("🎵 음악 %d", math.floor((tonumber(Net.setting("musicVolume")) or 0) * 10 + 0.5))
end

function SettingsController.start()
	gear.Activated:Connect(function()
		refresh()
		modal.Visible = not modal.Visible
	end)
	Net.SnapshotChanged:Connect(refresh)
end

return SettingsController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000403</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6145">
            <Properties>
              <string name="Name">SquadPresence</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{D82CF01B-FB41-4057-B27E-78DCD12AA317}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 분대원 리그 머리 위 말풍선·이름표·기분 아이콘. 서버는 모델 속성(Bubble/BubbleToken/Mood)만 바꾼다.
-- 파트의 SignText 속성(명찰·번호판)은 SurfaceGui 로 글자를 그린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Palette = require(Shared:WaitForChild("Palette"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Net = require(script.Parent.Net)

local SquadPresence = {}

type Bubble = { gui: BillboardGui, label: TextLabel, token: number }
local bubbles: { [Model]: Bubble } = {}
local signed: { [BasePart]: boolean } = {}

-- 이름표 글: ● (셔츠 색) 이름 + 기분 아이콘
local function nameTag(model: Model, icon: string?): string
	local id = tostring(model:GetAttribute("MemberId") or "")
	local color = (Palette.Member :: any)[id] :: Color3?
	local dot = if color then string.format('<font color="#%s">●</font> ', color:ToHex()) else ""
	return dot .. tostring(model:GetAttribute("NameKo") or "") .. (icon or "")
end

local function ensureBubble(model: Model): Bubble?
	local existing = bubbles[model]
	if existing then
		return existing
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CampBubble"
	gui.Size = UDim2.fromOffset(220, 90)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 80
	gui.Adornee = head
	-- 이름표: 어두운 알약 + 셔츠 색 점 (19_UI_MAP_STYLE — 빨강은 누를 것에만 쓴다)
	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.AnchorPoint = Vector2.new(0.5, 1)
	name.Position = UDim2.fromScale(0.5, 1)
	name.AutomaticSize = Enum.AutomaticSize.X
	name.Size = UDim2.fromOffset(0, 22)
	name.BackgroundColor3 = Palette.UI.PanelBottom
	name.BackgroundTransparency = 0.2
	name.BorderSizePixel = 0
	name.Font = Enum.Font.GothamBold
	name.TextSize = 14
	name.TextColor3 = Palette.Cream
	name.RichText = true
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = name
	local np = Instance.new("UIPadding")
	np.PaddingLeft = UDim.new(0, 8)
	np.PaddingRight = UDim.new(0, 9)
	np.Parent = name
	name.Text = nameTag(model)
	name.Parent = gui
	local label = Instance.new("TextLabel")
	label.Name = "Bubble"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -26)
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Size = UDim2.fromOffset(0, 0)
	label.BackgroundColor3 = Palette.Cream
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Palette.Ink
	label.Text = ""
	label.Visible = false
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = label
	local c2 = Instance.new("UICorner")
	c2.CornerRadius = UDim.new(0, 10)
	c2.Parent = label
	local s = Instance.new("UIStroke")
	s.Color = Palette.Ink
	s.Thickness = 1.5
	s.Transparency = 0.4
	s.Parent = label
	label.Parent = gui
	gui.Parent = head
	local b: Bubble = { gui = gui, label = label, token = 0 }
	bubbles[model] = b
	return b
end

local function showBubble(model: Model, text: string, seconds: number)
	local b = ensureBubble(model)
	if not b then
		return
	end
	b.label.Text = text
	b.label.Visible = true
	b.token += 1
	local tok = b.token
	task.delay(seconds, function()
		if b.token == tok then
			b.label.Visible = false
		end
	end)
end

local function watchModel(model: Model)
	if model:GetAttribute("ProjectId") ~= SceneBindings.ProjectId then
		return
	end
	ensureBubble(model)
	model:GetAttributeChangedSignal("BubbleToken"):Connect(function()
		local text = model:GetAttribute("Bubble")
		if typeof(text) == "string" and #text > 0 then
			showBubble(model, text, tonumber(model:GetAttribute("BubbleSec")) or 2)
		end
	end)
	model:GetAttributeChangedSignal("Mood"):Connect(function()
		local b = bubbles[model]
		local mood = model:GetAttribute("Mood")
		if b then
			local nameLabel = b.gui:FindFirstChild("Name") :: TextLabel?
			if nameLabel then
				-- 밤 역할 (28 §4, 1단계): 두리 불 · 산 짐 · 미르 그림
				local icon = if mood == "WAIT"
					then " 😟"
					elseif mood == "HAPPY" then " 😄"
					elseif mood == "SCARED" then " 😣"
					elseif mood == "ROLE_FIRE" then " 🔥"
					elseif mood == "ROLE_PACK" then " 🎒"
					elseif mood == "ROLE_DRAW" then " 🖍️"
					elseif mood == "DOWN" then " 🤝" -- 살리기 (2단계): 넘어짐 🤝 E · 얼음 ❄️
					elseif mood == "FROZEN" then " ❄️"
					elseif mood == "OFFER" then " 🎁" -- 꾸미기 (3단계): 들고 와 내미는 중 (E 받기)
					elseif
						mood == "HANGING"
					then " ➰" -- 탑승 (4·5단계): 배 뒤 밧줄에 매달림 (E 끌어올리기)
					else ""
				nameLabel.Text = nameTag(model, icon)
			end
		end
	end)
end

-- 표지(SignText): 파트 앞면에 글자
local function ensureSign(part: BasePart)
	if signed[part] then
		return
	end
	signed[part] = true
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	local big = Instance.new("TextLabel")
	big.Size = UDim2.fromScale(1, if part:GetAttribute("SignSub") then 0.62 else 1)
	big.BackgroundTransparency = 1
	big.Font = Enum.Font.GothamBlack
	big.TextScaled = true
	big.TextColor3 = if part:GetAttribute("SignLight") == true then Palette.Cream else Palette.Ink
	big.Text = tostring(part:GetAttribute("SignText") or "")
	big.Parent = gui
	local subText = part:GetAttribute("SignSub")
	if subText then
		local sub = Instance.new("TextLabel")
		sub.Size = UDim2.fromScale(1, 0.3)
		sub.Position = UDim2.fromScale(0, 0.66)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.TextColor3 = big.TextColor3
		sub.Text = tostring(subText)
		sub.Parent = gui
	end
	gui.Parent = part
	-- 양면 표지
	if part:GetAttribute("SignBothSides") == true then
		local back = gui:Clone()
		back.Face = Enum.NormalId.Back
		back.Parent = part
	end
end

-- 스티커: 이모지 한 글자
local function ensureSticker(part: BasePart)
	if signed[part] then
		return
	end
	signed[part] = true
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextScaled = true
	l.Text = tostring(part:GetAttribute("StickerEmoji") or "⭐")
	l.Parent = gui
	gui.Parent = part
end

local function scan(root: Instance)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("Model") and d:GetAttribute("MemberId") then
			if not bubbles[d] then
				watchModel(d)
			end
		elseif d:IsA("BasePart") then
			if d:GetAttribute("SignText") ~= nil then
				ensureSign(d)
			elseif d:GetAttribute("StickerEmoji") ~= nil then
				ensureSticker(d)
			end
		end
	end
end

-- 내 소대 분대원 말풍선 (자막과 함께). 다른 소대는 서버 속성으로만
function SquadPresence.say(memberId: string, text: string, seconds: number)
	local folder = SceneBindings.getFolder("Runtime")
	local holder = folder and folder:FindFirstChild("CampSquads")
	local mine = holder and holder:FindFirstChild("Squad_" .. Net.boatOwnerId())
	local model = mine and mine:FindFirstChild("Npc_" .. memberId)
	if model and model:IsA("Model") then
		showBubble(model, text, seconds)
	end
end

function SquadPresence.start()
	task.spawn(function()
		while true do
			scan(workspace)
			task.wait(3)
		end
	end)
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and (d:GetAttribute("SignText") ~= nil or d:GetAttribute("StickerEmoji") ~= nil) then
			task.defer(function()
				if d:GetAttribute("SignText") ~= nil then
					ensureSign(d)
				else
					ensureSticker(d)
				end
			end)
		end
	end)
	local _ = CollectionService
end

return SquadPresence
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000404</UniqueId>
