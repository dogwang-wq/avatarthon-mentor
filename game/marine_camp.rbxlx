	AutoDepartSec = 60, -- 이만큼 지나면 교관 "출발!" 하고 간다
	PromptHold = 0, -- 집기·싣기는 바로 (길게 누르기 없음)
	EntryKeepStuds = 12, -- 걸어 들어온 아이가 입구에서 이 안이면 순간이동하지 않는다 (첫 1분: 걸어온 길이 끊기지 않게)
	HintPickAfterSec = 12, -- 아직 더미에서 직접 집지 않았으면 두리 내밀기가 끝날 때(늦어도 이만큼 뒤) 안내 한 줄
}

