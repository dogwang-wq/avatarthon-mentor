          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 게임 속 모든 글. 기준: docs/design/05_VOICE.md (Rob_mind 14·17). 교훈 문장 없음, 조사 괄호 없음, 20자 안팎.
-- who: KANG(강찬 교관) | DURI | SAN | MIR | SYSTEM(안내) | TRACE(흔적 살펴보기)
-- 6단계(2026-10-21): 옛 운반·박자·갈림길·레이스 글을 지웠다 (git 역사에 남음). 조작은 걷기·점프·E 셋 (27 §1)
local CampScript = {}

export type Line = { who: string, text: string, sec: number? }

CampScript.Title = "🧢 한 배 타자! 해병대 극기캠프 [4박 5일]" -- 2026-10-20: 갯벌(3일차)을 뺌 (v2, 22)
CampScript.Motto = "한 배 타자!"

-- ===== 첫 입소 (01_CONCEPT §7 · 6단계: 첫 들기 연습 없음 — 아래 출발 버튼 → 1일차 유보트 꾸미기) =====
CampScript.Intro = {
	{ who = "KANG", text = "한 배 타자! 악!", sec = 2.5 },
	{ who = "SYSTEM", text = "🚩 아래 출발 버튼을 눌러 보세요!", sec = 3.5 },
} :: { Line } -- GameConfig.Welcome.Enabled = false 일 때만 (첫 1분은 아래 Welcome)

-- ===== 첫 1분 (28 §7, 2026-10-21 · WelcomeService): 1일차 전 기지 → 꾸미기 마당. 글 대신 분대원이 먼저 달려가 손 흔든다 =====
CampScript.Welcome = {
	kang = { who = "KANG", text = "소대! 한 배 타자!", sec = 2.2 }, -- 첫 입소 구호 (코믹하게 짧게)
	ak = "악!", -- 분대원 셋 말풍선 (동시에)
	there = "여기야! 우리 배!", -- 두리: 입구에 닿아 손 흔들며
	-- 오래 안 오면 9초마다 한 명씩 (재촉·벌 아님. 미르는 첫 3일 말이 거의 없다 — 05_VOICE)
	nudge = {
		{ who = "DURI", text = "이쪽이야! 노란 화살표!" },
		{ who = "SAN", text = "…와" },
		{ who = "MIR", text = "…(손 흔듦)" },
		{ who = "DURI", text = "배 꾸미자! 빨리 와" },
	} :: { { who: string, text: string } },
}

-- 조작 카드 한 장 (왼쪽 위 압정 쪽지): 기기마다 다른 글 — 키 이름 바꾸기(KoreanText.keysFor)에 기대지 않는다
CampScript.Tutorial = {
	{
		title = "🎮 조작은 셋!",
		body = "🚶 WASD 걷기 · ⤴ Space 점프 · ✋ E 하기",
		bodyTouch = "🚶 막대로 걷기 · ⤴ 점프 버튼 · ✋ 탭 버튼",
		bodyPad = "🚶 왼쪽 스틱 걷기 · ⤴ Ⓐ 점프 · ✋ Ⓧ 하기",
	},
}

-- ===== 날 시작 (강찬 교관). 1일차는 CampScript.Build.start → Ride.dayStart[1], 4일차는 Ride.dayStart[4] =====
