	GiveMorale = 0.15, -- 나눠 받은 분대원 사기
	NpcPickRadius = 10, -- 분대원이 제 자리 근처 이 안의 줍을 것을 하나 집는다 (하루 한 번)
	NpcPickEverySec = 2, -- 분대원 줍기 검사 간격
	DuriLogEverySec = 12, -- 두리가 장작을 넣는(시늉) 간격
	DuriFirstSec = 25, -- 두리가 처음 장작을 집는 때 (아이가 먼저 넣을 틈)
	DuriFeedsMax = 2, -- 두리가 아이 주머니에서 대신 넣는 장작 최대 (아이가 안 해도 불은 커지지만 "결과가 작다" — 27 §5)
	SanUnpackSec = 20, -- 산이 짐을 풀고 간식을 나누는 때
	MirDrawSec = 25, -- 미르가 유보트에 그림(스티커)을 남기는 때
	CloseRadius = 4.4, -- 큰 불이면 분대원이 이만큼 가까이 (아니면 5.6)
	FarRadius = 5.6,
	PromptCustom = true, -- true 면 ProximityPrompt Style=Custom (PromptController 가 그린다). 2026-10-21 2단계에서 켬 (PromptController Studio 확인 뒤)
}

-- 살리기 (27 §3 · 28, 2026-10-21 2단계): 분대원이 넘어지고(2·6일차 유격) 언다(5일차 탐조등, 나도). E 일으키기/풀기. 전부 "막지 않는다":
-- 안 일으켜도 10초면 스스로 일어나고, 아무도 안 풀어도 5초면 풀린다. 깃발·도착은 그대로 된다. 점수·벌 없음
