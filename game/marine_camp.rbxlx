            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003f6</UniqueId>
          </Properties>
          <Item class="ModuleScript" referent="6132">
            <Properties>
              <string name="Name">AudioController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{8CEF3C00-42C6-47C4-BA00-2E101803438E}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- FxCue → 소리(있으면) + 상태별 음악(1.2초 엇갈려 바뀜) + 환경음 겹. 소리 없이도 같은 정보가 화면에 있다 (CourseFx·RideFx·CampHud).
-- 2026-10-21 소리 패스: 27 계획 새 장면(꾸미기·급류·모닥불·살리기·바다·탐조등·탈출 문)에 맞는 음원으로 바꿈 (28 §7).
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local AudioCueMap = require(Shared:WaitForChild("AudioCueMap"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Net = require(script.Parent.Net)

local AudioController = {}
local S = ProtocolTypes.SessionState

local MUSIC_FADE = 1.2
local AMB_FADE = 2
local SPATIAL_MIN = 20 -- 이 거리까지는 3D 소리도 그대로 큼 (카메라가 멀어도 안 놓치게)
local SPATIAL_MAX = 160
local FIRE_MAX = 40 -- 모닥불 타닥: 40 스터드 밖에선 안 들림

local volumes = {
	master = AudioCueMap.MasterDefault,
	SFX = AudioCueMap.Buses.SFX,
	SENSORY = AudioCueMap.Buses.SENSORY,
	MUSIC = AudioCueMap.Buses.MUSIC,
}
local lastPlayed: { [string]: number } = {}
local active: { Sound } = {}
local music: Sound? = nil
local musicId = ""
local musicFadeUntil = 0 -- 엇갈림 중엔 스냅숏이 볼륨을 덮어쓰지 않게
local ambience: { [string]: Sound } = {}
local ambMul: { [string]: number } = {} -- 환경음마다 덧곱 (급류는 배 속도)
local ambFadeUntil: { [string]: number } = {}
local fires: { [BasePart]: Sound } = {}
local group = Instance.new("SoundGroup")
group.Name = "CampSfx"
group.Parent = SoundService

local function gainFor(cue: AudioCueMap.Cue): number
	if RunService:IsStudio() and workspace:GetAttribute("Camp_DevMute") == true then
		return 0
	end
	return volumes.master * ((volumes :: any)[cue.bus] or 1) * cue.gain
end

-- 3D 소리 자리: 보이지 않는 Attachment 를 Terrain 에 (소리가 끝나면 같이 지움)
local function spatialHost(pos: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = "CampSfxAt"
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	return a
end

local function play(cueId: string, pos: Vector3?)
	local cue = AudioCueMap.get(cueId)
	if not cue or cue.assetId == "" then
		return
	end
	local now = os.clock()
	if (lastPlayed[cueId] or -math.huge) + cue.cooldownSec > now then
		return
	end
	for i = #active, 1, -1 do
		if not active[i].Parent or not active[i].IsPlaying then
			table.remove(active, i)
		end
	end
	if #active >= AudioCueMap.MaxVoices then
		return
	end
	lastPlayed[cueId] = now
	local s = Instance.new("Sound")
	s.SoundId = cue.assetId
	s.Volume = gainFor(cue)
	s.SoundGroup = group
	local host: Attachment? = nil
	if cue.spatial and pos then
		host = spatialHost(pos)
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = SPATIAL_MIN
		s.RollOffMaxDistance = SPATIAL_MAX
		s.Parent = host
	else
		s.Parent = SoundService
	end
	local function cleanup()
		s:Destroy()
		if host then
			host:Destroy()
		end
	end
	s.Ended:Once(cleanup)
	if cue.startAt then
		s.TimePosition = cue.startAt
	end
	s:Play()
	table.insert(active, s)
	local maxSec = cue.maxSec
	if maxSec then
		task.delay(maxSec, function()
			if s.Parent then
				TweenService:Create(s, TweenInfo.new(0.25), { Volume = 0 }):Play()
				task.delay(0.3, cleanup)
			end
		end)
	end
end

local function setMusic(cueId: string)
	if musicId == cueId then
		return
	end
	musicId = cueId
	local old = music
	if old then
		TweenService:Create(old, TweenInfo.new(MUSIC_FADE), { Volume = 0 }):Play()
		task.delay(MUSIC_FADE + 0.1, function()
			old:Destroy()
		end)
		music = nil
	end
	local cue = AudioCueMap.get(cueId)
	if not cue or cue.assetId == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = cue.assetId
	s.Looped = true
	s.Volume = 0
	s.SoundGroup = group
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(MUSIC_FADE), { Volume = gainFor(cue) }):Play()
	musicFadeUntil = os.clock() + MUSIC_FADE + 0.05
	music = s
end

local function setAmbience(wanted: { [string]: boolean })
	for id, s in pairs(ambience) do
		if not wanted[id] then
			TweenService:Create(s, TweenInfo.new(AMB_FADE), { Volume = 0 }):Play()
			task.delay(AMB_FADE + 0.1, function()
				s:Destroy()
			end)
			ambience[id] = nil
		end
	end
	for id in pairs(wanted) do
		if not ambience[id] then
			local cue = AudioCueMap.get(id)
			if cue and cue.assetId ~= "" then
				local s = Instance.new("Sound")
				s.SoundId = cue.assetId
				s.Looped = true
				s.Volume = 0
				s.SoundGroup = group
				s.Parent = SoundService
				s:Play()
				TweenService:Create(s, TweenInfo.new(AMB_FADE), { Volume = gainFor(cue) * (ambMul[id] or 1) }):Play()
				ambFadeUntil[id] = os.clock() + AMB_FADE + 0.05
				ambience[id] = s
			end
		end
	end
end

-- 밤 모닥불 (Triggers 의 Kind=FIRE 파트, 오늘 Day): 그 자리에 3D 타닥 소리. FireLevel 0..3 으로 크기
local function fireGain(part: BasePart): number
	local cue = AudioCueMap.get("AMB_FIRE")
	if not cue then
		return 0
	end
	local lv = tonumber(part:GetAttribute("FireLevel")) or 0
	return gainFor(cue) * (0.3 + 0.7 * math.clamp(lv, 0, 3) / 3)
end

local function setFires(on: boolean, day: number)
	local cue = AudioCueMap.get("AMB_FIRE")
	local want: { [BasePart]: boolean } = {}
	if on and cue and cue.assetId ~= "" then
		local f = SceneBindings.getFolder("Triggers")
		if f then
			local all: { BasePart } = {}
			for _, c in ipairs(f:GetChildren()) do
				if c:IsA("BasePart") and c:GetAttribute("Kind") == "FIRE" then
					table.insert(all, c)
					if c:GetAttribute("Day") == day then
						want[c] = true
					end
				end
			end
			if next(want) == nil then -- 날 속성이 안 맞으면 모든 불 자리에
				for _, c in ipairs(all) do
					want[c] = true
				end
			end
		end
	end
	for part, s in pairs(fires) do
		if not want[part] or not part.Parent then
			TweenService:Create(s, TweenInfo.new(AMB_FADE), { Volume = 0 }):Play()
			task.delay(AMB_FADE + 0.1, function()
				s:Destroy()
			end)
			fires[part] = nil
		end
	end
	for part in pairs(want) do
		local s = fires[part]
		if not s and cue then
			local ns = Instance.new("Sound")
			ns.Name = "CampFireCrackle"
			ns.SoundId = cue.assetId
			ns.Looped = true
			ns.Volume = 0
			ns.RollOffMode = Enum.RollOffMode.InverseTapered
			ns.RollOffMinDistance = 6
			ns.RollOffMaxDistance = FIRE_MAX
			ns.SoundGroup = group
			ns.Parent = part
			ns:Play()
			fires[part] = ns
			s = ns
		end
		local target = fireGain(part)
		if s and math.abs(s.Volume - target) > 0.02 and os.clock() > (s:GetAttribute("FadeUntil") or 0) then
			TweenService:Create(s, TweenInfo.new(0.8), { Volume = target }):Play()
			s:SetAttribute("FadeUntil", os.clock() + 0.85)
		end
	end
end

-- FxCue 종류 → 소리. 표에 없는 종류는 조용 (화면 연출만)
local FX_TO_CUE = {
	CP = "SFX_CP",
	STICKER = "SFX_STICKER",
	BELL = "SFX_BELL",
	CANDLES = "SFX_CANDLE",
	SEALED = "SFX_CANDLE",
	GRADUATE = "SFX_CANDLE",
	FLAG = "SFX_BELL", -- 자유 스테이지 깃발 (22 v2)
	FALL_ASSIST = "SFX_SUPPORT", -- 유격: 산이 손 잡아 다음 발판으로 (20)
	FALL = "SFX_COMIC_OOPS", -- 내가 미끄러짐: 코믹 한 방 (벌 아님)
	-- 6일차 탈출 문 사격: 맞으면 "펑", 빗나가면 스티로폼 삐끗, 문 열리면 삐걱 + 다 같이 "예!"
	TARGET_HIT = "SFX_TARGET_POP",
	TARGET_MISS = "SFX_BEAT_MISS",
	GATE_OPEN = "SFX_GATE_CREAK",
	-- 5일차 탐조등
	SPOTTED = "SFX_SPOTTED",
	FLASHLIGHT = "SFX_TICK",
	-- 모닥불 허브 (1단계)
	PICKUP = "SFX_PICKUP",
	FIRE_FEED = "SFX_FIRE_WHOOSH",
	FIRE_LEVEL = "SFX_FIRE_UP",
	GIVE = "SFX_GIVE",
	-- 살리기 (2단계): 넘어짐 쿵 + 코믹 피치카토, 일으키기 퉁김, 얼음 짤랑, 땡 딩
	FALL_NPC = "SFX_NPC_FALL",
	REVIVE = "SFX_REVIVE",
	FREEZE = "SFX_FREEZE",
	THAW = "SFX_THAW",
	-- 유보트 꾸미기 (3단계)
	ATTACH = "SFX_ATTACH",
	PICK = "SFX_PICKUP",
	OFFER = "SFX_OFFER",
	-- 탑승 (4·5단계)
	SPLASH = "SFX_SPLASH_BIG",
	WAVE = "SFX_SPLASH",
	WAVE_WARN = "SFX_WAVE_WARN",
	BUMP = "SFX_BUMP",
	SCRAPE = "SFX_SCRAPE", -- 늦게 비껴감: 고무 긁힘 작게 (+ 첨벙, FX_THEN)
	-- RIDE_ITEM 은 넣지 않는다: RideFx 가 건진 물건이 배에 닿을 때 SFX_PICKUP 을 직접 부름 (여기 넣으면 두 번)
	DODGE = "SFX_WHOOSH",
	BRANCH = "SFX_SUPPORT",
	WATERFALL = "SFX_WATERFALL",
	WHEE = "SFX_WHOOSH",
	HANG = "SFX_SUPPORT",
	RESCUE = "SFX_LIFT",
	BOARDED = "SFX_LAND",
	RIDE_START = "SFX_CHEER",
	FINISH = "SFX_CP",
}
-- 소리 다음 소리 (after 초 뒤)
local FX_THEN: { [string]: { cue: string, after: number } } = {
	FALL_NPC = { cue = "SFX_COMIC_OOPS", after = 0.12 }, -- 쿵 다음 "어이쿠" 피치카토
	RESCUE = { cue = "SFX_CHEER", after = 0.55 }, -- 끌어올리면 다 같이 "예!"
	GATE_OPEN = { cue = "SFX_CHEER", after = 0.9 },
	FINISH = { cue = "SFX_CHEER", after = 0.4 },
	ATTACH = { cue = "SFX_STICKER", after = 0.05 }, -- 놓는 탁 + 천 스침
	SCRAPE = { cue = "SFX_STROKE", after = 0.08 }, -- 긁힌 뒤 작은 첨벙
}
-- 조용히 하라는 표지(quiet)가 있는 FX 는 소리 없음 (예: 시간 끝나 저절로 풀림)
local function isQuiet(c: { [string]: any }): boolean
	return c.quiet == true
end

-- 다른 컨트롤러가 바로 소리 하나 (사격 "뽁" 등 — 서버 큐를 기다리지 않는 손맛). pos 를 주면 3D
function AudioController.play(cueId: string, pos: Vector3?)
	play(cueId, pos)
end

local function musicFor(snap: any, s: string): string
	if s == S.RIDE then
		return if snap.ride and snap.ride.kind == "SEA" then "MUS_SEA" else "MUS_RIDE"
	elseif s == S.OBBY then
		if snap.day == 5 then
			return "MUS_STEALTH"
		end
		local kr = AudioCueMap.get("MUS_MARCH_KR")
		return if kr and kr.assetId ~= "" then "MUS_MARCH_KR" else "MUS_COURSE"
	elseif s == S.NIGHT then
		return "MUS_CAMPFIRE"
	elseif s == S.LETTER then
		return "MUS_NIGHT"
	elseif s == S.GRADUATE then
		return "MUS_GRADUATE"
	end
	return "MUS_CAMP" -- CAMP·BUILD·TRAINING·LOADING
end

function AudioController.start()
	Net.FxCue:Connect(function(c)
		if c.kind == "HIT" then
			if c.memberId == "ME" or (Net.isGuest() and c.memberId == (Net.Snapshot :: any).coop.memberId) then
				play(
					if c.quality == "GOOD"
						then "SFX_BEAT_GOOD"
						elseif c.quality == "OK" then "SFX_BEAT_OK"
						else "SFX_BEAT_MISS"
				)
			end
			return
		end
		if isQuiet(c :: any) then
			return
		end
		local pos: Vector3? = if typeof(c.pos) == "Vector3" then c.pos else nil
		local id = (FX_TO_CUE :: any)[c.kind]
		if id then
			play(id, pos)
		end
		local later = FX_THEN[c.kind]
		if later then
			task.delay(later.after, play, later.cue, pos)
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		volumes.master = tonumber(snap.settings.masterVolume) or volumes.master
		volumes.SFX = tonumber(snap.settings.sfxVolume) or volumes.SFX
		volumes.MUSIC = tonumber(snap.settings.musicVolume) or volumes.MUSIC
		local st = snap.state
		local host = if snap.coop and snap.coop.role == "GUEST" then snap.coop.hostState else nil
		local s = host or st
		setMusic(musicFor(snap, s))

		local wanted: { [string]: boolean } = {}
		local ride = (snap :: any).ride
		if st == S.NIGHT or st == S.LETTER or (snap.day == 5 and s == S.OBBY) then -- 밤·편지·5일차 야간 침투
			wanted.AMB_NIGHT = true
		elseif s == S.RIDE then
			if ride and ride.kind == "SEA" then -- 바다: 파도 + 바람 한 겹
				wanted.AMB_OCEAN = true
				wanted.AMB_SEA = true
			else -- 급류: 물살, 배가 빠를수록 크게 (서 있을 때 60%)
				wanted.AMB_RAPIDS = true
				local sp = if ride then tonumber(ride.speed) or 0 else 0
				ambMul.AMB_RAPIDS = 0.6 + 0.4 * math.clamp(sp / GameConfig.Ride.RapidsSpeed, 0, 1.3)
			end
		elseif s == S.CAMP or s == S.BUILD or s == S.GRADUATE or s == S.TRAINING then -- 연병장: 숲 + 바람
			wanted.AMB_FOREST = true
			wanted.AMB_WIND = true
		else
			wanted.AMB_FOREST = true
		end
		setAmbience(wanted)
		-- 이미 켜진 환경음도 볼륨 설정·음소거·속도를 따른다
		for id, amb in pairs(ambience) do
			local acue = AudioCueMap.get(id)
			if acue and wanted[id] and os.clock() > (ambFadeUntil[id] or 0) then
				amb.Volume = gainFor(acue) * (ambMul[id] or 1)
			end
		end
		setFires(st == S.NIGHT, tonumber(snap.day) or 0)
		if music and os.clock() > musicFadeUntil then
			local cue = AudioCueMap.get(musicId)
			if cue then
				music.Volume = gainFor(cue)
			end
		end
	end)
end

return AudioController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003f7</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6133">
            <Properties>
              <string name="Name">BeatHud</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{8C2AB0FA-552C-4F06-9BDE-6E94E33DA374}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 체력단련장 박자 기구 HUD (07_PHASE2 §3 · 10_TAP_ONLY) — 6단계부터 박자는 기지 체력단련장에서만 쓴다 (낮 작전은 걷기·점프·E 셋, 27 §1).
-- 참고: Funky Friday·리듬 게임의 "받침대(receptor)" — 키가 실제 키보드 순서대로 있고, 음표가 그 키 색으로 흘러와 받침대에 닿을 때 누른다.
--   [A ◀] 파랑  ·  [Space] 빨강  ·  [▶ D] 파랑      빨간 점 = Space 탭 · 금색 "악!" 점 = Space 탭 · 빈칸 = 쉬기 · 파란 A/D 점 = 트랙 발
-- 왼쪽 아래: 기구 이름 + 진행 막대 + 맞힌 수 (사격장도 이 칸만 쓴다 — 쏘기는 RangeController)
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local BeatPatterns = require(Shared:WaitForChild("BeatPatterns"))
local TrainingCatalog = require(Shared:WaitForChild("TrainingCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local InputController = require(script.Parent.InputController)

local BeatHud = {}
local S = ProtocolTypes.SessionState

local RED = Palette.Red
local BLUE = Color3.fromHex("2F7FC1")
local GOLD = Color3.fromHex("F2B636")
local GOOD = Color3.fromHex("5BBF6A")

local gui = UiKit.screen("CampBeatHud", 20)
gui.Enabled = false

-- ===================== 아래 가운데: 박자 길 + 한 줄 안내 + 키 받침대 =====================
local panel = UiKit.panel(gui, "BeatBar", UDim2.fromOffset(520, 150), UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1))
local panelScale = Instance.new("UIScale")
panelScale.Scale = 0.82
panelScale.Parent = panel

local prompt = UiKit.label(panel, "", 21, true, Palette.Cream)
prompt.AnchorPoint = Vector2.new(0.5, 0)
prompt.Position = UDim2.new(0.5, 0, 0, 10)
prompt.Size = UDim2.new(1, -20, 0, 26)
prompt.AutomaticSize = Enum.AutomaticSize.None
prompt.TextXAlignment = Enum.TextXAlignment.Center
prompt.TextStrokeColor3 = Palette.Ink
prompt.TextStrokeTransparency = 0.45

local lane = Instance.new("Frame")
lane.Name = "Lane"
lane.AnchorPoint = Vector2.new(0.5, 0)
lane.Position = UDim2.new(0.5, 0, 0, 42)
lane.Size = UDim2.new(1, -30, 0, 38)
lane.BackgroundColor3 = Palette.OliveDark
lane.BorderSizePixel = 0
UiKit.corner(lane, 19)
lane.Parent = panel
-- 받침대: 음표가 여기 닿을 때 누른다 (가운데)
local receptor = Instance.new("Frame")
receptor.Name = "Receptor"
receptor.AnchorPoint = Vector2.new(0.5, 0.5)
receptor.Position = UDim2.fromScale(0.5, 0.5)
receptor.Size = UDim2.fromOffset(46, 46)
receptor.BackgroundTransparency = 1
receptor.Parent = lane
UiKit.corner(receptor, 99)
UiKit.stroke(receptor, Palette.Cream, 3, 0.15)

type Note = { frame: Frame, text: TextLabel, stroke: UIStroke }
local notes: { Note } = {}
for i = 1, 10 do
	local f = Instance.new("Frame")
	f.Name = "Note" .. i
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(28, 28)
	f.BorderSizePixel = 0
	f.Visible = false
	UiKit.corner(f, 99)
	local st = UiKit.stroke(f, Palette.Cream, 2, 0.4)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = UiKit.FontBlack
	t.TextSize = 14
	t.TextColor3 = Palette.Cream
	t.Text = ""
	t.Parent = f
	f.Parent = lane
	table.insert(notes, { frame = f, text = t, stroke = st })
end

local judge = UiKit.label(panel, "", 22, true, GOOD)
judge.AnchorPoint = Vector2.new(0.5, 1)
judge.Position = UDim2.new(0.5, 0, 0, -4)
judge.Size = UDim2.fromOffset(200, 28)
judge.AutomaticSize = Enum.AutomaticSize.None
judge.TextXAlignment = Enum.TextXAlignment.Center
judge.TextStrokeTransparency = 0.4
judge.TextStrokeColor3 = Palette.Ink
judge.Visible = false

-- 키 받침대 줄 (PC): [A] [Space] [D] 키보드 순서 그대로
type Key = { box: Frame, stroke: UIStroke, scale: UIScale, label: TextLabel, wrap: Frame }
local keyRow = Instance.new("Frame")
keyRow.Name = "Keys"
keyRow.AnchorPoint = Vector2.new(0.5, 1)
keyRow.Position = UDim2.new(0.5, 0, 1, -6)
keyRow.Size = UDim2.new(1, -20, 0, 58)
keyRow.BackgroundTransparency = 1
keyRow.Parent = panel
local kl = Instance.new("UIListLayout")
kl.FillDirection = Enum.FillDirection.Horizontal
kl.HorizontalAlignment = Enum.HorizontalAlignment.Center
kl.VerticalAlignment = Enum.VerticalAlignment.Top
kl.Padding = UDim.new(0, 18)
kl.SortOrder = Enum.SortOrder.LayoutOrder
kl.Parent = keyRow
local function key(order: number, text: string, width: number, color: Color3): Key
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.fromOffset(math.max(width, 70), 58)
	wrap.BackgroundTransparency = 1
	wrap.LayoutOrder = order
	wrap.Parent = keyRow
	local box = Instance.new("Frame")
	box.AnchorPoint = Vector2.new(0.5, 0)
	box.Position = UDim2.fromScale(0.5, 0)
	box.Size = UDim2.fromOffset(width, 36)
	box.BackgroundColor3 = color
	box.BorderSizePixel = 0
	UiKit.corner(box, 8)
	local st = UiKit.stroke(box, Palette.Cream, 2, 0.75)
	local sc = Instance.new("UIScale")
	sc.Parent = box
	-- 키 윗면 느낌: 아래 짙은 턱
	local lip = Instance.new("Frame")
	lip.AnchorPoint = Vector2.new(0.5, 1)
	lip.Position = UDim2.fromScale(0.5, 1)
	lip.Size = UDim2.new(1, 0, 0, 5)
	lip.BackgroundColor3 = Palette.Ink
	lip.BackgroundTransparency = 0.6
	lip.BorderSizePixel = 0
	UiKit.corner(lip, 4)
	lip.Parent = box
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = UiKit.FontBlack
	t.TextSize = 18
	t.TextColor3 = Palette.Cream
	t.Text = text
	t.Parent = box
	box.Parent = wrap
	return { box = box, stroke = st, scale = sc, label = t, wrap = wrap }
end
local keyA = key(1, "◀ A", 64, BLUE)
local keySpace = key(2, "Space", 150, RED)
local keyD = key(3, "D ▶", 64, BLUE)

-- ===================== 왼쪽 아래: 기구 칸 =====================
local trainPanel = UiKit.panel(gui, "Train", UDim2.fromOffset(220, 110), UDim2.new(0, 16, 1, -16), Vector2.new(0, 1))
local trainTitle = UiKit.label(trainPanel, "", 20, true, Palette.Cream)
trainTitle.Position = UDim2.fromOffset(14, 12)
trainTitle.Size = UDim2.new(1, -28, 0, 26)
trainTitle.AutomaticSize = Enum.AutomaticSize.None
local trainBarBg = Instance.new("Frame")
trainBarBg.Position = UDim2.fromOffset(14, 48)
trainBarBg.Size = UDim2.new(1, -28, 0, 14)
trainBarBg.BackgroundColor3 = Palette.OliveDark
trainBarBg.BorderSizePixel = 0
UiKit.corner(trainBarBg, 7)
trainBarBg.Parent = trainPanel
local trainBar = Instance.new("Frame")
trainBar.Size = UDim2.fromScale(0, 1)
trainBar.BackgroundColor3 = Palette.Yellow
trainBar.BorderSizePixel = 0
UiKit.corner(trainBar, 7)
trainBar.Parent = trainBarBg
local trainGood = UiKit.label(trainPanel, "", 16, true, Palette.Cream)
trainGood.Position = UDim2.fromOffset(14, 70)
trainGood.Size = UDim2.new(1, -28, 0, 22)
trainGood.AutomaticSize = Enum.AutomaticSize.None

-- ===================== 터치: 키보드와 같은 순서 [◀] … [탭!][▶] =====================
type TouchBtn = { button: TextButton, stroke: UIStroke, scale: UIScale }
local function touchButton(text: string, size: number, pos: UDim2, color: Color3, keyName: string): TouchBtn
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(if pos.X.Scale > 0.5 then 1 else 0, 1)
	b.Position = pos
	b.Size = UDim2.fromOffset(size, size)
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.Visible = false
	UiKit.corner(b, 999)
	local st = UiKit.stroke(b, Palette.Cream, 3, 0.55)
	local sc = Instance.new("UIScale")
	sc.Parent = b
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.5)
	t.Size = UDim2.fromScale(0.8, 0.45)
	t.Font = UiKit.FontBlack
	t.TextScaled = true
	t.TextColor3 = Palette.Cream
	t.Text = text
	t.Parent = b
	b.Parent = gui
	b.MouseButton1Down:Connect(function()
		InputController.press(keyName, true)
	end)
	b.MouseButton1Up:Connect(function()
		InputController.press(keyName, false)
	end)
	b.MouseLeave:Connect(function()
		InputController.press(keyName, false)
	end)
	return { button = b, stroke = st, scale = sc }
end
local tA = touchButton("◀", 108, UDim2.new(0, 18, 1, -18), BLUE, "A")
local tD = touchButton("▶", 108, UDim2.new(1, -18, 1, -18), BLUE, "D")
local tTap = touchButton("탭!", 140, UDim2.new(1, -18, 1, -18), RED, "SPACE")

-- ===================== 상태 =====================
local function currentPattern(snap: ProtocolTypes.StateSnapshot): BeatPatterns.Pattern
	local id = if snap.training then snap.training.patternId else (snap.patternId or "FLAT")
	return BeatPatterns.get(id) or BeatPatterns.Patterns.FLAT
end

local function glow(stroke: UIStroke, scale: UIScale, on: boolean)
	stroke.Transparency = if on then 0 else 0.75
	stroke.Thickness = if on then 4 else 2
	scale.Scale = if on and Net.setting("reducedMotion") ~= true
		then 1 + 0.07 * math.abs(math.sin(os.clock() * 8))
		else 1
end

local function shade(obj: GuiObject, base: Color3, down: boolean)
	obj.BackgroundColor3 = if down then base:Lerp(Color3.new(0, 0, 0), 0.35) else base
end

local sideUsed = false
local function refresh(snap: ProtocolTypes.StateSnapshot)
	local training = snap.state == S.TRAINING and snap.training ~= nil
	gui.Enabled = training
	if not training then
		return
	end
	local tr = snap.training :: ProtocolTypes.TrainingView
	local rangeMode = tr.kind == "RANGE" -- 모의 사격은 박자 바 대신 화면을 눌러 맞힌다 (RangeController)
	local touch = InputController.CurrentInputType == "TOUCH"
	local pad = InputController.CurrentInputType == "GAMEPAD"
	local pat = currentPattern(snap)
	sideUsed = table.find(pat.keys, "A") ~= nil
	panel.Visible = not rangeMode
	keyA.wrap.Visible = sideUsed
	keyD.wrap.Visible = sideUsed
	keySpace.wrap.Visible = not sideUsed
	keyRow.Visible = not touch
	keyA.label.Text = if pad then "LB" else "◀ A"
	keyD.label.Text = if pad then "RB" else "D ▶"
	keySpace.label.Text = if pad then "Ⓐ" else "Space"
	panel.Size = if touch then UDim2.fromOffset(500, 92) else UDim2.fromOffset(520, 150)
	tA.button.Visible = touch and not rangeMode and sideUsed
	tD.button.Visible = touch and not rangeMode and sideUsed
	tTap.button.Visible = touch and not rangeMode and not sideUsed
	-- 한 줄 안내: 패턴 글 (터치는 "탭!", 패드는 Ⓐ·LB·RB)
	local hint = if sideUsed then "파란 점에 맞춰 A D A D" else pat.hintKo
	prompt.Text = if touch
		then (string.gsub(string.gsub(hint, "A D A D", "◀ ▶ ◀ ▶"), "Space", "탭!"))
		elseif pad then KoreanText.padKeys(hint)
		else hint
	local station = TrainingCatalog.get(tr.stationId)
	trainTitle.Text = if station then station.emoji .. " " .. station.nameKo else ""
	local frac = if rangeMode
			and tr.seconds
			and tr.timeLeft
		then 1 - tr.timeLeft / math.max(1, tr.seconds)
		else tr.beatsDone / math.max(1, tr.beatsTotal)
	trainBar.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
	local pass = if station then station.passGood else 0
	trainGood.Text = if rangeMode
		then string.format("🎯 맞힘 %d / %d · %d초", tr.good, pass, math.ceil(tr.timeLeft or 0))
		else string.format("좋아 %d / %d", tr.good, pass)
	trainGood.TextColor3 = if tr.good >= pass then GOOD else Palette.Cream
end

local function tick()
	if not gui.Enabled then
		return
	end
	local snap = Net.Snapshot
	if not snap or not panel.Visible then
		return
	end
	local held = InputController.held()
	local pat = currentPattern(snap)
	local beat = 60 / snap.beat.bpm
	local now = workspace:GetServerTimeNow()
	local n0 = math.floor((now - snap.beat.startedAt) / beat)
	-- 지금 받침대에 가장 가까운 박자의 키가 빛난다
	local nearest = math.floor((now - snap.beat.startedAt) / beat + 0.5)
	local want: string = BeatPatterns.expected(pat, nearest)
	glow(keyA.stroke, keyA.scale, want == "A")
	glow(keyD.stroke, keyD.scale, want == "D")
	glow(keySpace.stroke, keySpace.scale, want == "SPACE" or want == "SHOUT")
	glow(tA.stroke, tA.scale, want == "A")
	glow(tD.stroke, tD.scale, want == "D")
	glow(tTap.stroke, tTap.scale, want == "SPACE" or want == "SHOUT")
	shade(keyA.box, BLUE, held.a)
	shade(keyD.box, BLUE, held.d)
	shade(keySpace.box, RED, held.space)
	shade(tA.button, BLUE, held.a)
	shade(tD.button, BLUE, held.d)
	shade(tTap.button, RED, held.space)
	-- 음표: 빨강 = Space, 금색 "악!" = Space, 파랑 A/D, 쉼 = 비움
	local speedPx = lane.AbsoluteSize.X / 2 / (beat * 2.4)
	for i, note in ipairs(notes) do
		local kb = n0 + i - 3
		local dtb = snap.beat.startedAt + kb * beat - now
		local f = note.frame
		local exp: string = BeatPatterns.expected(pat, kb)
		if dtb < -beat * 0.5 or dtb > beat * 2.5 or exp == "REST" then
			f.Visible = false
			continue
		end
		f.Visible = true
		f.Position = UDim2.new(0.5, dtb * speedPx, 0.5, 0)
		f.BackgroundTransparency = if dtb < 0 then 0.6 else 0
		local near = math.abs(dtb) < 0.12
		if exp == "SHOUT" then
			local s = if near then 42 else 36
			f.Size = UDim2.fromOffset(s, s)
			f.BackgroundColor3 = GOLD
			note.text.Text = "악!"
			note.text.TextColor3 = Palette.Ink
			note.stroke.Color = Palette.Cream
			note.stroke.Transparency = 0
		elseif exp == "A" or exp == "D" then
			local s = if near then 34 else 28
			f.Size = UDim2.fromOffset(s, s)
			f.BackgroundColor3 = BLUE
			note.text.Text = exp
			note.text.TextColor3 = Palette.Cream
			note.stroke.Transparency = 0.4
		else
			local s = if near then 32 else 26
			f.Size = UDim2.fromOffset(s, s)
			f.BackgroundColor3 = RED
			note.text.Text = ""
			note.stroke.Transparency = 0.4
		end
	end
	-- 구호가 있는 패턴은 안내 줄에 크게
	local idx = (n0 % #pat.keys) + 1
	if pat.callKo and pat.callKo[idx] and not sideUsed then
		prompt.Text = pat.callKo[idx]
	end
end

local judgeToken = 0
local lastPress: { offset: number, exp: string, at: number }? = nil
local function showJudge(text: string, color: Color3, sec: number?)
	judge.Text = text
	judge.TextColor3 = color
	judge.Visible = true
	judgeToken += 1
	local tok = judgeToken
	task.delay(sec or 0.45, function()
		if judgeToken == tok then
			judge.Visible = false
		end
	end)
end

function BeatHud.start()
	Net.SnapshotChanged:Connect(refresh)
	if Net.Snapshot then
		refresh(Net.Snapshot)
	end
	RunService.RenderStepped:Connect(tick)
	InputController.InputTypeChanged:Connect(function()
		if Net.Snapshot then
			refresh(Net.Snapshot)
		end
	end)
	InputController.BeatPressed:Connect(function()
		-- 눌린 순간 가장 가까운 박자와의 차이 (화면 설명용. 판정은 서버)
		local snap = Net.Snapshot
		if snap then
			local beat = 60 / snap.beat.bpm
			local x = (workspace:GetServerTimeNow() - snap.beat.startedAt) / beat
			local kb = math.floor(x + 0.5)
			lastPress = {
				offset = (x - kb) * beat,
				exp = BeatPatterns.expected(currentPattern(snap), kb),
				at = os.clock(),
			}
		end
		if Net.setting("reducedMotion") == true then
			return
		end
		receptor.BackgroundTransparency = 0.5
		receptor.BackgroundColor3 = Palette.Cream
		TweenService:Create(receptor, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
	end)
	Net.FxCue:Connect(function(c)
		if c.kind ~= "HIT" or c.memberId ~= "ME" or not gui.Enabled then
			return
		end
		-- 색만이 아니라 모양(✔ ～ ✕)과 이유(빨라·늦어·쉬는 박자)로 구분
		local why = ""
		local lp = lastPress
		if lp and os.clock() - lp.at < 0.6 then
			if lp.exp == "REST" then
				why = " 쉬는 박자!"
			elseif lp.offset < -0.08 then
				why = " 빨라"
			elseif lp.offset > 0.08 then
				why = " 늦어"
			end
		end
		if c.quality == "GOOD" then
			showJudge("✔ 좋아!", GOOD)
		elseif c.quality == "OK" then
			showJudge("～ 오케이" .. why, Palette.Sand)
		else
			showJudge("✕ 앗" .. why, Palette.Fire)
		end
	end)
end

return BeatHud
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003f8</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6134">
            <Properties>
              <string name="Name">CameraController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{BB18FD51-A5CB-4BE5-AFAB-95133E933216}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 카메라: 편지·퇴소식은 장면 고정, 기지 사격장은 표적 쪽. 그 외(기지·꾸미기·급류·바다·유격·밤 모닥불)는 기본 카메라 —
-- 탑승 중엔 최소 거리만 늘리고, 밤에 들어올 때는 한 번만 모닥불 쪽으로 놓아 준다 (그 뒤는 아이가 돌린다).
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local Net = require(script.Parent.Net)

local CameraController = {}
local S = ProtocolTypes.SessionState
local player = Players.LocalPlayer
local mode = "DEFAULT"
local smoothPos: Vector3? = nil
local smoothLook: Vector3? = nil

local function myBoat(): Model?
	local f = SceneBindings.getFolder("Runtime")
	local m = f and f:FindFirstChild("Boat_" .. Net.boatOwnerId())
	return if m and m:IsA("Model") then m else nil
end

local function decide(snap: ProtocolTypes.StateSnapshot): string
	local st = snap.state
	if player:GetAttribute("CampAiming") == true then
		return "DEFAULT" -- 조준 모드(RangeController): 기본 카메라가 마우스·스틱을 따른다 (어깨 너머는 CameraOffset)
	end
	if st == S.TRAINING and snap.training and snap.training.kind == "RANGE" then
		return "RANGE" -- 모의 사격: 내 뒤에서 표적 쪽을 본다
	end
	-- 밤(모닥불 허브)은 기본 카메라 (마감 패스 M069): 예전 고정 FIRE 카메라는 뒤집힌 유보트를 비춰
	-- 모닥불·통나무 의자로 걸어가는 아이가 화면 밖으로 나갔다. 들어올 때 한 번만 불 쪽으로 놓아 준다(nightFrame)
	if st == S.GRADUATE or st == S.LETTER then -- 퇴소 편지는 무대에서
		return "STAGE"
	end
	return "DEFAULT"
end

local function apply(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if mode == "DEFAULT" then
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
		end
		smoothPos = nil
		return
	end
	local boat = myBoat()
	if not boat then
		return
	end
	local pivot = boat:GetPivot()
	local pos: Vector3, look: Vector3
	if mode == "RANGE" then
		local f = SceneBindings.getFolder("Triggers")
		local st = f and f:FindFirstChild("TRAIN_RANGE")
		if not st or not st:IsA("BasePart") then
			return
		end
		local lv = st.CFrame.LookVector
		pos = st.Position - lv * 7 + Vector3.new(0, 3.5, 0)
		look = st.Position + lv * 30 + Vector3.new(0, 0.5, 0)
	else -- STAGE: 길 건너 의자 쪽에서 무대를 본다. 유보트·나는 앞, 분대원은 무대 위에서 이쪽을 본다
		-- (2026-10-19 2차: 무대를 1일차 길 옆으로 옮김. 예전 카메라는 무대 뒷막 뒤에서 봐서 분대원이 가려졌다)
		local f = SceneBindings.getFolder("Triggers")
		local sum, n, front = Vector3.zero, 0, nil :: Vector3?
		for i = 1, 4 do
			local spot = f and f:FindFirstChild("GRAD_Spot" .. i)
			if spot and spot:IsA("BasePart") then
				sum += spot.Position
				n += 1
				front = spot.CFrame.LookVector
			end
		end
		if n > 0 and front then
			-- 가운데는 사진·수료 창이 덮는다 → 무대(분대원 넷)는 화면 오른쪽 1/3, 가운데·왼쪽은 들어온 북문 길
			local c = sum / n
			local fwd = Vector3.new(front.X, 0, front.Z).Unit
			local side = fwd:Cross(Vector3.yAxis) -- 무대에서 본 오른쪽 (북문 쪽)
			pos = c + fwd * 46 - side * 4 + Vector3.new(0, 12, 0)
			look = c + fwd * 24 + side * 16.5 + Vector3.new(0, 1.5, 0)
		else
			pos = pivot.Position + pivot.LookVector * 22 + Vector3.new(0, 7, 0)
			look = pivot.Position + Vector3.new(0, 2, 0)
		end
	end
	local reduced = Net.setting("reducedMotion") == true
	local k = math.min(1, dt * (if reduced then 8 else 3))
	smoothPos = if smoothPos then (smoothPos :: Vector3):Lerp(pos, k) else pos
	smoothLook = if smoothLook then (smoothLook :: Vector3):Lerp(look, k) else look
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(smoothPos :: Vector3, smoothLook :: Vector3)
end

-- 탑승 (4·5단계): 기본 카메라 그대로(아이가 돌려 볼 수 있게) 두되 최소 거리만 늘려 배·분대원 넷이 한 화면에 들어오게.
-- 끝나면 원래 값으로 (카메라를 빼앗지 않는다)
local savedMinZoom: number? = nil
local function rideZoom(on: boolean)
	if on and savedMinZoom == nil then
		savedMinZoom = player.CameraMinZoomDistance
		player.CameraMinZoomDistance = math.max(player.CameraMinZoomDistance, GameConfig.Ride.CameraMinZoom)
		-- 처음 한 번만 배 뒤 위에서 앞을 보게 놓는다 (그 뒤는 아이가 돌린다). 바로 뒤 낮은 자리면 뒷자리 분대원 머리가 화면을 가렸다 (Studio 2026-10-21)
		task.delay(0.6, function()
			local cam = workspace.CurrentCamera
			local boat = myBoat()
			local ch = player.Character
			local head = ch and ch:FindFirstChild("Head")
			if not cam or not boat or not head or not head:IsA("BasePart") or Net.state() ~= S.RIDE then
				return
			end
			local look = boat:GetPivot().LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
			local d = GameConfig.Ride.CameraMinZoom
			cam.CFrame =
				CFrame.lookAt(head.Position - flat * d * 0.85 + Vector3.new(0, d * 0.55, 0), head.Position + flat * 4)
		end)
	elseif not on and savedMinZoom ~= nil then
		player.CameraMinZoomDistance = savedMinZoom :: number
		savedMinZoom = nil
	end
end

-- 밤 첫 구도 (마감 패스): 오늘 밤 모닥불(Triggers Kind FIRE, Day)을 내 뒤 위에서 보게 한 번 놓는다
local function nightFrame(day: number)
	task.delay(0.9, function()
		local cam = workspace.CurrentCamera
		local ch = player.Character
		local head = ch and ch:FindFirstChild("Head")
		local f = SceneBindings.getFolder("Triggers")
		if not cam or not head or not head:IsA("BasePart") or not f or Net.state() ~= S.NIGHT then
			return
		end
		local fire: BasePart? = nil
		for _, c in ipairs(f:GetChildren()) do
			if c:IsA("BasePart") and c:GetAttribute("Kind") == "FIRE" and c:GetAttribute("Day") == day then
				fire = c
				break
			end
		end
		if not fire then
			return
		end
		local to = Vector3.new(fire.Position.X - head.Position.X, 0, fire.Position.Z - head.Position.Z)
		if to.Magnitude > 60 then
			return
		end
		local dir = if to.Magnitude > 0.5 then to.Unit else Vector3.new(0, 0, -1)
		-- 내 뒤에서 불을 보되, 등대·나무가 가리면 옆으로 돌려 본다 (Studio: 섬 쉼터 등대가 화면을 막았다)
		local look = fire.Position + Vector3.new(0, 0.5, 0)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore: { Instance } = { ch :: Instance }
		local runtime = workspace:FindFirstChild("Runtime")
		if runtime then
			table.insert(ignore, runtime)
		end
		params.FilterDescendantsInstances = ignore
		local best = head.Position - dir * 12 + Vector3.new(0, 7, 0)
		for _, deg in ipairs({ 0, 35, -35, 70, -70, 110, -110 }) do
			local d = CFrame.Angles(0, math.rad(deg), 0):VectorToWorldSpace(dir)
			local p = head.Position - d * 12 + Vector3.new(0, 7, 0)
			if not workspace:Raycast(look, p - look, params) then
				best = p
				break
			end
		end
		cam.CFrame = CFrame.lookAt(best, look)
	end)
end

-- 첫 1분 (28 §7): 한 번만 내 뒤 위에서 목표 쪽을 보게 놓는다 (그 뒤는 아이가 돌린다).
--   YARD  = 1일차 전 기지: 스폰 앞에서 꾸미기 마당 발판(FM_YardPad) 쪽 — 화살표·달려가는 분대원·아치·내 유보트가 한 화면
--   BUILD = 꾸미기 시작: 거치대(BD_Rack) 쪽. 버튼으로 순간이동하면 카메라가 옛 방향(빈 출발 원)을 보고 있었다 (Studio 2026-10-21 BEFORE).
--           걸어 들어와 이미 그쪽을 보고 있으면(50° 안) 건드리지 않는다
local function partNamed(folder: string, name: string): BasePart?
	local f = SceneBindings.getFolder(folder)
	local p = f and f:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end
local function frameToward(kind: string, delaySec: number)
	task.delay(delaySec, function()
		-- 마당: 서버가 나를 스폰 앞 첫 자리(FM_StartSpot)에 옮긴 뒤에 놓는다 (첫 스냅숏이 캐릭터보다 먼저 와서 놓치던 것 — 폰 시뮬 캡처)
		if kind == "YARD" then
			local spot = partNamed("Triggers", "FM_StartSpot")
			for _ = 1, 40 do
				local c = player.Character
				local h = c and c:FindFirstChild("HumanoidRootPart")
				if h and h:IsA("BasePart") and (not spot or (h.Position - spot.Position).Magnitude < 6) then
					break
				end
				task.wait(0.1)
			end
		end
		local cam = workspace.CurrentCamera
		local ch = player.Character
		local head = ch and ch:FindFirstChild("Head")
		local target = if kind == "YARD"
			then partNamed("Decorations", "FM_YardPad")
			else partNamed("Triggers", "BD_Rack")
		if not cam or not head or not head:IsA("BasePart") or not target then
			return
		end
		if kind == "BUILD" and Net.state() ~= S.BUILD then
			return
		end
		if kind == "YARD" and Net.state() ~= S.CAMP then
			return
		end
		local to = Vector3.new(target.Position.X - head.Position.X, 0, target.Position.Z - head.Position.Z)
		if to.Magnitude < 1 or to.Magnitude > 120 then
			return
		end
		local dir = to.Unit
		local camLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if kind == "BUILD" and camLook.Magnitude > 0.1 and camLook.Unit:Dot(dir) > math.cos(math.rad(50)) then
			return
		end
		-- 기본 카메라는 거리를 다시 맞추고 각만 남는다. 마당: 키 큰 화면(PC 창)은 ≈23° 내려다봐 바닥 화살표까지,
		-- 가로로 넓은 화면(폰)은 ≈10° — 더 숙이면 마당 아치·▼ 가 위 할 일 판 뒤로 숨었다 (폰 시뮬 캡처 2026-10-21)
		local vp = cam.ViewportSize
		local wide = vp.Y > 0 and vp.X / vp.Y > 1.6
		if kind == "YARD" then
			-- 기본 카메라는 내 머리를 늘 화면 가운데에 다시 놓고 보는 방향만 남긴다 → 보는 방향을 마당 쪽에서 옆으로 비켜야
			-- 머리가 아치·▼ 를 안 덮는다 (최종 점검 2026-10-21: 옛 식은 카메라 자리만 16° 돌려 실제 방향은 ≈4° — 폰·PC 모두 머리가 아치 위).
			-- 화면 좌우로 ≈18°(넓은 화면)·13° 비켜 아치를 머리 오른쪽에 두고, 아래로 ≈9°(넓은 화면 — 더 숙이면 아치가 위 할 일 판 뒤로)·16°(키 큰 화면)
			local yawDeg = if wide then 18 else 13
			local pitchDeg = if wide then 9 else 16
			local look = CFrame.Angles(0, math.rad(yawDeg), 0):VectorToWorldSpace(dir)
			look = (look * math.cos(math.rad(pitchDeg)) - Vector3.new(0, math.sin(math.rad(pitchDeg)), 0)).Unit
			local focus = head.Position
			cam.CFrame = CFrame.lookAt(focus - look * 12.5, focus)
			return
		end
		cam.CFrame = CFrame.lookAt(
			head.Position - dir * 12 + Vector3.new(0, 7, 0),
			head.Position + dir * math.min(to.Magnitude, 14) + Vector3.new(0, 0.5, 0)
		)
	end)
end

function CameraController.start()
	local lastState = ""
	local lastYard = false
	local function refresh(snap: ProtocolTypes.StateSnapshot)
		rideZoom(snap.state == S.RIDE)
		if snap.state == S.NIGHT and lastState ~= S.NIGHT then
			nightFrame(snap.day)
		end
		-- 첫 1분: 1일차 전 기지에 들어오면(첫 접속·다시 입소·기지로) 마당 쪽, 꾸미기가 시작되면 거치대 쪽
		local yard = snap.state == S.CAMP and StationCatalog.nextDay(snap.day) == 1 and snap.allowed.START_DAY == true
		if yard and not lastYard then
			frameToward("YARD", 0.7)
		end
		lastYard = yard
		if snap.state == S.BUILD and lastState ~= S.BUILD then
			frameToward("BUILD", 0.45)
		end
		lastState = snap.state
		local m = decide(snap)
		if m ~= mode then
			mode = m
			smoothPos = nil
			smoothLook = nil
		end
	end
	Net.SnapshotChanged:Connect(refresh)
	player.CharacterAdded:Connect(function()
		if lastYard then
			frameToward("YARD", 0.8) -- 리셋해도 스폰 앞에서 다시 마당 쪽
		end
	end)
	player:GetAttributeChangedSignal("CampAiming"):Connect(function()
		if Net.Snapshot then
			refresh(Net.Snapshot)
		end
	end)
	RunService.RenderStepped:Connect(apply)
end

return CameraController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
