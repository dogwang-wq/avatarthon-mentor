					CFrame.new(p[1] + (c - (5 - r) / 2) * 2.3, 0.45 + (r - 1) * 0.85, p[2])
						* CFrame.Angles(0, math.rad((c + r) * 6), 0),
					Palette.Khaki,
					Enum.Material.Fabric,
					{ canCollide = true }
				)
			end
		end
	end
