	goalSeaIdle = "%s · 탄 사람 %d/4", -- %s = goalKeys
	goalFinish = "🏖️ 도착!",
	-- 밤 일지 (메모체, 마침표 없음) · 오늘의 발견 (사실만, 해석 없음)
	journal = {
		RAPIDS = "🌊 급류 완주. 빠짐 %d번",
		RAPIDS_CLEAN = "🌊 급류 완주. 아무도 안 빠짐",
		SEA = "⛵ 섬까지 노 젓기. 빠짐 %d번",
		SEA_CLEAN = "⛵ 섬까지 노 젓기. 아무도 안 빠짐",
	} :: { [string]: string },
	discoverPulled = "➰ 내가 끌어올린 사람: %s",
	discoverPulledMe = "나를 끌어올린 사람: %s",
	discoverFell = "🌊 빠진 사람: %s",
	discoverDodge = "🌊 바위 %d개 피함 · 쿵 %d",
	discoverClean = "🌊 넷이 끝까지 배 위에",
	-- ===== 급류 2차 (2026-10-21): 아이를 따라오기 · 물 위 줍기 =====
	-- 아이가 먼저 맞는 쪽으로 가면 분대원이 따라오며 (돌아가며 한 사람)
	followCall = {
		LEFT = { "그래, 왼쪽!", "따라간다, 왼쪽!", "왼쪽 좋아!" },
		RIGHT = { "그래, 오른쪽!", "따라간다, 오른쪽!", "오른쪽 좋아!" },
		CENTER = { "그래, 가운데!", "가운데 좋아!", "다 같이 가운데!" },
	} :: { [string]: { string } },
	-- 아이가 반대로 가면 미르가 바로잡는다 (나무라지 않는다)
	mirFix = { LEFT = "아니 아니, 왼쪽!", RIGHT = "아니 아니, 오른쪽!", CENTER = "가운데로 와!" } :: { [string]: string },
	-- 아무도 먼저 안 움직여 늦게 피했을 때 (빠지지 않음, 코믹)
	scrape = { "휴, 아슬아슬!", "끼이익—!", "스쳤다!" },
	-- 폭포를 지날 때 다 같이 팔을 든다
	fallsCheer = { DURI = "와아아!", SAN = "오—!", MIR = "꺄아!" } :: { [string]: string },
	-- 줍기: 처음 둘은 두리가 알려 주고, 주우면 가끔 한마디
	itemCall = {
		LWOOD = "왼쪽에 장작!",
		RWOOD = "오른쪽에 장작!",
		LWATER = "왼쪽에 물통!",
		RWATER = "오른쪽에 물통!",
	} :: { [string]: string },
	itemFirst = { WOOD = "오! 장작!", WATER = "물통이다!" } :: { [string]: string },
	itemReact = {
		DURI = { "오늘 밤 불 크겠다!", "또 건졌다!" },
		SAN = { "좋아.", "잘 잡았다." },
		MIR = { "나이스!", "하나 더!" },
	} :: { [string]: { string } },
	itemFloat = { WOOD = "+1 🌲", WATER = "+1 💧" } :: { [string]: string },
	goalWood = " · 🌲 %d", -- 할 일 판 머리 뒤 (오늘 주머니 장작)
	goalBumps = " · 💥 %d", -- 할 일 판 머리 뒤 (바위에 쿵 수 — 점수 아님. 🪨 는 Roblox 글꼴에 없어 ▯ 로 나왔다)
	-- 밤 일지 뒤에 붙는 것 (메모체): "내가 먼저 움직인 바위 4" · "건진 장작 3"
	journalLed = { RAPIDS = " · 방향 잡아 피한 바위 %d", SEA = " · 저으며 넘은 파도 %d" } :: { [string]: string },
