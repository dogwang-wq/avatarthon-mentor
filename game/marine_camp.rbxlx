          <string name="Source"><![CDATA[--!strict
-- RemoteEvent 이름·요청/응답 형태·상태 enum·오류 코드의 단일 기준.
local ProtocolTypes = {}

ProtocolTypes.RemotesFolderName = "Remotes"

ProtocolTypes.ClientToServer = {
	ClientReady = "ClientReady",
	BeatInput = "BeatInput", -- { t: number(서버 시각), key: "SPACE"|"A"|"D" } 체력단련장 박자 기구에서만 (6단계)
	LoadoutRequest = "LoadoutRequest", -- { requestId, op, seatKey?, memberId?, otherSeatKey?, cargoId?, oar? }
	FlowRequest = "FlowRequest", -- { requestId, op, choiceId? }
	LetterRequest = "LetterRequest", -- { requestId, toId, chips: {string}, freeText? }
	SettingsRequest = "SettingsRequest",
	CoopRequest = "CoopRequest", -- { requestId, op, targetUserId?, hostUserId?, memberId? }
	CarryInput = "CarryInput", -- { move: boolean, steer: number } 탑승(RIDE): W·스틱 위 = 노 젓기, A/D·스틱 좌우 = 방향 −1..1 (이름은 옛 운반 그대로, 바뀔 때·10Hz 까지)
	RangeShot = "RangeShot", -- { group: "RANGE"|"GATE"|"GATEB"…, index } 모의 사격 표적 누름 (14 §5). 서버가 표적이 서 있었는지 판정
	LeaderboardRequest = "LeaderboardRequest", -- { requestId, board: D1..D6|GRAD } → ActionResult.data { board, mode, rows } (15)
}

ProtocolTypes.ServerToClient = {
	StateSnapshot = "StateSnapshot",
	ActionResult = "ActionResult",
	StoryCue = "StoryCue", -- { kind: "LINE"|"CHOICE"|"BADGE", who, text, seconds, beatId?, choices? }
	FxCue = "FxCue", -- { kind, pos?, memberId?, quality? }
	DayReport = "DayReport", -- 밤 일지 (03_FLOW §6)
	CoopCue = "CoopCue",
}

ProtocolTypes.SessionState = {
	LOADING = "LOADING",
	CAMP = "CAMP",
	OBBY = "OBBY", -- 2·5·6일차 자유 이동 스테이지 (깃발·탐조등·사격 문)
	NIGHT = "NIGHT",
	LETTER = "LETTER",
	GRADUATE = "GRADUATE",
	RIDING = "RIDING", -- 친구 소대에 분대원 자리로 들어감 (CoopService)
	TRAINING = "TRAINING", -- 체력단련장 미니게임 (기지에서만)
	BUILD = "BUILD", -- 1일차 1-A 유보트 꾸미기·싣기 (27 §3 · 28, 3단계): 연병장 거치대에서 E 집기·싣기·자리 발판 → 출발 깃발
	RIDE = "RIDE", -- 1일차 1-B 급류 · 4일차 바다 노 젓기 (27 §3 · 28, 4·5단계): 탑승 물리 배 (RideService)
	DISCONNECTING = "DISCONNECTING",
}

ProtocolTypes.LoadoutOp = {
	SEAT = "SEAT", -- seatKey ← memberId (그 자리에 있던 멤버는 memberId 의 옛 자리로)
	CARGO_ADD = "CARGO_ADD",
	CARGO_REMOVE = "CARGO_REMOVE",
	OAR = "OAR",
	RESET = "RESET",
}

ProtocolTypes.FlowOp = {
	START_DAY = "START_DAY", -- CAMP → 그날 훈련
	NEXT_DAY = "NEXT_DAY", -- NIGHT/LETTER → 다음 날
	INTERACT = "INTERACT", -- E: 넘어진·언 분대원 / 산 같이 가기 (OBBY) · 매달린 분대원 끌어올리기 (RIDE)
	STORY_CHOICE = "STORY_CHOICE", -- beatId + choiceId
	GRADUATE_DONE = "GRADUATE_DONE", -- 퇴소식 끝: choiceId REENTER | STAY
	RETURN_CAMP = "RETURN_CAMP", -- 수동 복귀 (막힘 대비)
	SKIP_TUTORIAL = "SKIP_TUTORIAL", -- 첫 입소 조작 카드(걷기·점프·E)를 닫음
	TRAIN_START = "TRAIN_START", -- choiceId = 기구 id (TrainingCatalog)
	TRAIN_STOP = "TRAIN_STOP",
	REPLAY_DAY = "REPLAY_DAY", -- NIGHT: 오늘 코스를 (바꾼 배치로) 한 번 더
	LETTER_SKIP = "LETTER_SKIP", -- 퇴소 편지 안 쓰고 퇴소식으로
	BUILD_GO = "BUILD_GO", -- 꾸미기(BUILD) 건너뛰고 바로 출발 (플레이테스트 2026-10-21)
}

ProtocolTypes.CoopOp = {
	INVITE = "INVITE",
	ACCEPT = "ACCEPT",
	DECLINE = "DECLINE",
	LEAVE = "LEAVE",
	NOTE = "NOTE", -- 밤 일지 한 줄 (choiceId)
}

ProtocolTypes.PersistenceMode = {
	SAVING = "SAVING",
	UNAVAILABLE = "UNAVAILABLE",
	LOCKED = "LOCKED",
}

ProtocolTypes.ErrorCode = {
	OK = "OK",
	BAD_REQUEST = "BAD_REQUEST",
	WRONG_STATE = "WRONG_STATE",
	RATE_LIMITED = "RATE_LIMITED",
	INVALID_SEAT = "INVALID_SEAT",
	INVALID_MEMBER = "INVALID_MEMBER",
	INVALID_CARGO = "INVALID_CARGO",
	CARGO_FULL = "CARGO_FULL",
	NOT_FRIEND = "NOT_FRIEND",
	BUSY = "BUSY",
	TEXT_FILTERED = "TEXT_FILTERED",
	INTERNAL = "INTERNAL",
}

ProtocolTypes.ErrorTextKo = {
	OK = "됐어요!",
	BAD_REQUEST = "다시 눌러 주세요!",
	WRONG_STATE = "지금은 안 돼요. 밤에 바꿔요!",
	RATE_LIMITED = "잠깐만요!",
	INVALID_SEAT = "그 자리는 없어요!",
	INVALID_MEMBER = "그 친구는 없어요!",
	INVALID_CARGO = "그 짐은 없어요!",
	CARGO_FULL = "짐은 3개까지!",
	NOT_FRIEND = "로블록스 친구만 탈 수 있어요!",
	BUSY = "친구가 지금 바빠요!",
	TEXT_FILTERED = "그 말은 편지에 못 써요. 다른 말로!",
	INTERNAL = "잠깐 문제가 있어요. 다시 해 보세요!",
}

export type Loadout = {
	seats: { [string]: string }, -- FL/FR/BL/BR → memberId
	cargo: { string },
	oar: string, -- LONG | SHORT
	revision: number,
}

export type MemberView = {
	id: string,
	nameKo: string,
	emoji: string,
	seat: string?,
	isFriend: boolean,
	waiting: boolean?, -- 산이 그물벽 앞에서 멈춤 등
}

export type TrainingView = {
	stationId: string,
	patternId: string,
	beatsTotal: number,
	beatsDone: number,
	good: number,
	ok: number,
	miss: number,
	kind: string?, -- "RANGE" = 모의 사격
	timeLeft: number?,
	seconds: number?,
}

export type Stats = { strength: number, speed: number, stamina: number, aim: number? }

export type StateSnapshot = {
	state: string,
	day: number,
	highestCp: string,
	resumeCp: string,
	entryCount: number,
	loadout: Loadout,
	members: { MemberView },
	beat: { bpm: number, startedAt: number }, -- 체력단련장 박자 기구 시계
	training: TrainingView?,
	-- 자유 이동 스테이지 (22 v2): 깃발 수·탈출 남은 시간·사격 문이 있나·지금 선 문의 맞힌 수/필요 수/내가 맞힌 수 (6단계)
	obby: {
		flags: number,
		need: number,
		escapeLeft: number?,
		gateHint: boolean,
		gate: { hits: number, need: number, mine: number }?,
	}?,
	stats: Stats,
	trainedToday: { [string]: boolean },
	flashlight: boolean,
	stickers: { string },
	badges: { string },
	letters: number,
	letterNote: string?, -- 마지막 퇴소 편지(친구들에게 한 말) — 퇴소식 사진 밑에 (v2, M061)
	persistence: string,
	tutorialDone: boolean,
	allowed: { [string]: boolean },
	settings: { [string]: any },
	coop: { role: string, partnerUserId: number, memberId: string?, hostState: string? }?,
	patternId: string?, -- 체력단련장 박자 기구 패턴
	records: { best: { [string]: number }, run: { [string]: number }, bestTotal: number? }?, -- 15_RECORDS
	stage: { day: number, startedAt: number, paused: number, best: number? }?, -- 지금 재는 작전 (클라이언트 타이머)
	-- 모닥불 허브 (27 §3 · 28 §4, 1단계): 오늘 주운 장작·물통, 불 크기 0..3, 넣은 수, 나눠 준 사람, 옆에 앉은 사람, 내일로 켜질 때까지 초
	camp: CampView?,
	-- 살리기 (27 §3 · 28 §4, 2단계): 넘어진 분대원 · 언 분대원 · 내가 언 남은 초 · 오늘 내가 살린 수
	rescue: RescueView?,
	-- 유보트 꾸미기 (27 §3 · 28 §4, 3단계): 들고 있는 것 · 짐 · 노 · 내 자리 · 분대원이 내미는 것 · 출발 깃발이 빛나는지
	build: BuildView?,
	-- 탑승 (27 §3 · 28 §4, 4·5단계): 급류/바다 · 단계 · 진행 · 속도 · 기울기 · 지금 부르는 쪽 · 빠진 수 · 매달린 사람 · 내 상태
	ride: RideView?,
}

export type RideView = {
	kind: string, -- RAPIDS | SEA
	phase: string, -- BOARD | COUNT | RUN | FINISH | DONE
	progress: number, -- 0..1 (도착점까지)
	speed: number, -- stud/s
	roll: number, -- 지금 기울기(도, + 왼쪽이 내려감)
	cue: string?, -- LEFT | RIGHT | CENTER | JUMP (미르가 부르는 쪽)
	cueLeft: number,
	falls: number, -- 오늘 빠진 수 (나 + 분대원)
	hanging: { string }, -- 지금 배 뒤에 매달린 사람 id
	meState: string, -- DECK | WATER | HANGING | CLIMBING
	riders: number, -- 갑판 위 사람 수
	moving: boolean, -- 바다: W 누르는 중
	jumpWindow: boolean, -- 폭포 "붕" 창 (클라이언트 연출)
	items: number?, -- 급류 2차: 이번에 물 위에서 건진 것 (장작+물통)
	ledByMe: number?, -- 방향 잡아 피한 바위 · 저으며 넘은 파도 수 (점수 아님)
	lat: number?, -- 앉아서 직접 젓기: 배 옆 자리 (스플라인에서 오른쪽 +)
	rowing: boolean?, -- 노 젓는 힘이 붙어 있나
	bumps: number?, -- 바위에 쿵 수 (할 일 판 🪨)
}

export type BuildView = {
	holding: string?, -- 지금 손에 든 부품 (PartType: OAR_LONG|OAR_SHORT|WATER|FLAG|AID|SNACK|STICKER_A|B|C)
	cargo: { string }, -- 실은 짐 (BoatLoadout.Cargo id)
	oar: string, -- LONG | SHORT
	mySeat: string, -- FL | FR | BL | BR
	offers: { [string]: string }?, -- 분대원 id → 내미는 부품 (머리 위 🎁 E)
	idleHint: boolean, -- 오래 가만히 있어 출발 깃발이 빛나는 중
	changed: boolean, -- 하나라도 붙이거나 바꿨나 (BUILD 뱃지)
}

export type RescueView = {
	downId: string?, -- 지금 넘어져 있는 분대원 (🤝 E)
	frozenId: string?, -- 지금 얼어 있는 분대원 (❄️ E)
	meFrozenLeft: number?, -- 내가 얼어 있으면 풀릴 때까지 남은 초
	revives: number, -- 오늘 내가 일으키고 풀어 준 수
}

export type CampView = {
	wood: number,
	water: number,
	fire: number, -- 0 낮(불 없음) · 1 작은 불 · 2 보통 · 3 큰 불
	fed: number,
	gave: { [string]: boolean },
	sat: { [string]: boolean },
	nextIn: number?, -- NIGHT: "내일로" 가 켜질 때까지 남은 초 (0 이면 켜짐)
	canGive: boolean, -- 지금 나눠 줄 것(물통·간식)이 있나
}

export type ActionResult = { requestId: string, accepted: boolean, code: string, data: any? }

return ProtocolTypes
