              <string name="ScriptGuid">{C684A3EB-96CB-48EC-96CE-3A9B33662D3E}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 기지·작전 HUD (docs/design/19_UI_MAP_STYLE.md). 보는 순서:
--   ① 위 가운데 "지금 할 일" 나무 판 — 아이콘 + 할 일 한 줄 + 어디인지 한 줄 + 진행 막대, 아래 ⏱ 알약(낮 작전 OBBY·RIDE 만)
--   ② 아래 가운데 큰 빨간 버튼 하나 (기지: n일차 출발 / 편지: 아침 / 퇴소: 다시 입소). 밤의 내일로·한 번 더는 NightPanel 작은 카드
--   ③ 오른쪽 위 기수 알약 + 아이콘 타일 (배치·일지·기록판·친구·기지로·내리기)
-- 가운데는 비운다. 가운데 창이 열리면 ②③ 을 숨긴다.
-- 폰: 왼쪽 아래(이동 막대)·오른쪽 아래(점프·탭 버튼)는 비운다 — 큰 버튼은 아래 가운데, 타일은 오른쪽 위.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local TrainingCatalog = require(Shared:WaitForChild("TrainingCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local Palette = require(Shared:WaitForChild("Palette"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Signal = require(Shared:WaitForChild("Signal"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local InputController = require(script.Parent.InputController)

local CampHud = {}
local S = ProtocolTypes.SessionState
local C2S = ProtocolTypes.ClientToServer
local G = CampScript.Goal
local EDGE = Palette.UI.Edge

CampHud.OpenLoadout = Signal.new() :: Signal.Signal<>
CampHud.OpenJournal = Signal.new() :: Signal.Signal<>
CampHud.OpenCoop = Signal.new() :: Signal.Signal<>
CampHud.OpenBoard = Signal.new() :: Signal.Signal<> -- 🏆 기록판 (15)

local gui = UiKit.screen("CampHud", 10)

-- ===================== ① 지금 할 일 (위 가운데 나무 판) =====================
local goal = UiKit.woodSign(gui, "Goal", UDim2.fromOffset(470, 70), UDim2.new(0.5, 0, 0, 44), Vector2.new(0.5, 0))
local goalIcon = Instance.new("TextLabel")
goalIcon.Name = "Icon"
goalIcon.AnchorPoint = Vector2.new(0, 0.5)
goalIcon.Position = UDim2.new(0, 10, 0.5, -2)
goalIcon.Size = UDim2.fromOffset(46, 46)
goalIcon.BackgroundColor3 = Palette.Yellow -- 노랑 = 지금 볼 곳
goalIcon.BorderSizePixel = 0
goalIcon.Font = UiKit.FontBold
goalIcon.TextSize = 26
goalIcon.Text = ""
UiKit.corner(goalIcon, 999)
UiKit.stroke(goalIcon, Palette.WoodDark, 2, 0)
goalIcon.Parent = goal
local goalText = UiKit.label(goal, "", 22, true, Palette.Cream)
goalText.Name = "Text"
goalText.Position = UDim2.fromOffset(66, 7)
goalText.Size = UDim2.new(1, -78, 0, 27)
goalText.AutomaticSize = Enum.AutomaticSize.None
goalText.TextWrapped = false
goalText.TextTruncate = Enum.TextTruncate.AtEnd
goalText.TextStrokeColor3 = Palette.Ink
goalText.TextStrokeTransparency = 0.5
local goalSub = UiKit.label(goal, "", 15, true, Palette.Cream)
goalSub.Name = "Sub"
goalSub.TextTransparency = 0.2
goalSub.Position = UDim2.fromOffset(66, 35)
goalSub.Size = UDim2.new(1, -78, 0, 18)
goalSub.AutomaticSize = Enum.AutomaticSize.None
goalSub.TextWrapped = false
goalSub.TextTruncate = Enum.TextTruncate.AtEnd
-- 진행 막대 (오늘 구간 전체): 판 아래 가장자리, 노랑
local progBg = Instance.new("Frame")
progBg.Name = "Progress"
progBg.AnchorPoint = Vector2.new(0, 1)
progBg.Position = UDim2.new(0, 66, 1, -7)
progBg.Size = UDim2.new(1, -80, 0, 5)
progBg.BackgroundColor3 = Palette.WoodDark
progBg.BorderSizePixel = 0
progBg.Visible = false
UiKit.corner(progBg, 3)
progBg.Parent = goal
local progFill = Instance.new("Frame")
progFill.Size = UDim2.fromScale(0, 1)
progFill.BackgroundColor3 = Palette.Yellow
progFill.BorderSizePixel = 0
UiKit.corner(progFill, 3)
progFill.Parent = progBg

-- ⏱ 작전 타이머 (15_RECORDS): 판 바로 아래 알약. 내 최고보다 빠르면 초록, 6일차는 탈출 남은 시간도
local timerPill = UiKit.pill(goal, "Timer", 18)
timerPill.AnchorPoint = Vector2.new(0.5, 0)
timerPill.Position = UDim2.new(0.5, 0, 1, 8)
timerPill.Visible = false
-- 기록 시계는 낮 작전에만 (꾸미기·모닥불·기지에는 없다 — 6단계)
local TIMED: { [string]: boolean } = {
	[S.OBBY] = true,
	[S.RIDE] = true, -- 급류·바다 (4·5단계)
}
local function tickTimer()
	local snap = Net.Snapshot
	local stage = snap and snap.stage
	if not snap or not stage or not TIMED[snap.state] then
		timerPill.Visible = false
		return
	end
	local cs = math.max(0, (workspace:GetServerTimeNow() - stage.startedAt - stage.paused) * 100)
	local text = "⏱ " .. KoreanText.clock(cs)
	if stage.best then
		text ..= " · 최고 " .. KoreanText.clock(stage.best)
	end
	local esc = snap.obby and snap.obby.escapeLeft
	if esc then
		text ..= if esc >= 0
			then string.format(" · 🚨 %d초", math.ceil(esc))
			else string.format(" · 🚨 %d초 늦음", math.ceil(-esc))
	end
	timerPill.Text = text
	timerPill.TextColor3 = if esc and esc < 10
		then Palette.Fire
		elseif stage.best and cs < stage.best then Color3.fromHex("8EE59A")
		else Palette.Cream
	timerPill.Visible = true
end

-- ===================== ② 큰 버튼 하나 (아래 가운데) =====================
local cta = Instance.new("Frame")
cta.Name = "Cta"
cta.AnchorPoint = Vector2.new(0.5, 1)
cta.Position = UDim2.new(0.5, 0, 1, -20)
cta.Size = UDim2.fromOffset(0, 66)
cta.AutomaticSize = Enum.AutomaticSize.X
cta.BackgroundTransparency = 1
cta.Visible = false
cta.Parent = gui
local ctaList = UiKit.list(cta, Enum.FillDirection.Horizontal, 12)
ctaList.VerticalAlignment = Enum.VerticalAlignment.Center
ctaList.HorizontalAlignment = Enum.HorizontalAlignment.Center
local startBtn = UiKit.button(cta, "", function()
	local snap = Net.Snapshot
	if not snap then
		return
	end
	local op = if snap.state == S.CAMP
		then ProtocolTypes.FlowOp.START_DAY
		elseif snap.state == S.BUILD then ProtocolTypes.FlowOp.BUILD_GO
		else ProtocolTypes.FlowOp.NEXT_DAY
	Net.request(C2S.FlowRequest, { op = op }, function(res)
		if not res.accepted then
			UiKit.toast(Net.errorText(res.code))
		end
	end)
end, true)
startBtn.Size = UDim2.fromOffset(300, 66)
startBtn.Font = UiKit.FontBlack
startBtn.TextSize = 24
startBtn.Name = "Start"
startBtn.LayoutOrder = 2
local reenterBtn = UiKit.button(cta, CampScript.Graduate.reenter, function()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.GRADUATE_DONE, choiceId = "REENTER" })
end, true)
reenterBtn.Size = UDim2.fromOffset(300, 66)
reenterBtn.Font = UiKit.FontBlack
reenterBtn.TextSize = 24
reenterBtn.Name = "Reenter"
reenterBtn.LayoutOrder = 3

-- ===================== ③ 오른쪽 위: 기수 알약 + 타일 =====================
local right = Instance.new("Frame")
right.Name = "Right"
right.AnchorPoint = Vector2.new(1, 0)
right.Position = UDim2.new(1, -EDGE, 0, 44)
right.Size = UDim2.fromOffset(0, 0)
right.AutomaticSize = Enum.AutomaticSize.XY
right.BackgroundTransparency = 1
right.Parent = gui
local rightList = UiKit.list(right, nil, 8)
rightList.HorizontalAlignment = Enum.HorizontalAlignment.Right
local profile = UiKit.pill(right, "Profile", 15)
profile.LayoutOrder = 1
local tiles = Instance.new("Frame")
tiles.Name = "Tiles"
tiles.Size = UDim2.fromOffset(0, 0)
tiles.AutomaticSize = Enum.AutomaticSize.XY
tiles.BackgroundTransparency = 1
tiles.LayoutOrder = 2
tiles.Parent = right
local tileList = UiKit.list(tiles, Enum.FillDirection.Horizontal, 8)
tileList.HorizontalAlignment = Enum.HorizontalAlignment.Right
local loadoutTile = UiKit.tile(tiles, "🛶", CampScript.UI.tileLoadout, function()
	CampHud.OpenLoadout:Fire()
end)
loadoutTile.Name = "Loadout"
loadoutTile.LayoutOrder = 1
local journalTile = UiKit.tile(tiles, "📒", CampScript.UI.tileJournal, function()
	CampHud.OpenJournal:Fire()
end)
journalTile.Name = "Journal"
journalTile.LayoutOrder = 2
local boardTile = UiKit.tile(tiles, "🏆", CampScript.UI.tileBoard, function()
	CampHud.OpenBoard:Fire()
end)
boardTile.Name = "Board"
boardTile.LayoutOrder = 3
local coopTile = UiKit.tile(tiles, "👋", CampScript.UI.tileCoop, function()
	CampHud.OpenCoop:Fire()
end)
coopTile.Name = "Coop"
coopTile.LayoutOrder = 4
local returnTile = UiKit.tile(tiles, "↩", CampScript.UI.tileReturn, function()
