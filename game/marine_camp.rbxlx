            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 탑승 물리 배 (27 §3 1-B 급류 타기 · 4일차 바다 노 젓기, 28 4·5단계 프로토타입, 2026-10-21).
-- · 유보트는 물리 덩어리(Root unanchored + 선체 WeldConstraint) 를 AlignPosition/AlignOrientation 이 RIDE 경로점 스플라인(Catmull-Rom,
--   호 길이 매개변수) + **옆 자리 lat** 을 따라 끌고 간다.
-- · 앉아서 직접 젓기 (2026-10-21 플레이테스트 "노 젓는 것도 아니고" → Build a Boat·보트 게임 꼴): 나는 배치 자리(FL/FR/BL/BR) 튜브 위
--   Seat 에 **앉는다** (갑판을 걸어 다니지 않는다). W(·↑·스틱 위) = 노 젓기, A/D(·스틱 좌우) = 방향 (CarryInput {move, steer}).
--   급류는 물살로 기본 RapidsBaseSpeed 로 내려가고 저으면 +RapidsRowAdd, 바다는 저을 때만 간다. 한 번 젓기(RowStrokeSec)마다 속도가 밀려 나간다
--   (서버 시각 기준 박자 — 클라이언트 RideCrew 가 같은 박자로 내 노·분대원 노를 젓는다). 방향은 옆 자리 lat(수로 폭 안) + 작은 뱃머리 돌림·기울기.
-- · 배치(자리 힘·짐)가 기본 기울기·속도다 (가설 1).
-- · 장애물: 바위(옆 자리로 판정 — 반대쪽으로 비껴가면 깨끗, 가운데면 긁힘, 바위 쪽이면 쿵 · 세게 박으면 드물게 그쪽 사람이 빠짐)
--   · 낮은 가지(분대원이 숙임 — 빠짐 없음) · 폭포(3 stud 하강, 다 같이 환호) · 파도(옆으로 밀림 — 젓고 있지 않으면 드물게 그쪽 사람이 빠짐).
-- · 빠지면: 물에 2초 → 배 꼬리 밧줄에 매달림(HANGING) → 분대원·친구가 E 끌어올리기(1.5초면 분대원이 당긴다) → 4초면 혼자 기어오른다. 막지 않는다.
-- 규약: 서버 판정. 카메라는 건드리지 않는다. 수치는 GameConfig.Ride, 글은 CampScript.Ride (28 §7 4·5단계 통합). 상태 기계는 SessionService RIDE.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local BoatService = require(script.Parent.BoatService)
local SquadNpcService = require(script.Parent.SquadNpcService)
local AssetLibrary = require(script.Parent.AssetLibrary) -- 급류 2차: 물 위 장작·물통 메시 (없으면 기본 파트)
local TelemetryService = require(script.Parent.TelemetryService)

local RideService = {}

export type Kind = "RAPIDS" | "SEA"

-- ===== 수치·글 (28 §7 통합: 수치는 GameConfig.Ride, 글은 CampScript.Ride — 여기 이름은 별칭) =====
RideService.Config = GameConfig.Ride
RideService.Lines = CampScript.Ride

local CFG = RideService.Config
local L = RideService.Lines
local SIZE = GameConfig.Boat.Size
local HALF_L = SIZE.Z / 2
local DECK_HALF_X = 3.2
local DECK_HALF_Z = 6.7

local GROUP_BOAT = "CampBoat"
local GROUP_CHARS = "CampChars"
local GROUP_DECK = "CampDeck" -- 갑판: 탑승자(CampChars)하고만 부딪힌다. 1차 주행에서 Default 갑판이 협곡 벽 계단에 걸려 34 stud 뒤처졌다
local groupsReady = false
local function ensureGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	pcall(function()
		PhysicsService:RegisterCollisionGroup(GROUP_BOAT)
		PhysicsService:RegisterCollisionGroup(GROUP_CHARS)
		PhysicsService:RegisterCollisionGroup(GROUP_DECK)
		PhysicsService:CollisionGroupSetCollidable(GROUP_BOAT, GROUP_CHARS, false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_CHARS, GROUP_CHARS, false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_BOAT, "Default", false) -- 선체는 바위·둑과도 안 부딪힌다 (판정은 서버)
		PhysicsService:CollisionGroupSetCollidable(GROUP_BOAT, GROUP_DECK, false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_DECK, "Default", false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_DECK, GROUP_DECK, false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_DECK, GROUP_CHARS, true)
	end)
end

local function setCharGroup(model: Model, group: string)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = group
		end
	end
end

-- ===== 타입 =====
export type RiderState = "DECK" | "WATER" | "HANGING" | "CLIMBING"

export type Rider = {
	id: string, -- ME | DURI | SAN | MIR
	rig: SquadNpcService.Rig?,
	seatKey: string,
	home: Vector3, -- 갑판 위 기본 자리 (Root 로컬 XZ)
	cur: Vector3, -- 지금 자리 (분대원: 모터 C0 의 XZ)
	goal: Vector3, -- 옮겨 가는 자리
	moveFrom: Vector3,
	moveAt: number, -- 옮기기 시작 시각
	moveSec: number,
	motor: Motor6D?, -- 분대원: Root → HRP
	weld: WeldConstraint?, -- 나: 매달림·올라올 때
	state: RiderState,
	stateAt: number,
	offDeckSince: number?,
	falls: number,
	prompt: ProximityPrompt?,
	late: boolean, -- 이번 장애물에 늦게 옮긴다
	lateUntil: number,
	ropeIndex: number,
	pulledBy: string?,
	hip: number,
	-- 급류 2차: 클라이언트 RideCrew 가 읽는 리그 속성 (바뀔 때만 씀)
	rowOn: any, -- RideRow: 노 젓는 힘 (0 · 0.45 급류 천천히 · 1 힘차게, false 쉼)
	seatOn: boolean?, -- RideSeat: 갑판 위 (노·몸짓 보임)
	leanAttr: number, -- RideLean: −1 왼쪽 · 0 · 1 오른쪽으로 몸을 싣는 중
	duckAttr: boolean, -- RideDuck: 가지 — 가운데에서 몸을 숙임
	gestureUntil: number, -- 손짓(가리키기·환호·당기기) 동안은 노를 쉰다
}

export type Obstacle = {
	part: BasePart,
	rideType: string, -- ROCK | BRANCH | FALLS | WAVE | FINISH
	side: string?,
	s: number,
	state: string, -- PENDING | WARNED | DONE
	pos: Vector3,
	-- 급류 2차: 아이를 먼저 본다 (WAIT → LED 아이가 먼저 · FIX 반대로 가서 미르가 바로잡음 · LATE 아무도 안 움직여 늦게)
	warnAt: number,
	decision: string?,
	led: boolean,
	safeX: number,
	cue: string?,
	ducked: boolean?, -- 가지: 분대원이 숙였나
}

-- 물 위 줍기 (급류 2차)
export type Item = {
	index: number,
	part: BasePart,
	side: string, -- L | R
	item: string, -- WOOD | WATER
	s: number,
	pos: Vector3, -- 떠 있는 자리 (수면)
	lat: number, -- 스플라인에서 옆으로 (오른쪽 +)
	model: Model?,
	state: string, -- FLOAT | TAKEN | MISSED
	called: boolean,
}

type Spline = { samples: { Vector3 }, sampleS: { number }, length: number }

export type Handle = {
	userId: number,
	kind: Kind,
	day: number,
	boat: BoatService.BoatHandle,
	character: Model?,
	riders: { Rider },
	byId: { [string]: Rider },
	spline: Spline,
	obstacles: { Obstacle },
	finishS: number,
	deck: Part,
	attach: Attachment,
	align: AlignPosition,
	orient: AlignOrientation,
	ropes: { Attachment },
	boardPrompt: ProximityPrompt,
	phase: string, -- BOARD | COUNT | RUN | FINISH | DONE
	phaseAt: number,
	s: number, -- 목표가 스플라인에서 온 거리
	boatS: number, -- 배 실제 위치의 거리
	speed: number,
	moving: boolean, -- W 노 젓기 (급류·바다)
	steer: number, -- A/D 방향 −1..1
	lat: number, -- 옆 자리 (스플라인에서 오른쪽 + stud)
	latVel: number,
	rowPower: number, -- 0..1 젓기가 붙는 정도 (RowRampSec)
	seat: Seat?, -- 내 자리 (튜브 위)
	unseatedSince: number?, -- DECK 인데 자리에서 떨어진 때 (다시 앉힌다)
	meAttrs: { [string]: any }, -- 내 캐릭터 속성(RideSeat·RideRow·RideSide) 바뀔 때만 씀
	slowUntil: number, -- 쿵: 이때까지 크게 느림
	spinAt: number, -- 쿵: 빙 도는 시작
	spinDir: number,
	lastRockHit: boolean, -- 바로 앞 바위도 쿵이었나 (연속 두 번이면 한 사람이 빠진다)
	massSaved: { [BasePart]: boolean }?, -- 앉은 동안 무게 없앤 내 캐릭터 파트의 원래 Massless
	roll: number, -- 지금 기울기(도)
	rollBias: number,
	cargoKg: number,
	steady: boolean, -- 짐에 물통(WATER): 덜 흔들리고 가장자리에서 덜 빠진다 (GameConfig.Ride.WaterRollMul·WaterEdgeBonus)
	speedMul: number,
	bumpAt: number,
	bumpDir: number,
	bumpScale: number, -- 쿵 1 · 긁힘 ScrapeScale (급류 2차)
	cue: string?,
	cueUntil: number,
	jumpState: boolean,
	jumpWindowUntil: number,
	lastWheeAt: number,
	cheerAt: number,
	finishedAt: number?,
	done: boolean,
	events: {
		falls: number,
		bumps: number,
		dodges: number,
		pulls: number,
		selfClimbs: number,
		npcPulls: number,
		ledByMe: number, -- 아이가 먼저 맞는 쪽으로 움직인 바위·파도 수 (급류 2차 — 밤 일지, 점수 아님)
		scrapes: number, -- 늦게 피해 긁힌 수
		items: number, -- 건진 것 (장작+물통)
	},
	itemsGot: { [string]: number }, -- WOOD | WATER → 수
	items: { Item },
	itemCalls: number,
	itemFolder: Folder?,
	followTurn: number, -- 따라오는 말을 돌아가며
	bot: string?, -- Studio 검증 봇 (devBot): IDLE | LEAD | ITEMS
	botAt: number,
	pullLog: { { who: string, by: string } }, -- 올라온 사람과 끌어올린 사람 (ME | 분대원 id | SELF) — 밤 일지·고마움 (가설 2)
	boardSince: number?,
	boardFixAt: number, -- BOARD 에서 못 탔을 때 갑판에 놓아 준 시각
	startAt: number,
	cbs: Cbs,
}

export type Cbs = {
	lines: (any) -> (),
	fx: (string, { [string]: any }?) -> (),
	bubble: (string, string, number?) -> (),
	finish: () -> (),
	dirty: () -> (),
	item: ((string, number) -> ())?, -- 급류 2차: 건진 것 (WOOD|WATER, n) → 오늘 밤 모닥불 주머니 (SessionService → CampfireService.addWood)
}

local function hrpOf(model: Model?): BasePart?
	local p = model and model:FindFirstChild("HumanoidRootPart")
	return if p and p:IsA("BasePart") then p else nil
end

local function humOf(model: Model?): Humanoid?
	return if model then model:FindFirstChildOfClass("Humanoid") else nil
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

-- ===== 스플라인 (Catmull-Rom, 호 길이 표) =====
local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end

local function buildSpline(points: { Vector3 }): Spline
	local n = #points
	local samples: { Vector3 } = {}
	local sampleS: { number } = {}
	if n == 0 then
		return { samples = { Vector3.zero }, sampleS = { 0 }, length = 0 }
	elseif n == 1 then
		return { samples = { points[1] }, sampleS = { 0 }, length = 0 }
	end
	local total = 0
	table.insert(samples, points[1])
	table.insert(sampleS, 0)
	local prev = points[1]
	local STEPS = 10
	for i = 1, n - 1 do
		local p0 = points[math.max(1, i - 1)]
		local p1 = points[i]
		local p2 = points[i + 1]
		local p3 = points[math.min(n, i + 2)]
		for k = 1, STEPS do
			local p = catmull(p0, p1, p2, p3, k / STEPS)
			total += (p - prev).Magnitude
			table.insert(samples, p)
			table.insert(sampleS, total)
			prev = p
		end
	end
	return { samples = samples, sampleS = sampleS, length = total }
end

-- 거리 s 의 위치와 진행 방향(단위, y 포함)
local function splineAt(sp: Spline, s: number): (Vector3, Vector3)
	local n = #sp.samples
	if n < 2 then
		return sp.samples[1], Vector3.new(0, 0, -1)
	end
	local sc = math.clamp(s, 0, sp.length)
	-- 이진 탐색
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if sp.sampleS[mid] <= sc then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = sp.samples[lo], sp.samples[hi]
	local sa, sb = sp.sampleS[lo], sp.sampleS[hi]
	local t = if sb > sa then (sc - sa) / (sb - sa) else 0
	local pos = a:Lerp(b, t)
	-- 방향: 앞뒤 표본으로 (끝에선 마지막 구간)
	local i0, i1 = math.max(1, lo - 1), math.min(n, hi + 1)
	local d = sp.samples[i1] - sp.samples[i0]
	if s > sp.length then
		pos += (b - a).Unit * (s - sp.length) -- 끝을 지나면 직선으로 (해변 위로 밀려 올라간다)
	end
	return pos, if d.Magnitude > 0.001 then d.Unit else Vector3.new(0, 0, -1)
end

-- 점을 스플라인에 투영한 거리 (XZ)
local function splineProject(sp: Spline, p: Vector3, hint: number?): number
	local n = #sp.samples
	local bestI, bestD = 1, math.huge
	local from, to = 1, n
	if hint then
		-- 힌트 주변 ±40 stud 만 (U 턴에서 건너편 구간을 잡지 않게)
		from, to = n, 1
		for i = 1, n do
			if sp.sampleS[i] >= hint - 40 then
				from = math.min(from, i)
			end
			if sp.sampleS[i] <= hint + 40 then
				to = math.max(to, i)
			end
		end
	end
	for i = from, to do
		local q = sp.samples[i]
		local d = (q.X - p.X) ^ 2 + (q.Z - p.Z) ^ 2
		if d < bestD then
			bestI, bestD = i, d
		end
	end
	-- 이웃 구간에 선형 투영
	local s = sp.sampleS[bestI]
	local function refine(i: number, j: number)
		local a, b = sp.samples[i], sp.samples[j]
		local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
		local l2 = ab:Dot(ab)
		if l2 < 0.001 then
			return
		end
		local u = math.clamp(Vector3.new(p.X - a.X, 0, p.Z - a.Z):Dot(ab) / l2, 0, 1)
		local q = a + ab * u
		local d = (q.X - p.X) ^ 2 + (q.Z - p.Z) ^ 2
		if d <= bestD then
			bestD = d
			s = sp.sampleS[i] + (sp.sampleS[j] - sp.sampleS[i]) * u
		end
	end
	if bestI > 1 then
		refine(bestI - 1, bestI)
	end
	if bestI < n then
		refine(bestI, bestI + 1)
	end
	return s
end

-- ===== 장면: RIDE 경로점·장애물 =====
type RawItem = { part: BasePart, side: string, item: string }
local function collectRide(
	day: number
): ({ Vector3 }, { { part: BasePart, rideType: string, side: string? } }, { RawItem })
	local pts: { { idx: number, pos: Vector3 } } = {}
	local obs = {}
	local items: { RawItem } = {}
	local folder = SceneBindings.getFolder("Triggers")
	if folder then
		for _, inst in ipairs(folder:GetChildren()) do
			if not inst:IsA("BasePart") or inst:GetAttribute("ProjectId") ~= SceneBindings.ProjectId then
				continue
			end
			if inst:GetAttribute("Kind") ~= "RIDE" or tonumber(inst:GetAttribute("Day")) ~= day then
				continue
			end
			local rt = inst:GetAttribute("RideType")
			if rt == "ITEM" then
				-- 물 위 줍기 (급류 2차): 장애물이 아니다 — 배가 옆을 지날 때 아이가 그쪽에 있으면 건진다
				local side = inst:GetAttribute("Side")
				local it = inst:GetAttribute("Item")
				table.insert(items, {
					part = inst,
					side = if side == "L" then "L" else "R",
					item = if it == "WATER" then "WATER" else "WOOD",
				})
			elseif typeof(rt) == "string" then
				table.insert(obs, { part = inst, rideType = rt, side = inst:GetAttribute("Side") :: string? })
			else
				table.insert(pts, { idx = tonumber(inst:GetAttribute("Index")) or 0, pos = inst.Position })
			end
		end
	end
	table.sort(pts, function(a, b)
		return a.idx < b.idx
	end)
	-- 실제 수면: 복셀 스무딩으로 수면이 경로점 y 와 0.2~1.4 어긋난다 → 경로점마다 물을 재서 그 높이에 띄운다 (물이 아니면 그대로)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	local out = {}
	for _, p in ipairs(pts) do
		local pos = p.pos
		local r = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -12, 0), params)
		if r and r.Material == Enum.Material.Water and math.abs(r.Position.Y - pos.Y) <= 2.5 then
			pos = Vector3.new(pos.X, r.Position.Y, pos.Z)
		end
		table.insert(out, pos)
	end
	return out, obs, items
end

-- ===== 유보트 물리 =====
local function makeBoatPhysical(h: Handle)
	local boat = h.boat
	local root = boat.root
	for _, p in ipairs(boat.model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root and p ~= h.deck and not p:IsDescendantOf(h.deck) then
			if not p:FindFirstChild("RideHullWeld") then
				local w = Instance.new("WeldConstraint")
				w.Name = "RideHullWeld"
				w.Part0 = root
				w.Part1 = p
				w.Parent = p
			end
			p.Anchored = false
			p.Massless = true
			p.CanCollide = false
			p.CollisionGroup = GROUP_BOAT
		end
	end
	root.CanCollide = false
	root.CollisionGroup = GROUP_BOAT
	root.Massless = false
	root.RootPriority = 20 -- 앉은 내 캐릭터가 붙어도 배 Root 가 덩어리 뿌리 (소유·정렬 기준)
	root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.2)
end

local function restoreBoat(h: Handle, finalCF: CFrame)
	local boat = h.boat
	local root = boat.root
	h.align.Enabled = false
	h.orient.Enabled = false
	local lf = root:FindFirstChild("RideLift")
	if lf and lf:IsA("VectorForce") then
		lf.Enabled = false
	end
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	for _, p in ipairs(boat.model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then
			local w = p:FindFirstChild("RideHullWeld")
			if w then
				w:Destroy()
			end
			p.Anchored = true
			p.Massless = false
			p.CanCollide = false
			p.CollisionGroup = "Default"
		end
	end
	root.CollisionGroup = "Default"
	root.RootPriority = 0
	root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
	BoatService.pivot(boat, finalCF)
end

-- 갑판: 바닥판 위와 같은 높이의 보이지 않는 발판 (튜브 사이, 튜브 중심까지)
local function makeDeck(h: Handle): Part
	local root = h.boat.root
	local deck = root:FindFirstChild("RideDeck") :: Part?
	if not deck then
		local d = Instance.new("Part")
		d.Name = "RideDeck"
		d.Size = Vector3.new(DECK_HALF_X * 2, 0.4, DECK_HALF_Z * 2)
		d.Transparency = 1
		d.CanCollide = true
		d.CanQuery = true
		d.CanTouch = true
		d.Anchored = false
		d.Massless = true
		d.CastShadow = false
		d.Material = Enum.Material.SmoothPlastic
		d.CustomPhysicalProperties = PhysicalProperties.new(0.3, CFG.DeckFriction, 0, 100, 1)
		d.CollisionGroup = GROUP_DECK
		d.CFrame = root.CFrame
		d.Parent = root
		local w = Instance.new("WeldConstraint")
		w.Name = "RideDeckWeld"
		w.Part0 = root
		w.Part1 = d
		w.Parent = d
		deck = d
		-- 난간 (보이지 않음, 탑승자만 막음 — 4·5단계 통합): 걷다가 미끄러져 빠지지 않게. 빠지는 건 바위·가지·파도 판정과 일부러 뛰어넘기뿐.
		-- 4일차 W·아이들의 "계속 앞으로" 가 뱃머리 밖으로 걸어 나가던 것 (프로토타입 OFFDECK 시나리오) 을 막는다
		local rh = CFG.RailHeight
		local y = 0.2 + rh / 2
		local rails = {
			{ Vector3.new(-(DECK_HALF_X + 0.25), y, 0), Vector3.new(0.5, rh, DECK_HALF_Z * 2 + 1) },
			{ Vector3.new(DECK_HALF_X + 0.25, y, 0), Vector3.new(0.5, rh, DECK_HALF_Z * 2 + 1) },
			{ Vector3.new(0, y, -(DECK_HALF_Z + 0.25)), Vector3.new(DECK_HALF_X * 2 + 1, rh, 0.5) },
			{ Vector3.new(0, y, DECK_HALF_Z + 0.25), Vector3.new(DECK_HALF_X * 2 + 1, rh, 0.5) },
		}
		for i, r in ipairs(rails) do
			local rail = Instance.new("Part")
			rail.Name = "RideRail" .. i
			rail.Size = r[2]
			rail.Transparency = 1
			rail.CanCollide = true
			rail.CanQuery = false
			rail.CanTouch = false
			rail.Anchored = false
			rail.Massless = true
			rail.CastShadow = false
			rail.CollisionGroup = GROUP_DECK
			rail.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0, 0, 100, 1)
			rail.CFrame = root.CFrame * CFrame.new(r[1])
			rail.Parent = d
			local rw = Instance.new("WeldConstraint")
			rw.Part0 = root
			rw.Part1 = rail
			rw.Parent = rail
		end
	end
	return deck :: Part
end

-- 내 자리 Seat: 배치 자리 쪽 튜브 위 (앉으면 다리는 바닥판 쪽). 갑판 아래에 두어 갑판과 같이 지운다. 닿아서 앉지 않게 CanTouch 끔 — Seat:Sit 으로만
local SEAT_X = 2.3
local SEAT_Y = 1.5
local function makeSeat(h: Handle, seatKey: string): Seat
	local root = h.boat.root
	local old = h.deck:FindFirstChild("RideSeatMe")
	if old then
		old:Destroy()
	end
	local sx = if SquadCatalog.isLeft(seatKey) then -1 else 1
	local z = if SquadCatalog.isFront(seatKey) then -2.5 else 3.0
	local s = Instance.new("Seat")
	s.Name = "RideSeatMe"
	s.Size = Vector3.new(1.6, 0.3, 1.6)
	s.Transparency = 1
	s.CanCollide = false
	s.CanTouch = false
	s.CanQuery = false
	s.Anchored = false
	s.Massless = true
	s.CastShadow = false
	s.CollisionGroup = GROUP_BOAT
	s.CFrame = root.CFrame * CFrame.new(sx * SEAT_X, SEAT_Y, z)
	s:SetAttribute("RideSide", sx)
	s.Parent = h.deck
	local w = Instance.new("WeldConstraint")
	w.Name = "RideSeatWeld"
	w.Part0 = root
	w.Part1 = s
	w.Parent = s
	return s
end

-- ===== 내 캐릭터 옮기기 (클라이언트 소유를 잠깐 서버로) =====
local function serverMove(character: Model, cf: CFrame, holdSec: number?)
	local hrp = hrpOf(character)
	local player = Players:GetPlayerFromCharacter(character)
	if hrp and player then
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
		hrp.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(cf)
		task.delay(holdSec or 0.4, function()
			if hrp.Parent and player.Parent and not hrp:FindFirstChild("RideHangWeld") then
				pcall(function()
					hrp:SetNetworkOwner(player)
				end)
			end
		end)
	else
		character:PivotTo(cf)
	end
end

local function makePrompt(
	parent: Instance,
	action: string,
	obj: string,
	hold: number,
	forUser: number?
): ProximityPrompt
	local pr = Instance.new("ProximityPrompt")
	pr.Name = "RidePrompt"
	pr.ActionText = action
	pr.ObjectText = obj
	pr.KeyboardKeyCode = Enum.KeyCode.E
	pr.GamepadKeyCode = Enum.KeyCode.ButtonX
	pr.MaxActivationDistance = CFG.PullDistance
	pr.RequiresLineOfSight = false
	pr.HoldDuration = hold
	pr.Style = Enum.ProximityPromptStyle.Custom
	pr.Enabled = false
	if forUser then
		pr:SetAttribute("ForUserId", forUser)
	end
	pr:SetAttribute("PromptIcon", "➰")
	pr.Parent = parent
	return pr
end

-- ===== 자리 =====
local function seatHome(seatKey: string): Vector3
	local sx = if SquadCatalog.isLeft(seatKey) then -1 else 1
	local z = if SquadCatalog.isFront(seatKey) then -2.5 else 3.0
	return Vector3.new(sx * CFG.NpcHomeX, 0, z)
end

local function riderHrp(h: Handle, r: Rider): BasePart?
	if r.rig then
		return r.rig.hrp
	end
	return hrpOf(h.character)
end

-- 갑판 위 로컬 좌표
local function localOf(h: Handle, pos: Vector3): Vector3
	return h.boat.root.CFrame:PointToObjectSpace(pos)
end

local function onDeckLocal(l: Vector3): boolean
	-- 위로는 넉넉히: 폭포 "붕" 점프 꼭대기(갑판 위 ~10)에서 갑판 밖으로 쳐서 빠지던 것 (Studio 4·5단계 통합)
	return math.abs(l.X) <= DECK_HALF_X + 0.6 and math.abs(l.Z) <= DECK_HALF_Z + 0.8 and l.Y > -1.2 and l.Y < 16
end

-- 분대원 모터 (Root → HRP). C0 을 트윈하면 갑판 위를 미끄러져 옮긴다 (조립체를 끌지 않는다)
local function npcMotorCF(r: Rider, xz: Vector3): CFrame
	return CFrame.new(xz.X, 0.2 + r.hip, xz.Z)
end

local function attachNpc(h: Handle, r: Rider, xz: Vector3)
	local rig = r.rig
	if not rig then
		return
	end
	if r.motor then
		r.motor:Destroy()
		r.motor = nil
	end
	local root = h.boat.root
	rig.humanoid:Move(Vector3.zero)
	rig.humanoid.PlatformStand = true
	rig.humanoid.EvaluateStateMachine = false
	rig.humanoid.AutoRotate = false
	for _, p in ipairs(rig.model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Massless = true
			p.CanCollide = false
			p.Anchored = false
			p.CollisionGroup = GROUP_CHARS
		end
	end
	rig.hrp.AssemblyLinearVelocity = Vector3.zero
	rig.model:PivotTo(root.CFrame * npcMotorCF(r, xz))
	local m = Instance.new("Motor6D")
	m.Name = "RideMotor"
	m.Part0 = root
	m.Part1 = rig.hrp
	m.C0 = npcMotorCF(r, xz)
	m.C1 = CFrame.identity
	m.Parent = rig.hrp
	r.motor = m
	r.cur = xz
	r.goal = xz
	r.moveFrom = xz
	r.moveAt = -99
	r.moveSec = 0
	SquadNpcService.setSitting(rig, false)
	BoatService.pose(rig.model, "NONE")
end

local function detachNpc(r: Rider)
	if r.motor then
		r.motor:Destroy()
		r.motor = nil
	end
end

-- 리그 속성 (급류 2차, 클라이언트 RideCrew 가 몸짓으로 그린다): 바뀔 때만 쓴다 (매 프레임 복제하지 않게)
local function setBodyAttrs(r: Rider, lean: number, duck: boolean)
	local rig = r.rig
	if not rig then
		return
	end
	if r.leanAttr ~= lean then
		r.leanAttr = lean
		rig.model:SetAttribute("RideLean", lean)
	end
	if r.duckAttr ~= duck then
		r.duckAttr = duck
		rig.model:SetAttribute("RideDuck", duck)
	end
end

local function setRowAttrs(r: Rider, row: any, seat: boolean?)
	local rig = r.rig
	if not rig then
		return
	end
	if r.rowOn ~= row then
		r.rowOn = row
		rig.model:SetAttribute("RideRow", row)
	end
	if r.seatOn ~= seat then
		r.seatOn = seat
		rig.model:SetAttribute("RideSeat", seat)
	end
end

-- 탑승이 끝나면 리그 속성을 지운다 (클라이언트가 팔·노·몸을 원래대로)
local function clearRideAttrs(r: Rider)
	local rig = r.rig
	if not rig then
		return
	end
	r.rowOn, r.seatOn, r.leanAttr, r.duckAttr = nil, nil, 0, false
	for _, k in ipairs({ "RideRow", "RideSeat", "RideLean", "RideDuck" }) do
		rig.model:SetAttribute(k, nil)
	end
end

-- 손짓 (playOnce 트랙 재사용 — SquadNpcService 캐시) 동안 노를 쉰다
local function gesture(r: Rider, anim: string, sec: number)
	local rig = r.rig
	if not rig or r.state ~= "DECK" then
		return
	end
	r.gestureUntil = os.clock() + sec
	setRowAttrs(r, false, r.seatOn)
	SquadNpcService.playOnce(rig, anim)
end

-- pose: LEAN(안전한 쪽으로 몸을 실음) | DUCK(가지 — 가운데에서 숙임) | nil(제자리)
local function npcMoveTo(r: Rider, xz: Vector3, sec: number, pose: string?)
	if not r.motor then
		return
	end
	r.moveFrom = r.cur
	r.goal = xz
	r.moveAt = os.clock()
	r.moveSec = math.max(0.05, sec)
	if pose == "LEAN" then
		setBodyAttrs(r, if xz.X < 0 then -1 else 1, false)
	elseif pose == "DUCK" then
		setBodyAttrs(r, 0, true)
	else
		setBodyAttrs(r, 0, false)
	end
end

local function tickNpcMotor(r: Rider, now: number)
	local m = r.motor
	if not m then
		return
	end
	if (r.goal - r.cur).Magnitude > 0.01 then
		local t = math.clamp((now - r.moveAt) / r.moveSec, 0, 1)
		local e = TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		r.cur = r.moveFrom:Lerp(r.goal, e)
		-- 옮기는 동안 그쪽을 살짝 본다
		local d = r.goal - r.moveFrom
		local yaw = if d.Magnitude > 0.2 and t < 1 then math.atan2(-d.X, -d.Z) * 0.6 else 0
		m.C0 = npcMotorCF(r, r.cur) * CFrame.Angles(0, yaw, 0)
	end
end

-- 내 자리 (앉아서 직접 젓기): 튜브 위 Seat 에 앉힌다 (Seat:Sit — SeatWeld 로 배 덩어리에 붙는다, 걸어 다니지 않음).
-- 리스폰·끌어올림·건너뛰기·검증이 같이 쓴다. 앉는 동안(CLIMBING 0.35초)은 빠짐 판정을 하지 않는다.
-- 서버가 배를 돌리면(ServerOwnsBoat) 앉은 뒤 덩어리 소유를 다시 서버로 (내 HRP 가 붙으며 내 클라이언트로 넘어가지 않게)
-- 앉은 동안 내 캐릭터를 무게 없이: 앉은 Humanoid 가 붙어 있으면 배가 목표보다 1.2 stud 처져 바닥으로 물이 보였다
-- (Studio 측정: 앉음 err −1.24 · 일어섬 −0.03 · 캐릭터 Massless −0.00 — 2026-10-21 "배 바닥에 자꾸 물"). 일어서면 원래대로
local function setCharMassless(h: Handle, on: boolean)
	local ch = h.character
	if not ch then
		return
	end
	if on then
		if h.massSaved then
			return
		end
		local saved: { [BasePart]: boolean } = {}
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then
				saved[p] = p.Massless
				p.Massless = true
			end
		end
		h.massSaved = saved
	else
		local saved = h.massSaved
		if not saved then
			return
		end
		h.massSaved = nil
		for p, was in pairs(saved) do
			if p.Parent then
				p.Massless = was
			end
		end
	end
end

local function unseatMe(h: Handle)
	setCharMassless(h, false)
	local seat = h.seat
	if seat then
		local sw = seat:FindFirstChild("SeatWeld")
		if sw then
			sw:Destroy()
		end
	end
	local hum = humOf(h.character)
	if hum and hum.Sit then
		hum.Sit = false
	end
end

local function seatedNow(h: Handle): boolean
	local seat = h.seat
	local hum = humOf(h.character)
	return seat ~= nil and hum ~= nil and seat.Occupant == hum
end

local function sitMe(h: Handle)
	local me = h.byId.ME
	local ch = h.character
	local hrp = hrpOf(ch)
	local hum = humOf(ch)
	local seat = h.seat
	if not me or not ch or not hrp or not hum or not seat or h.done then
		return
	end
	local root = h.boat.root
	if me.weld then
		me.weld:Destroy()
		me.weld = nil
	end
	ch:SetAttribute("CampHanging", nil)
	me.state = "CLIMBING"
	me.stateAt = os.clock()
	me.offDeckSince = nil
	h.unseatedSince = nil
	pcall(function()
		hrp:SetNetworkOwner(nil)
	end)
	hum.PlatformStand = false
	hrp.AssemblyLinearVelocity = root.AssemblyLinearVelocity
	ch:PivotTo(seat.CFrame * CFrame.new(0, me.hip, 0))
	if seat.Occupant ~= hum then
		seat:Sit(hum)
	end
	setCharMassless(h, true)
	if CFG.ServerOwnsBoat then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	task.delay(0.35, function()
		if me.state == "CLIMBING" and not h.done and h.character == ch then
			me.state = "DECK"
			me.stateAt = os.clock()
			h.cbs.dirty()
		end
	end)
	h.cbs.dirty()
end

-- ===== 빠짐·매달림·끌어올리기 =====
local function setCue(h: Handle, cue: string?, sec: number)
	h.cue = cue
	h.cueUntil = os.clock() + sec
	h.cbs.dirty()
end

local function memberName(id: string): string
	local m = SquadCatalog.get(id)
	return if m then m.nameKo else id
end

local function ropeFor(h: Handle, r: Rider): Attachment
	-- 매달리는 자리 3: 비어 있는 것부터
	local usedIdx: { [number]: boolean } = {}
	for _, o in ipairs(h.riders) do
		if o ~= r and (o.state == "HANGING") then
			usedIdx[o.ropeIndex] = true
		end
	end
	for i = 1, #h.ropes do
		if not usedIdx[i] then
			r.ropeIndex = i
			return h.ropes[i]
		end
	end
	r.ropeIndex = 1
	return h.ropes[1]
end

local function fall(h: Handle, r: Rider, why: string?)
	-- 도착 중(FINISH)엔 세지 않는다: 바다 4일차 봇이 섬 부두 모서리에 밀려 갑판 밖으로 나가 낙수 1 이 더해졌다 (Studio 2026-10-21)
	if r.state ~= "DECK" or h.done or h.phase == "FINISH" or h.phase == "DONE" then
		return
	end
	local now = os.clock()
	r.state = "WATER"
	r.stateAt = now
	r.falls += 1
	h.events.falls += 1
	local root = h.boat.root
	local hrp = riderHrp(h, r)
	local lx = if hrp then localOf(h, hrp.Position).X else 0
	local side = if lx < 0 then -1 else 1
	local dropCF = root.CFrame * CFrame.new(side * 3.5, -1.2, HALF_L + 3)
	local waterPos = Vector3.new(dropCF.Position.X, root.Position.Y - CFG.RootHeight - 0.8, dropCF.Position.Z)
	local lookDir = flat(root.CFrame.LookVector)
	local cf = CFrame.lookAt(waterPos, waterPos + lookDir)
	if r.rig then
		detachNpc(r)
		setBodyAttrs(r, 0, false)
		setRowAttrs(r, false, false)
		local rig = r.rig
		rig.hrp.Anchored = true -- 물에 떠서 멀어진다 (배가 간다)
		rig.model:PivotTo(cf * CFrame.new(0, 1.0, 0))
		SquadNpcService.setMood(rig, "SCARED")
		h.cbs.bubble(r.id, L.fell[r.id] or L.aak, 2)
	elseif h.character then
		unseatMe(h) -- 자리에서 떨어져 물로
		local hum = humOf(h.character)
		if hum then
			hum.PlatformStand = false
			hum.Sit = false
		end
		-- 이미 몸으로 떨어진 것이면 그 자리에서 헤엄친다. 판정으로 빠진 것이면 배 뒤 물로 옮긴다
		local alreadyIn = hrp ~= nil
			and not onDeckLocal(localOf(h, (hrp :: BasePart).Position))
			and (hrp :: BasePart).Position.Y < root.Position.Y + 1
		if not alreadyIn then
			serverMove(h.character, cf * CFrame.new(0, 1.2, 0), 0.4)
		end
		-- 아래 자막 줄은 쓰지 않는다: 줄 대기열이 밀려 몇 초 늦게 떴다 (Studio 4·5단계). 할 일 판 보조 줄(meState)·물보라가 바로 알린다
	end
	h.cbs.fx("SPLASH", { pos = waterPos, memberId = r.id, why = why })
	h.cbs.dirty()
end

local function hang(h: Handle, r: Rider)
	if r.state ~= "WATER" or h.done then
		return
	end
	local now = os.clock()
	local rope = ropeFor(h, r)
	local root = h.boat.root
	r.state = "HANGING"
	r.stateAt = now
	r.pulledBy = nil
	local target = rope.WorldCFrame
	if r.rig then
		local rig = r.rig
		rig.hrp.Anchored = false
		rig.model:PivotTo(target)
		local m = Instance.new("Motor6D")
		m.Name = "RideMotor"
		m.Part0 = root
		m.Part1 = rig.hrp
		m.C0 = rope.CFrame * CFrame.Angles(math.rad(-25), 0, 0)
		m.C1 = CFrame.identity
		m.Parent = rig.hrp
		r.motor = m
		SquadNpcService.setMood(rig, "HANGING")
		h.cbs.bubble(r.id, L.hanging[r.id] or L.aak, 2)
		if r.prompt then
			r.prompt.Enabled = true
		end
	elseif h.character then
		local ch = h.character
		local hrp = hrpOf(ch)
		local hum = humOf(ch)
		if hrp and hum then
			pcall(function()
				hrp:SetNetworkOwner(nil)
			end)
			hum.PlatformStand = true
			hrp.AssemblyLinearVelocity = Vector3.zero
			ch:PivotTo(target * CFrame.Angles(math.rad(-25), 0, 0))
			local w = Instance.new("WeldConstraint")
			w.Name = "RideHangWeld"
			w.Part0 = root
			w.Part1 = hrp
			w.Parent = hrp
			r.weld = w
			ch:SetAttribute("CampHanging", true)
			if r.prompt then
				r.prompt.Enabled = true
			end
		end
		-- (자막 줄 없음 — 할 일 판 "➰ 매달렸어요" 와 밧줄 연출)
	end
	h.cbs.fx("HANG", { memberId = r.id })
	h.cbs.dirty()
end

-- 갑판으로 올라옴 (끌어올려졌거나 혼자). 잠깐 갑판에 붙였다 풀어 관성을 받게 한다
local function climb(h: Handle, r: Rider, by: string?)
	if r.state ~= "HANGING" or h.done then
		return
	end
	local now = os.clock()
	local root = h.boat.root
	r.state = "CLIMBING"
	r.stateAt = now
	if r.prompt then
		r.prompt.Enabled = false
	end
	local landing = Vector3.new(0, 0, 1.5)
	if r.rig then
		local rig = r.rig
		attachNpc(h, r, landing)
		SquadNpcService.setMood(rig, "IDLE")
		if by then
			h.cbs.bubble(r.id, L.thanks[r.id] or L.aak, 1.8)
		else
			h.cbs.bubble(r.id, L.climbed[r.id] or L.aak, 1.6)
		end
		task.delay(CFG.ReweldSec + 0.3, function()
			if r.state == "CLIMBING" and not h.done then
				r.state = "DECK"
				r.stateAt = os.clock()
				npcMoveTo(r, r.home, 0.6)
				h.cbs.dirty()
			end
		end)
	elseif h.character then
		-- 앉아서 직접 젓기: 밧줄에서 올라오면 바로 내 자리에 앉는다 (sitMe 가 CLIMBING → DECK)
		sitMe(h)
		-- (자막 줄 없음 — 판이 바로 돌아오고, 끌어 준 분대원 말풍선이 말한다)
	end
	table.insert(h.pullLog, { who = r.id, by = by or "SELF" })
	if by then
		h.events.pulls += 1
		if by ~= "ME" then
			h.events.npcPulls += 1
			local puller = h.byId[by]
			if puller and puller.rig then
				h.cbs.bubble(by, L.pullCall[by] or L.aak, 1.4)
				puller.gestureUntil = os.clock() + 1.0 -- 당기는 팔 (노를 쉰다)
				setRowAttrs(puller, false, puller.seatOn)
				BoatService.pose(puller.rig.model, "LIFT")
				npcMoveTo(puller, puller.home, 0.8)
			end
		elseif h.character then
			BoatService.pose(h.character, "LIFT")
		end
	else
		h.events.selfClimbs += 1
	end
	h.cbs.fx("RESCUE", { pos = root.CFrame:PointToWorldSpace(Vector3.new(0, 0, HALF_L)), memberId = r.id, by = by })
	h.cbs.dirty()
end

-- 가까운(갑판 위) 분대원이 매달린 사람 쪽으로 가서 당긴다
local function npcPull(h: Handle, target: Rider)
	local best: Rider? = nil
	for _, o in ipairs(h.riders) do
		if o ~= target and o.rig and o.state == "DECK" then
			if not best or (o.cur.Z > (best :: Rider).cur.Z) then
				best = o -- 제일 뒤에 있는 사람
			end
		end
	end
	if not best then
		return
	end
	local puller = best :: Rider
	npcMoveTo(puller, Vector3.new(math.clamp(h.ropes[target.ropeIndex].Position.X, -1.6, 1.6), 0, 5.2), 0.4)
	target.pulledBy = puller.id
	task.delay(0.45, function()
		if target.state == "HANGING" and not h.done then
			climb(h, target, puller.id)
		end
	end)
end

-- ===== 장애물 (앉아서 직접 젓기, 2026-10-21) =====
-- 경고(할 일 판 ⬅/➡ · 갑판 빛)가 뜨면, 판정은 지나는 순간 배의 옆 자리(lat)로만 한다 (몸무게·걷기 없음):
--   바위 반대쪽으로 RockClearLat 넘게 비켜 있으면 깨끗이 비껴감 (내가 방향 잡아 피한 바위 +1)
--   가운데쯤이면 긁힘 (물보라·작은 흔들림, 빠지지 않음) — 아무것도 안 해도 지나간다 ("막지 않는다", 27 §1 ①)
--   바위 쪽으로 RockBumpLat 넘게 가 있으면 쿵 (속도 뚝, 옆으로 튕김). 세게(RockHardLat·RockHardSpeed) 박을 때만 드물게 그쪽 사람이 빠진다.
-- 분대원은 내 방향을 따라 몸을 싣고(RideLean), 가지 앞에선 숙인다(RideDuck). 새 말은 붙이지 않는다 (조용한 분대 — 말은 SessionService 가 거른다)
local function caller(h: Handle): string
	local mir = h.byId.MIR
	if mir and mir.state == "DECK" then
		return "MIR"
	end
	local san = h.byId.SAN
	if san and san.state == "DECK" then
		return "SAN"
	end
	return "DURI"
end

local function warnObstacle(h: Handle, o: Obstacle)
	o.state = "WARNED"
	o.warnAt = os.clock()
	local cue: string? = nil
	if o.rideType == "ROCK" then
		cue = if o.side == "L" then "RIGHT" else "LEFT"
		o.safeX = if o.side == "L" then 1 else -1
		-- 바위 위 빨간 ▼ (클라이언트 RideFx): 둑에서 튀어나온 바위 무더기 자리 (수로 가운데에서 그쪽으로 RockMarkLat)
		local sp, sd = splineAt(h.spline, o.s)
		local right = flat(sd):Cross(Vector3.yAxis)
		local mark = sp + right * ((if o.side == "L" then -1 else 1) * CFG.RockMarkLat) + Vector3.new(0, 4, 0)
		h.cbs.fx("ROCK_WARN", { pos = mark, side = o.side, sec = CFG.WarnSec + 1.5 })
	elseif o.rideType == "WAVE" then
		cue = "ROW" -- 파도: 저으면서 넘으면 덜 흔들리고 아무도 안 빠진다
		o.safeX = if o.side == "L" then 1 else -1
		h.cbs.fx("WAVE_WARN", { pos = o.pos, side = o.side, sec = CFG.WaveWarnSec })
		h.cbs.bubble(caller(h), L.waveWarn[o.side or "L"] or L.aak, 1.4)
	elseif o.rideType == "FALLS" then
		local r = h.byId[caller(h)]
		if r then
			gesture(r, "point", 1.0)
		end
	end
	o.cue = cue
	o.decision = "NONE"
	if cue then
		setCue(h, cue, if o.rideType == "WAVE" then CFG.WaveWarnSec + 0.5 else CFG.WarnSec + 0.5)
	end
	h.cbs.dirty()
end

-- 이 쪽(sideSign −1 왼쪽/+1 오른쪽) 자리에 앉은 사람 (분대원 먼저 — 빠지면 아이가 E 로 끌어올린다, 가설 2)
local function ridersOnSide(h: Handle, sideSign: number): { Rider }
	local npcs, mine = {}, {}
	for _, r in ipairs(h.riders) do
		if r.state == "DECK" and r.home.X * sideSign > 0 then
			table.insert(if r.rig then npcs else mine, r)
		end
	end
	for i = #npcs, 2, -1 do
		local j = math.random(i)
		npcs[i], npcs[j] = npcs[j], npcs[i]
	end
	for _, r in ipairs(mine) do
		table.insert(npcs, r)
	end
	return npcs
end

local function deckNpc(h: Handle): Rider?
	local list = {}
	for _, r in ipairs(h.riders) do
		if r.rig and r.state == "DECK" then
			table.insert(list, r)
		end
	end
	return if #list > 0 then list[math.random(#list)] else nil
end

local function passObstacle(h: Handle, o: Obstacle)
	o.state = "DONE"
	local now = os.clock()
	if o.rideType == "ROCK" then
		local sideSign = if o.side == "L" then -1 else 1
		local into = h.lat * sideSign -- + 바위 쪽으로 가 있음
		if into <= -CFG.RockClearLat then
			-- 방향을 잡아 반대쪽으로: 깨끗이
			o.led = true
			h.lastRockHit = false
			h.events.dodges += 1
			h.events.ledByMe += 1
			h.cbs.fx("DODGE", { pos = o.pos, side = o.side, led = true })
		elseif into <= -CFG.RockScrapeLat then
			-- 아슬아슬하게 비켜 섰다: 스친다 (물보라·작은 흔들림, 빠지지 않음)
			h.lastRockHit = false
			h.events.dodges += 1
			h.events.scrapes += 1
			h.bumpAt = now
			h.bumpDir = -sideSign
			h.bumpScale = CFG.ScrapeScale
			h.latVel = -sideSign * CFG.LatSpeed * 0.3
			h.speed *= CFG.ScrapeSlow
			h.cbs.fx("SCRAPE", { pos = o.pos, side = o.side })
		else
			-- 못 피함: 쿵 — 반대쪽으로 튕기며 빙 돌고 BumpSlowSec 동안 크게 느려진다 (멈추진 않음). 할 일 판 "쿵!" + 🪨 수
			-- 사람이 빠지는 건 바로 앞 바위도 쿵이었을 때만 (연속 두 번 — 드물게)
			local twice = h.lastRockHit
			h.lastRockHit = true
			h.events.bumps += 1
			h.bumpAt = now
			h.bumpDir = -sideSign
			h.bumpScale = 1
			h.lat -= sideSign * CFG.BumpLatPush
			h.latVel = -sideSign * CFG.LatSpeed * 0.6
			h.speed *= CFG.BumpSlow
			h.slowUntil = now + CFG.BumpSlowSec
			h.spinAt = now
			h.spinDir = -sideSign
			setCue(h, "BUMP", CFG.BumpSlowSec)
			h.cbs.fx("BUMP", { pos = o.pos, side = o.side, twice = twice })
			if twice then
				h.lastRockHit = false -- 빠진 뒤엔 다시 두 번 연속이어야
				local victim = ridersOnSide(h, sideSign)[1]
				if victim then
					fall(h, victim, "ROCK")
				end
			end
		end
	elseif o.rideType == "BRANCH" then
		h.cbs.fx("BRANCH", { pos = o.pos, led = true })
	elseif o.rideType == "FALLS" then
		h.cbs.fx("WATERFALL", { pos = o.pos })
		-- 다 같이 팔을 든다 "와아!" (cheer 트랙 재사용)
		local k = 0
		for _, r in ipairs(h.riders) do
			if r.rig and r.state == "DECK" then
				k += 1
				gesture(r, "cheer", 1.5)
				local line = L.fallsCheer[r.id]
				if line then
					task.delay((k - 1) * 0.15, function()
						if not h.done then
							h.cbs.bubble(r.id, line, 1.2)
						end
					end)
				end
			end
		end
	elseif o.rideType == "WAVE" then
		local sideSign = if o.side == "L" then -1 else 1
		local me = h.byId.ME
		local led = h.moving and me ~= nil and me.state == "DECK"
		o.led = led
		h.cbs.fx("WAVE", { pos = o.pos, side = o.side, led = led })
		h.bumpAt = now
		h.bumpDir = -sideSign
		h.bumpScale = if led then CFG.ScrapeScale else 1
		h.latVel = -sideSign * CFG.WavePushVel * (if led then 0.5 else 1) -- 파도 반대쪽으로 밀린다
		if led then
			h.events.dodges += 1
			h.events.ledByMe += 1
		elseif math.random() < CFG.WaveFallChance then
			local victim = ridersOnSide(h, sideSign)[1]
			if victim then
				fall(h, victim, "WAVE")
			end
		end
	elseif o.rideType == "FINISH" then
		if h.phase == "RUN" then
			h.phase = "FINISH"
			h.phaseAt = now
			h.cbs.fx("FINISH_NEAR", { pos = o.pos })
		end
	end
	h.cbs.dirty()
end

-- ===== 물 위 줍기 (급류 2차 — Build a Boat 보물 줍기 꼴) =====
-- 수로 옆에 장작 묶음·물통이 떠 있다(세션마다, 나만 보임). 배가 옆을 지날 때 아이가 A/D 로 배를 그쪽으로 몰았으면 건진다
-- → 오늘 밤 모닥불 주머니 (cbs.item). 분대원은 배를 몰지 않는다(방향은 아이 몫).
-- 놓쳐도 벌 없음 — 그냥 떠내려간다. 바위와 같은 쪽 바로 앞에 놓인 것은 "주울까, 먼저 피할까" 고르는 자리.
local ITEM_SIZE = { WOOD = Vector3.new(2.5, 1.3, 2.9), WATER = Vector3.new(1.3, 1.95, 1.2) } :: { [string]: Vector3 }
local ITEM_KEY = { WOOD = "FirewoodPile", WATER = "Jerrycan" } :: { [string]: string }

local function waterSurfaceAt(pos: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	local r = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -12, 0), params)
	if r and r.Material == Enum.Material.Water then
		return r.Position.Y
	end
	return pos.Y
end

-- 라이브러리가 없는 place: 기본 파트로 (통나무 셋 + 끈 / 파란 물통 + 노란 뚜껑)
local function fallbackItem(kind: string, cf: CFrame): Model
	local m = Instance.new("Model")
	local first: BasePart? = nil
	local function p(size: Vector3, rel: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType?): Part
		local q = Instance.new("Part")
		q.Size = size
		q.CFrame = cf * rel
		q.Color = color
		q.Material = mat
		if shape then
			q.Shape = shape
		end
		q.Parent = m
		if not first then
			first = q
		end
		return q
	end
	if kind == "WATER" then
		p(
			Vector3.new(1.15, 1.5, 0.75),
			CFrame.new(0, -0.15, 0),
			Color3.fromRGB(52, 122, 196),
			Enum.Material.SmoothPlastic
		)
		p(
			Vector3.new(0.32, 0.28, 0.32),
			CFrame.new(0.3, 0.72, 0),
			Color3.fromRGB(242, 196, 60),
			Enum.Material.SmoothPlastic
		)
		p(
			Vector3.new(0.7, 0.16, 0.22),
			CFrame.new(-0.15, 0.68, 0),
			Color3.fromRGB(40, 90, 150),
			Enum.Material.SmoothPlastic
		)
	else
		local bark = { Color3.fromRGB(122, 86, 52), Color3.fromRGB(104, 72, 44), Color3.fromRGB(138, 100, 62) }
		for i, off in ipairs({ Vector3.new(0, -0.25, -0.33), Vector3.new(0, -0.25, 0.33), Vector3.new(0, 0.28, 0) }) do
			p(Vector3.new(2.6, 0.62, 0.62), CFrame.new(off), bark[i], Enum.Material.Wood, Enum.PartType.Cylinder)
		end
		for _, x in ipairs({ -0.75, 0.75 }) do
			p(Vector3.new(0.18, 1.25, 1.42), CFrame.new(x, 0, 0), Color3.fromRGB(196, 72, 56), Enum.Material.Fabric)
		end
	end
	m.PrimaryPart = first
	return m
end

local function spawnItems(h: Handle, raw: { RawItem })
	if #raw == 0 then
		return
	end
	local runtime = SceneBindings.ensureRuntimeFolder()
	local name = "RideItems_" .. h.userId
	local old = runtime:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder:SetAttribute("ForUserId", h.userId)
	folder:SetAttribute("ProjectId", SceneBindings.ProjectId)
	for i, ri in ipairs(raw) do
		local base = ri.part.Position
		local y = waterSurfaceAt(base)
		local size = ITEM_SIZE[ri.item] or ITEM_SIZE.WOOD
		local _, yaw, _ = ri.part.CFrame:ToEulerAnglesYXZ()
		-- 반쯤 잠기게: 상자 가운데가 수면 위 0.15×높이 (+ 띄움)
		local center = CFrame.new(base.X, y + size.Y * 0.15 + CFG.ItemFloatLift, base.Z)
			* CFrame.Angles(0, yaw + (i % 4) * 0.55, 0)
		local m = AssetLibrary.cloneFit(ITEM_KEY[ri.item] or "FirewoodPile", center, size)
			or fallbackItem(ri.item, center)
		m.Name = string.format("Item_%02d", i)
		m:SetAttribute("RideItem", ri.item)
		m:SetAttribute("ItemIndex", i)
		m:SetAttribute("Side", ri.side)
		m:SetAttribute("BaseCF", center)
		m:SetAttribute("ForUserId", h.userId)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.CastShadow = true
			end
		end
		m.Parent = folder
		local sItem = splineProject(h.spline, base)
		local sp, sd = splineAt(h.spline, sItem)
		local latItem = (base - sp):Dot(flat(sd):Cross(Vector3.yAxis))
		table.insert(h.items, {
			index = i,
			part = ri.part,
			side = ri.side,
			item = ri.item,
			s = sItem,
			pos = center.Position,
			lat = latItem,
			model = m,
			state = "FLOAT",
			called = false,
		})
	end
	table.sort(h.items, function(a, b)
		return a.s < b.s
	end)
	folder.Parent = runtime
	h.itemFolder = folder
end

local function collectItem(h: Handle, it: Item, how: string)
	it.state = "TAKEN"
	h.events.items += 1
	h.itemsGot[it.item] = (h.itemsGot[it.item] or 0) + 1
	local cb = h.cbs.item
	if cb then
		cb(it.item, 1)
	end
	h.cbs.fx("RIDE_ITEM", {
		pos = it.pos,
		item = it.item,
		index = it.index,
		how = how,
		n = h.itemsGot[it.item],
	})
	local m = it.model
	if m then
		it.model = nil
		m:SetAttribute("Taken", true) -- 클라이언트가 배 안으로 날려 보내고 숨긴다
		task.delay(1.5, function()
			m:Destroy()
		end)
	end
	-- 내 팔 번쩍 (손맛) + 분대원 한마디 (첫 번째는 꼭, 그 뒤엔 가끔)
	if h.character then
		BoatService.pose(h.character, "LIFT")
	end
	if h.events.items == 1 then
		local duri = h.byId.DURI
		h.cbs.bubble(if duri and duri.state == "DECK" then "DURI" else caller(h), L.itemFirst[it.item] or L.aak, 1.4)
	elseif h.events.items % CFG.ItemReactEvery == 0 then
		local r = deckNpc(h)
		local list = r and L.itemReact[r.id]
		if r and list then
			h.cbs.bubble(r.id, list[math.random(#list)], 1.3)
		end
	end
	TelemetryService.log("ride_item", { kind = h.kind, item = it.item, how = how, index = it.index })
	h.cbs.dirty()
end

local function tickItems(h: Handle)
	if #h.items == 0 or (h.phase ~= "RUN" and h.phase ~= "FINISH") then
		return
	end
	local me = h.byId.ME
	local meDeck = me ~= nil and me.state == "DECK"
	for _, it in ipairs(h.items) do
		if it.state ~= "FLOAT" then
			continue
		end
		local ds = it.s - h.boatS
		if ds < -(HALF_L + 3) then
			it.state = "MISSED" -- 놓쳤다: 벌 없음, 그냥 떠 있다가 탄 뒤 치운다
			if it.model then
				it.model:SetAttribute("Missed", true)
			end
			continue
		end
		-- 처음 ItemCallMax 개는 두리가 알려 준다 (분대원이 배를 그쪽으로 몰지는 않는다 — 줍기는 아이 몫)
		if not it.called and ds > 0 and ds <= math.max(h.speed, 4) * CFG.ItemCallSec then
			it.called = true
			if h.itemCalls < CFG.ItemCallMax then
				h.itemCalls += 1
				local duri = h.byId.DURI
				h.cbs.bubble(
					if duri and duri.state == "DECK" then "DURI" else caller(h),
					L.itemCall[it.side .. it.item] or L.aak,
					1.6
				)
			end
		end
		if meDeck and math.abs(ds) <= HALF_L + 1 then
			-- 앉아서 직접 젓기: 배를 그쪽으로 몰아(옆 자리 ItemSteerLat 넘게) 뱃전이 닿으면 건진다
			local sideSign = if it.side == "L" then -1 else 1
			if h.lat * sideSign >= CFG.ItemSteerLat and math.abs(it.lat - h.lat) <= CFG.ItemPickLat then
				collectItem(h, it, "STEER")
			end
		end
	end
end

-- ===== Studio 검증 봇 (devBot — 사람 손 아님): 서버에서 내 입력(move·steer)을 대신 넣는다 =====
-- IDLE 아무것도 안 함 · LEAD 저으며 경고 0.35초 뒤 바위 반대쪽으로 · ITEMS LEAD + 다가오는 줍기 쪽으로 (1.2초 안에 부딪힐 바위가 있으면 피하기 먼저)
-- · INTO 저으며 바위 쪽으로 (쿵 시험)
local function tickBot(h: Handle, now: number)
	local mode = h.bot
	if not mode or now - h.botAt < 0.08 then
		return
	end
	h.botAt = now
	if h.phase ~= "RUN" then
		return
	end
	if mode == "IDLE" then
		h.moving = false
		h.steer = 0
		return
	end
	h.moving = true
	local goal = 0
	local active: Obstacle? = nil
	for _, o in ipairs(h.obstacles) do
		if o.state == "WARNED" and o.rideType == "ROCK" then
			active = o
			break
		end
	end
	local toImpact = 99
	if active and now - active.warnAt >= 0.35 then
		toImpact = (active.s - h.boatS) / math.max(h.speed, 1)
		goal = active.safeX * (if mode == "INTO" then -2.2 else 1.8)
	end
	if mode == "ITEMS" and toImpact > 1.2 then
		for _, it in ipairs(h.items) do
			local ds = it.s - h.boatS
			if it.state == "FLOAT" and ds > -HALF_L and ds < 18 then
				goal = it.lat * 0.6
				break
			end
		end
	end
	local d = goal - h.lat
	h.steer = if math.abs(d) < 0.25 then 0 else math.clamp(d * 1.5, -1, 1)
end

-- ===== 속도·기울기 =====
local function ridersOnDeck(h: Handle): number
	local n = 0
	for _, r in ipairs(h.riders) do
		if r.state == "DECK" then
			n += 1
		end
	end
	return n
end

-- 내 캐릭터 속성 (클라이언트 RideCrew 가 내 노·팔을 그린다): 바뀔 때만 쓴다
local function setMeAttr(h: Handle, key: string, value: any)
	if h.meAttrs[key] ~= value then
		h.meAttrs[key] = value
		if h.character then
			h.character:SetAttribute(key, value)
		end
	end
end

local function clearMeAttrs(h: Handle)
	for _, k in ipairs({ "RideSeat", "RideRow", "RideSide" }) do
		h.meAttrs[k] = nil
		if h.character then
			h.character:SetAttribute(k, nil)
		end
	end
end

-- ===== 시작 =====
function RideService.start(opts: {
	userId: number,
	character: Model?,
	boat: BoatService.BoatHandle,
	members: { { id: string, rig: SquadNpcService.Rig } },
	kind: Kind,
	day: number,
	loadout: { seats: { [string]: string }, cargo: { string }, oar: string },
	cbs: Cbs,
}): Handle
	ensureGroups()
	local boat = opts.boat
	local root = boat.root
	local now = os.clock()
	local points, obsRaw, itemsRaw = collectRide(opts.day)
	local spline = buildSpline(points)

	-- 유보트: 물에 뜬 자세로 먼저 (노를 밖으로) → 선체 Weld → 갑판 → 정렬 기구
	BoatService.detachAll(boat)
	BoatService.setMode(boat, "WATER")
	local attach = root:FindFirstChild("RideAttach") :: Attachment? or Instance.new("Attachment")
	attach.Name = "RideAttach"
	attach.Parent = root
	local align = root:FindFirstChild("RideAlign") :: AlignPosition? or Instance.new("AlignPosition")
	align.Name = "RideAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = attach
	align.ApplyAtCenterOfMass = true
	align.MaxForce = CFG.AlignForce
	align.MaxVelocity = CFG.AlignMaxVel
	align.Responsiveness = CFG.AlignResponsiveness
	align.RigidityEnabled = false
	align.Enabled = false
	align.Parent = root
	local orient = root:FindFirstChild("RideOrient") :: AlignOrientation? or Instance.new("AlignOrientation")
	orient.Name = "RideOrient"
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = attach
	orient.MaxTorque = CFG.AlignTorque
	orient.Responsiveness = CFG.OrientResponsiveness
	orient.RigidityEnabled = false
	orient.Enabled = false
	orient.Parent = root
	-- 무게 들기: AlignPosition 은 용수철이라 무게만큼 처진다 (Studio 측정: 목표보다 1.2 stud 아래 → 배 안 바닥으로 물이 보였다).
	-- 덩어리 무게 × 중력만큼 위로 밀어 처짐을 없앤다 (매 프레임 — 내가 앉으면 덩어리가 무거워진다)
	local lift = root:FindFirstChild("RideLift") :: VectorForce? or Instance.new("VectorForce")
	lift.Name = "RideLift"
	lift.Attachment0 = attach
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.ApplyAtCenterOfMass = true
	lift.Force = Vector3.zero
	lift.Enabled = false
	lift.Parent = root
	local ropes: { Attachment } = {}
	for i, x in ipairs({ 0, -1.6, 1.6 }) do
		local a = root:FindFirstChild("RideRope" .. i) :: Attachment? or Instance.new("Attachment")
		a.Name = "RideRope" .. i
		a.Position = Vector3.new(x, -0.9, HALF_L + 1.4)
		a.Parent = root
		ropes[i] = a
	end

	-- 배치 → 기울기 치우침·속도
	local powerL, powerR = 0, 0
	for key, memberId in pairs(opts.loadout.seats or {}) do
		local m = SquadCatalog.get(memberId)
		local pw = if m then m.power else 2
		if SquadCatalog.isLeft(key) then
			powerL += pw
		else
			powerR += pw
		end
	end
	local kg = 0
	for _, c in ipairs(opts.loadout.cargo or {}) do
		local cg = BoatLoadout.Cargo[c]
		if cg then
			kg += cg.kg
		end
	end
	local speedMul = (if opts.loadout.oar == "LONG" then CFG.OarLongMul else 1.0) * (1 - CFG.CargoSpeedPerKg * kg)

	local h: Handle = {
		userId = opts.userId,
		kind = opts.kind,
		day = opts.day,
		boat = boat,
		character = opts.character,
		riders = {},
		byId = {},
		spline = spline,
		obstacles = {},
		finishS = spline.length,
		deck = nil :: any,
		attach = attach,
		align = align,
		orient = orient,
		ropes = ropes,
		boardPrompt = nil :: any,
		phase = "BOARD",
		phaseAt = now,
		s = 0,
		boatS = 0,
		speed = 0,
		moving = false,
		steer = 0,
		lat = 0,
		latVel = 0,
		rowPower = 0,
		seat = nil,
		unseatedSince = nil,
		meAttrs = {},
		slowUntil = 0,
		spinAt = -99,
		spinDir = 0,
		lastRockHit = false,
		massSaved = nil,
		roll = 0,
		rollBias = (powerL - powerR) * CFG.RollBiasPerPower,
		cargoKg = kg,
		steady = table.find(opts.loadout.cargo or {}, "WATER") ~= nil,
		speedMul = speedMul,
		bumpAt = -99,
		bumpDir = 0,
		bumpScale = 1,
		cue = nil,
		cueUntil = 0,
		jumpState = false,
		jumpWindowUntil = 0,
		lastWheeAt = -99,
		cheerAt = now + 6,
		finishedAt = nil,
		done = false,
		events = {
			falls = 0,
			bumps = 0,
			dodges = 0,
			pulls = 0,
			selfClimbs = 0,
			npcPulls = 0,
			ledByMe = 0,
			scrapes = 0,
			items = 0,
		},
		itemsGot = {},
		items = {},
		itemCalls = 0,
		itemFolder = nil,
		followTurn = 0,
		bot = nil,
		botAt = 0,
		pullLog = {},
		boardSince = nil,
		boardFixAt = 0,
		startAt = now,
		cbs = opts.cbs,
	}
	h.deck = makeDeck(h)
	makeBoatPhysical(h)
	-- 장애물: 스플라인에 투영
	for _, o in ipairs(obsRaw) do
		if o.rideType == "BRANCH" or o.rideType == "FALLS" then
			continue -- 장애물은 바위만 (2026-10-21 플레이테스트: 가지·폭포 판정 없앰 — 폭포 턱 물높이는 지형이라 그대로 내려간다)
		end
		local sPos = splineProject(spline, o.part.Position)
		table.insert(h.obstacles, {
			part = o.part,
			rideType = o.rideType,
			side = o.side,
			s = sPos,
			state = "PENDING",
			pos = o.part.Position,
			warnAt = 0,
			decision = nil,
			led = false,
			safeX = 0,
			cue = nil,
		})
		if o.rideType == "FINISH" then
			h.finishS = sPos
		end
	end
	table.sort(h.obstacles, function(a, b)
		return a.s < b.s
	end)
	-- 물 위 줍기 (급류 2차): 떠 있는 장작·물통을 띄운다 (세션마다)
	spawnItems(h, itemsRaw)

	-- 출발 자세: s=0 에 놓고 (앵커 풀고 정렬 기구 켬)
	local p0, d0 = splineAt(spline, 0)
	local startCF =
		CFrame.lookAt(p0 + Vector3.new(0, CFG.RootHeight, 0), p0 + Vector3.new(0, CFG.RootHeight, 0) + flat(d0))
	BoatService.pivot(boat, startCF)
	root.Anchored = false
	align.Position = startCF.Position
	orient.CFrame = startCF
	align.Enabled = true
	orient.Enabled = true
	lift.Enabled = true
	if CFG.ServerOwnsBoat then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	else
		local pl = Players:GetPlayerByUserId(opts.userId)
		if pl then
			pcall(function()
				root:SetNetworkOwner(pl)
			end)
		end
	end
	for _, p in ipairs(boat.model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
	end

	-- 탑승자: 자리 = loadout.seats (없으면 기본)
	local seatOf: { [string]: string } = {}
	for key, id in pairs(opts.loadout.seats or {}) do
		seatOf[id] = key
	end
	local function addRider(id: string, rig: SquadNpcService.Rig?)
		local key = seatOf[id] or (if id == "ME" then "FL" else "BR")
		-- 앉아서 직접 젓기: 나도 내 자리 쪽 (좌우는 바위·파도에 누가 빠질 수 있는지만 정한다)
		local home = seatHome(key)
		local hip = 3
		local hum = if rig then rig.humanoid else humOf(opts.character)
		local hrp = if rig then rig.hrp else hrpOf(opts.character)
		if hum and hrp then
			hip = hum.HipHeight + hrp.Size.Y / 2
		end
		local r: Rider = {
			id = id,
			rig = rig,
			seatKey = key,
			home = home,
			cur = home,
			goal = home,
			moveFrom = home,
			moveAt = -99,
			moveSec = 0,
			motor = nil,
			weld = nil,
			state = "DECK",
			stateAt = now,
			offDeckSince = nil,
			falls = 0,
			prompt = nil,
			late = false,
			lateUntil = 0,
			ropeIndex = 1,
			pulledBy = nil,
			hip = hip,
			rowOn = nil,
			seatOn = nil,
			leanAttr = 0,
			duckAttr = false,
			gestureUntil = 0,
		}
		table.insert(h.riders, r)
		h.byId[id] = r
		return r
	end
	local me = addRider("ME", nil)
	for _, m in ipairs(opts.members) do
		local r = addRider(m.id, m.rig)
		attachNpc(h, r, r.home)
		r.prompt = makePrompt(m.rig.hrp, L.promptPull, memberName(m.id), CFG.PullHoldSec, opts.userId)
		r.prompt.Triggered:Connect(function(pl)
			if pl.UserId == opts.userId and r.state == "HANGING" and not h.done then
				climb(h, r, "ME")
			end
		end)
	end
	-- 나: 갑판 위 내 자리에 (출발 전이라 아직 안 움직인다). 친구용 끌어올리기 프롬프트는 내 HRP 에 (혼자면 아무도 못 봄)
	if opts.character then
		setCharGroup(opts.character, GROUP_CHARS)
		local hum = humOf(opts.character)
		if hum then
			hum.PlatformStand = false
			hum.Sit = false
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			hum.UseJumpPower = true
		end
		local hrp = hrpOf(opts.character)
		if hrp then
			me.prompt = makePrompt(hrp, L.promptPull, memberName("ME"), CFG.PullHoldSec, -1)
		end
	end
	-- 앉아서 직접 젓기: 내 배치 자리 튜브 위에 앉는다
	h.seat = makeSeat(h, me.seatKey)
	if opts.character then
		sitMe(h)
	end
	-- 타기 프롬프트 (자리에서 떨어졌을 때 E → 내 자리에 앉기)
	local bp = makePrompt(root, L.promptBoard, L.objBoat, 0, opts.userId)
	bp.Name = "RideBoard"
	bp:SetAttribute("PromptIcon", "🚤")
	bp.MaxActivationDistance = 14
	bp.Enabled = true
	bp.Triggered:Connect(function(pl)
		if pl.UserId == opts.userId and h.character and not h.done then
			sitMe(h)
		end
	end)
	h.boardPrompt = bp

	if CFG.DebugAttrs then
		workspace:SetAttribute("Ride_phase", h.phase)
	end
	-- (탑승 자막 줄은 빼었다 — 날 시작 줄과 겹쳐 대기열이 밀렸다. 할 일 판이 "🚤 유보트에 타요" 를 보여 준다)
	opts.cbs.dirty()
	return h
end

-- ===== 매 프레임 =====
local function debugAttrs(h: Handle, lag: number)
	if not CFG.DebugAttrs then
		return
	end
	workspace:SetAttribute("Ride_phase", h.phase)
	workspace:SetAttribute("Ride_s", math.floor(h.s * 10) / 10)
	workspace:SetAttribute("Ride_boatS", math.floor(h.boatS * 10) / 10)
	workspace:SetAttribute("Ride_speed", math.floor(h.speed * 100) / 100)
	workspace:SetAttribute("Ride_roll", math.floor(h.roll * 10) / 10)
	workspace:SetAttribute("Ride_lag", math.floor(lag * 100) / 100)
	workspace:SetAttribute("Ride_falls", h.events.falls)
	workspace:SetAttribute("Ride_bumps", h.events.bumps)
	workspace:SetAttribute("Ride_dodges", h.events.dodges)
	workspace:SetAttribute("Ride_pulls", h.events.pulls)
	workspace:SetAttribute("Ride_npcPulls", h.events.npcPulls)
	workspace:SetAttribute("Ride_selfClimbs", h.events.selfClimbs)
	local me = h.byId.ME
	workspace:SetAttribute("Ride_me", if me then me.state else "")
	workspace:SetAttribute("Ride_cue", h.cue or "")
	local st = {}
	for _, r in ipairs(h.riders) do
		if r.rig then
			table.insert(st, string.format("%s:%s:%.1f", r.id, r.state, r.cur.X))
		end
	end
	workspace:SetAttribute("Ride_npcs", table.concat(st, " "))
end

function RideService.tick(h: Handle, dt: number)
	if h.done then
		return
	end
	local now = os.clock()
	local root = h.boat.root
	local ch = h.character
	local myHum = humOf(ch)
	local me = h.byId.ME
	local dtc = math.min(dt, 0.1)
	local running = h.phase == "RUN" or h.phase == "FINISH"

	-- 노 젓기 (W): 저으면 RowRampSec 에 걸쳐 힘이 붙고, 떼면 RowFadeSec 에 걸쳐 빠진다 (물에 빠져 있으면 못 젓는다)
	local meRowing = h.moving and me ~= nil and me.state == "DECK" and h.phase == "RUN"
	if meRowing then
		h.rowPower = math.min(1, h.rowPower + dtc / CFG.RowRampSec)
	else
		h.rowPower = math.max(0, h.rowPower - dtc / CFG.RowFadeSec)
	end
	-- 가지 앞뒤: 분대원이 숙인다 (빠짐 없음)
	local duck = false
	for _, o in ipairs(h.obstacles) do
		if o.rideType == "BRANCH" and o.s - h.boatS < CFG.DuckAhead and o.s - h.boatS > -CFG.DuckBehind then
			duck = true
			break
		end
	end
	-- 방향 (−1 왼쪽 · 1 오른쪽으로 도는 중): 분대원이 그쪽으로 몸을 싣는다
	local turn = math.clamp(h.latVel / CFG.LatSpeed, -1, 1)
	local leanSign = if turn > 0.35 then 1 elseif turn < -0.35 then -1 else 0

	-- 분대원 모터 트윈 + 노 젓기·몸 속성 (클라이언트 RideCrew 가 팔·노·몸을 그린다 — 바뀔 때만 씀). 내가 저을 때 같이 젓는다 (하나 둘)
	for _, r in ipairs(h.riders) do
		if r.rig and r.motor then
			tickNpcMotor(r, now)
		end
		if r.rig then
			local seat = (r.state == "DECK" or r.state == "CLIMBING") and h.phase ~= "DONE"
			-- 분대원 노: 급류에선 늘 천천히(RowSoft), 내가 W 로 저으면 같이 힘차게 (하나 둘). 바다는 내가 저을 때만
			local canRow = seat and r.state == "DECK" and running and now >= r.gestureUntil
			local row: any = false
			if canRow then
				if h.rowPower > 0.25 then
					row = 1
				elseif h.kind == "RAPIDS" then
					row = CFG.RowSoft
				end
			end
			setRowAttrs(r, row, seat)
			if r.state == "DECK" then
				setBodyAttrs(r, leanSign, duck)
			end
		end
	end
	-- 내 캐릭터: 앉음·젓기·노 쪽 (클라이언트 RideCrew)
	local meSeated = me ~= nil and (me.state == "DECK" or me.state == "CLIMBING") and h.phase ~= "DONE"
	setMeAttr(h, "RideSeat", meSeated)
	setMeAttr(h, "RideRow", meSeated and meRowing)
	setMeAttr(h, "RideSide", if h.seat then h.seat:GetAttribute("RideSide") else nil)

	-- 단계
	if h.phase == "BOARD" then
		-- 내 자리에 앉아 BoardSec 지나면 출발 카운트
		if seatedNow(h) then
			h.boardSince = h.boardSince or now
			if now - (h.boardSince :: number) >= CFG.BoardSec then
				h.phase = "COUNT"
				h.phaseAt = now
				h.boardPrompt.Enabled = false
				h.cbs.fx("BOARDED")
				h.cbs.dirty()
			end
		else
			h.boardSince = nil
			-- 막지 않는다: 2.5초 안에 못 앉으면(리스폰 순간 등) 다시 앉힌다
			if me and now - h.phaseAt > 2.5 and now - h.boardFixAt > 2.5 then
				h.boardFixAt = now
				sitMe(h)
			end
		end
	elseif h.phase == "COUNT" then
		if now - h.phaseAt >= CFG.StartCountSec then
			h.phase = "RUN"
			h.phaseAt = now
			h.startAt = now
			h.cbs.lines({ if h.kind == "SEA" then L.startSea else L.start })
			h.cbs.fx("RIDE_START")
			for _, r in ipairs(h.riders) do
				if r.rig then
					h.cbs.bubble(r.id, L.aak, 0.8)
				end
			end
			h.cbs.dirty()
		end
	end

	-- 속도: 한 번 젓기마다 밀려 나간다 — 서버 시각 박자 (클라이언트 RideCrew 와 같은 박자, 노가 물을 당기는 반 바퀴에 힘)
	local phi = (workspace:GetServerTimeNow() / CFG.RowStrokeSec) * math.pi * 2
	local surge = 1 + CFG.StrokeSurge * (2 * math.max(0, math.sin(phi)) - 0.64)
	local want = 0
	if h.phase == "RUN" then
		if h.kind == "RAPIDS" then
			-- 급류: 물살로 늘 내려간다 (멈추지 않음) + 저으면 더
			want = (CFG.RapidsBaseSpeed + CFG.RapidsRowAdd * h.rowPower * surge) * h.speedMul
			if now < h.slowUntil then
				want *= CFG.BumpSlowMul -- 쿵 뒤 잠깐 크게 느림 (멈추진 않음)
			end
			for _, o in ipairs(h.obstacles) do
				if o.rideType == "FALLS" and math.abs(h.s - o.s) < 8 then
					want *= CFG.FallsRushMul
				end
			end
		else
			-- 바다: 저을 때만 간다 (탄 사람 수만큼)
			want = CFG.SeaSpeed * (CFG.RiderMul[ridersOnDeck(h)] or 0.45) * h.rowPower * surge * h.speedMul
		end
	end
	if want > h.speed then
		h.speed = math.min(want, h.speed + dtc * CFG.RowAccel)
	else
		local decel = if h.phase == "FINISH"
			then math.max(h.speed, 3) / CFG.FinishSlowSec
			elseif h.kind == "SEA" and h.rowPower <= 0 then CFG.SeaSpeed / CFG.SeaDecelSec
			else CFG.RowDecel
		h.speed = math.max(want, h.speed - dtc * decel)
	end
	h.s += h.speed * dtc

	-- 방향 (A/D): 옆 자리 lat 를 LatSpeed 로 (부드럽게). 급류는 손을 떼면 물살이 천천히 가운데로
	local latMax = if h.kind == "SEA" then CFG.SeaLatMax else CFG.RapidsLatMax
	local canSteer = me ~= nil and (me.state == "DECK" or me.state == "CLIMBING") and running
	local st = if canSteer then h.steer else 0
	local goalVel = st * CFG.LatSpeed
	if h.kind == "RAPIDS" and math.abs(st) < 0.1 then
		goalVel = -h.lat * CFG.CenterPull
	end
	h.latVel += (goalVel - h.latVel) * math.min(1, dtc * CFG.LatEase)
	h.lat += h.latVel * dtc
	if h.lat > latMax then
		h.lat = latMax
		h.latVel = math.min(h.latVel, 0)
	elseif h.lat < -latMax then
		h.lat = -latMax
		h.latVel = math.max(h.latVel, 0)
	end

	-- 목표 자세: 스플라인 + 오른쪽 × lat, 뱃머리를 도는 쪽으로 조금(SteerYawDeg), 도는 쪽으로 기울기(SteerRollDeg)
	local pos, tan = splineAt(h.spline, h.s)
	local bob = math.sin(now * 1.6) * CFG.BobStuds * (if h.phase == "BOARD" then 0.4 else 1)
	local ft = flat(tan)
	local right = ft:Cross(Vector3.yAxis)
	local targetPos = pos + right * h.lat + Vector3.new(0, CFG.RootHeight + bob, 0)
	-- 쿵·긁힘·파도: 흔들림
	local bumpT = now - h.bumpAt
	local shake = 0
	if bumpT >= 0 and bumpT < CFG.BumpSec then
		shake = CFG.BumpShakeDeg
			* h.bumpScale
			* math.sin(math.pi * 2 * bumpT / CFG.BumpSec)
			* (1 - bumpT / CFG.BumpSec)
			* -h.bumpDir
			* (if h.steady then CFG.WaterRollMul else 1)
	end
	local steadyMul = if h.steady then CFG.WaterRollMul else 1
	local tr = math.clamp(h.rollBias * steadyMul - turn * CFG.SteerRollDeg, -CFG.MaxRollDeg, CFG.MaxRollDeg)
	h.roll += (tr - h.roll) * math.min(1, dtc * CFG.RollFollow)
	local yaw = math.rad(-turn * CFG.SteerYawDeg)
	-- 쿵: 바위 반대쪽으로 빙 돌았다가 돌아온다 (BumpSlowSec 동안)
	local spinT = now - h.spinAt
	if spinT >= 0 and spinT < CFG.BumpSlowSec then
		yaw += -h.spinDir * math.rad(CFG.BumpSpinDeg) * math.sin(math.pi * spinT / CFG.BumpSlowSec)
	end
	local pitchExtra = math.sin(now * 1.1) * 0.03 + math.rad(h.cargoKg * CFG.CargoPitchPerKg)
	local look = Vector3.new(tan.X, if h.phase == "RUN" then tan.Y else 0, tan.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	local targetCF = CFrame.lookAt(targetPos, targetPos + look.Unit)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(pitchExtra, 0, math.rad(h.roll + shake))
	h.align.Position = targetPos
	h.orient.CFrame = targetCF
	local lift = root:FindFirstChild("RideLift")
	if lift and lift:IsA("VectorForce") then
		lift.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
	end
	-- 배 실제 거리·뒤처짐
	h.boatS = splineProject(h.spline, root.Position, h.s)
	local lag = (Vector3.new(root.Position.X - targetPos.X, 0, root.Position.Z - targetPos.Z)).Magnitude

	-- 나: 자리에서 떨어졌으면(점프·리셋 순간 등) 다시 앉힌다 — 걸어서 빠지는 일은 없다
	if me and myHum and me.state == "DECK" and h.phase ~= "BOARD" and h.phase ~= "DONE" then
		if seatedNow(h) then
			h.unseatedSince = nil
		else
			h.unseatedSince = h.unseatedSince or now
			if now - (h.unseatedSince :: number) >= CFG.ReseatSec then
				sitMe(h)
			end
		end
	end

	-- 빠진 사람들: 매달리기·당기기·혼자 올라오기
	for _, r in ipairs(h.riders) do
		if r.state == "WATER" then
			if now - r.stateAt >= CFG.HangDelaySec then
				hang(h, r)
			end
		elseif r.state == "HANGING" then
			local t = now - r.stateAt
			if t >= CFG.SelfClimbSec then
				climb(h, r, nil)
			elseif t >= CFG.NpcPullAfterSec and not r.pulledBy then
				npcPull(h, r)
			end
		end
	end

	-- 장애물: 경고 → 지나감 (판정은 지나는 순간의 옆 자리)
	if running then
		local warnDist = math.max(6, h.speed * CFG.WarnSec)
		local waveWarnDist = math.max(6, h.speed * CFG.WaveWarnSec)
		for _, o in ipairs(h.obstacles) do
			if o.state == "PENDING" then
				local wd = if o.rideType == "WAVE" then waveWarnDist else warnDist
				if o.rideType == "FINISH" then
					if h.boatS >= o.s - 1 then
						passObstacle(h, o)
					end
				elseif h.s >= o.s - wd then
					warnObstacle(h, o)
				end
			elseif o.state == "WARNED" then
				if h.boatS >= o.s - 1.5 then
					passObstacle(h, o)
				end
			end
		end
	end
	-- 물 위 줍기 · 검증 봇
	tickItems(h)
	tickBot(h, now)
	-- 큐 끝
	if h.cue and now >= h.cueUntil then
		h.cue = nil
		h.cbs.dirty()
	end
	-- 바다: 가끔 응원
	if h.kind == "SEA" and h.phase == "RUN" and now >= h.cheerAt then
		h.cheerAt = now + 9
		local who = ({ "DURI", "SAN", "MIR" })[math.random(3)]
		local r = h.byId[who]
		if r and r.state == "DECK" then
			h.cbs.bubble(who, L.seaCheer[math.random(#L.seaCheer)], 1.4)
		end
	end
	-- 물결 (클라이언트 연출용 속성)
	root:SetAttribute("RideSpeed", math.floor(h.speed * 10) / 10)

	-- 도착: 속도 0 이 된 뒤 배를 모래 위에 세우고 모두 풀어 준다
	if h.phase == "FINISH" and now - h.phaseAt >= CFG.FinishSlowSec + 0.3 then
		h.phase = "DONE"
		h.phaseAt = now
		h.finishedAt = now
		local pe, de = splineAt(h.spline, h.s)
		local fd = flat(de)
		-- 모래 위에 얹는다: 배 밑 땅(물 제외)을 재서 BoatService PARK 와 같은 높이(땅 +0.5). 1차 주행: 경로점 y 로는 모래 위 3.4 stud 에 떠 있었다
		local gp = RaycastParams.new()
		gp.FilterType = Enum.RaycastFilterType.Exclude
		gp.IgnoreWater = true
		local ex: { Instance } = { h.boat.model }
		if ch then
			table.insert(ex, ch)
		end
		for _, r in ipairs(h.riders) do
			if r.rig then
				table.insert(ex, r.rig.model)
			end
		end
		gp.FilterDescendantsInstances = ex
		local gr = workspace:Raycast(root.Position + Vector3.new(0, 6, 0), Vector3.new(0, -20, 0), gp)
		local restY = if gr then gr.Position.Y + 0.5 else pe.Y + CFG.RootHeight
		local finalCF = CFrame.lookAt(
			Vector3.new(root.Position.X, restY, root.Position.Z),
			Vector3.new(root.Position.X, restY, root.Position.Z) + fd
		)
		-- 탑승자 먼저 풀고
		for _, r in ipairs(h.riders) do
			if r.rig then
				detachNpc(r)
				clearRideAttrs(r)
				SquadNpcService.setMood(r.rig, "HAPPY")
				-- 도착: 미르는 손을 흔들고 둘은 환호 (트랙 재사용)
				SquadNpcService.playOnce(r.rig, if r.id == "MIR" then "wave" else "cheer")
			else
				unseatMe(h) -- 배를 앵커하기 전에 자리에서 일으킨다 (붙은 채 앵커되면 굳는다)
				if r.weld then
					r.weld:Destroy()
					r.weld = nil
				end
			end
			if r.prompt then
				r.prompt.Enabled = false
			end
			r.state = "DECK"
		end
		restoreBoat(h, finalCF)
		BoatService.setMode(h.boat, "PARK")
		-- 분대원은 배 옆 모래에 세운다
		for i, r in ipairs(h.riders) do
			if r.rig then
				local p = finalCF * CFrame.new((i - 2.5) * 2.4, 0, -HALF_L - 3)
				SquadNpcService.standAt(r.rig, Vector3.new(p.Position.X, p.Position.Y, p.Position.Z), fd)
				r.rig.hrp.Anchored = true
			end
		end
		if ch then
			local hum = humOf(ch)
			if hum then
				hum.PlatformStand = false
			end
			ch:SetAttribute("CampHanging", nil)
			local hrp = hrpOf(ch)
			local pl = Players:GetPlayerFromCharacter(ch)
			if hrp and pl then
				pcall(function()
					hrp:SetNetworkOwner(pl)
				end)
			end
		end
		clearMeAttrs(h)
		h.cbs.fx("FINISH", { pos = finalCF.Position, falls = h.events.falls })
		h.cbs.lines({
			if h.kind == "SEA" then L.finishSea elseif h.events.falls == 0 then L.finishNoFall else L.finish,
		})
		h.done = true
		debugAttrs(h, lag)
		h.cbs.dirty()
		h.cbs.finish()
		return
	end
	debugAttrs(h, lag)
end

-- ===== 입력 =====
-- W 노 젓기 · A/D 방향 (CarryInput {move, steer}). 판정은 서버 (steer 는 −1..1 로 자른다)
function RideService.setInput(h: Handle, moving: boolean, steer: number)
	if steer ~= steer then
		steer = 0
	end
	h.steer = math.clamp(steer, -1, 1)
	if h.moving ~= moving then
		h.moving = moving
		h.cbs.dirty()
	end
end

function RideService.setMove(h: Handle, moving: boolean)
	RideService.setInput(h, moving, h.steer)
end

-- E: 가까운 매달린 사람 끌어올리기 (프롬프트와 같은 동작 — 폰·패드 공용 경로)
function RideService.interact(h: Handle, player: Player): boolean
	if h.done or player.UserId ~= h.userId then
		return false
	end
	local hrp = hrpOf(player.Character)
	if not hrp then
		return false
	end
	local best: Rider? = nil
	local bestD = CFG.PullDistance
	for _, r in ipairs(h.riders) do
		if r.state == "HANGING" and r.rig then
			local d = (r.rig.hrp.Position - hrp.Position).Magnitude
			if d < bestD then
				best, bestD = r, d
			end
		end
	end
	if best then
		climb(h, best :: Rider, "ME")
		return true
	end
	return false
end

function RideService.onCharacter(h: Handle, character: Model)
	h.massSaved = nil -- 옛 캐릭터 것 (지워짐)
	h.character = character
	setCharGroup(character, GROUP_CHARS)
	local me = h.byId.ME
	if not me or h.done then
		return
	end
	if me.weld then
		me.weld = nil
	end
	me.state = "CLIMBING" -- 앉힐 때까지 빠짐 판정 없음 (sitMe 가 DECK 으로)
	me.stateAt = os.clock()
	me.offDeckSince = nil
	h.meAttrs = {}
	local hum = humOf(character)
	local hrp = hrpOf(character)
	if hum and hrp then
		hum.PlatformStand = false
		me.hip = hum.HipHeight + hrp.Size.Y / 2
		me.prompt = makePrompt(hrp, L.promptPull, memberName("ME"), CFG.PullHoldSec, -1)
	end
	task.delay(0.2, function()
		if not h.done and character.Parent then
			sitMe(h)
		end
	end)
	h.cbs.dirty()
end

-- ===== 스냅샷 =====
function RideService.view(h: Handle): { [string]: any }
	local hanging = {}
	for _, r in ipairs(h.riders) do
		if r.state == "HANGING" then
			table.insert(hanging, r.id)
		end
	end
	local me = h.byId.ME
	return {
		kind = h.kind,
		phase = h.phase,
		progress = if h.finishS > 0 then math.clamp(h.boatS / h.finishS, 0, 1) else 0,
		speed = h.speed,
		roll = h.roll,
		cue = h.cue,
		cueLeft = if h.cue then math.max(0, h.cueUntil - os.clock()) else 0,
		falls = h.events.falls,
		hanging = hanging,
		meState = if me then me.state else "DECK",
		riders = ridersOnDeck(h),
		moving = h.moving,
		jumpWindow = os.clock() < h.jumpWindowUntil,
		items = h.events.items, -- 급류 2차: 건진 것
		ledByMe = h.events.ledByMe, -- 방향 잡아 피한 바위 · 저으며 넘은 파도
		bumps = h.events.bumps, -- 🪨 바위에 쿵 (할 일 판 수)
		lat = math.floor(h.lat * 10) / 10, -- 앉아서 직접 젓기: 옆 자리 (HUD·검증)
		rowing = h.rowPower > 0.25,
	}
end

-- 검증용 상세
function RideService.debug(h: Handle): { [string]: any }
	local riders = {}
	for _, r in ipairs(h.riders) do
		local hrp = riderHrp(h, r)
		riders[r.id] = {
			state = r.state,
			falls = r.falls,
			x = if r.rig then r.cur.X else (if hrp then localOf(h, hrp.Position).X else nil),
			onDeck = if hrp then onDeckLocal(localOf(h, hrp.Position)) else nil,
		}
	end
	local obs = {}
	for _, o in ipairs(h.obstacles) do
		table.insert(obs, string.format("%s%s@%.0f:%s:%s", o.rideType, o.side or "", o.s, o.state, o.decision or "-"))
	end
	return {
		phase = h.phase,
		s = h.s,
		boatS = h.boatS,
		length = h.spline.length,
		finishS = h.finishS,
		speed = h.speed,
		roll = h.roll,
		rollBias = h.rollBias,
		steady = h.steady,
		speedMul = h.speedMul,
		events = h.events,
		itemsGot = h.itemsGot,
		lat = h.lat, -- 앉아서 직접 젓기: 옆 자리 · 입력 · 젓기 힘
		latVel = h.latVel,
		steer = h.steer,
		moving = h.moving,
		rowPower = h.rowPower,
		seated = seatedNow(h),
		items = RideService.devItems(h),
		riders = riders,
		obstacles = obs,
		hullDrift = BoatService.hullDrift(h.boat),
		rootPos = h.boat.root.Position,
		rootAnchored = h.boat.root.Anchored,
	}
end

-- ===== Studio 검증 (DevApi "ride") =====
-- 이 사람을 지금 빠뜨린다 (판정과 같은 길). who = ME | DURI | SAN | MIR
function RideService.devFall(h: Handle, who: string): boolean
	local r = h.byId[who]
	if not r or r.state ~= "DECK" or h.phase ~= "RUN" then
		return false
	end
	fall(h, r, "DEV")
	return true
end

-- 검증 봇 (급류 2차): IDLE | LEAD | ITEMS | nil(끔) — 서버 MoveTo 로 갑판 위를 걷는다 (사람 손 아님)
function RideService.devBot(h: Handle, mode: string?)
	h.bot = mode
	h.botAt = 0
end

-- 줍기 상태 (검증용)
function RideService.devItems(h: Handle): { string }
	local out = {}
	for _, it in ipairs(h.items) do
		table.insert(out, string.format("%d:%s%s@%.0f:%s", it.index, it.side, it.item, it.s, it.state))
	end
	return out
end

-- 나를 내 자리에 다시 앉힌다 (앉아서 직접 젓기 — 옛 x, z 는 쓰지 않음)
function RideService.devPlaceMe(h: Handle, _x: number, _z: number): boolean
	local me = h.byId.ME
	if not me or me.state ~= "DECK" then
		return false
	end
	sitMe(h)
	return true
end

-- 앞으로 건너뛰기: 지나친 장애물은 끝난 것으로, 배·나를 그 자리로 옮긴다 (봇 시험 — 작전 기록은 호출 쪽이 무효로)
function RideService.devSeek(h: Handle, s: number)
	if h.done then
		return
	end
	local target = math.clamp(s, 0, h.spline.length)
	for _, o in ipairs(h.obstacles) do
		if o.s < target + 2 and o.rideType ~= "FINISH" then
			o.state = "DONE"
		end
	end
	h.s = target
	h.boatS = target
	h.lat = 0
	h.latVel = 0
	h.cue = nil
	if h.phase == "BOARD" or h.phase == "COUNT" then
		h.phase = "RUN"
		h.phaseAt = os.clock()
	end
	local p, d = splineAt(h.spline, target)
	local cf = CFrame.lookAt(p + Vector3.new(0, CFG.RootHeight, 0), p + Vector3.new(0, CFG.RootHeight, 0) + flat(d))
	h.align.Position = cf.Position
	h.orient.CFrame = cf
	unseatMe(h) -- 붙은 캐릭터째 CFrame 으로 옮기면 덩어리가 갈라진다 (boat-weld 메모) → 떼고 옮긴 뒤 다시 앉힌다
	BoatService.pivot(h.boat, cf)
	h.boat.root.AssemblyLinearVelocity = Vector3.zero
	local me = h.byId.ME
	if me and h.character and me.state == "DECK" and not seatedNow(h) then
		sitMe(h)
	end
	h.cbs.dirty()
end

function RideService.stop(h: Handle)
	-- 도착 정리(DONE)를 이미 했으면 프롬프트·갑판 정리만 남는다 (restoreBoat 는 앵커 상태를 보고 건너뛴다)
	h.done = true
	local root = h.boat.root
	for _, r in ipairs(h.riders) do
		if r.rig then
			detachNpc(r)
			clearRideAttrs(r)
			r.rig.hrp.Anchored = true
			setCharGroup(r.rig.model, "Default")
			SquadNpcService.setMood(r.rig, "IDLE")
			BoatService.pose(r.rig.model, "NONE")
		end
		if r.weld then
			r.weld:Destroy()
			r.weld = nil
		end
		if r.prompt then
			r.prompt:Destroy()
			r.prompt = nil
		end
	end
	if h.boardPrompt then
		h.boardPrompt:Destroy()
	end
	unseatMe(h)
	clearMeAttrs(h)
	if h.character then
		local hum = humOf(h.character)
		if hum then
			hum.PlatformStand = false
			hum.Sit = false
		end
		h.character:SetAttribute("CampHanging", nil)
		setCharGroup(h.character, "Default")
		local hrp = hrpOf(h.character)
		local pl = Players:GetPlayerFromCharacter(h.character)
		if hrp and pl then
			pcall(function()
				hrp:SetNetworkOwner(pl)
			end)
		end
	end
	if not root.Anchored then
		local look = flat(root.CFrame.LookVector)
		restoreBoat(h, CFrame.lookAt(root.Position, root.Position + look))
	else
		h.align.Enabled = false
		h.orient.Enabled = false
		local lf = root:FindFirstChild("RideLift")
		if lf and lf:IsA("VectorForce") then
			lf.Enabled = false
		end
	end
	if h.deck and h.deck.Parent then
		h.deck:Destroy()
	end
	if h.itemFolder then
		h.itemFolder:Destroy()
		h.itemFolder = nil
	end
	root:SetAttribute("RideSpeed", nil)
end

return RideService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
