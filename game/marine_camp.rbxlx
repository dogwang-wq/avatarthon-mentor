        </Item>
        <Item class="ModuleScript" referent="6226">
          <Properties>
            <string name="Name">CampfireService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{B7564581-4F86-4500-A79E-C71E69A4A7EF}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 모닥불 허브 (27 §3 · 28 §1·§2, 2026-10-21 1단계).
-- 낮: 길가의 장작·물통(PICKUP)을 E 로 줍는다 — 세상 공유(다른 사람도 줍고 20초 뒤 다시 놓임). 주우라는 글은 없다. 분대원도 하루 한 번 집는다.
-- 밤: 그날 쉼터의 모닥불(FIRE) 둘레 통나무 의자 4(SEAT). 불 크기 3단계 = 넣은 장작(0~1 작은 불 · 2~3 보통 · 4+ 큰 불).
--   동사 셋(전부 ProximityPrompt): 넣기(불에 장작) · 나누기(분대원에게 물통·간식) · 앉기(그 사람 옆 통나무 → 오늘 이야기).
--   분대원 역할이 보인다: 두리는 불을 들여다보며 장작을 넣고(아이가 안 넣으면 아이 주머니의 장작을 12초에 하나씩), 산은 짐을 풀고(간식이 있으면 돌림),
--   미르는 유보트에 그림(스티커)을 남긴다. 아이가 아무것도 안 해도 셋이 저절로 한다 — 아이가 하면 "같이" 가 된다 (규칙 ①).
-- 막지 않는다: 장작 0개여도 작은 불은 핀다. 90초가 지나거나 동사 하나를 하면 "내일로" 가 켜진다. 점수·벌 없음.
-- 세션 상태 기계는 SessionService 것 그대로 — 여기는 훅(beginDay·enterNight·leaveNight·tick·view)으로만 붙는다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local BoatLoadout = require(Shared:WaitForChild("BoatLoadout"))
local SquadNpcService = require(script.Parent.SquadNpcService)
local BoatService = require(script.Parent.BoatService)
local TelemetryService = require(script.Parent.TelemetryService)
local RescueService = require(script.Parent.RescueService) -- 밤 고마움 한 줄 (2단계: 오늘 내가 일으켜/풀어 준 사람)
local AssetLibrary = require(script.Parent.AssetLibrary) -- 마감 패스: 줍기·밤 상자 메시 (없으면 기본 파트)

local CampfireService = {}

local C = GameConfig.Campfire
local T = CampScript.Campfire
local S = ProtocolTypes.SessionState

type Line = CampScript.Line
-- SessionService.Session 중 여기서 읽는 것만 (순환 require 를 피한다)
type Member = {
	id: string,
	def: SquadCatalog.Member,
	rig: SquadNpcService.Rig?,
	friendUserId: number?,
	morale: number,
	waiting: boolean,
}
export type SessionLike = {
	userId: number,
	player: Player,
	day: number,
	state: string,
	loadout: ProtocolTypes.Loadout,
	members: { [string]: Member },
	boat: BoatService.BoatHandle,
	rec: { fireFed: number?, gaveTo: number? },
}
-- SessionService 가 주는 손 (말·연출·말풍선·스티커·일지·저장 표시)
export type Hooks = {
	lines: (session: any, list: { Line }) -> (),
	fx: (session: any, kind: string, extra: { [string]: any }?) -> (),
	bubble: (session: any, memberId: string, text: string, sec: number?) -> (),
	cue: (session: any, kind: string, payload: { [string]: any }) -> (),
	addSticker: (session: any, id: string) -> (),
	addJournal: (session: any, day: number, text: string) -> (),
	markDirty: (session: any) -> (),
}

type PickupRt = {
	def: SceneBindings.Pickup,
	decos: { BasePart },
	decoAlpha: { [BasePart]: number },
	prompt: ProximityPrompt,
	taken: boolean,
	respawnAt: number,
}

type Night = {
	day: number,
	fire: SceneBindings.Fire?,
	seats: { SceneBindings.SeatSpot },
	center: Vector3,
	startAt: number,
	level: number,
	holder: BasePart?,
	feedPrompt: ProximityPrompt?,
	givePrompts: { [string]: ProximityPrompt },
	props: { Instance },
	conns: { RBXScriptConnection },
	sitIdx: { [string]: number }, -- 분대원별 다음 이야기 줄
	seated: { [string]: boolean }, -- 분대원이 제 통나무에 앉았나 (역할 뒤)
	duriNext: number,
	duriTalk: number,
	duriFed: number, -- 두리가 아이 주머니에서 대신 넣은 수 (DuriFeedsMax)
	sanAt: number,
	sanDone: boolean,
	mirAt: number,
	mirDone: boolean,
	smallAt: number,
	smallSaid: boolean,
	lonelySaid: boolean,
	firstFeedSaid: boolean,
	bigSaid: boolean,
	midSaid: boolean,
	snackGiven: boolean, -- 산이 간식을 돌렸다 (오늘 밤 간식은 끝)
	kangLines: { Line },
	systemLines: { Line },
	sticker: string?,
	trace: string?,
	promptCheckAt: number,
}

type Camp = {
	day: number,
	wood: number,
	water: number,
	fed: number,
	gave: { [string]: boolean },
	sat: { [string]: boolean },
	verbs: number,
	npcPicked: boolean,
	npcCheckAt: number,
	night: Night?,
}

local scene: SceneBindings.Scene? = nil
local hooks: Hooks? = nil
local pickups: { [string]: PickupRt } = {}
local pickupList: { PickupRt } = {}
local camps: { [number]: Camp } = {}
local sessionOf: ((userId: number) -> SessionLike?)? = nil
local lastWorldTick = 0

-- ===== 공통 =====
local function H(): Hooks
	return hooks :: Hooks
end

local function ensure(session: SessionLike): Camp
	local c = camps[session.userId]
	if not c then
		c = {
			day = session.day,
			wood = 0,
			water = 0,
			fed = 0,
			gave = {},
			sat = {},
			verbs = 0,
			npcPicked = false,
			npcCheckAt = 0,
			night = nil,
		}
		camps[session.userId] = c
	end
	return c
end

local function levelOf(fed: number): number
	if fed >= C.Level3Wood then
		return 3
	elseif fed >= C.Level2Wood then
		return 2
	end
	return 1
end

local function npcOf(session: SessionLike, memberId: string): (Member?, SquadNpcService.Rig?)
	local m = session.members[memberId]
	if m and m.rig and not m.friendUserId then
		return m, m.rig
	end
	return nil, nil
end

local function newPrompt(action: string, object: string, dist: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = 0
	p.MaxActivationDistance = dist
	p.RequiresLineOfSight = false
	p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	if C.PromptCustom then
		p.Style = Enum.ProximityPromptStyle.Custom -- PromptController 가 그린다 (28 §4)
	end
	return p
end

-- 캐릭터가 잠깐 몸을 낮췄다가 편다 (줍기·넣기·나누기 손맛 0.3초)
local function bend(character: Model?, sec: number)
	if not character then
		return
	end
	BoatService.pose(character, "READY2")
	task.delay(sec, function()
		if character.Parent then
			BoatService.pose(character, "NONE")
		end
	end)
end

local function canGive(session: SessionLike, c: Camp): boolean
	local n = c.night
	if not n then
		return false
	end
	if c.water > 0 then
		return true
	end
	return BoatLoadout.hasCargo(session.loadout, "SNACK") and not n.snackGiven
end

-- 땅 높이 (Terrain 만, 물 무시). 섬 쉼터(표면 ≈1)처럼 0 이 아닌 곳에 상자를 묻지 않게 (마감 패스)
local function groundAt(pos: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = true
	local hit = workspace:Raycast(Vector3.new(pos.X, pos.Y + 20, pos.Z), Vector3.new(0, -60, 0), params)
	return if hit then hit.Position.Y else 0
end

-- 런타임 소품 폴더 (줍기 메시): Workspace.Runtime.CampProps
local function propsFolder(): Instance
	local runtime = workspace:FindFirstChild("Runtime")
	if not runtime then
		SceneBindings.ensureRuntimeFolder()
		runtime = workspace:FindFirstChild("Runtime")
	end
	local f = (runtime :: Instance):FindFirstChild("CampProps")
	if not f then
		f = Instance.new("Folder")
		f.Name = "CampProps"
		f.Parent = runtime
	end
	return f :: Instance
end

-- 줍기 메시 (마감 패스): 장작 → FirewoodPile(통나무 축 = 모델 Z → 기본 장작 축 X 에 맞춰 90° 돌림), 물통 → Jerrycan.
-- 기본 파트는 늘 숨기고(alpha 1) 메시를 같은 묶음으로 보이고 숨긴다. 라이브러리가 없으면 아무것도 안 함
local function addPickupMesh(def: SceneBindings.Pickup, decos: { BasePart }, alpha: { [BasePart]: number })
	local water = def.pickType == "WATER"
	local base = def.part.Position - Vector3.new(0, def.part.Size.Y / 2, 0)
	local _, yaw, _ = def.part.CFrame:ToEulerAnglesYXZ()
	local size = if water then Vector3.new(0.85, 1.32, 0.8) else Vector3.new(1.6, 1.15, 2.1)
	local cf = CFrame.new(base + Vector3.new(0, size.Y / 2, 0))
		* CFrame.Angles(0, yaw + (if water then 0 else math.pi / 2), 0)
	local name = "PickMesh_" .. def.id
	local folder = propsFolder()
	local old = folder:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local m = AssetLibrary.cloneFit(if water then "Jerrycan" else "FirewoodPile", cf, size)
	if not m then
		return
	end
	m.Name = name
	m.Parent = folder
	for _, d in ipairs(decos) do
		alpha[d] = 1
		d.CastShadow = false
	end
	for _, p in ipairs(AssetLibrary.parts(m)) do
		p.CastShadow = true
		table.insert(decos, p)
		alpha[p] = 0
	end
end

-- ===== 낮 줍기 (세상 공유) =====
local function setPickupShown(p: PickupRt, shown: boolean)
	for _, d in ipairs(p.decos) do
		d.Transparency = if shown then (p.decoAlpha[d] or 0) else 1
		d.CanQuery = shown
	end
	p.def.part.CanQuery = shown
	p.prompt.Enabled = shown
	p.def.part:SetAttribute("Taken", not shown)
end

local function takePickup(p: PickupRt)
	p.taken = true
	p.respawnAt = os.clock() + math.max(3, p.def.respawnSec)
	setPickupShown(p, false)
end

local function pickAllowed(state: string): boolean
	return state == S.OBBY or state == S.NIGHT or state == S.CAMP
end

local function creditPickup(session: SessionLike, c: Camp, p: PickupRt, byNpc: string?)
	if p.def.pickType == "WATER" then
		c.water += 1
	else
		c.wood += 1
	end
	local pos = p.def.part.Position
	H().fx(session, "PICKUP", { pos = pos, pickType = p.def.pickType, by = byNpc })
	TelemetryService.log("camp_pick", { id = p.def.id, type = p.def.pickType, npc = byNpc ~= nil })
	takePickup(p)
	-- 밤에 물통을 주우면 나누기가 바로 열린다 (프롬프트 갱신은 tick)
	H().markDirty(session)
end

-- 다른 곳에서 건진 것 (급류 2차: 급류·바다 물 위 줍기 → RideService cbs.item → SessionService). 주머니에 넣고 할 일 판만 갱신 (연출은 RideFx)
function CampfireService.addWood(session: SessionLike, n: number, source: string?)
	local c = ensure(session)
	c.wood += math.max(0, math.floor(n))
	TelemetryService.log("camp_pick", { type = "WOOD", n = n, source = source or "?" })
	H().markDirty(session)
end

function CampfireService.addWater(session: SessionLike, n: number, source: string?)
	local c = ensure(session)
	c.water += math.max(0, math.floor(n))
	TelemetryService.log("camp_pick", { type = "WATER", n = n, source = source or "?" })
	H().markDirty(session)
end

-- 사람이 줍기 (프롬프트·DevApi)
function CampfireService.pick(session: SessionLike, pickId: string): boolean
	local p = pickups[pickId]
	if not p or p.taken or not pickAllowed(session.state) then
		return false
	end
	local c = ensure(session)
	creditPickup(session, c, p, nil)
	bend(session.player.Character, 0.35)
	return true
end

local function bindPickup(def: SceneBindings.Pickup)
	local decos: { BasePart } = {}
	local alpha: { [BasePart]: number } = {}
	local decoFolder = SceneBindings.getFolder("Decorations")
	if decoFolder then
		for _, d in ipairs(decoFolder:GetChildren()) do
			if d:IsA("BasePart") and d:GetAttribute("PickupId") == def.id then
				table.insert(decos, d)
				alpha[d] = d.Transparency
			end
		end
	end
	addPickupMesh(def, decos, alpha)
	local old = def.part:FindFirstChild("CampPickPrompt")
	if old then
		old:Destroy()
	end
	local prompt =
		newPrompt(T.promptPick, if def.pickType == "WATER" then T.promptWater else T.promptWood, C.PickDistance)
	prompt.Name = "CampPickPrompt"
	prompt.Parent = def.part
	local rt: PickupRt = {
		def = def,
		decos = decos,
		decoAlpha = alpha,
		prompt = prompt,
		taken = false,
		respawnAt = 0,
	}
	prompt.Triggered:Connect(function(player: Player)
		local get = sessionOf
		local s = if get then get(player.UserId) else nil
		if s then
			CampfireService.pick(s, def.id)
		end
	end)
	pickups[def.id] = rt
	table.insert(pickupList, rt)
	setPickupShown(rt, true)
end

function CampfireService.setScene(sc: SceneBindings.Scene, getSession: (userId: number) -> SessionLike?)
	scene = sc
	sessionOf = getSession
	table.clear(pickups)
	table.clear(pickupList)
	for _, def in ipairs(sc.pickups) do
		bindPickup(def)
	end
end

function CampfireService.setHooks(h: Hooks)
	hooks = h
end

-- 세상 공유 되돌리기 (어느 세션의 tick 이든 한 번만)
local function tickWorld(now: number)
	if now - lastWorldTick < 0.5 then
		return
	end
	lastWorldTick = now
	for _, p in ipairs(pickupList) do
		if p.taken and now >= p.respawnAt then
			p.taken = false
			setPickupShown(p, true)
		end
	end
end

-- 분대원이 제 자리 근처의 장작을 하나 집는다 (하루 한 번 — "이거 가져갈까?"). 유격·밤처럼 리그가 서 있는 때만
local function tickNpcPick(session: SessionLike, c: Camp, now: number)
	if c.npcPicked or now < c.npcCheckAt or (GameConfig.Quiet.Enabled and not GameConfig.Quiet.NpcPick) then
		return
	end
	c.npcCheckAt = now + C.NpcPickEverySec
	if session.state ~= S.OBBY and session.state ~= S.NIGHT then
		return
	end
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if not m or not rig or m.waiting then
			continue
		end
		local mood = rig.model:GetAttribute("Mood")
		if mood == "DOWN" or mood == "FROZEN" then
			continue -- 넘어져 있거나 언 사람은 줍지 않는다 (2단계)
		end
		local rp = rig.hrp.Position
		local best: PickupRt? = nil
		local bestD = C.NpcPickRadius
		for _, p in ipairs(pickupList) do
			if not p.taken and p.def.day == session.day and p.def.pickType == "WOOD" then
				local d = (p.def.part.Position - rp).Magnitude
				if d < bestD then
					best, bestD = p, d
				end
			end
		end
		if best then
			c.npcPicked = true
			local target = best.def.part.Position
			-- 그쪽으로 몸을 돌리고 숙였다가, 0.5초 뒤 집는다
			SquadNpcService.standAt(rig, rp, target - rp)
			BoatService.pose(rig.model, "READY2")
			H().bubble(session, id, (T.npcPick :: { [string]: string })[id] or T.npcPick.DURI, 2)
			local p = best
			task.delay(0.5, function()
				if not p.taken and rig.model.Parent then
					creditPickup(session, c, p, id)
				end
				if rig.model.Parent then
					BoatService.pose(rig.model, "NONE")
				end
			end)
			return
		end
	end
end

-- ===== 밤: 자리 =====
local function seatOfMember(n: Night, memberId: string): SceneBindings.SeatSpot?
	for _, s in ipairs(n.seats) do
		if s.memberId == memberId then
			return s
		end
	end
	return nil
end

-- 분대원을 제 통나무 반대쪽 끝에 앉힌다. 큰 불이면 불 쪽으로 조금 당겨 앉는다
local function sitNpc(session: SessionLike, n: Night, memberId: string)
	local _, rig = npcOf(session, memberId)
	if not rig then
		return
	end
	local seat = seatOfMember(n, memberId)
	local pos: Vector3
	if seat then
		pos = seat.part.Position - seat.part.CFrame.RightVector * 3.0
	else
		local i = table.find(SquadCatalog.NpcOrder, memberId) or 1
		local ang = math.rad(100 + i * 70)
		pos = n.center + Vector3.new(math.cos(ang) * 5.2, 0, math.sin(ang) * 5.2)
	end
	local toFire = Vector3.new(n.center.X - pos.X, 0, n.center.Z - pos.Z)
	local r = if n.level >= 3 then C.CloseRadius else C.FarRadius
	local flat = Vector3.new(pos.X, 0, pos.Z) - Vector3.new(n.center.X, 0, n.center.Z)
	if flat.Magnitude > 0.1 then
		-- 통나무 끝에서 불까지의 거리 ≈ 5.4: 큰 불이면 4.4 까지 당겨 앉는다 (의자 모양은 그대로, 사람만 가까이)
		pos = Vector3.new(n.center.X, pos.Y, n.center.Z) + flat.Unit * r
	end
	SquadNpcService.standAt(rig, pos, toFire)
	SquadNpcService.setSitting(rig, true)
	BoatService.pose(rig.model, "NONE")
	n.seated[memberId] = true
end

local function placeRoles(session: SessionLike, n: Night)
	-- 두리: 불 앞에 쪼그려 앉아 들여다본다 (제 통나무와 불 사이)
	local _, duri = npcOf(session, "DURI")
	if duri then
		local seat = seatOfMember(n, "DURI")
		local from = if seat then seat.part.Position else n.center + Vector3.new(4, 0, 0)
		local flat = Vector3.new(from.X - n.center.X, 0, from.Z - n.center.Z)
		local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(1, 0, 0)
		local pos = n.center + dir * 3.6
		SquadNpcService.standAt(duri, pos, -dir)
		SquadNpcService.setSitting(duri, true)
		BoatService.pose(duri.model, "READY2")
		SquadNpcService.setMood(duri, "ROLE_FIRE")
	end
	-- 산: 짐 상자 옆에 서서 짐을 푼다
	local _, san = npcOf(session, "SAN")
	if san then
		local seat = seatOfMember(n, "SAN")
		local base = if seat then seat.part.Position else n.center + Vector3.new(-4, 0, 4)
		local flat = Vector3.new(base.X - n.center.X, 0, base.Z - n.center.Z)
		local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(-1, 0, 0)
		local cratePos = n.center + dir * 8.6
		local side = Vector3.new(-dir.Z, 0, dir.X) -- 산이 서는 쪽
		local gy = groundAt(cratePos)
		local crate = Instance.new("Model")
		crate.Name = "CampCrate_" .. session.userId
		crate:SetAttribute("ProjectId", SceneBindings.ProjectId)
		-- 마감 패스: 메시 상자 둘 + 랜턴(따뜻한 빛) — 라이브러리가 없으면 예전 기본 파트 상자
		local function meshAt(key: string, pos: Vector3, yawDeg: number, height: number, lift: number?): Model?
			local y = gy + (lift or 0)
			local cf = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(n.center.X, y, n.center.Z))
				* CFrame.Angles(0, math.rad(yawDeg), 0)
			local m = AssetLibrary.clone(key, cf, AssetLibrary.scaleForHeight(key, height))
			if m then
				m.Parent = crate
			end
			return m
		end
		local big = meshAt("Crate", cratePos + side * 0.2, 0, 1.5)
		if big then
			meshAt("Crate", cratePos - side * 0.95 + dir * 0.2, 18, 1.0)
			local lantern = meshAt("Lantern", cratePos + side * 0.2, 30, 0.85, 1.48)
			local glass = lantern and lantern:FindFirstChildWhichIsA("BasePart")
			if glass then
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 196, 120)
				light.Range = 11
				light.Brightness = 1.3
				light.Shadows = false
				light.Parent = glass
			end
		else
			local box = Instance.new("Part")
			box.Name = "Box"
			box.Size = Vector3.new(2.2, 1.6, 1.6)
			box.Color = Color3.fromHex("6E5A3A")
			box.Material = Enum.Material.WoodPlanks
			box.Anchored = true
			box.CanCollide = false
			box.CanQuery = false
			box.CanTouch = false
			box.CFrame = CFrame.lookAt(
				Vector3.new(cratePos.X, gy + 0.8, cratePos.Z),
				Vector3.new(n.center.X, gy + 0.8, n.center.Z)
			)
			box.Parent = crate
			local lid = Instance.new("Part")
			lid.Name = "Lid"
			lid.Size = Vector3.new(2.4, 0.2, 1.8)
			lid.Color = Color3.fromHex("8B6A3F")
			lid.Material = Enum.Material.Wood
			lid.Anchored = true
			lid.CanCollide = false
			lid.CanQuery = false
			lid.CanTouch = false
			lid.CFrame = box.CFrame * CFrame.new(0, 0.9, 0.7) * CFrame.Angles(math.rad(-60), 0, 0)
			lid.Parent = crate
		end
		crate.Parent = SceneBindings.ensureRuntimeFolder()
		table.insert(n.props, crate)
		local stand = cratePos + (Vector3.new(-dir.Z, 0, dir.X)) * 1.8
		SquadNpcService.standAt(san, stand, cratePos - stand)
		SquadNpcService.setSitting(san, false)
		BoatService.pose(san.model, "READY2")
		SquadNpcService.setMood(san, "ROLE_PACK")
	end
	-- 미르: 유보트 옆구리에 붙어 그림을 그린다
	local _, mir = npcOf(session, "MIR")
	if mir then
		local root = session.boat.root
		local pos = root.Position + root.CFrame.RightVector * 5.5 + root.CFrame.LookVector * 2
		SquadNpcService.standAt(mir, pos, -root.CFrame.RightVector)
		SquadNpcService.setSitting(mir, false)
		BoatService.pose(mir.model, "READY")
		SquadNpcService.setMood(mir, "ROLE_DRAW")
	end
end

local function setLevel(session: SessionLike, n: Night, level: number)
	if level == n.level then
		return
	end
	n.level = level
	if n.fire then
		n.fire.part:SetAttribute("FireLevel", level)
	end
	H().fx(session, "FIRE_LEVEL", { level = level, pos = n.center })
	-- 앉아 있는 분대원은 불 크기에 맞춰 다시 앉는다 (큰 불이면 가까이)
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		if n.seated[id] then
			sitNpc(session, n, id)
		end
	end
	if level >= 3 and not n.bigSaid then
		n.bigSaid = true
		H().lines(session, { T.fireBig })
		local _, duri = npcOf(session, "DURI")
		if duri then
			SquadNpcService.playOnce(duri, "cheer")
		end
	elseif level == 2 and not n.midSaid then
		n.midSaid = true
		H().bubble(session, "DURI", T.fireMid.text, T.fireMid.sec)
	end
end

local function feedOnce(session: SessionLike, c: Camp, n: Night, byMe: boolean)
	if c.wood <= 0 then
		return false
	end
	c.wood -= 1
	c.fed += 1
	if byMe then
		c.verbs += 1
		session.rec.fireFed = (session.rec.fireFed or 0) + 1
		bend(session.player.Character, 0.3)
		if not n.firstFeedSaid then
			n.firstFeedSaid = true
			H().bubble(session, "DURI", T.feedFirst, 2)
		end
	end
	H().fx(session, "FIRE_FEED", { pos = n.center, level = levelOf(c.fed) })
	TelemetryService.log("camp_feed", { byMe = byMe, fed = c.fed })
	setLevel(session, n, levelOf(c.fed))
	if c.fed >= C.Level3Wood and byMe then
		-- 큰 불이 되면 산이 한마디, 4박부터 미르도
		task.delay(1.2, function()
			if c.night == n then
				H().bubble(session, "SAN", T.feedBig, 2)
				if n.day >= 4 then
					task.delay(1.0, function()
						if c.night == n then
							H().bubble(session, "MIR", T.feedMirLate, 2)
						end
					end)
				end
			end
		end)
	end
	H().markDirty(session)
	return true
end

-- E 넣기 (프롬프트·DevApi)
function CampfireService.feed(session: SessionLike): boolean
	local c = ensure(session)
	local n = c.night
	if not n or session.state ~= S.NIGHT then
		return false
	end
	return feedOnce(session, c, n, true)
end

-- E 나눠 주기: 물통이 먼저, 없으면 간식 (짐에 있을 때). 한 사람에게 하룻밤 한 번
function CampfireService.give(session: SessionLike, memberId: string): boolean
	local c = ensure(session)
	local n = c.night
	if not n or session.state ~= S.NIGHT then
		return false
	end
	local m, rig = npcOf(session, memberId)
	if not m or not rig or c.gave[memberId] then
		return false
	end
	local item: string
	if c.water > 0 then
		c.water -= 1
		item = "WATER"
	elseif BoatLoadout.hasCargo(session.loadout, "SNACK") and not n.snackGiven then
		n.snackGiven = true
		item = "SNACK"
	else
		return false
	end
	c.gave[memberId] = true
	c.verbs += 1
	session.rec.gaveTo = (session.rec.gaveTo or 0) + 1
	m.morale = math.min(1, m.morale + C.GiveMorale)
	local pool = if item == "WATER" then T.giveWater else T.giveSnack
	H().bubble(session, memberId, (pool :: { [string]: string })[memberId] or "…", 2.2)
	if memberId == "MIR" then
		-- 미르는 말 대신 그림 한 장 (흔적 살펴보기 말투)
		task.delay(0.8, function()
			if c.night == n then
				H().cue(session, "TRACE", { text = T.mirGiveTrace })
			end
		end)
	end
	SquadNpcService.setMood(rig, "HAPPY")
	SquadNpcService.playOnce(rig, if memberId == "DURI" then "cheer" else "wave")
	H().fx(session, "GIVE", { pos = rig.hrp.Position, memberId = memberId, item = item })
	bend(session.player.Character, 0.3)
	TelemetryService.log("camp_give", { to = memberId, item = item })
	H().markDirty(session)
	return true
end

-- 그 사람의 오늘 이야기: 기존 밤 대사(그 사람 줄)가 먼저, 없으면 CampScript.Campfire.sitLines, 다 했으면 짧은 한마디
local function storyLines(n: Night, memberId: string): { string }
	local out: { string } = {}
	local night = CampScript.Nights[n.day]
	if night then
		for _, l in ipairs(night.lines) do
			if l.who == memberId then
				table.insert(out, l.text)
			end
		end
	end
	local extra = (T.sitLines :: { [number]: { [string]: { string } } })[n.day]
	local mine = if extra then extra[memberId] else nil
	if mine then
		for _, t in ipairs(mine) do
			if not table.find(out, t) then
				table.insert(out, t)
			end
		end
	end
	return out
end

-- 앉기: 그 통나무의 분대원이 이야기한다 (프롬프트 없음 — Seat 에 앉으면 서버가 안다)
function CampfireService.sit(session: SessionLike, memberId: string): boolean
	local c = ensure(session)
	local n = c.night
	if not n or session.state ~= S.NIGHT then
		return false
	end
	local m, rig = npcOf(session, memberId)
	if not m or not rig then
		return false
	end
	-- 아직 역할 중이면 그 순간을 먼저 하고 와서 앉는다 (산 짐 풀기 · 미르 그림)
	if memberId == "SAN" and not n.sanDone then
		n.sanAt = 0
	elseif memberId == "MIR" and not n.mirDone then
		n.mirAt = 0
	end
	if not n.seated[memberId] and memberId == "DURI" then
		sitNpc(session, n, "DURI")
	end
	local all = storyLines(n, memberId)
	local idx = n.sitIdx[memberId] or 0
	local list: { Line } = {}
	-- 오늘 내가 일으켜/풀어 준 사람이면 고마움 한 줄이 먼저 (2단계, 하룻밤 한 번)
	local thanks = RescueService.thanksTonight(session, memberId)
	if thanks then
		table.insert(list, thanks)
	end
	if idx >= #all then
		table.insert(
			list,
			{ who = memberId, text = (T.sitAgain :: { [string]: string })[memberId] or "…", sec = 1.6 }
		)
	else
		for i = idx + 1, math.min(#all, idx + 2) do
			table.insert(list, { who = memberId, text = all[i], sec = math.clamp(#all[i] * 0.11 + 1.2, 1.5, 3.2) })
		end
		n.sitIdx[memberId] = math.min(#all, idx + 2)
	end
	if not c.sat[memberId] then
		c.sat[memberId] = true
		c.verbs += 1
	end
	-- 조용한 분대원: 옆에 앉았을 때 이야기는 남긴다 (말 길이만큼 열어 둔다)
	local talkSec = 1
	for _, l in ipairs(list) do
		talkSec += (l.sec or 2) + 0.2
	end
	SquadNpcService.allowSpeech(rig, talkSec)
	-- 말풍선 + 자막 (같은 줄, 자막은 순서대로)
	H().lines(session, list)
	local acc = 0
	for _, l in ipairs(list) do
		local delay = acc
		task.delay(delay, function()
			if c.night == n then
				H().bubble(session, memberId, l.text, l.sec)
			end
		end)
		acc += (l.sec or 2) + 0.2
	end
	-- 내 쪽을 한 번 보고 (고개 대신 몸을 잠깐) 다시 불을 본다
	local ch = session.player.Character
	if ch then
		local me = ch:GetPivot().Position
		local rp = rig.hrp.Position
		SquadNpcService.standAt(rig, rp, Vector3.new(me.X - rp.X, 0, me.Z - rp.Z))
		task.delay(acc + 0.4, function()
			if c.night == n and n.seated[memberId] then
				SquadNpcService.standAt(rig, rig.hrp.Position, n.center - rig.hrp.Position)
			end
		end)
	end
	TelemetryService.log("camp_sit", { who = memberId, idx = n.sitIdx[memberId] })
	H().markDirty(session)
	return true
end

-- ===== 밤 들어가기 / 나가기 =====
local function refreshPrompts(session: SessionLike, c: Camp, n: Night)
	if n.feedPrompt then
		n.feedPrompt.Enabled = c.wood > 0
	end
	local give = canGive(session, c)
	for id, p in pairs(n.givePrompts) do
		p.Enabled = give and not c.gave[id]
	end
end

function CampfireService.enterNight(session: SessionLike, day: number)
	local c = ensure(session)
	if c.night then
		CampfireService.leaveNight(session)
	end
	local sc = scene
	local fire = if sc then sc.firesByDay[day] else nil
	local seats = if sc and fire then (sc.seatsByFire[fire.id] or {}) else {}
	local root = session.boat.root
	local center = if fire then fire.part.Position else (root.Position - root.CFrame.LookVector * 5)
	center = Vector3.new(center.X, if fire then center.Y - 1.3 else center.Y, center.Z)
	local night = CampScript.Nights[day]
	local n: Night = {
		day = day,
		fire = fire,
		seats = seats,
		center = center,
		startAt = os.clock(),
		level = 0,
		holder = nil,
		feedPrompt = nil,
		givePrompts = {},
		props = {},
		conns = {},
		sitIdx = {},
		seated = {},
		duriNext = os.clock() + C.DuriFirstSec,
		duriTalk = 0,
		duriFed = 0,
		sanAt = os.clock() + C.SanUnpackSec,
		sanDone = false,
		mirAt = os.clock() + C.MirDrawSec,
		mirDone = false,
		smallAt = os.clock() + 14,
		smallSaid = false,
		lonelySaid = false,
		firstFeedSaid = false,
		bigSaid = false,
		midSaid = false,
		snackGiven = false,
		kangLines = {},
		systemLines = {},
		sticker = if night then night.sticker else nil,
		trace = if night then night.trace else nil,
		promptCheckAt = 0,
	}
	c.night = n
	c.day = day
	c.fed = 0
	c.gave = {}
	c.sat = {}
	c.verbs = 0
	if night then
		for _, l in ipairs(night.lines) do
			if l.who == "KANG" then
				table.insert(n.kangLines, l)
			elseif l.who == "SYSTEM" then
				table.insert(n.systemLines, l)
			end
		end
	end
	-- 불: 작은 불부터 (장작 0개여도 핀다)
	setLevel(session, n, 1)
	-- 넣기 프롬프트: 세션 소유 보이지 않는 파트 (모닥불은 세상 공유라 사람마다 하나씩, ForUserId 로 구분 — PromptController 가 남의 것을 숨긴다)
	local holder = Instance.new("Part")
	holder.Name = "CampfirePrompts_" .. session.userId
	holder.Size = Vector3.new(1, 1, 1)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Position = center + Vector3.new(0, 1.6, 0)
	holder:SetAttribute("ProjectId", SceneBindings.ProjectId)
	holder:SetAttribute("ForUserId", session.userId)
	holder.Parent = SceneBindings.ensureRuntimeFolder()
	n.holder = holder
	local feed = newPrompt(T.promptFeed, T.promptFire, C.FeedDistance)
	feed.Name = "CampFeedPrompt"
	feed:SetAttribute("ForUserId", session.userId)
	feed.Parent = holder
	n.feedPrompt = feed
	table.insert(
		n.conns,
		feed.Triggered:Connect(function(player: Player)
			if player == session.player then
				CampfireService.feed(session)
				refreshPrompts(session, c, n)
			end
		end)
	)
	-- 나누기 프롬프트: 분대원 리그마다 (리그는 세션 것이라 사람마다 따로)
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m, rig = npcOf(session, id)
		if m and rig then
			local old = rig.hrp:FindFirstChild("CampGivePrompt")
			if old then
				old:Destroy()
			end
			local p = newPrompt(T.promptGive, m.def.nameKo, C.GiveDistance)
			p.Name = "CampGivePrompt"
			p:SetAttribute("ForUserId", session.userId)
			p.Parent = rig.hrp
			n.givePrompts[id] = p
			table.insert(
				n.conns,
				p.Triggered:Connect(function(player: Player)
					if player == session.player then
						CampfireService.give(session, id)
						refreshPrompts(session, c, n)
					end
				end)
			)
		end
	end
	-- 앉기: 통나무 의자 (Seat) — 내 캐릭터가 앉으면 그 통나무의 분대원이 이야기한다
	for _, seat in ipairs(seats) do
		seat.part.Disabled = false
		table.insert(
			n.conns,
			seat.part:GetPropertyChangedSignal("Occupant"):Connect(function()
				local occ = seat.part.Occupant
				local ch = session.player.Character
				if occ and ch and occ:IsDescendantOf(ch) and session.state == S.NIGHT and c.night == n then
					if seat.memberId then
						CampfireService.sit(session, seat.memberId)
					end
				end
			end)
		)
	end
	placeRoles(session, n)
	refreshPrompts(session, c, n)
	-- 교관 한 줄은 바로 (나머지 이야기는 앉아서 듣는다)
	if #n.kangLines > 0 then
		H().lines(session, { n.kangLines[1] })
	end
	TelemetryService.log("camp_night", { day = day, wood = c.wood, water = c.water })
	H().markDirty(session)
end

local function journalLine(session: SessionLike, c: Camp, n: Night): string
	local parts = { (T.journalFire :: { [number]: string })[n.level] or T.journalFire[1] }
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		if c.gave[id] then
			local m = session.members[id]
			table.insert(parts, string.format(T.journalGave, (if m then m.def.nameKo else id) .. "에게"))
		end
	end
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		if c.sat[id] then
			local m = session.members[id]
			table.insert(parts, string.format(T.journalSat, if m then m.def.nameKo else id))
		end
	end
	return "🔥 " .. table.concat(parts, " · ")
end

function CampfireService.leaveNight(session: SessionLike)
	local c = camps[session.userId]
	if not c or not c.night then
		return
	end
	local n = c.night :: Night
	c.night = nil
	H().addJournal(session, n.day, journalLine(session, c, n))
	for _, conn in ipairs(n.conns) do
		conn:Disconnect()
	end
	for _, p in ipairs(n.props) do
		p:Destroy()
	end
	for _, p in pairs(n.givePrompts) do
		p:Destroy()
	end
	if n.holder then
		n.holder:Destroy()
	end
	if n.fire then
		n.fire.part:SetAttribute("FireLevel", 0)
	end
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local _, rig = npcOf(session, id)
		if rig then
			BoatService.pose(rig.model, "NONE")
			SquadNpcService.setMood(rig, "IDLE")
		end
	end
	-- 내일을 위해 주머니를 비운다 (낮에 다시 줍는다 — 규칙 ⑤: 결과는 일지·불 크기로 남는다)
	c.wood = 0
	c.water = 0
	c.fed = 0
	c.gave = {}
	c.sat = {}
	c.verbs = 0
	H().markDirty(session)
end

function CampfireService.beginDay(session: SessionLike, day: number)
	local c = ensure(session)
	if c.night then
		CampfireService.leaveNight(session)
	end
	if c.day ~= day then
		c.wood = 0
		c.water = 0
	end
	c.day = day
	c.fed = 0
	c.gave = {}
	c.sat = {}
	c.verbs = 0
	c.npcPicked = false
	c.npcCheckAt = os.clock() + 4
	H().markDirty(session)
end

function CampfireService.onPlayerRemoving(session: SessionLike)
	local c = camps[session.userId]
	if c and c.night then
		-- 나가는 사람의 일지는 남기지 않는다 (저장은 SessionService 가 한다)
		local n = c.night :: Night
		c.night = nil
		for _, conn in ipairs(n.conns) do
			conn:Disconnect()
		end
		for _, p in ipairs(n.props) do
			p:Destroy()
		end
		if n.holder then
			n.holder:Destroy()
		end
		if n.fire then
			n.fire.part:SetAttribute("FireLevel", 0)
		end
	end
	camps[session.userId] = nil
end

-- "내일로" 가 켜졌나: 90초가 지났거나 동사 하나를 했으면
function CampfireService.nightReady(session: SessionLike): boolean
	local c = camps[session.userId]
	local n = c and c.night
	if not c or not n then
		return true
	end
	return c.verbs > 0 or os.clock() - n.startAt >= C.MinNightSec
end

-- ===== 틱 =====
local function tickNight(session: SessionLike, c: Camp, n: Night, now: number)
	if session.state ~= S.NIGHT then
		return
	end
	if now >= n.promptCheckAt then
		n.promptCheckAt = now + 0.5
		refreshPrompts(session, c, n)
	end
	-- 두리: 25초부터 12초마다 장작 — 아이 주머니에 있으면 하나 넣고(최대 2: 아이가 안 해도 불은 좀 커지지만 큰 불은 아이 몫), 없으면 넣는 시늉 + 가끔 한마디
	if now >= n.duriNext then
		n.duriNext = now + C.DuriLogEverySec
		local _, duri = npcOf(session, "DURI")
		if duri then
			BoatService.pose(duri.model, "LIFT")
			local fedNow = n.duriFed < C.DuriFeedsMax and feedOnce(session, c, n, false)
			if fedNow then
				n.duriFed += 1
			end
			if not fedNow then
				H().fx(session, "FIRE_FEED", { pos = n.center, level = n.level, mime = true })
			end
			n.duriTalk += 1
			if fedNow or n.duriTalk % 2 == 1 then
				local pool = T.duriLog
				H().bubble(session, "DURI", pool[(n.duriTalk - 1) % #pool + 1], 1.8)
			end
			task.delay(0.6, function()
				if c.night == n and duri.model.Parent then
					BoatService.pose(duri.model, if n.seated.DURI then "NONE" else "READY2")
				end
			end)
		end
	end
	-- 산: 20초에 짐을 푼다 → 간식이 있으면 돌린다 → 제 통나무에 앉는다
	if not n.sanDone and now >= n.sanAt then
		n.sanDone = true
		local _, san = npcOf(session, "SAN")
		if san then
			local snack = BoatLoadout.hasCargo(session.loadout, "SNACK") and not n.snackGiven
			if snack then
				n.snackGiven = true
				H().bubble(session, "SAN", T.sanUnpackSnack, 2.2)
				for _, id in ipairs({ "DURI", "MIR" }) do
					local m, rig = npcOf(session, id)
					if m and rig then
						m.morale = math.min(1, m.morale + C.GiveMorale * 0.5)
						task.delay(1.4, function()
							if c.night == n then
								H().bubble(session, id, (T.sanSnackThanks :: { [string]: string })[id] or "…", 1.8)
								H().fx(
									session,
									"GIVE",
									{ pos = rig.hrp.Position, memberId = id, item = "SNACK", by = "SAN" }
								)
							end
						end)
					end
				end
			else
				H().bubble(session, "SAN", T.sanUnpackPlain, 1.8)
			end
			SquadNpcService.playOnce(san, "wave")
			task.delay(2.2, function()
				if c.night == n and san.model.Parent then
					SquadNpcService.setMood(san, "IDLE")
					sitNpc(session, n, "SAN")
				end
			end)
		end
	end
	-- 미르: 25초에 유보트에 그림(스티커 = 흔적) → 제 통나무에 앉는다
	if not n.mirDone and now >= n.mirAt then
		n.mirDone = true
		local _, mir = npcOf(session, "MIR")
		if n.sticker then
			H().addSticker(session, n.sticker :: string)
		end
		if n.trace then
			H().cue(session, "TRACE", { text = n.trace })
		end
		if #n.systemLines > 0 then
			H().lines(session, n.systemLines)
		end
		if mir then
			H().bubble(session, "MIR", T.mirDraw, 1.5)
			BoatService.pose(mir.model, "LIFT")
			task.delay(2.0, function()
				if c.night == n and mir.model.Parent then
					SquadNpcService.setMood(mir, "IDLE")
					sitNpc(session, n, "MIR")
				end
			end)
		end
	end
	-- 작은 불인데 넣을 장작도 없으면 산이 한마디 (벌 아님 — 내일 더 주우면 된다)
	if not n.smallSaid and now >= n.smallAt then
		n.smallSaid = true
		if n.level <= 1 and c.wood == 0 then
			H().lines(session, { T.fireSmall })
		end
	end
	-- 아무에게도 안 앉은 채 90초: 두리가 부른다
	if not n.lonelySaid and now - n.startAt >= C.LonelyLineSec then
		n.lonelySaid = true
		if next(c.sat) == nil then
			H().bubble(session, "DURI", T.lonely, 2.4)
			local _, duri = npcOf(session, "DURI")
			if duri then
				SquadNpcService.playOnce(duri, "wave")
			end
		end
		H().markDirty(session) -- 내일로 켜짐
	end
end

function CampfireService.tick(session: SessionLike, _dt: number)
	local now = os.clock()
	tickWorld(now)
	local c = camps[session.userId]
	if not c then
		return
	end
	if c.night then
		tickNight(session, c, c.night :: Night, now)
	end
	tickNpcPick(session, c, now)
end

-- ===== 스냅샷 =====
function CampfireService.view(session: SessionLike): ProtocolTypes.CampView?
	local c = camps[session.userId]
	if not c then
		return nil
	end
	local n = c.night
	local nextIn: number? = nil
	if n then
		nextIn = if c.verbs > 0 then 0 else math.max(0, C.MinNightSec - (os.clock() - n.startAt))
	end
	return {
		wood = c.wood,
		water = c.water,
		fire = if n then n.level else 0,
		fed = c.fed,
		gave = c.gave,
		sat = c.sat,
		nextIn = nextIn,
		canGive = canGive(session, c),
	}
end

-- Studio 검증용 (DevApi "camp", "wood"|"water", n): 주머니를 직접 채운다
function CampfireService.devSet(session: SessionLike, key: string, value: number)
	local c = ensure(session)
	if key == "wood" then
		c.wood = math.max(0, math.floor(value))
	elseif key == "water" then
		c.water = math.max(0, math.floor(value))
	end
	if c.night then
		refreshPrompts(session, c, c.night :: Night)
	end
	H().markDirty(session)
end

-- Studio 검증용 (DevApi "camp")
function CampfireService.debug(session: SessionLike): { [string]: any }
	local c = camps[session.userId]
	local out: { [string]: any } = { state = session.state, day = session.day }
	if c then
		out.wood = c.wood
		out.water = c.water
		out.fed = c.fed
		out.verbs = c.verbs
		out.npcPicked = c.npcPicked
		local gave, sat = {}, {}
		for id in pairs(c.gave) do
			table.insert(gave, id)
		end
		for id in pairs(c.sat) do
			table.insert(sat, id)
		end
		out.gave = table.concat(gave, ",")
		out.sat = table.concat(sat, ",")
		local n = c.night
		if n then
			out.fire = n.level
			out.fireId = if n.fire then n.fire.id else "(boat)"
			out.fireLevelAttr = if n.fire then n.fire.part:GetAttribute("FireLevel") else nil
			out.seats = #n.seats
			out.elapsed = os.clock() - n.startAt
			out.ready = CampfireService.nightReady(session)
			out.feedPrompt = if n.feedPrompt then n.feedPrompt.Enabled else nil
			local gp = {}
			for id, p in pairs(n.givePrompts) do
				table.insert(gp, id .. "=" .. tostring(p.Enabled))
			end
			out.givePrompts = table.concat(gp, ",")
			out.sanDone = n.sanDone
			out.mirDone = n.mirDone
			out.center = n.center
		end
	end
	local taken, total, today = 0, 0, 0
	for _, p in ipairs(pickupList) do
		total += 1
		if p.taken then
			taken += 1
		end
		if p.def.day == session.day then
			today += 1
		end
	end
	out.pickups = string.format("%d total · %d today · %d taken", total, today, taken)
	return out
end

-- 오늘 줍을 것 목록 (DevApi: 가까운 것부터)
function CampfireService.pickupsNear(pos: Vector3, day: number?): { { id: string, d: number, taken: boolean } }
	local out = {}
	for _, p in ipairs(pickupList) do
		if day == nil or p.def.day == day then
			table.insert(out, { id = p.def.id, d = (p.def.part.Position - pos).Magnitude, taken = p.taken })
		end
	end
	table.sort(out, function(a, b)
		return a.d < b.d
	end)
	return out
end

-- 분대원 자리로 내 캐릭터를 옮기는 검증용 좌표 (의자 위치)
function CampfireService.seatPosition(session: SessionLike, memberId: string): Vector3?
	local c = camps[session.userId]
	local n = c and c.night
	if not n then
		return nil
	end
	local seat = seatOfMember(n :: Night, memberId)
	return if seat then seat.part.Position else nil
end

return CampfireService
]]></string>
