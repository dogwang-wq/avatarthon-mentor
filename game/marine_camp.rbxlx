	-- 의자는 길 건너편에 있다 — 열병식처럼 유보트가 무대와 의자 사이를 지난다.
	-- (2026-10-19 2차: 무대가 1일차 길 한가운데(0,-62)에 있어 출발하자마자 유보트가 의자·무대·뒷막·가로등을 뚫고 지나갔다)
	local SO = Vector3.new(22, 0, -46) -- 무대 가운데
	local SF = Vector3.new(-1, 0, 0) -- 무대 앞(관객·길 쪽)
	local function stageAt(w: number, y: number, f: number): CFrame
		-- w: 무대 폭 방향(+z), f: 앞으로(SF). 앞면(Front)이 길 쪽을 본다
		return facing(Vector3.new(SO.X + SF.X * f, y, SO.Z + w), SF)
	end
