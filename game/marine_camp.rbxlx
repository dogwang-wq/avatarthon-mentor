	promptSwap = "바꿔 들기",
	promptLoad = "싣기",
	promptStick = "붙이기",
	promptOar = "노 바꾸기",
	promptUnload = "빼기",
	promptBoat = "유보트",
	promptSeat = "내 자리",
	promptTake = "받기",
	promptGo = "출발!",
	promptGoWhat = "출발 깃발",
	offerWhat = "%s %s", -- "두리의 구급상자" (앞은 KoreanText.josa(이름, "의") 대신 이름 .. "의")
	-- 부품 이름·이모지 (더미 PartType)
	partName = {
		OAR_LONG = "긴 노",
		OAR_SHORT = "짧은 노",
		WATER = "물통",
		FLAG = "깃발",
		AID = "구급상자",
		SNACK = "간식",
		STICKER_A = "별 스티커",
		STICKER_B = "물결 스티커",
		STICKER_C = "고래 스티커",
		GO = "출발 깃발",
	} :: { [string]: string },
	partIcon = {
		OAR_LONG = "🥢",
		OAR_SHORT = "🥄",
		WATER = "💧",
		FLAG = "🚩",
		AID = "🩹",
		SNACK = "🍙",
		STICKER_A = "⭐",
		STICKER_B = "🌊",
		STICKER_C = "🐳",
		GO = "🚩",
	} :: { [string]: string },
	seatName = { FL = "앞 왼쪽", FR = "앞 오른쪽", BL = "뒤 왼쪽", BR = "뒤 오른쪽" } :: { [string]: string },
	-- 시작 (작전 제목 + 교관 한 줄, 키 이름 없음 — 프롬프트가 기기마다 맞는 입력을 보여 준다).
	-- 첫 1분(2026-10-21): "더미에서 집어 실어" 안내는 여기서 빼 hintPick 으로 — 두리가 내미는 동안 할 일이 둘로 겹쳤다
	start = {
		{ who = "SYSTEM", text = "🎖️ 작전 1 · 유보트 꾸미기", sec = 1.8 },
		{ who = "KANG", text = "출발 전에 배부터 꾸며! 다 되면 깃발!", sec = 2.8 },
	} :: { Line },
	-- 아직 더미에서 직접 집지 않았으면 두리 내밀기가 끝난 뒤 한 번 (집어 봤으면 안 나옴)
	hintPick = { who = "SYSTEM", text = "🛠️ 더미에서 집어 유보트에 실어 보세요!", sec = 3.5 },
	-- 분대원이 들고 와 내민다 (그 사람이 바라는 것과 이유 — 가설 2)
	offer = {
		DURI = { part = "AID", line = "떨어져도 금방… 다시 올라올 수 있대" },
		SAN = { part = "WATER", line = "무거운 건 내가" },
		MIR = { part = "FLAG", line = "…이거 있으면 악! 소리 커" },
	} :: { [string]: { part: string, line: string } },
	-- 그 사람 것이 이미 실려 있으면 다른 것 (없으면 안 내민다)
	offerAlt = {
		DURI = { part = "SNACK", line = "간식도! 밤에 배고파" },
		SAN = { part = "SNACK", line = "…간식" },
		MIR = { part = "STICKER_C", line = "…이것도 붙여" },
	} :: { [string]: { part: string, line: string } },
	offerThanks = { DURI = "좋아! 실었다", SAN = "…됐다", MIR = "…(끄덕)" } :: { [string]: string },
	later = "응, 다음에", -- 안 받거나 짐이 꽉 찼을 때 (서운해하지 않는다)
	full = "…꽉 찼어", -- 산: 짐 세 칸이 다 찼을 때 (든 것은 제자리로)
	already = "그거 벌써 실었어", -- 두리: 같은 짐을 또 실으려 할 때
	stickerAgain = "…거기 붙어 있어", -- 미르: 같은 스티커
	-- 붙일 때 분대원 반응 (말풍선, 수치 없음)
	react = {
		OAR_LONG = { who = "DURI", text = "긴 노! 세게 저어 보자" },
		OAR_SHORT = { who = "SAN", text = "…짧은 거. 편하다" },
		WATER = { who = "SAN", text = "…물" },
		FLAG = { who = "MIR", text = "…펄럭" },
		AID = { who = "DURI", text = "이거 있으면 든든하지" },
		SNACK = { who = "DURI", text = "간식! 최고" },
		STICKER = { who = "MIR", text = "…예쁘다" },
	} :: { [string]: { who: string, text: string } },
	unload = "빼자, 빼자", -- 두리: 마지막 짐을 뺄 때
	seatMove = { DURI = "그럼 난 저기!", SAN = "…응", MIR = "…" } :: { [string]: string }, -- 내 자리에 있던 사람이 옮기며
	idle = "출발할까?", -- 두리: 오래 가만히 있을 때 (지시 아님, 부르는 말)
	autoGo = { who = "KANG", text = "시간 됐다. 출발!", sec = 2.2 },
	go = { who = "KANG", text = "좋다! 그 배로 간다", sec = 2.2 },
	goPlain = { who = "KANG", text = "기본 배로 간다! 출발!", sec = 2.2 },
	skipBtn = "⏩ 바로 출발", -- 꾸미기 건너뛰기 버튼 (플레이테스트 2026-10-21)
	skipPacked = { who = "DURI", text = "짐은 우리가 챙겼어! 가자!", sec = 2 }, -- 바로 출발: 빈 짐이면 분대원이 제 짐을 싣는다
	-- 두 번째 입소: 거치대 옆 반투명 판 (가설 1 — 지난번과 견주기)
	ghostTitle = "👀 지난번 배치",
	ghost = "%s · %s · 내 자리 %s",
	ghostNone = "짐 없음",
	-- 할 일 판 (CampHud)
