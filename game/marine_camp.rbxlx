      <Item class="ModuleScript" referent="6188">
        <Properties>
          <string name="Name">AudioCueMap</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{710071BB-1EDB-4389-BA2B-9CB07D1B6E04}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 효과음·음악·환경음. 코드에서는 cue ID 로만 요청하고 실제 asset ID 는 여기에만 둔다.
-- assetId "" 는 미확보: 소리를 건너뛰고 시각 반응만. 존재하지 않는 ID 를 채우지 않는다.
-- 채워진 ID 는 전부 Creator Store 라이브러리 음원(Pro Sound Effects·APM Music — Roblox 경험 안 사용 허용)이다.
-- Rob_mind 2026-10-17/18 확인분 + 2026-10-19·20 이 프로젝트 확인분 + 2026-10-21 소리 패스(27 계획 새 장면)에서
-- search_asset 로 찾아 Studio(Camp.rbxl Play·Client)에서 IsLoaded·TimeLength·PlaybackLoudness 를 잰 것만 넣었다
-- (docs/progress/evidence/2026-10-21_audio.txt, docs/art/AUDIO_CUE_PLAN.csv). 사람 귀로 듣는 검수는 NOT_RUN.
-- 음량 기준: gain 은 PlaybackLoudness(Volume 0.5) 측정치로 맞췄다 — 음악은 평균×gain ≈ 100(잠입·편지는 더 작게),
-- 효과음은 봉우리×gain ≈ 120~200. 버스(설정 슬라이더)가 그 위에 곱해진다.

export type Cue = {
	assetId: string,
	bus: string, -- SFX | SENSORY | MUSIC
	gain: number,
	loop: boolean,
	spatial: boolean, -- true 면 FxCue 에 pos 가 있을 때 그 자리에서 3D 로 (가까이 20 스터드까지는 그대로 큼)
	cooldownSec: number,
	maxInstances: number,
	priority: number,
	startAt: number?, -- 재생 시작 위치(초): 긴 음원의 쓸 부분만
	maxSec: number?, -- 이 시간 뒤 0.25초 페이드로 끊음 (긴 음원을 짧게)
}

local AudioCueMap = {}

AudioCueMap.Buses = { SFX = 0.65, SENSORY = 0.45, MUSIC = 0.35 }
AudioCueMap.MasterDefault = 0.75
AudioCueMap.MaxVoices = 10

local function cue(assetId: string, bus: string, gain: number, loop: boolean, spatial: boolean, cd: number): Cue
	return {
		assetId = assetId,
		bus = bus,
		gain = gain,
		loop = loop,
		spatial = spatial,
		cooldownSec = cd,
		maxInstances = 2,
		priority = 3,
	}
end

-- 긴 음원 일부만: 시작 위치·길이
local function cut(c: Cue, startAt: number, maxSec: number): Cue
	c.startAt = startAt
	c.maxSec = maxSec
	return c
end

AudioCueMap.Cues = {
	-- ===== 체력단련장 박자 (TrainingController → 서버 HIT): GOOD 은 맑은 목탁, OK 는 둔한 나무, MISS 는 스티로폼 삐끗 =====
	SFX_BEAT_GOOD = cue("rbxassetid://9120917609", "SFX", 0.6, false, false, 0.08),
	SFX_BEAT_OK = cue("rbxassetid://9126267413", "SFX", 0.45, false, false, 0.08),
	SFX_BEAT_MISS = cue("rbxassetid://9119660325", "SFX", 0.45, false, false, 0.15), -- 표적 빗나감에도 씀
	-- ===== 공용 =====
	SFX_CP = cue("rbxassetid://9125921376", "SFX", 0.65, false, false, 1.0), -- 체크포인트 잠금·급류 도착
	SFX_STICKER = cue("rbxassetid://9113826866", "SFX", 0.5, false, false, 0.2), -- 천 스침
	SFX_BELL = cue("rbxassetid://9119983674", "SFX", 0.6, false, true, 0.5), -- 깃발 찍음
	SFX_CANDLE = cue("rbxassetid://9116394545", "SFX", 0.7, false, false, 2.0), -- 촛불·수료·봉투
	SFX_SUPPORT = cue("rbxassetid://9113826866", "SFX", 0.55, false, false, 0.3), -- 천 스침 (SFX_STICKER 와 같은 음원): 손 잡아 줌·나뭇가지·매달림
	SFX_LIFT = cue("rbxassetid://9125407169", "SFX", 0.6, false, true, 0.5), -- PSE "Bow Stretches" 나무 삐걱: 밧줄 당겨 끌어올림
	SFX_LAND = cue("rbxassetid://9120947304", "SFX", 0.7, false, true, 0.3), -- PSE "Wood Pound Dirt 18" 둔탁: 배에 올라탐
	SFX_WHOOSH = cue("rbxassetid://9117018196", "SFX", 0.5, false, true, 0.3), -- 공기 훅: 비껴감·폭포 점프 "붕"
	SFX_SPLASH = cue("rbxassetid://9125703162", "SFX", 0.9, false, true, 0.3), -- PSE "Mud Puddle Splash 19" 작은 첨벙: 파도 넘음
	SFX_STROKE = cue("rbxassetid://9125703162", "SFX", 0.35, false, true, 0.3), -- 급류 2차: 분대원 노가 물을 칠 때 (SFX_SPLASH 음원 작게 — RideCrew, 1.1초 주기)
	-- ===== 사격 (RangeController 가 직접 부름 — 이름은 옛 박자 시절 그대로, 소리는 사격용) =====
	SFX_TICK = cue("rbxassetid://9118622391", "SFX", 0.28, false, false, 0.05), -- PSE "Rock Impacts 8" 나무 톡: 장전 시작·손전등 딸깍
	-- PSE "Pacifier 4" 코믹 팝 0.49초 (봉우리 268@0.07): 나무 목총 "뽁" — 총소리 아님. 분대원 한 발·장전 끝에도 (RangeController)
	SFX_TICK_SHOUT = cue("rbxassetid://9117183939", "SFX", 0.45, false, false, 0.05),
	-- PSE "Balloon Pop 3" 0.43초 (봉우리 482): 종이·풍선 표적 맞음 "펑"
	SFX_TARGET_POP = cue("rbxassetid://9113263649", "SFX", 0.35, false, true, 0.06),
	-- PSE "Wood Creak 1" 삐걱 + 끝에 쿵 (앞 2.4초): 탈출 문 열림. 뒤에 SFX_CHEER
	SFX_GATE_CREAK = cut(cue("rbxassetid://9120829478", "SFX", 0.6, false, true, 1.0), 0, 2.4),
	-- APM "Yeah" (KPM, 아이들 목소리 2.9초, 봉우리 259): 다 같이 "예!" — 끌어올림·문 열림·출발·도착
	SFX_CHEER = cue("rbxassetid://1841221347", "SFX", 0.45, false, false, 2.5),
