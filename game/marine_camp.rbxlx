      <Item class="ModuleScript" referent="6189">
        <Properties>
          <string name="Name">BoatLoadout</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{70E3CDE4-AB72-4DB6-A2F1-64F0E12AF791}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 유보트 배치(가설 1 의 재료): 자리 4 · 짐 3칸 · 노. 검증·기본값·느낌 한 줄(feelKo). 점수가 아니다.
local GameConfig = require(script.Parent.GameConfig)
local SquadCatalog = require(script.Parent.SquadCatalog)
local ProtocolTypes = require(script.Parent.ProtocolTypes)

local BoatLoadout = {}

export type Cargo = { id: string, nameKo: string, emoji: string, kg: number, whyKo: string }

BoatLoadout.Cargo = {
	WATER = { id = "WATER", nameKo = "물통", emoji = "💧", kg = 2, whyKo = "급류에서 덜 흔들려요" },
	FLAG = { id = "FLAG", nameKo = "깃발", emoji = "🚩", kg = 1, whyKo = "뱃머리에서 펄럭여요" },
	AID = { id = "AID", nameKo = "구급상자", emoji = "🩹", kg = 2, whyKo = "두리가 든든해해요" }, -- ⛑️ 는 Roblox 글꼴에서 빨간 바탕 흰 십자(의료 표식)로 그려져 🩹 로 (2026-10-21 3단계)
	SNACK = { id = "SNACK", nameKo = "간식", emoji = "🍙", kg = 1, whyKo = "밤 모닥불에서 나눠 먹어요" },
} :: { [string]: Cargo }
BoatLoadout.CargoOrder = { "WATER", "FLAG", "AID", "SNACK" }

BoatLoadout.Oars = {
	LONG = { id = "LONG", nameKo = "긴 노", emoji = "🥢", whyKo = "배가 조금 빨라요" },
	SHORT = { id = "SHORT", nameKo = "짧은 노", emoji = "🥄", whyKo = "보통 빠르기" },
}

function BoatLoadout.default(): ProtocolTypes.Loadout
	return {
		seats = { FL = "ME", FR = "SAN", BL = "MIR", BR = "DURI" }, -- 힘센 쪽을 대각선으로 (기본 배치는 균형이 맞게, 08_CARRY)
		cargo = {}, -- 첫 입소는 빈 짐 (27 §3 1-A, 4단계 결정 2026-10-21): 산이 물통을 들고 와 내미는 것이 첫 꾸미기의 한 장면 (다음 입소는 지난 배치를 이어 감)
		oar = "SHORT",
		revision = 0,
	}
end

function BoatLoadout.clone(l: ProtocolTypes.Loadout): ProtocolTypes.Loadout
	return {
		seats = table.clone(l.seats),
		cargo = table.clone(l.cargo),
		oar = l.oar,
		revision = l.revision,
	}
end

-- 저장·요청 검증: 자리 4개에 서로 다른 멤버, 짐 ≤ 3 (카탈로그에 있는 것만, 중복 없음), 노 LONG/SHORT
function BoatLoadout.validate(l: any, allowedMembers: { [string]: boolean }): boolean
	if typeof(l) ~= "table" or typeof(l.seats) ~= "table" or typeof(l.cargo) ~= "table" then
		return false
	end
	if l.oar ~= "LONG" and l.oar ~= "SHORT" then
		return false
	end
	local seen: { [string]: boolean } = {}
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		local m = l.seats[key]
		if typeof(m) ~= "string" or not allowedMembers[m] or seen[m] then
			return false
		end
		seen[m] = true
	end
	if #l.cargo > GameConfig.Cargo.MaxSlots then
		return false
	end
	local seenCargo: { [string]: boolean } = {}
	for _, c in ipairs(l.cargo) do
		if typeof(c) ~= "string" or not BoatLoadout.Cargo[c] or seenCargo[c] then
			return false
		end
		seenCargo[c] = true
	end
	return true
end

function BoatLoadout.weightKg(l: ProtocolTypes.Loadout): number
	local kg = 0
	for _, c in ipairs(l.cargo) do
		local cargo = BoatLoadout.Cargo[c]
		if cargo then
			kg += cargo.kg
		end
	end
	return kg
end

function BoatLoadout.hasCargo(l: ProtocolTypes.Loadout, id: string): boolean
	return table.find(l.cargo, id) ~= nil
end

function BoatLoadout.seatOf(l: ProtocolTypes.Loadout, memberId: string): string?
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		if l.seats[key] == memberId then
			return key
		end
	end
	return nil
end

-- 배치가 급류·바다에서 어떻게 느껴지나 한 줄 (6단계 — 옛 "앞 들기 3.0 · 뒤 들기 1.8 …" 숫자 읽기를 대신한다).
-- 수치는 안 보여 준다(27 §3): RideService 가 실제로 쓰는 것만 말로 — 좌우 힘 치우침(기울기)·긴 노(빠르기)·짐 무게(조금 느림)
function BoatLoadout.feelKo(l: ProtocolTypes.Loadout): string
	local left, right = 0, 0
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		local m = SquadCatalog.get(l.seats[key])
		local pw = if m then m.power else 2
		if SquadCatalog.isLeft(key) then
			left += pw
		else
			right += pw
		end
	end
	local parts = {}
	if left - right >= 1 then
		table.insert(parts, "힘센 사람이 왼쪽에 많아 배가 왼쪽으로 기울어요")
	elseif right - left >= 1 then
		table.insert(parts, "힘센 사람이 오른쪽에 많아 배가 오른쪽으로 기울어요")
	else
		table.insert(parts, "좌우 힘이 비슷해요")
	end
	table.insert(parts, if l.oar == "LONG" then "긴 노라 조금 빨라요" else "짧은 노는 보통 빠르기")
	if BoatLoadout.weightKg(l) >= 4 then
		table.insert(parts, "짐이 많아 조금 느려요")
	end
	return table.concat(parts, " · ")
end

-- 두 배치의 차이를 한 줄로 (밤 일지 "나란히 보기")
function BoatLoadout.diffKo(prev: ProtocolTypes.Loadout?, cur: ProtocolTypes.Loadout): string
	if not prev then
		return "첫 배치"
	end
	local parts = {}
	for _, key in ipairs(SquadCatalog.SeatKeys) do
		if prev.seats[key] ~= cur.seats[key] then
			local m = SquadCatalog.get(cur.seats[key])
			table.insert(
				parts,
				string.format("%s에 %s", SquadCatalog.SeatNameKo[key], if m then m.nameKo else "친구")
			)
		end
	end
	local prevCargo = table.concat(prev.cargo, ",")
	local curCargo = table.concat(cur.cargo, ",")
	if prevCargo ~= curCargo then
		table.insert(parts, "짐 바꿈")
	end
	if prev.oar ~= cur.oar then
		table.insert(parts, if cur.oar == "LONG" then "긴 노로" else "짧은 노로")
	end
	if #parts == 0 then
		return "그대로"
	end
	return table.concat(parts, " · ")
end

return BoatLoadout
]]></string>
