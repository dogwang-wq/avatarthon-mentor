              <UniqueId name="UniqueId">531aee31db1b5e520ae6ff5900001daf</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6151">
            <Properties>
              <string name="Name">RangeController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{C82FEAD5-5DDA-40DF-89DD-1CAA791A754E}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 모의 사격 (14_INFILTRATION_CAMP §5 · 6단계 단순화): 종이 원형 표적(Kind=TARGET)을 세우고 눕히는 연출 + 클릭/탭 하나로 서버에 RangeShot.
-- 기지 사격장(TRAINING RANGE)과 6일차 사격 문(OBBY gateHint)에서만 쏜다. 맞았는지는 서버가 정한다. 사람·동물·적 모양 없음.
-- 장전은 저절로 (R·Y·장전 버튼 없음 — 탄 표시만). 6일차 문에서는 분대원도 같이 쏜다: 표적 속성 HitBy 로 구멍 색이 다르다(내 구멍 = 먹색).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Palette = require(Shared:WaitForChild("Palette"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Net = require(script.Parent.Net)
local InputController = require(script.Parent.InputController)
local UiKit = require(script.Parent.UiKit)
local AudioController = require(script.Parent.AudioController)

local RangeController = {}
local S = ProtocolTypes.SessionState
local C2S = ProtocolTypes.ClientToServer
local player = Players.LocalPlayer

type T = { part: BasePart, base: CFrame, group: string, index: number }
local targets: { [BasePart]: T } = {}

-- 눕힌 모습: 기둥 쪽으로 80° 넘어진 원판
local function downCf(t: T): CFrame
	return t.base * CFrame.new(0, -1.3, 0) * CFrame.Angles(0, 0, math.rad(80)) * CFrame.new(0, 1.3, 0)
end

local function show(t: T, up: boolean, instant: boolean?)
	local goal = if up then t.base else downCf(t)
	t.part.Color = if up then Palette.Cream else Palette.Sand
	if instant then
		t.part.CFrame = goal
	else
		TweenService:Create(t.part, TweenInfo.new(if up then 0.18 else 0.25, Enum.EasingStyle.Back), { CFrame = goal })
			:Play()
	end
end

-- 구멍 색: 내가 맞힌 구멍은 먹색(기본), 분대원이 맞힌 구멍은 그 사람 색 (27 §3 6일차 "아이가 맞힌 구멍만 색이 다르다")
local function holeColor(by: string): Color3
	if by == "ME" then
		return Palette.Ink
	end
	return (Palette.Member :: any)[by] or Color3.fromHex("3F7FB5")
end

-- 표적 양면 종이에 구멍 하나 (HitBy 가 바뀔 때). HitBy 가 사라지면(다시 하기·다시 입소) 구멍도 지운다
local function drawHole(t: T)
	local by = t.part:GetAttribute("HitBy")
	for _, sg in ipairs(t.part:GetChildren()) do
		if sg:IsA("SurfaceGui") and sg.Name == "PaperFace" then
			local old = sg:FindFirstChild("Hole")
			if old then
				old:Destroy()
			end
			if typeof(by) == "string" then
				local r = Random.new(t.index * 31 + #by)
				local h = Instance.new("Frame")
				h.Name = "Hole"
				h.AnchorPoint = Vector2.new(0.5, 0.5)
				h.Position = UDim2.fromScale(0.5 + r:NextNumber(-0.14, 0.14), 0.5 + r:NextNumber(-0.14, 0.14))
				h.Size = UDim2.fromScale(0.2, 0.2)
				h.BackgroundColor3 = holeColor(by)
				h.BorderSizePixel = 0
				h.ZIndex = 5
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(1, 0)
				c.Parent = h
				local st = Instance.new("UIStroke")
				st.Color = Palette.Cream
				st.Thickness = 3
				st.Parent = h
				h.Parent = sg
			end
		end
	end
end

local function register(p: Instance)
	if not p:IsA("BasePart") or p:GetAttribute("Kind") ~= "TARGET" or targets[p] then
		return
	end
	local t: T = {
		part = p,
		base = p.CFrame,
		group = tostring(p:GetAttribute("Group")),
		index = tonumber(p:GetAttribute("TargetIndex")) or 0,
	}
	targets[p] = t
	-- 종이 표적 얼굴 (21 4단계 검수): 원판 양면에 흰 바탕·빨간 고리 둘·가운데 점 — 멀리서도 "표적" 으로 읽히게
	for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
		local sg = Instance.new("SurfaceGui")
		sg.Name = "PaperFace"
		sg.Face = face
		sg.CanvasSize = Vector2.new(200, 200)
		sg.LightInfluence = 0.6
		sg.AlwaysOnTop = false
		sg.Parent = p
		local function ring(size: number, color: Color3)
			local f = Instance.new("Frame")
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(0.5, 0.5)
			f.Size = UDim2.fromScale(size, size)
			f.BackgroundColor3 = color
			f.BorderSizePixel = 0
			f.Parent = sg
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = f
			return f
		end
		ring(1, Color3.fromRGB(250, 246, 236))
		ring(0.78, Palette.Red)
		ring(0.6, Color3.fromRGB(250, 246, 236))
		ring(0.4, Palette.Red)
		ring(0.22, Color3.fromRGB(250, 246, 236))
		ring(0.08, Palette.Ink)
	end
	-- 흰 원판 + 빨간 테두리 (종이 표적)
	local stroke = Instance.new("SelectionBox")
	stroke.Adornee = p
	stroke.LineThickness = 0.05
	stroke.Color3 = Palette.Red
	stroke.SurfaceTransparency = 1
	stroke.Parent = p
	show(t, p:GetAttribute("Up") == true, true)
	drawHole(t)
	p:GetAttributeChangedSignal("Up"):Connect(function()
		show(t, p:GetAttribute("Up") == true)
	end)
	p:GetAttributeChangedSignal("HitBy"):Connect(function()
		drawHole(t)
	end)
end

-- 표적 그룹 맞춤: "GATE" 로 쏠 수 있으면 GATEB 같은 길목 그룹도 같이 (22 v2)
local function sameGroup(have: string, want: string): boolean
	return have == want or (want == "GATE" and string.sub(have, 1, 4) == "GATE")
end

local function canShoot(): string?
	local snap = Net.Snapshot
	if not snap then
		return nil
	end
	if snap.state == S.TRAINING and snap.training and snap.training.kind == "RANGE" then
		return "RANGE"
	end
	if snap.state == S.OBBY and snap.obby and snap.obby.gateHint then
		return "GATE" -- 자유 스테이지 사격 문 (22 v2): 길목마다 GATE·GATEB… 그룹
	end
	return nil
end

-- ===== 조준·발사 (21 4단계, M060 · 6단계): 나무 목총 손맛. 맞았는지는 그대로 서버가 정한다 =====
-- 서 있는 표적이 AimRadius 안에 들어오면 조준 모드: 십자선·어깨 너머·PC 마우스 잠금(캐릭터가 보는 쪽을 봄).
-- 탄 5발, 다 쓰면 저절로 장전. 쏘면 "딱" + 반동(카메라 잠깐 들림) + 십자선 벌어짐. 종이 표적엔 구멍, 빗나가면 흙먼지
local R = GameConfig.Range
local aimGui = UiKit.screen("CampAim", 30)
aimGui.Enabled = false
local cross = Instance.new("Frame")
cross.Name = "Cross"
cross.BackgroundTransparency = 1
cross.AnchorPoint = Vector2.new(0.5, 0.5)
cross.Position = UDim2.fromScale(0.5, 0.5)
cross.Size = UDim2.fromOffset(60, 60)
cross.Parent = aimGui
local crossLines: { { f: Frame, dx: number, dy: number } } = {}
for _, v in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = Palette.Cream
	f.BorderSizePixel = 0
	f.Size = if v[1] == 0 then UDim2.fromOffset(3, 12) else UDim2.fromOffset(12, 3)
	f.Parent = cross
	local stroke = Instance.new("UIStroke")
	stroke.Color = Palette.Ink
	stroke.Thickness = 1
	stroke.Transparency = 0.4
	stroke.Parent = f
	table.insert(crossLines, { f = f, dx = v[1], dy = v[2] })
end
local dot = Instance.new("Frame")
dot.AnchorPoint = Vector2.new(0.5, 0.5)
dot.Position = UDim2.fromScale(0.5, 0.5)
dot.Size = UDim2.fromOffset(4, 4)
dot.BackgroundColor3 = Palette.Red
dot.BorderSizePixel = 0
dot.Parent = cross
UiKit.corner(dot, 2)
local ammoLabel = UiKit.label(aimGui, "", 24, true, Palette.Cream)
ammoLabel.AutomaticSize = Enum.AutomaticSize.None
ammoLabel.TextXAlignment = Enum.TextXAlignment.Center
ammoLabel.AnchorPoint = Vector2.new(0.5, 1)
ammoLabel.Position = UDim2.new(0.5, 0, 1, -116)
ammoLabel.Size = UDim2.fromOffset(240, 32)
ammoLabel.TextStrokeColor3 = Palette.Ink
ammoLabel.TextStrokeTransparency = 0.4
local hintLabel = UiKit.label(aimGui, "", 17, false, Palette.Cream)
hintLabel.AutomaticSize = Enum.AutomaticSize.None
hintLabel.TextXAlignment = Enum.TextXAlignment.Center
hintLabel.AnchorPoint = Vector2.new(0.5, 1)
hintLabel.Position = UDim2.new(0.5, 0, 1, -88)
hintLabel.Size = UDim2.fromOffset(420, 26)
hintLabel.TextStrokeColor3 = Palette.Ink
hintLabel.TextStrokeTransparency = 0.4
local ammo = R.Magazine
local reloadUntil = 0
local lastFireAt = 0
local spread = 0 -- 0..1 십자선 벌어짐
local kick = 0 -- 반동 남은 양
local aiming = false
local hintToken = 0

local function setAmmoText()
	ammoLabel.Text = string.rep("●", ammo) .. string.rep("○", R.Magazine - ammo)
end
local function hint(text: string, sec: number?)
	hintToken += 1
	local my = hintToken
	hintLabel.Text = text
	if sec then
		task.delay(sec, function()
			if hintToken == my then
				hintLabel.Text = ""
			end
		end)
	end
end
-- 저절로 장전 (탄을 다 쓰면): 누를 키 없음
local function reload()
	local now = os.clock()
	if now < reloadUntil or ammo == R.Magazine then
		return
	end
	reloadUntil = now + R.ReloadSec
	AudioController.play("SFX_TICK")
	hint(CampScript.Range.reloading)
	task.delay(R.ReloadSec, function()
		ammo = R.Magazine
		setAmmoText()
		AudioController.play("SFX_TICK") -- 장전 끝은 가벼운 톡 (소리 패스: "뽁"은 맞힐 때만)
		if hintLabel.Text == CampScript.Range.reloading then
			hint("")
		end
	end)
end
-- 폰 조준 모드: 화면 끌기가 조준이라 탭 대신 이 버튼 하나가 "쏘기" (장전 버튼 없음)
local fireBtn = UiKit.button(aimGui, CampScript.Range.fireBtn, function()
	-- 아래에서 fire 로 묶는다 (정의 순서)
end, true)
fireBtn.Size = UDim2.fromOffset(120, 72)
fireBtn.AnchorPoint = Vector2.new(1, 1)
fireBtn.Position = UDim2.new(1, -24, 1, -150)
fireBtn.Visible = false

-- 종이 표적 구멍 / 빗나간 흙먼지 (화면에만, 2.5초·0.5초)
local function impactFx(pos: Vector3, normal: Vector3, paper: boolean)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = if paper then Enum.Material.SmoothPlastic else Enum.Material.Sand
	p.Color = if paper then Color3.fromRGB(40, 36, 32) else Palette.Sand
	p.Size = if paper then Vector3.new(0.12, 0.55, 0.55) else Vector3.new(0.6, 0.6, 0.6)
	p.Transparency = if paper then 0 else 0.3
	p.CFrame = CFrame.lookAt(pos + normal * 0.06, pos + normal) * CFrame.Angles(0, math.rad(90), 0)
	p.Parent = workspace
	if paper then
		task.delay(2.5, function()
			p:Destroy()
		end)
	else
		TweenService:Create(p, TweenInfo.new(0.45), { Transparency = 1, Size = Vector3.new(1.6, 1.6, 1.6) }):Play()
		task.delay(0.5, function()
			p:Destroy()
		end)
	end
end

-- 분대원 한 발 (서버 SQUAD_SHOT): 목총 끝에서 표적까지 하얀 줄이 번쩍 + "딱" + 종이 부스러기 (총알·피해 표현 없음)
local function squadShotFx(from: Vector3, to: Vector3, memberId: string)
	local d = to - from
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = holeColor(memberId):Lerp(Color3.new(1, 1, 1), 0.55)
	p.Size = Vector3.new(0.08, 0.08, math.max(0.1, d.Magnitude))
	p.CFrame = CFrame.lookAt(from + d / 2, to)
	p.Transparency = 0.2
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.18), { Transparency = 1 }):Play()
	task.delay(0.22, function()
		p:Destroy()
	end)
	AudioController.play("SFX_TICK_SHOUT")
	if Net.setting("reducedMotion") ~= true then
		local bits = Instance.new("Part")
		bits.Anchored = true
		bits.CanCollide = false
		bits.CanQuery = false
		bits.CanTouch = false
		bits.Transparency = 1
		bits.Size = Vector3.new(0.5, 0.5, 0.5)
		bits.Position = to
		bits.Parent = workspace
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(Palette.Cream)
		e.Size = NumberSequence.new(0.25, 0)
		e.Lifetime = NumberRange.new(0.3, 0.5)
		e.Speed = NumberRange.new(4, 8)
		e.SpreadAngle = Vector2.new(60, 60)
		e.Rate = 0
		e.Parent = bits
		e:Emit(10)
		task.delay(0.8, function()
			bits:Destroy()
		end)
	end
end

-- 한 발: screenPos 가 있으면 그 자리로(탭·클릭), 없으면 화면 가운데(조준 모드·패드·발사 버튼)
local function fire(screenPos: Vector2?): boolean
	local group = canShoot()
	if not group then
		return false
	end
	local now = os.clock()
	if now < reloadUntil or now - lastFireAt < R.FireCooldown then
		return false
	end
	if ammo <= 0 then
		reload()
		return false
	end
	ammo -= 1
	lastFireAt = now
	setAmmoText()
	spread = 1
	kick = R.RecoilKick
	AudioController.play("SFX_TICK_SHOUT")
	local cam = workspace.CurrentCamera
	local ray: Ray
	if screenPos then
		ray = cam:ScreenPointToRay(screenPos.X, screenPos.Y) -- 입력 좌표는 GUI 좌표(상단바 제외)
	else
		local vp = cam.ViewportSize
		ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	local t = hit and targets[hit.Instance]
	-- 살짝 빗나가도 가까운 서 있는 표적을 잡아 준다 (아이 손·터치 너그럽게)
	if not t and hit then
		local best, bestD = nil, 2.2
		for _, cand in pairs(targets) do
			if sameGroup(cand.group, group) and cand.part:GetAttribute("Up") == true then
				local d = (cand.part.Position - hit.Position).Magnitude
				if d < bestD then
					best, bestD = cand, d
				end
			end
		end
		t = best
	end
	if hit then
		impactFx(hit.Position, hit.Normal, t ~= nil and t.part:GetAttribute("Up") == true)
	end
	if t and sameGroup(t.group, group) then
		Net.fire(C2S.RangeShot, { group = t.group, index = t.index })
	else
		Net.fire(C2S.RangeShot, { group = group, index = -1 })
	end
	if ammo == 0 then
		task.delay(0.25, reload) -- 저절로 장전
	end
	return true
end
fireBtn.MouseButton1Click:Connect(function()
	fire(nil)
end)

local baseOffset = Vector3.zero
local function setAim(on: boolean)
	if on == aiming then
		return
	end
	aiming = on
	player:SetAttribute("CampAiming", on)
	aimGui.Enabled = on
	local it = InputController.CurrentInputType
	local touch = it == "TOUCH"
	fireBtn.Visible = on and touch
	if not touch then
		UserInputService.MouseBehavior = if on then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.AutoRotate = not (on and not touch)
		hum.CameraOffset = if on then Vector3.new(1.75, 0.5, 0) else baseOffset
	end
	if on then
		setAmmoText()
		hint(
			if touch
				then CampScript.Range.aimTouch
				elseif it == "GAMEPAD" then CampScript.Range.aimPad
				else CampScript.Range.aimPc,
			4
		)
	end
end
-- 탄창은 쏠 수 있는 자리(사격장·문)가 바뀔 때만 채운다 — 조준 반경을 들락거리면 공짜 장전이 되던 것 (검수 2026-10-20)
local lastGroupKey = ""
local function refillIfNewPlace()
	local snap = Net.Snapshot
	local key = if snap then tostring(snap.state) .. ":" .. tostring(snap.day) .. ":" .. tostring(canShoot()) else ""
	if key ~= lastGroupKey then
		lastGroupKey = key
		ammo = R.Magazine
		reloadUntil = 0
		setAmmoText()
	end
end

local function updateAim(dt: number)
	local group = canShoot()
	local want = false
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if group and hrp and hrp:IsA("BasePart") then
		for _, t in pairs(targets) do
			if
				sameGroup(t.group, group)
				and t.part:GetAttribute("Up") == true
				and (t.part.Position - hrp.Position).Magnitude <= R.AimRadius
			then
				want = true
				break
			end
		end
	end
	refillIfNewPlace()
	setAim(want)
	if not aiming then
		return
	end
	spread = math.max(0, spread - dt * R.SpreadDecayPerSec)
	local gap = 7 + spread * 16
	for _, l in ipairs(crossLines) do
		l.f.Position = UDim2.new(0.5, l.dx * gap, 0.5, l.dy * gap)
	end
	-- 반동: 카메라가 잠깐 들렸다 내려온다
	kick = math.max(0, kick - dt * 2.4)
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.CameraOffset = Vector3.new(1.75, 0.5 + kick, 0)
		if InputController.CurrentInputType ~= "TOUCH" and hum.AutoRotate then
			hum.AutoRotate = false -- 조준 중 리스폰한 새 캐릭터도 (아니면 자동 회전과 아래 CFrame 이 싸워 떨린다)
		end
	end
end

-- 카메라 스크립트 뒤(RenderPriority Camera+1)에서: 기본 카메라가 매 프레임 MouseBehavior 를 Default 로 되돌리므로 조준 중엔 다시 잠그고,
-- PC·패드는 캐릭터가 보는 쪽(카메라 방향)을 본다 — 걷는 방향과 조준이 따로 (검수 2026-10-20)
local function aimRenderStep()
	if not aiming or InputController.CurrentInputType == "TOUCH" then
		return
	end
	if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		local cam = workspace.CurrentCamera
		local lv = cam.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		if flat.Magnitude > 0.01 then
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
		end
	end
end

-- ===== 탈출 문 열림 (14 §7) =====
local gateBase: { [BasePart]: CFrame } = {}
local function openGate(id: string)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("GateBar") == id then
			gateBase[d] = gateBase[d] or d.CFrame
			TweenService:Create(d, TweenInfo.new(0.8, Enum.EasingStyle.Back), {
				CFrame = d.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(0, 0, math.rad(70)),
			}):Play()
		end
	end
end

-- 패드 X 로 쏘기 (20_DAYS_UNIFY): 패드엔 클릭이 없어 화면 가운데에 가장 가까운 서 있는 표적을 맞힌다
local function shootNearestCenter(): boolean
	local group = canShoot()
	if not group then
		return false
	end
	if aiming then
		return fire(nil) -- 조준 모드: 화면 가운데 광선 (탄 포함)
	end
	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestD = nil, math.huge
	for _, t in pairs(targets) do
		if sameGroup(t.group, group) and t.part:GetAttribute("Up") == true then
			local sp, on = cam:WorldToViewportPoint(t.part.Position)
			if on then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if d < bestD then
					best, bestD = t, d
				end
			end
		end
	end
	if not best then
		return false
	end
	Net.fire(C2S.RangeShot, { group = best.group, index = best.index })
	return true
end

function RangeController.start()
	InputController.padShoot = shootNearestCenter
	-- 판정·화면은 Heartbeat(그리지 않는 창에서도 돎 — Studio 검수에서 RenderStepped 가 0 이었다), 마우스 잠금·몸 방향은 카메라 뒤 렌더 단계
	RunService.Heartbeat:Connect(updateAim)
	RunService:BindToRenderStep("CampAim", Enum.RenderPriority.Camera.Value + 1, aimRenderStep)
	Net.FxCue:Connect(function(c)
		if c.kind == "GATE_OPEN" and typeof(c.id) == "string" then
			openGate(c.id)
		elseif c.kind == "SQUAD_SHOT" and typeof(c.from) == "Vector3" and typeof(c.to) == "Vector3" then
			squadShotFx(c.from, c.to, tostring(c.memberId))
		elseif c.kind == "DAY_START" then
			for bar, cf in pairs(gateBase) do
				bar.CFrame = cf -- 다시 입소·다시 하기: 문을 닫아 둔다
			end
		end
	end)
	local folder = SceneBindings.getFolder("Triggers")
	if folder then
		for _, p in ipairs(folder:GetChildren()) do
			register(p)
		end
		folder.ChildAdded:Connect(register)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if aiming then
				fire(nil) -- 마우스 잠금: 십자선(화면 가운데)으로
			else
				local p = input.Position
				fire(Vector2.new(p.X, p.Y))
			end
		elseif input.UserInputType == Enum.UserInputType.Touch and not aiming then
			-- 조준 모드에선 화면 끌기가 조준이라 탭으로 쏘지 않는다 (발사 버튼)
			local p = input.Position
			fire(Vector2.new(p.X, p.Y))
		end
	end)
end

return RangeController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">531aee31db1b5e520ae6ff59000139b4</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6152">
            <Properties>
              <string name="Name">LeaderboardPanel</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{B2D338A5-79C7-4862-8077-19F52962DDC8}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 🏆 기록판 (docs/design/15_RECORDS.md): 작전 1~6 · 🎓 수료. 상위 10 과 내 최고만 보여 준다(꼴찌·하위 목록 없음).
-- 이름은 "○○의 소대" — 한 배의 기록이다. 기지에는 수료 기록판 게시판(LeaderboardBoard 속성 파트)도 같은 자료로 그린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local KoreanText = require(Shared:WaitForChild("KoreanText"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local CampHud = require(script.Parent.CampHud)

local LeaderboardPanel = {}
local C2S = ProtocolTypes.ClientToServer
local R = CampScript.Records

-- 날 목록은 StationCatalog 를 따른다 (3일차 갯벌 제거 M057 — D3 칸 없음). 화면 번호는 dayNo
local BOARDS = { "GRAD" }
for _, st in ipairs(StationCatalog.List) do
	if st.day >= 1 then
		table.insert(BOARDS, "D" .. st.day)
	end
end
local MEDAL = { "🥇", "🥈", "🥉" }

local gui = UiKit.screen("CampBoard", 40)
gui.Enabled = false
local modal = UiKit.modal(gui, "Board", 460)
UiKit.pad(modal, 16)
UiKit.list(modal, nil, 8)
local title = UiKit.label(modal, R.boardTitle, 24, true)
title.LayoutOrder = 1

local tabs = Instance.new("Frame")
tabs.Size = UDim2.fromScale(1, 0)
tabs.AutomaticSize = Enum.AutomaticSize.Y
tabs.BackgroundTransparency = 1
tabs.LayoutOrder = 2
local tg = Instance.new("UIGridLayout")
tg.CellSize = UDim2.fromOffset(100, 36)
tg.CellPadding = UDim2.fromOffset(6, 6)
tg.SortOrder = Enum.SortOrder.LayoutOrder
tg.Parent = tabs
tabs.Parent = modal

local list = Instance.new("Frame")
list.Size = UDim2.fromScale(1, 0)
list.AutomaticSize = Enum.AutomaticSize.Y
list.BackgroundTransparency = 1
list.LayoutOrder = 3
UiKit.list(list, nil, 4)
list.Parent = modal

local mine = UiKit.label(modal, "", 17, true, Palette.Red)
mine.LayoutOrder = 4
local note = UiKit.label(modal, "", 13, false, Palette.WoodDark)
note.LayoutOrder = 5
local closeBtn = UiKit.button(modal, "닫기", function()
	UiKit.closeThen(modal, function()
		gui.Enabled = false
	end)
end, true)
closeBtn.LayoutOrder = 6

local current = "GRAD"
local tabBtns: { [string]: TextButton } = {}

local function boardLabel(b: string): string
	if b == "GRAD" then
		return R.boardGrad
	end
	return string.format(R.boardStage, StationCatalog.dayNo(tonumber(string.sub(b, 2)) or 0))
end

local function myBest(b: string): number?
	local snap = Net.Snapshot
	local rec = snap and snap.records
	if not rec then
		return nil
	end
	if b == "GRAD" then
		return rec.bestTotal
	end
	return rec.best[string.sub(b, 2)]
end

local function clearRows()
	for _, ch in ipairs(list:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
end

local function row(text: string, isMe: boolean, order: number)
	local l = UiKit.label(list, text, 17, isMe, if isMe then Palette.Red else Palette.Ink)
	l.LayoutOrder = order
end

local function render(data: any)
	clearRows()
	local rows = data and data.rows or {}
	if #rows == 0 then
		row(R.none, false, 1)
	end
	for i, r in ipairs(rows) do
		local medal = MEDAL[r.rank] or string.format("%d.", r.rank)
		row(
			string.format("%s  %s  ·  %s", medal, string.format(R.crew, tostring(r.name)), KoreanText.clock(r.cs)),
			r.isMe == true,
			i
		)
	end
	local b = myBest(current)
	mine.Text = if b then string.format(R.mine, KoreanText.clock(b)) else ""
	note.Text = if data and data.mode == "LOCAL" then R.localMode else ""
end

local function load(b: string)
	current = b
	for id, btn in pairs(tabBtns) do
		UiKit.setChipSelected(btn, id == b)
	end
	clearRows()
	row("…", false, 1)
	Net.request(C2S.LeaderboardRequest, { board = b }, function(res)
		if current ~= b then
			return
		end
		if res.accepted then
			render(res.data)
		else
			clearRows()
			row(Net.errorText(res.code), false, 1)
		end
	end)
end

for i, b in ipairs(BOARDS) do
	local btn = UiKit.chip(tabs, boardLabel(b), function()
		load(b)
	end)
	btn.LayoutOrder = i
	tabBtns[b] = btn
end

function LeaderboardPanel.open(board: string?)
	gui.Enabled = true
	load(board or current)
end

-- ===== 기지 게시판 (수료 기록판 상위 5) =====
local function renderWorldBoards(data: any)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("LeaderboardBoard") == "GRAD" then
			local sg = d:FindFirstChild("CampBoardGui") :: SurfaceGui?
			if not sg then
				local s = Instance.new("SurfaceGui")
				s.Name = "CampBoardGui"
				s.Face = Enum.NormalId.Front
				s.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				s.PixelsPerStud = 40
				s.LightInfluence = 0
				s.Parent = d
				local f = Instance.new("Frame")
				f.Name = "Body"
				f.Size = UDim2.fromScale(1, 1)
				f.BackgroundColor3 = Palette.Ink
				f.BackgroundTransparency = 0.1
				f.Parent = s
				UiKit.pad(f, 14)
				UiKit.list(f, nil, 4)
				sg = s
			end
			local body = (sg :: SurfaceGui):FindFirstChild("Body") :: Frame
			for _, ch in ipairs(body:GetChildren()) do
				if ch:IsA("TextLabel") then
					ch:Destroy()
				end
			end
			local t = UiKit.label(body, "🏆 " .. R.boardGrad .. " 기록판", 34, true, Palette.Yellow)
			t.LayoutOrder = 0
			local rows = data and data.rows or {}
			if #rows == 0 then
				local e = UiKit.label(body, R.none, 24, false, Palette.Cream)
				e.LayoutOrder = 1
			end
			for i = 1, math.min(5, #rows) do
				local r = rows[i]
				local l = UiKit.label(
					body,
					string.format(
						"%s %s · %s",
						MEDAL[r.rank] or (tostring(r.rank) .. "."),
						string.format(R.crew, tostring(r.name)),
						KoreanText.clock(r.cs)
					),
					26,
					r.isMe == true,
					if r.isMe then Palette.Yellow else Palette.Cream
				)
				l.LayoutOrder = i
			end
		end
	end
end

local function refreshWorld()
	Net.request(C2S.LeaderboardRequest, { board = "GRAD" }, function(res)
		if res.accepted then
			renderWorldBoards(res.data)
		end
	end)
end

function LeaderboardPanel.start()
	-- 작전·퇴소식이 시작되면 기록판 창은 닫는다
	Net.SnapshotChanged:Connect(function(snap)
		local s = snap.state
		if gui.Enabled and s ~= ProtocolTypes.SessionState.CAMP and s ~= ProtocolTypes.SessionState.NIGHT then
			gui.Enabled = false
		end
	end)
	CampHud.OpenBoard:Connect(function()
		LeaderboardPanel.open()
	end)
	task.spawn(function()
		task.wait(4)
		while true do
			refreshWorld()
			task.wait(60)
		end
	end)
	Net.FxCue:Connect(function(c)
		if c.kind == "GRADUATE" then
			task.delay(3, refreshWorld)
		end
	end)
end

return LeaderboardPanel
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">531aee31db1b5e520ae6ff5900015880</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6153">
            <Properties>
              <string name="Name">PromptController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{CE724603-7B23-47AE-8F77-6A144171CC2B}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- ProximityPrompt (Style=Custom) 공용 UI (28 §1·§4·§6): 키 배지·대상/동사 라벨·길게 누르기 게이지·폰 탭 버튼.
-- 서버가 프롬프트를 만들고 Triggered 를 받는다. 여기서는 그리기와 눌림·채움·톡(pop) 피드백만 한다 (판정 없음).
-- 룩: 19_UI_MAP_STYLE — 어두운 올리브 판(반투명) + 굵은 테두리 + 위에서 오는 빛, 크림 글자, 노랑 = 지금 볼 곳(게이지·톡).
-- 소리는 아직 없다 — 음향 패스가 AudioCueMap 으로 붙인다 (hold 시작 "prompt_hold" / 트리거 "prompt_ok" 자리).
--
-- 프롬프트(또는 그 Parent) 속성:
--   ForUserId    number   — 그 플레이어에게만 보인다 (다른 사람은 그리지 않음. 서버도 Triggered 에서 UserId 를 확인할 것)
--   HideForUserId number  — 그 플레이어에게만 안 보인다 (내 캐릭터에 달린 "풀어 주기" 는 친구만, 2단계)
--   PromptOffset Vector3  — 머리 위 오프셋(월드 Y 위, 기본 (0, 2.6, 0))
--   PromptIcon   string   — 동사 왼쪽 이모지 (🪵 💧 🔥 🤝 …)
--   PromptAccent string   — "YELLOW" | "RED" (테두리 색. 기본 WoodDark)
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local UiKit = require(script.Parent.UiKit)
local InputController = require(script.Parent.InputController)
local AudioController = require(script.Parent.AudioController)

local Palette = UiKit.Palette
local U = Palette.UI

local PromptController = {}

-- ===== 치수 (픽셀 오프셋: 거리와 상관없이 화면에서 같은 크기 — Roblox 기본 프롬프트와 같은 방식) =====
local BADGE_PC = 44
local BADGE_TOUCH = 48
local RING_PAD = 8 -- 게이지 링은 배지보다 이만큼 크다
local RING_THICK = 4
local PANEL_H_PC = 66
local PANEL_H_TOUCH = 74
local ACTION_TEXT = 20
local OBJECT_TEXT = 15
local ICON_TEXT = 22
local DEFAULT_OFFSET = Vector3.new(0, 2.6, 0)
local SHOW_SEC = 0.12
local HIDE_SEC = 0.1
local PRESS_SEC = 0.08
local POP_UP_SEC = 0.07
local POP_DOWN_SEC = 0.11
local FLASH_SEC = 0.26

local TW_SHOW = TweenInfo.new(SHOW_SEC, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TW_HIDE = TweenInfo.new(HIDE_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local TW_FADE_IN = TweenInfo.new(SHOW_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TW_FADE_OUT = TweenInfo.new(HIDE_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local TW_PRESS = TweenInfo.new(PRESS_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TW_RING_RESET = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- 흐려지기: 각 부품의 기본 투명도를 기억해 두고 alpha(0=안 보임, 1=다 보임)로 곱한다.
-- (CanvasGroup 은 BillboardGui 안에서 글자가 흐려질 수 있어 쓰지 않는다)
type FadeItem = { inst: Instance, prop: string, base: number }

type Entry = {
	prompt: ProximityPrompt,
	gui: BillboardGui,
	root: TextButton,
	rootScale: UIScale,
	badge: Frame,
	badgeScale: UIScale,
	badgeText: TextLabel,
	panelStroke: UIStroke,
	ringRight: UIGradient,
	ringLeft: UIGradient,
	ringTrack: UIStroke,
	icon: TextLabel,
	action: TextLabel,
	object: TextLabel,
	fade: NumberValue,
	fadeItems: { FadeItem },
	conns: { RBXScriptConnection },
	tweens: { Tween }, -- 손맛(눌림·게이지·번쩍)
	visTweens: { Tween }, -- 등장·퇴장
	holding: boolean,
	hiding: boolean,
	accent: Color3,
}

local entries: { [ProximityPrompt]: Entry } = {}
local holder: Folder? = nil
local touchOverride: boolean? = nil
-- 폰: 머리 위 판과 별개로 화면 오른쪽 아래(점프 버튼 왼쪽)에 큰 탭 버튼 하나 (28 §6). 빌보드 판 탭이 안 잡히는 기기·상황의 안전망이자
-- 엄지로 누르기 쉬운 자리. 지금 보이는 프롬프트(가장 최근에 뜬 것)에 InputHoldBegin/End 를 보낸다
local TOUCH_BTN = 96
local touchBtn: TextButton? = nil
local touchLabel: TextLabel? = nil
local touchScale: UIScale? = nil
local touchTarget: ProximityPrompt? = nil
local touchOrder = 0 -- 뜬 순서 (가장 최근 것이 버튼의 대상)
local entryOrder: { [ProximityPrompt]: number } = {}
local updateTouchButton: () -> () -- 아래에서 정의 (attach·hide·destroy 가 먼저 쓴다)

-- ===== 입력 종류 =====
local function inputKind(): string
	if touchOverride == true then
		return "TOUCH"
	end
	if RunService:IsStudio() and workspace:GetAttribute("Camp_ForceTouch") == true then
		return "TOUCH"
	end
	local t = InputController.CurrentInputType
	if t == "TOUCH" or t == "GAMEPAD" then
		return t
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "TOUCH"
	end
	return "KBM"
end

local PAD_NAMES: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.ButtonX] = "X",
	[Enum.KeyCode.ButtonA] = "A",
	[Enum.KeyCode.ButtonB] = "B",
	[Enum.KeyCode.ButtonY] = "Y",
	[Enum.KeyCode.ButtonR1] = "RB",
	[Enum.KeyCode.ButtonL1] = "LB",
	[Enum.KeyCode.ButtonR2] = "RT",
	[Enum.KeyCode.ButtonL2] = "LT",
}

local function keyGlyph(prompt: ProximityPrompt, kind: string): string
	if kind == "TOUCH" then
		return "탭"
	elseif kind == "GAMEPAD" then
		return PAD_NAMES[prompt.GamepadKeyCode] or "X"
	end
	local code = prompt.KeyboardKeyCode
	if code == Enum.KeyCode.None then
		return "E"
	end
	local name = UserInputService:GetStringForKeyCode(code)
	if name == nil or #name == 0 then
		name = code.Name
	end
	return string.upper(name)
end

-- ===== 속성 읽기 (프롬프트 → Parent 순) =====
local function attr(prompt: ProximityPrompt, name: string): any
	local v = prompt:GetAttribute(name)
	if v == nil and prompt.Parent then
		v = prompt.Parent:GetAttribute(name)
	end
	return v
end

local function accentOf(prompt: ProximityPrompt): Color3
	local a = attr(prompt, "PromptAccent")
	if a == "YELLOW" then
		return Palette.Yellow
	elseif a == "RED" then
		return Palette.Red
	end
	return Palette.WoodDark
end

local function isForMe(prompt: ProximityPrompt): boolean
	local me = Players.LocalPlayer
	local id = attr(prompt, "ForUserId")
	if typeof(id) == "number" and id > 0 then
		return me ~= nil and me.UserId == id
	end
	-- HideForUserId: 그 사람에게만 안 보인다 (내 캐릭터에 달린 "풀어 주기" — 친구만 누른다, 2단계)
	local hide = attr(prompt, "HideForUserId")
	if typeof(hide) == "number" and hide > 0 and me ~= nil and me.UserId == hide then
		return false
	end
	return true
end

local function ensureHolder(): Folder
	if holder and holder.Parent then
		return holder
	end
	local f = Instance.new("Folder")
	f.Name = "CampPrompts"
	f.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	holder = f
	return f
end

-- ===== 게이지 링: 반쪽 두 개(ClipsDescendants, 회전 없음) + 각 반쪽의 UIStroke 에 반 가림 UIGradient. 그라데이션 회전만 돌린다 =====
-- 오른쪽 반: Rotation 0(왼쪽 반만 보임 → 클립 밖) → 180(오른쪽 반 다 보임). 12시부터 시계 방향으로 찬다
-- 왼쪽 반: Rotation 180(오른쪽만 → 클립 밖) → 360(왼쪽 반 다 보임). 6시부터 9시·12시로 이어진다
local HALF_MASK = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.4999, 0),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(1, 1),
})

local function ringHalf(parent: GuiObject, right: boolean, size: number): UIGradient
	local clip = Instance.new("Frame")
	clip.Name = if right then "Right" else "Left"
	clip.BackgroundTransparency = 1
	clip.BorderSizePixel = 0
	clip.ClipsDescendants = true
	clip.Size = UDim2.fromScale(0.5, 1)
	clip.Position = UDim2.fromScale(if right then 0.5 else 0, 0)
	clip.ZIndex = parent.ZIndex + 1
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundTransparency = 1
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromOffset(size, size)
	fill.Position = UDim2.fromOffset(if right then -size / 2 else 0, 0)
	fill.ZIndex = clip.ZIndex
	UiKit.corner(fill, 999)
	local s = UiKit.stroke(fill, Palette.Yellow, RING_THICK, 0)
	s.LineJoinMode = Enum.LineJoinMode.Round
	local g = Instance.new("UIGradient")
	g.Transparency = HALF_MASK
	g.Rotation = if right then 0 else 180
	g.Parent = s
	fill.Parent = clip
	clip.Parent = parent
	return g
end

local function setRing(e: Entry, p: number)
	p = math.clamp(p, 0, 1)
	e.ringRight.Rotation = 180 * math.clamp(p * 2, 0, 1)
	e.ringLeft.Rotation = 180 + 180 * math.clamp(p * 2 - 1, 0, 1)
end

-- 손맛 트윈만 끊는다 (등장·퇴장 트윈은 따로 — 뜨는 중에 E 를 눌러도 판이 작게 멈추지 않게)
local function cancelTweens(e: Entry)
	for _, t in ipairs(e.tweens) do
		t:Cancel()
	end
	table.clear(e.tweens)
end

local function cancelVis(e: Entry)
	for _, t in ipairs(e.visTweens) do
		t:Cancel()
	end
	table.clear(e.visTweens)
end

local function play(e: Entry, t: Tween): Tween
	table.insert(e.tweens, t)
	t:Play()
	return t
end

local function playVis(e: Entry, t: Tween): Tween
	table.insert(e.visTweens, t)
	t:Play()
	return t
end

-- ===== 그리기 =====
local function track(e: Entry, inst: Instance, prop: string, base: number)
	table.insert(e.fadeItems, { inst = inst, prop = prop, base = base })
end

local function applyFade(e: Entry)
	local a = e.fade.Value
	for _, it in ipairs(e.fadeItems) do
		(it.inst :: any)[it.prop] = 1 - (1 - it.base) * a
	end
end

local function build(prompt: ProximityPrompt, kind: string): Entry
	local touch = kind == "TOUCH"
	local badgeSize = if touch then BADGE_TOUCH else BADGE_PC
	local ringSize = badgeSize + RING_PAD
	local panelH = if touch then PANEL_H_TOUCH else PANEL_H_PC
	local accent = accentOf(prompt)

	local gui = Instance.new("BillboardGui")
	gui.Name = "CampPrompt"
	gui.Adornee = prompt.Parent :: any -- BasePart·Model·Attachment
	gui.AlwaysOnTop = true
	gui.Active = true -- 폰: 아래 TextButton 이 탭을 받으려면 필요
	gui.ResetOnSpawn = false
	gui.MaxDistance = prompt.MaxActivationDistance + 4
	gui.Size = UDim2.fromOffset(360, panelH + 24)
	gui.LightInfluence = 0
	local off = attr(prompt, "PromptOffset")
	gui.StudsOffsetWorldSpace = if typeof(off) == "Vector3" then off else DEFAULT_OFFSET

	-- 판: 어두운 올리브(반투명) + 위에서 빛 + 굵은 테두리. 폰에서는 판 전체가 탭 버튼
	local root = Instance.new("TextButton")
	root.Name = "Panel"
	root.Text = ""
	root.AutoButtonColor = false
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Position = UDim2.new(0.5, 0, 1, -6)
	root.AutomaticSize = Enum.AutomaticSize.X
	root.Size = UDim2.fromOffset(0, panelH)
	root.BackgroundColor3 = U.PanelTop
	root.BackgroundTransparency = 0.12
	root.BorderSizePixel = 0
	root.Active = touch
	root.Selectable = false
	UiKit.corner(root, 18)
	UiKit.gradient(root, Color3.new(1, 1, 1), Color3.new(0.68, 0.68, 0.68))
	local panelStroke = UiKit.stroke(root, accent, 2.5, 0.05)
	panelStroke.LineJoinMode = Enum.LineJoinMode.Round
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 16)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = root
	local row = Instance.new("UIListLayout")
	row.FillDirection = Enum.FillDirection.Horizontal
	row.VerticalAlignment = Enum.VerticalAlignment.Center
	row.SortOrder = Enum.SortOrder.LayoutOrder
	row.Padding = UDim.new(0, 12)
	row.Parent = root
	local rootScale = UiKit.popScale(root)

	-- 키 배지 자리(링 포함)
	local keyBox = Instance.new("Frame")
	keyBox.Name = "Key"
	keyBox.BackgroundTransparency = 1
	keyBox.Size = UDim2.fromOffset(ringSize, ringSize)
	keyBox.LayoutOrder = 1
	keyBox.ZIndex = 2
	keyBox.Parent = root

	-- 게이지 바탕 링(옅게) + 채워지는 노란 링
	local trackRing = Instance.new("Frame")
	trackRing.Name = "Track"
	trackRing.BackgroundTransparency = 1
	trackRing.Size = UDim2.fromScale(1, 1)
	trackRing.ZIndex = 2
	UiKit.corner(trackRing, 999)
	local ringTrack = UiKit.stroke(trackRing, Palette.Cream, RING_THICK, 0.8)
	trackRing.Parent = keyBox
	local ringRight = ringHalf(keyBox, true, ringSize)
	local ringLeft = ringHalf(keyBox, false, ringSize)

	-- 배지: 어두운 올리브 원 + 크림 글자. 눌리면 작아진다(Press)
	local badge = Instance.new("Frame")
	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = UDim2.fromScale(0.5, 0.5)
	badge.Size = UDim2.fromOffset(badgeSize, badgeSize)
	badge.BackgroundColor3 = Palette.OliveDark
	badge.BorderSizePixel = 0
	badge.ZIndex = 4
	UiKit.corner(badge, 999)
	UiKit.gradient(badge, Color3.new(1, 1, 1), Color3.new(0.72, 0.72, 0.72))
	local badgeStroke = UiKit.stroke(badge, Palette.Cream, 2, 0.25)
	local badgeScale = Instance.new("UIScale")
	badgeScale.Name = "Press"
	badgeScale.Parent = badge
	local badgeText = Instance.new("TextLabel")
	badgeText.Name = "Glyph"
	badgeText.BackgroundTransparency = 1
	badgeText.Size = UDim2.fromScale(1, 1)
	badgeText.Font = UiKit.FontBlack
	badgeText.TextSize = if touch then 19 else 22
	badgeText.TextColor3 = Palette.Cream
	badgeText.Text = keyGlyph(prompt, kind)
	badgeText.ZIndex = 5
	badgeText.Parent = badge
	badge.Parent = keyBox

	-- 라벨 두 줄: 동사(굵게, 크림 + 먹 테두리) / 대상(작게, 크림 80%)
	local labels = Instance.new("Frame")
	labels.Name = "Labels"
	labels.BackgroundTransparency = 1
	labels.AutomaticSize = Enum.AutomaticSize.XY
	labels.Size = UDim2.fromOffset(0, 0)
	labels.LayoutOrder = 2
	labels.ZIndex = 2
	local col = Instance.new("UIListLayout")
	col.FillDirection = Enum.FillDirection.Vertical
	col.HorizontalAlignment = Enum.HorizontalAlignment.Left
	col.SortOrder = Enum.SortOrder.LayoutOrder
	col.Padding = UDim.new(0, 1)
	col.Parent = labels

	local actionRow = Instance.new("Frame")
	actionRow.Name = "ActionRow"
	actionRow.BackgroundTransparency = 1
	actionRow.AutomaticSize = Enum.AutomaticSize.XY
	actionRow.Size = UDim2.fromOffset(0, 0)
	actionRow.LayoutOrder = 1
	actionRow.ZIndex = 2
	local arow = Instance.new("UIListLayout")
	arow.FillDirection = Enum.FillDirection.Horizontal
	arow.VerticalAlignment = Enum.VerticalAlignment.Center
	arow.SortOrder = Enum.SortOrder.LayoutOrder
	arow.Padding = UDim.new(0, 6)
	arow.Parent = actionRow

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.AutomaticSize = Enum.AutomaticSize.X
	icon.Size = UDim2.fromOffset(0, ACTION_TEXT + 6)
	icon.Font = UiKit.FontBold
	icon.TextSize = ICON_TEXT
	icon.TextColor3 = Palette.Cream
	icon.LayoutOrder = 1
	icon.ZIndex = 2
	icon.Visible = false
	icon.Parent = actionRow

	local action = Instance.new("TextLabel")
	action.Name = "Action"
	action.BackgroundTransparency = 1
	action.AutomaticSize = Enum.AutomaticSize.X
	action.Size = UDim2.fromOffset(0, ACTION_TEXT + 6)
	action.Font = UiKit.FontBold
	action.TextSize = ACTION_TEXT
	action.TextColor3 = Palette.Cream
	action.TextStrokeColor3 = Palette.Ink
	action.TextStrokeTransparency = 0.35
	action.TextXAlignment = Enum.TextXAlignment.Left
	action.LayoutOrder = 2
	action.ZIndex = 2
	action.Parent = actionRow
	actionRow.Parent = labels

	local object = Instance.new("TextLabel")
	object.Name = "Object"
	object.BackgroundTransparency = 1
	object.AutomaticSize = Enum.AutomaticSize.X
	object.Size = UDim2.fromOffset(0, OBJECT_TEXT + 4)
	object.Font = UiKit.Font
	object.TextSize = OBJECT_TEXT
	object.TextColor3 = Palette.Cream
	object.TextTransparency = 0.2
	object.TextXAlignment = Enum.TextXAlignment.Left
	object.LayoutOrder = 2
	object.ZIndex = 2
	object.Parent = labels
	labels.Parent = root

	root.Parent = gui
	gui.Parent = ensureHolder()

	local fade = Instance.new("NumberValue")
	fade.Name = "Fade"
	fade.Value = 0
	fade.Parent = gui

	local e: Entry = {
		prompt = prompt,
		gui = gui,
		root = root,
		rootScale = rootScale,
		badge = badge,
		badgeScale = badgeScale,
		badgeText = badgeText,
		panelStroke = panelStroke,
		ringRight = ringRight,
		ringLeft = ringLeft,
		ringTrack = ringTrack,
		icon = icon,
		action = action,
		object = object,
		fade = fade,
		fadeItems = {},
		conns = {},
		tweens = {},
		visTweens = {},
		holding = false,
		hiding = false,
		accent = accent,
	}
	track(e, root, "BackgroundTransparency", root.BackgroundTransparency)
	track(e, panelStroke, "Transparency", panelStroke.Transparency)
	track(e, ringTrack, "Transparency", ringTrack.Transparency)
	track(e, badge, "BackgroundTransparency", 0)
	track(e, badgeStroke, "Transparency", badgeStroke.Transparency)
	track(e, badgeText, "TextTransparency", 0)
	track(e, icon, "TextTransparency", 0)
	track(e, action, "TextTransparency", 0)
	track(e, action, "TextStrokeTransparency", action.TextStrokeTransparency)
	track(e, object, "TextTransparency", object.TextTransparency)
	-- 노란 채움 링은 fade 와 상관없이 진행도만 (처음엔 0 = 안 보임)
	table.insert(
		e.conns,
		fade.Changed:Connect(function()
			applyFade(e)
		end)
	)
	applyFade(e)
	setRing(e, 0)
	return e
end

local function refreshText(e: Entry)
	local p = e.prompt
	local ic = attr(p, "PromptIcon")
	if typeof(ic) == "string" and #ic > 0 then
		e.icon.Text = ic
		e.icon.Visible = true
	else
		e.icon.Visible = false
	end
	e.action.Text = p.ActionText
	e.object.Text = p.ObjectText
	e.object.Visible = #p.ObjectText > 0
	local accent = accentOf(p)
	e.accent = accent
	if not e.holding then
		e.panelStroke.Color = accent
	end
	updateTouchButton()
end

-- ===== 보이기·숨기기·지우기 =====
local function destroy(e: Entry)
	entries[e.prompt] = nil
	cancelTweens(e)
	cancelVis(e)
	for _, c in ipairs(e.conns) do
		c:Disconnect()
	end
	table.clear(e.conns)
	e.gui:Destroy()
	entryOrder[e.prompt] = nil
	updateTouchButton()
end

local function show(e: Entry)
	e.hiding = false
	cancelTweens(e)
	cancelVis(e)
	e.gui.Enabled = true
	e.rootScale.Scale = 0.8
	playVis(e, TweenService:Create(e.rootScale, TW_SHOW, { Scale = 1 }))
	playVis(e, TweenService:Create(e.fade, TW_FADE_IN, { Value = 1 }))
end

local function hide(e: Entry)
	if e.hiding then
		return
	end
	e.hiding = true
	e.holding = false
	cancelTweens(e)
	cancelVis(e)
	updateTouchButton()
	playVis(e, TweenService:Create(e.rootScale, TW_HIDE, { Scale = 0.85 }))
	local t = playVis(e, TweenService:Create(e.fade, TW_FADE_OUT, { Value = 0 }))
	t.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and e.hiding and entries[e.prompt] == e then
			destroy(e)
		end
	end)
end

-- ===== 손맛 =====
local function holdBegan(e: Entry)
	if e.hiding then
		return
	end
	e.holding = true
	cancelTweens(e)
	-- 배지 눌림
	play(e, TweenService:Create(e.badgeScale, TW_PRESS, { Scale = 0.9 }))
	-- 게이지: HoldDuration 동안 12시부터 시계 방향으로 한 바퀴 (오른쪽 반 → 왼쪽 반)
	local dur = e.prompt.HoldDuration
	setRing(e, 0)
	if dur > 0 then
		local half = dur / 2
		play(
			e,
			TweenService:Create(
				e.ringRight,
				TweenInfo.new(half, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
				{ Rotation = 180 }
			)
		)
		play(
			e,
			TweenService:Create(
				e.ringLeft,
				TweenInfo.new(half, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, half),
				{ Rotation = 360 }
			)
		)
	end
	AudioController.play("UI_PROMPT_HOLD")
end

local function holdEnded(e: Entry)
	if not e.holding then
		return
	end
	e.holding = false
	cancelTweens(e)
	play(e, TweenService:Create(e.badgeScale, TW_PRESS, { Scale = 1 }))
	-- 놓으면 게이지가 스르륵 되돌아간다
	play(e, TweenService:Create(e.ringRight, TW_RING_RESET, { Rotation = 0 }))
	play(e, TweenService:Create(e.ringLeft, TW_RING_RESET, { Rotation = 180 }))
	e.panelStroke.Color = e.accent
end

local function triggered(e: Entry)
	if e.hiding then
		return
	end
	e.holding = false
	cancelTweens(e)
	setRing(e, 1)
	e.badgeScale.Scale = 1
	-- 톡: 1 → 1.15 → 1 (0.18초)
	local up = play(
		e,
		TweenService:Create(
			e.rootScale,
			TweenInfo.new(POP_UP_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = 1.15 }
		)
	)
	up.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and entries[e.prompt] == e and not e.hiding then
			play(
				e,
				TweenService:Create(
					e.rootScale,
					TweenInfo.new(POP_DOWN_SEC, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Scale = 1 }
				)
			)
		end
	end)
	-- 노란 번쩍: 배지·테두리가 노랑이 됐다가 돌아온다
	e.badge.BackgroundColor3 = Palette.Yellow
	e.badgeText.TextColor3 = Palette.Ink
	e.panelStroke.Color = Palette.Yellow
	local flashInfo = TweenInfo.new(FLASH_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	play(e, TweenService:Create(e.badge, flashInfo, { BackgroundColor3 = Palette.OliveDark }))
	play(e, TweenService:Create(e.badgeText, flashInfo, { TextColor3 = Palette.Cream }))
	play(e, TweenService:Create(e.panelStroke, flashInfo, { Color = e.accent }))
	-- 채운 링은 번쩍 뒤에 비운다
	task.delay(FLASH_SEC, function()
		if entries[e.prompt] == e and not e.holding then
			play(e, TweenService:Create(e.ringRight, TW_RING_RESET, { Rotation = 0 }))
			play(e, TweenService:Create(e.ringLeft, TW_RING_RESET, { Rotation = 180 }))
		end
	end)
	AudioController.play("UI_PROMPT_OK")
end

-- ===== 프롬프트 하나 붙이기 =====
local function attach(prompt: ProximityPrompt)
	local existing = entries[prompt]
	if existing then
		-- 숨는 중에 다시 보이면 그대로 살린다
		show(existing)
		touchOrder += 1
		entryOrder[prompt] = touchOrder
		refreshText(existing)
		return
	end
	local kind = inputKind()
	local e = build(prompt, kind)
	entries[prompt] = e
	touchOrder += 1
	entryOrder[prompt] = touchOrder
	refreshText(e)
	show(e)
	updateTouchButton()

	local touch = kind == "TOUCH"
	if touch then
		-- 판 전체가 탭 버튼: 누르는 동안 InputHoldBegin, 떼면 InputHoldEnd (HoldDuration 0 이면 바로 Triggered)
		table.insert(
			e.conns,
			e.root.InputBegan:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.Touch
					or input.UserInputType == Enum.UserInputType.MouseButton1
				then
					prompt:InputHoldBegin()
				end
			end)
		)
		table.insert(
			e.conns,
			e.root.InputEnded:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.Touch
					or input.UserInputType == Enum.UserInputType.MouseButton1
				then
					prompt:InputHoldEnd()
				end
			end)
		)
	end
	-- 서버가 글·속성을 바꾸면 그 자리에서 갱신
	table.insert(
		e.conns,
		prompt:GetPropertyChangedSignal("ActionText"):Connect(function()
			refreshText(e)
		end)
	)
	table.insert(
		e.conns,
		prompt:GetPropertyChangedSignal("ObjectText"):Connect(function()
			refreshText(e)
		end)
	)
	table.insert(
		e.conns,
		prompt.AttributeChanged:Connect(function()
			refreshText(e)
		end)
	)
	local parent = prompt.Parent
	if parent then
		table.insert(
			e.conns,
			parent.AttributeChanged:Connect(function()
				refreshText(e)
			end)
		)
	end
	-- 프롬프트나 그 부모가 없어지면 바로 지운다
	table.insert(
		e.conns,
		prompt.AncestryChanged:Connect(function(_, newParent)
			if newParent == nil or not prompt:IsDescendantOf(workspace) then
				if entries[prompt] == e then
					destroy(e)
				end
			end
		end)
	)
	table.insert(
		e.conns,
		prompt.Destroying:Connect(function()
			if entries[prompt] == e then
				destroy(e)
			end
		end)
	)
end

local function isCustom(prompt: ProximityPrompt): boolean
	return prompt.Style == Enum.ProximityPromptStyle.Custom
end

-- ===== 폰 탭 버튼 (ScreenGui) =====
local function ensureTouchButton(): TextButton
	if touchBtn and touchBtn.Parent then
		return touchBtn
	end
	local gui = UiKit.screen("CampPromptTouch", 12)
	local btn = Instance.new("TextButton")
	btn.Name = "Tap"
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.AnchorPoint = Vector2.new(1, 1)
	-- 점프 버튼(오른쪽 아래, iPhone 시뮬 실측 (655,233) 70px)의 왼쪽. UiKit 화면 배율(폰 0.61)이 오프셋에도 걸리므로 넉넉히
	btn.Position = UDim2.new(1, -210, 1, -40)
	btn.Size = UDim2.fromOffset(TOUCH_BTN, TOUCH_BTN)
	btn.BackgroundColor3 = Palette.OliveDark
	btn.BorderSizePixel = 0
	btn.Active = true
	btn.Selectable = false
	btn.Visible = false
	UiKit.corner(btn, 999)
	UiKit.gradient(btn, Color3.new(1, 1, 1), Color3.new(0.72, 0.72, 0.72))
	local s = UiKit.stroke(btn, Palette.Yellow, 3, 0)
	s.LineJoinMode = Enum.LineJoinMode.Round
	local scale = Instance.new("UIScale")
	scale.Parent = btn
	touchScale = scale
	local glyph = Instance.new("TextLabel")
	glyph.Name = "Glyph"
	glyph.BackgroundTransparency = 1
	glyph.Position = UDim2.fromScale(0, 0.1)
	glyph.Size = UDim2.fromScale(1, 0.42)
	glyph.Font = UiKit.FontBlack
	glyph.TextSize = 24
	glyph.TextColor3 = Palette.Cream
	glyph.Text = "탭"
	glyph.Parent = btn
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.05, 0.5)
	label.Size = UDim2.fromScale(0.9, 0.36)
	label.Font = UiKit.FontBold
	label.TextSize = 16
	label.TextScaled = true
	label.TextColor3 = Palette.Cream
	label.TextStrokeColor3 = Palette.Ink
	label.TextStrokeTransparency = 0.4
	label.Text = ""
	label.Parent = btn
	touchLabel = label
	local function isTap(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
	end
	btn.InputBegan:Connect(function(input)
		local p = touchTarget
		if p and p.Parent and isTap(input) then
			scale.Scale = 0.92
			p:InputHoldBegin()
		end
	end)
	btn.InputEnded:Connect(function(input)
		local p = touchTarget
		if isTap(input) then
			TweenService:Create(scale, TW_PRESS, { Scale = 1 }):Play()
			if p and p.Parent then
				p:InputHoldEnd()
			end
		end
	end)
	btn.Parent = gui
	touchBtn = btn
	return btn
end

updateTouchButton = function()
	if inputKind() ~= "TOUCH" then
		touchTarget = nil
		if touchBtn then
			touchBtn.Visible = false
		end
		return
	end
	local best: Entry? = nil
	local bestOrder = -1
	for p, e in pairs(entries) do
		if not e.hiding and p.Parent and (entryOrder[p] or 0) > bestOrder then
			best, bestOrder = e, entryOrder[p] or 0
		end
	end
	local btn = ensureTouchButton()
	if not best then
		touchTarget = nil
		btn.Visible = false
		return
	end
	local p = best.prompt
	touchTarget = p
	local ic = attr(p, "PromptIcon")
	local icon = if typeof(ic) == "string" and #ic > 0 then ic .. " " else ""
	if touchLabel then
		touchLabel.Text = icon .. p.ActionText
	end
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if accentOf(p) == Palette.WoodDark then Palette.Cream else accentOf(p)
	end
	if not btn.Visible then
		btn.Visible = true
		if touchScale then
			touchScale.Scale = 0.8
			TweenService:Create(touchScale, TW_SHOW, { Scale = 1 }):Play()
		end
	end
end

-- 입력 종류가 바뀌면(키보드 ↔ 패드 ↔ 터치) 보이는 프롬프트를 다시 그린다
local function rebuildAll()
	local list: { ProximityPrompt } = {}
	for p, e in pairs(entries) do
		if not e.hiding then
			table.insert(list, p)
		end
	end
	for _, p in ipairs(list) do
		local e = entries[p]
		if e then
			destroy(e)
		end
		if p.Parent and isCustom(p) and isForMe(p) then
			attach(p)
		end
	end
	updateTouchButton()
end

-- 개발 토글: true 면 폰처럼(큰 탭 배지·판 탭), false/nil 이면 자동 판별
function PromptController.setTouchOverride(on: boolean)
	touchOverride = if on then true else nil
	rebuildAll()
end

function PromptController.start()
	ensureHolder()
	-- Exclusivity(OnePerButton 등)와 가까운 것 고르기는 Roblox 가 한다: 여기 PromptShown 이 오는 것만 그린다
	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt)
		if not isCustom(prompt) then
			return
		end
		if not isForMe(prompt) then
			return -- 다른 사람 몫: 그리지 않는다 (Enabled 는 서버 것이라 건드리지 않음)
		end
		attach(prompt)
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
		local e = entries[prompt]
		if e then
			hide(e)
		end
	end)
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt: ProximityPrompt)
		local e = entries[prompt]
		if e then
			holdBegan(e)
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt: ProximityPrompt)
		local e = entries[prompt]
		if e then
			holdEnded(e)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if player ~= Players.LocalPlayer then
			return
		end
		local e = entries[prompt]
		if e then
			triggered(e)
		end
	end)
	InputController.InputTypeChanged:Connect(function()
		rebuildAll()
	end)
	if RunService:IsStudio() then
		workspace:GetAttributeChangedSignal("Camp_ForceTouch"):Connect(rebuildAll)
	end
end

return PromptController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
