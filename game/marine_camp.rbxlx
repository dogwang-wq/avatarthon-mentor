            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 첫 1분 (28 §7 "첫 1분", 2026-10-21): 1일차 전 기지(CAMP)의 첫 목적지 = 유보트 꾸미기 마당.
-- 가설 2·3 의 전제 — 처음 들어온 아이가 "뭐 하지?" 로 멈추지 않고 5초 안에 걷기 시작한다(이해했다는 것은 아이 테스트로만).
--   · 내 유보트는 처음부터 마당 거치대 위에 있다 (SessionService.placeAtCamp 가 1일차 전이면 거치대에 둔다)
--   · 나는 스폰 앞(FM_StartSpot)에서 마당을 보고 선다. 바닥 노란 화살표(생성기 FM_Arrow*)가 입구 발판(FM_YardPad)까지 이어진다
--   · 첫 입소: 강찬 "소대! 한 배 타자!" → 분대원 셋 "악!" → 분대원이 먼저 마당 입구로 달려가 손을 흔든다
--   · 입구 상자(FM_YardGate)에 들어서면 1일차 시작 (아래 큰 출발 버튼과 같은 길 — 막지 않는다, 버튼으로도 간다)
--   · 오래 안 오면 9초마다 분대원 한 명이 손 흔들며 부른다 (재촉·벌 아님)
-- 판정은 서버. 클라이언트는 화살표 빛·첫 카메라만 (WayFx·CameraController).
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local SquadNpcService = require(script.Parent.SquadNpcService)
local TelemetryService = require(script.Parent.TelemetryService)

local WelcomeService = {}

type Rig = SquadNpcService.Rig
type SessionLike = {
	userId: number,
	player: Player,
	members: { [string]: { rig: Rig?, friendUserId: number? } },
}
export type Hooks = {
	lines: (session: any, list: { CampScript.Line }) -> (),
	bubble: (session: any, memberId: string, text: string, sec: number?) -> (),
	cue: (session: any, kind: string, payload: { [string]: any }) -> (),
	arrive: (session: any) -> (), -- 입구 상자에 들어섰다: SessionService 가 허용되면 1일차 시작
}

type Welcome = {
	session: SessionLike,
	first: boolean,
	phase: string, -- WAIT_CHAR → INTRO → AK → RUN → THERE
	t0: number,
	joinedAt: number,
	nextNudge: number,
	nudgeIdx: number,
	running: number,
	token: number,
}

local W = GameConfig.Welcome
local T = CampScript.Welcome
local hooks: Hooks? = nil
local welcomes: { [number]: Welcome } = {}
local lastArriveSec: { [number]: number } = {} -- 검증용: 들어와서 마당에 닿기까지 초 (DevApi "welcome")

function WelcomeService.setHooks(h: Hooks)
	hooks = h
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function trigger(name: string): BasePart?
	local f = SceneBindings.getFolder("Triggers")
	local p = f and f:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end

-- 입구 상자 (생성기 FM_YardGate: 마당 전체 + 아치 앞 발판까지). 없으면 꾸미기 거치대 기준으로 같은 크기
local function gateBox(): (CFrame, Vector3)
	local g = trigger("FM_YardGate")
	if g then
		return g.CFrame, g.Size
	end
	local r = GameConfig.Build.RackPos
	return CFrame.lookAt(r + Vector3.new(0, 4, 3), r + Vector3.new(0, 4, 2)), Vector3.new(30, 8, 34)
end

-- 아치 앞 발판 가운데(땅) — 상자의 앞(남쪽) 면 가운데에서 2 안쪽
local function gateFront(): (Vector3, Vector3)
	local cf, size = gateBox()
	local front = cf * CFrame.new(0, -size.Y / 2, size.Z / 2 - 2)
	return front.Position, flat(cf.LookVector).Unit
end

-- 스폰 앞 첫 자리 (생성기 FM_StartSpot, LookVector = 마당 쪽)
function WelcomeService.startSpot(): CFrame
	local s = trigger("FM_StartSpot")
	if s then
		return s.CFrame
	end
	local f = gateFront()
	local p = Vector3.new(14, 3.3, 30)
	return CFrame.lookAt(p, Vector3.new(f.X, p.Y, f.Z))
end

-- 이 자리가 입구 상자 안인가
function WelcomeService.inGate(pos: Vector3): boolean
	local cf, size = gateBox()
	local l = cf:PointToObjectSpace(pos)
	return math.abs(l.X) <= size.X / 2 and math.abs(l.Z) <= size.Z / 2 and l.Y <= size.Y / 2 + 4
end

local function hrpOf(session: SessionLike): BasePart?
	local ch = session.player.Character
	local h = ch and ch:FindFirstChild("HumanoidRootPart")
	return if h and h:IsA("BasePart") then h else nil
end

local function npcRigs(session: SessionLike): { { id: string, rig: Rig } }
	local out = {}
	for _, id in ipairs(SquadCatalog.NpcOrder) do
		local m = session.members[id]
		if m and m.rig and not m.friendUserId then
			table.insert(out, { id = id, rig = m.rig :: Rig })
		end
	end
	return out
end

-- 분대원 첫 자리: 내 왼쪽에 한 줄로 서서 나와 같은 쪽(마당)을 본다 — 소대 정렬. 화면 가운데(마당 가는 길)는 비운다
-- (Studio 1차: 내 앞에 나를 보고 서니 첫 화면 가운데를 셋이 가렸다)
local function squadStart(session: SessionLike)
	local cf = WelcomeService.startSpot()
	local fwd, right = flat(cf.LookVector).Unit, flat(cf.RightVector).Unit
	for i, e in ipairs(npcRigs(session)) do
		local p = cf.Position - right * (3 + (i - 1) * 2.8) + fwd * 1.2
		SquadNpcService.setSitting(e.rig, false)
		SquadNpcService.setMood(e.rig, "IDLE")
		SquadNpcService.standAt(e.rig, p, fwd)
	end
end

-- 입구에서 기다리는 자리: 아치 기둥 안쪽 양옆 + 가운데 조금 뒤 (아이가 걸어 들어오는 발판 위는 비운다), 나(스폰 쪽)를 본다
local function waitSpots(): { Vector3 }
	local f, look = gateFront()
	local right = look:Cross(Vector3.yAxis)
	return {
		f + look * 4.5 - right * 4.2,
		f + look * 4.5 + right * 4.2,
		f + look * 7.5,
	}
end

-- 달리기: Heartbeat 마다 standAt 보간 + run 애니 (BoatBuildService·RescueService 의 glide 와 같은 요령)
local function run(w: Welcome, rig: Rig, to: Vector3, look: Vector3, onDone: () -> ())
	local tok = w.token
	local from = rig.hrp.Position
	local dir = flat(to - from)
	local dist = dir.Magnitude
	local sec = math.max(0.3, dist / W.RunSpeed)
	local moveLook = if dist > 0.3 then dir.Unit else look
	SquadNpcService.setRunning(rig, true)
	w.running += 1
	task.spawn(function()
		local t0 = os.clock()
		while rig.model.Parent and w.token == tok do
			local a = math.clamp((os.clock() - t0) / sec, 0, 1)
			SquadNpcService.standAt(rig, from:Lerp(to, a), moveLook)
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		w.running -= 1
		SquadNpcService.setRunning(rig, false)
		if w.token ~= tok or not rig.model.Parent then
			return
		end
		SquadNpcService.standAt(rig, to, look)
		onDone()
	end)
end

local function H(): Hooks
	return hooks :: Hooks
end

-- placeAtCamp(1일차 전)에서: 분대원은 내 앞, 첫 입소면 구호부터. 캐릭터가 서면(tick) 시계가 돈다
function WelcomeService.begin(session: SessionLike, first: boolean)
	local old = welcomes[session.userId]
	local w: Welcome = {
		session = session,
		first = first,
		phase = "WAIT_CHAR",
		t0 = 0,
		joinedAt = if old then old.joinedAt else os.clock(),
		nextNudge = 0,
		nudgeIdx = 0,
		running = 0,
		token = (if old then old.token else 0) + 1,
	}
	welcomes[session.userId] = w
	squadStart(session)
end

-- 리스폰·첫 스폰: 스폰 앞 첫 자리에서 마당을 본다
function WelcomeService.placeMe(_session: SessionLike, character: Model)
	character:PivotTo(WelcomeService.startSpot())
	-- 스폰 보호막(SpawnLocation 기본 10초) 빛 공이 첫 화면 가운데를 덮었다 — 싸움이 없는 캠프라 뗀다
	local ff = character:FindFirstChildOfClass("ForceField")
	if ff then
		ff:Destroy()
	end
end

local function goRun(w: Welcome)
	w.phase = "RUN"
	local spots = waitSpots()
	local f = gateFront()
	local me = hrpOf(w.session)
	local faceTo = if me then me.Position else WelcomeService.startSpot().Position
	local rigs = npcRigs(w.session)
	local left = #rigs
	for i, e in ipairs(rigs) do
		local spot = spots[i] or f
		task.delay((i - 1) * 0.18, function()
			if welcomes[w.session.userId] ~= w then
				return
			end
			run(w, e.rig, spot, flat(faceTo - spot), function()
				left -= 1
				SquadNpcService.playOnce(e.rig, "wave")
				if left <= 0 and w.phase == "RUN" then
					w.phase = "THERE"
					w.nextNudge = os.clock() + W.NudgeSec
					H().bubble(w.session, rigs[1].id, T.there, 2.6)
				end
			end)
		end)
	end
	if left == 0 then
		w.phase = "THERE"
		w.nextNudge = os.clock() + W.NudgeSec
	end
	-- 조작 카드는 분대원이 달려가는 순간 한 장 (그 전엔 제목 카드·구호를 본다). 이미 걸었으면 클라이언트가 안 띄운다
	if w.first then
		H().cue(w.session, "TUTORIAL", { cards = CampScript.Tutorial })
	end
end

local function nudge(w: Welcome)
	local rigs = npcRigs(w.session)
	if #rigs == 0 then
		return
	end
	w.nudgeIdx += 1
	local line = T.nudge[(w.nudgeIdx - 1) % #T.nudge + 1]
	for _, e in ipairs(rigs) do
		if e.id == line.who then
			SquadNpcService.playOnce(e.rig, "wave")
			H().bubble(w.session, e.id, line.text, 2.4)
			return
		end
	end
	SquadNpcService.playOnce(rigs[1].rig, "wave")
	H().bubble(w.session, rigs[1].id, line.text, 2.4)
end

-- CAMP 에서 매 Heartbeat (SessionService.tick). yardDay = 다음 날이 1일차이고 출발할 수 있다
function WelcomeService.tick(session: SessionLike, yardDay: boolean)
	local hrp = hrpOf(session)
	if yardDay and hrp and WelcomeService.inGate(hrp.Position) then
		local w0 = welcomes[session.userId]
		local sec = os.clock() - (if w0 then w0.joinedAt else os.clock())
		lastArriveSec[session.userId] = sec
		TelemetryService.log("yard_walk_in", { sec = math.floor(sec * 10) / 10 })
		WelcomeService.stop(session)
		H().arrive(session)
		return
	end
	local w = welcomes[session.userId]
	if not w or not yardDay then
		return
	end
	local now = os.clock()
	if w.phase == "WAIT_CHAR" then
		if hrp then
			w.t0 = now
			w.phase = if w.first then "INTRO" else "AK"
			if not w.first then
				w.t0 = now - W.AkSec -- 다시 입소·기지로: 구호 없이 곧 달려간다
			end
		end
	elseif w.phase == "INTRO" then
		if now - w.t0 >= W.IntroSec then
			w.phase = "AK"
			w.t0 = now
			H().lines(session, { T.kang })
		end
	elseif w.phase == "AK" then
		if now - w.t0 >= W.AkSec then
			w.phase = "AK_SAID"
			w.t0 = now
			if w.first then
				for _, e in ipairs(npcRigs(session)) do
					H().bubble(session, e.id, T.ak, 1.4)
					SquadNpcService.playOnce(e.rig, "cheer")
				end
			end
		end
	elseif w.phase == "AK_SAID" then
		if now - w.t0 >= (if w.first then W.RunDelaySec else 0) then
			goRun(w)
		end
	elseif w.phase == "THERE" then
		if now >= w.nextNudge then
			w.nextNudge = now + W.NudgeSec
			local f = gateFront()
			if not hrp or flat(hrp.Position - f).Magnitude > W.NearStuds then
				nudge(w)
			end
		end
	end
end

-- 1일차가 시작되면(버튼이든 걸어 들어오든)·나가면: 달리기를 끊는다 (분대원 자리는 BoatBuildService 가 정한다)
function WelcomeService.stop(session: SessionLike)
	local w = welcomes[session.userId]
	if w then
		w.token += 1
		for _, e in ipairs(npcRigs(session)) do
			SquadNpcService.setRunning(e.rig, false)
		end
	end
	welcomes[session.userId] = nil
end

function WelcomeService.onPlayerRemoving(session: SessionLike)
	WelcomeService.stop(session)
	lastArriveSec[session.userId] = nil
end

function WelcomeService.debug(session: SessionLike): { [string]: any }
	local w = welcomes[session.userId]
	local hrp = hrpOf(session)
	return {
		phase = if w then w.phase else "NONE",
		first = if w then w.first else nil,
		sinceJoin = if w then math.floor((os.clock() - w.joinedAt) * 10) / 10 else nil,
		arriveSec = lastArriveSec[session.userId],
		inGate = if hrp then WelcomeService.inGate(hrp.Position) else nil,
		gateFront = tostring((gateFront())),
		start = tostring(WelcomeService.startSpot().Position),
	}
end

return WelcomeService
