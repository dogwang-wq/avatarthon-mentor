	AimRadius = 45, -- 서 있는 표적이 이 안에 있으면 조준 모드(십자선·마우스 잠금·어깨 너머)
	RecoilKick = 0.45, -- 쏠 때 카메라가 잠깐 들림 (CameraOffset)
	SpreadDecayPerSec = 3, -- 십자선 벌어짐이 돌아오는 속도
}

-- 자유 이동 스테이지 (22 v2, 2026-10-20): 2일차 유격·4일차(안 번호 5) 야간·5일차(안 번호 6) 탈출. 깃발을 아무 순서로 밟고 도착점으로
GameConfig.Free = {
	FlagsNeed = { [2] = 3, [5] = 1, [6] = 1 } :: { [number]: number }, -- 날마다 밟아야 하는 깃발 수 (5일차 밤은 두 길 중 하나)
	SpotMoveSpeed = 2, -- 탐조등 빛 안에서 이 속도(stud/s) 넘게 움직이면 발각 (→ 제자리 얼음, RescueService)
	CheerEverySec = 7, -- 분대원 응원 말풍선 간격
	EscapeBaseSec = 60, -- 탈출(걷기) 기본 시간 + 능력치 합 × 1.5초. 늦어도 수료
	-- 6일차 사격 문: 분대원도 쏜다 (27 §3 6일차 · 6단계). 아이가 못 맞혀도 문은 열린다(규칙 ①) — 아이가 맞힌 구멍만 색이 다르다
	GateSquadRadius = 30, -- 내가 문에서 이 안(수평)에 오면 분대원이 옆에 서서 쏘기 시작
	GateSquadFirstSec = 4, -- 처음 이만큼은 아이가 먼저 쏘게 기다린다 (2.5 는 5표적 문이 4초 만에 분대원 손으로 열렸다 — Studio 6단계)
	GateSquadEverySec = 5, -- 분대원마다 이 간격으로 남은 표적 하나 (셋이면 약 1.7초에 하나 — 아무도 안 쏴도 약 10초면 열린다)
	GateSquadStaggerSec = 1.4, -- 분대원끼리 첫 사격을 이만큼씩 엇갈림
	GateSquadStandBack = 6, -- 문(보이지 않는 벽) 앞 이만큼에 선다 (벽 위로 올라서지 않게)
}

-- 모닥불 허브 (27 §3 · 28, 2026-10-21 1단계): 낮에 길가의 장작·물통을 E 로 줍고, 밤에 불 크기 3단계 + E 넣기·나누기·앉기.
-- 전부 "막지 않는다": 장작 0개여도 작은 불은 핀다, 안 앉아도 90초면 내일로 갈 수 있다
