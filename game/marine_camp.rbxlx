	PineB = Color3.fromRGB(50, 108, 86),
	LeafShadow = Color3.fromRGB(48, 86, 46), -- 활엽 아래 덩어리 (그림자 톤)
	Bark = Color3.fromRGB(72, 52, 34), -- 가늘고 어두운 줄기
	Basalt = Color3.fromRGB(70, 74, 82), -- 바위 어두운 톤
	RockSlab = Color3.fromRGB(112, 118, 128), -- 큰 바위 판 (밝은 회색은 콘크리트처럼 보였다)
	Bush = Color3.fromRGB(98, 148, 72),
