			"Gym_RopeLeg" .. i,
			"TerrainProps",
			Vector3.new(0.6, 14, 0.6),
			at(80 + c[1] * 2.5, 7, -8 + c[2] * 2.5),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	box(
		"Gym_RopeTop",
		"TerrainProps",
		Vector3.new(6.4, 0.5, 6.4),
		at(80, 14.25, -8),
		Palette.Wood,
		Enum.Material.WoodPlanks
	)
	for i = 1, 3 do
		deco(
			"Gym_Rope" .. i,
			Vector3.new(0.25, 13, 0.25),
			at(78.5 + (i - 1) * 1.5, 7.4, -8),
			Palette.Rope,
			Enum.Material.Fabric,
			{ attrs = { Rope = true } }
		)
		deco(
			"Gym_RopeKnot" .. i,
			Vector3.new(0.5, 0.5, 0.5),
			at(78.5 + (i - 1) * 1.5, 1.2, -8),
			Palette.WoodDark,
			Enum.Material.Fabric,
			{ shape = Enum.PartType.Ball }
		)
	end
	deco(
		"Gym_RopeBell",
		Vector3.new(1.2, 1.3, 1.2),
		at(80, 15.3, -8),
		Palette.Yellow,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Ball }
	)
	deco(
		"Gym_RopeSign",
		Vector3.new(4, 1.2, 0.2),
		at(80, 1.4, -3),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "🧗 로프", SignSub = "체력" } }
	)
	trainTrigger("ROPE", Vector3.new(80, 0.3, -14), PZ)
	-- 타이어 뒤집기: 큰 타이어 1 + 쌓인 타이어 5 + 레인
	deco("Gym_TireLane", Vector3.new(5, 0.1, 18), at(96, 0.38, -18), Palette.Sand, Enum.Material.SmoothPlastic)
	deco(
		"Gym_TireBig",
		Vector3.new(1.4, 4.2, 4.2),
		CFrame.new(96, 0.7, -12) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Ink,
		Enum.Material.Rubber,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco(
		"Gym_TireBigHub",
		Vector3.new(1.5, 1.8, 1.8),
		CFrame.new(96, 0.7, -12) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Stone,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Cylinder }
	)
	for i = 1, 5 do
		deco(
			"Gym_TireStack" .. i,
			Vector3.new(0.9, 2.6, 2.6),
			CFrame.new(103, 0.45 + (i - 1) * 0.9, -26) * CFrame.Angles(0, math.rad(i * 15), math.rad(90)),
			Palette.Ink,
			Enum.Material.Rubber,
			{ shape = Enum.PartType.Cylinder, canCollide = true }
		)
	end
	deco(
		"Gym_TireSign",
		Vector3.new(4, 1.2, 0.2),
		at(96, 1.4, -29),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "🏋️ 타이어", SignSub = "근력" } }
	)
	trainTrigger("TIRE", Vector3.new(96, 0.3, -7), NZ)
	-- 물통·수건걸이 (쉼터 느낌)
	deco(
		"Gym_Jug",
		Vector3.new(1.4, 2, 1.4),
		at(89, 1.2, 40),
		Palette.Sea,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco("Gym_TowelRack", Vector3.new(0.2, 0.2, 4), at(92, 2.2, 40), Palette.WoodDark, Enum.Material.Wood)
	for i = 1, 3 do
