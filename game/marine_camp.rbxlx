        <Item class="ModuleScript" referent="6212">
          <Properties>
            <string name="Name">CoopService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{3B41C3AD-B3E1-4F64-9F77-2F03C18F6BFF}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 친구 자리: 같은 서버·로블록스 친구·수락 필수. 분대원 한 자리를 친구가 대신한다 (03_FLOW §9). 친구 이름·ID 는 저장하지 않는다.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SessionService = require(script.Parent.SessionService)

local CoopService = {}

local S = ProtocolTypes.SessionState
local E = ProtocolTypes.ErrorCode
local Op = ProtocolTypes.CoopOp

type Invite = { hostUserId: number, guestUserId: number, memberId: string, at: number }
local invites: { [number]: Invite } = {} -- guestUserId → invite
local remotes: { [string]: RemoteEvent } = {}

function CoopService.setRemotes(r: { [string]: RemoteEvent })
	remotes = r
end

local function result(session: SessionService.Session, requestId: string, accepted: boolean, code: string)
	local r = remotes[ProtocolTypes.ServerToClient.ActionResult]
	if r then
		r:FireClient(session.player, { requestId = requestId, accepted = accepted, code = code })
	end
end

local function coopCue(session: SessionService.Session, payload: { [string]: any })
	local r = remotes[ProtocolTypes.ServerToClient.CoopCue]
	if r then
		r:FireClient(session.player, payload)
	end
end

local function isFriend(a: Player, b: Player): boolean
	local ok, res = pcall(function()
		return a:IsFriendsWith(b.UserId)
	end)
	return ok and res == true
end

local function calm(session: SessionService.Session): boolean
	return session.state == S.CAMP or session.state == S.NIGHT or session.state == S.LETTER
end

function CoopService.handleRequest(
	session: SessionService.Session,
	requestId: string,
	op: string,
	args: { [string]: any }
)
	if op == Op.INVITE then
		if not calm(session) or session.coop then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		local targetId = args.targetUserId
		local memberId = args.memberId
		if
			typeof(targetId) ~= "number"
			or typeof(memberId) ~= "string"
			or not table.find(SquadCatalog.NpcOrder, memberId)
		then
			return result(session, requestId, false, E.BAD_REQUEST)
		end
		local target = Players:GetPlayerByUserId(targetId)
		local guest = target and SessionService.get(targetId)
		if not target or not guest then
			return result(session, requestId, false, E.INVALID_MEMBER)
		end
		if not isFriend(session.player, target) then
			return result(session, requestId, false, E.NOT_FRIEND)
		end
		if guest.coop or not calm(guest) then
			return result(session, requestId, false, E.BUSY)
		end
		invites[targetId] =
			{ hostUserId = session.userId, guestUserId = targetId, memberId = memberId, at = os.clock() }
		coopCue(guest, {
			kind = "INVITE",
			hostUserId = session.userId,
			hostName = session.player.DisplayName,
			memberId = memberId,
			memberNameKo = SquadCatalog.Members[memberId].nameKo,
		})
		coopCue(session, { kind = "INVITED", targetName = target.DisplayName })
		return result(session, requestId, true, E.OK)
	elseif op == Op.ACCEPT then
		local inv = invites[session.userId]
		if not inv or os.clock() - inv.at > 60 then
			invites[session.userId] = nil
			return result(session, requestId, false, E.WRONG_STATE)
		end
		invites[session.userId] = nil
		local host = SessionService.get(inv.hostUserId)
		if not host or host.coop or not calm(session) then
			return result(session, requestId, false, E.BUSY)
		end
		if not SessionService.mountFriend(host, session, inv.memberId) then
			return result(session, requestId, false, E.INTERNAL)
		end
		local seatKo =
			SquadCatalog.SeatNameKo[(host.loadout.seats.FL == inv.memberId and "FL") or (host.loadout.seats.FR == inv.memberId and "FR") or (host.loadout.seats.BL == inv.memberId and "BL") or "BR"]
		coopCue(host, { kind = "JOINED", guestName = session.player.DisplayName, memberId = inv.memberId })
		coopCue(session, {
			kind = "RIDING",
			hostName = host.player.DisplayName,
			memberId = inv.memberId,
			text = string.format(CampScript.UI.friendSeatHint, seatKo),
		})
		return result(session, requestId, true, E.OK)
	elseif op == Op.DECLINE then
		local inv = invites[session.userId]
		invites[session.userId] = nil
		if inv then
			local host = SessionService.get(inv.hostUserId)
			if host then
				coopCue(host, { kind = "DECLINED" })
			end
		end
		return result(session, requestId, true, E.OK)
	elseif op == Op.LEAVE then
		if not session.coop then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		local other = SessionService.get(session.coop.partnerUserId)
		if other then
			if session.coop.role == "GUEST" then
				SessionService.unmountFriend(other, session)
			else
				SessionService.unmountFriend(session, other)
			end
			coopCue(other, { kind = "LEFT" })
		end
		coopCue(session, { kind = "LEFT" })
		return result(session, requestId, true, E.OK)
	elseif op == Op.NOTE then
		-- 친구의 밤 일지 한 줄: 호스트 프로필에 칩 id 만 남는다
		if not session.coop or session.coop.role ~= "GUEST" then
			return result(session, requestId, false, E.WRONG_STATE)
		end
		local host = SessionService.get(session.coop.partnerUserId)
		local choiceId = args.choiceId
		if not host or typeof(choiceId) ~= "string" or #choiceId > 24 then
			return result(session, requestId, false, E.BAD_REQUEST)
		end
		host.handle.profile.progress.friendMarks["N" .. host.day] = choiceId
		host.handle.dirty = true
		coopCue(host, { kind = "NOTE", choiceId = choiceId })
		return result(session, requestId, true, E.OK)
	end
	return result(session, requestId, false, E.BAD_REQUEST)
end

return CoopService
]]></string>
