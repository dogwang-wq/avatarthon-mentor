        </Properties>
        <Item class="ModuleScript" referent="6211">
          <Properties>
            <string name="Name">BoatService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{B69D9DA8-10A8-40C8-83ED-8B6AF5EEC1C5}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 유보트(IBS, Zodiac FC470 계열 17×7 stud) 모델 생성·모드(물/주차/뒤집기/숨김)·놓기·자세·꾸밈(짐·노·깃발·스티커).
-- 주차·뒤집기는 서버가 CFrame 으로 놓는다. 급류·바다(RIDE)에서는 RideService 가 Root 를 풀어 물리 배로 쓴다 (선체 Weld).
-- 외형: 기본 Part 선체(자체 제작)가 판정·자리(Seat_ Attachment)·노 자세의 기준이고, 메시 라이브러리(ServerStorage.CampAssets)가 있으면
-- 마감 패스(2026-10-21)부터 그 위에 AI 생성 메시를 입힌다 — 선체 BoatHull_IBS(7.4×2.3×17.4 로 늘림)·노 OarLong·짐 Jerrycan/FirstAidBox/Crate.
-- 메시를 입히면 기본 선체 파트는 투명(속성 BoatHidden, setMode 가 되살리지 않음)이고 충돌·자리·무게는 그대로다. 라이브러리가 없으면 기본 Part 그대로.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Palette = require(Shared:WaitForChild("Palette"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
-- 절대 경로: Edit 명령창에서 :Clone() 으로 읽어도(script.Parent 없음) 찾도록
local AssetLibrary = require(
	game:GetService("ServerScriptService"):WaitForChild("Server"):WaitForChild("Services"):WaitForChild("AssetLibrary")
)

local BoatService = {}

export type Mode = "WATER" | "PARK" | "FLIP" | "HIDDEN"

export type BoatHandle = {
	userId: number,
	model: Model,
	root: Part,
	mode: Mode,
	anchors: { [string]: Attachment }, -- 자리 (FL/FR/BL/BR)
	stickerSlots: { Attachment },
	oars: { [string]: Part },
	welds: { [Instance]: WeldConstraint },
	-- 선체 파트의 Root 기준 자리 (2026-10-20 플레이테스트: 붙은 캐릭터가 CFrame 으로 옮겨지면 Root 만 끌려가 선체가 남았다 → 매 place 마다 이 자리로 맞춘다)
	hull: { [BasePart]: CFrame },
	tiltZ: number, -- 물 위 옆 기울기 (WATER)
	flame: Part?,
	-- 마감 패스: 메시 외형 (라이브러리가 있을 때만)
	meshHull: boolean, -- 선체 메시(BoatHull_IBS)를 입혔나 — 짐 자리·명찰·스티커 자리가 메시 모양에 맞춰진다
	oarMesh: { [string]: BasePart }, -- 자리 키 → 노 메시 (기본 노 Part 를 따라간다)
	oarMeshOff: { [string]: CFrame },
}

local SIZE = GameConfig.Boat.Size -- X 폭 7 · Y 2.4 · Z 길이 17 (IBS 1.9 × 4.7 m)
local HALF_L = SIZE.Z / 2 -- 8.5
local HALF_W = SIZE.X / 2 -- 3.5
local TUBE_R = 0.9 -- 튜브 반지름 (실물 지름 약 0.5 m)
local TUBE_X = HALF_W - TUBE_R -- 2.6: 튜브 중심

-- 자리 좌표 (앞 = -Z, 왼 = -X). IBS 는 튜브 위에 걸터앉는다
local SEAT_LOCAL = {
	FL = Vector3.new(-TUBE_X, TUBE_R + 1.2, -1.5),
	FR = Vector3.new(TUBE_X, TUBE_R + 1.2, -1.5),
	BL = Vector3.new(-TUBE_X, TUBE_R + 1.2, 4.0),
	BR = Vector3.new(TUBE_X, TUBE_R + 1.2, 4.0),
}

-- 선체 메시 (마감 패스): 생성 메시는 폭:길이 1:1.6 이라 IBS 비율로 늘린다(MeshPart.Size 직접). 바닥이 Root 아래 0.65(땅·수면에 닿게)
local SHELL_SIZE = Vector3.new(7.4, 2.3, 17.4)
local SHELL_Y = 0.5
local SHELL_SIDE_X = 3.76 -- 메시 튜브 바깥면 (명찰·스티커 자리)
-- 메시를 입히면 숨기는 기본 선체 파트 (Root 는 숨겨도 판정·물리 기준 그대로)
local SHELL_HIDE: { [string]: boolean } = {
	Root = true,
	Keel = true,
	Nose = true,
	BowBoard = true,
	Transom = true,
	MotorPad = true,
	TubeL = true,
	TubeR = true,
	BowL = true,
	BowR = true,
	TubeCapL = true,
	TubeCapR = true,
	LifelineL = true,
	LifelineR = true,
	Handle = true,
	Plate = true,
}
-- 노 메시: 긴 축(모델 X, 날 +X)을 기본 노의 +Z(날 쪽)로, 날 너비(모델 Y)는 눕혀서 노의 X 로
local OAR_ROT = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 0, 1), Vector3.new(1, 0, 0))
local OAR_BLADE_W = { LONG = 1.25, SHORT = 0.95 } :: { [string]: number }

local function part(props: { [string]: any }, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- 노 메시 (마감 패스): 기본 노 Part(자세·길이 기준)를 숨기고 그 자리에 OarLong 메시를 길이에 맞춰 놓는다.
-- 노 길이가 바뀌면(긴 노·짧은 노) 다시 만든다. 라이브러리가 없으면 아무것도 안 함(기본 노가 보인다)
local function refreshOarMesh(h: BoatHandle, key: string, oarId: string?)
	local oar = h.oars[key]
	if not oar or not oar.Parent then
		return
	end
	local len = oar.Size.Z
	local old = h.oarMesh[key]
	local oldLen = if old then old:GetAttribute("OarLen") else nil
	if old and old.Parent and typeof(oldLen) == "number" and math.abs(oldLen - len) < 0.01 then
		return
	end
	local id = oarId or tostring(h.model:GetAttribute("Oar") or "")
	local off = CFrame.new(0, 0, len * 0.06) * OAR_ROT
	local m = AssetLibrary.cloneFit("OarLong", oar.CFrame * off, Vector3.new(len * 1.12, OAR_BLADE_W[id] or 1.1, 0.28))
	if not m then
		return
	end
	if old then
		h.hull[old] = nil
		old:Destroy()
	end
	local mesh: BasePart? = nil
	for _, p in ipairs(AssetLibrary.parts(m)) do
		p.Name = "OarMesh_" .. key
		p:SetAttribute("OarLen", len)
		p.CastShadow = true
		p.Transparency = if h.mode == "HIDDEN" then 1 else 0
		p.Parent = h.model
		if not h.root.Anchored then
			-- 물리 유보트(RideService) 중이면 Root 에 붙여 같이 간다
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = h.root
			w.Part1 = p
			w.Parent = p
		end
		h.hull[p] = h.root.CFrame:ToObjectSpace(p.CFrame)
		mesh = p
		break
	end
	m:Destroy()
	if not mesh then
		return
	end
	h.oarMesh[key] = mesh
	h.oarMeshOff[key] = oar.CFrame:ToObjectSpace(mesh.CFrame)
	local blade = h.model:FindFirstChild("Blade_" .. key)
	for _, p in ipairs({ oar, blade } :: { Instance? }) do
		if p and p:IsA("BasePart") then
			p.Transparency = 1
			p.CastShadow = false
			p:SetAttribute("BoatHidden", true)
		end
	end
end

local function build(userId: number, labelKo: string): BoatHandle
	local folder = SceneBindings.ensureRuntimeFolder()
	local model = Instance.new("Model")
	model.Name = "Boat_" .. userId
	model:SetAttribute("OwnerUserId", userId)
	model:SetAttribute("ProjectId", SceneBindings.ProjectId)

	-- 바닥(Root): 튜브 사이 알루미늄 바닥판. 피벗 기준
	local root = part({
		Name = "Root",
		Size = Vector3.new(TUBE_X * 2 - 0.4, 0.4, SIZE.Z - 4),
		Color = Color3.fromHex("6B6F73"),
		Material = Enum.Material.DiamondPlate,
	}, model)
	model.PrimaryPart = root
	-- 선체 메시 (마감 패스, 라이브러리가 있으면): 기본 선체는 아래 끝에서 숨기고 판정·자리 기준으로만 쓴다
	local shellModel = AssetLibrary.cloneFit("BoatHull_IBS", root.CFrame * CFrame.new(0, SHELL_Y, 0), SHELL_SIZE)
	local meshHull = false
	if shellModel then
		for _, p in ipairs(AssetLibrary.parts(shellModel)) do
			p.Name = "Shell"
			p.CastShadow = true
			p.Parent = model
			meshHull = true
		end
		shellModel:Destroy()
	end
	-- 바닥 가로 널 6 (알루미늄 스트링거)
	for i = 1, 6 do
		part({
			Name = "Slat" .. i,
			Size = Vector3.new(TUBE_X * 2 - 0.6, 0.12, 0.5),
			CFrame = root.CFrame * CFrame.new(0, 0.26, -4.5 + (i - 1) * 2.0),
			Color = Color3.fromHex("8A8F94"),
			Material = Enum.Material.Metal,
		}, model)
	end
	-- 용골 띠 (바닥 아래 가운데)
	part({
		Name = "Keel",
		Size = Vector3.new(0.5, 0.3, SIZE.Z - 5),
		CFrame = root.CFrame * CFrame.new(0, -0.3, 0.3),
		Color = Palette.Rubber,
		Material = Enum.Material.Rubber,
	}, model)

	-- 좌우 튜브: 뒤쪽 직선부(길이 11) + 앞으로 모이는 사선부(길이 4.6, 살짝 들림) + 앞코
	local straightLen = 11
	local straightZ = HALF_L - 2 - straightLen / 2 -- 뒤쪽 끝 z = HALF_L-2 (선미판 앞), 중심 z = 1
	for _, sx in ipairs({ -1, 1 }) do
		local side = if sx < 0 then "L" else "R"
		part({
			Name = "Tube" .. side,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(straightLen, TUBE_R * 2, TUBE_R * 2),
			CFrame = root.CFrame * CFrame.new(sx * TUBE_X, TUBE_R, straightZ) * CFrame.Angles(0, math.rad(90), 0),
			Color = Palette.Rubber,
			Material = Enum.Material.Rubber,
		}, model)
		-- 사선부: 직선부 앞끝(z = straightZ - 5.5)에서 앞코(x ≈ ±0.8, z = -HALF_L + 0.8)로
		local a = Vector3.new(sx * TUBE_X, TUBE_R, straightZ - straightLen / 2)
		local b = Vector3.new(sx * 0.8, TUBE_R + 0.7, -HALF_L + 1.2)
		local mid = (a + b) / 2
		part({
			Name = "Bow" .. side,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new((b - a).Magnitude + 0.6, TUBE_R * 2, TUBE_R * 2),
			CFrame = root.CFrame * CFrame.lookAt(mid, mid + (b - a).Unit) * CFrame.Angles(0, math.rad(90), 0),
			Color = Palette.Rubber,
			Material = Enum.Material.Rubber,
		}, model)
		-- 튜브 끝 둥글게 (뒤)
		part({
			Name = "TubeCap" .. side,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(TUBE_R * 2, TUBE_R * 2, TUBE_R * 2),
			CFrame = root.CFrame * CFrame.new(sx * TUBE_X, TUBE_R, straightZ + straightLen / 2),
			Color = Palette.Rubber,
			Material = Enum.Material.Rubber,
		}, model)
		-- 생명줄(튜브 바깥 밧줄) + 손잡이 4
		part({
			Name = "Lifeline" .. side,
			Size = Vector3.new(0.12, 0.12, straightLen - 1),
			CFrame = root.CFrame * CFrame.new(sx * (TUBE_X + TUBE_R + 0.05), TUBE_R + 0.35, straightZ),
			Color = Palette.Rope,
			Material = Enum.Material.Fabric,
		}, model)
		for i = 1, 4 do
			part({
				Name = "Handle",
				Size = Vector3.new(0.25, 0.4, 1.1),
				CFrame = root.CFrame
					* CFrame.new(sx * (TUBE_X + TUBE_R + 0.12), TUBE_R - 0.1, straightZ - 4 + (i - 1) * 2.7),
				Color = Palette.Ink,
				Material = Enum.Material.Fabric,
			}, model)
		end
		-- 선체 번호 (흰 글자 "1", 뒤쪽 튜브 바깥면). 글자는 클라이언트 SurfaceGui
		part({
			Name = "Plate",
			Size = Vector3.new(1.6, 1.1, 0.08), -- 앞면이 바깥, 얇은 축 Z
			CFrame = root.CFrame
				* CFrame.new(sx * (TUBE_X + TUBE_R + 0.02), TUBE_R + 0.05, 4.8)
				* CFrame.Angles(0, math.rad(if sx < 0 then 90 else -90), 0),
			Color = Palette.Rubber,
			Material = Enum.Material.SmoothPlastic,
		}, model):SetAttribute("SignText", "1")
	end
	-- 앞코: 두 사선 튜브가 만나는 둥근 코 + 추진판(합판)
	part({
		Name = "Nose",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.4, TUBE_R * 2 + 0.2, 2.2),
		CFrame = root.CFrame * CFrame.new(0, TUBE_R + 0.75, -HALF_L + 1.1),
		Color = Palette.Rubber,
		Material = Enum.Material.Rubber,
	}, model)
	part({
		Name = "BowBoard",
		Size = Vector3.new(2.2, 0.15, 2.6),
		CFrame = root.CFrame * CFrame.new(0, 0.9, -HALF_L + 3.0) * CFrame.Angles(math.rad(18), 0, 0),
		Color = Palette.Wood,
		Material = Enum.Material.WoodPlanks,
	}, model)
	-- 선미판(트랜섬) + 모터판
	part({
		Name = "Transom",
		Size = Vector3.new(TUBE_X * 2 - 0.2, 1.5, 0.5),
		CFrame = root.CFrame * CFrame.new(0, 0.75, HALF_L - 1.8),
		Color = Color3.fromHex("3A3D40"), -- 실물 트랜섬은 어두운 회색 (7차 캡처: 나무색이 너무 튐)
		Material = Enum.Material.Metal,
	}, model)
	part({
		Name = "MotorPad",
		Size = Vector3.new(1.4, 1.0, 0.2),
		CFrame = root.CFrame * CFrame.new(0, 1.2, HALF_L - 1.5),
		Color = Palette.Stone,
		Material = Enum.Material.Metal,
	}, model)
	-- 옆구리 명찰(소대·이름): 선미 쪽 튜브 위 노란 판 양쪽
	for _, sx in ipairs({ -1, 1 }) do
		part({
			Name = "NamePlate",
			Size = Vector3.new(2.6, 0.7, 0.12), -- 앞면(−Z)이 바깥: 얇은 축은 Z (전엔 X 가 얇아 날개처럼 옆으로 튀어나왔다)
			CFrame = root.CFrame * CFrame.new(
				sx * (if meshHull then SHELL_SIDE_X else TUBE_X + TUBE_R + 0.02),
				if meshHull then 0.5 else TUBE_R + 0.2,
				if meshHull then 2.2 else 1.5
			) * CFrame.Angles(0, math.rad(if sx < 0 then 90 else -90), 0),
			Color = Palette.Yellow,
			Material = Enum.Material.SmoothPlastic,
		}, model):SetAttribute("SignText", labelKo)
	end
	-- 노 4 (나무 자루 + 날): 주차 때 튜브 위에 눕고, 물에서는 밖으로 기운다
	local oars: { [string]: Part } = {}
	for key, local3 in pairs(SEAT_LOCAL) do
		local sx = if SquadCatalog.isLeft(key) then -1 else 1
		local oar = part({
			Name = "Oar_" .. key,
			Size = Vector3.new(0.22, 0.22, 5.6),
			CFrame = root.CFrame * CFrame.new(sx * (TUBE_X - 0.5), TUBE_R * 2 + 0.15, local3.Z),
			Color = Palette.Wood,
			Material = Enum.Material.Wood,
		}, model)
		part({
			Name = "Blade_" .. key,
			Size = Vector3.new(0.12, 1.1, 1.7),
			CFrame = oar.CFrame * CFrame.new(0, 0, 2.8),
			Color = Palette.Ink,
			Material = Enum.Material.SmoothPlastic,
		}, model)
		oars[key] = oar
	end
	-- 앵커: 자리·스티커
	local anchors: { [string]: Attachment } = {}
	for key, v in pairs(SEAT_LOCAL) do
		local a = Instance.new("Attachment")
		a.Name = "Seat_" .. key
		a.Position = v
		a.Parent = root
		anchors[key] = a
	end
	local stickerSlots: { Attachment } = {}
	for i = 1, 10 do
		local s = Instance.new("Attachment")
		s.Name = "Sticker" .. i
		local row = if i <= 5 then 0 else 1
		local col = (i - 1) % 5
		s.Position = if meshHull
			then Vector3.new(-(SHELL_SIDE_X + 0.05), 0.85 - row * 0.62, -4.4 + col * 1.15) -- 명찰(z 0.9~3.5) 앞쪽
			else Vector3.new(-(TUBE_X + TUBE_R + 0.06), TUBE_R + 0.55 - row * 0.7, -3.5 + col * 1.6)
		-- 얇은 축 X 를 바깥(왼쪽 −X)으로: SquadPresence 가 Left 면에 이모지를 그린다 (전에는 90° 돌아가 지느러미처럼 튀어나왔다)
		s.Orientation = Vector3.zero
		s.Parent = root
		table.insert(stickerSlots, s)
	end
	-- 메시를 입혔으면 기본 선체를 숨긴다 (BoatHidden: setMode 가 되살리지 않는다. 충돌·판정은 원래도 Root·RideDeck 이 한다)
	if meshHull then
		for _, d in ipairs(model:GetChildren()) do
			if d:IsA("BasePart") and (SHELL_HIDE[d.Name] or string.match(d.Name, "^Slat%d") ~= nil) then
				d.Transparency = 1
				d.CastShadow = false
				d:SetAttribute("BoatHidden", true)
				if d.Name == "Plate" then
					d:SetAttribute("SignText", nil) -- 선체 번호 "1" 은 메시 위에 뜨므로 뺀다
				end
			end
		end
	end
	local oarMesh: { [string]: BasePart } = {}
	local oarMeshOff: { [string]: CFrame } = {}
	-- 선체 자리 기록: Root 가 혼자 움직여도(WeldConstraint 조립체 끌림·리스폰) place() 가 되돌린다
	local hull: { [BasePart]: CFrame } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			hull[d] = root.CFrame:ToObjectSpace(d.CFrame)
		end
	end
	model.Parent = folder
	local h: BoatHandle = {
		userId = userId,
		model = model,
		root = root,
		hull = hull,
		mode = "PARK",
		anchors = anchors,
		stickerSlots = stickerSlots,
		oars = oars,
		welds = {},
		tiltZ = 0,
		flame = nil,
		meshHull = meshHull,
		oarMesh = oarMesh,
		oarMeshOff = oarMeshOff,
	}
	for key in pairs(oars) do
		refreshOarMesh(h, key, nil)
	end
	return h
end

function BoatService.create(userId: number, labelKo: string): BoatHandle
	return build(userId, labelKo)
end

function BoatService.destroy(h: BoatHandle)
	for inst, w in pairs(h.welds) do
		w:Destroy()
		h.welds[inst] = nil
	end
	h.model:Destroy()
end

-- 유보트를 통째로 옮긴다. 모델 PivotTo 대신 Root 를 놓고 선체 파트를 기록된 자리로 하나씩 맞춘다:
-- 붙어 있는 캐릭터·리그가 CFrame 으로 옮겨지면 Roblox 가 조립체(WeldConstraint)의 Root 까지 끌고 가 선체만 남았고,
-- 그 뒤 PivotTo 는 어긋난 간격을 그대로 유지했다 (2026-10-20 플레이테스트: 선체가 z=+1279 에, Root 만 CP6)
function BoatService.pivot(h: BoatHandle, cf: CFrame)
	h.root.CFrame = cf
	for p, off in pairs(h.hull) do
		if p.Parent then
			p.CFrame = cf * off
		else
			h.hull[p] = nil
		end
	end
end

-- 선체가 Root 에서 얼마나 벗어나 있나 (검증용: 0 에 가까워야 한다)
function BoatService.hullDrift(h: BoatHandle): number
	local worst = 0
	for p, off in pairs(h.hull) do
		if p.Parent then
			worst = math.max(worst, ((h.root.CFrame * off).Position - p.Position).Magnitude)
		end
	end
	return worst
end

-- ===== 모드 =====
function BoatService.setMode(h: BoatHandle, mode: Mode)
	if h.mode == mode then
		return
	end
	h.mode = mode
	h.model:SetAttribute("Mode", mode)
	local visible = mode ~= "HIDDEN"
	for _, d in ipairs(h.model:GetDescendants()) do
		if d:IsA("BasePart") then
			-- 뱃머리 깃발(HideInFlip, 3단계)은 뒤집힌 유보트에서 땅을 뚫으므로 밤에는 숨긴다
			-- 메시를 입혀 숨긴 기본 선체·노(BoatHidden)는 늘 숨김
			d.Transparency = if visible
					and d:GetAttribute("BoatHidden") ~= true
					and not (mode == "FLIP" and d:GetAttribute("HideInFlip") == true)
				then 0
				else 1
		end
	end
	-- 노 자세: 물에서는 밖으로 45°, 아니면 눕힘
	for key, oar in pairs(h.oars) do
		local sx = if SquadCatalog.isLeft(key) then -1 else 1
		local base = h.root.CFrame * CFrame.new(sx * (TUBE_X - 0.5), TUBE_R * 2 + 0.15, SEAT_LOCAL[key].Z)
		local blade = h.model:FindFirstChild("Blade_" .. key) :: Part?
		if mode == "WATER" then
			oar.CFrame = base * CFrame.new(sx * 1.2, 0.3, 0) * CFrame.Angles(0, math.rad(sx * 70), math.rad(-sx * 35))
		else
			oar.CFrame = base
		end
		if blade then
			blade.CFrame = oar.CFrame * CFrame.new(0, 0, oar.Size.Z / 2) -- 노 끝 (기본 5.6 → 2.8, 긴 노·짧은 노는 applyLoadoutVisual)
			h.hull[blade] = h.root.CFrame:ToObjectSpace(blade.CFrame)
		end
		h.hull[oar] = h.root.CFrame:ToObjectSpace(oar.CFrame)
		local om = h.oarMesh[key]
		if om and om.Parent then
			om.CFrame = oar.CFrame * h.oarMeshOff[key]
			h.hull[om] = h.root.CFrame:ToObjectSpace(om.CFrame)
		end
	end
	-- 뒤집기 옆 불꽃(옛 밤 장면)은 마감 패스에 뺐다: 밤은 모닥불 허브(CampfireService, 생성기 FIRE)가 진짜 불이고,
	-- 유보트 옆 두 번째 불이 노을 빛에서 크게 번져 어느 불인지 헷갈렸다. 남아 있으면 지운다
	if h.flame then
		h.flame:Destroy()
		h.flame = nil
	end
end

-- 바닥 높이 찾기 (지형·파트). 못 찾으면 fallback
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
local function groundY(pos: Vector3, exclude: { Instance }, fallback: number): number
	rayParams.FilterDescendantsInstances = exclude
	local r = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rayParams)
	if r then
		return r.Position.Y
	end
	return fallback
end

-- 유보트를 한 점에 놓는다 (진행 방향 look). 모드에 따라 높이가 다르다. t 는 연출용 시간.
function BoatService.place(h: BoatHandle, pos: Vector3, look: Vector3, t: number?)
	local time_ = t or os.clock()
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	local exclude: { Instance } = { h.model }
	for ch in pairs(h.welds) do
		table.insert(exclude, ch)
	end
	local gy = groundY(pos, exclude, pos.Y)
	local y: number
	local tilt = CFrame.identity
	if h.mode == "WATER" then
		y = pos.Y + 0.4 + math.sin(time_ * 1.6) * 0.18
		tilt = CFrame.Angles(math.sin(time_ * 1.1) * 0.03, 0, math.sin(time_ * 1.4) * 0.05 + h.tiltZ)
	elseif h.mode == "FLIP" then
		y = gy + 2.4
		tilt = CFrame.Angles(0, 0, math.pi)
	else
		y = gy + 0.5
	end
	local cf = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + flat) * tilt
	BoatService.pivot(h, cf)
	if h.flame then
		h.flame.CFrame = CFrame.new(pos.X + flat.X * -5, gy + 0.9, pos.Z + flat.Z * -5)
	end
end

-- ===== 사람 붙이기 (플레이어 캐릭터·NPC 리그 공통) =====
local function hrpOf(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function BoatService.detach(h: BoatHandle, character: Model)
	local w = h.welds[character]
	if w then
		w:Destroy()
		h.welds[character] = nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
		hum.Sit = false
		-- 안전망: 어떤 길로든 0 으로 남은 걸음·점프를 되돌린다 (얼음 등 — 장면을 옮길 때마다 지나는 곳)
		if hum.JumpPower == 0 then
			hum.JumpPower = 50
		end
		if hum.WalkSpeed ~= 16 then
			hum.WalkSpeed = 16
		end
	end
	BoatService.pose(character, "NONE")
end

function BoatService.detachAll(h: BoatHandle)
	for character in pairs(h.welds) do
		if character:IsA("Model") then
			BoatService.detach(h, character)
		end
	end
end

-- 유보트 옆 땅에 내려 세운다 (유격·기지)
function BoatService.standBeside(h: BoatHandle, character: Model, index: number)
	local hrp = hrpOf(character)
	if not hrp then
		return
	end
	local right = h.root.CFrame.RightVector
	local back = -h.root.CFrame.LookVector
	-- 유보트 폭(노·손잡이 포함 약 ±9) 바깥에 세운다. 6 이면 뒤집힌 유보트 위에 올라선다 (Studio 2026-10-18)
	local base = h.root.Position + right * 13 + back * (index - 2.5) * 2.5 -- 유보트 폭 ±9.8 (노 포함) 바깥
	local gy = groundY(base, { h.model, character }, base.Y)
	-- 유보트를 보고 선다 (2026-10-19 첫 화면: 등지고 서서 카메라가 유보트 안에 박혔다)
	local center = h.root.Position
	local cf = CFrame.lookAt(Vector3.new(base.X, gy + 3.2, base.Z), Vector3.new(center.X, gy + 3.2, center.Z))
	character:PivotTo(cf)
	-- Weld 를 풀자마자 옮기면 클라이언트가 물리 소유권을 되찾으며 Weld 전 위치로 되돌린다 (Studio 2026-10-18: 0.5초 뒤 복귀 확인) → 잠시 다시 놓는다
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			task.wait(0.1)
			if not character.Parent then
				return
			end
			if (character:GetPivot().Position - cf.Position).Magnitude > 3 then
				character:PivotTo(cf)
			end
		end
	end)
end

-- ===== 자세 (내밀기·넣기·끌어올리기 손짓) =====
-- R15 어깨 Motor6D 의 C0 만 돌린다 (애니메이션 Transform 위에 더해짐). 애니메이션 자산을 새로 쓰지 않는다.
-- READY·READY2: 팔을 앞으로 내밂(내밀기·장작 넣기·그림) · LIFT: 번쩍 든 뒤 내려옴(끌어올리기) · CHEER: 번쩍 · NONE: 원래대로
local TweenService = game:GetService("TweenService")
-- 관절이 둘 중 하나다: 옛 R15 Motor6D(C0) · 아바타 관절 업그레이드 리그(AnimationConstraint — 이 place 의 분대원·내 캐릭터).
-- 업그레이드 리그는 Part0 쪽 Attachment0.CFrame 이 C0 구실이라 그것을 돌린다 (RideCrew 와 같은 길).
-- 배 위(RideSeat)에서는 RideCrew 가 매 프레임 어깨를 덮어쓰므로, 같은 각도를 리그 속성 PoseArm(도)으로도 알려 준다.
local baseC0: { [Instance]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local poseSeq: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local ARM_ANGLE = { CHEER = 185, NONE = 0, READY = 150, READY2 = 140, LIFT = 192 }

-- 돌릴 것과 그 속성 이름: Motor6D → "C0", Attachment → "CFrame"
local function shoulders(character: Model): { { j: Instance, prop: string } }
	local out = {}
	for _, n in ipairs({ "RightShoulder", "LeftShoulder" }) do
		local arm = character:FindFirstChild(if n == "RightShoulder" then "RightUpperArm" else "LeftUpperArm")
		local m = arm and arm:FindFirstChild(n)
		if not m then
			-- 관절이 다른 곳에 있는 리그 (업그레이드 리그는 몸통 쪽에 둘 수 있다)
			for _, d in ipairs(character:GetDescendants()) do
				if d.Name == n and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) then
					m = d
					break
				end
			end
		end
		if m and m:IsA("Motor6D") then
			table.insert(out, { j = m, prop = "C0" })
		elseif m and m:IsA("AnimationConstraint") and m.Attachment0 then
			table.insert(out, { j = m.Attachment0 :: Attachment, prop = "CFrame" })
		end
	end
	return out
end

function BoatService.pose(character: Model, kind: string)
	local deg = ARM_ANGLE[kind] or 0
	local seq = (poseSeq[character] or 0) + 1
	poseSeq[character] = seq
	local flash = kind == "CHEER" or kind == "LIFT"
	character:SetAttribute("PoseArm", deg)
	if flash then
		task.delay(if kind == "LIFT" then 0.55 else 0.45, function()
			if poseSeq[character] == seq and character.Parent then
				character:SetAttribute("PoseArm", 0)
			end
		end)
	end
	for _, s in ipairs(shoulders(character)) do
		local m, prop = s.j, s.prop
		local base = baseC0[m]
		if not base then
			base = (m :: any)[prop] :: CFrame
			baseC0[m] = base
		end
		local goal = (base :: CFrame) * CFrame.Angles(math.rad(deg), 0, 0)
		if flash then
			TweenService
				:Create(
					m,
					TweenInfo.new(if kind == "LIFT" then 0.1 else 0.18, Enum.EasingStyle.Back),
					{ [prop] = goal }
				)
				:Play()
			task.delay(if kind == "LIFT" then 0.55 else 0.45, function()
				-- 번쩍 뒤에는 팔을 내린다 (그 사이 다른 자세가 오면 그것을 따른다)
				if m.Parent and poseSeq[character] == seq then
					TweenService:Create(m, TweenInfo.new(0.3), { [prop] = (baseC0[m] or base) :: CFrame }):Play()
				end
			end)
		else
			TweenService:Create(m, TweenInfo.new(0.35), { [prop] = goal }):Play()
		end
	end
end

-- ===== 스티커 (유보트 흔적) =====
function BoatService.setStickers(h: BoatHandle, ids: { string })
	local holder = h.model:FindFirstChild("Stickers")
	if not holder then
		holder = Instance.new("Folder")
		holder.Name = "Stickers"
		holder.Parent = h.model
	end
	local existing: { [string]: boolean } = {}
	for _, c in ipairs(holder:GetChildren()) do
		existing[c.Name] = true
	end
	for i, id in ipairs(ids) do
		if i > #h.stickerSlots or existing[id] then
			continue
		end
		local meta = CampScript.Stickers[id]
		local s = part({
			Name = id,
			Size = Vector3.new(0.1, 0.9, 0.9),
			Color = Palette.Cream,
			Material = Enum.Material.SmoothPlastic,
		}, holder)
		s:SetAttribute("StickerEmoji", if meta then meta.emoji else "⭐")
		s:SetAttribute("StickerSlot", i)
		-- 앵커 상태로 둔다. Weld 로 묶은 뒤 CFrame 을 주면 어셈블리(Root)가 끌려가 유보트가 튄다 (Studio 2026-10-18)
		s.CFrame = h.stickerSlots[i].WorldCFrame
		h.hull[s] = h.root.CFrame:ToObjectSpace(s.CFrame) -- 선체와 같이 맞춰진다 (pivot)
	end
end

-- 스티커는 유보트 모델의 앵커된 파트이므로 PivotTo 가 함께 옮긴다. 여기서 갱신할 것은 없다.

-- ===== 배치 외형 (27 §3 1-A · 28, 3단계): 실은 짐·노 길이·뱃머리 깃발이 유보트에 보인다 =====
-- 꾸민 배는 5일 내내 기지에 그 모습 그대로 선다(규칙 ②·⑤). 배치가 바뀔 때마다·세션이 생길 때 부른다. 수치는 안 보여 준다 — 모양만.
local OAR_LEN = { LONG = 7.2, SHORT = 4.6 } :: { [string]: number }
local BLADE_SIZE = {
	LONG = Vector3.new(0.14, 1.35, 2.1),
	SHORT = Vector3.new(0.12, 0.95, 1.35),
} :: { [string]: Vector3 }
-- 짐 자리: 바닥 가운데 줄, 앞자리(−1.5)·뒷자리(4.0) 사이와 앞·뒤 끝 (사람은 튜브 위 ±2.6 에 앉으니 겹치지 않는다)
local FLOOR_Y = 0.32
local CARGO_SLOTS = { Vector3.new(0, FLOOR_Y, 1.2), Vector3.new(0, FLOOR_Y, -3.6), Vector3.new(0, FLOOR_Y, 5.6) }
-- 선체 메시: 가로판(좌석) 둘이 z ≈ ±4 에 있어 짐은 그 사이 바닥에 (위에서 잰 메시 바닥 −5.8..5.8)
local CARGO_SLOTS_MESH = { Vector3.new(0, FLOOR_Y, 0.2), Vector3.new(0, FLOOR_Y, -2.2), Vector3.new(0, FLOOR_Y, 2.5) }
-- 짐 메시 (모델 축 상자 크기, 밑면이 짐 자리 바닥). SNACK 은 상자만 메시 — 주먹밥은 기본 파트로 위에 얹는다
local CARGO_MESH = {
	WATER = { key = "Jerrycan", size = Vector3.new(0.8, 1.25, 0.74) },
	AID = { key = "FirstAidBox", size = Vector3.new(1.2, 1.07, 0.8) },
	SNACK = { key = "Crate", size = Vector3.new(1.1, 0.62, 0.9) },
} :: { [string]: { key: string, size: Vector3 } }
local function cargoSlots(h: BoatHandle): { Vector3 }
	return if h.meshHull then CARGO_SLOTS_MESH else CARGO_SLOTS
end
type VisualPart = { name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType? }
local function cargoLook(id: string): { VisualPart }
	if id == "WATER" then
		-- 올리브 물통 (손잡이·뚜껑)
		return {
			{
				name = "Can",
				size = Vector3.new(0.75, 1.25, 1.0),
				cf = CFrame.new(0, 0.63, 0),
				color = Palette.OliveDark,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Cap",
				size = Vector3.new(0.3, 0.2, 0.3),
				cf = CFrame.new(0, 1.33, 0.28),
				color = Palette.Ink,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Handle",
				size = Vector3.new(0.16, 0.16, 0.55),
				cf = CFrame.new(0, 1.33, -0.18),
				color = Palette.Ink,
				mat = Enum.Material.SmoothPlastic,
			},
		}
	elseif id == "AID" then
		-- 크림 상자 + 올리브 띠 (붉은 십자 같은 표식 없음)
		return {
			{
				name = "Box",
				size = Vector3.new(1.2, 0.75, 0.9),
				cf = CFrame.new(0, 0.38, 0),
				color = Palette.Cream,
				mat = Enum.Material.SmoothPlastic,
			},
			{
				name = "Band",
				size = Vector3.new(1.24, 0.18, 0.94),
				cf = CFrame.new(0, 0.42, 0),
				color = Palette.Olive,
				mat = Enum.Material.Fabric,
			},
			{
				name = "Latch",
				size = Vector3.new(0.3, 0.16, 0.06),
				cf = CFrame.new(0, 0.6, -0.47),
				color = Palette.Ink,
				mat = Enum.Material.SmoothPlastic,
			},
		}
	elseif id == "SNACK" then
		-- 나무 상자 + 주먹밥 둘
		return {
			{
				name = "Crate",
				size = Vector3.new(1.1, 0.55, 0.9),
				cf = CFrame.new(0, 0.28, 0),
				color = Palette.Wood,
				mat = Enum.Material.WoodPlanks,
			},
			{
				name = "Ball1",
				size = Vector3.new(0.48, 0.46, 0.48),
				cf = CFrame.new(-0.24, 0.72, 0),
				color = Palette.Cream,
				mat = Enum.Material.SmoothPlastic,
				shape = Enum.PartType.Ball,
			},
			{
				name = "Ball2",
				size = Vector3.new(0.48, 0.46, 0.48),
				cf = CFrame.new(0.26, 0.7, 0.1),
				color = Palette.Cream,
				mat = Enum.Material.SmoothPlastic,
				shape = Enum.PartType.Ball,
			},
			{
				name = "Nori",
				size = Vector3.new(0.22, 0.24, 0.5),
				cf = CFrame.new(-0.24, 0.64, 0),
				color = Palette.Ink,
				mat = Enum.Material.Fabric,
			},
		}
	end
	return {}
end

local function addVisual(h: BoatHandle, holder: Instance, name: string, v: VisualPart, at: CFrame): Part
	local off = at * v.cf
	local p = part({
		Name = name .. "_" .. v.name,
		Size = v.size,
		CFrame = h.root.CFrame * off,
		Color = v.color,
		Material = v.mat,
	}, holder)
	if v.shape then
		p.Shape = v.shape
	end
	if h.mode == "HIDDEN" then
		p.Transparency = 1
	end
	if not h.root.Anchored then
		-- 물리 유보트(급류·바다 RideService) 중이면 Root 에 붙여 같이 간다
		p.Anchored = false
		p.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = h.root
		w.Part1 = p
		w.Parent = p
	end
	h.hull[p] = off
	return p
end

local function clearHolder(h: BoatHandle, holder: Instance)
	for _, c in ipairs(holder:GetChildren()) do
		if c:IsA("BasePart") then
			h.hull[c] = nil
		end
		c:Destroy()
	end
end

-- 노 길이: 긴 노 7.2(날 큼) · 짧은 노 4.6(날 작음). 자세(눕힘/물)는 setMode 가 그대로 정한다
function BoatService.setOarVisual(h: BoatHandle, oarId: string)
	local len = OAR_LEN[oarId] or 5.6
	local bladeSize = BLADE_SIZE[oarId] or Vector3.new(0.12, 1.1, 1.7)
	for key, oar in pairs(h.oars) do
		if oar.Parent and math.abs(oar.Size.Z - len) > 0.01 then
			oar.Size = Vector3.new(oar.Size.X, oar.Size.Y, len)
			local blade = h.model:FindFirstChild("Blade_" .. key)
			if blade and blade:IsA("BasePart") then
				blade.Size = bladeSize
				blade.CFrame = oar.CFrame * CFrame.new(0, 0, len / 2)
				h.hull[blade] = h.root.CFrame:ToObjectSpace(blade.CFrame)
			end
		end
	end
	h.model:SetAttribute("Oar", oarId)
	for key in pairs(h.oars) do
		refreshOarMesh(h, key, oarId)
	end
end

-- 뱃머리 깃발: 추진판 위 기둥 + 빨간 천 "한 배" (뒤로 날린다). 뒤집힌 밤엔 숨긴다(HideInFlip)
function BoatService.setFlag(h: BoatHandle, on: boolean)
	local holder = h.model:FindFirstChild("BowFlag")
	if not on then
		if holder then
			clearHolder(h, holder)
			holder:Destroy()
		end
		return
	end
	if holder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "BowFlag"
	f.Parent = h.model
	local base = CFrame.new(0, 1.0, -HALF_L + 3.0)
	local pole = addVisual(h, f, "BowFlag", {
		name = "Pole",
		size = Vector3.new(0.14, 3.0, 0.14),
		cf = CFrame.new(0, 1.5, 0),
		color = Palette.WoodDark,
		mat = Enum.Material.Wood,
	}, base)
	local cloth = addVisual(h, f, "BowFlag", {
		name = "Cloth",
		size = Vector3.new(1.6, 0.95, 0.06),
		cf = CFrame.new(0, 2.5, 0.85) * CFrame.Angles(0, math.rad(90), 0),
		color = Palette.Red,
		mat = Enum.Material.Fabric,
	}, base)
	cloth:SetAttribute("SignText", "한 배")
	cloth:SetAttribute("SignLight", true)
	cloth:SetAttribute("SignBothSides", true)
	for _, p in ipairs({ pole, cloth }) do
		p:SetAttribute("HideInFlip", true)
		if h.mode == "FLIP" then
			p.Transparency = 1
		end
	end
end

-- 짐 메시 하나 (마감 패스): at = Root 기준 짐 자리(밑면). 라이브러리가 없으면 false → 기본 파트 모양으로
local function addMeshVisual(
	h: BoatHandle,
	holder: Instance,
	name: string,
	key: string,
	size: Vector3,
	at: CFrame
): boolean
	local m = AssetLibrary.cloneFit(key, h.root.CFrame * at * CFrame.new(0, size.Y / 2, 0), size)
	if not m then
		return false
	end
	for _, p in ipairs(AssetLibrary.parts(m)) do
		p.Name = name .. "_Mesh"
		p.CastShadow = true
		p.Transparency = if h.mode == "HIDDEN" then 1 else 0
		p.Parent = holder
		if not h.root.Anchored then
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = h.root
			w.Part1 = p
			w.Parent = p
		end
		h.hull[p] = h.root.CFrame:ToObjectSpace(p.CFrame)
	end
	m:Destroy()
	return true
end

-- 짐 자리에 실은 짐 모양 (깃발은 짐 칸을 쓰지만 모양은 뱃머리에)
function BoatService.setCargoVisual(h: BoatHandle, cargo: { string })
	local holder = h.model:FindFirstChild("CargoVisual")
	if not holder then
		holder = Instance.new("Folder")
		holder.Name = "CargoVisual"
		holder.Parent = h.model
	end
	local sig = table.concat(cargo, ",")
	if holder:GetAttribute("Sig") ~= sig then
		clearHolder(h, holder)
		local slots = cargoSlots(h)
		local slot = 0
		for _, id in ipairs(cargo) do
			if id == "FLAG" then
				continue
			end
			slot += 1
			local at = slots[slot]
			if not at then
				break
			end
			local yaw = CFrame.Angles(0, math.rad((slot - 2) * 9), 0) -- 조금씩 비뚤게 (손으로 실은 느낌)
			local base = CFrame.new(at) * yaw
			local mesh = CARGO_MESH[id]
			local meshed = mesh ~= nil and addMeshVisual(h, holder, "Cargo" .. slot .. id, mesh.key, mesh.size, base)
			for _, v in ipairs(cargoLook(id)) do
				if meshed then
					-- 메시가 있으면 간식 주먹밥만 상자 위에 얹고 나머지 기본 파트는 뺀다
					if id ~= "SNACK" or v.name == "Crate" then
						continue
					end
					v = table.clone(v)
					v.cf = CFrame.new(0, (mesh :: any).size.Y - 0.55, 0) * v.cf -- 기본 상자 높이 0.55 → 메시 상자 높이
				end
				addVisual(h, holder, "Cargo" .. slot .. id, v, base)
			end
		end
		holder:SetAttribute("Sig", sig)
	end
	BoatService.setFlag(h, table.find(cargo, "FLAG") ~= nil)
end

function BoatService.applyLoadoutVisual(h: BoatHandle, loadout: { cargo: { string }, oar: string })
	BoatService.setOarVisual(h, loadout.oar)
	BoatService.setCargoVisual(h, loadout.cargo)
end

-- 실은 짐 n 번째 자리의 월드 위치 (붙이기 연출 ATTACH)
function BoatService.cargoSlotWorld(h: BoatHandle, index: number): Vector3
	local slots = cargoSlots(h)
	local at = slots[math.clamp(index, 1, #slots)]
	return (h.root.CFrame * CFrame.new(at + Vector3.new(0, 0.6, 0))).Position
end

return BoatService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
