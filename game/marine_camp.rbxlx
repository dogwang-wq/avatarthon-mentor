              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 분대원 노 젓기·몸짓 (급류 2차, 2026-10-21 — 27 §3 1-B · 28 §7 "급류 2차"): 전부 클라이언트 그림, 판정은 서버(RideService).
-- 서버는 리그 속성을 **바뀔 때만** 쓴다: RideSeat(갑판 위) · RideRow(노 젓는 중) · RideLean(−1/0/1 그쪽으로 몸을 실음) · RideDuck(가지 — 숙임).
-- 여기서 매 프레임 어깨·허리·골반 Motor6D C0 를 원래 C0(리그 속성 BaseC0 — SquadNpcService) 위에 흔들고, 손에 노를 든다
-- (유보트 노 메시 OarMesh_* 를 복제해 줄임, 라이브러리가 없으면 자루+날 기본 파트). 배에 꽂힌 노 4 는 타는 동안 내 화면에서만 숨긴다.
-- 한 번 젓기 RowStrokeSec(1.1초), 서버 시각 박자로 다 같이 (하나 둘). 노가 물을 칠 때 물방울 + 내 노만 첨벙 SFX_STROKE.
-- 앉아서 직접 젓기 (2026-10-21): 내 캐릭터도 같은 팔·노 — 내 입력(InputController.rideInput)으로 바로 젓고, 노 쪽은 서버가 준 RideSide.
-- 쿵·긁힘·파도(FxCue)엔 다 같이 휘청. 손짓(가리키기·환호·당기기) 동안 서버가 RideRow 를 끄면 팔은 애니메이션에 맡긴다.
-- 비용: 리그 셋 × C0 4 + 노 Weld 1 을 RenderStepped 에서 씀(로컬, 복제 없음). 프레임마다 인스턴스를 만들지 않는다(노·물방울 발사기는 탈 때 한 번).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local InputController = require(script.Parent.InputController)

local RideCrew = {}
local S = ProtocolTypes.SessionState
local _player = Players.LocalPlayer

local STROKE = GameConfig.Ride.RowStrokeSec or 1.1
local TAU = math.pi * 2
local MOTORS = { "RightShoulder", "LeftShoulder", "Waist", "Root" }
local TILT = math.rad(46) -- 노 자루가 밖으로 기운 각 (32° 는 날이 뱃전 위에 걸려 물에 안 닿았다 — Studio 21_r2 캡처)
local KNEEL = 0.7 -- 노 저을 땐 무릎을 굽혀 낮게 (선 채로는 노가 물에 안 닿는다)
local SWEEP = math.rad(30) -- 앞뒤로 젓는 폭

type Crew = {
	model: Model,
	motors: { [string]: Instance }, -- 관절 → 움직일 것: Motor6D(C0) 또는 AnimationConstraint 의 Attachment0(CFrame) — 아바타 관절 업그레이드 리그
	base: { [string]: CFrame },
	torso: BasePart?,
	paddle: BasePart?,
	paddleWeld: Weld?,
	paddleOff: CFrame, -- 노 틀(자루 = Z, 날 = +Z 끝, 가운데 원점) → 노 파트 CFrame
	paddleLen: number,
	phase: number,
	row: number,
	lean: number,
	duck: number,
	pose: number, -- 서버 손짓 자세(리그 속성 PoseArm, 도 → 라디안): 끌어올리기·환호 때 팔 번쩍 (BoatService.pose)
	side: number,
	wobbleAt: number,
	wobbleAmp: number,
	lastStroke: number,
	active: boolean,
	isMe: boolean, -- 내 캐릭터 (앉아서 직접 젓기): 내 입력으로 바로 젓고, 앉은 자세라 골반은 건드리지 않는다
	drops: ParticleEmitter?,
	dropAt: Attachment?,
}

local crews: { [Model]: Crew } = {}
local hiddenOars: { BasePart } = {}
local riding = false

local function reduced(): boolean
	return Net.setting("reducedMotion") == true
end

local function myBoat(): Model?
	local f = SceneBindings.getFolder("Runtime")
	local m = f and f:FindFirstChild("Boat_" .. Net.boatOwnerId())
	return if m and m:IsA("Model") then m else nil
end

local function mySquad(): Instance?
	local f = SceneBindings.getFolder("Runtime")
	local holder = f and f:FindFirstChild("CampSquads")
	return holder and holder:FindFirstChild("Squad_" .. Net.boatOwnerId())
end

local function playStroke(pos: Vector3)
	local ok, audio = pcall(function()
		return require(script.Parent.AudioController) :: any
	end)
	if ok and audio and typeof(audio.play) == "function" then
		audio.play("SFX_STROKE", pos)
	end
end

-- ===== 노 (유보트 노 메시를 줄여 손에) =====
local function buildPaddle(crew: Crew)
	local torso = crew.torso
	if not torso or crew.paddle then
		return
	end
	local boat = myBoat()
	local mesh: BasePart? = nil
	local oar: BasePart? = nil
	if boat then
		for _, d in ipairs(boat:GetChildren()) do
			if d:IsA("BasePart") and string.sub(d.Name, 1, 8) == "OarMesh_" then
				local o = boat:FindFirstChild("Oar_" .. string.sub(d.Name, 9))
				if o and o:IsA("BasePart") then
					mesh, oar = d, o
					break
				end
			end
		end
		if not oar then
			local o = boat:FindFirstChild("Oar_FL")
			oar = if o and o:IsA("BasePart") then o else nil
		end
	end
	local oarLen = if oar then oar.Size.Z else 5.6
	local len = math.clamp(oarLen * 0.75, 3.6, 5.2) -- 긴 노 7.2 → 5.2 · 짧은 노 4.6 → 3.6 (배치가 손에 보인다)
	local k = len / oarLen
	local paddle: BasePart
	local off = CFrame.identity
	if mesh and oar then
		local c = mesh:Clone()
		for _, d in ipairs(c:GetChildren()) do
			if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint") or d:IsA("Attachment") then
				d:Destroy()
			end
		end
		c.Size = mesh.Size * k
		local rel = oar.CFrame:ToObjectSpace(mesh.CFrame)
		off = CFrame.new(rel.Position * k) * rel.Rotation
		paddle = c
	else
		local shaft = Instance.new("Part")
		shaft.Size = Vector3.new(0.2, 0.2, len)
		shaft.Color = Palette.Wood
		shaft.Material = Enum.Material.Wood
		local blade = Instance.new("Part")
		blade.Name = "CampPaddleBlade"
		blade.Size = Vector3.new(0.12, 1.0, 1.4)
		blade.Color = Palette.Ink
		blade.Material = Enum.Material.SmoothPlastic
		blade.CanCollide = false
		blade.CanQuery = false
		blade.CanTouch = false
		blade.Massless = true
		blade.CFrame = shaft.CFrame * CFrame.new(0, 0, len / 2 - 0.5)
		local w = Instance.new("WeldConstraint")
		w.Part0 = shaft
		w.Part1 = blade
		w.Parent = blade
		blade.Parent = shaft
		paddle = shaft
	end
	paddle.Name = "CampPaddle"
	paddle.Anchored = false
	paddle.Massless = true
	paddle.CanCollide = false
	paddle.CanQuery = false
	paddle.CanTouch = false
	paddle.CastShadow = true
	paddle.Transparency = 0
	paddle.LocalTransparencyModifier = 0
	paddle:SetAttribute("BoatHidden", nil)
	local weld = Instance.new("Weld")
	weld.Name = "CampPaddleWeld"
	weld.Part0 = torso
	weld.Part1 = paddle
	weld.C1 = CFrame.identity
	weld.Parent = paddle
	paddle.Parent = crew.model
	crew.paddle = paddle
	crew.paddleWeld = weld
	crew.paddleOff = off
	crew.paddleLen = len
	-- 노 끝 물방울 (한 번 만든 발사기를 자리만 옮겨 쓴다)
	local att = Instance.new("Attachment")
	att.Name = "CampStrokeAt"
	att.Parent = workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.32), NumberSequenceKeypoint.new(1, 0.05) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.35, 0.6)
	e.Speed = NumberRange.new(5, 9)
	e.SpreadAngle = Vector2.new(35, 35)
	e.Acceleration = Vector3.new(0, -40, 0)
	e.EmissionDirection = Enum.NormalId.Top
	e.LightEmission = 0.3
	e.Rate = 0
	e.Parent = att
	crew.drops = e
	crew.dropAt = att
end

local function dropPaddle(crew: Crew)
	if crew.paddle then
		crew.paddle:Destroy()
		crew.paddle = nil
		crew.paddleWeld = nil
	end
	if crew.dropAt then
		crew.dropAt:Destroy()
		crew.dropAt = nil
		crew.drops = nil
	end
end

-- ===== 리그 =====
local function setJoint(j: Instance, cf: CFrame)
	if j:IsA("Motor6D") then
		j.C0 = cf
	elseif j:IsA("Attachment") then
		j.CFrame = cf
	end
end

local function crewOf(model: Model, index: number): Crew?
	local c = crews[model]
	if c then
		return c
	end
	local motors: { [string]: Instance } = {}
	local base: { [string]: CFrame } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if not table.find(MOTORS, d.Name) then
			continue
		end
		if d:IsA("Motor6D") then
			motors[d.Name] = d
			local b = d:GetAttribute("BaseC0")
			base[d.Name] = if typeof(b) == "CFrame" then b else d.C0
		elseif d:IsA("AnimationConstraint") and d.Attachment0 then
			-- 관절 업그레이드 리그(Studio 2026-10-21: 분대원 리그는 Motor6D 대신 AnimationConstraint): Part0 쪽 붙임점이 C0 와 같은 구실
			local a0 = d.Attachment0 :: Attachment
			motors[d.Name] = a0
			base[d.Name] = a0.CFrame
		end
	end
	if not motors.RightShoulder or not motors.Waist then
		return nil
	end
	local torso = model:FindFirstChild("UpperTorso")
	c = {
		model = model,
		motors = motors,
		base = base,
		torso = if torso and torso:IsA("BasePart") then torso else nil,
		paddle = nil,
		paddleWeld = nil,
		paddleOff = CFrame.identity,
		paddleLen = 4.5,
		phase = if index <= 0 then 0 else index * 0.12, -- 다 같이 한 박자 (하나 둘) — 사람마다 아주 조금 엇갈림
		isMe = index <= 0,
		row = 0,
		lean = 0,
		duck = 0,
		pose = 0,
		side = 1,
		wobbleAt = -99,
		wobbleAmp = 0,
		lastStroke = -1,
		active = false,
		drops = nil,
		dropAt = nil,
	}
	crews[model] = c :: Crew
	model.Destroying:Connect(function()
		local cc = crews[model]
		if cc then
			dropPaddle(cc)
		end
		crews[model] = nil
	end)
	return c
end

local function restore(crew: Crew)
	if not crew.active then
		return
	end
	crew.active = false
	for name, j in pairs(crew.motors) do
		if j.Parent then
			setJoint(j, crew.base[name])
		end
	end
	dropPaddle(crew)
	crew.row, crew.lean, crew.duck, crew.pose = 0, 0, 0, 0
end

local function hideBoatOars(hide: boolean)
	if hide then
		local boat = myBoat()
		if not boat then
			return
		end
		for _, d in ipairs(boat:GetChildren()) do
			if d:IsA("BasePart") then
				local n = d.Name
				if
					string.sub(n, 1, 8) == "OarMesh_"
					or string.sub(n, 1, 4) == "Oar_"
					or string.sub(n, 1, 6) == "Blade_"
				then
					d.LocalTransparencyModifier = 1
					table.insert(hiddenOars, d)
				end
			end
		end
	else
		for _, d in ipairs(hiddenOars) do
			if d.Parent then
				d.LocalTransparencyModifier = 0
			end
		end
		table.clear(hiddenOars)
	end
end

local function approach(cur: number, goal: number, rate: number, dt: number): number
	return cur + (goal - cur) * math.min(1, dt * rate)
end

local function stepCrew(crew: Crew, now: number, dt: number)
	local model = crew.model
	local seatOn = model:GetAttribute("RideSeat") == true
	if not seatOn then
		restore(crew)
		return
	end
	if not crew.active then
		crew.active = true
	end
	if not crew.paddle then
		buildPaddle(crew)
	end
	local rr = model:GetAttribute("RideRow") -- 서버: false · RowSoft(급류 천천히) · 1(힘차게)
	local rowGoal = if rr == true then 1 elseif typeof(rr) == "number" then rr else 0
	local leanGoal = tonumber(model:GetAttribute("RideLean")) or 0
	if crew.isMe then
		-- 내 노는 내 입력으로 바로 (서버 왕복을 기다리지 않음) · 도는 쪽으로 몸을 싣는다
		local move, steer = InputController.rideInput()
		rowGoal = if move then 1 else 0
		leanGoal = if steer > 0.3 then 1 elseif steer < -0.3 then -1 else 0
	end
	local duckGoal = if model:GetAttribute("RideDuck") == true then 1 else 0
	crew.row = approach(crew.row, rowGoal, 5, dt)
	crew.lean = approach(crew.lean, leanGoal, 9, dt)
	crew.duck = approach(crew.duck, duckGoal, 9, dt)
	crew.pose = approach(crew.pose, math.rad(tonumber(model:GetAttribute("PoseArm")) or 0), 14, dt)
	-- 어느 쪽 뱃전에 있나 (서버 RideMotor C0 의 X — 복제됨): 노는 바깥쪽으로
	local hrp = model:FindFirstChild("HumanoidRootPart")
	local rm = hrp and hrp:FindFirstChild("RideMotor")
	if rm and rm:IsA("Motor6D") then
		local x = rm.C0.Position.X
		if math.abs(x) > 0.3 then
			crew.side = if x < 0 then -1 else 1
		end
	else
		local rs = tonumber(model:GetAttribute("RideSide")) -- 나: 서버가 앉힌 자리 쪽 (RideService 내 Seat)
		if rs and rs ~= 0 then
			crew.side = if rs < 0 then -1 else 1
		end
	end
	local side = crew.side
	local row, lean, duck = crew.row, crew.lean, crew.duck
	-- 서버 시각 박자: 서버 RideService 가 같은 박자로 배를 밀어낸다 (노가 물을 당기는 반 바퀴 φ 0→π 에 빨라짐)
	local phi = (workspace:GetServerTimeNow() / STROKE) * TAU + crew.phase
	local c, s = math.cos(phi), math.sin(phi)
	-- 휘청 (쿵·긁힘·파도)
	local wob = 0
	local wt = now - crew.wobbleAt
	if wt >= 0 and wt < 0.75 and not reduced() then
		wob = crew.wobbleAmp * math.rad(13) * math.sin(TAU * wt / 0.3) * (1 - wt / 0.75)
	end
	local m = crew.motors
	local b = crew.base
	-- 팔: 앞으로 뻗어 노를 잡고, 당길 때(φ 0→π) 뒤로 — 숙이면 조금 더 앞으로, 휘청이면 옆으로 벌어진다
	local armPitch = math.max(row * (math.rad(60) + math.rad(20) * c) + duck * math.rad(18), crew.pose)
	local flail = wob * 2.2
	if m.RightShoulder then
		setJoint(m.RightShoulder, b.RightShoulder * CFrame.Angles(armPitch, 0, -flail))
	end
	if m.LeftShoulder then
		setJoint(m.LeftShoulder, b.LeftShoulder * CFrame.Angles(armPitch * 0.92, 0, flail))
	end
	-- 허리: 잡을 때 앞으로 숙였다 당기며 편다 · 그쪽으로 몸을 싣는다(기울기) · 가지엔 푹 숙임
	local pitch = -(row * (math.rad(10) + math.rad(9) * (1 + c) * 0.5) + duck * math.rad(34))
	if m.Waist then
		setJoint(m.Waist, b.Waist * CFrame.Angles(pitch, 0, -lean * math.rad(16) + wob))
	end
	-- 골반: 그쪽으로 엉덩이를 옮기고(0.3) 살짝 기울임 · 숙일 땐 낮게
	if m.Root then
		setJoint(
			m.Root,
			b.Root
				* CFrame.new(lean * 0.3, if crew.isMe then 0 else -duck * 0.5 - row * KNEEL * (1 - duck), 0)
				* CFrame.Angles(0, 0, -lean * math.rad(7) + wob * 0.6)
		)
	end
	-- 노: 손 자리(가슴 앞 바깥)를 축으로 앞뒤로 젓고, 돌아올 땐(φ π→2π) 물 밖으로 들어 올린다
	local weld = crew.paddleWeld
	if weld and weld.Parent then
		local lift = row * math.max(0, -s) * 0.6 + duck * 0.4
		local sweep = row * SWEEP * c
		local frame = CFrame.new(side * 1.0, -0.6 + lift, -1.15)
			* CFrame.Angles(sweep, 0, 0)
			* CFrame.Angles(0, 0, side * TILT * (1 - duck * 0.5))
			* CFrame.Angles(math.rad(90), 0, 0)
			* CFrame.new(0, 0, crew.paddleLen * 0.28)
		weld.C0 = frame * crew.paddleOff
		-- 노가 물을 칠 때(위상 0 = 앞으로 뻗은 잡기) 첨벙 — 배가 움직일 때만
		local strokeNo = math.floor((phi - math.pi * 0.15) / TAU)
		if strokeNo ~= crew.lastStroke then
			crew.lastStroke = strokeNo
			if row > 0.4 and crew.torso then
				local tip = (crew.torso.CFrame * frame * CFrame.new(0, 0, crew.paddleLen * 0.5)).Position
				local e, at = crew.drops, crew.dropAt
				if e and at then
					at.WorldPosition = tip
					e:Emit(if reduced() then 3 else 7)
				end
				if crew.isMe then
					playStroke(tip) -- 첨벙 소리는 내 노만 (넷이 한 박자라 겹치면 시끄럽다)
				end
			end
		end
	end
end

local function wobbleAll(amp: number)
	local now = os.clock()
	for _, crew in pairs(crews) do
		crew.wobbleAt = now + math.random() * 0.08
		crew.wobbleAmp = amp
	end
end

function RideCrew.start()
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local on = Net.state() == S.RIDE
		if on then
			if not riding then
				riding = true
				hideBoatOars(true)
			end
			-- 나 (앉아서 직접 젓기): 내 노·팔
			local myCh = _player.Character
			if myCh then
				local crew = crewOf(myCh, 0)
				if crew then
					stepCrew(crew, now, dt)
				end
			end
			local squad = mySquad()
			if squad then
				local i = 0
				for _, ch in ipairs(squad:GetChildren()) do
					if ch:IsA("Model") and string.sub(ch.Name, 1, 4) == "Npc_" then
						i += 1
						local crew = crewOf(ch, i)
						if crew then
							stepCrew(crew, now, dt)
						end
					end
				end
			end
		elseif riding then
			riding = false
			hideBoatOars(false)
			for _, crew in pairs(crews) do
				restore(crew)
			end
		end
	end)
	Net.FxCue:Connect(function(c)
		if not riding then
			return
		end
		if c.kind == "BUMP" then
			wobbleAll(1)
		elseif c.kind == "SCRAPE" then
			wobbleAll(0.55)
		elseif c.kind == "WAVE" then
			wobbleAll(if c.led then 0.35 else 0.8)
		end
	end)
end

return RideCrew
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">460af1f4451ca1c10aea070b0000b958</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6156">
            <Properties>
              <string name="Name">WayFx</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{D438AD94-62F6-4360-99DD-6EA9445FD3FA}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 첫 1분 (28 §7, 2026-10-21): 1일차 전 기지에서 스폰 → 꾸미기 마당 길 안내. 서버 판정 없음 (보이기만).
--   · 바닥 노란 화살표(생성기 FM_Arrow*): 빛이 스폰에서 마당 쪽으로 흐른다 (인기 게임의 "따라가는 길")
--   · 아치 앞 발판(FM_YardPad): 숨쉬듯 밝아졌다 어두워짐 + 위에 통통 튀는 ▼ 표시 (멀리서도 보이게)
--   · 1일차가 아니면(아침 기지·밤·작전) 전부 숨긴다. 유보트가 없는 옛 출발 원(Start_Mark)도 그동안 숨긴다(노랑이 둘이면 헷갈린다)
-- 움직임 줄이기 설정이면 흐름 없이 고정 밝기.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local StationCatalog = require(Shared:WaitForChild("StationCatalog"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)

local WayFx = {}
local S = ProtocolTypes.SessionState
local player = Players.LocalPlayer

type Arrow = { part: BasePart, index: number }
local arrows: { Arrow } = {}
local edges: { BasePart } = {} -- 화살표 어두운 테두리 (모래 위 대비)
local pad: BasePart? = nil
local padIn: BasePart? = nil
local startMark: BasePart? = nil
local marker: BillboardGui? = nil
local maxIndex = 1
local shown: boolean? = nil

-- 1일차 전 기지: 꾸미기 마당이 첫 목적지 (서버 WelcomeService 와 같은 조건)
function WayFx.yardMode(snap: ProtocolTypes.StateSnapshot?): boolean
	return snap ~= nil
		and snap.state == S.CAMP
		and StationCatalog.nextDay(snap.day) == 1
		and snap.allowed.START_DAY == true
end

local function collect()
	table.clear(arrows)
	table.clear(edges)
	pad, padIn = nil, nil
	local deco = SceneBindings.getFolder("Decorations")
	if not deco then
		return
	end
	for _, c in ipairs(deco:GetChildren()) do
		if c:IsA("BasePart") then
			local fm = c:GetAttribute("FirstMinute")
			if fm == "ARROW" then
				local i = tonumber(c:GetAttribute("Index")) or 1
				table.insert(arrows, { part = c, index = i })
				maxIndex = math.max(maxIndex, i)
			elseif fm == "EDGE" then
				table.insert(edges, c)
			elseif fm == "PAD" then
				pad = c
			elseif fm == "PADIN" then
				padIn = c
			elseif c.Name == "Start_Mark" then
				startMark = c
			end
		end
	end
	local p = pad
	if p and not marker then
		local bb = Instance.new("BillboardGui")
		bb.Name = "CampYardMarker"
		bb.Size = UDim2.new(2.5, 34, 2.5, 34) -- 2.5 stud + 34px: 멀리서도 읽히는 크기
		bb.StudsOffset = Vector3.new(0, 7.5, 0) -- 분대원 머리(5.5) 위, 아치 판(10.5) 아래
		bb.AlwaysOnTop = false -- 허공(분대원 머리 위)이라 가릴 것이 없다. true 면 Studio 캡처에 안 나왔다
		bb.LightInfluence = 0
		bb.MaxDistance = 220
		bb.Adornee = p
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBlack
		t.Text = "▼"
		t.TextScaled = true
		t.TextColor3 = Palette.Yellow
		t.TextStrokeColor3 = Palette.Ink
		t.TextStrokeTransparency = 0.2
		t.Parent = bb
		bb.Parent = p -- 파트 아래(이 클라이언트에만 있는 인스턴스). PlayerGui 빌보드는 Studio 캡처에 안 나와 눈 확인이 어려웠다
		marker = bb
	end
end

local function setShown(on: boolean)
	if shown == on then
		return
	end
	shown = on
	for _, a in ipairs(arrows) do
		a.part.Transparency = if on then 0.1 else 1
	end
	for _, e in ipairs(edges) do
		e.Transparency = if on then 0.45 else 1
	end
	if pad then
		(pad :: BasePart).Transparency = if on then 0.35 else 1
	end
	if padIn then
		(padIn :: BasePart).Transparency = if on then 0.1 else 1
	end
	if startMark then
		(startMark :: BasePart).LocalTransparencyModifier = if on then 1 else 0
	end
	if marker then
		(marker :: BillboardGui).Enabled = on
	end
end

local function step()
	local on = WayFx.yardMode(Net.Snapshot)
	if on and #arrows == 0 then
		collect()
	end
	setShown(on and #arrows > 0)
	if not shown then
		return
	end
	local t = os.clock()
	local reduced = Net.setting("reducedMotion") == true
	-- 화살표: 빛 한 줄기가 스폰 → 마당으로 1.4초에 한 번 흐른다
	for _, a in ipairs(arrows) do
		local tr = 0.1
		if not reduced then
			local k = (t / 1.4 - a.index / (maxIndex + 2)) % 1
			local glow = if k < 0.3 then 1 - k / 0.3 else 0
			tr = 0.4 - 0.4 * glow
		end
		a.part.Transparency = tr
	end
	if pad and not reduced then
		(pad :: BasePart).Transparency = 0.3 + 0.25 * (0.5 + 0.5 * math.sin(t * 4))
	end
	-- ▼: 발판 위에서 통통. 가까이 오면(발판 8 안) 숨긴다 — 이미 왔다
	local m, p = marker, pad
	if m and p then
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local near = hrp ~= nil
			and hrp:IsA("BasePart")
			and Vector3.new(hrp.Position.X - p.Position.X, 0, hrp.Position.Z - p.Position.Z).Magnitude < 8
		m.Enabled = not near
		m.StudsOffset = Vector3.new(0, 7.5 + (if reduced then 0 else math.abs(math.sin(t * 3)) * 1.2), 0)
	end
end

function WayFx.start()
	-- 맵이 늦게 오면(스트리밍·생성기 apply 뒤) 다시 모은다
	task.defer(collect)
	local warned = false
	RunService.Heartbeat:Connect(function()
		local ok, err = pcall(step)
		if not ok and not warned then
			warned = true
			warn("[Camp] WayFx: " .. tostring(err))
		end
	end)
end

return WayFx
]]></string>
