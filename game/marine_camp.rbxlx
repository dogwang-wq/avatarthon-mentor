	SFX_ATTACH = cue("rbxassetid://9120910011", "SFX", 1.0, false, true, 0.12), -- PSE "Wood Impacts 1x2 Planks" 0.54초 (봉우리 49, 작아서 1.0): 짐 놓기 탁
	-- APM "Knock Knock (sting)" 아코디언 2.66초 (봉우리 236, 아동 Playtime 앨범): 분대원이 짐을 내밂 "이거!"
	SFX_OFFER = cue("rbxassetid://9038313977", "SFX", 0.4, false, false, 3.0),
	-- ===== 탑승 (RideService · RideFx) =====
	-- PSE "Water Splash Big Dive In 1" 3.6초 (봉우리 192@0.38): 사람이 물에 풍덩
	SFX_SPLASH_BIG = cut(cue("rbxassetid://9120585252", "SFX", 0.7, false, true, 0.3), 0, 2.0),
	SFX_BUMP = cue("rbxassetid://9118731771", "SFX", 0.4, false, true, 0.35), -- PSE "Rubber Hose 6" 1.46초 (봉우리 424): 고무배 바위에 퉁
	-- 늦게 비껴간 바위(SCRAPE): 같은 고무 음원을 작게·짧게 + 0.08초 뒤 작은 첨벙(SFX_STROKE) — 새 ID 없음
	SFX_SCRAPE = cut(cue("rbxassetid://9118731771", "SFX", 0.16, false, true, 0.35), 0, 0.55),
	-- PSE "Waterfall Background Water Roar 1" 56초 중 앞 2.5초 (고른 85): 폭포 쾅 쏟아짐
	SFX_WATERFALL = cut(cue("rbxassetid://9120549564", "SFX", 0.8, false, true, 2.0), 0, 2.5),
	-- PSE "Big Surf Ocean Wave Impact 2" 14.9초: 3.8초부터 차오르다 6초쯤 부서짐 → 경고(2.2초) 끝에 파도가 닿는다
	SFX_WAVE_WARN = cut(cue("rbxassetid://9125393600", "SFX", 0.8, false, false, 1.5), 3.8, 3.2),
	-- ===== 프롬프트 (PromptController — 훅은 아직 없음, 28 §7 소리 패스) =====
	UI_PROMPT_HOLD = cue("rbxassetid://9118622391", "SFX", 0.18, false, false, 0.15), -- 누르기 시작 톡 (SFX_TICK 음원 작게)
	UI_PROMPT_OK = cue("rbxassetid://9120891270", "SFX", 0.3, false, false, 0.12), -- 됐다 딱 (SFX_PICKUP 음원 작게)

	-- ===== 음악 (평균×gain ≈ 100 으로 맞춤, 2026-10-21) =====
	-- 기지·연병장(CAMP·BUILD·TRAINING): APM "Triumph Of Power" 106초 (평균 182 → 0.55). 우쿨렐레는 "갑자기 너무 활기참"(2026-10-20)으로 뺐다
	MUS_CAMP = cue("rbxassetid://1844801556", "MUSIC", 0.55, true, false, 0),
	-- 2·6일차 낮 작전(OBBY): APM "Military March" 158.9초 (사용자: 군가 느낌, 평균 111 → 0.9)
	MUS_COURSE = cue("rbxassetid://1844397606", "MUSIC", 0.9, true, false, 0),
	-- 해병대 군가: 사용자가 권리 있는 음원을 직접 업로드해 ID 를 넣으면 2·6일차 BGM 이 이것으로 바뀐다. 비어 있으면 MUS_COURSE
	MUS_MARCH_KR = cue("", "MUSIC", 1.0, true, false, 0),
	-- 1일차 급류(RIDE RAPIDS): APM "Dancing for Joy 60 A" 61초 — 신나는 오케스트라·구르는 북 (평균 205·봉우리 촘촘 24/5초 → 0.5)
	MUS_RIDE = cue("rbxassetid://9043170481", "MUSIC", 0.5, true, false, 0),
	-- 4일차 바다(RIDE SEA): APM "The Ash Grove (a)" 52.6초 — 리코더 합주, 영국 민요·뱃노래 앨범 (평균 92 → 1.1). 급류보다 가볍게
	MUS_SEA = cue("rbxassetid://1842335284", "MUSIC", 1.1, true, false, 0),
