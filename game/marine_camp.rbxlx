	goalSub = "짐 %d/%d · %s · 출발 깃발",
	goalHolding = "%s 들었어요 · 유보트에 E",
	goalOffer = "🎁 %s 내밀어요 · E 받기",
	goalIdle = "🚩 출발 깃발에서 E",
	-- 밤 일지 한 줄 (메모체)
	journal = "🛠️ 유보트: %s · 짐 %s · 내 자리 %s",
}

-- ===== 탑승 (27 §3 1-B 급류 · 4일차 바다 노 젓기, 28 4·5단계, 2026-10-21) =====
-- RideService 가 읽는다 (RideService.Lines 는 이 표의 별칭). Line 표는 화면 아래 줄(cbs.lines), 문자열은 분대원 말풍선(cbs.bubble).
-- 미르가 먼저 부르고(오른쪽!·왼쪽!·가운데로!) 두리는 자주 늦고 산은 짧게. 빠져도 벌 없음 — 2~4초 안에 웃기게 돌아온다.
CampScript.Ride = {
