			"TerrainProps",
			Vector3.new(h, 3, 3),
			CFrame.new(ox + 28 + (i - 1) * 7, h / 2, -341 + ((i % 2 == 0) and 1.5 or -1.5))
				* CFrame.Angles(0, 0, math.rad(90)),
			Palette.Wood,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder }
		)
	end
	pad("P4", 4, Vector3.new(ox + 74, 0.5, -341), NZ)
	-- 넘기기 벽 1 (진행 -Z)
	passWall("W1", Vector3.new(ox + 90, 0, -365), NZ, 24, 8, "P5")
	pad("P5", 5, Vector3.new(ox + 90, 0.5, -380), NZ)
	-- 그물벽 (높이 14, 산이 멈춤)
	pad("P6", 6, Vector3.new(ox + 110, 0.5, -398), NZ, true)
	box(
		"D2_NetWall",
		"TerrainProps",
		Vector3.new(22, 14, 2),
		at(ox + 110, 7, -410),
		Palette.WoodDark,
		Enum.Material.WoodPlanks
	)
	deco(
		"D2_NetWeave",
		Vector3.new(22.2, 14, 0.2),
		at(ox + 110, 7, -408.8),
