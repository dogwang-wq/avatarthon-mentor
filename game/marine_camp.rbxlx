-- 장애물 (꺾은선 거리 s): 8~9 사건, 25~32 stud 간격 (속도 7 stud/s 면 4초쯤마다 하나)
-- 2026-10-21 플레이테스트 "장애물 막힌 건 좀 없애고 바위만 둬": 가지 2·폭포(판정·"뛰어!" 표지·턱 장식)를 뺐다.
-- 폭포 턱의 물높이 단차(terrain)는 그대로 — 배는 경로점 y 를 따라 내려간다 (선체는 지형과 안 부딪힌다)
local EVENTS = {
	{ s = 42, t = "ROCK", side = "L" },
	{ s = 72, t = "ROCK", side = "R" },
	{ s = 158, t = "ROCK", side = "R" },
	{ s = 212, t = "ROCK", side = "L" },
