	-- 연병장 둘레 밧줄 울타리 (흰 말뚝 + 밧줄 2줄). 아치 쪽(남, z 62)과 코스 쪽(북, z -62) 가운데 12 는 비운다
	local half = 62
	local postIdx = 0
	local function fencePost(x: number, z: number)
		postIdx += 1
		box(
			"Fence_Post" .. postIdx,
			"Buildings",
			Vector3.new(0.5, 2.6, 0.5),
			at(x, 1.3, z),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ canCollide = false }
		)
	end
	local function fenceRope(id: string, a: Vector3, b: Vector3, y: number)
		local mid = (a + b) / 2
		deco(
			"Fence_Rope_" .. id,
			Vector3.new(0.12, 0.12, (b - a).Magnitude),
			facing(Vector3.new(mid.X, y, mid.Z), (b - a).Unit),
			Palette.Rope,
			Enum.Material.Fabric,
			{ attrs = { Rope = true } }
		)
	end
	local step = 12.4
	for i = 0, 10 do
		local t = -half + i * step
		for _, side in ipairs({ "W", "E" }) do
			local x = if side == "W" then -half else half
			fencePost(x, t)
			if i < 10 then
				fenceRope(side .. i .. "a", Vector3.new(x, 0, t), Vector3.new(x, 0, t + step), 2.2)
				fenceRope(side .. i .. "b", Vector3.new(x, 0, t), Vector3.new(x, 0, t + step), 1.3)
			end
		end
		for _, side in ipairs({ "S", "N" }) do
			local z = if side == "S" then half else -half
			if math.abs(t) > 7 then
				fencePost(t, z)
			end
			if i < 10 and t + step <= -7 or t >= 7 then
				if i < 10 then
					fenceRope(side .. i .. "a", Vector3.new(t, 0, z), Vector3.new(t + step, 0, z), 2.2)
					fenceRope(side .. i .. "b", Vector3.new(t, 0, z), Vector3.new(t + step, 0, z), 1.3)
				end
			end
		end
	end
	-- 모래주머니 더미 3 (연병장 가장자리)
	for s, p in ipairs({ { -52, 50 }, { 52, 50 }, { -52, -34 } }) do
		for r = 1, 3 do
			for c = 1, 4 - r do
				deco(
