              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 탑승 연출 (27 §3 1-B 급류 · 4일차 바다, 28 §4·§6 4·5단계): 전부 클라이언트, 판정은 서버(RideService).
-- · 물결: 내 유보트 Root 에 꼬리 물결·양옆 물결·뱃머리 물보라 ParticleEmitter 를 달고, Root 속성 RideSpeed(stud/s) 로 세기를 정한다.
-- · 갑판 빛: 미르가 "오른쪽!·왼쪽!·가운데로!" 부르는 동안 갑판의 그쪽이 노랗게 숨쉰다 — 글을 안 읽어도 어디로 갈지 몸으로 읽게.
-- · FxCue: SPLASH(풍덩 고리·물기둥) · BUMP(쿵 물보라 + 카메라 흔들 0.25초) · DODGE · BRANCH(잎) · WATERFALL(물안개 + 카메라 살짝 내려감)
--   · WAVE_WARN(밀려오는 하얀 물결 벽) · WAVE · HANG(밧줄) · RESCUE(밧줄 톡 끊김 + 고리) · BOARDED · RIDE_START · FINISH(모래·색종이).
-- · 폭포 "붕": 내 점프는 서버가 못 잡는다(28 §7) → ride.cue == JUMP 또는 jumpWindow 동안 내가 뛰면 여기서 소리·물보라·"붕—!" 글자.
-- Part·Particle·Beam·Light 만 (에셋 ID 없음). 움직임 줄이기면 흔들림·물결 벽 이동을 끈다.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local Palette = require(Shared:WaitForChild("Palette"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local RideFx = {}
local S = ProtocolTypes.SessionState
local player = Players.LocalPlayer

local WATER_WHITE = Color3.fromRGB(240, 250, 255)
local WATER_BLUE = Color3.fromRGB(150, 210, 235)
local LEAF = Color3.fromRGB(92, 140, 70)
local HALF_L = GameConfig.Boat.Size.Z / 2

local function reduced(): boolean
	return Net.setting("reducedMotion") == true
end

local function myBoat(): Model?
	local f = SceneBindings.getFolder("Runtime")
	local m = f and f:FindFirstChild("Boat_" .. Net.boatOwnerId())
	return if m and m:IsA("Model") then m else nil
end

local function rootOf(boat: Model?): BasePart?
	if not boat then
		return nil
	end
	local r = boat.PrimaryPart or boat:FindFirstChild("Root")
	return if r and r:IsA("BasePart") then r else nil
end

local function riding(): ProtocolTypes.RideView?
	local snap = Net.Snapshot
	if snap and snap.state == S.RIDE then
		return snap.ride
	end
	return nil
end

-- ===== 작은 도구 =====
local function holderAt(pos: Vector3, life: number): Part
	local p = Instance.new("Part")
	p.Name = "CampRideFx"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = workspace
	task.delay(life, function()
		p:Destroy()
	end)
	return p
end

type EmitOpts = {
	color: Color3,
	size: number,
	sizeEnd: number?,
	count: number,
	life: number,
	speed: number,
	spread: number?,
	accel: Vector3?,
	transparency: number?,
	dir: Enum.NormalId?,
	light: number?,
	drag: number?,
}

local function emitAt(parent: Instance, o: EmitOpts): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(o.color)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, o.size),
		NumberSequenceKeypoint.new(1, o.sizeEnd or 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, o.transparency or 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Lifetime = NumberRange.new(o.life * 0.6, o.life)
	e.Speed = NumberRange.new(o.speed * 0.55, o.speed)
	e.SpreadAngle = Vector2.new(o.spread or 40, o.spread or 40)
	e.Acceleration = o.accel or Vector3.zero
	e.EmissionDirection = o.dir or Enum.NormalId.Top
	e.LightEmission = o.light or 0.25
	e.Drag = o.drag or 0
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Rate = 0
	e.Parent = parent
	return e
end

local function burst(pos: Vector3, o: EmitOpts)
	if reduced() and o.count > 12 then
		o.count = 12
	end
	local p = holderAt(pos, o.life + 0.6)
	local e = emitAt(p, o)
	e:Emit(o.count)
end

-- 물에 퍼지는 하얀 고리 (풍덩·쿵·끌어올림)
local function waterRing(pos: Vector3, color: Color3, to: number, sec: number)
	local p = Instance.new("Part")
	p.Name = "CampRideRing"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Transparency = 0.2
	p.Size = Vector3.new(0.1, 1, 1)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TweenService:Create(
		p,
		TweenInfo.new(sec, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.1, to, to), Transparency = 1 }
	):Play()
	task.delay(sec + 0.1, function()
		p:Destroy()
	end)
end

-- 카메라: 기본 카메라는 그대로 두고 Humanoid.CameraOffset 만 잠깐 흔든다 (빼앗지 않음)
local shakeToken = 0
local function shake(amp: number, sec: number)
	if reduced() then
		return
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	shakeToken += 1
	local my = shakeToken
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if my ~= shakeToken or t >= sec or not hum.Parent then
			conn:Disconnect()
			if my == shakeToken and hum.Parent then
				hum.CameraOffset = Vector3.zero
			end
			return
		end
		local k = amp * (1 - t / sec)
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k, 0)
	end)
end

local function dip(depth: number, sec: number)
	if reduced() then
		return
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	shakeToken += 1
	local my = shakeToken
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if my ~= shakeToken or t >= sec or not hum.Parent then
			conn:Disconnect()
			if my == shakeToken and hum.Parent then
				hum.CameraOffset = Vector3.zero
			end
			return
		end
		hum.CameraOffset = Vector3.new(0, -depth * math.sin(math.pi * t / sec), 0)
	end)
end

-- 머리 위로 떠오르는 글자 ("붕—!")
local function floatText(adornee: BasePart, text: string, color: Color3, big: boolean?)
	local bb = Instance.new("BillboardGui")
	bb.Name = "CampRideFloat"
	bb.Adornee = adornee
	bb.AlwaysOnTop = true -- (줍기 "+1 🌲" 는 크게 — 분대원 몸에 가리지 않게)
	bb.Size = if big then UDim2.fromOffset(230, 72) else UDim2.fromOffset(160, 50)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	bb.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = UiKit.FontBlack
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = color
	l.TextStrokeColor3 = Palette.Ink
	l.TextStrokeTransparency = 0.2
	l.Parent = bb
	bb.Parent = player:WaitForChild("PlayerGui")
	TweenService:Create(bb, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffsetWorldSpace = Vector3.new(0, 6, 0),
	}):Play()
	TweenService:Create(l, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1, function()
		bb:Destroy()
	end)
end

local function characterOfWho(who: string): Model?
	if who == "ME" then
		return player.Character
	end
	local folder = SceneBindings.getFolder("Runtime")
	local holder = folder and folder:FindFirstChild("CampSquads")
	local mine = holder and holder:FindFirstChild("Squad_" .. Net.boatOwnerId())
	local model = mine and mine:FindFirstChild("Npc_" .. who)
	return if model and model:IsA("Model") then model else nil
end

-- ===== 물결 (상시) =====
type Wake = {
	root: BasePart,
	atts: { Attachment },
	stern: ParticleEmitter,
	sideL: ParticleEmitter,
	sideR: ParticleEmitter,
	bow: ParticleEmitter,
	foam: ParticleEmitter,
	glow: Part,
}
local wake: Wake? = nil

local function clearWake()
	local w = wake
	if not w then
		return
	end
	wake = nil
	for _, a in ipairs(w.atts) do
		a:Destroy()
	end
	w.glow:Destroy()
end

local function makeWake(root: BasePart): Wake
	local function att(name: string, pos: Vector3): Attachment
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = pos
		a.Parent = root
		return a
	end
	local aStern = att("CampWakeStern", Vector3.new(0, -0.5, HALF_L + 0.4))
	local aL = att("CampWakeL", Vector3.new(-3.3, -0.5, HALF_L - 1))
	local aR = att("CampWakeR", Vector3.new(3.3, -0.5, HALF_L - 1))
	local aBow = att("CampWakeBow", Vector3.new(0, -0.2, -HALF_L - 0.2))
	-- 꼬리 물결: 넓게 퍼지는 하얀 거품 (월드에 남아 뒤로 길게 끌린다)
	local stern = emitAt(aStern, {
		color = WATER_WHITE,
		size = 1.1,
		sizeEnd = 3.2,
		count = 0,
		life = 1.8,
		speed = 1.2,
		spread = 55,
		dir = Enum.NormalId.Back,
		transparency = 0.35,
		light = 0.15,
	})
	stern.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
	local function side(a: Attachment, dir: Enum.NormalId): ParticleEmitter
		local e = emitAt(a, {
			color = WATER_WHITE,
			size = 0.8,
			sizeEnd = 2.2,
			count = 0,
			life = 1.3,
			speed = 2.2,
			spread = 20,
			dir = dir,
			transparency = 0.4,
			light = 0.15,
		})
		return e
	end
	local sideL = side(aL, Enum.NormalId.Left)
	local sideR = side(aR, Enum.NormalId.Right)
	-- 뱃머리 물보라: 위·앞으로 튀었다 떨어지는 물방울
	local bow = emitAt(aBow, {
		color = WATER_BLUE,
		size = 0.35,
		sizeEnd = 0.1,
		count = 0,
		life = 0.8,
		speed = 9,
		spread = 38,
		dir = Enum.NormalId.Front,
		accel = Vector3.new(0, -34, 0),
		transparency = 0.1,
		light = 0.3,
	})
	-- 뱃머리 거품 (수면에 깔림)
	local foam = emitAt(aBow, {
		color = WATER_WHITE,
		size = 1.2,
		sizeEnd = 2.4,
		count = 0,
		life = 0.9,
		speed = 1.5,
		spread = 70,
		dir = Enum.NormalId.Front,
		transparency = 0.35,
	})
	local glow = Instance.new("Part")
	glow.Name = "CampRideCueGlow"
	glow.Anchored = true
	glow.CanCollide = false
	glow.CanQuery = false
	glow.CanTouch = false
	glow.CastShadow = false
	glow.Material = Enum.Material.Neon
	glow.Color = Palette.Yellow:Lerp(Palette.Cream, 0.35)
	glow.Transparency = 1
	glow.Size = Vector3.new(2.8, 0.06, 12.4)
	glow.Parent = workspace
	-- "여기로" 화살표: 갑판 그쪽 위에서 통통 튄다 (3D 자리라 카메라를 돌려도 맞는 쪽을 가리킨다). 노란 바닥 무늬와 헷갈리지 않게
	local arrow = Instance.new("BillboardGui")
	arrow.Name = "CampRideCueArrow"
	arrow.Adornee = glow
	arrow.AlwaysOnTop = true
	arrow.LightInfluence = 0
	arrow.Size = UDim2.fromOffset(84, 84)
	arrow.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	arrow.Enabled = false
	local al = Instance.new("TextLabel")
	al.Name = "Arrow"
	al.BackgroundTransparency = 1
	al.Size = UDim2.fromScale(1, 1)
	al.Font = UiKit.FontBlack
	al.TextScaled = true
	al.Text = "▼"
	al.TextColor3 = Palette.Yellow
	al.TextStrokeColor3 = Palette.Ink
	al.TextStrokeTransparency = 0
	al.Parent = arrow
	arrow.Parent = glow
	return {
		root = root,
		atts = { aStern, aL, aR, aBow },
		stern = stern,
		sideL = sideL,
		sideR = sideR,
		bow = bow,
		foam = foam,
		glow = glow,
	}
end

local function stepWake()
	local rv = riding()
	local root = rootOf(myBoat())
	if not rv or not root then
		clearWake()
		return
	end
	if wake and wake.root ~= root then
		clearWake()
	end
	if not wake then
		wake = makeWake(root)
	end
	local w = wake :: Wake
	local speed = tonumber(root:GetAttribute("RideSpeed")) or rv.speed or 0
	local on = speed >= GameConfig.Ride.WakeMinSpeed and rv.phase ~= "DONE"
	local k = if on then math.clamp(speed / 9, 0.3, 1.6) else 0
	local cut = if reduced() then 0.4 else 1
	w.stern.Rate = 26 * k * cut
	w.sideL.Rate = 14 * k * cut
	w.sideR.Rate = 14 * k * cut
	w.bow.Rate = 30 * k * cut
	w.foam.Rate = 10 * k * cut
	-- 갑판 빛: 부르는 쪽 (LEFT = −X · RIGHT = +X · CENTER = 가운데 띠). 내가 배 위에 있을 때만
	local cue = rv.cue
	local show = (cue == "LEFT" or cue == "RIGHT") and rv.phase == "RUN" and rv.meState == "DECK" -- 앉아서 직접 젓기: 가야 할 쪽 (파도 ROW 는 빛 없음)
	if show then
		local x = if cue == "LEFT" then -1.75 elseif cue == "RIGHT" then 1.75 else 0
		local width = if cue == "CENTER" then 1.4 else 2.9
		if math.abs(w.glow.Size.X - width) > 0.01 then
			w.glow.Size = Vector3.new(width, 0.06, 12.4)
		end
		w.glow.CFrame = root.CFrame * CFrame.new(x, 0.46, 0) -- 바닥판 윗면(0.32) 위로 (0.26 은 바닥에 묻혔다)
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * (if reduced() then 3 else 9))
		w.glow.Transparency = 0.3 + 0.35 * pulse
		local arrow = w.glow:FindFirstChild("CampRideCueArrow") :: BillboardGui?
		if arrow then
			arrow.Enabled = true
			local al = arrow:FindFirstChild("Arrow")
			if al and al:IsA("TextLabel") then
				al.Text = if cue == "LEFT" then "◀" else "▶" -- 앉아서 직접 젓기: A/D 쪽
			end
			arrow.StudsOffsetWorldSpace = Vector3.new(0, 2.6 + (if reduced() then 0 else 0.6 * pulse), 0)
		end
	elseif w.glow.Transparency < 1 then
		w.glow.Transparency = 1
		local arrow = w.glow:FindFirstChild("CampRideCueArrow") :: BillboardGui?
		if arrow then
			arrow.Enabled = false
		end
	end
end

-- ===== 밧줄 (매달림) =====
local ropes: { [string]: { beam: Beam, a1: Attachment, at: number } } = {}

local function dropRope(who: string, snap: boolean)
	local r = ropes[who]
	if not r then
		return
	end
	ropes[who] = nil
	if snap and not reduced() then
		-- 톡: 밧줄이 노랗게 번쩍하고 사라진다
		r.beam.Color = ColorSequence.new(Palette.Yellow)
		r.beam.Width0 = 0.35
		r.beam.Width1 = 0.35
		task.delay(0.12, function()
			r.beam:Destroy()
			r.a1:Destroy()
		end)
	else
		r.beam:Destroy()
		r.a1:Destroy()
	end
end

local function hangRope(who: string)
	dropRope(who, false)
	local root = rootOf(myBoat())
	local ch = characterOfWho(who)
	if not root or not ch then
		return
	end
	local hand = ch:FindFirstChild("RightHand") or ch:FindFirstChild("HumanoidRootPart")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	-- 가장 가까운 밧줄 자리 (서버 RideRope1..3)
	local best: Attachment? = nil
	local bestD = math.huge
	for i = 1, 3 do
		local a = root:FindFirstChild("RideRope" .. i)
		if a and a:IsA("Attachment") then
			local d = (a.WorldPosition - hand.Position).Magnitude
			if d < bestD then
				best, bestD = a, d
			end
		end
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "CampRopeTie"
	a0.Position = Vector3.new(if best then best.Position.X else 0, 0.6, HALF_L - 0.6)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "CampRopeHand"
	a1.Parent = hand
	local beam = Instance.new("Beam")
	beam.Name = "CampRideRope"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(Palette.Rope)
	beam.Width0 = 0.18
	beam.Width1 = 0.14
	beam.CurveSize0 = -0.6
	beam.CurveSize1 = 0.3
	beam.Segments = 12
	beam.FaceCamera = true
	beam.LightInfluence = 1
	beam.Parent = root
	ropes[who] = { beam = beam, a1 = a1, at = os.clock() }
	-- 끈 쪽 붙임 a0 은 beam 과 같이 지운다
	beam.Destroying:Connect(function()
		a0:Destroy()
	end)
	-- 안전장치: 끌어올림 큐가 안 와도 사라진다
	task.delay(6, function()
		if ropes[who] and ropes[who].beam == beam then
			dropRope(who, false)
		end
	end)
end

-- ===== 파도 벽 (바다 WAVE_WARN): 배가 닿을 자리로 옆에서 밀려오는 하얀 물결 =====
local function waveWall(side: string, sec: number)
	local root = rootOf(myBoat())
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
	local right = flatLook:Cross(Vector3.yAxis)
	local fromDir = if side == "L" then -right else right
	local speed = tonumber(root:GetAttribute("RideSpeed")) or 0
	local waterY = root.Position.Y - GameConfig.Ride.RootHeight
	local hit = root.Position + flatLook * (speed * sec)
	local at = Vector3.new(hit.X, waterY, hit.Z)
	local startPos = at + fromDir * (if reduced() then 7 else 30)
	local endPos = at + fromDir * 2
	local w = Instance.new("Part")
	w.Name = "CampRideWave"
	w.Anchored = true
	w.CanCollide = false
	w.CanQuery = false
	w.CanTouch = false
	w.CastShadow = false
	w.Material = Enum.Material.SmoothPlastic
	w.Color = Palette.SeaFoam
	w.Size = Vector3.new(24, 1.8, 3)
	w.Transparency = 0.2
	-- 벽의 긴 쪽(X)이 배 진행 방향과 나란히, 앞면(−Z)이 배 쪽
	w.CFrame = CFrame.lookAt(startPos, startPos - fromDir) * CFrame.new(0, 0.4, 0)
	w.Parent = workspace
	local crest = emitAt(w, {
		color = WATER_WHITE,
		size = 0.9,
		sizeEnd = 0.2,
		count = 0,
		life = 0.7,
		speed = 5,
		spread = 30,
		accel = Vector3.new(0, -18, 0),
		transparency = 0.1,
	})
	crest.Rate = if reduced() then 10 else 60
	if not reduced() then
		TweenService:Create(w, TweenInfo.new(math.max(0.3, sec), Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = CFrame.lookAt(endPos, endPos - fromDir) * CFrame.new(0, 1.2, 0),
			Size = Vector3.new(26, 3, 3),
		}):Play()
	end
	task.delay(math.max(0.3, sec) + 0.1, function()
		crest.Rate = 0
		TweenService:Create(w, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		task.delay(0.4, function()
			w:Destroy()
		end)
	end)
end

-- ===== 큐 =====
local function splash(pos: Vector3, big: boolean)
	waterRing(pos, WATER_WHITE, if big then 11 else 7, 0.55)
	burst(pos, {
		color = WATER_BLUE,
		size = 0.55,
		sizeEnd = 0.15,
		count = if big then 46 else 26,
		life = 1.0,
		speed = if big then 22 else 15,
		spread = 28,
		accel = Vector3.new(0, -46, 0),
		transparency = 0.05,
		light = 0.3,
	})
	burst(pos + Vector3.new(0, 0.6, 0), {
		color = WATER_WHITE,
		size = 2.2,
		sizeEnd = 3.6,
		count = if big then 16 else 9,
		life = 1.1,
		speed = 3,
		spread = 80,
		transparency = 0.4,
	})
end

-- ===== 물 위 줍기 (급류 2차 — Build a Boat 보물 줍기 꼴) =====
-- 서버가 띄운 장작·물통(Runtime/RideItems_<내 id>/Item_nn, 앵커)을 여기서 흔들고(둥실·빙글) 반짝이와 거품 고리를 단다(처음 한 번).
-- 건지면(FxCue RIDE_ITEM) 물에서 톡 튀어 배 안으로 포물선을 그리며 날아와 사라지고, 배 위에 "+1 🌲" · 나무 조각 · 딱 소리.
-- 다른 사람의 줍기는 내 화면에서 숨긴다. 놓친 건(Missed) 그냥 떠 있다 — 벌 없음.
type ItemVis = { model: Model, base: CFrame, seed: number, flying: boolean, hidden: boolean }
local itemVis: { [Model]: ItemVis } = {}
local hiddenFolders: { [Instance]: boolean } = {}
local lastFolderScan = 0
local ITEM_SPARK = Color3.fromRGB(255, 226, 120)

local function itemFolder(): Instance?
	local f = SceneBindings.getFolder("Runtime")
	return f and f:FindFirstChild("RideItems_" .. Net.boatOwnerId())
end

local function setModelHidden(m: Instance, hidden: boolean)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

local function decorateItem(m: Model): ItemVis
	local base = m:GetPivot()
	local cf, size = m:GetBoundingBox()
	local surfaceY = cf.Position.Y - size.Y * 0.15 - GameConfig.Ride.ItemFloatLift
	-- 거품 고리 (물에 뜬 자리 표시) + 반짝이 + 따뜻한 빛: 멀리서도 "저기 뭔가 있다"
	local ring = Instance.new("Part")
	ring.Name = "CampItemRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.SmoothPlastic
	ring.Color = WATER_WHITE
	ring.Transparency = 0.35
	local d = math.max(size.X, size.Z) + 1.2
	ring.Size = Vector3.new(0.12, d, d)
	ring.CFrame = CFrame.new(cf.Position.X, surfaceY + 0.06, cf.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = m
	local holder = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
	if holder then
		local a = Instance.new("Attachment")
		a.Name = "CampItemFx"
		a.WorldPosition = cf.Position + Vector3.new(0, size.Y * 0.4, 0)
		a.Parent = holder
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(ITEM_SPARK)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		e.Lifetime = NumberRange.new(0.6, 1.0)
		e.Speed = NumberRange.new(1.2, 2.4)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, 2, 0)
		e.LightEmission = 1
		e.Rate = if reduced() then 2 else 6
		e.Parent = a
		local l = Instance.new("PointLight")
		l.Color = ITEM_SPARK
		l.Range = 7
		l.Brightness = 0.8
		l.Shadows = false
		l.Parent = a
	end
	local seed = (tonumber(m:GetAttribute("ItemIndex")) or 1) * 1.37
	local v: ItemVis = { model = m, base = base, seed = seed, flying = false, hidden = false }
	itemVis[m] = v
	m.Destroying:Connect(function()
		itemVis[m] = nil
	end)
	return v
end

local function stepItems()
	local now = os.clock()
	-- 다른 사람 줍기는 숨긴다 (1초마다 훑기)
	if now - lastFolderScan > 1 then
		lastFolderScan = now
		local f = SceneBindings.getFolder("Runtime")
		if f then
			local mine = "RideItems_" .. Net.boatOwnerId()
			for _, c in ipairs(f:GetChildren()) do
				if string.sub(c.Name, 1, 10) == "RideItems_" and c.Name ~= mine and not hiddenFolders[c] then
					hiddenFolders[c] = true
					setModelHidden(c, true)
				end
			end
		end
	end
	local folder = itemFolder()
	if not folder then
		return
	end
	local still = reduced()
	for _, m in ipairs(folder:GetChildren()) do
		if not m:IsA("Model") then
			continue
		end
		local v = itemVis[m] or decorateItem(m)
		if v.flying or v.hidden then
			continue
		end
		if m:GetAttribute("Taken") == true then
			-- 큐를 놓쳤으면 그냥 숨긴다
			v.hidden = true
			setModelHidden(m, true)
			continue
		end
		local t = now + v.seed
		local bob = if still then 0 else math.sin(t * 2.1) * 0.16
		m:PivotTo(
			v.base
				* CFrame.new(0, bob, 0)
				* CFrame.Angles(math.sin(t * 1.7) * 0.07, if still then 0 else t * 0.45, math.cos(t * 1.3) * 0.07)
		)
	end
end

local function flyItem(c: any)
	local folder = itemFolder()
	local idx = tonumber(c.index) or 0
	local m = folder and folder:FindFirstChild(string.format("Item_%02d", idx))
	local root = rootOf(myBoat())
	local from: Vector3 = if typeof(c.pos) == "Vector3" then c.pos elseif root then root.Position else Vector3.zero
	local isWater = c.item == "WATER"
	-- 물에서 톡 (고리 + 물기둥)
	waterRing(from, Palette.Yellow, 7, 0.45)
	burst(from + Vector3.new(0, 0.4, 0), {
		color = WATER_WHITE,
		size = 0.5,
		sizeEnd = 0.1,
		count = 22,
		life = 0.8,
		speed = 14,
		spread = 22,
		accel = Vector3.new(0, -44, 0),
		transparency = 0.05,
	})
	local function land()
		local r = rootOf(myBoat())
		if not r then
			return
		end
		local at = r.CFrame:PointToWorldSpace(Vector3.new(0, 1.4, 0.6))
		burst(at, {
			color = if isWater then WATER_BLUE else Palette.Wood,
			size = 0.35,
			count = 16,
			life = 0.7,
			speed = 9,
			spread = 70,
			accel = Vector3.new(0, -30, 0),
			light = 0,
		})
		burst(at + Vector3.new(0, 0.6, 0), {
			color = ITEM_SPARK,
			size = 0.45,
			count = if reduced() then 6 else 18,
			life = 0.7,
			speed = 7,
			spread = 180,
			light = 1,
		})
		floatText(r, (CampScript.Ride.itemFloat :: any)[c.item] or "+1", Palette.Yellow, true)
		local ok, audio = pcall(function()
			return require(script.Parent.AudioController) :: any
		end)
		if ok and audio and typeof(audio.play) == "function" then
			audio.play("SFX_PICKUP", at)
		end
	end
	if not m or not m:IsA("Model") or not root then
		land()
		return
	end
	local v = itemVis[m] or decorateItem(m)
	v.flying = true
	local ring = m:FindFirstChild("CampItemRing")
	if ring and ring:IsA("BasePart") then
		ring.LocalTransparencyModifier = 1
	end
	local start = m:GetPivot()
	local t0 = os.clock()
	local DUR = 0.5
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local r = rootOf(myBoat())
		local k = math.clamp((os.clock() - t0) / DUR, 0, 1)
		if not m.Parent or not r or k >= 1 then
			conn:Disconnect()
			if m.Parent then
				v.hidden = true
				setModelHidden(m, true)
			end
			land()
			return
		end
		local e = TweenService:GetValue(k, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local target = r.CFrame:PointToWorldSpace(Vector3.new(0, 1.4, 0.6))
		local p = start.Position:Lerp(target, e) + Vector3.new(0, 4 * math.sin(math.pi * k), 0)
		m:PivotTo(CFrame.new(p) * start.Rotation * CFrame.Angles(k * 5, k * 3, 0))
	end)
end

-- 늦게 피해 바위에 긁힘 (빠지지 않음): 그쪽 뱃전 물보라 + 돌 부스러기 + 작은 흔들림
local function scrape(c: any)
	local root = rootOf(myBoat())
	if not root then
		return
	end
	shake(0.22, 0.2)
	local sideSign = if c.side == "L" then -1 else 1
	for i = -1, 1 do
		local at = root.CFrame:PointToWorldSpace(Vector3.new(sideSign * 3.8, -0.3, i * 3))
		burst(at, {
			color = WATER_WHITE,
			size = 0.45,
			sizeEnd = 0.1,
			count = 12,
			life = 0.7,
			speed = 11,
			spread = 30,
			accel = Vector3.new(0, -40, 0),
		})
	end
	local mid = root.CFrame:PointToWorldSpace(Vector3.new(sideSign * 3.9, 0.4, 0))
	burst(mid, {
		color = Palette.Stone,
		size = 0.25,
		count = 8,
		life = 0.6,
		speed = 7,
		spread = 60,
		accel = Vector3.new(0, -30, 0),
		light = 0,
	})
end

local function onFx(c: any)
	if Net.state() ~= S.RIDE and c.kind ~= "FINISH" then
		return
	end
	local root = rootOf(myBoat())
	local pos: Vector3? = if typeof(c.pos) == "Vector3" then c.pos else nil
	local kind = c.kind
	if kind == "SPLASH" then
		local at = pos or (if root then root.Position else nil)
		if at then
			splash(at, c.memberId == "ME" or c.why == "WAVE")
		end
		if c.memberId == "ME" then
			shake(0.3, 0.25)
		end
	elseif kind == "HANG" then
		local who = tostring(c.memberId or "ME")
		hangRope(who)
		local ch = characterOfWho(who)
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			waterRing(hrp.Position - Vector3.new(0, 1.5, 0), WATER_WHITE, 5, 0.45)
		end
	elseif kind == "RESCUE" then
		local who = tostring(c.memberId or "ME")
		dropRope(who, true)
		local at = pos or (if root then root.Position else nil)
		if at then
			waterRing(at + Vector3.new(0, 0.3, 0), Palette.Yellow, 6, 0.4)
			burst(at + Vector3.new(0, 1.5, 0), {
				color = Palette.Cream,
				size = 0.5,
				count = 18,
				life = 0.7,
				speed = 10,
				spread = 60,
				accel = Vector3.new(0, -20, 0),
			})
			burst(at + Vector3.new(0, 1.2, 0), {
				color = WATER_BLUE,
				size = 0.4,
				count = 20,
				life = 0.8,
				speed = 12,
				spread = 30,
				accel = Vector3.new(0, -40, 0),
			})
		end
	elseif kind == "BUMP" then
		shake(0.5, 0.3) -- 못 피했을 때가 분명하게: 카메라 흔들림 0.3초
		local at = pos or (if root then root.Position else nil)
		if at and root then
			-- 바위와 배 사이에서 물보라
			local mid = at:Lerp(root.Position, 0.5)
			splash(Vector3.new(mid.X, root.Position.Y - 0.4, mid.Z), false)
			burst(mid + Vector3.new(0, 1, 0), {
				color = Palette.Stone,
				size = 0.3,
				count = 8,
				life = 0.6,
				speed = 8,
				spread = 50,
				accel = Vector3.new(0, -30, 0),
			})
		end
	elseif kind == "DODGE" then
		if pos and root then
			local mid = pos:Lerp(root.Position, 0.4)
			burst(Vector3.new(mid.X, root.Position.Y - 0.3, mid.Z), {
				color = WATER_WHITE,
				size = 1,
				sizeEnd = 2,
				count = 12,
				life = 0.8,
				speed = 4,
				spread = 60,
				transparency = 0.3,
			})
		end
	elseif kind == "BRANCH" then
		local at = if pos then pos + Vector3.new(0, 3, 0) elseif root then root.Position + Vector3.new(0, 5, 0) else nil
		if at then
			burst(at, {
				color = LEAF,
				size = 0.5,
				sizeEnd = 0.3,
				count = 26,
				life = 1.6,
				speed = 7,
				spread = 70,
				accel = Vector3.new(0, -6, 0),
				drag = 2,
				transparency = 0,
				light = 0,
			})
			burst(at, {
				color = Palette.Wood,
				size = 0.25,
				count = 8,
				life = 1,
				speed = 6,
				spread = 60,
				accel = Vector3.new(0, -24, 0),
				light = 0,
			})
		end
		shake(0.15, 0.15)
	elseif kind == "WATERFALL" then
		local at = pos or (if root then root.Position else nil)
		if at then
			burst(at + Vector3.new(0, 1, 0), {
				color = WATER_WHITE,
				size = 3.5,
				sizeEnd = 6,
				count = 30,
				life = 1.8,
				speed = 4,
				spread = 90,
				transparency = 0.5,
				light = 0.2,
			})
			splash(at, true)
		end
		dip(0.9, 0.45)
	elseif kind == "ROCK_WARN" then
		-- 바위 위 빨간 ▼ (다가오면, 지나갈 때까지): 어느 쪽 바위인지 물 위에서 바로 보이게
		if pos then
			local at: Vector3 = pos
			local holder = holderAt(pos, tonumber(c.sec) or 4)
			-- 빨간 마름모 (3D, 네온) — 글자 표시가 안 보이는 화면에서도 보이게
			local gem = Instance.new("Part")
			gem.Name = "CampRockGem"
			gem.Anchored = true
			gem.CanCollide = false
			gem.CanQuery = false
			gem.CanTouch = false
			gem.CastShadow = false
			gem.Material = Enum.Material.Neon
			gem.Color = Palette.Red
			gem.Size = Vector3.new(1.3, 1.3, 1.3)
			gem.CFrame = CFrame.new(at + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, 0, math.rad(45))
			gem.Parent = holder
			local bb = Instance.new("BillboardGui")
			bb.Name = "CampRockMark"
			bb.AlwaysOnTop = false
			bb.LightInfluence = 0
			bb.Size = UDim2.fromOffset(70, 70)
			bb.Adornee = holder
			local tl = Instance.new("TextLabel")
			tl.BackgroundTransparency = 1
			tl.Size = UDim2.fromScale(1, 1)
			tl.Font = UiKit.FontBlack
			tl.TextScaled = true
			tl.Text = "▼"
			tl.TextColor3 = Palette.Red
			tl.TextStrokeColor3 = Palette.Ink
			tl.TextStrokeTransparency = 0
			tl.Parent = bb
			bb.Parent = holder
			if not reduced() then
				task.spawn(function()
					local t0 = os.clock()
					while bb.Parent do
						local t = os.clock() - t0
						local up = 0.6 * math.abs(math.sin(t * 5))
						bb.StudsOffsetWorldSpace = Vector3.new(0, up, 0)
						gem.CFrame = CFrame.new(at + Vector3.new(0, 1.6 + up, 0))
							* CFrame.Angles(0, t * 3, 0)
							* CFrame.Angles(0, 0, math.rad(45))
						task.wait(1 / 30)
					end
				end)
			end
		end
	elseif kind == "WAVE_WARN" then
		waveWall(tostring(c.side or "L"), tonumber(c.sec) or 2.2)
	elseif kind == "WAVE" then
		if root then
			local right = root.CFrame.RightVector
			local sideSign = if c.side == "L" then -1 else 1
			local at = root.Position + right * sideSign * 3.6 - Vector3.new(0, 0.3, 0)
			splash(at, true)
		end
		shake(0.25, 0.2)
	elseif kind == "RIDE_ITEM" then
		flyItem(c)
	elseif kind == "SCRAPE" then
		scrape(c)
	elseif kind == "BOARDED" then
		if root then
			waterRing(root.Position - Vector3.new(0, 0.5, 0), Palette.Yellow, 14, 0.5)
		end
	elseif kind == "RIDE_START" then
		if root then
			local bow = root.CFrame:PointToWorldSpace(Vector3.new(0, 0, -HALF_L))
			splash(bow, true)
		end
	elseif kind == "FINISH" then
		local at = pos or (if root then root.Position else nil)
		if at then
			burst(at + Vector3.new(0, 0.5, 0), {
				color = Palette.Sand,
				size = 0.7,
				count = 30,
				life = 1,
				speed = 10,
				spread = 60,
				accel = Vector3.new(0, -30, 0),
				light = 0,
			})
			for i = 1, 3 do
				task.delay(i * 0.25, function()
					burst(at + Vector3.new((i - 2) * 3, 6, 0), {
						color = if i % 2 == 0 then Palette.Red else Palette.Yellow,
						size = 0.45,
						count = 30,
						life = 1.4,
						speed = 12,
						spread = 70,
						accel = Vector3.new(0, -14, 0),
						drag = 1,
					})
				end)
			end
		end
		for who in pairs(ropes) do
			dropRope(who, false)
		end
	end
end

-- ===== 폭포 "붕": 내 점프 (클라이언트만 아는 것 — 점수 없음, 손맛만) =====
local lastWhee = 0
-- 스냅샷은 4~8Hz 라 창을 놓치기 쉽다: "뛰어!" 를 본 순간부터 여기서 창을 연다 (서버 창 + 여유)
local jumpOpenUntil = 0
local function onJump()
	local rv = riding()
	if not rv or rv.meState ~= "DECK" or rv.phase ~= "RUN" then
		return
	end
	local now = os.clock()
	if not (rv.cue == "JUMP" or rv.jumpWindow or now < jumpOpenUntil) then
		return
	end
	if now - lastWhee < 1.2 then
		return
	end
	lastWhee = now
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return
	end
	floatText(hrp, CampScript.Ride.jumpWhee, Palette.Yellow)
	burst(hrp.Position - Vector3.new(0, 2.5, 0), {
		color = WATER_WHITE,
		size = 0.5,
		count = 20,
		life = 0.8,
		speed = 10,
		spread = 50,
		accel = Vector3.new(0, -30, 0),
	})
	waterRing(hrp.Position - Vector3.new(0, 3, 0), Palette.Yellow, 6, 0.35)
	local ok, audio = pcall(function()
		return require(script.Parent.AudioController) :: any
	end)
	if ok and audio and typeof(audio.play) == "function" then
		audio.play("SFX_WHOOSH")
	end
end

local jumpConn: RBXScriptConnection? = nil
local function bindCharacter(ch: Model)
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	local hum = ch:WaitForChild("Humanoid", 10)
	if not hum or not hum:IsA("Humanoid") then
		return
	end
	jumpConn = hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			onJump()
		end
	end)
end

function RideFx.start()
	Net.FxCue:Connect(function(c)
		local ok, err = pcall(onFx, c)
		if not ok then
			warn("[Camp] RideFx: " .. tostring(err))
		end
	end)
	RunService.RenderStepped:Connect(function()
		stepWake()
		if Net.state() == S.RIDE then
			stepItems()
		end
	end)
	-- 급류 2차: 분대원 노 젓기·몸짓 (RideCrew)
	require(script.Parent.RideCrew).start()
	Net.SnapshotChanged:Connect(function(snap)
		if snap.state == S.RIDE and snap.ride and (snap.ride.cue == "JUMP" or snap.ride.jumpWindow) then
			jumpOpenUntil = os.clock() + GameConfig.Ride.JumpWindowSec + 0.6
		end
		if snap.state ~= S.RIDE then
			for who in pairs(ropes) do
				dropRope(who, false)
			end
			return
		end
		-- 매달림이 끝난 사람의 밧줄은 지운다 (큐를 놓쳐도)
		local rv = snap.ride
		local hanging: { [string]: boolean } = {}
		if rv then
			for _, id in ipairs(rv.hanging) do
				hanging[id] = true
			end
			if rv.meState == "HANGING" then
				hanging.ME = true
			end
		end
		for who, r in pairs(ropes) do
			if not hanging[who] and os.clock() - r.at > 0.6 then
				dropRope(who, true)
			end
		end
	end)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)
end

return RideFx
]]></string>
              <int64 name="SourceAssetId">-1</int64>
