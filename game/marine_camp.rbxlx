            <string name="Source"><![CDATA[--!strict
-- Studio 편집 전용 맵 생성기. 일반 서버 init 에서 require 하지 않는다. 플레이/운영 서버에서는 실행을 거부한다.
-- 명령창 또는 MCP(Edit):
--   local B = require(game.ServerScriptService.Server.Editor.CampSceneBootstrap:Clone())
--   print(B.dryRun())   -- 추가/수정/유지/충돌 목록만
--   print(B.apply())    -- 소유 영역만 갱신 (ProjectId/SceneSchemaVersion/SpecId 부착) + Terrain 채우기
--   print(B.check())    -- CP0~CP6, 발판, 깃발·영역, 모닥불·줍기, 꾸미기, 에셋, 스폰 검증
--   print(B.prune())    -- 생성기 소유(ProjectId)인데 지금 스펙에 없는 파트만 지운다 (이름을 바꾸거나 스펙을 지운 뒤의 STALE)
-- 전체 Workspace 삭제·Terrain.Clear·Lighting 초기화는 하지 않는다. 좌표는 docs/design/02_MAP_LAYOUT.md 와 함께 조정한다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
-- Edit 모드 require 캐시: DevSync 로 바뀐 SceneBindings 를 check() 가 읽도록 복제해서 require (상태 없는 모듈)
local SceneBindings = require(Shared:WaitForChild("SceneBindings"):Clone())
local Palette = require(Shared:WaitForChild("Palette"))
-- 때깔 패스(28): Edit 모드 require 캐시를 피하려고 매번 복제해서 읽는다 (이 모듈 자체도 :Clone() 으로 읽히므로 script.Parent 는 nil)
local CampRideCourse = require(
	game:GetService("ServerScriptService")
		:WaitForChild("Server")
		:WaitForChild("Editor")
		:WaitForChild("CampRideCourse")
		:Clone()
)
local CampArt = require(
	game:GetService("ServerScriptService"):WaitForChild("Server"):WaitForChild("Editor"):WaitForChild("CampArt"):Clone()
)
-- 에셋 1차: ServerStorage.CampAssets 메시를 앵커 스펙 자리에 입힌다 (라이브러리 없으면 기본 파트 그대로)
local CampAssets = require(
	game:GetService("ServerScriptService")
		:WaitForChild("Server")
		:WaitForChild("Editor")
		:WaitForChild("CampAssets")
		:Clone()
)

local Bootstrap = {}

local PROJECT = SceneBindings.ProjectId
local SCHEMA = SceneBindings.SceneSchemaVersion
local K = SceneBindings.TriggerKind

type Spec = {
	id: string,
	folder: string, -- Buildings | TerrainProps | Decorations | Roads | Triggers | Spawns | LightingParts
	class: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	attrs: { [string]: any }?,
	shape: Enum.PartType?,
	light: { color: Color3, range: number, brightness: number }?,
	-- 길 검사 (clearCorridors — corridor() 선 기준): 길 위에 있어야 하는 것은 onPath. 길과 겹치면 clear="push" 는 group 째 길 밖으로,
	-- "drop" 은 뺀다(고리 장식). 둘 다 아니면 pathReport 에 남긴다 (2026-10-19 2차: 무대·가로등·표지·촛불이 길 위)
	onPath: boolean?,
	clear: string?,
	group: string?,
}

local specs: { Spec } = {}
local ids: { [string]: boolean } = {}

local function add(s: Spec)
	if ids[s.id] then
		error("duplicate spec id " .. s.id)
	end
	ids[s.id] = true
	table.insert(specs, s)
end

-- ===== 작은 도우미 =====
local function box(
	id: string,
	folder: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	mat: Enum.Material?,
	extra: { [string]: any }?
)
	local s: Spec = {
		id = id,
		folder = folder,
		size = size,
		cframe = cf,
		color = color,
		material = mat or Enum.Material.SmoothPlastic,
	}
	if extra then
		for k, v in pairs(extra) do
			(s :: any)[k] = v
		end
	end
	add(s)
end
local function deco(
	id: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	mat: Enum.Material?,
	extra: { [string]: any }?
)
	local e = extra or {}
	if e.canCollide == nil then
		e.canCollide = false
	end
	box(id, "Decorations", size, cf, color, mat, e)
end
-- 섬처럼 지형 표면이 0 이 아닌 구역은 Y_OFFSET 으로 통째로 올린다 (at() 을 쓰는 모든 도우미에 적용)
local Y_OFFSET = 0
local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y + Y_OFFSET, z)
end
local function facing(pos: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(pos, pos + dir)
end
local NZ = Vector3.new(0, 0, -1)
local PZ = Vector3.new(0, 0, 1)
local PX = Vector3.new(1, 0, 0)

-- 나무: 줄기 + 잎 2덩이. 바로 만들지 않고 모아 두었다가(buildSpecs 끝) 운반 길과 겹치면 길 밖으로 민다
-- (2026-10-19 사용자: "나무는 왜 통과하는거야?" — 5·6일차 나무 12그루가 길 가운데에서 1~6 stud)
type PendingTree = { id: string, x: number, z: number, scale: number, leaf: Color3? }
local pendingTrees: { PendingTree } = {}
-- 걷는 길·물길: corridor() 가 채운다 (마감 패스 2026-10-21: SEG 트리거는 없앴고 이 선은 나무 밀기·clearCorridors 기준으로만 쓴다).
-- lane = 나무만 비우는 구역(사격장). ground = 그 길의 바닥 높이(물길은 수면)
type SegLine = { a: Vector3, b: Vector3, w: number, id: string?, day: number?, ground: number?, lane: boolean? }
local segLines: { SegLine } = {}
local function tree(id: string, x: number, z: number, scale: number, leaf: Color3?)
	table.insert(pendingTrees, { id = id, x = x, z = z, scale = scale, leaf = leaf })
end
local function emitTree(id: string, x: number, z: number, scale: number, leaf: Color3?)
	local y = 0
	box(
		id .. "_Trunk",
		"TerrainProps",
		Vector3.new(1.4 * scale, 7 * scale, 1.4 * scale),
		at(x, y + 3.5 * scale, z),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	deco(
		id .. "_Leaf1",
		Vector3.new(7 * scale, 7 * scale, 7 * scale),
		at(x, y + 8.5 * scale, z),
		leaf or Palette.Leaf,
		Enum.Material.Grass,
		{ shape = Enum.PartType.Ball }
	)
	deco(
		id .. "_Leaf2",
		Vector3.new(5 * scale, 5 * scale, 5 * scale),
		at(x + 1.5 * scale, y + 11 * scale, z - 1 * scale),
		leaf or Palette.Grass,
		Enum.Material.Grass,
		{ shape = Enum.PartType.Ball }
	)
end

-- 깃발 기둥 + 깃발 (Flag 속성 → 클라이언트 펄럭임)
local function flag(id: string, pos: Vector3, h: number, color: Color3, label: string?)
	box(
		id .. "_Pole",
		"Buildings",
		Vector3.new(0.4, h, 0.4),
		at(pos.X, pos.Y + h / 2, pos.Z),
		Palette.Stone,
		Enum.Material.Metal,
		{ canCollide = false }
	)
	deco(
		id .. "_Flag",
		Vector3.new(4.5, 2.8, 0.15),
		at(pos.X + 2.4, pos.Y + h - 1.6, pos.Z),
		color,
		Enum.Material.Fabric,
		{
			attrs = if label
				then { Flag = true, SignText = label, SignLight = true, SignBothSides = true }
				else { Flag = true },
		}
	)
end

-- 그날 도착 깃발 (19_UI_MAP_STYLE §9): 날마다 같은 모양 — 높이 24 기둥 + 큰 빨간 깃발("n일차") + 꼭대기 등(밤에 켜짐).
-- 할 일 판 "…깃발까지" 의 그 깃발. 나무 잎(꼭대기 ≤ 16)보다 높고, 1일차 출발 카메라(높이 14)에서 290 stud 앞 북문 가로대(15.4) 위로 보인다
local GOAL_FLAG_H = 24
local function goalFlag(id: string, pos: Vector3, label: string)
	box(
		id .. "_Pole",
		"Buildings",
		Vector3.new(0.7, GOAL_FLAG_H, 0.7),
		at(pos.X, pos.Y + GOAL_FLAG_H / 2, pos.Z),
		Palette.Stone,
		Enum.Material.Metal,
		{ canCollide = false }
	)
	deco(
		id .. "_Flag",
		Vector3.new(8, 5, 0.2),
		at(pos.X + 4.4, pos.Y + GOAL_FLAG_H - 3, pos.Z),
		Palette.Red,
		Enum.Material.Fabric,
		{ attrs = { Flag = true, SignText = label, SignLight = true, SignBothSides = true } }
	)
	box(
		id .. "_Top",
		"LightingParts",
		Vector3.new(1.4, 1.4, 1.4),
		at(pos.X, pos.Y + GOAL_FLAG_H + 0.7, pos.Z),
		Palette.Yellow,
		Enum.Material.Neon,
		{
			shape = Enum.PartType.Ball,
			canCollide = false,
			light = { color = Palette.Yellow, range = 20, brightness = 1.1 }, -- 마감 패스: 노을 밤 모닥불 옆에서 덜 번지게
		}
	)
end

-- 가로등 (밤에 보임): 기둥 + 네온 전구 + PointLight
local function lamp(id: string, x: number, z: number, h: number?, color: Color3?)
	local hh = h or 7
	box(
		id .. "_Post",
		"Buildings",
		Vector3.new(0.5, hh, 0.5),
		at(x, hh / 2, z),
		Palette.Ink,
		Enum.Material.Metal,
		{ canCollide = false, clear = "push", group = id }
	)
	box(
		id .. "_Bulb",
		"LightingParts",
		Vector3.new(1.3, 1.3, 1.3),
		at(x, hh + 0.4, z),
		color or Palette.Yellow,
		Enum.Material.Neon,
		{
			shape = Enum.PartType.Ball,
			canCollide = false,
			light = { color = color or Palette.Yellow, range = 26, brightness = 1.4 },
			clear = "push",
			group = id,
		}
	)
end

-- A 형 막사(텐트): 두 장의 기울어진 천 + 능선 막대 + 기둥 4 + 번호판
local function tent(id: string, x: number, z: number, w: number, l: number, h: number, numberKo: string?)
	local roofLen = math.sqrt((w / 2) ^ 2 + h ^ 2) + 0.6
	local ang = math.atan2(h, w / 2)
	for i, sx in ipairs({ -1, 1 }) do
		box(
			id .. "_Roof" .. i,
			"Buildings",
			Vector3.new(roofLen, 0.3, l),
			CFrame.new(x + sx * w / 4, h / 2, z) * CFrame.Angles(0, 0, -sx * ang),
			Palette.Olive,
			Enum.Material.Fabric
		)
	end
	box(
		id .. "_Ridge",
		"Buildings",
		Vector3.new(0.4, 0.4, l + 1),
		at(x, h + 0.1, z),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ canCollide = false }
	)
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		box(
			id .. "_Pole" .. i,
			"Buildings",
			Vector3.new(0.4, h, 0.4),
			at(x + c[1] * (w / 2 - 0.3), h / 2, z + c[2] * (l / 2 - 0.3)),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		-- 당김줄
		deco(
			id .. "_Rope" .. i,
			Vector3.new(0.08, 0.08, 3.2),
			CFrame.new(x + c[1] * (w / 2 + 1.1), 0.9, z + c[2] * (l / 2 - 0.3))
				* CFrame.Angles(0, math.rad(90), math.rad(-c[1] * 35)),
			Palette.Rope,
			Enum.Material.Fabric
		)
	end
	if numberKo then
		deco(
			id .. "_Sign",
			Vector3.new(2.4, 1.4, 0.2),
			at(x, 2.2, z + l / 2 + 0.2),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ attrs = { SignText = numberKo } }
		)
	end
	-- 침상 (안쪽 바닥 깔개)
	deco(id .. "_Mat", Vector3.new(w - 1.5, 0.25, l - 1.5), at(x, 0.13, z), Palette.Khaki, Enum.Material.Fabric)
end

-- 통나무 (가로로 누운 원통 — 6일차 🌲 통나무 길에서 뛰어넘는 소품). 옛 OBST 판정 트리거는 마감 패스(2026-10-21)에 없앴다
local function logProp(id: string, folder: string, pos: Vector3, len: number, radius: number, yawDeg: number?)
	box(
		id,
		folder,
		Vector3.new(len, radius * 2, radius * 2),
		CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg or 0), 0),
		Palette.Wood,
		Enum.Material.Wood,
		{ shape = Enum.PartType.Cylinder, onPath = true }
	)
end

-- 길 방향 dir 을 가로지르게 눕힌 통나무의 yaw (원통 축 X 를 dir 에 수직으로)
local function yawAcross(dir: Vector3): number
	return math.deg(math.atan2(-dir.X, -dir.Z))
end

-- 길 선: a → b, 폭 w. 트리거는 만들지 않는다 (마감 패스 2026-10-21 — 옛 SEG 트리거는 아무도 안 읽었다).
-- 나무를 길 밖으로 밀고(buildSpecs) 길 위 장식을 빼는(clearCorridors) 기준. 땅 길은 a.Y = 2(바닥 0), 물길은 수면(-1)
local corridorCounter: { [number]: number } = {}
local function corridor(day: number, a: Vector3, b: Vector3, w: number?)
	corridorCounter[day] = (corridorCounter[day] or 0) + 1
	table.insert(segLines, {
		a = Vector3.new(a.X, 0, a.Z),
		b = Vector3.new(b.X, 0, b.Z),
		w = w or 12,
		id = string.format("COR_D%d_%02d", day, corridorCounter[day]),
		day = day,
		ground = if a.Y < 0 then a.Y else a.Y - 2,
	})
end

local function cp(id: string, day: number, pos: Vector3, dir: Vector3, size: Vector3?)
	add({
		id = id,
		folder = "Triggers",
		size = size or Vector3.new(18, 8, 18),
		cframe = facing(pos, dir),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.CP, StableId = id, Day = day },
	})
end

local function pad(id: string, index: number, pos: Vector3, dir: Vector3, sanWaits: boolean?, day: number?)
	-- 눈에 보이는 발판(노란 테두리 원판) + 판정 트리거
	box(
		"PADV_" .. id,
		"TerrainProps",
		Vector3.new(0.3, 5, 5),
		CFrame.new(pos.X, pos.Y - 0.35, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Yellow,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	add({
		id = "PAD_" .. id,
		folder = "Triggers",
		size = Vector3.new(5, 5, 5),
		cframe = facing(pos + Vector3.new(0, 2, 0), dir),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.PAD, Day = day or 2, PadIndex = index, PadId = id, SanWaits = sanWaits == true },
	})
end

local function fall(id: string, pos: Vector3, size: Vector3)
	add({
		id = "FALL_" .. id,
		folder = "Triggers",
		size = size,
		cframe = CFrame.new(pos),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.FALL },
	})
end

-- 자유 이동 스테이지 (22 v2): 깃발(목표, 아무 순서) — 기둥·빨간 천·꼭대기 등 + 8×8 트리거. 밟으면 분대가 환호한다
local function goalPoint(id: string, day: number, pos: Vector3, nameKo: string)
	box(
		id .. "_Pole",
		"Buildings",
		Vector3.new(0.5, 9, 0.5),
		at(pos.X, pos.Y + 4.5, pos.Z),
		Palette.Stone,
		Enum.Material.Metal,
		{ canCollide = false }
	)
	deco(
		id .. "_Cloth",
		Vector3.new(4, 2.6, 0.2),
		at(pos.X + 2.2, pos.Y + 7.4, pos.Z),
		Palette.Red,
		Enum.Material.Fabric,
		{
			attrs = { Flag = true, SignText = nameKo, SignLight = true, SignBothSides = true },
		}
	)
	box(
		id .. "_Top",
		"LightingParts",
		Vector3.new(1, 1, 1),
		at(pos.X, pos.Y + 9.4, pos.Z),
		Palette.Yellow,
		Enum.Material.Neon,
		{
			shape = Enum.PartType.Ball,
			canCollide = false,
			light = { color = Palette.Yellow, range = 18, brightness = 1.2 },
		}
	)
	deco(
		id .. "_Ring",
		Vector3.new(0.2, 8, 8),
		at(pos.X, pos.Y + 0.08, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Yellow,
		Enum.Material.SmoothPlastic,
		{
			shape = Enum.PartType.Cylinder,
			transparency = 0.5,
		}
	)
	add({
		id = id,
		folder = "Triggers",
		size = Vector3.new(8, 8, 8),
		cframe = at(pos.X, pos.Y + 4, pos.Z),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.FLAG or "FLAG", Day = day, FlagId = id, NameKo = nameKo }, -- Edit 모드 require 캐시 대비 (1249 와 같음)
	})
end

-- 영역: SEARCH(탐조등 빛 — 켜진 동안 안에서 움직이면 발각) · GATE(표적을 다 맞혀야 열리는 보이지 않는 벽)
local function zone(id: string, day: number, zoneType: string, cf: CFrame, size: Vector3, extra: { [string]: any }?)
	local attrs: { [string]: any } = { Kind = K.ZONE or "ZONE", Day = day, ZoneId = id, ZoneType = zoneType }
	for k, v in pairs(extra or {}) do
		attrs[k] = v
	end
	add({
		id = id,
		folder = "Triggers",
		size = size,
		cframe = cf,
		transparency = 1,
		canCollide = zoneType == "GATE",
		attrs = attrs,
	})
end

-- 넘기기 벽: 벽 + 양쪽 사다리(트러스) + 발판 표시 + 트리거(진행 방향 dir, 길이 14)
local function passWall(id: string, center: Vector3, dir: Vector3, width: number, height: number, _afterPad: string)
	-- v2(22): 유보트 없이 타고 넘는 벽 — 넘기기 트리거(PASS)·발판 표시는 뺐다 (2026-10-20). 사다리 트러스로 오른다
	local right = dir:Cross(Vector3.yAxis)
	box(
		id .. "_Wall",
		"TerrainProps",
		Vector3.new(width, height, 2),
		facing(center + Vector3.new(0, height / 2, 0), dir),
		Palette.WoodDark,
		Enum.Material.WoodPlanks
	)
	-- 벽 양옆 울타리(밧줄 기둥 + 보이지 않는 막음): 벽을 비켜 걸어가서 도착점에 닿던 것 (2026-10-20 플레이테스트, 21 §1-4)
	for i, sx in ipairs({ -1, 1 }) do
		local fc = center + right * (sx * (width / 2 + 15))
		add({
			id = id .. "_Fence" .. i,
			folder = "Triggers",
			size = Vector3.new(30, 14, 1),
			cframe = facing(Vector3.new(fc.X, 7, fc.Z), dir),
			transparency = 1,
			canCollide = true,
		})
		for j = 0, 3 do
			local pp = center + right * (sx * (width / 2 + 2 + j * 9))
			deco(
				string.format("%s_FencePost%d_%d", id, i, j),
				Vector3.new(0.35, 2.4, 0.35),
				at(pp.X, 1.2, pp.Z),
				Palette.WoodDark,
				Enum.Material.Wood
			)
		end
		local rp = center + right * (sx * (width / 2 + 2 + 13.5))
		deco(
			id .. "_FenceRope" .. i,
			Vector3.new(27.5, 0.15, 0.15),
			facing(Vector3.new(rp.X, 2.1, rp.Z), dir) * CFrame.Angles(0, math.rad(90), 0),
			Palette.Rope,
			Enum.Material.Fabric,
			{ attrs = { Rope = true } }
		)
	end
	box(
		id .. "_Top",
		"TerrainProps",
		Vector3.new(width + 0.6, 0.5, 2.6),
		facing(center + Vector3.new(0, height + 0.25, 0), dir),
		Palette.Wood,
		Enum.Material.Wood
	)
	for i, sgn in ipairs({ -1, 1 }) do
		add({
			id = id .. "_Ladder" .. i,
			folder = "TerrainProps",
			class = "TrussPart",
			size = Vector3.new(2, height, 2),
			cframe = facing(center + Vector3.new(0, height / 2, 0) - dir * sgn * 2 + right * 3, dir),
			color = Palette.Stone,
			material = Enum.Material.Metal,
			canCollide = true,
		})
	end
end

-- 부표: 노란 공 + 막대 + 작은 깃발 (Buoy 속성 → 흔들림)
local function buoy(id: string, x: number, z: number, numberKo: string)
	deco(
		id .. "_Ball",
		Vector3.new(3, 3, 3),
		at(x, -0.3, z),
		Palette.Yellow,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Ball, attrs = { Buoy = true } }
	)
	deco(
		id .. "_Pole",
		Vector3.new(0.3, 4, 0.3),
		at(x, 2.3, z),
		Palette.Ink,
		Enum.Material.Metal,
		{ attrs = { Buoy = true } }
	)
	deco(
		id .. "_Flag",
		Vector3.new(2, 1.4, 0.12),
		at(x + 1.1, 3.9, z),
		Palette.Red,
		Enum.Material.Fabric,
		{ attrs = { Flag = true, SignText = numberKo, SignLight = true, SignBothSides = true } }
	)
end

-- 게: 몸통 + 다리 (Crab 속성 → 종종걸음). 바닥 위

-- 모닥불 터: 돌 고리 8 + 장작 + 불꽃 파트(FireRing → 파티클·빛)
-- night 가 있으면 밤 모닥불 허브 (27 §3 · 28 §3, 1단계): FIRE 트리거(서버가 FireLevel 0..3 을 쓰고 클라이언트 CourseFx 가 불·빛·불티를 그린다)
-- + 통나무 의자 4 — 보이는 통나무(5.4) 한쪽 끝에 보이지 않는 Seat(앉는 자리), 다른 끝에 그 통나무의 분대원(1 두리 · 2 산 · 3 미르 · 4 빈자리).
-- 앉으면 서버가 그 사람의 오늘 이야기를 들려준다. angles = 통나무 각도(도) — 뒤집힌 유보트·소품을 피해 날마다 다르게
local SEAT_RADIUS = 5.2
local SEAT_MEMBERS = { "DURI", "SAN", "MIR" }
local function fireRing(id: string, x: number, z: number, lit: boolean, night: { day: number, angles: { number } }?)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local cf = at(x + math.cos(a) * 2.6, 0.45, z + math.sin(a) * 2.6) * CFrame.Angles(0, -a, 0)
		-- 마감 패스: 돌 고리도 바위 메시(통나무 의자·장작 메시 옆에 회색 상자가 남아 있었다)
		deco(id .. "_Stone" .. i, Vector3.new(1.2, 0.9, 1), cf, Palette.Stone, Enum.Material.Slate, {
			canCollide = true,
			attrs = {
				AssetKey = if i % 2 == 0 then "RockCluster_A" else "RockCluster_B",
				AssetPos = cf.Position - Vector3.new(0, 0.45, 0),
				AssetYaw = math.deg(-a) + i * 37,
				AssetHeight = 0.95,
				AssetSnap = true,
			},
		})
	end
	-- 불 밑 장작 둘: 마감 패스부터 통나무 메시(LogSeat — 곧은 통나무·나이테 끝)를 같은 크기로 늘려 입힌다
	for i, l in ipairs({ { y = 0.4, yaw = 30 }, { y = 0.7, yaw = -40 } }) do
		local cf = at(x, l.y, z) * CFrame.Angles(0, math.rad(l.yaw), 0)
		deco(id .. "_Log" .. i, Vector3.new(3.2, 0.6, 0.6), cf, Palette.WoodDark, Enum.Material.Wood, {
			shape = Enum.PartType.Cylinder,
			attrs = { AssetKey = "LogSeat", AssetCF = cf, AssetSize = Vector3.new(3.3, 0.62, 0.66) },
		})
	end
	if lit then
		deco(
			id .. "_Flame",
			Vector3.new(1.2, 1.2, 1.2),
			at(x, 1.4, z),
			Palette.Fire,
			Enum.Material.Neon,
			{ shape = Enum.PartType.Ball, transparency = 0.2, attrs = { FireRing = true } }
		)
	end
	if not night then
		-- 둘레 통나무 의자 3 (기지 모닥불: 밤이 없다)
		for i = 1, 3 do
			local a = math.rad(100 + i * 70)
			deco(
				id .. "_Seat" .. i,
				Vector3.new(3.4, 0.9, 0.9),
				at(x + math.cos(a) * 5.2, 0.45, z + math.sin(a) * 5.2) * CFrame.Angles(0, -a + math.rad(90), 0),
				Palette.Wood,
				Enum.Material.Wood,
				{ shape = Enum.PartType.Cylinder, canCollide = true }
			)
		end
		return
	end
	-- 밤 모닥불 중심: 불꽃 자리 (낮에는 보이지 않음. 클라이언트가 FireLevel 에 따라 그린다)
	add({
		id = id,
		folder = "Triggers",
		size = Vector3.new(1.4, 1.4, 1.4),
		cframe = at(x, 1.3, z),
		transparency = 1,
		canCollide = false,
		shape = Enum.PartType.Ball,
		attrs = { Kind = K.FIRE or "FIRE", FireId = id, Day = night.day, FireLevel = 0 }, -- K.X 폴백: Edit 모드 require 캐시 대비
	})
	local center = Vector3.new(x, 0, z)
	for i, deg in ipairs(night.angles) do
		local a = math.rad(deg)
		local lc = Vector3.new(x + math.cos(a) * SEAT_RADIUS, 0, z + math.sin(a) * SEAT_RADIUS) -- 통나무 가운데
		local t = Vector3.new(-math.sin(a), 0, math.cos(a)) -- 접선 (각도가 커지는 쪽)
		deco(
			id .. "_SeatLog" .. i,
			Vector3.new(5.4, 0.9, 0.9),
			at(lc.X, 0.45, lc.Z) * CFrame.Angles(0, a + math.rad(90), 0),
			Palette.Wood,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, canCollide = true }
		)
		-- 통나무 양 끝 받침돌 (통나무가 땅에 뜬 듯 보이지 않게)
		for j, sgn in ipairs({ -1, 1 }) do
			local sp = lc + t * (sgn * 2.2)
			deco(
				string.format("%s_SeatRock%d_%d", id, i, j),
				Vector3.new(1.1, 0.5, 0.9),
				at(sp.X, 0.2, sp.Z) * CFrame.Angles(0, a, 0),
				Palette.Stone,
				Enum.Material.Slate
			)
		end
		-- 앉는 자리: 통나무 한쪽 끝(접선 반대쪽), 불을 보고 앉는다. 분대원은 다른 끝(seat - RightVector × 3)
		local sp = lc - t * 1.5
		add({
			id = id .. "_Seat" .. i,
			folder = "Triggers",
			class = "Seat",
			size = Vector3.new(2.2, 0.6, 2.2),
			cframe = facing(Vector3.new(sp.X, 1.2 + Y_OFFSET, sp.Z), Vector3.new(center.X - sp.X, 0, center.Z - sp.Z)),
			transparency = 1,
			canCollide = true,
			attrs = {
				Kind = K.SEAT or "SEAT",
				FireId = id,
				SeatIndex = i,
				MemberId = SEAT_MEMBERS[i],
			},
		})
	end
end

-- 낮 줍기 (27 §2 · 28 §3, 1단계): 길가의 장작 묶음 / 물통. 트리거(PICKUP)는 Triggers 에, 보이는 묶음은 Decorations 에 PickupId 로 묶는다.
-- 서버 CampfireService 가 ProximityPrompt 를 달고, 주우면 묶음을 숨겼다가 RespawnSec 뒤 다시 놓는다 (세상 공유)
local function pickup(id: string, day: number, pickType: string, x: number, z: number, yawDeg: number?)
	local yaw = math.rad(yawDeg or 0)
	add({
		id = id,
		folder = "Triggers",
		size = Vector3.new(3, 3, 3),
		cframe = at(x, 1.5, z) * CFrame.Angles(0, yaw, 0),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.PICKUP or "PICKUP", PickId = id, PickType = pickType, Day = day, RespawnSec = 20 },
	})
	local tag = { PickupId = id }
	if pickType == "WATER" then
		-- 올리브 물통: 세운 원통 + 검은 뚜껑 + 끈
		deco(
			id .. "_Can",
			Vector3.new(1.1, 0.95, 0.95),
			at(x, 0.55, z) * CFrame.Angles(0, yaw, math.rad(90)),
			Palette.OliveDark,
			Enum.Material.Fabric,
			{ shape = Enum.PartType.Cylinder, attrs = tag }
		)
		deco(
			id .. "_Cap",
			Vector3.new(0.25, 0.42, 0.42),
			at(x, 1.22, z) * CFrame.Angles(0, yaw, math.rad(90)),
			Palette.Ink,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, attrs = tag }
		)
		deco(
			id .. "_Strap",
			Vector3.new(1.15, 0.22, 0.12),
			at(x, 0.7, z) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -0.5),
			Palette.Rope,
			Enum.Material.Fabric,
			{ attrs = tag }
		)
		return
	end
	-- 장작 묶음: 통나무 토막 2+1 + 밧줄 띠
	local base = at(x, 0, z) * CFrame.Angles(0, yaw, 0)
	for i, off in ipairs({ Vector3.new(0, 0.28, -0.3), Vector3.new(0, 0.28, 0.3), Vector3.new(0.1, 0.78, 0) }) do
		deco(
			id .. "_Log" .. i,
			Vector3.new(2.2, 0.56, 0.56),
			base * CFrame.new(off) * CFrame.Angles(0, 0, math.rad((i - 2) * 4)),
			if i == 3 then Palette.Wood else Palette.WoodDark,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, attrs = tag }
		)
	end
	deco(
		id .. "_Band",
		Vector3.new(0.35, 1.3, 1.3),
		base * CFrame.new(0, 0.5, 0),
		Palette.Rope,
		Enum.Material.Fabric,
		{ shape = Enum.PartType.Cylinder, attrs = tag }
	)
end

-- 쉼터: 작은 천막 + 물통 + 벤치 + 깃발
local function shelter(id: string, x: number, z: number, labelKo: string)
	tent(id .. "_Tent", x + 10, z, 8, 10, 5)
	deco(
		id .. "_Bench",
		Vector3.new(6, 0.4, 1.2),
		at(x - 6, 1.0, z),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ canCollide = true }
	)
	deco(id .. "_BenchLeg1", Vector3.new(0.5, 0.8, 1.2), at(x - 8.5, 0.4, z), Palette.WoodDark, Enum.Material.Wood)
	deco(id .. "_BenchLeg2", Vector3.new(0.5, 0.8, 1.2), at(x - 3.5, 0.4, z), Palette.WoodDark, Enum.Material.Wood)
	deco(
		id .. "_WaterJug",
		Vector3.new(1.4, 2, 1.4),
		at(x - 6, 1, z + 2.5),
		Palette.Sea,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	deco(
		id .. "_Cups",
		Vector3.new(1.6, 0.4, 0.8),
		at(x - 4.5, 0.2, z + 2.5),
		Palette.Cream,
		Enum.Material.SmoothPlastic
	)
	goalFlag(id .. "_Flag", Vector3.new(x - 10, 0, z - 6), labelKo .. "일차") -- 그날 도착 깃발 (19 §9: 예전 높이 9 는 출발에서 안 보임)
end

-- ===== 유보트 꾸미기 마당 (27 §3 1-A · 28 §3, 2026-10-21 3단계) =====
-- 연병장 동쪽 북부: 거치대(나무 받침 둘 + 용골 받침) 위에 유보트, 둘레에 부품 더미(PILE)·자리 발판(SEATPAD)·출발 깃발(PILE GO).
-- 자리: 1일차 옛 운반 길(x 0, z −16 → −62, 반폭 6)과 CP6(x −4..8, z −56..−36)·무대(x 17..27, z ≤ −33)·북문 표지판(−8,−22)·가로등(30,−20)을 비켜
-- 가운데 (20, −20). 유보트는 북쪽(−z, 북문 쪽)을 본다. 트리거는 Triggers, 보이는 것은 Decorations/Buildings. id 접두 BD_
local YARD = Vector3.new(20, 0, -20)
local function buildYard()
	local X, Z = YARD.X, YARD.Z
	local K_PILE = K.PILE or "PILE" -- Edit 모드 require 캐시 대비 폴백 (기존 관례)
	local K_PAD = K.SEATPAD or "SEATPAD"
	-- 작업장 바닥(나무 깔판) + 테두리 각목
	box("BD_Deck", "TerrainProps", Vector3.new(12, 0.2, 21), at(X, 0.4, Z), Palette.Wood, Enum.Material.WoodPlanks)
	for i, sx in ipairs({ -1, 1 }) do
		deco(
			"BD_DeckEdge" .. i,
			Vector3.new(0.4, 0.28, 21.4),
			at(X + sx * 6.1, 0.44, Z),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	-- 거치대: 나무 받침(가로대 + A 다리) 둘 + 용골 받침 (유보트 바닥이 그 위 — BoatService.place 가 땅으로 읽는다)
	for i, dz in ipairs({ -4.5, 4.5 }) do
		box(
			"BD_RackBar" .. i,
			"Buildings",
			Vector3.new(6.4, 0.45, 0.6),
			at(X, 2.05, Z + dz),
			Palette.WoodDark,
			Enum.Material.Wood
		)
		for j, sx in ipairs({ -1, 1 }) do
			for k, sz in ipairs({ -1, 1 }) do
				deco(
					string.format("BD_RackLeg%d_%d%d", i, j, k),
					Vector3.new(0.35, 1.5, 0.35),
					at(X + sx * 2.7, 1.2, Z + dz + sz * 0.35) * CFrame.Angles(math.rad(sz * 14), 0, 0),
					Palette.WoodDark,
					Enum.Material.Wood
				)
			end
		end
		-- 받침 위 고무 패드 (튜브가 닿는 자리)
		for j, sx in ipairs({ -1, 1 }) do
			deco(
				string.format("BD_RackPad%d_%d", i, j),
				Vector3.new(1.4, 0.14, 0.7),
				at(X + sx * 2.6, 2.33, Z + dz),
				Palette.Ink,
				Enum.Material.Rubber
			)
		end
	end
	box(
		"BD_RackKeel",
		"Buildings",
		Vector3.new(0.6, 0.35, 13),
		at(X, 1.775, Z),
		Palette.Wood,
		Enum.Material.Wood,
		{ canCollide = true }
	)
	add({
		id = "BD_Rack",
		folder = "Triggers",
		size = Vector3.new(1, 1, 1),
		cframe = facing(Vector3.new(X, 1.95, Z), NZ),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K_PILE, PartType = "RACK" },
	})
	-- 마당 입구 아치 (남쪽): 나무 기둥 둘 + 올리브 판 "🛠️ 유보트 꾸미기". 판 밑 10.5 — 입구에 선 아이 뒤 카메라가 판에 가리지 않게 (Studio 1차: 6.6 이면 첫 화면을 가림)
	for i, sx in ipairs({ -1, 1 }) do
		box(
			"BD_ArchPost" .. i,
			"Buildings",
			Vector3.new(0.7, 12.4, 0.7),
			at(X + sx * 7.2, 6.2, Z + 16),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = true }
		)
	end
	deco(
		"BD_ArchBoard",
		Vector3.new(13, 1.8, 0.3),
		facing(Vector3.new(X, 11.4, Z + 16), PZ),
		Palette.OliveDark,
		Enum.Material.Fabric,
		{ attrs = { SignText = "🛠️ 유보트 꾸미기", SignLight = true, SignBothSides = true } }
	)
	-- 자리 발판 4: 유보트 옆, 그 자리 줄(앞 = 앞자리 −1.5, 뒤 = 뒷자리 +4)에. 노란 원(서는 곳) + 기둥 표지(SignText)
	local seatSide = { FL = -1, BL = -1, FR = 1, BR = 1 }
	local seatDz = { FL = -1.5, FR = -1.5, BL = 4.0, BR = 4.0 }
	local seatKo = { FL = "앞 왼쪽", FR = "앞 오른쪽", BL = "뒤 왼쪽", BR = "뒤 오른쪽" }
	for _, key in ipairs({ "FL", "FR", "BL", "BR" }) do
		local sx = seatSide[key]
		local px, pz = X + sx * 5.8, Z + seatDz[key]
		add({
			id = "BD_SeatPad_" .. key,
			folder = "Triggers",
			size = Vector3.new(2.8, 0.3, 2.8),
			cframe = facing(Vector3.new(px, 0.6, pz), Vector3.new(-sx, 0, 0)),
			color = Palette.Wood,
			material = Enum.Material.WoodPlanks,
			canCollide = true,
			attrs = { Kind = K_PAD, SeatKey = key },
		})
		deco(
			"BD_SeatPad_" .. key .. "_Ring",
			Vector3.new(0.06, 2.3, 2.3),
			CFrame.new(px, 0.78, pz) * CFrame.Angles(0, 0, math.rad(90)),
			Palette.Yellow,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, transparency = 0.25 }
		)
		-- 표지 기둥: 발판 바깥 모서리, 판은 바깥(아이가 다가오는 쪽)을 본다
		local postX = px + sx * 1.9
		local postZ = pz + (if seatDz[key] < 0 then -1.1 else 1.1)
		box(
			"BD_SeatPad_" .. key .. "_Post",
			"Buildings",
			Vector3.new(0.3, 3.0, 0.3),
			at(postX, 1.5, postZ),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		deco(
			"BD_SeatPad_" .. key .. "_Sign",
			Vector3.new(2.2, 0.9, 0.12),
			facing(Vector3.new(postX, 3.1, postZ), Vector3.new(sx, 0, 0)),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ attrs = { SignText = "🪑 " .. seatKo[key], SignBothSides = true } }
		)
	end
	-- 부품 더미: 트리거(보이지 않는 3×3) + 보이는 소품. face = 아이가 서는 쪽(유보트 쪽)
	local function pileTrigger(id: string, partType: string, pos: Vector3, face: Vector3)
		add({
			id = id,
			folder = "Triggers",
			size = Vector3.new(2.6, 2.6, 2.6),
			cframe = facing(pos, face),
			transparency = 1,
			canCollide = false,
			attrs = { Kind = K_PILE, PartType = partType },
		})
	end
	local function pileSign(id: string, pos: Vector3, face: Vector3, text: string)
		deco(
			id .. "_Sign",
			Vector3.new(2.6, 0.8, 0.12),
			facing(pos, face),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ attrs = { SignText = text, SignBothSides = true } }
		)
	end
	-- 서쪽 줄(x 7.8, 동쪽 = 유보트 쪽을 본다): 긴 노 · 짧은 노 · 스티커 판
	local WX = X - 12.2
	for i, spec in ipairs({
		{
			id = "BD_OarLong",
			pt = "OAR_LONG",
			z = Z - 5,
			len = 6.6,
			blade = Vector3.new(0.14, 2.0, 1.15),
			sign = "🥢 긴 노",
		},
		{
			id = "BD_OarShort",
			pt = "OAR_SHORT",
			z = Z + 0.5,
			len = 4.4,
			blade = Vector3.new(0.14, 1.4, 0.9),
			sign = "🥄 짧은 노",
		},
	}) do
		-- 노 받침: 기둥 둘 + 가로대, 노 둘이 기대 선다
		for j, sz in ipairs({ -1, 1 }) do
			box(
				string.format("%s_Stand%d", spec.id, j),
				"Buildings",
				Vector3.new(0.35, 3.2, 0.35),
				at(WX - 0.6, 1.6, spec.z + sz * 1.3),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = true }
			)
		end
		deco(
			spec.id .. "_StandBar",
			Vector3.new(0.3, 0.3, 3.0),
			at(WX - 0.6, 2.9, spec.z),
			Palette.Wood,
			Enum.Material.Wood
		)
		for j, sz in ipairs({ -0.55, 0.55 }) do
			local base = at(WX, spec.len / 2 * 0.97 + 0.3, spec.z + sz) * CFrame.Angles(0, 0, math.rad(8))
			-- 마감 패스: 노 메시(OarLong, 유보트·손 소품과 같은 메시) — 모델 +X(날)를 아래로, 날 너비를 Z 로. 날·손잡이 테이프는 대체 파트
			local shaftId = string.format("%s_Shaft%d", spec.id, j)
			deco(shaftId, Vector3.new(0.24, spec.len, 0.24), base, Palette.Wood, Enum.Material.Wood, {
				attrs = {
					AssetKey = "OarLong",
					AssetCF = base
						* CFrame.new(0, -0.2, 0)
						* CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(0, 0, 1)),
					AssetSize = Vector3.new(spec.len + 0.5, spec.blade.Z, 0.26),
				},
			})
			-- 날은 아래(땅 쪽)로
			deco(
				string.format("%s_Blade%d", spec.id, j),
				spec.blade,
				base * CFrame.new(0, -spec.len / 2 + spec.blade.Y / 2 - 0.1, 0),
				Palette.Ink,
				Enum.Material.SmoothPlastic,
				{ attrs = { AssetFallback = shaftId } }
			)
			-- 손잡이 끝 노란 테이프 (긴 노·짧은 노 구분 + 때깔)
			deco(
				string.format("%s_Grip%d", spec.id, j),
				Vector3.new(0.3, 0.45, 0.3),
				base * CFrame.new(0, spec.len / 2 - 0.4, 0),
				if i == 1 then Palette.Yellow else Palette.Cream,
				Enum.Material.Fabric
			)
		end
		pileSign(spec.id, Vector3.new(WX + 0.9, 1.1, spec.z), PX, spec.sign)
		pileTrigger(spec.id, spec.pt, Vector3.new(WX + 0.4, 1.8, spec.z), PX)
	end
	-- 스티커 판: 다리 둘 + 판(동쪽을 본다) + 둥근 스티커 셋 (스티커 글자는 클라이언트가 StickerEmoji 로 Left 면에 그린다 → 180° 돌려 동쪽)
	local SZ = Z + 6.6
	for j, sz in ipairs({ -1, 1 }) do
		box(
			"BD_StickerBoard_Leg" .. j,
			"Buildings",
			Vector3.new(0.35, 3.6, 0.35),
			at(WX - 0.2, 1.8, SZ + sz * 3.2),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = true }
		)
	end
	deco(
		"BD_StickerBoard",
		Vector3.new(0.25, 2.4, 6.8),
		at(WX - 0.05, 2.5, SZ),
		Palette.Cream,
		Enum.Material.WoodPlanks
	)
	deco(
		"BD_StickerBoard_Top",
		Vector3.new(0.5, 0.3, 7.2),
		at(WX - 0.05, 3.8, SZ),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	for j, st in ipairs({
		{ pt = "STICKER_A", emoji = "⭐", color = Palette.Yellow },
		{ pt = "STICKER_B", emoji = "🌊", color = Palette.SeaFoam },
		{ pt = "STICKER_C", emoji = "🐳", color = Color3.fromHex("9ED0E8") },
	}) do
		local sz = SZ + (j - 2) * 2.2
		deco(
			"BD_Sticker" .. j,
			Vector3.new(0.12, 1.5, 1.5),
			CFrame.new(WX + 0.14, 2.5, sz) * CFrame.Angles(0, math.pi, 0),
			st.color,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, attrs = { StickerEmoji = st.emoji } }
		)
		pileTrigger("BD_Sticker" .. j .. "_Pile", st.pt, Vector3.new(WX + 0.8, 2.2, sz), PX)
	end
	-- 동쪽 줄(x 34, 서쪽 = 유보트 쪽을 본다): 물통 · 구급상자 · 간식
	local EX = X + 14
	-- 물통: 나무 깔판 + 올리브 물통 3(둘 아래·하나 위) + 검은 뚜껑
	deco("BD_Water_Pallet", Vector3.new(2.6, 0.3, 2.6), at(EX, 0.45, Z - 5), Palette.Wood, Enum.Material.WoodPlanks)
	for j, off in ipairs({ Vector3.new(0, 1.3, -0.62), Vector3.new(0, 1.3, 0.62), Vector3.new(0.1, 2.75, 0) }) do
		local c = CFrame.new(EX + off.X, off.Y, Z - 5 + off.Z) * CFrame.Angles(0, math.rad((j - 2) * 6), 0)
		-- 마감 패스: 물통 메시(Jerrycan, 모델 X 를 기본 물통의 긴 Z 로) — 뚜껑·손잡이는 대체 파트
		local canId = "BD_Water_Can" .. j
		deco(canId, Vector3.new(0.8, 1.7, 1.15), c, Palette.OliveDark, Enum.Material.SmoothPlastic, {
			canCollide = true,
			attrs = {
				AssetKey = "Jerrycan",
				AssetCF = c * CFrame.Angles(0, math.rad(90), 0),
				AssetSize = Vector3.new(1.08, 1.7, 1.0),
			},
		})
		deco(
			"BD_Water_Cap" .. j,
			Vector3.new(0.32, 0.25, 0.32),
			c * CFrame.new(0, 0.95, 0.3),
			Palette.Ink,
			Enum.Material.SmoothPlastic,
			{ attrs = { AssetFallback = canId } }
		)
		deco(
			"BD_Water_Handle" .. j,
			Vector3.new(0.18, 0.18, 0.7),
			c * CFrame.new(0, 0.95, -0.2),
			Palette.Ink,
			Enum.Material.SmoothPlastic,
			{ attrs = { AssetFallback = canId } }
		)
	end
	pileSign("BD_Water", Vector3.new(EX - 1.6, 1.1, Z - 5), -PX, "💧 물통")
	pileTrigger("BD_Water", "WATER", Vector3.new(EX - 0.6, 1.6, Z - 5), -PX)
	-- 구급상자: 작은 탁자 + 크림 상자 둘(올리브 띠 — 붉은 십자 표식 없음)
	deco(
		"BD_Aid_Table",
		Vector3.new(2.4, 0.25, 2.6),
		at(EX, 1.3, Z + 0.5),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ canCollide = true }
	)
	for j, sz in ipairs({ -1, 1 }) do
		for k, sx in ipairs({ -1, 1 }) do
			deco(
				string.format("BD_Aid_Leg%d%d", j, k),
				Vector3.new(0.25, 1.2, 0.25),
				at(EX + sx * 1.0, 0.6, Z + 0.5 + sz * 1.1),
				Palette.WoodDark,
				Enum.Material.Wood
			)
		end
	end
	for j, off in ipairs({ Vector3.new(0, 1.85, -0.55), Vector3.new(0.1, 1.85, 0.6), Vector3.new(0, 2.6, 0) }) do
		local c = CFrame.new(EX + off.X, off.Y, Z + 0.5 + off.Z) * CFrame.Angles(0, math.rad((j - 2) * 9), 0)
		local size = if j == 3 then Vector3.new(0.9, 0.6, 0.9) else Vector3.new(1.0, 0.8, 1.1)
		-- 마감 패스: 구급상자 메시(FirstAidBox, 붉은 십자 없음) — 띠는 대체 파트
		local boxId = "BD_Aid_Box" .. j
		deco(boxId, size, c, Palette.Cream, Enum.Material.SmoothPlastic, {
			attrs = {
				AssetKey = "FirstAidBox",
				AssetCF = c * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0.05, 0),
				AssetSize = if j == 3 then Vector3.new(0.9, 0.72, 0.62) else Vector3.new(1.1, 0.9, 0.78),
			},
		})
		deco(
			"BD_Aid_Band" .. j,
			Vector3.new(size.X + 0.04, 0.2, size.Z + 0.04),
			c,
			Palette.Olive,
			Enum.Material.Fabric,
			{ attrs = { AssetFallback = boxId } }
		)
	end
	pileSign("BD_Aid", Vector3.new(EX - 1.6, 1.1, Z + 0.5), -PX, "🩹 구급상자")
	pileTrigger("BD_Aid", "AID", Vector3.new(EX - 0.6, 2.0, Z + 0.5), -PX)
	-- 간식: 나무 상자 + 주먹밥 셋(흰 공 + 검은 김 띠)
	deco(
		"BD_Snack_Crate",
		Vector3.new(2.0, 1.1, 1.6),
		at(EX, 0.85, Z + 6),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ canCollide = true }
	)
	deco("BD_Snack_Rim", Vector3.new(2.1, 0.15, 1.7), at(EX, 1.45, Z + 6), Palette.WoodDark, Enum.Material.Wood)
	for j = 1, 3 do
		local c = CFrame.new(EX - 0.6 + (j - 1) * 0.6, 1.75, Z + 6 + (if j == 2 then 0.25 else -0.2))
		deco(
			"BD_Snack_Ball" .. j,
			Vector3.new(0.62, 0.6, 0.62),
			c,
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Ball }
		)
		deco(
			"BD_Snack_Nori" .. j,
			Vector3.new(0.3, 0.32, 0.66),
			c * CFrame.new(0, -0.1, 0),
			Palette.Ink,
			Enum.Material.Fabric
		)
	end
	pileSign("BD_Snack", Vector3.new(EX - 1.4, 1.1, Z + 7.6), -PX, "🍙 간식")
	pileTrigger("BD_Snack", "SNACK", Vector3.new(EX - 0.4, 1.6, Z + 6), -PX)
	-- 깃발 통: 북동쪽, 통 + 작은 깃발 셋 (펄럭임은 Flag 속성)
	local FX, FZ = X + 11, Z - 10.5
	deco(
		"BD_Flag_Bucket",
		Vector3.new(1.4, 1.4, 1.4),
		CFrame.new(FX, 0.7, FZ) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Olive,
		Enum.Material.Metal,
		{ shape = Enum.PartType.Cylinder, canCollide = true }
	)
	for j = 1, 3 do
		local a = math.rad(j * 120)
		local px, pz = FX + math.cos(a) * 0.35, FZ + math.sin(a) * 0.35
		deco(
			"BD_Flag_Pole" .. j,
			Vector3.new(0.12, 3.2 + j * 0.2, 0.12),
			CFrame.new(px, 1.6 + j * 0.1, pz) * CFrame.Angles(math.rad((j - 2) * 6), 0, math.rad((j - 2) * 5)),
			Palette.WoodDark,
			Enum.Material.Wood
		)
		deco(
			"BD_Flag_Cloth" .. j,
			Vector3.new(1.3, 0.8, 0.06),
			CFrame.new(px + 0.7, 2.75 + j * 0.3, pz),
			if j == 2 then Palette.Yellow else Palette.Red,
			Enum.Material.Fabric,
			{ attrs = { Flag = true } }
		)
	end
	pileSign("BD_Flag", Vector3.new(FX, 1.0, FZ + 1.1), PZ, "🚩 깃발")
	pileTrigger("BD_Flag", "FLAG", Vector3.new(FX, 1.8, FZ), PZ)
	-- 출발 깃발 (북서쪽, 북문 쪽 끝): 노란 원 + 기둥 + 노란 깃발 "출발!" (밤엔 꼭대기 등)
	local GX, GZ = X - 7.5, Z - 11.5 -- 노 더미에서 7.8 (출발 프롬프트 5 와 겹치지 않게 — Studio 1차: 긴 노를 집으려다 출발이 눌림)
	deco(
		"BD_Go_Ring",
		Vector3.new(0.06, 4.4, 4.4),
		CFrame.new(GX, 0.36, GZ) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Yellow,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, transparency = 0.3 }
	)
	box(
		"BD_Go_Pole",
		"Buildings",
		Vector3.new(0.45, 8, 0.45),
		at(GX, 4, GZ),
		Palette.Stone,
		Enum.Material.Metal,
		{ canCollide = true }
	)
	deco(
		"BD_Go_Flag",
		Vector3.new(4.2, 2.4, 0.14),
		facing(Vector3.new(GX + 2.3, 6.6, GZ), PZ),
		Palette.Yellow,
		Enum.Material.Fabric,
		{ attrs = { Flag = true, SignText = "🚩 출발!", SignBothSides = true } }
	)
	box("BD_Go_Top", "LightingParts", Vector3.new(0.9, 0.9, 0.9), at(GX, 8.4, GZ), Palette.Yellow, Enum.Material.Neon, {
		shape = Enum.PartType.Ball,
		canCollide = false,
		light = { color = Palette.Yellow, range = 16, brightness = 1 },
	})
	pileTrigger("BD_Go", "GO", Vector3.new(GX, 2.2, GZ), PZ)

	-- ===== 첫 1분 (28 §7, 2026-10-21 · FM_*): 스폰 → 꾸미기 마당 =====
	-- 1일차 전 기지에서 유보트는 거치대에 있고(SessionService.placeAtCamp), 나는 스폰 앞 FM_StartSpot 에서 마당을 본다.
	-- 바닥 노란 화살표(Neon, 클라이언트 WayFx 가 앞으로 흐르듯 깜빡이고 1일차가 아니면 숨김) → 아치 앞 노란 발판 →
	-- 입구 상자 FM_YardGate(보이지 않음, 마당 전체 + 발판)에 들어서면 1일차 시작 (WelcomeService). 트리거에 Kind 없음(SceneBindings 무시)
	local startPos = Vector3.new(14, 3.3, 30) -- 스폰(14, 34) 바로 앞
	local padPos = Vector3.new(X, 0.38, Z + 19) -- 아치(Z+16) 앞 3
	add({
		id = "FM_StartSpot",
		folder = "Triggers",
		size = Vector3.new(1, 1, 1),
		cframe = CFrame.lookAt(startPos, Vector3.new(padPos.X, startPos.Y, padPos.Z)),
		transparency = 1,
		canCollide = false,
		attrs = { FirstMinute = "START" },
	})
	add({
		id = "FM_YardGate",
		folder = "Triggers",
		size = Vector3.new(30, 8, 32), -- x 5~35 (노 더미 7.8 ~ 물통 34), z −32~0 (무대 −33 앞에서 끊음) → 앞면 Z+20 = 발판 가운데 조금 앞
		cframe = facing(Vector3.new(X, 4, Z + 20 - 16), NZ),
		transparency = 1,
		canCollide = false,
		attrs = { FirstMinute = "GATE" },
	})
	-- 아치 앞 발판: 노란 고리 + 안쪽 원 (19 §2 노랑 = 지금 볼 곳). Decorations 의 Neon 은 낮에도 빛난다
	deco(
		"FM_YardPad",
		Vector3.new(0.08, 6.2, 6.2),
		CFrame.new(padPos) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Yellow,
		Enum.Material.Neon,
		{ shape = Enum.PartType.Cylinder, transparency = 0.35, attrs = { FirstMinute = "PAD" } }
	)
	deco(
		"FM_YardPadIn",
		Vector3.new(0.1, 4.6, 4.6),
		CFrame.new(padPos + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Sand,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, transparency = 0.1, attrs = { FirstMinute = "PADIN" } }
	)
	-- 바닥 화살표(갈매기 ^): 스폰 앞 → 발판, 3.4 간격. 두 막대가 끝에서 만난다
	local a0 = Vector3.new(startPos.X, 0.38, startPos.Z - 4)
	local a1 = Vector3.new(padPos.X, 0.38, padPos.Z + 4.2)
	local dir = (a1 - a0).Unit
	local n = math.floor((a1 - a0).Magnitude / 3.4) + 1
	for i = 1, n do
		local tip = a0 + dir * ((i - 1) * 3.4)
		local base = CFrame.lookAt(tip, tip + dir)
		for j, sx in ipairs({ -1, 1 }) do
			local bar = base * CFrame.Angles(0, math.rad(sx * 40), 0) * CFrame.new(0, 0, 1.25)
			deco(
				string.format("FM_Arrow%d_%d", i, j),
				Vector3.new(0.75, 0.06, 2.7),
				bar,
				Palette.Yellow,
				Enum.Material.Neon,
				{ transparency = 0.1, attrs = { FirstMinute = "ARROW", Index = i } }
			)
			-- 어두운 테두리 (모래 위 노랑은 대비가 약했다 — Studio 1차 캡처). 화살표와 같이 보이고 숨는다
			deco(
				string.format("FM_Arrow%d_%dE", i, j),
				Vector3.new(1.25, 0.05, 3.2),
				bar * CFrame.new(0, -0.02, 0),
				Palette.Ink,
				Enum.Material.SmoothPlastic,
				{ transparency = 0.45, attrs = { FirstMinute = "EDGE" } }
			)
		end
	end
end

-- ===== 장면 =====
local function buildBase()
	-- 연병장 판 + 흰 선
	box("Parade_Slab", "TerrainProps", Vector3.new(120, 0.3, 120), at(0, 0.15, 0), Palette.Sand, Enum.Material.Concrete)
	for i = -2, 2 do
		deco(
			"Parade_Line" .. (i + 3),
			Vector3.new(90, 0.05, 0.4),
			at(0, 0.33, i * 12 - 10),
			Palette.Cream,
			Enum.Material.SmoothPlastic
		)
	end
	deco(
		"Parade_Center",
		Vector3.new(0.1, 10, 10),
		CFrame.new(0, 0.33, -10) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Cream, -- 빨강은 목적지(북문 판·깃발·출발 표지)에만 (19_UI_MAP_STYLE 60/30/10)
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, transparency = 0.3 }
	)
	-- 입소 아치
	for i, sx in ipairs({ -1, 1 }) do
		box(
			"Arch_Pillar" .. i,
			"Buildings",
			Vector3.new(2, 11, 2),
			at(sx * 9, 5.5, 70),
			Palette.WoodDark,
			Enum.Material.WoodPlanks
		)
		-- 전구는 Lighting_Parts 에 두어야 CourseFx 가 낮에 끈다 (Studio 2026-10-19 5차: Decorations 의 Neon 은 낮에도 노랗게 빛남)
		box(
			"Arch_Lamp" .. i,
			"LightingParts",
			Vector3.new(1, 1, 1),
			at(sx * 9, 11.6, 70),
			Palette.Yellow,
			Enum.Material.Neon,
			{
				shape = Enum.PartType.Ball,
				canCollide = false,
				light = { color = Palette.Yellow, range = 18, brightness = 1 },
			}
		)
	end
	box("Arch_Beam", "Buildings", Vector3.new(22, 3.2, 0.6), at(0, 11.6, 70), Palette.Red, Enum.Material.Fabric, {
		canCollide = false,
		attrs = { SignText = "🧢 환영! 한 배 타자 극기캠프", SignLight = true, SignBothSides = true },
	})
	deco(
		"Arch_Rope1",
		Vector3.new(0.1, 0.1, 6),
		CFrame.new(-6, 12.8, 70) * CFrame.Angles(0, math.rad(90), math.rad(20)),
		Palette.Rope,
		Enum.Material.Fabric
	)
	deco(
		"Arch_Rope2",
		Vector3.new(0.1, 0.1, 6),
		CFrame.new(6, 12.8, 70) * CFrame.Angles(0, math.rad(90), math.rad(-20)),
		Palette.Rope,
		Enum.Material.Fabric
	)
	-- 막사 4동
	tent("Barracks1", -45, 22, 10, 16, 6, "1소대")
	tent("Barracks2", -45, 0, 10, 16, 6, "2소대")
	tent("Barracks3", 45, 22, 10, 16, 6, "3소대")
	tent("Barracks4", 45, 0, 10, 16, 6, "4소대")
	-- 식당
	box("Mess_Body", "Buildings", Vector3.new(26, 7, 14), at(-60, 3.5, -45), Palette.Wood, Enum.Material.WoodPlanks)
	box(
		"Mess_Roof1",
		"Buildings",
		Vector3.new(14.5, 0.4, 15),
		CFrame.new(-66.3, 8.6, -45) * CFrame.Angles(0, 0, math.rad(22)),
		Palette.OliveDark,
		Enum.Material.Fabric
	)
	box(
		"Mess_Roof2",
		"Buildings",
		Vector3.new(14.5, 0.4, 15),
		CFrame.new(-53.7, 8.6, -45) * CFrame.Angles(0, 0, math.rad(-22)),
		Palette.OliveDark,
		Enum.Material.Fabric
	)
	box(
		"Mess_Chimney",
		"Buildings",
		Vector3.new(1.6, 4, 1.6),
		at(-54, 9.2, -49),
		Palette.Stone,
		Enum.Material.Brick,
		{ canCollide = false }
	)
	deco(
		"Mess_Sign",
		Vector3.new(6, 1.6, 0.3),
		at(-60, 5.6, -37.8),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "🍚 식당" } }
	)
	deco("Mess_Door", Vector3.new(3, 5, 0.3), at(-60, 2.5, -37.9), Palette.WoodDark, Enum.Material.Wood)
	for i = 1, 3 do
		deco(
			"Mess_Table" .. i,
			Vector3.new(6, 0.4, 2),
			at(-72 + i * 6, 1.6, -30),
			Palette.Wood,
			Enum.Material.WoodPlanks,
			{ canCollide = true }
		)
		deco(
			"Mess_Bench" .. i .. "a",
			Vector3.new(6, 0.3, 0.8),
			at(-72 + i * 6, 0.9, -28.4),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = true }
		)
		deco(
			"Mess_Bench" .. i .. "b",
			Vector3.new(6, 0.3, 0.8),
			at(-72 + i * 6, 0.9, -31.6),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = true }
		)
	end
	-- 교관 망루
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		box(
			"Tower_Leg" .. i,
			"Buildings",
			Vector3.new(0.8, 9, 0.8),
			at(55 + c[1] * 3.4, 4.5, -40 + c[2] * 3.4),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	box("Tower_Deck", "Buildings", Vector3.new(9, 0.6, 9), at(55, 9.3, -40), Palette.Wood, Enum.Material.WoodPlanks)
	for i, side in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local alongX = side[1] == 0
		box(
			"Tower_Rail" .. i,
			"Buildings",
			if alongX then Vector3.new(9, 1.2, 0.3) else Vector3.new(0.3, 1.2, 9),
			at(55 + side[1] * 4.35, 10.2, -40 + side[2] * 4.35),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
	end
	box(
		"Tower_Roof",
		"Buildings",
		Vector3.new(11, 0.4, 11),
		at(55, 14, -40),
		Palette.OliveDark,
		Enum.Material.Fabric,
		{ canCollide = false }
	)
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
