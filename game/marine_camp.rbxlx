          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6209">
          <Properties>
            <string name="Name">CampAssets</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{59CBA831-A497-4901-AC2B-CDB1C2BD28E9}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 에셋 1차 (28 §7 "에셋 1차"): 생성기 기본 Part 소품 위에 진짜 메시(AI 생성·저폴리)를 입힌다. Studio 편집 전용.
-- 라이브러리: ServerStorage.CampAssets (Folder) 아래 키 이름의 Model 하나씩 — Studio 에만 있다(Rojo 밖, place 에 저장).
--   Model 규약: PrimaryPart = 밑면 가운데의 보이지 않는 "AssetBase", 피벗 = PrimaryPart, 긴 축 = X(통나무·노),
--   속성 AssetKey · AssetSource("generate_mesh" | "creator_store:<id>") · AssetId · UnitSize(Vector3, 배율 1 경계 상자)
--   · Sink(배율 1 에서 땅에 묻을 깊이) · AssetVer(바꾸면 dress 가 복제본을 새로 만든다).
-- 앵커: 생성기 스펙 attrs 에 AssetKey (+ AssetPos 밑면 가운데 · AssetYaw 도 · AssetHeight | AssetWidth | AssetScale · AssetSnap)
--   를 단 파트 하나. 같은 소품의 다른 기본 파트는 AssetFallback = <앵커 SpecId>.
--   비율을 바꿔야 하면(가는 노·짧은 장작) AssetCF(모델 축 상자 가운데) + AssetSize(모델 축 상자 크기) — MeshPart.Size 를 직접 준다 (마감 패스).
-- dress(): 라이브러리에 키가 있으면 Map/Dressing/Camp 에 복제(Dress_<앵커>)해 놓고 앵커·대체 파트를 투명하게(충돌은 그대로 —
--   나무 줄기·큰 바위 충돌이 게임 판정). 키가 없으면 기본 파트가 그대로 보인다(대체). 멱등: 있는 복제본은 다시 놓기만, 남은 것은 지운다.
-- Triggers·Spawns·LightingParts·Kind 파트와 클라이언트가 속성으로 찾는 파트(Flag·Rope·WaveFoam·Candle·SignText…)는 건드리지 않는다.
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
-- 고르지 않은 배율(AssetCF·AssetSize 앵커 — 노·장작 토막): 런타임과 같은 fitParts. Edit require 캐시를 피해 복제해서 읽는다
local AssetLibrary = require(
	game:GetService("ServerScriptService")
		:WaitForChild("Server")
		:WaitForChild("Services")
		:WaitForChild("AssetLibrary")
		:Clone()
)

local CampAssets = {}

local PROJECT = SceneBindings.ProjectId
CampAssets.LibraryName = "CampAssets"
-- Edit 모드 require 캐시(옛 SceneBindings)에도 돌도록 폴백 (생성기 K.X or "X" 관례)
local DRESS_PATH: { string } = (SceneBindings.Paths :: any).Dressing or { "Map", "Dressing", "Camp" }
local SCAN = { "Buildings", "TerrainProps", "Decorations" }
-- 복제 방식이 바뀌면 올린다 → 있는 복제본을 새로 만든다
local DRESS_REV = "/r2"
-- 클라이언트·서비스가 속성으로 찾는 파트: 숨기면 연출이 사라진다
local LIVE_ATTRS = {
	"Kind",
	"Flag",
	"Rope",
	"WaveFoam",
	"Candle",
	"SignText",
	"Firefly",
	"Buoy",
	"Crab",
	"PickupId",
	"FireRing",
	"LogPart",
}

-- 생성기 헬퍼(CampArt·CampRideCourse)가 쓴다: 이 속성을 가진 파트는 숨겨도 되는가
function CampAssets.isLive(attrs: { [string]: any }?): boolean
	if not attrs then
		return false
	end
	for _, k in ipairs(LIVE_ATTRS) do
		if attrs[k] ~= nil then
			return true
		end
	end
	return false
end

-- id → 0..n-1 (난수열을 소비하지 않는 변형 고르기 — 기존 배치가 바뀌지 않게)
function CampAssets.pick(id: string, n: number): number
	local h = 5381
	for i = 1, #id do
		h = (h * 33 + string.byte(id, i)) % 2147483647
	end
	return h % n
end

local function library(): Folder?
	local f = ServerStorage:FindFirstChild(CampAssets.LibraryName)
	return if f and f:IsA("Folder") then f else nil
end

local function ensurePath(path: { string }): Instance
	local cur: Instance = workspace
	for _, name in ipairs(path) do
		local nxt = cur:FindFirstChild(name)
		if not nxt then
			nxt = Instance.new("Folder")
			nxt.Name = name
			nxt:SetAttribute("ProjectId", PROJECT)
			nxt.Parent = cur
		end
		cur = nxt :: Instance
	end
	return cur
end

local function findPath(path: { string }): Instance?
	local cur: Instance? = workspace
	for _, name in ipairs(path) do
		cur = cur and cur:FindFirstChild(name)
	end
	return cur
end

local function unitSize(m: Model): Vector3
	local u = m:GetAttribute("UnitSize")
	if typeof(u) == "Vector3" then
		return u
	end
	local _, sz = m:GetBoundingBox()
	return sz
end

-- 앵커 속성 → 배율 (라이브러리 모델 UnitSize 기준)
local function scaleFor(anchor: BasePart, m: Model): number
	local u = unitSize(m)
	local h = anchor:GetAttribute("AssetHeight")
	if typeof(h) == "number" and h > 0 and u.Y > 0 then
		return h / u.Y
	end
	local w = anchor:GetAttribute("AssetWidth")
	if typeof(w) == "number" and w > 0 then
		return w / math.max(u.X, u.Z, 0.01)
	end
	local s = anchor:GetAttribute("AssetScale")
	return if typeof(s) == "number" and s > 0 then s else 1
end

-- Terrain 만 본다 (기본 파트·다른 복제본 무시), 물은 통과
local function groundY(pos: Vector3): number?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = true
	local hit = workspace:Raycast(pos + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), params)
	return if hit then hit.Position.Y else nil
end

local function targetCFrame(anchor: BasePart, scale: number, m: Model): CFrame
	local pos = anchor:GetAttribute("AssetPos")
	local base: Vector3 = if typeof(pos) == "Vector3"
		then pos
		else anchor.Position - Vector3.new(0, anchor.Size.Y / 2, 0)
	if anchor:GetAttribute("AssetSnap") == true then
		local y = groundY(base)
		-- 땅이 추정과 4 넘게 다르면(물속·다리 위) 추정을 믿는다
		if y and math.abs(y - base.Y) <= 4 then
			base = Vector3.new(base.X, y, base.Z)
		end
	end
	local sink = tonumber(m:GetAttribute("Sink")) or 0
	local yaw = tonumber(anchor:GetAttribute("AssetYaw")) or 0
	return CFrame.new(base.X, base.Y - sink * scale, base.Z) * CFrame.Angles(0, math.rad(yaw), 0)
end

local function prepClone(c: Model)
	-- 밑면 파트는 피벗으로만 쓰므로 복제본에선 WorldPivot 으로 옮기고 지운다 (복제본마다 파트 하나 덜)
	local base = c.PrimaryPart
	if base then
		c.WorldPivot = base.CFrame
		c.PrimaryPart = nil
		base:Destroy()
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false -- 땅 레이캐스트(Rescue·CourseFx)가 나뭇잎에 걸리지 않게
			d.CanTouch = false
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy() -- 라이브러리 규약상 없어야 하지만 혹시
		end
	end
end

local function hide(p: BasePart)
	if p:GetAttribute("DressHidden") == nil or p.Transparency < 1 then
		p:SetAttribute("DressHidden", p.Transparency)
		p:SetAttribute("DressShadow", p.CastShadow)
	end
	p.Transparency = 1
	p.CastShadow = false
end

local function unhide(p: BasePart)
	local t = p:GetAttribute("DressHidden")
	if typeof(t) == "number" then
		p.Transparency = t
		local sh = p:GetAttribute("DressShadow")
		if typeof(sh) == "boolean" then
			p.CastShadow = sh
		end
		p:SetAttribute("DressHidden", nil)
		p:SetAttribute("DressShadow", nil)
	end
end

type Group = { anchor: BasePart?, parts: { BasePart } }

local function collect(): ({ [string]: Group }, number)
	local groups: { [string]: Group } = {}
	local n = 0
	for _, key in ipairs(SCAN) do
		local folder = findPath((SceneBindings.Paths :: any)[key])
		if not folder then
			continue
		end
		for _, p in ipairs(folder:GetChildren()) do
			if not p:IsA("BasePart") or p:GetAttribute("ProjectId") ~= PROJECT or p:GetAttribute("Kind") ~= nil then
				continue
			end
			local sid = p:GetAttribute("SpecId")
			if typeof(p:GetAttribute("AssetKey")) == "string" and typeof(sid) == "string" then
				local g = groups[sid] or { parts = {} }
				g.anchor = p
				table.insert(g.parts, p)
				groups[sid] = g
				n += 1
			else
				local fb = p:GetAttribute("AssetFallback")
				if typeof(fb) == "string" then
					local g = groups[fb] or { parts = {} }
					table.insert(g.parts, p)
					groups[fb] = g
				end
			end
		end
	end
	return groups, n
end

-- 생성기 apply() 끝에서 부른다 (Edit 전용). 라이브러리가 없으면 기본 파트를 되살리고 복제본을 지운다.
function CampAssets.dress(): string
	local lib = library()
	local dressFolder = ensurePath(DRESS_PATH)
	local groups, anchors = collect()
	local live: { [string]: boolean } = {}
	local dressed, hidden, made, missing = 0, 0, 0, {} :: { [string]: number }
	local count = 0
	for gid, g in pairs(groups) do
		local anchor = g.anchor
		local key = anchor and anchor:GetAttribute("AssetKey")
		local src = if lib and typeof(key) == "string" then lib:FindFirstChild(key) else nil
		if not anchor or not src or not src:IsA("Model") then
			if typeof(key) == "string" then
				missing[key] = (missing[key] or 0) + 1
			end
			for _, p in ipairs(g.parts) do
				unhide(p)
			end
			continue
		end
		local model = src :: Model
		local name = "Dress_" .. gid
		live[name] = true
		local ver = tostring(model:GetAttribute("AssetVer") or "") .. DRESS_REV
		local c = dressFolder:FindFirstChild(name)
		if c and (not c:IsA("Model") or c:GetAttribute("AssetKey") ~= key or c:GetAttribute("AssetVer") ~= ver) then
			c:Destroy()
			c = nil
		end
		local clone: Model
		if c then
			clone = c :: Model
		else
			clone = model:Clone()
			clone.Name = name
			prepClone(clone)
			clone:SetAttribute("ProjectId", PROJECT)
			clone:SetAttribute("SpecId", name)
			clone:SetAttribute("AssetKey", key)
			clone:SetAttribute("AssetVer", ver)
			clone:SetAttribute("AnchorId", gid)
			made += 1
		end
		local fitCF = anchor:GetAttribute("AssetCF")
		local fitSize = anchor:GetAttribute("AssetSize")
		if typeof(fitCF) == "CFrame" and typeof(fitSize) == "Vector3" then
			AssetLibrary.fitParts(model, clone, fitCF, fitSize)
		else
			local scale = scaleFor(anchor, model)
			if math.abs(clone:GetScale() - scale) > 1e-4 then
				clone:ScaleTo(scale)
			end
			clone:PivotTo(targetCFrame(anchor, scale, model))
		end
		if clone.Parent ~= dressFolder then
			clone.Parent = dressFolder
		end
		for _, p in ipairs(g.parts) do
			hide(p)
			hidden += 1
		end
		dressed += 1
		count += 1
		if count % 40 == 0 then
			task.wait()
		end
	end
	local stale = 0
	for _, c in ipairs(dressFolder:GetChildren()) do
		if c:GetAttribute("ProjectId") == PROJECT and not live[c.Name] then
			c:Destroy()
			stale += 1
		end
	end
	local miss = {}
	for k, v in pairs(missing) do
		table.insert(miss, string.format("%s×%d", k, v))
	end
	table.sort(miss)
	return string.format(
		"[DRESS] 라이브러리 %s · 앵커 %d · 입힘 %d (새 %d) · 숨긴 기본 파트 %d · 지운 복제본 %d · 키 없음(기본 파트 그대로): %s",
		if lib then tostring(#lib:GetChildren()) .. "키" else "없음",
		anchors,
		dressed,
		made,
		hidden,
		stale,
		if #miss > 0 then table.concat(miss, ", ") else "-"
	)
end

-- check() 한 줄: 라이브러리 키·앵커 커버리지·메시 수 (Edit/Server 어디서나 읽기만)
function CampAssets.coverage(): string
	local lib = library()
	local groups, anchors = collect()
	local byKey: { [string]: number } = {}
	local covered = 0
	for _, g in pairs(groups) do
		local key = g.anchor and g.anchor:GetAttribute("AssetKey")
		if typeof(key) == "string" then
			byKey[key] = (byKey[key] or 0) + 1
			if lib and lib:FindFirstChild(key) then
				covered += 1
			end
		end
	end
	local keys = {}
	for k, v in pairs(byKey) do
		table.insert(keys, string.format("%s%s %d", k, if lib and lib:FindFirstChild(k) then "" else "(없음)", v))
	end
	table.sort(keys)
	local dressFolder = findPath(DRESS_PATH)
	local meshes = 0
	if dressFolder then
		for _, d in ipairs(dressFolder:GetDescendants()) do
			if d:IsA("MeshPart") then
				meshes += 1
			end
		end
	end
	return string.format(
		"assets: 라이브러리 %s · 앵커 %d · 키 있음 %d · Dressing 메시 %d · %s",
		if lib then tostring(#lib:GetChildren()) .. "키" else "없음",
		anchors,
		covered,
		meshes,
		table.concat(keys, ", ")
	)
end

return CampAssets
]]></string>
