          <string name="Source"><![CDATA[--!strict
-- 맵 개체를 이름·속성으로 찾는다. 생성기(CampSceneBootstrap)와 같은 계약. 전역 이름 검색으로 다른 개체를 오인하지 않게 ProjectId 를 확인한다.
local SceneBindings = {}

SceneBindings.ProjectId = "RobMarin.Camp"
SceneBindings.SceneSchemaVersion = 1

SceneBindings.Paths = {
	Buildings = { "Map", "Buildings", "Camp" },
	TerrainProps = { "Map", "Terrain_Props", "Camp" },
	Decorations = { "Map", "Decorations", "Camp" },
	Roads = { "Map", "Roads", "Camp" },
	Spawns = { "SpawnLocations", "Camp" },
	Triggers = { "Triggers", "Camp" },
	LightingParts = { "Lighting_Parts", "Camp" },
	Dressing = { "Map", "Dressing", "Camp" }, -- 에셋 1차: CampAssets.dress() 가 놓는 메시 복제본 (보기만, 충돌·쿼리 없음)
	Runtime = { "Runtime", "CampBoats" },
}

SceneBindings.TriggerKind = {
	CP = "CP", -- StableId CP0..CP6, Day. 유보트가 밤에 뒤집히는 자리이자 저장 자리
	-- 옛 운반 길 SEG·넘기기 PASS·장애물 OBST·파도 WAVE 는 마감 패스(2026-10-21)에 생성기와 함께 뺐다 (6단계 뒤 아무도 안 읽음).
	-- 급류·바다 경로점(Kind "RIDE")은 RideService 가 Triggers 에서 직접 모은다
	PAD = "PAD", -- 유격 리스폰 발판: Day, PadIndex, PadId, SanWaits(bool)
	FALL = "FALL", -- 유격 추락 영역
	GRAD = "GRAD", -- 퇴소식 사진 자리
	TRAIN = "TRAIN", -- 체력단련장 기구: TrainId (TrainingCatalog). LookVector 가 플레이어가 서는 방향
	TARGET = "TARGET", -- 모의 사격 표적 (14 §5): Group RANGE|GATE, TargetIndex. 종이 원형 표적만
	-- 자유 이동 스테이지 (22 v2, 2026-10-20): 깃발(목표, 아무 순서)과 영역(탐조등 빛·사격 문)
	FLAG = "FLAG", -- Day, FlagId, NameKo
	ZONE = "ZONE", -- Day, ZoneId, ZoneType SEARCH(OnSec·OffSec·Phase, 빛이 켜진 동안 안에서 움직이면 발각)|GATE(GateGroup = 표적 그룹, 막는 벽)
	-- 모닥불 허브 (27 §3 · 28 §3, 2026-10-21 1단계): 낮에 줍는 장작·물통, 밤 모닥불 중심, 모닥불 둘레 통나무 의자
	PICKUP = "PICKUP", -- PickId, PickType WOOD|WATER, Day, RespawnSec. 보이는 묶음은 Decorations 의 PickupId 속성으로 묶는다
	FIRE = "FIRE", -- FireId, Day. 밤 모닥불 중심(불꽃 파트 자리). 서버가 FireLevel 0..3 속성을 쓴다
	SEAT = "SEAT", -- 클래스 Seat. FireId, SeatIndex 1..4, 그 통나무의 분대원 자리(MemberId). 앉으면 그 사람이 오늘 이야기를 한다
	-- 유보트 꾸미기 (27 §3 1-A · 28 §3, 2026-10-21 3단계): 연병장 부품 더미·거치대·출발 깃발과 자리 발판
	PILE = "PILE", -- PartType OAR_LONG|OAR_SHORT|WATER|FLAG|AID|SNACK|STICKER_A|STICKER_B|STICKER_C|GO|RACK. 트리거 파트에 서버가 프롬프트를 단다 (RACK 은 유보트 자리, LookVector = 뱃머리)
	SEATPAD = "SEATPAD", -- SeatKey FL|FR|BL|BR. 그 발판에서 E → 내 자리
}

export type Pad = { part: BasePart, day: number, index: number, id: string, sanWaits: boolean }
export type Target = { part: BasePart, group: string, index: number }
export type Flag = { part: BasePart, day: number, id: string, nameKo: string }
export type Zone = {
	part: BasePart,
	day: number,
	id: string,
	zoneType: string,
	onSec: number,
	offSec: number,
	phase: number,
	gateGroup: string?,
}
export type Checkpoint = { part: BasePart, id: string, day: number }
export type Pickup = { part: BasePart, id: string, pickType: string, day: number, respawnSec: number }
export type Fire = { part: BasePart, id: string, day: number }
export type SeatSpot = { part: Seat, fireId: string, index: number, memberId: string? }
export type Pile = { part: BasePart, id: string, partType: string }
export type SeatPad = { part: BasePart, id: string, seatKey: string }
export type Scene = {
	ok: boolean,
	missing: { string },
	cps: { [string]: Checkpoint },
	padsByDay: { [number]: { Pad } },
	padById: { [string]: Pad },
	falls: { BasePart },
	spawn: SpawnLocation?,
	gradSpots: { BasePart },
	trains: { [string]: BasePart },
	targets: { [string]: { Target } },
	flagsByDay: { [number]: { Flag } },
	zonesByDay: { [number]: { Zone } },
	-- 모닥불 허브 (28 §3)
	pickups: { Pickup },
	firesByDay: { [number]: Fire },
	seatsByFire: { [string]: { SeatSpot } },
	-- 유보트 꾸미기 (28 §3, 3단계)
	piles: { Pile },
	seatPads: { [string]: SeatPad }, -- SeatKey → 발판
	buildRack: BasePart?, -- PartType RACK: 거치대 위 유보트 자리
}

function SceneBindings.getFolder(key: string): Instance?
	local path = SceneBindings.Paths[key]
	if not path then
		return nil
	end
	local cur: Instance = workspace
	for _, name in ipairs(path) do
		local nxt = cur:FindFirstChild(name)
		if not nxt then
			return nil
		end
		cur = nxt
	end
	return cur
end

function SceneBindings.ensureRuntimeFolder(): Folder
	local cur: Instance = workspace
	for _, name in ipairs(SceneBindings.Paths.Runtime) do
		local nxt = cur:FindFirstChild(name)
		if not nxt then
			nxt = Instance.new("Folder")
			nxt.Name = name
			nxt.Parent = cur
		end
		cur = nxt
	end
	return cur :: Folder
end

local function owned(inst: Instance): boolean
	return inst:GetAttribute("ProjectId") == SceneBindings.ProjectId
end

function SceneBindings.resolve(): Scene
	local scene: Scene = {
		ok = true,
		missing = {},
		cps = {},
		padsByDay = {},
		padById = {},
		falls = {},
		spawn = nil,
		gradSpots = {},
		trains = {},
		targets = {},
		flagsByDay = {},
		zonesByDay = {},
		pickups = {},
		firesByDay = {},
		seatsByFire = {},
		piles = {},
		seatPads = {},
		buildRack = nil,
	}
	local K = SceneBindings.TriggerKind
	local triggers = SceneBindings.getFolder("Triggers")
	if not triggers then
		scene.ok = false
		table.insert(scene.missing, "Workspace.Triggers.Camp")
		return scene
	end
	for _, inst in ipairs(triggers:GetChildren()) do
		if not inst:IsA("BasePart") or not owned(inst) then
			continue
		end
		local kind = inst:GetAttribute("Kind")
		if kind == K.CP then
			local id = tostring(inst:GetAttribute("StableId"))
			scene.cps[id] = { part = inst, id = id, day = tonumber(inst:GetAttribute("Day")) or 0 }
		elseif kind == K.PAD then
			local pad: Pad = {
				part = inst,
				day = tonumber(inst:GetAttribute("Day")) or 2,
				index = tonumber(inst:GetAttribute("PadIndex")) or 0,
				id = tostring(inst:GetAttribute("PadId")),
				sanWaits = inst:GetAttribute("SanWaits") == true,
			}
			scene.padsByDay[pad.day] = scene.padsByDay[pad.day] or {}
			table.insert(scene.padsByDay[pad.day], pad)
			scene.padById[pad.id] = pad
		elseif kind == K.FALL then
			table.insert(scene.falls, inst)
		elseif kind == K.GRAD then
			table.insert(scene.gradSpots, inst)
		elseif kind == K.TRAIN then
			scene.trains[tostring(inst:GetAttribute("TrainId"))] = inst
		elseif kind == K.FLAG then
			local fl: Flag = {
				part = inst,
				day = tonumber(inst:GetAttribute("Day")) or 0,
				id = tostring(inst:GetAttribute("FlagId")),
				nameKo = tostring(inst:GetAttribute("NameKo") or ""),
			}
			scene.flagsByDay[fl.day] = scene.flagsByDay[fl.day] or {}
			table.insert(scene.flagsByDay[fl.day], fl)
		elseif kind == K.ZONE then
			local z: Zone = {
				part = inst,
				day = tonumber(inst:GetAttribute("Day")) or 0,
				id = tostring(inst:GetAttribute("ZoneId")),
				zoneType = tostring(inst:GetAttribute("ZoneType")),
				onSec = tonumber(inst:GetAttribute("OnSec")) or 3,
				offSec = tonumber(inst:GetAttribute("OffSec")) or 3,
				phase = tonumber(inst:GetAttribute("Phase")) or 0,
				gateGroup = if typeof(inst:GetAttribute("GateGroup")) == "string"
					then inst:GetAttribute("GateGroup")
					else nil,
			}
			scene.zonesByDay[z.day] = scene.zonesByDay[z.day] or {}
			table.insert(scene.zonesByDay[z.day], z)
		elseif kind == K.PICKUP then
			table.insert(scene.pickups, {
				part = inst,
				id = tostring(inst:GetAttribute("PickId")),
				pickType = tostring(inst:GetAttribute("PickType") or "WOOD"),
				day = tonumber(inst:GetAttribute("Day")) or 0,
				respawnSec = tonumber(inst:GetAttribute("RespawnSec")) or 20,
			})
		elseif kind == K.FIRE then
			local f: Fire = {
				part = inst,
				id = tostring(inst:GetAttribute("FireId")),
				day = tonumber(inst:GetAttribute("Day")) or 0,
			}
			scene.firesByDay[f.day] = f
		elseif kind == K.SEAT and inst:IsA("Seat") then
			local fid = tostring(inst:GetAttribute("FireId"))
			scene.seatsByFire[fid] = scene.seatsByFire[fid] or {}
			table.insert(scene.seatsByFire[fid], {
				part = inst,
				fireId = fid,
				index = tonumber(inst:GetAttribute("SeatIndex")) or 0,
				memberId = if typeof(inst:GetAttribute("MemberId")) == "string"
					then inst:GetAttribute("MemberId") :: string
					else nil,
			})
		elseif kind == K.PILE then
			local pt = tostring(inst:GetAttribute("PartType") or "")
			if pt == "RACK" then
				scene.buildRack = inst
			else
				table.insert(scene.piles, { part = inst, id = inst.Name, partType = pt })
			end
		elseif kind == K.SEATPAD then
			local key = tostring(inst:GetAttribute("SeatKey") or "")
			scene.seatPads[key] = { part = inst, id = inst.Name, seatKey = key }
		elseif kind == K.TARGET then
			local g = tostring(inst:GetAttribute("Group"))
			scene.targets[g] = scene.targets[g] or {}
			table.insert(
				scene.targets[g],
				{ part = inst, group = g, index = tonumber(inst:GetAttribute("TargetIndex")) or 0 }
			)
		end
	end
	for _, list in pairs(scene.padsByDay) do
		table.sort(list, function(a, b)
			return a.index < b.index
		end)
	end
	for _, list in pairs(scene.seatsByFire) do
		table.sort(list, function(a, b)
			return a.index < b.index
		end)
	end
	table.sort(scene.pickups, function(a, b)
		return a.id < b.id
	end)
	table.sort(scene.piles, function(a, b)
		return a.id < b.id
	end)
	for _, id in ipairs({ "CP0", "CP1", "CP2", "CP4", "CP5", "CP6" }) do -- 3일차(갯벌) 없음 (M057)
		if not scene.cps[id] then
			scene.ok = false
			table.insert(scene.missing, "Triggers.Camp " .. id)
		end
	end
	for _, day in ipairs({ 2, 5, 6 }) do -- 자유 스테이지 깃발 (OBBY 날)
		if not scene.flagsByDay[day] or #scene.flagsByDay[day] == 0 then
			scene.ok = false
			table.insert(scene.missing, "FLAG day " .. day)
		end
	end
	if not scene.padsByDay[2] or #scene.padsByDay[2] == 0 then
		scene.ok = false
		table.insert(scene.missing, "PAD day 2")
	end
	local spawns = SceneBindings.getFolder("Spawns")
	if spawns then
		for _, c in ipairs(spawns:GetChildren()) do
			if c:IsA("SpawnLocation") and owned(c) then
				scene.spawn = c
				break
			end
		end
	end
	if not scene.spawn then
		scene.ok = false
		table.insert(scene.missing, "SpawnLocations.Camp SpawnLocation")
	end
	return scene
end

return SceneBindings
]]></string>
