            <string name="ScriptGuid">{497B1BFD-E5B8-41C6-9715-83D88AF5A9C2}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 박자 판정 (기지 체력단련장 박자 기구만 — 낮 작전에는 박자가 없다, 27 §1·6단계). 서버 시각 기준.
-- 클라이언트가 보낸 시각은 상한 안에서만 믿는다 (03_FLOW §2).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local RhythmService = {}

export type Clock = { bpm: number, startedAt: number }

function RhythmService.newClock(bpm: number): Clock
	return { bpm = bpm, startedAt = workspace:GetServerTimeNow() }
end

function RhythmService.beatSec(c: Clock): number
	return 60 / c.bpm
end

-- 가장 가까운 박자와의 차이 (초, 부호 있음)와 그 박자 번호
function RhythmService.offset(c: Clock, t: number): (number, number)
	local b = RhythmService.beatSec(c)
	local n = math.floor((t - c.startedAt) / b + 0.5)
	return t - (c.startedAt + n * b), n
end

-- 판정: GOOD | OK | MISS. windowDelta 는 노 종류에 따른 창 보정
function RhythmService.judge(c: Clock, t: number, windowDelta: number?): (string, number)
	local d = windowDelta or 0
	local off, n = RhythmService.offset(c, t)
	local a = math.abs(off)
	if a <= GameConfig.Rhythm.GoodWindowSec + d then
		return "GOOD", n
	elseif a <= GameConfig.Rhythm.OkWindowSec + d then
		return "OK", n
	end
	return "MISS", n
end

-- 클라이언트 시각 정리: 서버와 너무 어긋나면 서버 시각으로
function RhythmService.sanitizeTime(t: any): number
	local now = workspace:GetServerTimeNow()
	if typeof(t) ~= "number" or t ~= t or math.abs(t - now) > GameConfig.Rhythm.ClockSkewMaxSec then
		return now
	end
	return t
end

-- 기대 키와 누른 키 비교 (BeatPatterns). REST 는 누르면 무조건 MISS, 금색 "악!" 점(SHOUT)도 Space 탭, anySide 는 A/D/SPACE 전부 인정
function RhythmService.keyMatches(expected: string, pressed: string, anySide: boolean): boolean
	if expected == "REST" then
		return false
	end
	if anySide and (pressed == "A" or pressed == "D" or pressed == "SPACE") then
		return true
	end
	if expected == "SHOUT" then
		return pressed == "SPACE"
	end
	return expected == pressed
end

-- 지금 박자 번호 (연출·미니게임 틱 기준)
function RhythmService.currentBeat(c: Clock): number
	return math.floor((workspace:GetServerTimeNow() - c.startedAt) / RhythmService.beatSec(c))
end

return RhythmService
]]></string>
