        <Item class="ModuleScript" referent="6216">
          <Properties>
            <string name="Name">RemoteRouter</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{1C78E3EF-F0B8-4757-A6ED-4D32B7CE473C}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- RemoteEvent 멱등 생성 + 요청 검증(타입·범위·빈도) + 서비스로 전달. 클라이언트가 보내는 값은 전부 검증한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local RateLimiter = require(script.Parent.RateLimiter)
local SessionService = require(script.Parent.SessionService)
local CoopService = require(script.Parent.CoopService)

local RemoteRouter = {}

local C2S = ProtocolTypes.ClientToServer
local S2C = ProtocolTypes.ServerToClient
local E = ProtocolTypes.ErrorCode

function RemoteRouter.ensureRemotes(): { [string]: RemoteEvent }
	local folder = ReplicatedStorage:FindFirstChild(ProtocolTypes.RemotesFolderName)
	if folder and not folder:IsA("Folder") then
		error("[RemoteRouter] ReplicatedStorage." .. ProtocolTypes.RemotesFolderName .. " exists but is not a Folder")
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = ProtocolTypes.RemotesFolderName
		folder.Parent = ReplicatedStorage
	end
	local out: { [string]: RemoteEvent } = {}
	for _, group in ipairs({ C2S, S2C }) do
		for _, name in pairs(group) do
			local existing = folder:FindFirstChild(name)
			if existing and not existing:IsA("RemoteEvent") then
				error("[RemoteRouter] Remotes." .. name .. " exists with class " .. existing.ClassName)
			end
			if not existing then
				existing = Instance.new("RemoteEvent")
				existing.Name = name
				existing.Parent = folder
			end
			out[name] = existing :: RemoteEvent
		end
	end
	return out
end

local buckets: { [number]: { [string]: RateLimiter.Bucket } } = {}
local LIMITS: { [string]: { number } } = {
	[C2S.ClientReady] = { 0.2, 1 },
	[C2S.BeatInput] = { GameConfig.Rhythm.MaxInputsPerSec, GameConfig.Network.BeatBurst },
	[C2S.LoadoutRequest] = { GameConfig.Network.RequestPerSec, GameConfig.Network.RequestBurst },
	[C2S.FlowRequest] = { GameConfig.Network.RequestPerSec, GameConfig.Network.RequestBurst },
	[C2S.LetterRequest] = { 0.5, 1 },
	[C2S.SettingsRequest] = { 2, 6 },
	[C2S.CoopRequest] = { 2, 4 },
	[C2S.CarryInput] = { 12, 20 },
	[C2S.RangeShot] = { 8, 12 },
	[C2S.LeaderboardRequest] = { 2, 6 },
}

local function allow(userId: number, name: string): boolean
	local b = buckets[userId]
	if not b then
		b = {}
		buckets[userId] = b
	end
	local bucket = b[name]
	if not bucket then
		local lim = LIMITS[name] or { 1, 1 }
		bucket = RateLimiter.newBucket(lim[1], lim[2])
		b[name] = bucket
	end
	return RateLimiter.take(bucket)
end

local function validRequestId(id: any): boolean
	return typeof(id) == "string" and #id > 0 and #id <= 40
end

local remotesRef: { [string]: RemoteEvent } = {}

local function reject(session: SessionService.Session, requestId: any, code: string)
	local r = remotesRef[S2C.ActionResult]
	if r and validRequestId(requestId) then
		r:FireClient(session.player, { requestId = requestId, accepted = false, code = code })
	end
end

function RemoteRouter.clearPlayer(userId: number)
	buckets[userId] = nil
end

function RemoteRouter.bind(remotes: { [string]: RemoteEvent })
	remotesRef = remotes
	CoopService.setRemotes(remotes)
	local function on(name: string, handler: (SessionService.Session, any) -> ())
		remotes[name].OnServerEvent:Connect(function(player: Player, payload: any)
			local session = SessionService.get(player.UserId)
			if not session or typeof(payload) ~= "table" then
				return
			end
			if not allow(player.UserId, name) then
				if name ~= C2S.BeatInput then
					reject(session, payload.requestId, E.RATE_LIMITED)
				end
				return
			end
			handler(session, payload)
		end)
	end

	on(C2S.ClientReady, function(session, _p)
		SessionService.pushSnapshot(session)
	end)

	on(C2S.BeatInput, function(session, p)
		SessionService.handleBeat(session, p.t, p.key)
	end)

	on(C2S.CarryInput, function(session, p)
		SessionService.handleCarryInput(session, p.move, p.steer)
	end)
	on(C2S.RangeShot, function(session, p)
		SessionService.handleRangeShot(session, p.group, p.index)
	end)
	on(C2S.LeaderboardRequest, function(session, p)
		task.spawn(SessionService.handleLeaderboard, session, p.requestId, p.board)
	end)

	on(C2S.LoadoutRequest, function(session, p)
		if not validRequestId(p.requestId) or typeof(p.op) ~= "string" then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		if (ProtocolTypes.LoadoutOp :: any)[p.op] == nil then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		SessionService.handleLoadout(session, p.requestId, p.op, {
			seatKey = if typeof(p.seatKey) == "string" and #p.seatKey <= 2 then p.seatKey else nil,
			memberId = if typeof(p.memberId) == "string" and #p.memberId <= 12 then p.memberId else nil,
			cargoId = if typeof(p.cargoId) == "string" and #p.cargoId <= 12 then p.cargoId else nil,
			oar = if typeof(p.oar) == "string" and #p.oar <= 6 then p.oar else nil,
		})
	end)

	on(C2S.FlowRequest, function(session, p)
		if not validRequestId(p.requestId) or typeof(p.op) ~= "string" then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		if (ProtocolTypes.FlowOp :: any)[p.op] == nil then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		local choice = if typeof(p.choiceId) == "string" and #p.choiceId <= 16 then p.choiceId else nil
		SessionService.handleFlow(session, p.requestId, p.op, choice)
	end)

	on(C2S.LetterRequest, function(session, p)
		if not validRequestId(p.requestId) then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		local text = if typeof(p.freeText) == "string" and #p.freeText <= 400 then p.freeText else nil
		SessionService.handleLetter(session, p.requestId, p.toId, p.chips, text)
	end)

	on(C2S.SettingsRequest, function(session, p)
		if not validRequestId(p.requestId) or typeof(p.key) ~= "string" or #p.key > 24 then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		SessionService.handleSettings(session, p.requestId, p.key, p.value)
	end)

	on(C2S.CoopRequest, function(session, p)
		if not validRequestId(p.requestId) or typeof(p.op) ~= "string" then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		if (ProtocolTypes.CoopOp :: any)[p.op] == nil then
			return reject(session, p.requestId, E.BAD_REQUEST)
		end
		CoopService.handleRequest(session, p.requestId, p.op, {
			targetUserId = if typeof(p.targetUserId) == "number"
					and math.floor(p.targetUserId) == p.targetUserId
				then p.targetUserId
				else nil,
			memberId = if typeof(p.memberId) == "string" and #p.memberId <= 12 then p.memberId else nil,
			choiceId = if typeof(p.choiceId) == "string" and #p.choiceId <= 24 then p.choiceId else nil,
		})
	end)
end

return RemoteRouter
]]></string>
