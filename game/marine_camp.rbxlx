	GoDistance = 9, -- 출발 깃발 (플레이테스트 2026-10-21 "출발이 안 됨": 5 는 찾기 어려웠다 → 9)
	GoHold = 0.2, -- 출발은 살짝 누르기 (0.5 는 손을 일찍 떼면 안 떠났다 — 플레이테스트)
	OfferDistance = 8, -- 분대원이 내민 것 받기
	OfferStartSec = 2.5, -- 첫 분대원(두리)이 가지러 가는 때 (첫 1분 2026-10-21: 4 → 2.5 — 마당에 들어서고 5초 안팎에 두리가 내민다)
	OfferGapSec = 6, -- 다음 분대원까지
	OfferWaitSec = 20, -- 내밀고 기다리는 시간 (지나면 "응, 다음에" 하고 되돌려 놓는다)
	OfferLeaveStuds = 12, -- 내가 이만큼 멀어지면 "응, 다음에"
	OfferStandStuds = 3.6, -- 내 앞 이만큼에 서서 내민다
