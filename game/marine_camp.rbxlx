	MUS_CAMPFIRE = cue("rbxassetid://9042875353", "MUSIC", 0.95, true, false, 0),
	-- 5일차 야간 탐조등(OBBY day 5): APM "Playing it Straight (c)" 144초 — 피치카토 가벼운 코미디 긴장 (평균 40 → 1.8, 일부러 작게)
	MUS_STEALTH = cue("rbxassetid://9039543444", "MUSIC", 1.8, true, false, 0),
	-- 편지의 밤(LETTER): 오르골 (평균 42 → 1.6)
	MUS_NIGHT = cue("rbxassetid://9047796475", "MUSIC", 1.6, true, false, 0),
	-- 수료식(GRADUATE): APM "Award for Achievement (a)" 72.7초 — 오프닝 팡파르, 성취 (평균 64 → 1.5)
	MUS_GRADUATE = cue("rbxassetid://1842291712", "MUSIC", 1.5, true, false, 0),

	-- ===== 환경음 =====
	AMB_FOREST = cue("rbxassetid://9117064941", "SENSORY", 0.5, true, false, 0), -- 낮 숲·새 (평균 10)
	AMB_WIND = cue("rbxassetid://9112777807", "SENSORY", 1.4, true, false, 0), -- PSE "Farmland Presence 1" 36초 포도밭 바람·벌레 (평균 4, 아주 작게 깔림): 연병장
	AMB_NIGHT = cue("rbxassetid://9112764573", "SENSORY", 1.1, true, false, 0), -- 귀뚜라미 (평균 4 → 1.1)
	AMB_SEA = cue("rbxassetid://9125742262", "SENSORY", 0.25, true, false, 0), -- 바닷바람 (평균 ~35): 바다 위 바람 한 겹
	AMB_RAPIDS = cue("rbxassetid://9118187543", "SENSORY", 0.55, true, false, 0), -- PSE "River Water 1" 27초 (고른 69): 급류 물살, ride.speed 로 크기
	AMB_OCEAN = cue("rbxassetid://9119677305", "SENSORY", 0.7, true, false, 0), -- PSE "Surf Ocean Wave Impact On Zuma Beach 4" 40초 (밀려왔다 빠짐 1~63): 바다
	-- PSE "Fireplace Constant Burning Flame 4" 42.8초 (평균 6, 작게 녹음): 모닥불 자리에 붙는 3D 소리, FireLevel 로 크기
	AMB_FIRE = cue("rbxassetid://9112780462", "SENSORY", 4.0, true, true, 0),
} :: { [string]: Cue }

function AudioCueMap.get(id: string): Cue?
	return AudioCueMap.Cues[id]
end

return AudioCueMap
