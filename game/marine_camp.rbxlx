              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 퇴소식 단체 사진: GRADUATE 연출 때 내 아바타가 환호하고, 흰 플래시 뒤 폴라로이드(유보트 ViewportFrame + 소대 이름 + 흔적) 가 뜬다.
-- 실제 촬영·업로드 없음(개인정보). 사진은 상태에서 다시 그린다.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local PhotoController = {}
local S = ProtocolTypes.SessionState
local player = Players.LocalPlayer
local CHEER_ID = "rbxassetid://507770677" -- Roblox 기본 R15 cheer

local gui = UiKit.screen("CampPhoto", 44) -- 퇴소식 패널(36) 위에 뜬다
gui.Enabled = false
-- 플래시
local flash = Instance.new("Frame")
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundColor3 = Color3.new(1, 1, 1)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.ZIndex = 5
flash.Parent = gui
-- 폴라로이드
local card = Instance.new("Frame")
card.Name = "Polaroid"
card.AnchorPoint = Vector2.new(0.5, 0.5)
card.Position = UDim2.fromScale(0.5, 0.46)
card.Size = UDim2.fromOffset(340, 400)
card.BackgroundColor3 = Color3.fromRGB(250, 248, 240)
card.BorderSizePixel = 0
card.Rotation = -3
card.Visible = false
UiKit.corner(card, 6)
UiKit.stroke(card, Palette.Ink, 1.5, 0.6)
card.Parent = gui
local viewport = Instance.new("ViewportFrame")
viewport.Position = UDim2.fromOffset(16, 16)
viewport.Size = UDim2.fromOffset(308, 260)
viewport.BackgroundColor3 = Palette.Sand
viewport.BorderSizePixel = 0
viewport.Ambient = Color3.fromRGB(200, 200, 200)
viewport.LightColor = Color3.new(1, 1, 1)
viewport.LightDirection = Vector3.new(-1, -2, -1)
viewport.Parent = card
local cam = Instance.new("Camera")
cam.Parent = viewport
viewport.CurrentCamera = cam
local worldModel = Instance.new("WorldModel")
worldModel.Parent = viewport
local caption = UiKit.label(card, "", 18, true)
caption.Position = UDim2.fromOffset(16, 284)
caption.Size = UDim2.fromOffset(308, 24)
caption.AutomaticSize = Enum.AutomaticSize.None
caption.TextXAlignment = Enum.TextXAlignment.Center
local names = UiKit.label(card, "", 14, false, Palette.WoodDark)
names.Position = UDim2.fromOffset(16, 312)
names.Size = UDim2.fromOffset(308, 20)
names.AutomaticSize = Enum.AutomaticSize.None
names.TextXAlignment = Enum.TextXAlignment.Center
local traces = UiKit.label(card, "", 20, false)
traces.Position = UDim2.fromOffset(16, 338)
traces.Size = UDim2.fromOffset(308, 28)
traces.AutomaticSize = Enum.AutomaticSize.None
traces.TextXAlignment = Enum.TextXAlignment.Center
local note = UiKit.label(card, "", 14, true, Palette.Red)
note.Position = UDim2.fromOffset(16, 368)
note.Size = UDim2.fromOffset(308, 40)
note.AutomaticSize = Enum.AutomaticSize.None
note.TextXAlignment = Enum.TextXAlignment.Center
note.TextWrapped = true
note.Visible = false
local closeHint = UiKit.label(card, "탭하면 닫혀요", 12, false, Palette.WoodDark)
closeHint.Position = UDim2.fromOffset(16, 372)
closeHint.Size = UDim2.fromOffset(308, 16)
closeHint.AutomaticSize = Enum.AutomaticSize.None
closeHint.TextXAlignment = Enum.TextXAlignment.Center
local closeBtn = Instance.new("TextButton")
closeBtn.BackgroundTransparency = 1
closeBtn.Text = ""
closeBtn.Size = UDim2.fromScale(1, 1)
closeBtn.ZIndex = 3
closeBtn.Parent = card

local spinConn: RBXScriptConnection? = nil
local shownEntry = -1

local function myBoat(): Model?
	local f = SceneBindings.getFolder("Runtime")
	local m = f and f:FindFirstChild("Boat_" .. Net.boatOwnerId())
	return if m and m:IsA("Model") then m else nil
end

local function cheer()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local a = Instance.new("Animation")
	a.AnimationId = CHEER_ID
	local ok, track = pcall(function()
		return animator:LoadAnimation(a)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track:Play()
	end
end

local function fillViewport()
	worldModel:ClearAllChildren()
	local boat = myBoat()
	if not boat then
		return
	end
	local clone = boat:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BaseScript") then
			d:Destroy()
		end
	end
	clone:PivotTo(CFrame.new(0, 0, 0))
	clone.Parent = worldModel
	-- 넷이 같이 찍힌 사진: 나 + 분대원 셋을 유보트 앞에 세운다 (12: 사진에 유보트만 있었다)
	local people: { Model } = {}
	local ch = player.Character
	if ch then
		table.insert(people, ch)
	end
	local rt = SceneBindings.getFolder("Runtime")
	local squads = rt and rt:FindFirstChild("CampSquads")
	local mine = squads and squads:FindFirstChild("Squad_" .. Net.boatOwnerId())
	if mine then
		for _, id in ipairs(SquadCatalog.NpcOrder) do
			local rig = mine:FindFirstChild("Npc_" .. id)
			if rig and rig:IsA("Model") then
				table.insert(people, rig)
			end
		end
	end
	for i, src in ipairs(people) do
		local wasArchivable = src.Archivable
		src.Archivable = true
		local pc = src:Clone()
		src.Archivable = wasArchivable
		if pc then
			for _, d in ipairs(pc:GetDescendants()) do
				if d:IsA("BaseScript") or d:IsA("BillboardGui") then
					d:Destroy()
				elseif d:IsA("BasePart") then
					d.Anchored = true
				end
			end
			-- 유보트 옆(+X)에 길이 방향으로 한 줄, 바깥을 본다
			local z = (i - (#people + 1) / 2) * 3.2
			pc:PivotTo(CFrame.new(6.5, 1.8, z) * CFrame.Angles(0, -math.pi / 2, 0))
			pc.Parent = worldModel
		end
	end
	local size = clone:GetExtentsSize()
	local dist = math.max(size.X, size.Z) * 0.8 + 2 -- 사람 넷이 보이게 가까이 (12)
	local angle = 0.2
	if spinConn then
		spinConn:Disconnect()
	end
	spinConn = RunService.RenderStepped:Connect(function(dt)
		if not card.Visible then
			return
		end
		if Net.setting("reducedMotion") ~= true then
			angle += dt * 0.35
		end
		local eye = Vector3.new(3 + math.cos(angle) * dist, dist * 0.45, math.sin(angle) * dist)
		cam.CFrame = CFrame.lookAt(eye, Vector3.new(3, 1, 0))
	end)
end

local function takePhoto(snap: ProtocolTypes.StateSnapshot)
	gui.Enabled = true
	cheer()
	flash.BackgroundTransparency = 0
	TweenService
		:Create(
			flash,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 1 }
		)
		:Play()
	fillViewport()
	caption.Text = string.format("🎓 %d기 · 한 배 탔다", snap.entryCount)
	local list = { "🧢 " .. player.DisplayName }
	for _, m in ipairs(snap.members) do
		if m.id ~= "ME" then
			table.insert(list, m.emoji .. " " .. m.nameKo)
		end
	end
	names.Text = table.concat(list, " · ")
	local emojis = {}
	for _, id in ipairs(snap.stickers) do
		local meta = (CampScript.Stickers :: any)[id]
		table.insert(emojis, if meta then meta.emoji else "⭐")
	end
	traces.Text = table.concat(emojis, " ")
	-- 편지 v2 (M061): 친구들에게 한 말이 사진 밑에 붙는다
	if snap.letterNote and snap.letterNote ~= "" then
		note.Text = "✉️ " .. snap.letterNote
		note.Visible = true
		card.Size = UDim2.fromOffset(340, 440)
		closeHint.Position = UDim2.fromOffset(16, 412)
	else
		note.Visible = false
		card.Size = UDim2.fromOffset(340, 400)
		closeHint.Position = UDim2.fromOffset(16, 372)
	end
	card.Visible = true
	card.Position = UDim2.fromScale(0.5, 0.6)
	TweenService:Create(
		card,
		TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.fromScale(0.5, 0.46) }
	):Play()
end

local function close()
	card.Visible = false
	gui.Enabled = false
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	worldModel:ClearAllChildren()
end

function PhotoController.start()
	closeBtn.Activated:Connect(close)
	Net.FxCue:Connect(function(c)
		if c.kind == "GRADUATE" then
			local snap = Net.Snapshot
			if snap and shownEntry ~= snap.entryCount then
				shownEntry = snap.entryCount
				task.delay(2.5, function()
					local s = Net.Snapshot
					if s and s.state == S.GRADUATE then
						takePhoto(s)
					end
				end)
			end
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		if snap.state ~= S.GRADUATE and card.Visible then
			close()
		end
	end)
	local _ = SquadCatalog
end

return PhotoController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000b5d</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6149">
            <Properties>
              <string name="Name">IntroCard</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{8B8908C7-AD89-4CC7-9F34-E073365CFBA3}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 입소 카드: 접속 직후 3초 동안 제목·구호·n기 표시가 올리브 천 위에 떴다가 사라진다. 다시 입소(REENTER) 때도 한 번.
-- 조작을 막지 않는다(탭하면 바로 사라짐). 움직임 줄이기면 페이드 없이 짧게.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local CampScript = require(Shared:WaitForChild("CampScript"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)

local IntroCard = {}

local gui = UiKit.screen("CampIntro", 60)
gui.Enabled = false
local back = Instance.new("Frame")
back.Size = UDim2.fromScale(1, 1)
back.BackgroundColor3 = Palette.OliveDark
back.BackgroundTransparency = 0.45 -- 첫 1분: 세상(분대원·마당)이 비쳐 보이게 (0.25 → 0.45)
back.BorderSizePixel = 0
back.Parent = gui
local card = UiKit.woodSign(gui, "Title", UDim2.fromOffset(560, 150), UDim2.fromScale(0.5, 0.42), Vector2.new(0.5, 0.5))
local title = UiKit.label(card, CampScript.Title, 30, true, Palette.Cream)
title.AnchorPoint = Vector2.new(0.5, 0)
title.Position = UDim2.new(0.5, 0, 0, 22)
title.Size = UDim2.new(1, -40, 0, 40)
title.AutomaticSize = Enum.AutomaticSize.None
title.TextXAlignment = Enum.TextXAlignment.Center
title.TextStrokeColor3 = Palette.Ink
title.TextStrokeTransparency = 0.4
local motto = UiKit.label(card, CampScript.Motto, 24, true, Palette.Yellow)
motto.AnchorPoint = Vector2.new(0.5, 0)
motto.Position = UDim2.new(0.5, 0, 0, 72)
motto.Size = UDim2.new(1, -40, 0, 32)
motto.AutomaticSize = Enum.AutomaticSize.None
motto.TextXAlignment = Enum.TextXAlignment.Center
local sub = UiKit.label(card, "", 16, false, Palette.Sand)
sub.AnchorPoint = Vector2.new(0.5, 1)
sub.Position = UDim2.new(0.5, 0, 1, -14)
sub.Size = UDim2.new(1, -40, 0, 22)
sub.AutomaticSize = Enum.AutomaticSize.None
sub.TextXAlignment = Enum.TextXAlignment.Center
local tap = Instance.new("TextButton")
tap.BackgroundTransparency = 1
tap.Text = ""
tap.Size = UDim2.fromScale(1, 1)
tap.Parent = gui

local token = 0
local hiding = false
local function hide()
	if hiding then
		return
	end
	hiding = true
	token += 1
	local reduced = Net.setting("reducedMotion") == true
	if reduced then
		gui.Enabled = false
		return
	end
	local t = TweenService:Create(back, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
	t:Play()
	TweenService:Create(card, TweenInfo.new(0.5), { Position = UDim2.fromScale(0.5, 0.3) }):Play()
	t.Completed:Once(function()
		if hiding then
			gui.Enabled = false
		end
	end)
end

local function show(entry: number, reenter: boolean)
	hiding = false
	sub.Text = if reenter
		then string.format("🔁 %d기 다시 입소 · 소대 넷이 기다려요", entry)
		else string.format("%d기 입소 · 분대원 두리·산·미르와 4박 5일", entry)
	back.BackgroundTransparency = 0.45
	card.Position = UDim2.fromScale(0.5, 0.42)
	gui.Enabled = true
	token += 1
	local my = token
	task.delay(2.4, function() -- 첫 1분: 3.2 → 2.4초 (그사이 걸으면 바로 걷힘)
		if token == my then
			hide()
		end
	end)
end

local shownOnce = false
local lastEntry = -1

function IntroCard.start()
	tap.Activated:Connect(hide)
	-- 첫 1분 (28 §7): 걷기 시작하면 바로 걷힌다 (제목 카드가 첫 걸음을 막지 않게)
	RunService.Heartbeat:Connect(function()
		if not gui.Enabled then
			return
		end
		local ch = Players.LocalPlayer.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0.1 then
			hide()
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		if not shownOnce then
			shownOnce = true
			lastEntry = snap.entryCount
			show(snap.entryCount, false)
		elseif snap.entryCount ~= lastEntry then
			lastEntry = snap.entryCount
			show(snap.entryCount, true)
		end
	end)
end

return IntroCard
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00001615</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6150">
            <Properties>
              <string name="Name">TrainingController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{0675B8E5-5A4B-4177-821E-6743CE39BEB3}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 체력단련장 (07_PHASE2 §3): 기구 가까이 가면 "🏋️ 철봉 · 근력" 안내 + 시작 버튼(PC "E 시작" · 폰 "▶ 시작" · 패드 "Ⓧ 시작" — 기기마다 실제 입력과 같은 이름),
-- E·Ⓧ·탭으로 시작(FlowRequest TRAIN_START), 끝나면 결과 카드.
-- 미니게임 중 박자 바는 BeatHud 가 그린다. 점수·순위 없음, 결과는 "힘 2 → 3" 한 줄.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local TrainingCatalog = require(Shared:WaitForChild("TrainingCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local InputController = require(script.Parent.InputController)

local TrainingController = {}
local S = ProtocolTypes.SessionState
local C2S = ProtocolTypes.ClientToServer
local player = Players.LocalPlayer

local gui = UiKit.screen("CampTraining", 33)
-- 가까이 갔을 때 안내: 아래 가운데 큰 버튼(n일차 출발, 아래에서 20~86) 바로 위 (19_UI_MAP_STYLE — 예전 자리는 큰 버튼과 겹침)
local prompt = UiKit.paper(gui, "Prompt", UDim2.fromOffset(360, 0), UDim2.new(0.5, 0, 1, -100), Vector2.new(0.5, 1))
prompt.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(prompt, 12)
UiKit.list(prompt, nil, 4)
prompt.Visible = false
local promptTitle = UiKit.label(prompt, "", 20, true)
promptTitle.TextXAlignment = Enum.TextXAlignment.Center
local promptWhy = UiKit.label(prompt, "", 14, false, Palette.WoodDark)
promptWhy.TextXAlignment = Enum.TextXAlignment.Center
local function startLabel(): string
	local t = InputController.CurrentInputType
	return if t == "TOUCH" then "▶ 시작" elseif t == "GAMEPAD" then "Ⓧ 시작" else "E 시작"
end
local promptBtn = UiKit.button(prompt, startLabel(), function()
	TrainingController.startNearest()
end, true)
-- 미니게임 중 그만두기
local stopBtn = UiKit.button(gui, "그만", function()
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.TRAIN_STOP })
end)
stopBtn.Size = UDim2.fromOffset(110, 44)
stopBtn.AnchorPoint = Vector2.new(1, 0)
stopBtn.Position = UDim2.new(1, -16, 0, 120)
stopBtn.Visible = false
-- 결과 카드
local card = UiKit.paper(gui, "Result", UDim2.fromOffset(360, 0), UDim2.fromScale(0.5, 0.4), Vector2.new(0.5, 0.5))
card.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(card, 16)
UiKit.list(card, nil, 6)
card.Visible = false
local cardTitle = UiKit.label(card, "", 24, true)
cardTitle.TextXAlignment = Enum.TextXAlignment.Center
local cardBody = UiKit.label(card, "", 18)
cardBody.TextXAlignment = Enum.TextXAlignment.Center
local cardStat = UiKit.label(card, "", 22, true, Palette.Red)
cardStat.TextXAlignment = Enum.TextXAlignment.Center
UiKit.button(card, "좋아!", function()
	card.Visible = false
end, true)

local nearestId: string? = nil
local trains: { [string]: BasePart } = {}
local scannedAt = -math.huge

local function scan()
	scannedAt = os.clock()
	trains = {}
	local folder = SceneBindings.getFolder("Triggers")
	if not folder then
		return
	end
	for _, p in ipairs(folder:GetChildren()) do
		if p:IsA("BasePart") and p:GetAttribute("Kind") == SceneBindings.TriggerKind.TRAIN then
			trains[tostring(p:GetAttribute("TrainId"))] = p
		end
	end
end

function TrainingController.startNearest()
	if not nearestId then
		return
	end
	Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.TRAIN_START, choiceId = nearestId }, function(res)
		if not res.accepted then
			if res.code == ProtocolTypes.ErrorCode.BUSY then
				UiKit.toast("오늘은 벌써 했어요. 내일 또! 💪", 3)
			else
				UiKit.toast(Net.errorText(res.code))
			end
		end
	end)
end

local function updatePrompt()
	local snap = Net.Snapshot
	local ch = player.Character
	if not snap or not ch or not snap.allowed.TRAIN then
		prompt.Visible = false
		nearestId = nil
		return
	end
	if os.clock() - scannedAt > 4 then
		scan()
	end
	local pos = ch:GetPivot().Position
	local bestId: string? = nil
	local bestD = 12
	for id, p in pairs(trains) do
		local d = (p.Position - pos).Magnitude
		if d < bestD then
			bestD = d
			bestId = id
		end
	end
	nearestId = bestId
	local st = if bestId then TrainingCatalog.get(bestId) else nil
	if st then
		local done = snap.trainedToday[st.id] == true
		local cur = (snap.stats :: any)[st.stat] or 0
		promptTitle.Text = string.format(
			"%s %s · %s %d/%d",
			st.emoji,
			st.nameKo,
			TrainingCatalog.StatLongKo[st.stat],
			cur,
			TrainingCatalog.StatMax
		)
		promptWhy.Text = if done then "오늘은 했어요. 내일 또! ✅" else st.whyKo
		promptBtn.Text = if done then "내일 또" else startLabel()
		UiKit.setEnabled(promptBtn, not done and cur < TrainingCatalog.StatMax)
		prompt.Visible = true
	else
		prompt.Visible = false
	end
end

local function showResult(c: any)
	local st = TrainingCatalog.get(tostring(c.stationId))
	if not st then
		return
	end
	cardTitle.Text = st.emoji .. " " .. st.nameKo
	if c.completed == false then
		cardBody.Text = "다음에 또 해요!"
		cardStat.Text = ""
	else
		cardBody.Text = if st.kind == "RANGE"
			then string.format("맞힘 %d · 놓침 %d  (%d 맞히면 +1)", c.good, c.miss, c.passGood)
			else string.format(
				"좋아 %d · 오케이 %d · 앗 %d  (좋아 %d 이상이면 +1)",
				c.good,
				c.ok,
				c.miss,
				c.passGood
			)
		local statKo = TrainingCatalog.StatLongKo[st.stat] or st.stat
		cardStat.Text = if c.gained
			then string.format(
				"%s %d → %d %s",
				statKo,
				c.before,
				c.after,
				if st.stat == "aim" then "🎯" else "💪"
			)
			elseif c.after >= TrainingCatalog.StatMax then string.format("%s 최대! %d", statKo, c.after)
			else string.format("%s 그대로 %d. 내일 다시!", statKo, c.after)
	end
	card.Visible = true
end

function TrainingController.start()
	InputController.InteractRequested:Connect(function()
		if nearestId and prompt.Visible and promptBtn.Active then
			TrainingController.startNearest()
		end
	end)
	RunService.Heartbeat:Connect(function()
		updatePrompt()
		stopBtn.Visible = Net.state() == S.TRAINING
	end)
	Net.StoryCue:Connect(function(c)
		if c.kind == "TRAIN_RESULT" then
			showResult(c)
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		if snap.state == S.TRAINING then
			card.Visible = false
		end
	end)
end

return TrainingController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
