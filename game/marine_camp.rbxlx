            <string name="Source"><![CDATA[--!strict
-- 맵 때깔 패스 (28 §1·§6): CampSceneBootstrap 이 스펙을 다 만든 뒤 호출한다. 에셋 ID 없이 Part·Material·Light·Particle·Terrain 으로.
-- specs(): 추가 장식 스펙 (id 접두 Art_) / restyle(specs): 기존 스펙의 재질·색 덮어쓰기 + 생성기 나무·촛불에 덩어리 덧붙이기(최종 위치를 아는 유일한 곳)
-- / lighting(): Lighting·Atmosphere·Terrain 물·구름·바람·재질 색 / terrain(): Terrain 추가 채움(언덕·바위·풀 무늬·모래톱·길가 흙)
--
-- 기준(28 §6): 99 Nights 의 따뜻한 모닥불·푸른 밤, Build a Boat 의 선명한 물, Natural Disaster 의 또렷한 실루엣.
-- 색은 19_UI_MAP_STYLE 60/30/10 — 빨강은 목적지에만. 여기서 더 쓰는 색은 Palette 에 넣지 않고 아래 로컬 상수(C)로.
-- 장식은 전부 clear="drop": 운반 길(SEG) 위에 걸리면 생성기가 **부품 단위로** 뺀다 → 길에서 (6 + 반지름 + 4.5) 이상 떨어뜨린다.
-- 1일차 옛 코스(x 0, z -70~-290)는 수로로 바뀌므로 비워 둔다. 2일차 유격장은 SEG 가 없어 자동 보호가 없다 — 좌표로 피한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Palette = require(Shared:WaitForChild("Palette"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
-- 에셋 1차: 소품 헬퍼가 앵커(AssetKey)·대체(AssetFallback) 속성을 단다 → CampAssets.dress() 가 메시를 입힌다 (Edit 캐시 피하려 복제)
local CampAssets = require(
	game:GetService("ServerScriptService")
		:WaitForChild("Server")
		:WaitForChild("Editor")
		:WaitForChild("CampAssets")
		:Clone()
)

local CampArt = {}

export type Spec = {
	id: string,
	folder: string,
	class: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	attrs: { [string]: any }?,
	shape: Enum.PartType?,
	light: { color: Color3, range: number, brightness: number }?,
	onPath: boolean?,
	clear: string?,
	group: string?,
}

local PROJECT = SceneBindings.ProjectId

-- 로컬 색 (Palette 밖. 28 §6)
local C = {
