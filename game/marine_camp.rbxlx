      <Item class="ModuleScript" referent="6198">
        <Properties>
          <string name="Name">StationCatalog</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{FDA43EDC-B56F-4972-A5E5-C0FC04B9612E}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 체크포인트 CP0~CP6(CP3 갯벌은 2026-10-20 에 뺌 — 4박 5일) 와 그날의 훈련 방식. 위치는 맵(SceneBindings)이 정하고 여기는 규칙만 둔다.
local StationCatalog = {}

export type Station = {
	id: string,
	day: number,
	nameKo: string,
	emoji: string,
	mode: string, -- CAMP | BUILD(1일차 꾸미기 → 급류 RIDE) | OBBY(자유 스테이지) | SEA(4일차 바다 RIDE) (6단계)
	badge: string?,
}

StationCatalog.List = {
	{
		id = "CP0",
		day = 0,
		nameKo = "입소식 연병장",
		emoji = "🧢",
		mode = "CAMP",
		badge = "🧢 입소",
	},
	{
		id = "CP1",
		day = 1,
		nameKo = "각개전투장",
		emoji = "🌲",
		mode = "BUILD",
		badge = "🌊 급류 완주", -- 27 개정(M068): 도착하면 RAPIDS (CampScript.Badges 와 같은 글이라야 arriveCheckpoint 가 찾는다)
	},
	{
		id = "CP2",
		day = 2,
		nameKo = "유격장",
		emoji = "🧗",
		mode = "OBBY",
		badge = "🧗 그물 꼭대기",
	},
	{
		id = "CP4",
		day = 4,
		nameKo = "해상 선착장",
		emoji = "🌊",
		mode = "SEA",
		badge = "🌊 부표 여덟",
	},
	{
		id = "CP5",
		day = 5,
		nameKo = "촛불 광장",
		emoji = "🕯️",
		mode = "OBBY",
		badge = "🔦 야간 행군",
	},
	{
		id = "CP6",
		day = 6,
		nameKo = "퇴소식 무대",
		emoji = "🎓",
		mode = "OBBY",
		badge = "🎓 수료",
	},
} :: { Station }

local byId: { [string]: Station } = {}
local indexOf: { [string]: number } = {}
for i, s in ipairs(StationCatalog.List) do
	byId[s.id] = s
	indexOf[s.id] = i
end

function StationCatalog.get(id: string): Station?
	return byId[id]
end

function StationCatalog.isValidId(id: any): boolean
	return typeof(id) == "string" and byId[id] ~= nil
end

function StationCatalog.indexOf(id: string): number
	return indexOf[id] or 1
end

-- day 의 훈련이 끝나면 닿는 체크포인트
function StationCatalog.forDay(day: number): Station?
	for _, s in ipairs(StationCatalog.List) do
		if s.day == day then
			return s
		end
	end
	return nil
end

function StationCatalog.idForDay(day: number): string
	local s = StationCatalog.forDay(day)
	return if s then s.id else "CP0"
end

-- 다음 훈련 날 (갯벌 3일차를 뺐다 — 2026-10-20 사용자 "갯벌은 버려" → 2일차 다음은 4일차. 날 번호는 그대로 두고 목록에서만 건너뛴다)
function StationCatalog.nextDay(day: number): number
	for _, s in ipairs(StationCatalog.List) do
		if s.day > day then
			return s.day
		end
	end
	return StationCatalog.LastDay
end

-- 화면에 보이는 날 번호(1~5, 갯벌을 뺀 뒤): 목록에서 그날까지의 훈련 날 수. 안 번호(day)는 그대로
function StationCatalog.dayNo(day: number): number
	local n = 0
	for _, s in ipairs(StationCatalog.List) do
		if s.day >= 1 and s.day <= day then
			n += 1
		end
	end
	return n
end

-- 몇 번째 밤인가 (화면 "n박"): 목록에서 그날까지의 훈련 날 수
function StationCatalog.nightNo(day: number): number
	return StationCatalog.dayNo(day)
end

StationCatalog.LastDay = 6

return StationCatalog
]]></string>
