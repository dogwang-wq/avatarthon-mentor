	deco("D2_BellArm", Vector3.new(0.4, 3, 0.4), at(ox + 110, 16.1, -410), Palette.WoodDark, Enum.Material.Wood)
	deco(
		"D2_Bell",
		Vector3.new(1.6, 1.8, 1.6),
		at(ox + 110, 17.6, -410),
