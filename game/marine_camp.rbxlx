      <Item class="ModuleScript" referent="6192">
        <Properties>
          <string name="Name">KoreanText</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{2CBC1188-3B71-47FE-890A-BFC71214811D}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 한국어 조사 고르기: "이(가)" 처럼 괄호로 쓰지 않고 앞말 받침에 맞춘다 (14_KOREAN_VOICE_GUIDE.md).
-- 마지막 글자가 한글이 아니면(영문 닉네임 등) 받침 없는 쪽을 쓴다.
local KoreanText = {}

local PAIRS: { [string]: { string } } = {
	["이/가"] = { "이", "가" },
	["을/를"] = { "을", "를" },
	["은/는"] = { "은", "는" },
	["과/와"] = { "과", "와" },
	["아/야"] = { "아", "야" },
	["이에요/예요"] = { "이에요", "예요" },
}

-- 숫자로 끝나면 읽는 소리로 (0 영, 1 일, 3 삼, 6 육, 7 칠, 8 팔 → 받침 있음)
local DIGIT_FINAL = { ["0"] = true, ["1"] = true, ["3"] = true, ["6"] = true, ["7"] = true, ["8"] = true }
-- 로마자로 끝나면 글자 이름 소리로 (L 엘, M 엠, N 엔, R 알 → 받침 있음). 로블록스 닉네임 대부분이 로마자라서
local LATIN_FINAL = { l = true, m = true, n = true, r = true }

-- 받침 있음 / 없음. 한글·숫자·로마자가 아니면 nil
function KoreanText.hasFinal(word: string): boolean?
	local last: number? = nil
	for _, c in utf8.codes(word) do
		last = c
	end
	if not last then
		return nil
	end
	if last >= 0xAC00 and last <= 0xD7A3 then
		return (last - 0xAC00) % 28 ~= 0
	end
	local ch = string.lower(utf8.char(last))
	if string.match(ch, "%d") then
		return DIGIT_FINAL[ch] == true
	elseif string.match(ch, "%a") then
		return LATIN_FINAL[ch] == true
	end
	return nil
end

-- KoreanText.josa("다온", "이/가") → "다온이"
function KoreanText.josa(word: string, pair: string): string
	local fin = KoreanText.hasFinal(word)
	if pair == "으로/로" then
		-- ㄹ 받침 뒤에는 "로" (길로·물로 — "길으로" 가 아님)
		local last: number? = nil
		for _, c in utf8.codes(word) do
			last = c
		end
		local rieul = last ~= nil and last >= 0xAC00 and last <= 0xD7A3 and (last - 0xAC00) % 28 == 8
		return word .. (if fin and not rieul then "으로" else "로")
	end
	local p = PAIRS[pair]
	if not p then
		return word
	end
	return word .. (if fin then p[1] else p[2])
end

-- 터치 화면에서는 키 이름을 버튼 이름으로 (키보드/터치가 같은 행동을 같은 이름으로): 클릭 → 탭(사격),
-- Space → 탭!(체력단련장 박자 버튼), A·D → ◀ ▶. liftWord 로 Space 자리 말을 바꿀 수 있다
function KoreanText.touchKeys(s: string, liftWord: string?): string
	local w = liftWord or "탭!"
	local out = string.gsub(s, "A·D", "◀ ▶")
	out = string.gsub(out, "클릭", "탭")
	out = string.gsub(out, "Space", w)
	out = string.gsub(out, "%f[%w]A%f[%W]", "◀")
	out = string.gsub(out, "%f[%w]D%f[%W]", "▶")
	return out
end

-- 패드: Space → Ⓐ, A·D → LB·RB, E → Ⓧ, 클릭 → Ⓧ
function KoreanText.padKeys(s: string): string
	local out = string.gsub(s, "A·D", "LB·RB")
	out = string.gsub(out, "Space", "Ⓐ")
	out = string.gsub(out, "%f[%w]A%f[%W]", "LB")
	out = string.gsub(out, "%f[%w]D%f[%W]", "RB")
	out = string.gsub(out, "%f[%w]E%f[%W]", "Ⓧ") -- E(상호작용) = 패드 X (InputController CampInteract)
	out = string.gsub(out, "클릭", "Ⓧ") -- 사격 표적: 패드 X 가 화면 가운데에 가장 가까운 것을 맞힌다 (RangeController)
	return out
end

-- 입력 기기에 맞춘 키 이름 (KBM | TOUCH | GAMEPAD)
function KoreanText.keysFor(s: string, inputType: string, liftWord: string?): string
	if inputType == "TOUCH" then
		return KoreanText.touchKeys(s, liftWord)
	elseif inputType == "GAMEPAD" then
		return KoreanText.padKeys(s)
	end
	return s
end

-- 기록 시간: 1/100초 → "1:05.32" (15_RECORDS)
function KoreanText.clock(cs: number): string
	cs = math.max(0, math.floor(cs))
	local m = math.floor(cs / 6000)
	local s = math.floor((cs % 6000) / 100)
	local c = cs % 100
	return string.format("%d:%02d.%02d", m, s, c)
end

return KoreanText
]]></string>
