-- ===== 꺾은선 도우미 =====
local function polyLength(pts: { Vector3 }): number
	local total = 0
	for i = 1, #pts - 1 do
		total += (pts[i + 1] - pts[i]).Magnitude
	end
	return total
end

-- 거리 d 의 위치·진행 방향(수평 단위)
local function along(pts: { Vector3 }, d: number): (Vector3, Vector3)
	local left = math.max(0, d)
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local len = (b - a).Magnitude
		local dir = (b - a).Unit
		if left <= len then
			return a + dir * left, dir
		elseif i == #pts - 1 then
			return a + dir * left, dir -- 끝을 지나면 마지막 방향으로 곧게 (해변 위)
		end
		left -= len
	end
	return pts[#pts], (pts[#pts] - pts[#pts - 1]).Unit
end

local function waterY(s: number): number
	if s <= FALLS_S then
		return UPPER_Y
	elseif s >= FALLS_S + FALLS_LEN then
		return LOWER_Y
	end
	return UPPER_Y + (LOWER_Y - UPPER_Y) * (s - FALLS_S) / FALLS_LEN
end

local function rightOf(dir: Vector3): Vector3
	return dir:Cross(Vector3.yAxis)
end

-- 해변 비탈 (때깔 3차): 물 끝(t=0)에서 앞으로 t, 옆으로 lat. 가운데(±HALF+1)는 4.3 기존 실측 그대로
-- (물 쪽 −6.6 → 18 stud 에 +1.1 = 마지막 경로점 t=8 에서 −3.2), 옆으로 8 stud 동안 땅(0)으로 부드럽게 올라간다.
local BEACH_FULL = HALF + 1
local BEACH_BLEND = 8
local BEACH_LEN = 26
local function beachY(t: number, lat: number): number
	local base = math.min(0, -6.6 + 7.7 * math.max(0, t) / 18)
	local k = math.clamp((lat - BEACH_FULL) / BEACH_BLEND, 0, 1)
	k = k * k * (3 - 2 * k) -- smoothstep: 둑과 만나는 곳이 꺾이지 않게
	return base * (1 - k)
end
-- 해변 비탈 안에 서 있는 생성기 나무 (D1_Tree3) — 그 둘레는 낮추지 않는다 (모래 둔덕)
local BEACH_KEEP = { Vector3.new(24, 0, -255) }

-- 결정적 난수 (멱등)
local function rng(seed: number): () -> number
	local state = seed
	return function()
		state = (state * 1103515245 + 12345) % 2147483648
		return state / 2147483648
	end
end

-- ===== 스펙 모음 =====
local out: { Spec } = {}
local used: { [string]: boolean } = {}

local function add(s: Spec)
	if used[s.id] then
		error("CampRideCourse duplicate id " .. s.id)
	end
	used[s.id] = true
	table.insert(out, s)
end

type AssetState = { anchor: string?, attrs: { [string]: any } }
local asset: AssetState? = nil
local function assetBegin(key: string, pos: Vector3, dims: { [string]: any }, id: string)
	local a: { [string]: any } = { AssetKey = key, AssetPos = pos, AssetYaw = CampAssets.pick(id .. "#yaw", 360) }
	for k, v in pairs(dims) do
		a[k] = v
	end
	asset = { attrs = a }
end
local function assetEnd()
	asset = nil
end
local function variant(base: string, letters: string, id: string): string
	local i = CampAssets.pick(id, #letters) + 1
	return base .. "_" .. string.sub(letters, i, i)
end

local function part(
	id: string,
	folder: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	mat: Enum.Material,
	extra: { [string]: any }?
)
	local s: Spec = { id = id, folder = folder, size = size, cframe = cf, color = color, material = mat }
	if extra then
		for k, v in pairs(extra) do
			(s :: any)[k] = v
		end
	end
	-- 에셋 묶음: 첫 파트 = 앵커, 나머지 = 대체 (CampArt 와 같은 규약). WaveFoam 같은 살아 있는 파트는 늘 보임
	local st = asset
	if st and folder ~= "LightingParts" and folder ~= "Triggers" then
		local a: { [string]: any } = if s.attrs then table.clone(s.attrs) else {}
		if not CampAssets.isLive(a) then
			if st.anchor == nil then
				st.anchor = id
				for k, v in pairs(st.attrs) do
					a[k] = v
				end
			else
				a.AssetFallback = st.anchor
			end
			s.attrs = a
		end
	end
	add(s)
end

local function deco(id: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, extra: { [string]: any }?)
	local e = extra or {}
	if e.canCollide == nil then
		e.canCollide = false
	end
	part(id, "Decorations", size, cf, color, mat, e)
end

local function trigger(id: string, size: Vector3, cf: CFrame, attrs: { [string]: any })
	add({
		id = id,
		folder = "Triggers",
		size = size,
		cframe = cf,
		transparency = 1,
		canCollide = false,
		attrs = attrs,
	})
end

local function rot(g: () -> number, amt: number): CFrame
	return CFrame.Angles((g() - 0.5) * amt, g() * math.pi * 2, (g() - 0.5) * amt)
end

-- 바위 무더기 (때깔 3차, CampArt.rocks 와 같은 틀): 크기 다른 각진 Block 2~3 을 돌려 겹치고 큰 것 위에 작은 쐐기.
-- 2톤(Slate 청회 + 어두운 Basalt). 물속(wet)이면 젖은 색 + 밑동 거품 고리(WaveFoam). 보이는 파트엔 전부 RideRock (판정은 트리거)
local function rocksParts(id: string, pos: Vector3, scale: number, seed: number, wet: boolean)
	local r = rng(seed)
	local n = 2 + (if r() < 0.5 then 1 else 0)
	local bigTop = pos
	local bigSize = Vector3.one
	local bigYaw = 0
	for i = 1, n do
		local big = i == 1
		local sx = scale * (if big then 3.0 + r() * 1.2 else 1.6 + r() * 1.4)
		local sy = scale * (if big then 2.0 + r() * 0.9 else 1.1 + r() * 0.8)
		local sz = scale * (if big then 2.4 + r() * 1.0 else 1.4 + r() * 1.2)
		local ang = r() * math.pi * 2
		local d = if big then 0 else scale * (1.6 + r() * 1.2)
		local yaw = r() * math.pi * 2
		-- 큰 판은 크게 기울여 깊이 묻는다 (CampArt.rocks 와 같음)
		local pitch = if big then (0.32 + r() * 0.3) * (if r() < 0.5 then -1 else 1) else (r() - 0.5) * 0.7
		local cf = CFrame.new(
			pos.X + math.cos(ang) * d,
			pos.Y + sy * (if big then 0.12 else 0.2),
			pos.Z + math.sin(ang) * d
		) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, (r() - 0.5) * 0.35)
		if big then
			bigTop = (cf * CFrame.new(0, sy / 2, 0)).Position
			bigSize = Vector3.new(sx, sy, sz)
			bigYaw = yaw
		end
		deco(
			string.format("%s_R%d", id, i),
			Vector3.new(sx, sy, sz),
			cf,
			if big then (if wet then C.RockWet else C.RockSlab) else C.Basalt,
			if big then Enum.Material.Slate else Enum.Material.Basalt,
			{ attrs = { RideRock = true }, class = if i == 2 then "WedgePart" else nil }
		)
	end
	deco(
		id .. "_Cap",
		Vector3.new(bigSize.X * 0.8, bigSize.Y * 0.85, bigSize.Z * 0.7), -- 큰 쐐기로 판의 평평한 윗면을 깬다
		CFrame.new(bigTop - Vector3.new(0, bigSize.Y * 0.12, 0))
			* CFrame.Angles(0, bigYaw + math.rad(30 + r() * 60), 0)
			* CFrame.new(bigSize.X * 0.12, 0, 0),
		if wet then C.RockDark else C.RockLight,
		Enum.Material.Slate,
		{ class = "WedgePart", attrs = { RideRock = true } }
	)
	if wet then
		-- 밑동 거품 고리 (수면 = pos.Y + 0.4 언저리)
		local fr = scale * 3.4
		deco(
			id .. "_FoamRing",
			Vector3.new(0.1, fr * 2, fr * 2),
			CFrame.new(pos.X, pos.Y + 0.46, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
			C.Foam,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, transparency = 0.55, attrs = { WaveFoam = true } }
		)
	end
end

-- 에셋: 바위 무더기 메시. 물속 바위(wet)는 땅에 붙이지 않고(물 밑 바닥으로 가라앉는다) 조금 더 키워 수면 위로 — 거품 고리는 늘 보임
local function rocks(id: string, pos: Vector3, scale: number, seed: number, wet: boolean)
	assetBegin(
		variant("RockCluster", "AB", id),
		if wet then pos - Vector3.new(0, 0.3 * scale, 0) else pos,
		{ AssetWidth = (if wet then 6.0 else 4.0) * scale, AssetSnap = not wet },
		id
	)
	rocksParts(id, pos, scale, seed, wet)
	assetEnd()
end

-- 원뿔 한 층 (CampArt.coneTier 와 같음): CornerWedgePart 4 장 사각뿔. 꼭짓점 = 로컬 (+X, 위, −Z) 모서리 (Studio 실측)
local function coneTier(
	id: string,
	cx: number,
	baseY: number,
	cz: number,
	r: number,
	h: number,
	yawOff: number,
	color: Color3
)
	for k = 1, 4 do
		local cf = CFrame.new(cx, baseY + h / 2, cz)
			* CFrame.Angles(0, yawOff + (k - 1) * (math.pi / 2), 0)
			* CFrame.new(-r / 2, 0, r / 2)
		deco(
			string.format("%s_%d", id, k),
			Vector3.new(r, h, r),
			cf,
			color,
			Enum.Material.LeafyGrass,
			{ class = "CornerWedgePart" }
		)
	end
end

-- 소나무 (때깔 3차): 가는 줄기 + 사각뿔 3층(층마다 45° 엇갈림 → 8각 별), 짙은 청록 2톤. id 의 _Trunk 는 유지
local function pineParts(id: string, x: number, z: number, s: number, seed: number, y0: number)
	local g = rng(seed)
	local yaw0 = g() * math.pi
	part(
		id .. "_Trunk",
		"TerrainProps",
		Vector3.new(0.75 * s, 4.0 * s + 1, 0.75 * s),
		CFrame.new(x, y0 + 2.0 * s - 0.5, z),
		C.Bark,
		Enum.Material.Wood,
		{ canCollide = true }
	)
	for i, t in ipairs({
		{ 2.7, 4.6, 1.9, C.PineA },
		{ 2.1, 4.0, 4.6, C.PineB },
		{ 1.4, 3.8, 7.2, C.PineA },
	}) do
		coneTier(
			string.format("%s_C%d", id, i),
			x,
			y0 + t[3] * s,
			z,
			t[1] * s,
			t[2] * s,
			yaw0 + (i - 1) * math.rad(45),
			t[4]
		)
	end
end

-- 에셋: 소나무 메시 (줄기가 앵커, 충돌 그대로)
local function pine(id: string, x: number, z: number, s: number, seed: number, y0: number)
	assetBegin(variant("TreePine", "AB", id), Vector3.new(x, y0, z), { AssetHeight = 11.0 * s, AssetSnap = true }, id)
	pineParts(id, x, z, s, seed, y0)
	assetEnd()
end

-- 작은 활엽수 (둑 위 띄엄띄엄): 가는 줄기 + 잎 4 (아래 둘은 그림자 톤)
local function smallTreeParts(id: string, x: number, z: number, s: number, seed: number, y0: number)
	local g = rng(seed)
	part(
		id .. "_Trunk",
		"TerrainProps",
		Vector3.new(0.6 * s, 5.0 * s + 0.6, 0.6 * s),
		CFrame.new(x, y0 + 2.5 * s - 0.3, z) * CFrame.Angles((g() - 0.5) * 0.12, 0, (g() - 0.5) * 0.12),
		C.Bark,
		Enum.Material.Wood,
		{ canCollide = true }
	)
	for i, l in ipairs({
		{ 2.8, 0, 6.0, 0, C.LeafBright },
		{ 2.4, 1.3, 5.2, 0.6, C.Bush },
		{ 2.3, -1.2, 4.8, -0.5, C.LeafShadow },
		{ 2.0, 0.3, 4.6, -1.4, C.LeafShadow },
	}) do
		deco(
			string.format("%s_L%d", id, i),
			Vector3.new(l[1] * s, l[1] * s * 0.85, l[1] * s),
			CFrame.new(x + l[2] * s, y0 + l[3] * s, z + l[4] * s) * rot(g, 0.7),
			l[5],
			Enum.Material.LeafyGrass,
			{ shape = Enum.PartType.Ball }
		)
	end
end

-- 에셋: 작은 활엽수 메시
local function smallTree(id: string, x: number, z: number, s: number, seed: number, y0: number)
	assetBegin(variant("TreeLeafy", "AB", id), Vector3.new(x, y0, z), { AssetHeight = 7.6 * s, AssetSnap = true }, id)
	smallTreeParts(id, x, z, s, seed, y0)
	assetEnd()
end

-- 덤불: LeafyGrass 공 2
local function bushParts(id: string, x: number, z: number, s: number, seed: number, y0: number)
	local g = rng(seed)
	for i = 1, 2 do
		local sz = s * (if i == 1 then 2.6 + g() * 0.6 else 1.8 + g() * 0.6)
		local a = g() * math.pi * 2
		local d = if i == 1 then 0 else s * 1.2
		deco(
			string.format("%s_B%d", id, i),
			Vector3.new(sz, sz * 0.75, sz),
			CFrame.new(x + math.cos(a) * d, y0 + sz * 0.28, z + math.sin(a) * d) * rot(g, 0.4),
			if i == 1 then C.Bush else C.LeafShadow,
			Enum.Material.LeafyGrass,
			{ shape = Enum.PartType.Ball }
		)
	end
end

-- 에셋: 덤불 메시
local function bush(id: string, x: number, z: number, s: number, seed: number, y0: number)
	assetBegin("Bush_A", Vector3.new(x, y0, z), { AssetWidth = 4.2 * s, AssetSnap = true }, id)
	bushParts(id, x, z, s, seed, y0)
	assetEnd()
end

-- 갈대 묶음: 얇은 Grass 막대 3 (살짝 벌어짐)
local function reedsParts(id: string, x: number, z: number, y0: number, seed: number)
	local g = rng(seed)
	for i = 1, 3 do
		local h = 2.4 + g() * 1.4
		local a = g() * math.pi * 2
		deco(
			string.format("%s_%d", id, i),
			Vector3.new(0.16, h, 0.16),
			CFrame.new(x + math.cos(a) * 0.35, y0 + h / 2 - 0.3, z + math.sin(a) * 0.35)
				* CFrame.Angles(math.cos(a) * 0.18, 0, math.sin(a) * 0.18),
			if i == 2 then C.Reed2 else C.Reed,
			Enum.Material.Grass
		)
	end
end

-- 에셋: 갈대 메시 (물가 — 땅에 붙이지 않는다)
local function reeds(id: string, x: number, z: number, y0: number, seed: number)
	assetBegin("Reeds", Vector3.new(x, y0 - 0.3, z), { AssetHeight = 3.4 }, id)
	reedsParts(id, x, z, y0, seed)
	assetEnd()
end

-- 들풀 덩어리
local function tuftParts(id: string, x: number, z: number, scale: number, seed: number, y0: number)
	local g = rng(seed)
	local s = scale * (2.2 + g() * 1.2)
	deco(
		id,
		Vector3.new(s, s * 0.38, s * (0.7 + g() * 0.3)),
		CFrame.new(x, y0 + s * 0.08, z) * CFrame.Angles(0, g() * math.pi * 2, 0),
		if g() < 0.5 then C.Tuft else C.Tuft2,
		if g() < 0.6 then Enum.Material.LeafyGrass else Enum.Material.Grass,
		{ shape = Enum.PartType.Ball }
	)
end

-- 에셋: 풀 포기 메시
local function tuft(id: string, x: number, z: number, scale: number, seed: number, y0: number)
	assetBegin("GrassTuft", Vector3.new(x, y0, z), { AssetHeight = 1.5 * scale, AssetSnap = true }, id)
	tuftParts(id, x, z, scale, seed, y0)
	assetEnd()
end

-- 거품 띠 (WaveFoam → CourseFx 가 출렁이게 한다)
local function foam(id: string, pos: Vector3, dir: Vector3, len: number, w: number)
	deco(
		id,
		Vector3.new(w, 0.12, len),
		CFrame.lookAt(pos, pos + dir),
		C.Foam,
		Enum.Material.SmoothPlastic,
		{ transparency = 0.45, attrs = { WaveFoam = true } }
	)
end

-- ===== 1일차 수로 =====
local function buildChannel()
	local total = polyLength(LINE)
	-- 경로점: 12 stud 마다 + 폭포 턱 앞뒤에 촘촘히 (스플라인이 3 stud 를 6 stud 동안 내려가게)
	local sList: { number } = {}
	local s = 0
	while s < total - 6 do
		table.insert(sList, s)
		if s < FALLS_S - 12 and s + 12 > FALLS_S - 12 then
			s = FALLS_S - 12
		elseif s >= FALLS_S - 12 and s < FALLS_S + FALLS_LEN + 6 then
			s += 6
		else
			s += 12
		end
	end
	table.insert(sList, total + 8) -- 해변: 마지막 점은 모래 비탈 위 8 stud (배가 밀려 올라가 멈춘다 — 실측 모래 −3.1)
	for i, sv in ipairs(sList) do
		local p, _dir = along(LINE, sv)
		local y = waterY(sv)
		if i == #sList then
			y = -2.8 -- 모래 비탈 (Studio 실측 d=8 → −3.1) 위
		end
		trigger(
			string.format("R1_P%02d", i),
			Vector3.new(1, 1, 1),
			CFrame.new(p.X, y, p.Z),
			{ Kind = "RIDE", Day = 1, Index = i, S = sv }
		)
	end
	-- 장애물
	local rockN, branchN = 0, 0
	for _, e in ipairs(EVENTS) do
		local p, dir = along(LINE, e.s)
		local right = rightOf(dir)
		local y = waterY(e.s)
		if e.t == "ROCK" then
			rockN += 1
			local sx = if e.side == "L" then -1 else 1
			local id = "R1_Rock" .. rockN
			trigger(
				id,
				Vector3.new(WIDTH, 6, 4),
				CFrame.lookAt(Vector3.new(p.X, y + 2, p.Z), Vector3.new(p.X, y + 2, p.Z) + dir),
				{ Kind = "RIDE", Day = 1, RideType = "ROCK", Side = e.side, S = e.s }
			)
			-- 바위 무더기: 둑 가장자리(±HALF)에 걸쳐 물로 2.5~3 stud 튀어나온다 (반쯤 물속)
			local rp = p + right * (sx * (HALF - 0.5))
			rocks(id .. "_V", Vector3.new(rp.X, y - 0.4, rp.Z), 1.15, 700 + rockN, true)
			-- 바위 앞 거품
			foam(id .. "_Foam", Vector3.new(rp.X, y + 0.06, rp.Z) - right * (sx * 2.2) - dir * 1.5, dir, 7, 2.2)
			foam(id .. "_Foam2", Vector3.new(rp.X, y + 0.06, rp.Z) - right * (sx * 3.4) + dir * 3, dir, 4, 1.4)
		elseif e.t == "BRANCH" then
			branchN += 1
			local id = "R1_Branch" .. branchN
			trigger(
				id,
				Vector3.new(WIDTH, 6, 3),
				CFrame.lookAt(Vector3.new(p.X, y + 2, p.Z), Vector3.new(p.X, y + 2, p.Z) + dir),
				{ Kind = "RIDE", Day = 1, RideType = "BRANCH", S = e.s }
			)
			-- 둑에서 둑으로 쓰러져 걸친 나무 (수면 +3.5): 이끼 낀 줄기 + 뿌리판(왼둑) + 잔가지 3 + 작은 잎 덩어리 4. 닿지 않는다(판정은 서버)
			-- (때깔 3차: 잎이 공 둘이라 가지가 아니라 공이 떠 보였다 — 21_ride_03·06)
			local a = p - right * (HALF + 3)
			local b = p + right * (HALF + 3)
			local mid = (a + b) / 2
			local len = (b - a).Magnitude
			local logCF = CFrame.lookAt(Vector3.new(mid.X, y + 3.5, mid.Z), Vector3.new(b.X, y + 3.9, b.Z))
			deco(
				id .. "_Log",
				Vector3.new(len, 1.0, 1.0),
				logCF * CFrame.Angles(0, math.rad(90), 0),
				C.Bark,
				Enum.Material.Wood,
				{ shape = Enum.PartType.Cylinder, attrs = { RideBranch = true } }
			)
			-- 이끼: 줄기 윗면을 따라 얇은 띠
			deco(
				id .. "_Moss",
				Vector3.new(0.75, 0.22, len * 0.55),
				logCF * CFrame.new(0, 0.48, -len * 0.08),
				C.Moss,
				Enum.Material.LeafyGrass
			)
			-- 뿌리판: 왼둑 끝에 세운 흙 원판 (뽑혀 쓰러진 나무)
			deco(
				id .. "_RootPlate",
				Vector3.new(0.6, 3.0, 3.0),
				logCF * CFrame.new(0, -0.3, len / 2 - 0.2) * CFrame.Angles(0, math.rad(90), 0),
				Color3.fromRGB(104, 84, 60),
				Enum.Material.Ground,
				{ shape = Enum.PartType.Cylinder }
			)
			-- 잔가지 3 (줄기에서 위·옆으로) + 끝에 작은 잎 덩어리
			local leafN = 0
			for j, tw in ipairs({ { -0.28, 1, 18 }, { 0.05, -1, 26 }, { 0.3, 1, 12 } }) do
				local base = logCF * CFrame.new(0, 0.2, -len * tw[1])
				local twigCF = base
					* CFrame.Angles(0, math.rad(90 * tw[2]), 0)
					* CFrame.Angles(math.rad(tw[3]), 0, 0)
					* CFrame.new(0, 0, -1.1)
				deco(
					string.format("%s_Twig%d", id, j),
					Vector3.new(0.42, 0.42, 2.4), -- 굵고 낮게: 가늘고 가파르면 끝의 잎이 공중에 뜬 공처럼 보였다
					twigCF,
					C.BarkLight,
					Enum.Material.Wood
				)
				local tip = (twigCF * CFrame.new(0, 0, -1.0)).Position
				for k = 1, (if j == 2 then 2 else 1) do
					leafN += 1
					deco(
						string.format("%s_Leaf%d", id, leafN),
						Vector3.new(1.5 - k * 0.2, 1.1, 1.3),
						CFrame.new(tip + Vector3.new(0, 0.2 * k, (k - 1) * 0.6)) * CFrame.Angles(0, leafN * 1.3, 0.3),
						if leafN % 2 == 0 then C.Bush else C.LeafShadow,
						Enum.Material.LeafyGrass,
						{ shape = Enum.PartType.Ball }
					)
				end
			end
			-- 가지가 걸린 둑 나무 (한쪽)
			local tp = b + dir * 1.5
			pine(id .. "_Tree", tp.X, tp.Z, 1.0, 800 + branchN, y + 1)
		elseif e.t == "FALLS" then
			trigger(
				"R1_Falls",
				Vector3.new(WIDTH, 8, FALLS_LEN + 2),
				CFrame.lookAt(Vector3.new(p.X, y + 2, p.Z), Vector3.new(p.X, y + 2, p.Z) + dir),
				{ Kind = "RIDE", Day = 1, RideType = "FALLS", S = e.s, Drop = UPPER_Y - LOWER_Y }
			)
			-- 턱: 윗물에서 아랫물로 미끄러지는 물 판 (Glass, 기울기 atan(3/6)). Terrain 은 턱 구간을 비워 둔다
			local drop = UPPER_Y - LOWER_Y
			local lipLen = math.sqrt(FALLS_LEN ^ 2 + drop ^ 2) + 1.5
			local lipPitch = math.atan2(drop, FALLS_LEN)
			local lipMid = Vector3.new(p.X, (UPPER_Y + LOWER_Y) / 2 - 0.2, p.Z)
			deco(
				"R1_FallsLip",
				Vector3.new(WIDTH + 1, 0.4, lipLen),
				CFrame.lookAt(lipMid, lipMid + dir) * CFrame.Angles(-lipPitch, 0, 0), -- 코가 내려간다 (진행 방향으로 3 stud 하강)
				C.WaterVivid,
				Enum.Material.Glass,
				{ transparency = 0.25, canCollide = false, attrs = { WaveFoam = true } }
			)
			-- 턱 위 흰 물결 + 아래 거품 웅덩이
			foam(
				"R1_FallsFoamTop",
				Vector3.new(p.X, UPPER_Y + 0.08, p.Z) - dir * (FALLS_LEN / 2 + 0.5),
				dir,
				2,
				WIDTH - 1
			)
			for j = 1, 3 do
				local fp = Vector3.new(p.X, LOWER_Y + 0.08, p.Z) + dir * (FALLS_LEN / 2 + 1 + (j - 1) * 2.4)
				foam("R1_FallsFoam" .. j, fp, dir, 2, WIDTH - 1 - (j - 1) * 2.5)
			end
			-- 턱 양옆 큰 바위 (협곡 입구)
			for j, sx in ipairs({ -1, 1 }) do
				local rp = p + right * (sx * (HALF + 2)) + dir * 2
				rocks("R1_FallsRock" .. j, Vector3.new(rp.X, UPPER_Y + 0.4, rp.Z), 1.5, 900 + j, false)
			end
			-- 폭포 표지 (오른쪽 둑): 🌊 폭포 · 뛰어!
			local sp = p + right * (HALF + 5) - dir * 10
			part(
				"R1_FallsSignPost",
				"Buildings",
				Vector3.new(0.4, 4.4, 0.4),
				CFrame.new(sp.X, UPPER_Y + 3.2, sp.Z),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = false }
			)
			deco(
				"R1_FallsSign",
				Vector3.new(4, 1.6, 0.3),
				CFrame.lookAt(Vector3.new(sp.X, UPPER_Y + 5.6, sp.Z), Vector3.new(sp.X, UPPER_Y + 5.6, sp.Z) - dir),
				Palette.Red,
				Enum.Material.SmoothPlastic,
				{ attrs = { SignText = "🌊 폭포", SignSub = "뛰어!", SignLight = true, SignBothSides = true } }
			)
		end
	end
	-- 줍기 자리 (급류 2차): 보이지 않는 2³ 트리거. 떠 있는 장작·물통은 RideService 가 탈 때 띄운다
	for i, it in ipairs(ITEMS) do
		local p, dir = along(LINE, it.s)
		local sx = if it.side == "L" then -1 else 1
		local q = p + rightOf(dir) * (sx * ITEM_LAT)
		local y = waterY(it.s)
		trigger(
			string.format("R1_Item%02d", i),
			Vector3.new(2, 2, 2),
			CFrame.lookAt(Vector3.new(q.X, y, q.Z), Vector3.new(q.X, y, q.Z) + dir),
			{ Kind = "RIDE", Day = 1, RideType = "ITEM", Side = it.side, Item = it.item, S = it.s }
		)
	end
	-- 도착 (해변): FINISH 트리거는 물 끝 2 stud 앞 — 2초 동안 서면서 모래 위로 7 stud 쯤 밀려 올라간다
	do
		local p, dir = along(LINE, total - 2)
		trigger(
			"R1_Finish",
			Vector3.new(WIDTH + 4, 8, 6),
			CFrame.lookAt(Vector3.new(p.X, LOWER_Y + 3, p.Z), Vector3.new(p.X, LOWER_Y + 3, p.Z) + dir),
			{ Kind = "RIDE", Day = 1, RideType = "FINISH", S = total - 2 }
		)
		-- 해변 위 자리 (때깔 3차): 물 끝 pe 기준 앞 t · 옆 lat(+ = 오른쪽), 높이는 beachY
		local pe = along(LINE, total)
		local rr = rightOf(dir)
		local function onBeach(t: number, lat: number): Vector3
			local q = pe + dir * t + rr * lat
			return Vector3.new(q.X, beachY(t, math.abs(lat)), q.Z)
		end
		-- 도착 깃발 (모래 위, 왼쪽): 🏖️ 해안. 비탈 옆 둑 위로 옮겨 땅에 박히게 (전에는 y 고정이라 비탈 위에 떠 있었다)
		local fp = onBeach(12, -11)
		part(
			"R1_FinishPole",
			"Buildings",
			Vector3.new(0.5, 9.5, 0.5),
			CFrame.new(fp.X, fp.Y + 4.25, fp.Z),
			Palette.Stone,
			Enum.Material.Metal,
			{ canCollide = false }
		)
		deco(
			"R1_FinishCloth",
			Vector3.new(4, 2.6, 0.2),
			CFrame.new(fp.X + 2.2, fp.Y + 7.4, fp.Z),
			Palette.Red,
			Enum.Material.Fabric,
			{ attrs = { Flag = true, SignText = "🏖️ 해안 도착", SignLight = true, SignBothSides = true } }
		)
		part(
			"R1_FinishTop",
			"LightingParts",
			Vector3.new(1, 1, 1),
			CFrame.new(fp.X, fp.Y + 9.4, fp.Z),
			Palette.Yellow,
			Enum.Material.Neon,
			{
				shape = Enum.PartType.Ball,
				canCollide = false,
				light = { color = Palette.Yellow, range = 18, brightness = 1.2 },
			}
		)
		-- 착지 표지: 오른쪽 둑에 크림 깃발 (글자 없음 — 빨강은 목적지만)
		local lp = onBeach(9, 10)
		part(
			"R1_LandPole",
			"Buildings",
			Vector3.new(0.35, 6, 0.35),
			CFrame.new(lp.X, lp.Y + 2.6, lp.Z),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		deco(
			"R1_LandFlag",
			Vector3.new(2.6, 1.6, 0.12),
			CFrame.lookAt(Vector3.new(lp.X, lp.Y + 4.6, lp.Z), Vector3.new(lp.X, lp.Y + 4.6, lp.Z) + rr)
				* CFrame.Angles(0, math.rad(90), 0)
				* CFrame.new(1.35, 0, 0),
			Palette.Cream,
			Enum.Material.Fabric,
			{ attrs = { Flag = true } }
		)
		-- 마중 나온 교관 자리: 깃대 하나 (원판 없음)
		local ip = onBeach(20, 3)
		part(
			"R1_GreetPole",
			"Buildings",
			Vector3.new(0.3, 7, 0.3),
			CFrame.new(ip.X, ip.Y + 3.2, ip.Z),
			Palette.Stone,
			Enum.Material.Metal,
			{ canCollide = false }
		)
		deco(
			"R1_GreetPoleTop",
			Vector3.new(0.6, 0.6, 0.6),
			CFrame.new(ip.X, ip.Y + 6.8, ip.Z),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Ball }
		)
		-- 구명튜브 걸이: 기둥 둘 + 가로대 + 튜브
		local rp = onBeach(15, -6.5)
		local rackCF = CFrame.lookAt(Vector3.new(rp.X, rp.Y, rp.Z), Vector3.new(rp.X, rp.Y, rp.Z) + dir)
		for j, sx in ipairs({ -1, 1 }) do
			part(
				"R1_RingRackPost" .. j,
				"Buildings",
				Vector3.new(0.3, 3.4, 0.3),
				rackCF * CFrame.new(sx * 1.1, 1.5, 0),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = false }
			)
		end
		deco(
			"R1_RingRackBar",
			Vector3.new(2.6, 0.25, 0.25),
			rackCF * CFrame.new(0, 3.0, 0),
			Palette.WoodDark,
			Enum.Material.Wood
		)
		deco(
			"R1_RingRackRing",
			Vector3.new(0.3, 1.8, 1.8),
			rackCF * CFrame.new(0, 1.9, 0.2) * CFrame.Angles(0, math.rad(90), 0),
			Palette.Fire,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder }
		)
		-- 해변 유목 (비탈 위 높이에 맞춰)
		local g = rng(1234)
		for j = 1, 3 do
			local dp = onBeach(4 + j * 4, (g() - 0.5) * 16)
			deco(
				"R1_Drift" .. j,
				Vector3.new(3 + g() * 3, 0.7, 0.7),
				CFrame.new(dp.X, dp.Y + 0.25, dp.Z) * CFrame.Angles(0, g() * math.pi, 0),
				C.Driftwood,
				Enum.Material.Wood,
				{ shape = Enum.PartType.Cylinder }
			)
		end
		-- 물가 갈대 둘 (비탈 양옆)
		for j, lat in ipairs({ -8, 8 }) do
			local q = onBeach(2.5, lat)
			reeds("R1_BeachReed" .. j, q.X, q.Z, q.Y, 1300 + j)
		end
	end
	-- 출발 부두 (서쪽 둑): 널판 덱 + 말뚝 4 + 밧줄 + 배로 건너는 널 + 표지 + 구명튜브
	do
		local p, dir = along(LINE, 8)
		local right = rightOf(dir)
		local dockC = p - right * (HALF + 3.5) -- 덱 중심은 둑 바깥 3.5
		local dockCF = CFrame.lookAt(Vector3.new(dockC.X, 0.25, dockC.Z), Vector3.new(dockC.X, 0.25, dockC.Z) + dir)
		part("R1_Dock", "Buildings", Vector3.new(7, 0.5, 16), dockCF, Palette.Wood, Enum.Material.WoodPlanks)
		part(
			"R1_DockEdge",
			"Buildings",
			Vector3.new(0.4, 0.7, 16),
			dockCF * CFrame.new(3.5, 0.3, 0),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		-- 널 사이 틈 (어두운 줄 9, 덱 윗면 0.5 위로 살짝) + 물 쪽 끝 밧줄 말뚝 2 (때깔 3차)
		for j = 1, 9 do
			deco(
				string.format("R1_DockGap%d", j),
				Vector3.new(6.8, 0.04, 0.12),
				dockCF * CFrame.new(0, 0.26, -8 + j * 1.6),
				C.Gap,
				Enum.Material.Wood
			)
		end
		for j, oz in ipairs({ -6.3, 6.3 }) do
			deco(
				"R1_DockBollard" .. j,
				Vector3.new(0.8, 1.2, 0.8),
				dockCF * CFrame.new(2.6, 0.85, oz),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ class = "Part", canCollide = true }
			)
			deco(
				"R1_DockBollardRope" .. j,
				Vector3.new(0.35, 1.05, 1.05),
				dockCF * CFrame.new(2.6, 0.85, oz) * CFrame.Angles(0, 0, math.rad(90)),
				Palette.Rope,
				Enum.Material.Fabric,
				{ shape = Enum.PartType.Cylinder }
			)
		end
		for j, o in ipairs({ { 3.4, -7.5 }, { 3.4, 7.5 }, { -3.4, -7.5 }, { -3.4, 7.5 } }) do
			part(
				"R1_DockPost" .. j,
				"Buildings",
				Vector3.new(0.8, 5, 0.8),
				dockCF * CFrame.new(o[1], -0.4, o[2]),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = false }
			)
		end
		deco(
			"R1_DockRope",
			Vector3.new(0.15, 0.15, 15),
			dockCF * CFrame.new(-3.4, 1.9, 0),
			Palette.Rope,
			Enum.Material.Fabric,
			{ attrs = { Rope = true } }
		)
		-- 배로 건너는 널: 덱 안쪽 모서리에서 물 위로 3 stud (유보트 바닥 −0.4 보다 위라 걸리지 않는다)
		part(
			"R1_DockPlank",
			"Buildings",
			Vector3.new(2.4, 0.25, 3.2),
			dockCF * CFrame.new(4.5, 0.05, 1.5) * CFrame.Angles(0, math.rad(90), 0),
			Palette.Wood,
			Enum.Material.WoodPlanks
		)
		local sp = dockCF * CFrame.new(-2.5, 0, -9)
		part(
			"R1_SignPost",
			"Buildings",
			Vector3.new(0.4, 4.2, 0.4),
			CFrame.new(sp.Position.X, 2.1, sp.Position.Z),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		deco(
			"R1_Sign",
			Vector3.new(5, 2, 0.3),
			CFrame.lookAt(
				Vector3.new(sp.Position.X, 4.4, sp.Position.Z),
				Vector3.new(sp.Position.X, 4.4, sp.Position.Z) - dir
			),
			Palette.Red,
			Enum.Material.SmoothPlastic,
			{
				attrs = {
					SignText = "급류 IBS",
					SignSub = "1일차 · 타기",
					SignLight = true,
					SignBothSides = true,
				},
			}
		)
		deco(
			"R1_LifeRing",
			Vector3.new(0.3, 2.0, 2.0),
			dockCF * CFrame.new(-3.6, 1.6, 4) * CFrame.Angles(0, math.rad(90), 0),
			Palette.Fire,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder }
		)
		deco(
			"R1_Barrel",
			Vector3.new(1.6, 2.0, 1.6),
			dockCF * CFrame.new(-2.4, 1.5, -5.5),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, canCollide = true }
		)
		deco(
			"R1_RopeCoil",
			Vector3.new(1.4, 0.4, 1.4),
			dockCF * CFrame.new(1.8, 0.7, 6),
			Palette.Rope,
			Enum.Material.Fabric,
			{ shape = Enum.PartType.Cylinder }
		)
		-- 출발 거품 (물이 흐르는 느낌)
		foam("R1_StartFoam1", Vector3.new(p.X, UPPER_Y + 0.06, p.Z) + dir * 6 + right * 2, dir, 6, 1.2)
		foam("R1_StartFoam2", Vector3.new(p.X, UPPER_Y + 0.06, p.Z) + dir * 14 - right * 2.5, dir, 5, 1.0)
	end
	-- 둑 꾸미기: 바깥 둑 소나무·들풀·바위 (12 stud 마다 한 쪽씩, 수로 가장자리에서 4~8 stud 바깥)
	do
		local g = rng(4242)
		local n = 0
		local sv = 14
		while sv < total - 14 do
			n += 1
			local p, dir = along(LINE, sv)
			local right = rightOf(dir)
			local side = if n % 2 == 0 then 1 else -1
			local y = waterY(sv)
			local bankY = 0 -- 둑 윗면은 어느 층이든 땅(0)
			local off = HALF + 4 + g() * 4
			local q = p + right * (side * off)
			local kind = g()
			if kind < 0.4 then
				pine("R1_Pine" .. n, q.X, q.Z, 0.85 + g() * 0.5, 5000 + n, bankY)
			elseif kind < 0.7 then
				rocks("R1_BankRock" .. n, Vector3.new(q.X, bankY, q.Z), 0.9 + g() * 0.5, 5100 + n, false)
			else
				tuft("R1_Tuft" .. n, q.X, q.Z, 1.1, 5200 + n, bankY)
				local q2 = p + right * (side * (off + 4))
				tuft("R1_Tuft" .. n .. "b", q2.X, q2.Z, 0.9, 5300 + n, bankY)
			end
			-- 협곡 구간: 물가 가장자리 젖은 바위 (벽 밑)
			if y < -2 and g() < 0.5 then
				local e = p + right * (-side * (HALF - 0.3))
				rocks("R1_EdgeRock" .. n, Vector3.new(e.X, y - 0.3, e.Z), 0.6, 5400 + n, true)
			end
			sv += 13
		end
	end
	-- ===== 때깔 3차: 배에서 보는 둑 (21_ride_05 — 둑이 밋밋한 모래 평면) =====
	local skipLo, skipHi = FALLS_S - 6, FALLS_S + FALLS_LEN + 6 -- 폭포 턱 앞뒤 (바위·표지)
	-- 길이 L 의 구간을 7~10 stud 조각으로 나눠 fn(조각 가운데 s, 조각 길이, 번호) — 긴 막대 하나는 콘크리트 보처럼 보였다(21_art_2x 1차)
	local function chunks(s0: number, s1: number, g: () -> number, fn: (number, number, number) -> ())
		local sv, k = s0, 0
		while sv < s1 - 2 do
			k += 1
			local len = math.min(7 + g() * 3, s1 - sv)
			fn(sv + len / 2, len, k)
			sv += len + 0.4 + g() * 1.2
		end
	end
	-- (1) 둑 가장자리 돌: 윗물 구간(둑이 물 위 1 stud 로 낮은 곳)에만, 양쪽 조각 돌 (협곡은 벽 띠가 대신)
	do
		local g = rng(7100)
		for _, sx in ipairs({ -1, 1 }) do
			local side = if sx < 0 then "L" else "R"
			chunks(if sx < 0 then 20 else 6, skipLo, g, function(sm, len, k)
				local p, d = along(LINE, sm)
				local q = p + rightOf(d) * (sx * (HALF + 2.4 + g() * 0.6))
				local h = 0.55 + g() * 0.4
				deco(
					string.format("R1_EdgeStone%s%d", side, k),
					Vector3.new(1.3 + g() * 0.6, h, len),
					CFrame.lookAt(Vector3.new(q.X, h * 0.2, q.Z), Vector3.new(q.X, h * 0.2, q.Z) + d)
						* CFrame.Angles((g() - 0.5) * 0.1, (g() - 0.5) * 0.25, (g() - 0.5) * 0.3),
					if k % 3 == 0 then C.Basalt else C.StoneEdge,
					if k % 3 == 0 then Enum.Material.Basalt else Enum.Material.Slate
				)
			end)
		end
	end
	-- (2) 협곡 벽 층 바위: 아랫물 구간 양쪽, 조각마다 아래(어두운 Basalt)·위(청회 Slate) 띠, 셋째마다 맨 위 따뜻한 Sandstone 얇은 띠.
	--     조각마다 높이·두께·바깥으로 물린 정도가 달라 층진 바위 벽처럼
	do
		local g = rng(7150)
		for _, sx in ipairs({ -1, 1 }) do
			local side = if sx < 0 then "L" else "R"
			chunks(FALLS_S + FALLS_LEN + 2, total - 10, g, function(sm, len, k)
				local p, d = along(LINE, sm)
				local rt = rightOf(d) * sx
				local bands = {
					{ HALF + 0.8 + g() * 0.4, LOWER_Y + 0.6 + g() * 0.3, 1.5, 1.2, C.BandDark, Enum.Material.Basalt },
					{
						HALF + 1.4 + g() * 0.5,
						LOWER_Y + 2.2 + g() * 0.4,
						1.7,
						1.4 + g() * 0.4,
						C.BandMid,
						Enum.Material.Slate,
					},
				}
				if k % 3 == 0 then
					table.insert(bands, { HALF + 2.1, LOWER_Y + 3.6, 1.4, 0.7, C.BandWarm, Enum.Material.Sandstone })
				end
				for b, band in ipairs(bands) do
					local m = p + rt * band[1]
					deco(
						string.format("R1_GorgeBand%s%d_%d", side, k, b),
						Vector3.new(band[3], band[4], len),
						CFrame.lookAt(Vector3.new(m.X, band[2], m.Z), Vector3.new(m.X, band[2], m.Z) + d)
							* CFrame.Angles((g() - 0.5) * 0.08, (g() - 0.5) * 0.12, sx * math.rad(3 + g() * 6)),
						band[5],
						band[6]
					)
				end
			end)
		end
	end
	-- (3) 둑 위 덤불·들풀·작은 나무 (기존 13 stud 줄과 엇갈리게 6.5 뒤, 반대쪽)
	do
		local g = rng(7200)
		local m = 0
		local sv = 20.5
		while sv < total - 16 do
			m += 1
			local p, dir = along(LINE, sv)
			local side = if m % 2 == 1 then 1 else -1
			local skip = (side == -1 and sv < 22)
				or (side == 1 and math.abs(sv - 117) < 7)
				or (sv > skipLo and sv < skipHi)
			if not skip then
				local q = p + rightOf(dir) * (side * (HALF + 4 + g() * 4))
				local kind = g()
				if kind < 0.35 then
					smallTree("R1_BankTree" .. m, q.X, q.Z, 0.9 + g() * 0.35, 7300 + m, 0)
				elseif kind < 0.75 then
					bush("R1_BankBush" .. m, q.X, q.Z, 0.9 + g() * 0.4, 7400 + m, 0)
				else
					tuft("R1_BankTuft" .. m, q.X, q.Z, 1.0, 7500 + m, 0)
					local q2 = q + dir * 2.5
					tuft("R1_BankTuft" .. m .. "b", q2.X, q2.Z, 0.8, 7600 + m, 0)
				end
			end
			sv += 13
		end
	end
	-- (4) 물가 갈대 (윗물 구간 둑 끝, 바위·부두·가지를 피해서)
	for i, rd in ipairs({ { 26, 1 }, { 52, 1 }, { 60, -1 }, { 86, -1 }, { 93, 1 }, { 112, -1 } }) do
		local p, dir = along(LINE, rd[1])
		local q = p + rightOf(dir) * (rd[2] * (HALF + 0.8))
		reeds("R1_Reed" .. i, q.X, q.Z, UPPER_Y, 1400 + i)
	end

	-- U 턴 안쪽 섬: 소나무 셋 + 바위 (협곡 위 둔덕)
	pine("R1_IsleP1", 108, -188, 1.3, 6001, 0)
	pine("R1_IsleP2", 100, -200, 1.0, 6002, 0)
	pine("R1_IsleP3", 116, -176, 0.9, 6003, 0)
	rocks("R1_IsleRock", Vector3.new(104, 0, -180), 1.4, 6004, false)
	tuft("R1_IsleT1", 96, -186, 1.2, 6005, 0)
	tuft("R1_IsleT2", 112, -196, 1.0, 6006, 0)
end

-- ===== 4일차 바다: 부표 지그재그를 따라가는 경로점 + 파도 5 + 도착 =====
local SEA_PTS = {
	Vector3.new(0, -1, -752),
	Vector3.new(-25, -1, -775),
	Vector3.new(25, -1, -815),
	Vector3.new(-25, -1, -855),
	Vector3.new(25, -1, -895),
	Vector3.new(-25, -1, -935),
	Vector3.new(25, -1, -975),
	Vector3.new(-20, -1, -1005),
	Vector3.new(0, -1, -1025),
}

local function buildSea()
	local total = polyLength(SEA_PTS)
	local idx = 0
	local sv = 0
	while sv < total - 4 do
		idx += 1
		local p, _dir = along(SEA_PTS, sv)
		trigger(string.format("R4_P%02d", idx), Vector3.new(1, 1, 1), CFrame.new(p.X, -1, p.Z), {
			Kind = "RIDE",
			Day = 4,
			Index = idx,
			S = sv,
		})
		sv += 16
	end
	idx += 1
	trigger(string.format("R4_P%02d", idx), Vector3.new(1, 1, 1), CFrame.new(0, -1, -1027), {
		Kind = "RIDE",
		Day = 4,
		Index = idx,
		S = total + 2,
	})
	-- 파도 5 (번갈아 L/R): 2·3·4·6·7 구간 가운데
	local waveN = 0
	for _, segI in ipairs({ 2, 3, 4, 6, 7 }) do
		waveN += 1
		local a, b = SEA_PTS[segI], SEA_PTS[segI + 1]
		local mid = (a + b) / 2
		local dir = (b - a).Unit
		trigger(
			"R4_Wave" .. waveN,
			Vector3.new(14, 6, 4),
			CFrame.lookAt(Vector3.new(mid.X, 2, mid.Z), Vector3.new(mid.X, 2, mid.Z) + dir),
			{ Kind = "RIDE", Day = 4, RideType = "WAVE", Side = if waveN % 2 == 1 then "L" else "R", S = 0 }
		)
	end
	-- 줍기 8 (급류 2차): 구간 seg 의 t 자리, 진행 방향 왼쪽/오른쪽 5 — 파도를 피한 쪽 바로 뒤(상)와 반대쪽(고르기)이 섞인다
	local seaItems = {
		{ seg = 1, t = 0.6, side = "R", item = "WOOD" },
		{ seg = 2, t = 0.85, side = "R", item = "WOOD" },
		{ seg = 3, t = 0.85, side = "L", item = "WATER" },
		{ seg = 4, t = 0.85, side = "L", item = "WOOD" },
		{ seg = 5, t = 0.5, side = "R", item = "WOOD" },
		{ seg = 6, t = 0.85, side = "L", item = "WOOD" },
		{ seg = 7, t = 0.25, side = "L", item = "WOOD" },
		{ seg = 8, t = 0.5, side = "R", item = "WATER" },
	}
	for i, it in ipairs(seaItems) do
		local a, b = SEA_PTS[it.seg], SEA_PTS[it.seg + 1]
		local dir = (b - a).Unit
		local sx = if it.side == "L" then -1 else 1
		local q = a:Lerp(b, it.t) + rightOf(dir) * (sx * 5)
		trigger(
			string.format("R4_Item%02d", i),
			Vector3.new(2, 2, 2),
			CFrame.lookAt(Vector3.new(q.X, -1, q.Z), Vector3.new(q.X, -1, q.Z) + dir),
			{ Kind = "RIDE", Day = 4, RideType = "ITEM", Side = it.side, Item = it.item, S = 0 }
		)
	end
	-- 도착: 섬 부두(z −1033 앞면) 12 stud 앞에서 서기 시작 → 2초 동안 8 stud 쯤 더 가서 코가 부두 앞에 멈춘다 (Studio 2026-10-21: −1030 이면 부두를 뚫었다)
	trigger(
		"R4_Finish",
		Vector3.new(18, 8, 6),
		CFrame.new(0, 2, -1010),
		{ Kind = "RIDE", Day = 4, RideType = "FINISH", S = total - 15 }
	)
end

function CampRideCourse.specs(): { Spec }
	table.clear(out)
	table.clear(used)
	buildChannel()
	buildSea()
	return table.clone(out)
end

-- ===== Terrain: 수로 파기·물 채우기 (Bootstrap.fillTerrain 의 바닥 풀·모래 뒤에 호출된다) =====
-- 복셀 4 stud 격자에 **축 정렬 셀 단위**로 채운다 (Studio 실측 2026-10-21: 길 방향으로 돌린 FillBlock 은 셀 점유율이 표본 잡음이라
-- 수면이 −2.2~−5.4 로 울퉁불퉁했다. 축 정렬 블록은 바다처럼 수면이 고르다). 벽은 4 stud 계단이 되지만 둑 바위·소나무가 가린다.
-- 수면 = 채운 윗면 (바다 −1 실측과 같은 규칙), 땅 표면은 윗면 +2.
local CELL = 4
local function cellProject(p: Vector3): (number, number)
	-- 점 → 꺾은선 거리 s, 수평 거리
	local bestS, bestD = 0, math.huge
	local acc = 0
	for i = 1, #LINE - 1 do
		local a, b = LINE[i], LINE[i + 1]
		local ab = b - a
		local l2 = ab:Dot(ab)
		local u = if l2 > 0 then math.clamp((p - a):Dot(ab) / l2, 0, 1) else 0
		local q = a + ab * u
		local d = (Vector3.new(q.X - p.X, 0, q.Z - p.Z)).Magnitude
		if d < bestD then
			bestD = d
			bestS = acc + math.sqrt(l2) * u
		end
		acc += math.sqrt(l2)
	end
	return bestS, bestD
end

function CampRideCourse.terrain()
	local T = workspace.Terrain
	local total = polyLength(LINE)
	local function fill(cx: number, cz: number, y0: number, y1: number, mat: Enum.Material)
		T:FillBlock(CFrame.new(cx, (y0 + y1) / 2, cz), Vector3.new(CELL, y1 - y0, CELL), mat)
	end
	-- 셀 중심은 4k+2. 경계 상자: 중심선 ±22
	local xmin, xmax, zmin, zmax = math.huge, -math.huge, math.huge, -math.huge
	for _, p in ipairs(LINE) do
		xmin, xmax = math.min(xmin, p.X), math.max(xmax, p.X)
		zmin, zmax = math.min(zmin, p.Z), math.max(zmax, p.Z)
	end
	local function cells(fn: (number, number, number, number) -> ())
		local cx = math.floor((xmin - 22) / CELL) * CELL + 2
		while cx <= xmax + 22 do
			local cz = math.floor((zmin - 22) / CELL) * CELL + 2
			while cz <= zmax + 22 do
				local s, d = cellProject(Vector3.new(cx, 0, cz))
				if d <= HALF + 7 then
					fn(cx, cz, s, d)
				end
				cz += CELL
			end
			cx += CELL
		end
	end
	-- 1) 협곡 벽 Rock 띠 (아랫물 구간, 중심선 ±(HALF+5), y −12..−4 — 풀 윗층 −4..−2 는 남긴다)
	--    윗물 구간 둑 모래 띠 (±(HALF+4), 윗 셀 −6..−2 = CampArt.patch 와 같은 틀)
	cells(function(cx, cz, s, d)
		if s >= FALLS_S - 2 and s < total - 6 and d <= HALF + 5 then
			fill(cx, cz, -12, -4, Enum.Material.Rock)
			if d > HALF + 0.3 and d <= HALF + 3 then
				fill(cx, cz, -6, -2, Enum.Material.Slate) -- 때깔 3차: 벽 위 가장자리를 청회 바위로 (물 위 벽 면 + 둑 끝)
			end
		elseif s < FALLS_S and d <= HALF + 4 then
			fill(cx, cz, -6, -2, Enum.Material.Sand)
		end
	end)
	-- 2) 수로: 공기(바닥 −4 아래 ~ 땅 위 +4) + 바닥 모래 + 물(층별 수면). 폭포 턱 구간은 물 없이 (Glass 판이 덮는다)
	--    폭 12 = 셀 3 — 중심 6.3 안의 셀 (격자 위치에 따라 12~16)
	cells(function(cx, cz, s, d)
		if d > HALF + 0.3 or s > total + 2 then
			return
		end
		local y = waterY(s)
		local floorY = y - 4
		fill(cx, cz, floorY, 4, Enum.Material.Air)
		fill(cx, cz, floorY - 3, floorY, Enum.Material.Sand)
		local inLip = s > FALLS_S - 1 and s < FALLS_S + FALLS_LEN + 1
		if not inLip then
			fill(cx, cz, floorY, y, Enum.Material.Water)
		end
	end)
	-- 3) 출발 웅덩이 (부두 앞을 넓게, 반지름 HALF+3) + 해변: 모래 비탈(쐐기) + 모래밭
	do
		local p0 = LINE[1]
		T:FillCylinder(CFrame.new(p0.X, -1.5, p0.Z), 11, HALF + 3, Enum.Material.Air)
		T:FillCylinder(CFrame.new(p0.X, -6.5, p0.Z), 3, HALF + 4, Enum.Material.Sand)
		T:FillBlock(CFrame.new(p0.X, -3, p0.Z), Vector3.new(WIDTH + 6, 4, WIDTH + 6), Enum.Material.Water) -- 축 정렬: 수면 −1
		local pe, dir = along(LINE, total)
		local right = rightOf(dir)
		-- 해변 (때깔 3차): 돌린 쐐기·블록(물결처럼 거칠었다 — 21_ride_04) 대신 **축 정렬 4 stud 칸마다 높이를 beachY 로** 채운다.
		-- 칸 높이가 비탈을 따라 조금씩 달라 부분 점유로 매끈하게 이어진다. 땅 표면 = 채운 윗면 + 2 (기존 실측 규칙)
		local SAND_OFF = 2
		local bx0 = math.floor((pe.X - 40) / CELL) * CELL + 2
		local bz0 = math.floor((pe.Z - 40) / CELL) * CELL + 2
		local cx = bx0
		while cx <= pe.X + 40 do
			local cz = bz0
			while cz <= pe.Z + 40 do
				local rel = Vector3.new(cx - pe.X, 0, cz - pe.Z)
				local t = rel:Dot(dir)
				local lat = math.abs(rel:Dot(right))
				-- 나무 둔덕: 칸 하나를 통째로 남기면 세로 모래 벽이 됐다(21_art_2x 1차) → 나무에서 멀어질수록 낮아지는 원뿔 둔덕
				local mound = -math.huge
				for _, kp in ipairs(BEACH_KEEP) do
					local dist = (Vector3.new(cx, 0, cz) - kp).Magnitude
					mound = math.max(mound, -math.max(0, dist - 2.5) * 1.6) -- 가파르게: 배 길(t 4~8, 나무에서 6.5 이상)엔 닿지 않는다
				end
				if t >= 0 and t <= BEACH_LEN and lat <= HALF + 14 then
					local surf = math.max(beachY(t, lat), mound)
					fill(cx, cz, -12, 8, Enum.Material.Air)
					if surf < -4.4 and lat <= HALF + 2 then
						fill(cx, cz, -8, -4, Enum.Material.Water) -- 비탈 아래쪽은 아랫물(−4)이 덮는다
					end
					fill(cx, cz, -14, surf - SAND_OFF, Enum.Material.Sand)
				elseif t < 0 and t >= -12 and lat > HALF + 0.3 and lat <= HALF + 12 then
					-- 협곡 벽 끝: 높이는 그대로, 윗면만 모래로 (해변으로 녹아든다)
					fill(cx, cz, -6, -2, Enum.Material.Sand)
				end
				cz += CELL
			end
			cx += CELL
		end
	end
end

-- Edit 모드 검증: 경로점·장애물 수, 수면 높이 실측(레이캐스트) — Bootstrap.check() 에 줄을 못 넣어 여기서 (28 §3)
function CampRideCourse.check(): string
	local lines = { "[RIDE CHECK]" }
	local folder = workspace:FindFirstChild("Triggers")
	folder = folder and folder:FindFirstChild("Camp")
	if not folder then
		return "[RIDE CHECK] Triggers.Camp 없음"
	end
	local counts: { [string]: number } = {}
	for _, inst in ipairs(folder:GetChildren()) do
		if inst:GetAttribute("Kind") == "RIDE" then
			local day = tostring(inst:GetAttribute("Day"))
			local t = tostring(inst:GetAttribute("RideType") or "PATH")
			local k = "D" .. day .. " " .. t
			counts[k] = (counts[k] or 0) + 1
		end
	end
	local keys = {}
	for k in pairs(counts) do
		table.insert(keys, k)
	end
	table.sort(keys)
	for _, k in ipairs(keys) do
		table.insert(lines, string.format("  %s = %d", k, counts[k]))
	end
	-- 수면·둑 높이 실측 (Terrain 만)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	for _, sv in ipairs({ 20, 80, 150, 220, 280, 300 }) do
		local p, dir = along(LINE, sv)
		local right = rightOf(dir)
		local function hit(q: Vector3): string
			local r = workspace:Raycast(q + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), params)
			if not r then
				return "없음"
			end
			return string.format("%.1f(%s)", r.Position.Y, tostring(r.Material):gsub("Enum.Material.", ""))
		end
		table.insert(
			lines,
			string.format(
				"  s=%d 가운데 %s · 왼둑 %s · 오른둑 %s (기대 수면 %.0f)",
				sv,
				hit(p),
				hit(p - right * (HALF + 3)),
				hit(p + right * (HALF + 3)),
				waterY(sv)
			)
		)
	end
	return table.concat(lines, "\n")
end

CampRideCourse.Line = LINE
CampRideCourse.Events = EVENTS
CampRideCourse.Items = ITEMS
CampRideCourse.waterY = waterY
CampRideCourse.along = along

return CampRideCourse
]]></string>
