	BobStuds = 0.14,
	ServerOwnsBoat = true, -- false 면 플레이어 클라이언트가 배 물리를 돈다 (폰 비교용 — NOT_RUN)
	WakeMinSpeed = 2, -- 클라이언트 물결: 이보다 느리면 꺼짐
	JumpWindowSec = 1.4, -- 폭포 앞뒤 이 창 안에서 뛰면 "붕" (클라이언트 연출만 — 점수 없음)
	DirtyEverySec = 0.25, -- 진행 막대용 스냅샷 갱신 주기
	CameraMinZoom = 20, -- RIDE 중 기본 카메라 최소 거리 (배와 분대원 넷이 한 화면에 — 12 는 뒷자리 분대원 머리가 화면을 가렸다. 앉아서 젓기 20)
	DebugAttrs = false, -- true 면 workspace 속성 Ride_* 로 상태를 내보낸다 (Studio 봇 폴링, 매 프레임 씀)
	-- ===== 급류 2차 (2026-10-21): 분대원이 아이를 따라온다 · 물 위 줍기 · 노 젓기 =====
	-- 바위·가지·파도 경고(할 일 판·갑판 빛)가 뜨면 분대원은 아이를 먼저 본다:
	--   아이가 맞는 쪽으로 먼저 가면 바로 따라간다("그래, 오른쪽!") → 깨끗이 비껴감 (내가 먼저 움직인 바위 +1)
	--   아이가 반대로 가면 LeadWaitSec 뒤 미르가 바로잡고 같이 간다 · 아무것도 안 하면 부딪히기 LateMoveSec 전에 늦게 간다 → 대개 비껴가지만 아슬아슬(긁힘)
	LeadWaitSec = 0.7, -- 아이를 기다리는 시간 (이 뒤로 반대쪽에 있으면 미르가 바로잡는다)
	LateMoveSec = 1.2, -- 아이가 아무것도 안 하면 부딪히기 이만큼 전에 분대원이 늦게 옮긴다
	LeadSideX = 1.3, -- 아이 발 자리가 안전한 쪽으로 이만큼 넘으면 "먼저 움직였다" (내 기본 자리 ±0.64 에서 걸어야 넘는다 — 0.9 는 배가 기울 때 가만히 있어도 넘었다, Studio)
	LeadCenterX = 0.3, -- 가지: 아이가 가운데(|x| ≤) 에 있으면 먼저 움직인 것 (기본 자리 ±0.64 에서 한 걸음)
	ScrapeScale = 0.35, -- 긁힘: 쿵의 밀림·흔들림 × 이만큼 (빠지지 않음)
	-- 물 위 줍기 (Build a Boat 보물 줍기 꼴): 배가 지나갈 때 그쪽으로 기울었거나(아이도 그쪽에) 손이 닿으면 줍는다. 놓쳐도 벌 없음
	ItemLeanDeg = 6, -- 그쪽으로 이만큼 기울어야
	ItemMeSideX = 1.4, -- 그리고 아이 발 자리가 그쪽으로 이만큼 (분대원이 기울인 것만으론 안 줍는다 — 줍기는 아이 몫. 0.8 은 가만히 있어도 넘었다)
	ItemReachX = 2.2, -- 또는 아이 발 자리가 그쪽 난간 가까이(이만큼 넘게) 가 있으면 손으로 건진다 (배가 반대로 기울어도). 처음엔 몸~줍기 거리 3.5·3.0 으로 쟀는데 굽이에서 스플라인이 물건 쪽으로 붙어 가만히 있어도 닿았다 (Studio)
	ItemCallMax = 2, -- 처음 이만큼은 두리가 "왼쪽에 장작!" 하고 알려 준다
	ItemCallSec = 2.2, -- 그 말은 이만큼 앞에서
	ItemReactEvery = 3, -- 주울 때 분대원이 한마디 하는 간격 (첫 번째는 꼭)
	ItemFloatLift = 0.15, -- 수면 위로 띄우는 높이 (메시 밑면 기준, 반쯤 잠김)
	-- 노 젓기 (클라이언트 RideCrew): 분대원 팔·노 한 번 젓기 주기
	RowStrokeSec = 1.1,
	-- ===== 앉아서 직접 젓기 (2026-10-21 플레이테스트 "노 젓는 것도 아니고" → Build a Boat·보트 게임 꼴) =====
	-- 내 자리 튜브 위에 앉는다. W(↑·스틱 위) = 노 젓기, A/D(스틱 좌우) = 방향. 한 번 젓기(RowStrokeSec, 서버 시각 박자)마다 밀려 나간다
	RapidsBaseSpeed = 5, -- 급류: 안 저어도 물살로 이만큼 (멈추지 않음)
	RapidsRowAdd = 6, -- 급류: 저으면 이만큼 더 (RowRampSec 에 걸쳐)
	RowRampSec = 1.0, -- 저으면 힘이 다 붙기까지
	RowFadeSec = 0.8, -- 떼면 힘이 빠지기까지
	StrokeSurge = 0.35, -- 한 번 젓기마다 속도가 출렁이는 폭 (당기는 반 바퀴에 빨라짐)
	RowAccel = 12, -- 속도가 붙는 가속 stud/s²
	RowDecel = 8, -- 줄어드는 감속 stud/s²
	LatSpeed = 8, -- A/D 옆으로 가는 속도 stud/s
	LatEase = 6, -- 옆 속도가 따라붙는 빠르기 (1/s)
	CenterPull = 0.6, -- 급류: 손을 떼면 물살이 가운데로 (lat × 이것 stud/s)
	RapidsLatMax = 2.4, -- 급류: 옆 자리 한계 (수로 반폭 6 − 배 반폭 3.5 − 여유)
	SeaLatMax = 14, -- 바다: 부표 길에서 옆으로 이만큼
	SteerYawDeg = 12, -- 도는 쪽으로 뱃머리
	SteerRollDeg = 4, -- 도는 쪽으로 기울기 (바닥이 물에 안 잠기게 작게)
	ReseatSec = 0.4, -- 자리에서 떨어진 채 이만큼이면 다시 앉힌다
	-- 바위: 지나는 순간 옆 자리(바위 쪽 +)로 판정
	RockClearLat = 0.7, -- 바위 반대쪽으로 이만큼 비켜 있으면 깨끗이 (내가 방향 잡아 피함)
	RockScrapeLat = 0.3, -- 반대쪽으로 이만큼~RockClearLat 이면 스침. 이보다 바위 쪽(가만히 가운데 포함)이면 쿵 — 못 피했을 때가 분명하게
	RockMarkLat = 4.4, -- 바위 위 빨간 ▼ 자리 (수로 가운데에서 그쪽으로)
	BumpSlow = 0.45, -- 쿵: 속도 × 이만큼 (바로)
	BumpSlowSec = 1.5, -- 쿵: 이 동안 크게 느림 + 빙 돌았다 돌아옴 + 할 일 판 "쿵!"
	BumpSlowMul = 0.35, -- 그동안 목표 속도 × 이만큼 (멈추지 않음)
	BumpSpinDeg = 55, -- 쿵: 바위 반대쪽으로 뱃머리가 도는 최대 각
	RowSoft = 0.45, -- 급류: 내가 안 저어도 분대원은 천천히 젓는다 (팔 폭)
	ScrapeSlow = 0.8, -- 긁힘: 속도 × 이만큼
	BumpLatPush = 1.0, -- 쿵: 바위 반대쪽으로 튕김 stud
	DuckAhead = 7, -- 가지 이만큼 앞에서 분대원이 숙인다
	DuckBehind = 4,
	WavePushVel = 12, -- 파도: 반대쪽으로 밀리는 옆 속도 (저으며 넘으면 반)
	WaveFallChance = 0.3, -- 파도: 안 젓고 있으면 그쪽 사람이 빠질 확률
	ItemSteerLat = 0.9, -- 줍기: 그쪽으로 이만큼 배를 몰았고
	ItemPickLat = 4.2, -- 배 가운데 ~ 물건 옆 거리가 이 안이면 뱃전이 닿아 건진다
}

-- 6일 중 기본으로 재생하는 "밤" 수 (갯벌을 뺀 뒤 4박)
GameConfig.NightsTotal = 4

-- 입소 훈련복 (M025): 들어오면 모두 같은 디지털 무늬 훈련복. 자체 제작 옷본(docs/art/uniform, 글자·국기·부대 마크 없음).
-- 머리카락·얼굴 장식만 남기고 모자·겹옷·등 장식은 벗긴다. 등에는 쏘지 않는 나무 목총을 멘다 (M026, 사용자 지시).
GameConfig.Uniform = {
	Shirt = "rbxassetid://136947973608914",
	Pants = "rbxassetid://85535148434788",
	BackRifle = true,
}

-- 조용한 분대원 (플레이테스트 2026-10-21 "친구들 정신 사납다, 대화 포함 다 없애"): 두리·산·미르의 말풍선·자막은 기본으로 막고,
-- 밤 모닥불 옆에 앉았을 때 이야기·일으켜/풀어 줬을 때 고마움만 남긴다. 혼자 뛰어다니는 동작(응원·짐 내밀기·낮 줍기)도 끈다.
GameConfig.Quiet = {
	Enabled = true,
	BuildOffers = false, -- 꾸미기 때 분대원이 짐을 들고 와 내밀기
	ObbyCheer = false, -- 유격·야간·탈출에서 돌아가며 응원 한 마디·손 흔들기
	NpcPick = false, -- 낮에 분대원이 장작을 대신 줍기
	InstructorCalls = false, -- 망루 교관의 아무 때 외침 (출발·도착 같은 장면 대사는 그대로)
}
return GameConfig
]]></string>
