        <Item class="ModuleScript" referent="6220">
          <Properties>
            <string name="Name">TelemetryService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{C272A4E4-EFDA-44F3-8524-6958347A69AB}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 분석 이벤트: 기본 꺼짐. 켜도 서버 콘솔에만 남긴다 (외부 전송 없음). 아이 개인 정보·자유 문장은 넣지 않는다.
local TelemetryService = {}

TelemetryService.enabled = false
local buffer: { { name: string, at: number, fields: { [string]: any } } } = {}
local LIMIT = 500

function TelemetryService.log(name: string, fields: { [string]: any }?)
	if not TelemetryService.enabled then
		return
	end
	table.insert(buffer, { name = name, at = os.time(), fields = fields or {} })
	while #buffer > LIMIT do
		table.remove(buffer, 1)
	end
end

function TelemetryService.dump(): { any }
	return table.clone(buffer)
end

return TelemetryService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003f1</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6221">
          <Properties>
            <string name="Name">WorldLoop</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{9AC5A5C3-16A5-4E07-A0DB-620B972DFC46}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 서버 틱: 세션 이동·NPC 박자·스냅샷 전송·자동 저장. Heartbeat 하나로 돈다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local SessionService = require(script.Parent.SessionService)

local WorldLoop = {}

local snapshotAcc = 0
local autosaveAcc = 0
local renewAcc = 0

function WorldLoop.start()
	RunService.Heartbeat:Connect(function(dt)
		for _, session in pairs(SessionService.Sessions) do
			local ok, err = pcall(SessionService.tick, session, dt)
			if not ok then
				warn("[Camp] tick failed for " .. tostring(session.userId) .. ": " .. tostring(err))
			end
		end
		snapshotAcc += dt
		if snapshotAcc >= 1 / GameConfig.Network.SnapshotHz then
			snapshotAcc = 0
			for _, session in pairs(SessionService.Sessions) do
				if session.snapshotDirty then
					SessionService.pushSnapshot(session)
				end
			end
		end
		autosaveAcc += dt
		if autosaveAcc >= GameConfig.Save.AutosaveSec then
			autosaveAcc = 0
			task.spawn(SessionService.saveAll, false)
		end
		renewAcc += dt
		if renewAcc >= GameConfig.Save.RenewSec then
			renewAcc = 0
			task.spawn(SessionService.renewLeases)
		end
	end)
end

return WorldLoop
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003f2</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6222">
          <Properties>
            <string name="Name">InstructorService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{ACA8E05D-EB33-4575-A300-6491833F7AB4}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 강찬 교관: 서버에 하나뿐인 R15 리그. 기지 망루와 1일차 망루에 서서 구호를 외치고, 지나가는 유보트에 "더 높이!" 를 외친다.
-- 소리로 밀지만 밤에는 돌보는 사람(01_CONCEPT §4). 말풍선은 SquadNpcService 와 같은 속성 계약(Bubble/BubbleToken) 으로 클라이언트가 그린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local SquadNpcService = require(script.Parent.SquadNpcService)
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local InstructorService = {}

-- 망루 위 구호 (짧고, 비난 없음 — 05_VOICE §3)
local CALLS = {
	"하나 둘! 하나 둘!",
	"허리 펴!",
	"좋다!",
	"배에서 떨어지지 마라!",
	"악!",
	"한 배 타자!",
}
local NEAR_CALLS = { "가운데로!", "몸으로 피해!", "좋아 그대로!", "하나 둘!" } -- 급류를 타는 유보트가 망루 옆을 지날 때 (6단계)

type Post = { rig: SquadNpcService.Rig, pos: Vector3, look: Vector3, nextCallAt: number, nearSaidAt: number }
local posts: { Post } = {}
local rng = Random.new(7)

local function instructorMember(): SquadCatalog.Member
	return {
		id = SquadCatalog.Instructor.id,
		nameKo = SquadCatalog.Instructor.nameKo,
		emoji = SquadCatalog.Instructor.emoji,
		power = 3,
		rhythm = 3,
		water = 3,
		height = 3,
		shirt = Palette.OliveDark,
		pants = Palette.OliveDark,
		scale = 1.08,
	}
end

-- 망루 상판 파트를 이름으로 찾는다 (생성기 Tower_Deck / D1_TowerDeck). 없으면 그 자리는 건너뛴다
local function deckTop(name: string): (Vector3?, Vector3?)
	local buildings = SceneBindings.getFolder("Buildings")
	local deck = buildings and buildings:FindFirstChild(name)
	if deck and deck:IsA("BasePart") and deck:GetAttribute("ProjectId") == SceneBindings.ProjectId then
		local top = deck.Position + Vector3.new(0, deck.Size.Y / 2, 0)
		return top, nil
	end
	return nil, nil
end

local function makePost(deckName: string, look: Vector3, parent: Instance)
	local top = deckTop(deckName)
	if not top then
		return
	end
	local rig = SquadNpcService.createRig(instructorMember(), parent)
	rig.model.Name = "Npc_KANG_" .. deckName
	-- 확성기: 오른손 앞에 빨간 원뿔(원기둥) 하나
	local hand = rig.model:FindFirstChild("RightHand") :: BasePart?
	if hand then
		local mega = Instance.new("Part")
		mega.Name = "Megaphone"
		mega.Shape = Enum.PartType.Cylinder
		mega.Size = Vector3.new(1.4, 0.9, 0.9)
		mega.Color = Palette.Red
		mega.Material = Enum.Material.SmoothPlastic
		mega.CanCollide = false
		mega.CanQuery = false
		mega.CanTouch = false
		mega.Massless = true
		mega.CFrame = hand.CFrame * CFrame.new(0, -0.2, -0.9) * CFrame.Angles(0, math.rad(90), 0)
		mega.Parent = rig.model
		local w = Instance.new("WeldConstraint")
		w.Part0 = hand
		w.Part1 = mega
		w.Parent = mega
	end
	-- 명찰 글자는 createRig 가 nameKo 로 붙였다. 팔각모는 그대로
	SquadNpcService.standAt(rig, top + Vector3.new(0, 0.1, 0), look)
	table.insert(
		posts,
		{ rig = rig, pos = top, look = look, nextCallAt = os.clock() + rng:NextNumber(4, 10), nearSaidAt = 0 }
	)
end

local function boatsNear(pos: Vector3, radius: number): boolean
	local runtime = SceneBindings.getFolder("Runtime")
	if not runtime then
		return false
	end
	for _, m in ipairs(runtime:GetChildren()) do
		if m:IsA("Model") and string.sub(m.Name, 1, 5) == "Boat_" and m:GetAttribute("Mode") == "WATER" then -- 급류·바다를 타는 유보트 (RIDE)
			local d = (m:GetPivot().Position - pos)
			if Vector3.new(d.X, 0, d.Z).Magnitude <= radius then
				return true
			end
		end
	end
	return false
end

function InstructorService.start()
	local runtime = SceneBindings.ensureRuntimeFolder()
	local holder = runtime:FindFirstChild("Instructor") or Instance.new("Folder")
	holder.Name = "Instructor"
	holder.Parent = runtime
	makePost("Tower_Deck", Vector3.new(-1, 0, 0.3).Unit, holder) -- 기지 망루: 연병장(서쪽) 을 본다
	makePost("D1_TowerDeck", Vector3.new(-1, 0, 0), holder) -- 1일차 망루: 코스(서쪽) 를 본다
	if #posts == 0 then
		warn(
			"[Camp] 교관 망루(Tower_Deck/D1_TowerDeck) 가 없어 강찬 교관을 세우지 못함 — CampSceneBootstrap.apply() 뒤 다시 시작"
		)
		return
	end
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			if GameConfig.Quiet.Enabled and not GameConfig.Quiet.InstructorCalls then
				continue -- 조용한 캠프: 망루 교관의 아무 때 외침 끔
			end
			for _, p in ipairs(posts) do
				if boatsNear(p.pos, 45) and now - p.nearSaidAt > 6 then
					p.nearSaidAt = now
					SquadNpcService.bubble(p.rig, NEAR_CALLS[rng:NextInteger(1, #NEAR_CALLS)], 2)
					SquadNpcService.playOnce(p.rig, "point")
					p.nextCallAt = now + rng:NextNumber(12, 20)
				elseif now >= p.nextCallAt then
					p.nextCallAt = now + rng:NextNumber(18, 40)
					SquadNpcService.bubble(p.rig, CALLS[rng:NextInteger(1, #CALLS)], 2)
					if rng:NextNumber() < 0.5 then
						SquadNpcService.playOnce(p.rig, "wave")
					end
				end
			end
		end
	end)
end

-- 퇴소식·입소 때 교관이 환호 (SessionService 가 부르지 않아도 무해. 클라이언트 FxCue 와 별개)
function InstructorService.cheerAll()
	for _, p in ipairs(posts) do
		SquadNpcService.playOnce(p.rig, "cheer")
	end
end

return InstructorService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000b5f</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6223">
          <Properties>
            <string name="Name">UniformService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{C3740972-1306-4165-83E8-99A6B5381C0F}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 입소 훈련복 (M025): 들어오면 모두 같은 디지털 무늬 훈련복(Shirt/Pants)으로 갈아입힌다.
-- 머리카락·얼굴 장식은 남기고 모자·겹옷(레이어드)·등/허리/어깨 장식·티셔츠 그림은 벗긴다.
-- 그 위에 빨간 명찰(표시 이름)·올리브 팔각모·캠프 마크, 등에는 쏘지 않는 나무 목총 (M026, CLAUDE.md 북극성 2026-10-19 개정).
-- 파트는 Massless·비충돌이라 물리에 영향이 없다. 글자는 SignText 로 클라이언트가 그린다.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Palette = require(Shared:WaitForChild("Palette"))
local SceneBindings = require(Shared:WaitForChild("SceneBindings"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local UniformService = {}

local KEEP_ACCESSORY: { [Enum.AccessoryType]: boolean } = {
	[Enum.AccessoryType.Hair] = true,
	[Enum.AccessoryType.Face] = true,
	[Enum.AccessoryType.Eyebrow] = true,
	[Enum.AccessoryType.Eyelash] = true,
}

local function decor(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p:SetAttribute("ProjectId", SceneBindings.ProjectId)
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

-- 옷 갈아입히기 (플레이어·분대원 공용). 여러 번 불러도 같은 결과.
function UniformService.applyClothes(character: Model)
	local cfg = GameConfig.Uniform
	for _, c in ipairs(character:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		elseif c:IsA("Accessory") then
			local layered = c:FindFirstChildWhichIsA("WrapLayer", true) ~= nil
			if layered or not KEEP_ACCESSORY[c.AccessoryType] then
				c:Destroy()
			end
		end
	end
	local shirt = Instance.new("Shirt")
	shirt.Name = "CampShirt"
	shirt.ShirtTemplate = cfg.Shirt
	shirt.Parent = character
	local pants = Instance.new("Pants")
	pants.Name = "CampPants"
	pants.PantsTemplate = cfg.Pants
	pants.Parent = character
end

-- 등에 멘 나무 목총 (M026): 쏘지 않는 제식·행진용 장식. 개머리·몸통·앞손잡이·총열 모두 나무, 앞가슴에 멜빵.
-- 파트만 붙이므로 Tool·발사·소리·판정이 없다.
function UniformService.attachBackRifle(character: Model)
	if character:FindFirstChild("CampWoodRifle") then
		return
	end
	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if not torso then
		return
	end
	-- 오른 어깨 위로 총구, 왼 허리 쪽으로 개머리 (Y = 총 길이, X = 옆모습 높이, Z = 두께)
	local sling = torso.CFrame * CFrame.new(0, 0.05, torso.Size.Z / 2 + 0.14) * CFrame.Angles(0, 0, math.rad(-35))
	local function piece(name: string, size: Vector3, y: number, color: Color3)
		local p = decor(name, size, color, Enum.Material.Wood)
		p.CFrame = sling * CFrame.new(0, y, 0)
		p.Parent = character
		weld(torso, p)
	end
	piece("CampWoodRifle", Vector3.new(0.26, 1.15, 0.16), 0, Palette.Wood) -- 몸통
	piece("CampWoodRifleStock", Vector3.new(0.46, 0.9, 0.18), -1.0, Palette.Wood) -- 개머리
	piece("CampWoodRifleGrip", Vector3.new(0.34, 0.22, 0.14), -0.35, Palette.WoodDark) -- 손잡이 턱
	piece("CampWoodRifleFore", Vector3.new(0.2, 0.8, 0.15), 0.95, Palette.Wood) -- 앞손잡이
	piece("CampWoodRifleBarrel", Vector3.new(0.1, 0.75, 0.1), 1.7, Palette.WoodDark) -- 총열(나무)
	-- 멜빵: 앞가슴을 사선으로 가로지른다
	local strap = decor("CampWoodRifleSling", Vector3.new(0.14, 2.3, 0.04), Palette.OliveDark, Enum.Material.Fabric)
	strap.CFrame = torso.CFrame * CFrame.new(0, 0.05, -(torso.Size.Z / 2 + 0.03)) * CFrame.Angles(0, 0, math.rad(35))
	strap.Parent = character
	weld(torso, strap)
end

local function dress(character: Model, player: Player)
	if not character.Parent then
		return
	end
	UniformService.applyClothes(character)
	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	if torso and not character:FindFirstChild("CampNameTag") then
		local tag = decor("CampNameTag", Vector3.new(1.0, 0.32, 0.08), Palette.Red, Enum.Material.SmoothPlastic)
		tag:SetAttribute("SignText", player.DisplayName)
		tag:SetAttribute("SignLight", true)
		tag.CFrame = torso.CFrame * CFrame.new(-0.4, 0.4, -(torso.Size.Z / 2 + 0.05))
		tag.Parent = character
		weld(torso, tag)
	end
	if GameConfig.Uniform.BackRifle then
		UniformService.attachBackRifle(character)
	end
	if head and not character:FindFirstChild("CampCap") then
		local cap = decor("CampCap", Vector3.new(0.35, 1.4, 1.4), Palette.OliveDark, Enum.Material.Fabric)
		cap.Shape = Enum.PartType.Cylinder
		cap.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90))
		cap.Parent = character
		weld(head, cap)
		local brim = decor("CampCapBrim", Vector3.new(1.35, 0.1, 0.65), Palette.OliveDark, Enum.Material.Fabric)
		brim.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 - 0.08, -(head.Size.Z / 2 + 0.25))
		brim.Parent = character
		weld(head, brim)
		-- 캠프 마크: 노란 작은 원 (실제 부대 표식 아님)
		local badge = decor("CampCapBadge", Vector3.new(0.08, 0.36, 0.36), Palette.Yellow, Enum.Material.SmoothPlastic)
		badge.Shape = Enum.PartType.Cylinder
		badge.CFrame = head.CFrame
			* CFrame.new(0, head.Size.Y / 2 + 0.3, -(head.Size.Z / 2 + 0.02))
			* CFrame.Angles(0, math.rad(90), 0)
		badge.Parent = character
		weld(head, badge)
	end
end

function UniformService.start()
	local function onPlayer(player: Player)
		player.CharacterAppearanceLoaded:Connect(function(character)
			task.defer(dress, character, player)
		end)
		if player.Character and player:HasAppearanceLoaded() then
			task.defer(dress, player.Character, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
end

return UniformService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00001617</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6224">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{CC7CF902-76BE-4DF7-917E-30FCAD1BE993}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 기록판 (docs/design/15_RECORDS.md): 작전별(D1~D6) 최단 기록과 수료(GRAD) 최단 기록. 값은 1/100초, 낮을수록 위.
-- OrderedDataStore 를 쓰고, 못 쓰면(Studio API 꺼짐 등) 이 서버 메모리에만 남긴다("체험"). 순위·이름은 서버가 만든다.
-- 보여 주는 것: 상위 N 과 내 기록뿐. 꼴찌·하위 목록은 만들지 않는다.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserService = game:GetService("UserService")

local LeaderboardService = {}

LeaderboardService.Boards = { "D1", "D2", "D3", "D4", "D5", "D6", "GRAD" }
local VALID: { [string]: boolean } = {}
for _, b in ipairs(LeaderboardService.Boards) do
	VALID[b] = true
end

local PREFIX = if RunService:IsStudio() then "Camp_Board_Dev_" else "Camp_Board_v1_"
local CACHE_SEC = 30
local TOP_N = 10

export type Row = { rank: number, userId: number, name: string, cs: number }

local stores: { [string]: any } = {} -- board → OrderedDataStore | false
local memory: { [string]: { [number]: number } } = {} -- 체험: board → userId → cs
local cache: { [string]: { at: number, rows: { Row }, mode: string } } = {}
local names: { [number]: string } = {}
local warned = false

function LeaderboardService.isBoard(b: any): boolean
	return typeof(b) == "string" and VALID[b] == true
end

local function storeFor(board: string): any
	local s = stores[board]
	if s ~= nil then
		return s
	end
	local ok, ds = pcall(function()
		return DataStoreService:GetOrderedDataStore(PREFIX .. board)
	end)
	if ok and ds then
		stores[board] = ds
		return ds
	end
	stores[board] = false
	if not warned then
		warned = true
		warn("[Leaderboard] OrderedDataStore 를 못 씀 → 이 서버 메모리 기록판(체험)")
	end
	return false
end

-- 저장이 실제로 되는지: 첫 쓰기·읽기가 실패하면 체험으로 바꾼다
local function markOffline(board: string)
	stores[board] = false
	if not warned then
		warned = true
		warn("[Leaderboard] OrderedDataStore 실패 → 이 서버 메모리 기록판(체험)")
	end
end

function LeaderboardService.mode(board: string): string
	return if storeFor(board) then "ONLINE" else "LOCAL"
end

local function nameOf(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local pl = Players:GetPlayerByUserId(userId)
	if pl then
		names[userId] = pl.DisplayName
		return pl.DisplayName
	end
	local ok, infos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync({ userId })
	end)
	if ok and typeof(infos) == "table" and infos[1] and typeof(infos[1].DisplayName) == "string" then
		names[userId] = infos[1].DisplayName
		return infos[1].DisplayName
	end
	local ok2, uname = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok2 and typeof(uname) == "string" then
		names[userId] = uname
		return uname
	end
	return "훈련병"
end

-- 기록 올리기: 더 빠를 때만 바뀐다. 반환: 기록판에 새로 남았는지
function LeaderboardService.submit(board: string, userId: number, cs: number): boolean
	if not VALID[board] or cs <= 0 then
		return false
	end
	cs = math.floor(cs)
	local improved = false
	local ds = storeFor(board)
	if ds then
		local ok = pcall(function()
			ds:UpdateAsync(tostring(userId), function(old)
				if typeof(old) == "number" and old <= cs then
					return nil
				end
				improved = true
				return cs
			end)
		end)
		if not ok then
			markOffline(board)
			improved = false
		end
	end
	if not stores[board] then
		local m = memory[board] or {}
		memory[board] = m
		if not m[userId] or cs < m[userId] then
			m[userId] = cs
			improved = true
		end
	end
	cache[board] = nil
	return improved
end

-- 상위 N (캐시 30초). 반환: 줄들, 모드(ONLINE|LOCAL)
function LeaderboardService.top(board: string, fresh: boolean?): ({ Row }, string)
	if not VALID[board] then
		return {}, "LOCAL"
	end
	local c = cache[board]
	if c and not fresh and os.clock() - c.at < CACHE_SEC then
		return c.rows, c.mode
	end
	local rows: { Row } = {}
	local mode = "LOCAL"
	local ds = storeFor(board)
	if ds then
		local ok, page = pcall(function()
			return ds:GetSortedAsync(true, TOP_N):GetCurrentPage()
		end)
		if ok and typeof(page) == "table" then
			mode = "ONLINE"
			for i, e in ipairs(page) do
				local uid = tonumber(e.key) or 0
				table.insert(rows, { rank = i, userId = uid, name = nameOf(uid), cs = tonumber(e.value) or 0 })
			end
		else
			markOffline(board)
		end
	end
	if mode == "LOCAL" then
		local list = {}
		for uid, cs in pairs(memory[board] or {}) do
			table.insert(list, { userId = uid, cs = cs })
		end
		table.sort(list, function(a, b)
			return a.cs < b.cs
		end)
		for i = 1, math.min(TOP_N, #list) do
			local e = list[i]
			table.insert(rows, { rank = i, userId = e.userId, name = nameOf(e.userId), cs = e.cs })
		end
	end
	cache[board] = { at = os.clock(), rows = rows, mode = mode }
	return rows, mode
end

-- 상위 N 안의 내 순위 (밖이면 nil)
function LeaderboardService.rankOf(board: string, userId: number): number?
	local rows = LeaderboardService.top(board, true)
	for _, r in ipairs(rows) do
		if r.userId == userId then
			return r.rank
		end
	end
	return nil
end

return LeaderboardService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">531aee31db1b5e520ae6ff5900015882</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6225">
          <Properties>
            <string name="Name">AssetLibrary</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{D96D74F5-5093-4729-8651-C10D4776C2DF}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- 런타임 에셋 복제 (28 §7 "에셋 1차"): 서비스가 소품(손에 든 것·유보트 짐·밤 상자·장작)을 기본 Part 대신 메시로 그리고 싶을 때.
-- ServerStorage.CampAssets 의 키 Model 을 복제해 배율·자리를 맞춰 돌려준다. 라이브러리나 키가 없으면 nil → 부른 쪽이 기존 Part 로 그린다.
-- 라이브러리는 Studio place(Camp_Art.rbxl)에만 있다 — Rojo 로 관리하지 않는다. 키 목록: docs/art/ASSET_REGISTER.csv (ASSET_*).
-- 모델 규약: PrimaryPart = 밑면 가운데 "AssetBase"(피벗), 긴 축 X, 속성 UnitSize(배율 1 경계 상자). 복제본은 전부 Anchored·충돌/쿼리/터치 없음.
-- 들고 다니는 소품이면 부른 쪽이 Anchored=false 로 바꾸고 WeldConstraint 로 붙인다(Massless 는 이미 true).
local ServerStorage = game:GetService("ServerStorage")

local AssetLibrary = {}

local function library(): Instance?
	return ServerStorage:FindFirstChild("CampAssets")
end

function AssetLibrary.has(key: string): boolean
	local lib = library()
	local m = lib and lib:FindFirstChild(key)
	return m ~= nil and m:IsA("Model")
end

-- 배율 1 크기 (없으면 nil)
function AssetLibrary.unitSize(key: string): Vector3?
	local lib = library()
	local m = lib and lib:FindFirstChild(key)
	if not m or not m:IsA("Model") then
		return nil
	end
	local u = m:GetAttribute("UnitSize")
	if typeof(u) == "Vector3" then
		return u
	end
	local _, sz = m:GetBoundingBox()
	return sz
end

-- key 의 복제본을 cframe(밑면 가운데)에 scale 배로 놓는다. Parent 는 부른 쪽이 정한다. 없으면 nil.
function AssetLibrary.clone(key: string, cframe: CFrame, scale: number?): Model?
	local lib = library()
	local src = lib and lib:FindFirstChild(key)
	if not src or not src:IsA("Model") then
		return nil
	end
	local m = (src :: Model):Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		elseif d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
	local s = scale or 1
	if s > 0 and math.abs(s - 1) > 1e-4 then
		m:ScaleTo(s)
	end
	m:PivotTo(cframe)
	m:SetAttribute("AssetKey", key)
	return m
end

-- 원하는 높이(stud)에 맞춘 배율 (UnitSize.Y 기준). 키가 없으면 1
function AssetLibrary.scaleForHeight(key: string, height: number): number
	local u = AssetLibrary.unitSize(key)
	return if u and u.Y > 0 then height / u.Y else 1
end

-- 원하는 긴 변(stud)에 맞춘 배율 (UnitSize X·Z 중 큰 쪽)
function AssetLibrary.scaleForWidth(key: string, width: number): number
	local u = AssetLibrary.unitSize(key)
	return if u then width / math.max(u.X, u.Z, 0.01) else 1
end

-- ===== 고르지 않은 배율 (마감 패스 2026-10-21) =====
-- ScaleTo 는 고른 배율만 된다. 노(가늘고 긴)·유보트 선체(7.4×2.3×17.4)처럼 비율을 바꿔야 하면 MeshPart.Size 를 직접 준다.
-- src 의 모델 축 상자(UnitSize, 밑면 가운데 피벗)를 size 로 늘려 centerCF(상자 가운데, 모델 축 그대로)에 놓는다.
-- target 은 src 의 복제본(파트 이름이 같아야 한다). 이미 맞춘 복제본에 다시 불러도 같은 결과(멱등) — 늘 src 기준으로 잰다.
function AssetLibrary.fitParts(src: Model, target: Model, centerCF: CFrame, size: Vector3)
	local u = src:GetAttribute("UnitSize")
	local unit: Vector3 = if typeof(u) == "Vector3" then u else select(2, src:GetBoundingBox())
	local k =
		Vector3.new(size.X / math.max(unit.X, 1e-4), size.Y / math.max(unit.Y, 1e-4), size.Z / math.max(unit.Z, 1e-4))
	local boxCenter = src:GetPivot() * CFrame.new(0, unit.Y / 2, 0)
	local function comp(
		a: Vector3
	): number -- 이 파트 축이 상자 축으로 몇 배 늘어나나 (축 정렬 메시 기준)
		return math.abs(a.X) * k.X + math.abs(a.Y) * k.Y + math.abs(a.Z) * k.Z
	end
	for _, sp in ipairs(src:GetDescendants()) do
		if not sp:IsA("BasePart") or sp == src.PrimaryPart then
			continue
		end
		local tp = target:FindFirstChild(sp.Name, true)
		if not tp or not tp:IsA("BasePart") then
			continue
		end
		local rel = boxCenter:ToObjectSpace(sp.CFrame)
		local rot = rel.Rotation
		tp.Size = Vector3.new(
			sp.Size.X * comp(rot.RightVector),
			sp.Size.Y * comp(rot.UpVector),
			sp.Size.Z * comp(rot.LookVector)
		)
		tp.CFrame = centerCF * CFrame.new(rel.Position * k) * rot
	end
	target.WorldPivot = centerCF
end

-- key 의 복제본을 모델 축 상자 size 로 늘려 centerCF 에 놓는다 (밑면 파트는 지움). 없으면 nil
function AssetLibrary.cloneFit(key: string, centerCF: CFrame, size: Vector3): Model?
	local lib = library()
	local src = lib and lib:FindFirstChild(key)
	if not src or not src:IsA("Model") then
		return nil
	end
	local m = AssetLibrary.clone(key, (src :: Model):GetPivot())
	if not m then
		return nil
	end
	local base = m.PrimaryPart
	if base then
		m.PrimaryPart = nil
		base:Destroy()
	end
	AssetLibrary.fitParts(src :: Model, m, centerCF, size)
	return m
end

-- 복제본 모델에서 보이는 메시 파트들 (서비스가 유보트 선체처럼 자기 모델로 옮겨 쓸 때)
function AssetLibrary.parts(m: Model): { BasePart }
	local out: { BasePart } = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "AssetBase" then
			table.insert(out, d)
		end
	end
	return out
end

return AssetLibrary
]]></string>
            <int64 name="SourceAssetId">-1</int64>
