			at(92, 1.4, 38.8 + (i - 1) * 1.2),
			if i == 2 then Palette.Red else Palette.Cream,
			Enum.Material.Fabric,
			{ attrs = { Flag = true } }
		)
	end
	buildYard() -- 유보트 꾸미기 마당 (3단계, BD_*)
	cp("CP0", 0, Vector3.new(0, 4, 20), NZ, Vector3.new(26, 8, 26))
	cp("CP6", 6, Vector3.new(2, 4, -46), NZ, Vector3.new(12, 8, 20)) -- 무대 앞 길 위. 북쪽을 봐야 오른쪽(동)=무대 쪽에 분대원·내가 선다 (남쪽을 보면 관객 의자 위에 섬)
end

local function buildDay1()
	-- 북문 (19_UI_MAP_STYLE): 스폰·첫 들기 화면에서 보이는 랜드마크 — 나무 탑 둘(16) + 탑 위 빨간 깃발 + 빨간 판(안 "🚩 훈련장" / 밖 "🏕️ 기지")
	-- + 노란 현수막 "하나 둘! 하나 둘!". 북문 밖(z -70): 연병장 안(-40)에 있으면 퇴소식 카메라와 무대 사이를 가렸다 (2026-10-19 2차)
	-- 길 폭: 탑 안쪽 면 ±8 > 운반 길 반폭 4.5. 판·현수막·등은 높이 9 위 (길 검사 PATH_HIGH)
	for i, sx in ipairs({ -1, 1 }) do
		box(
			"D1_BannerPost" .. i,
			"Buildings",
			Vector3.new(2, 16, 2),
			at(sx * 9, 8, -70),
			Palette.WoodDark,
			Enum.Material.WoodPlanks
		)
		box(
			"Gate_Cap" .. i,
			"Buildings",
			Vector3.new(2.8, 0.6, 2.8),
			at(sx * 9, 16.3, -70),
			Palette.OliveDark,
			Enum.Material.Fabric,
			{ canCollide = false }
		)
		flag("Gate_Flag" .. i, Vector3.new(sx * 9, 16.6, -70), 5, Palette.Red)
		box(
			"Gate_Lamp" .. i,
			"LightingParts",
			Vector3.new(1, 1, 1),
			at(sx * 7.5, 13.2, -69),
			Palette.Yellow,
			Enum.Material.Neon,
			{
				shape = Enum.PartType.Ball,
				canCollide = false,
				light = { color = Palette.Yellow, range = 20, brightness = 1 },
			}
		)
	end
	box(
		"Gate_Beam",
		"Buildings",
		Vector3.new(20, 1, 1),
		at(0, 15.4, -70),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ canCollide = false }
	)
	deco(
		"Gate_Sign",
		Vector3.new(10, 2.6, 0.3),
		facing(Vector3.new(0, 13.5, -69.6), PZ),
		Palette.Red,
		Enum.Material.Fabric,
		{ attrs = { SignText = "🚩 훈련장", SignLight = true } }
	)
	deco(
		"Gate_SignBack",
		Vector3.new(10, 2.6, 0.3),
		facing(Vector3.new(0, 13.5, -70.4), NZ),
		Palette.Red,
		Enum.Material.Fabric,
		{ attrs = { SignText = "🏕️ 기지", SignLight = true } }
	)
	deco(
		"D1_Banner",
		Vector3.new(16, 2.2, 0.2),
		at(0, 10.7, -70),
		Palette.Yellow,
		Enum.Material.Fabric,
		{ attrs = { Flag = true, SignText = "하나 둘! 하나 둘!", SignBothSides = true } }
	)
	-- 북문 → CP1 걷는 길 (옛 1일차 운반 코스 자리 x 0, 가로등 줄). 마감 패스(2026-10-21)에 가로대·개울·디딤돌·통나무·다리·비탈·
	-- 체크포인트 깃발을 지웠다 — 1일차는 수로(R1_, CampRideCourse)로 간다. 이 선은 옛 선 6개와 같은 자리·폭이라 나무 배치가 그대로다
	corridor(1, Vector3.new(0, 2, -16), Vector3.new(0, 2, -262))
	-- 두 번째 망루 (교관이 옆에서 외침)
	for i, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		box(
			"D1_TowerLeg" .. i,
			"Buildings",
			Vector3.new(0.7, 7, 0.7),
			at(16 + c[1] * 2.6, 3.5, -130 + c[2] * 2.6),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end
	box("D1_TowerDeck", "Buildings", Vector3.new(7, 0.5, 7), at(16, 7.25, -130), Palette.Wood, Enum.Material.WoodPlanks)
	deco(
		"D1_TowerMega",
		Vector3.new(1.2, 1.2, 2),
		CFrame.new(12.5, 8.8, -130) * CFrame.Angles(0, math.rad(-90), 0),
		Palette.Red,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder }
	)
	-- 쉼터 CP1
	shelter("D1_Shelter", 0, -280, "1")
	cp("CP1", 1, Vector3.new(0, 4, -264), NZ)
	-- 1박 모닥불 허브 (1단계): 길(x=0 ±4.5)·CP1 트리거(±9) 서쪽. 4단계가 옛 코스를 수로로 바꿔도 쉼터는 그대로
	fireRing("D1_Fire", -16, -266, false, { day = 1, angles = { 45, 135, 225, 315 } })
	-- 1일차 줍기: 북문 안 길가 1 + 해안 도착 둘레 3 + 물통 1 + 모닥불 옆 2 (옛 코스 자리는 4단계가 수로로 바꾸므로 길 위엔 두지 않는다)
	pickup("CF_W_D1_0", 1, "WOOD", 11, -64, 20)
	pickup("CF_W_D1_1", 1, "WOOD", 8, -248, -35)
	pickup("CF_W_D1_2", 1, "WOOD", -10, -243, 50)
	pickup("CF_W_D1_3", 1, "WOOD", 9, -270, 10)
	pickup("CF_WT_D1", 1, "WATER", -3, -286, 0)
	pickup("CF_W_D1_F1", 1, "WOOD", -23, -261, 70)
	pickup("CF_W_D1_F2", 1, "WOOD", -22, -273, -20)
	for i, p in ipairs({ { -40, -66 }, { 22, -95 }, { -24, -140 }, { 26, -175 }, { -22, -230 }, { 24, -255 } }) do
		tree("D1_Tree" .. i, p[1], p[2], 1 + (i % 3) * 0.15)
	end
	for i, z in ipairs({ -70, -120, -170, -220, -260 }) do
		lamp("D1_Lamp" .. i, -9, z)
	end
end

local function buildDay2()
	local ox = 60
	-- 시작 발판 P1 (CP1 옆)
	pad("P1", 1, Vector3.new(ox, 0.5, -270), PZ)
	deco(
		"D2_Sign",
