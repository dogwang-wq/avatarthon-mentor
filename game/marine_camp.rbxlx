          <string name="Source"><![CDATA[--!strict
-- 수치의 단일 기준. 전부 아이 테스트 전 초안(CANDIDATE)이다. 바꾸면 docs/progress/DECISIONS.csv 에 이유를 남긴다.
-- 6단계(2026-10-21): 옛 운반(Carry·CoCarry·Race)·박자 낮 작전 수치를 지웠다 — git 역사에 남음. 조작은 걷기·점프·E 셋 (27 §1)
local GameConfig = {}

GameConfig.designVersion = "1.0"
GameConfig.ProjectId = "RobMarin.Camp"

-- 박자 판정 (03_FLOW §2): 기지 체력단련장 박자 기구에서만 쓴다
GameConfig.Rhythm = {
	GoodWindowSec = 0.12,
	OkWindowSec = 0.22,
	MaxInputsPerSec = 6,
	ClockSkewMaxSec = 0.5, -- 클라이언트가 보낸 서버 시각이 이보다 어긋나면 서버 시각으로 대체
	OarLongWindowDelta = -0.03, -- 긴 노를 실었으면 박자 창이 조금 좁다 (단련장 손맛, 옛 규칙 그대로)
	OarShortWindowDelta = 0.03,
}

-- 유보트 (02_MAP §9)
GameConfig.Boat = {
	Size = Vector3.new(7, 2.4, 17), -- 유보트(IBS) 폭 X 7 · 높이 2.4 · 길이 Z 17 (실물 1.9×4.7 m). 2026-10-19 사용자 플레이: X/Z 가 바뀌어 폭 17 짜리 막대가 됐던 것 수정
}

-- 분대원 기분 (밤 간식·나누기에서만 오르내림 — 점수 아님)
GameConfig.Morale = {
	Start = 0.6,
}

-- 짐 (BoatLoadout 와 짝)
GameConfig.Cargo = { MaxSlots = 3 }

GameConfig.Network = {
	SnapshotHz = 8,
	BeatBurst = 4,
	RequestPerSec = 2,
	RequestBurst = 4,
}

GameConfig.Save = {
	LeaseSec = 120,
	RenewSec = 30,
	AutosaveSec = 60,
	ProfileBytesMax = 60000,
	JournalLimit = 30,
	LettersLimit = 12,
}

GameConfig.Letter = {
	FreeTextMaxChars = 40,
	MaxChips = 3,
}

GameConfig.Obby = {
	SanHelpDistance = 10,
	-- 유격 발판 떨어짐 (20_DAYS_UNIFY): 같은 발판에서 2·3·4번 → 한 마디 → 다음 발판 빛남 → (SquadDoesIt 면) 산이 손 잡아 다음 발판으로
	FallHelpAfter = { 2, 3, 4 },
	-- 도움 사다리 마지막 칸 "분대가 대신 해 줌" 스위치. 2026-10-20 플레이테스트(사용자: "왜 전부 조작 안 해도 넘어가져?") 뒤 false —
	-- 장면·동료 말·한 줄·발판 빛남까지는 그대로 (21 §3-5). 6일차 사격 문의 분대원 사격은 이것과 별개 ("같이" 쏜다, 27 §3)
	SquadDoesIt = false,
}

-- 사격 손맛 (21 4단계, M060 · 6단계 단순화): 나무 목총 — 조준 모드·반동. 쏘기는 클릭/탭 하나, 장전은 저절로 (R·Y·장전 버튼 없음).
