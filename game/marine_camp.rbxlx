	hanging = { DURI = "잡아 줘!", SAN = "밧줄 잡았다.", MIR = "여기! 여기!" } :: { [string]: string },
	pullCall = { DURI = "잡았다!", SAN = "올라와.", MIR = "영차!" } :: { [string]: string },
