	},
	finish = { who = "KANG", text = "소대 전원 도착! …아무도 안 빠졌…나?", sec = 3 },
	finishNoFall = { who = "KANG", text = "소대 전원 도착! 아무도 안 빠졌다! 악!", sec = 3 },
	finishSea = { who = "KANG", text = "섬 도착! 전원 탑승 확인… 하나 둘 셋 넷!", sec = 3 },
	-- 프롬프트 (ActionText 동사 · ObjectText 대상)
	promptPull = "끌어올리기",
	promptBoard = "타기",
	objBoat = "유보트",
	-- 미르가 먼저 부른다 (안 될 때 산이 대신)
	mirCall = { LEFT = "왼쪽!", RIGHT = "오른쪽!", CENTER = "가운데로!", JUMP = "폭포다! 뛰어!" } :: { [string]: string },
	mirDodge = "비껴갔다!",
	sanBump = "쿵!",
	duriBump = "어어어!",
