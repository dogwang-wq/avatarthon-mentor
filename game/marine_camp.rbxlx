	FeedDistance = 9, -- 넣기 프롬프트 거리
	GiveDistance = 8, -- 나누기 프롬프트 거리
	SeatNpcDistance = 4.5, -- 의자에 앉았을 때 이 안의 분대원이 이야기한다
	Level2Wood = 2, -- 오늘 주운(넣은) 장작이 이만큼이면 보통 불
	Level3Wood = 4, -- 이만큼이면 큰 불
	MinNightSec = 90, -- 이 시간이 지나거나 동사(넣기·나누기·앉기) 하나를 하면 "내일로" 가 켜진다
