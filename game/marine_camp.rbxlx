	FallNotBeforeSec = 10, -- 출발 뒤 이만큼은 안 넘어진다
	FallMinGapSec = 20, -- 넘어짐 사이 최소 간격
	FallWeights = { DURI = 0.5, MIR = 0.35, SAN = 0.15 } :: { [string]: number }, -- 누가 넘어지나 (두리 > 미르 > 산)
	FallAlong = { 0.4, 0.6 }, -- 나 → 다음 깃발 사이 어디쯤 (비율)
	FallSide = 3, -- 그 직선에서 옆으로 이만큼
	FallMinFromMe = 6, -- 나와 너무 가까우면(시야 밖·발밑) 안 됨
	FallMaxFromMe = 28, -- 깃발이 멀어도 이 안에서 넘어진다 (보이는 거리)
	LieAngle = 80, -- 누운 각도 (90 이면 완전히 등을 댐)
	LieHeight = 0.75, -- 누운 몸통 중심 높이
	ReviveDistance = 8, -- 일으키기 프롬프트·E 거리
	ReviveHoldSec = 0.8, -- 길게 누르기
	AutoUpSec = 10, -- 안 일으키면 이때 스스로 일어난다
	FreezeSec = 5, -- 발각되면 이만큼 얼음 (아무도 안 풀면)
	FreezeHelpAtSec = 0.8, -- 이때 가까운 분대원이 달려온다
	FreezeFreedSec = 2.5, -- 분대원이 "땡!" 하는 때 (달려오는 1.5초 뒤)
	FreezeCooldownSec = 2.5, -- 풀린 뒤 이만큼은 다시 얼지 않는다
	HelperAppearStuds = 16, -- 분대원이 이보다 멀리 있으면 이 거리에서 나타나 달려온다 (깃발 앞은 보통 멀다)
	NpcRunSpeed = 9, -- 달려오는 속도 (stud/s)
	NpcRunMaxSec = 3, -- 아무리 멀어도 이 안에 (제자리로 돌아갈 때)
	ThawDistance = 8, -- 풀어 주기 프롬프트·E 거리
	ThawHoldSec = 0.5,
	NpcFreezeWeights = { MIR = 0.5, DURI = 0.35, SAN = 0.15 } :: { [string]: number }, -- 탐조등에 누가 걸리나 (미르 > 두리 > 산)
	NpcFreezeSec = 5, -- 언 분대원이 스스로 풀리는 때
	NpcFreezeNearStuds = 12, -- 내가 빛 가장자리에서 이 안에 있을 때만 분대원이 걸린다 (멀리서 혼자 얼면 안 보인다)
}

