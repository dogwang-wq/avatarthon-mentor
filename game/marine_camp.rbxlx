local function buildDay4()
	-- 선착장: 갯벌 덱에서 바다로 나가는 부두
	box(
		"D4_Pier",
		"Buildings",
		Vector3.new(6, 0.6, 30),
		at(0, 0.6, -728),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ onPath = true }
	)
	for i = 1, 4 do
		box(
			"D4_PierPost" .. i,
			"Buildings",
			Vector3.new(0.8, 5, 0.8),
			at(((i % 2 == 0) and 3.2 or -3.2), -1, -716 - math.floor((i - 1) / 2) * 24),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
	end
	deco(
		"D4_Sign",
		Vector3.new(5, 2, 0.3),
		at(6, 2.4, -716),
		Palette.Red,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "해상 IBS", SignSub = "3일차 · 노 젓기", SignLight = true } }
	)
	deco(
		"D4_LifeRing",
		Vector3.new(0.3, 2.2, 2.2),
		CFrame.new(-3.6, 2.4, -720) * CFrame.Angles(0, math.rad(90), 0),
		Palette.Fire,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder }
	)
	-- 부표 8 지그재그 + 세그먼트 (y = 수면 -1)
	local pts = {
		Vector3.new(0, -1, -752), -- -745 였을 때 출발하는 유보트 꼬리가 부두 끝 말뚝(3.2,-740)을 뚫었다 (2026-10-19 2차)
		Vector3.new(-25, -1, -775),
		Vector3.new(25, -1, -815),
		Vector3.new(-25, -1, -855),
		Vector3.new(25, -1, -895),
		Vector3.new(-25, -1, -935),
		Vector3.new(25, -1, -975),
		Vector3.new(-20, -1, -1005),
		Vector3.new(0, -1, -1025),
	}
	-- 부표는 꺾이는 점 바깥 7.5 stud: 유보트가 부표를 돌아 나간다 (전에는 꺾이는 점 위라 유보트가 부표를 뚫음, 2026-10-19 2차)
	for i = 2, #pts do
		local p = pts[i]
		local d1 = (pts[i] - pts[i - 1]).Unit
		local out = d1:Cross(Vector3.yAxis)
		if i < #pts then
			local o = d1 - (pts[i + 1] - pts[i]).Unit
			if o.Magnitude > 0.05 then
				out = o.Unit
			end
		end
		buoy("D4_Buoy" .. (i - 1), p.X + out.X * 7.5, p.Z + out.Z * 7.5, tostring(i - 1))
	end
	for i = 1, #pts - 1 do
		-- 옛 박자 바다(파도 구간)의 흰 거품 띠 D4_Foam 은 마감 패스에 뺐다: 급류·바다 탑승(R4_ 경로)과 자리가 달라 물 위 차선처럼 보였다
		corridor(4, pts[i], pts[i + 1], 14)
	end
	-- 구조 유보트 (장식) + 바위
	deco("D4_Rescue", Vector3.new(5, 1.6, 12), at(55, -0.6, -860), Palette.Fire, Enum.Material.SmoothPlastic)
	deco(
		"D4_RescueFlag",
		Vector3.new(2, 1.4, 0.12),
		at(55, 3.5, -860),
		Palette.Cream,
		Enum.Material.Fabric,
		{ attrs = { Flag = true, SignText = "구조", SignBothSides = true } }
	)
	deco("D4_RescuePole", Vector3.new(0.25, 4, 0.25), at(55, 1.5, -860), Palette.Ink, Enum.Material.Metal)
	for i, p in ipairs({ { -70, -800, 9 }, { 72, -920, 12 }, { -75, -980, 8 }, { 80, -780, 7 } }) do
		deco(
			"D4_Rock" .. i,
			Vector3.new(p[3], p[3] * 0.7, p[3] * 0.8),
			at(p[1], -1.5, p[2]),
			Palette.Stone,
			Enum.Material.Slate,
			{ shape = Enum.PartType.Ball, canCollide = true }
		)
	end
	-- 섬: 물(-1) 위로 드러나려면 지형 윗면이 y=1 (4 stud 복셀 양자화, Studio 2026-10-18 실측) → 섬 소품 전부 +1
	Y_OFFSET = 1
	-- 섬 선착장 + 작은 등대
	box(
		"D4_IslandDock",
		"Buildings",
		Vector3.new(14, 0.6, 10),
		at(0, 0.5, -1038),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ onPath = true }
	)
	-- 등대 = 4일차 섬의 랜드마크 (19 §9): 높이 10 → 20, 빨간 띠 둘. 출발(326 stud, 45° 옆)에서 섬 위로 선다
	box(
		"D4_LightBase",
		"Buildings",
		Vector3.new(4.5, 20, 4.5),
		at(-14, 10, -1050),
		Palette.Cream,
		Enum.Material.Concrete
	)
	deco("D4_LightStripe", Vector3.new(4.7, 2.4, 4.7), at(-14, 7, -1050), Palette.Red, Enum.Material.SmoothPlastic)
	deco("D4_LightStripe2", Vector3.new(4.7, 2.4, 4.7), at(-14, 14, -1050), Palette.Red, Enum.Material.SmoothPlastic)
	box(
		"D4_LightLamp",
		"LightingParts",
		Vector3.new(2.6, 2.6, 2.6),
		at(-14, 21.3, -1050),
		Palette.Yellow,
		Enum.Material.Neon,
		{
			shape = Enum.PartType.Ball,
			canCollide = false,
			light = { color = Palette.Yellow, range = 26, brightness = 1 }, -- 마감 패스: 60·2 는 노을 밤에 섬 전체를 노랗게 태웠다 (네온 공이 랜드마크)
		}
	)
	box(
		"D4_LightRoof",
		"Buildings",
		Vector3.new(4.6, 0.5, 4.6),
		at(-14, 22.9, -1050),
		Palette.Red,
		Enum.Material.SmoothPlastic,
		{ canCollide = false }
	)
	shelter("D4_Shelter", 10, -1055, "3")
	cp("CP4", 4, Vector3.new(0, 4, -1040), NZ, Vector3.new(18, 8, 14))
	-- 3박(안 번호 4) 모닥불 허브 (1단계): 섬(x −30~30 · z −1067~−1023) 남쪽, 등대(x≥−16)·벤치(x≥1)·깃발 기둥(0,−1061) 사이
	fireRing("D4_Fire", -7, -1060, false, { day = 4, angles = { 45, 135, 225, 315 } })
	-- 3일차 줍기: 섬 위 3 + 물통 1 + 모닥불 옆 2 (5일차 출발 길 z −1044~−1036 밖)
	pickup("CF_W_D4_1", 4, "WOOD", 24, -1044, 25)
	pickup("CF_W_D4_2", 4, "WOOD", -24, -1060, -30)
	pickup("CF_W_D4_3", 4, "WOOD", 12, -1030, 55)
	pickup("CF_WT_D4", 4, "WATER", -20, -1028, 0)
	pickup("CF_W_D4_F1", 4, "WOOD", -14, -1065, 10)
	pickup("CF_W_D4_F2", 4, "WOOD", 2, -1065, -50)
	for i, p in ipairs({ { 18, -1060, 1 }, { -22, -1038, 1.2 }, { 20, -1030, 0.9 } }) do
		tree("D4_Palm" .. i, p[1], p[2], p[3], Palette.Grass)
	end
	Y_OFFSET = 0
end

local function buildDay5()
	-- 섬에서 서쪽 다리 (물 위) → 숲길 북쪽으로 (갈림길) → 촛불 광장
	box(
		"D5_Bridge",
		"TerrainProps",
		Vector3.new(8, 0.6, 150),
		at(-75, 0.7, -1040),
		Palette.Wood,
		Enum.Material.WoodPlanks,
		{ onPath = true }
	)
	for i = 1, 7 do
		for j, sz in ipairs({ -1, 1 }) do
			box(
				string.format("D5_BridgePost%d_%d", i, j),
				"Buildings",
				Vector3.new(0.8, 5, 0.8),
				at(-5 - (i - 1) * 23, -1, -1040 + sz * 3.8),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = false, onPath = true }
			)
		end
	end
	deco(
		"D5_BridgeRail1",
		Vector3.new(150, 0.2, 0.2),
		at(-75, 2.3, -1044),
		Palette.Rope,
		Enum.Material.Fabric,
		{ attrs = { Rope = true }, onPath = true }
	)
	deco(
		"D5_BridgeRail2",
		Vector3.new(150, 0.2, 0.2),
		at(-75, 2.3, -1036),
		Palette.Rope,
		Enum.Material.Fabric,
		{ attrs = { Rope = true }, onPath = true }
	)
	deco(
		"D5_Sign",
		Vector3.new(5, 2, 0.3),
		at(-8, 2.4, -1046),
		Palette.Red,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "야간 행군", SignSub = "4일차 · 🔦 손전등 켜기", SignLight = true } } -- 20: 키 이름 대신 손전등 그림(PC F · 폰 🔦 · 패드 Y)
	)
	-- 4일차(안 번호 5) 야간 침투 자유 스테이지 (22 v2): 출발 발판·목표 깃발 둘(어느 길이든 하나)·탐조등 빛 영역 넷
	pad("D5_Start", 1, Vector3.new(-14, 1.0, -1040), NZ, false, 5)
	goalPoint("F_D5_LANTERN", 5, Vector3.new(-150, 0, -470), "등불 길")
	goalPoint("F_D5_SHORT", 5, Vector3.new(-194, 0, -470), "지름길")
	for i, z in ipairs({
		{ Vector3.new(-176, 0, -700), 0 },
		{ Vector3.new(-190, 0, -520), 2.5 },
		{ Vector3.new(-131, 0, -690), 1.2 },
		{ Vector3.new(-146, 0, -540), 3.7 },
	}) do
		zone(
			"Z_D5_SEARCH" .. i,
			5,
			"SEARCH",
			at(z[1].X, 6, z[1].Z),
			Vector3.new(34, 12, 34),
			{ OnSec = 3, OffSec = 3.5, Phase = z[2] }
		)
		deco(
			"Z_D5_LightRing" .. i,
			Vector3.new(0.15, 34, 34),
			at(z[1].X, 0.12, z[1].Z) * CFrame.Angles(0, 0, math.rad(90)),
			Palette.Cream,
			Enum.Material.Neon,
			{
				shape = Enum.PartType.Cylinder,
				transparency = 0.85,
				attrs = { LightRing = "Z_D5_SEARCH" .. i },
			}
		)
	end
	corridor(5, Vector3.new(-6, 2, -1040), Vector3.new(-150, 2, -1040), 8)
	corridor(5, Vector3.new(-150, 2, -1040), Vector3.new(-170, 2, -900))
	corridor(5, Vector3.new(-170, 2, -900), Vector3.new(-170, 2, -880))
	-- 갈림길 뒤 두 길 (20_DAYS_UNIFY · 5단계 자유 침투). 예전엔 길이 하나라 고른 것이 빛·속도만 바꿨다(16 §1-4).
	-- 🌑 지름길(SHORT): 지금 길 — 조금 가깝지만 어둡고 쓰러진 나무(가로대)·탐조등 2
	corridor(5, Vector3.new(-170, 2, -880), Vector3.new(-176, 2, -700))
	corridor(5, Vector3.new(-176, 2, -700), Vector3.new(-190, 2, -500))
	corridor(5, Vector3.new(-190, 2, -500), Vector3.new(-200, 2, -318))
	-- 🏮 등불 길(LANTERN): 동쪽(진행 방향 왼쪽)으로 도는 길 — 조금 멀지만 등불·반딧불로 밝고 멈추는 장애물이 없다
	local lantern = {
		Vector3.new(-170, 2, -880),
		Vector3.new(-132, 2, -760),
		Vector3.new(-130, 2, -600),
		Vector3.new(-158, 2, -470),
		Vector3.new(-200, 2, -318),
	}
	for i = 1, #lantern - 1 do
		corridor(5, lantern[i], lantern[i + 1])
		local a, b = lantern[i], lantern[i + 1]
		local mid = (a + b) / 2
		box(
			"D5_PathL" .. i,
			"Roads",
			Vector3.new(8, 0.2, (b - a).Magnitude + 4),
			facing(Vector3.new(mid.X, 0.1, mid.Z), (b - a).Unit),
			Palette.Khaki,
			Enum.Material.Sand,
			{ canCollide = false }
		)
	end
	-- 등불 길 위의 점 (d = 길을 따라 간 거리)
	local function onLantern(d: number): (Vector3, Vector3)
		local left = d
		for i = 1, #lantern - 1 do
			local a, b = lantern[i], lantern[i + 1]
			local len = (b - a).Magnitude
			if left <= len or i == #lantern - 1 then
				local dir = (b - a).Unit
				return a + dir * math.min(left, len), dir
			end
			left -= len
		end
		return lantern[#lantern], Vector3.new(0, 0, 1)
	end
	-- 갈림길 표지 둘: 진행 방향(+z)으로 볼 때 등불 길은 왼쪽(동), 지름길은 곧장. 길 가운데에 두지 않는다(2026-10-19 2차)
	deco("D5_ForkSign", Vector3.new(5, 2.2, 0.3), at(-160, 2.6, -890), Palette.Fire, Enum.Material.SmoothPlastic, {
		attrs = {
			SignText = "← 🏮 등불 길",
			SignSub = "조금 멀지만 밝아요",
			SignLight = true,
			SignBothSides = true,
		},
	})
	deco("D5_ForkSign2", Vector3.new(5, 2.2, 0.3), at(-181, 2.6, -890), Palette.Ink, Enum.Material.SmoothPlastic, {
		attrs = {
			SignText = "🌑 지름길 ↑",
			SignSub = "가깝지만 어둡고 탐조등",
			SignLight = true,
			SignBothSides = true,
		},
	})
	box(
		"D5_ForkPost2",
		"Buildings",
		Vector3.new(0.5, 3, 0.5),
		at(-181, 1.5, -890),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ canCollide = false }
	)
	box(
		"D5_ForkPost",
		"Buildings",
		Vector3.new(0.5, 3, 0.5),
		at(-160, 1.5, -890),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ canCollide = false }
	)
	-- 숲길 흙 + 나무 60
	box(
		"D5_Path",
		"Roads",
		Vector3.new(10, 0.2, 740),
		CFrame.new(-183, 0.1, -680) * CFrame.Angles(0, math.rad(2), 0),
		Palette.Khaki,
		Enum.Material.Sand,
		{ canCollide = false }
	)
	for i = 1, 60 do
		local t = (i - 1) / 59
		local z = -1020 + t * 700
		local side = if i % 2 == 0 then 1 else -1
		local px = -175 - t * 22 + side * (14 + (i % 5) * 4)
		-- 촛불 광장(-200,-300) 반경 34 안에는 나무를 두지 않는다 (광장이 가려짐, Studio 2차)
		if (Vector3.new(px, 0, z) - Vector3.new(-200, 0, -300)).Magnitude < 34 then
			continue
		end
		tree("D5_Tree" .. i, px, z, 0.9 + (i % 4) * 0.2, if i % 3 == 0 then Palette.Leaf else Palette.OliveDark)
	end
	-- 등불 7: 등불 길 양옆에 번갈아 (20: 예전엔 하나뿐인 길의 서쪽에 있어 표지 화살표와 반대였다)
	for i = 1, 7 do
		local p, dir = onLantern(40 + (i - 1) * 80)
		local side = dir:Cross(Vector3.yAxis) * (if i % 2 == 0 then 7.5 else -7.5)
		lamp("D5_Lantern" .. i, p.X + side.X, p.Z + side.Z, 5, Palette.Fire)
	end
	-- 반딧불 15: 등불 길 위 (미르가 보고 싶어 하는 것)
	for i = 1, 15 do
		local fp, fdir = onLantern(20 + (i - 1) * 37)
		local fside = fdir:Cross(Vector3.yAxis) * ((if i % 2 == 0 then 1 else -1) * (5 + (i % 3) * 2))
		deco(
			"D5_Firefly" .. i,
			Vector3.new(0.35, 0.35, 0.35),
			at(fp.X + fside.X, 3 + (i % 3), fp.Z + fside.Z),
			Palette.Firefly,
			Enum.Material.Neon,
			{ shape = Enum.PartType.Ball, attrs = { Firefly = true }, clear = "push" }
		)
	end
	-- 촛불 광장 CP5: 돌 고리·촛불 20·편지함·모닥불 터 (4박 모닥불 허브, 1단계: 통나무는 북쪽 반원 — 남쪽 −303.5 부터 뒤집힌 유보트)
	fireRing("D5_Fire", -201, -296, false, { day = 5, angles = { 90, 150, 215, 325 } }) -- 불은 촛불 고리 중심보다 4 북쪽: 통나무가 뒤집힌 유보트(z ≤ −303.5)·5일차 출발 길에 안 닿게
	-- 4일차(안 번호 5) 줍기: 다리 뒤 숲길 2 + 지름길 2 + 등불 길 1 + 갈림길 물통 1 + 모닥불 옆 2 (탐조등 빛 r17 밖)
	pickup("CF_W_D5_1", 5, "WOOD", -149, -997, 80)
	pickup("CF_W_D5_2", 5, "WOOD", -171, -943, 100)
	pickup("CF_WT_D5", 5, "WATER", -162, -890, 0)
	pickup("CF_W_D5_3", 5, "WOOD", -165, -790, -10)
	pickup("CF_W_D5_4", 5, "WOOD", -175, -600, 30)
	pickup("CF_W_D5_5", 5, "WOOD", -122, -640, -60)
	pickup("CF_W_D5_F1", 5, "WOOD", -204.8, -289.4, 5)
	pickup("CF_W_D5_F2", 5, "WOOD", -207.2, -303.6, 40)
	for i = 1, 20 do
		local a = i / 20 * math.pi * 2
		local r = 10 + (i % 2) * 2 -- 1단계: 통나무 의자 4 가 들어오며 9 → 10 (90° 통나무와 안 겹치게)
		deco(
			"D5_Candle" .. i,
			Vector3.new(0.5, 1.2, 0.5),
			at(-200 + math.cos(a) * r, 0.6, -300 + math.sin(a) * r),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ shape = Enum.PartType.Cylinder, attrs = { Candle = true }, clear = "drop" }
		)
	end
	-- 편지함: 광장 서쪽, 앞면이 모닥불 쪽(+x). 전에는 6일차 출발 길 위(-188)에 있었고 글자가 상자 안쪽을 봤다 (2026-10-19 2차)
	box(
		"D5_Mailbox",
		"Buildings",
		Vector3.new(2, 2.4, 1.4),
		facing(Vector3.new(-212, 2.4, -290), PX),
		Palette.Red,
		Enum.Material.SmoothPlastic
	)
	box(
		"D5_MailPost",
		"Buildings",
		Vector3.new(0.5, 1.2, 0.5),
		at(-212, 0.6, -290),
		Palette.WoodDark,
		Enum.Material.Wood,
		{ canCollide = false }
	)
	deco(
		"D5_MailSign",
		Vector3.new(2, 0.9, 0.1),
		facing(Vector3.new(-211.2, 2.4, -290), PX),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{ attrs = { SignText = "✉️ 편지함" } }
	)
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		deco(
			"D5_PlazaStone" .. i,
			Vector3.new(2.2, 0.7, 1.4),
			CFrame.new(-200 + math.cos(a) * 14, 0.35, -300 + math.sin(a) * 14) * CFrame.Angles(0, -a, 0),
			Palette.Stone,
			Enum.Material.Slate,
			{ canCollide = true, clear = "drop" }
		)
	end
	cp("CP5", 5, Vector3.new(-200, 4, -312), PZ, Vector3.new(18, 8, 14))
	goalFlag("D5_Flag", Vector3.new(-212, 0, -312), "4일차") -- 그날 도착 깃발 (19 §9). 안 번호는 5, 화면 번호는 4 (갯벌을 뺌)
end

-- 꺾인 길 위 거리 d 의 점과 그 자리 진행 방향 (y 무시)
local function alongPath(pts: { Vector3 }, d: number): (Vector3, Vector3)
	local left = d
	for i = 1, #pts - 1 do
		local a = Vector3.new(pts[i].X, 0, pts[i].Z)
		local b = Vector3.new(pts[i + 1].X, 0, pts[i + 1].Z)
		local len = (b - a).Magnitude
		if left <= len or i == #pts - 1 then
			local dir = (b - a).Unit
			return a + dir * math.min(left, len), dir
		end
		left -= len
	end
	return pts[1], Vector3.new(0, 0, -1)
end

-- 6일차 갈림길 (20 · 5단계 자유 침투): 표적 문 길은 곧장(대각선), 통나무 길은 동쪽으로 돌아 남쪽으로 내려와 문 뒤(D6_MERGE)에서 만난다
local D6_FORK = Vector3.new(-130, 2, -200)
local D6_MERGE = Vector3.new(-50, 2, -120)
local D6_LOGS = { D6_FORK, Vector3.new(-60, 2, -206), D6_MERGE }

local function buildDay6()
	-- 촛불 광장 → 숲 가장자리 → 갈림길 → (🎯 표적 문 길 | 🌲 통나무 길) → 다시 만나 북문으로 들어와 무대 앞(CP6)
	-- 출발은 광장 모닥불에서 18 stud 앞: 유보트 꼬리(8.5)가 모닥불 돌에 닿지 않게 (2026-10-19 2차, 전에는 꼬리가 불 위)
	local pts = {
		Vector3.new(-189, 2, -286),
		D6_FORK,
		D6_MERGE,
		Vector3.new(0, 2, -84),
		Vector3.new(0, 2, -46),
	}
	-- 구간 순서 = 고른 길로 거른 뒤의 순서 (SessionService: route 가 없거나 고른 길인 구간만)
	-- 갈림길 카드는 갈림길 18 stud 앞에서 멈춰 고른다 (5일차와 같은 FORK 구간)
	-- 5일차(안 번호 6) 탈출 자유 스테이지 (22 v2): 출발 발판 · 두 길목 문(표적을 다 맞혀야) · 문 뒤 목표 깃발 하나
	pad("D6_Start", 1, Vector3.new(-189, 2.5, -286), NZ, false, 6)
	goalPoint("F_D6_MERGE", 6, Vector3.new(-44, 0, -126), "문 너머")
	local forkFrom = D6_FORK - (D6_FORK - pts[1]).Unit * 18
	corridor(6, pts[1], forkFrom)
	corridor(6, forkFrom, D6_FORK)
	corridor(6, D6_FORK, D6_MERGE)
	for i = 1, #D6_LOGS - 1 do
		corridor(6, D6_LOGS[i], D6_LOGS[i + 1])
	end
	corridor(6, D6_MERGE, pts[4])
	corridor(6, pts[4], pts[5])
	-- 5일차(안 번호 6) 줍기 (1단계): 길 왼쪽 8 (가로등은 오른쪽 9, 나무는 왼쪽 14). 밤은 없지만 줍는 습관은 같다 (규칙 ②)
	pickup("CF_WT_D6", 6, "WATER", -180, -292, 0)
	pickup("CF_W_D6_1", 6, "WOOD", -162, -260, 55)
	pickup("CF_W_D6_2", 6, "WOOD", -84, -166, 45)
	pickup("CF_W_D6_3", 6, "WOOD", -94, -195, -5)
	pickup("CF_W_D6_4", 6, "WOOD", -20, -108, 35)
	local total = 0
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		total += (b - a).Magnitude
		-- 흙길은 실제 꺾인 길을 따라 깐다 (북문 안은 연병장·Road_Course 가 덮는다)
		if i <= 3 then
			local mid = (a + b) / 2
			box(
				if i == 1 then "D6_Path" else "D6_Path" .. i,
				"Roads",
				Vector3.new(10, 0.2, (b - a).Magnitude + 10),
				facing(Vector3.new(mid.X, 0.1 + (i % 2) * 0.02, mid.Z), Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit),
				Palette.Khaki,
				Enum.Material.Sand,
				{ canCollide = false }
			)
		end
	end
	-- 가로등은 길 오른쪽 9, 나무는 왼쪽 14 (북문 안 마지막 조각 제외)
	local outside = total - 38
	for i = 1, 6 do
		local p, dir = alongPath(pts, outside * i / 7)
		local right = dir:Cross(Vector3.yAxis)
		local lp = p + right * 9
		local tp = p - right * 14 - dir * 6
		lamp("D6_Lamp" .. i, lp.X, lp.Z)
		tree("D6_Tree" .. i, tp.X, tp.Z, 1 + (i % 2) * 0.2)
	end

	-- 통나무 길 (LOGS): 낮은 통나무 → 붙은 통나무 둘 → 큰 통나무 (첫날과 같은 순서, 17·18).
	-- 판정은 첫날 장면 읽기 그대로(두리 하나·둘 → 닿을 때 들어!, 쿵 2·3·4번째 한 줄·키 빛남·같이 넘김).
	-- 큰 통나무에서 산이 앞자리면 들어! 창이 넓다 — 5일차 밤 배치가 탈출 날 몸으로 보이는 곳 (가설 1)
	for i = 1, #D6_LOGS - 1 do
		local a, b = D6_LOGS[i], D6_LOGS[i + 1]
		local mid = (a + b) / 2
		box(
			"D6_PathL" .. i,
			"Roads",
			Vector3.new(10, 0.2, (b - a).Magnitude + 10),
			facing(Vector3.new(mid.X, 0.13 + (i % 2) * 0.02, mid.Z), Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit),
			Palette.Khaki,
			Enum.Material.Sand,
			{ canCollide = false }
		)
	end
	local function onLogs(part: number, d: number): (Vector3, Vector3)
		local a, b = D6_LOGS[part], D6_LOGS[part + 1]
		local dir = Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit
		return Vector3.new(a.X, 0, a.Z) + dir * d, dir
	end
	-- 낮은 통나무와 붙은 둘 사이는 32: 22 였을 때 정시 판에서 번쩍 든 2.2초 안에 붙은 둘까지 닿아 셋을 한 번에 넘었다
	-- (들어! 가 2번뿐, 2026-10-19 하네스). 떨어져 있어야 낮은 것 · 붙은 둘 · 큰 것 세 번의 들어! 가 된다
	for _, l in ipairs({
		{ id = "D6_Log1", part = 1, d = 18, r = 1.5, len = 16 },
		{ id = "D6_Log2", part = 1, d = 50, r = 2.2, len = 16 },
		{ id = "D6_Log3", part = 1, d = 60, r = 2.2, len = 16 },
		{ id = "D6_Log4", part = 2, d = 40, r = 2.6, len = 18 },
	}) do
		local p, dir = onLogs(l.part, l.d)
		logProp(l.id, "TerrainProps", Vector3.new(p.X, l.r, p.Z), l.len, l.r, yawAcross(dir))
	end
	do
		-- 큰 통나무 앞 "더 높이!" (첫날과 같은 말), 길 왼쪽 10
		local p, dir = onLogs(2, 36)
		local left = -dir:Cross(Vector3.yAxis)
		local sp = p + left * 10
		deco(
			"D6_LogSign",
			Vector3.new(3, 1.6, 0.2),
			facing(Vector3.new(sp.X, 2, sp.Z), -dir),
			Palette.Cream,
			Enum.Material.SmoothPlastic,
			{ attrs = { SignText = "더 높이!" } }
		)
		-- 등 둘 (첫 조각 오른쪽·둘째 조각 왼쪽 9 — 두 길 사이를 비워 둔다), 숲 가장자리 나무 둘 (첫 조각 북쪽 15)
		local p1, d1 = onLogs(1, 34)
		local l1 = p1 + d1:Cross(Vector3.yAxis) * 9
		lamp("D6_LampL1", l1.X, l1.Z)
		local p2, d2 = onLogs(2, 60)
		local l2 = p2 - d2:Cross(Vector3.yAxis) * 9
		lamp("D6_LampL2", l2.X, l2.Z)
		tree("D6_TreeL1", -100, -218, 1.1)
		tree("D6_TreeL2", -72, -220, 1)
	end
	do
		-- 갈림길 표지: 두 길 사이(가운데 선 20 앞)에 기둥 하나, 위 🎯 표적 문 ↑ · 아래 ← 🌲 통나무 길. 다가오는 유보트 쪽을 본다
		local gDir = Vector3.new(D6_MERGE.X - D6_FORK.X, 0, D6_MERGE.Z - D6_FORK.Z).Unit
		local lDir = Vector3.new(D6_LOGS[2].X - D6_FORK.X, 0, D6_LOGS[2].Z - D6_FORK.Z).Unit
		local w = Vector3.new(D6_FORK.X, 0, D6_FORK.Z) + (gDir + lDir).Unit * 20
		local toward = -Vector3.new(D6_FORK.X - pts[1].X, 0, D6_FORK.Z - pts[1].Z).Unit
		box(
			"D6_ForkPost",
			"Buildings",
			Vector3.new(0.5, 5.2, 0.5),
			at(w.X, 2.6, w.Z),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ canCollide = false }
		)
		deco(
			"D6_ForkSign",
			Vector3.new(5, 2.2, 0.3),
			facing(Vector3.new(w.X, 4.1, w.Z), toward),
			Palette.Red,
			Enum.Material.SmoothPlastic,
			{
				attrs = {
					SignText = "🎯 표적 문 ↑",
					SignSub = "가깝지만 표적을 다 맞혀요",
					SignLight = true,
					SignBothSides = true,
				},
			}
		)
		deco(
			"D6_ForkSign2",
			Vector3.new(5, 2.2, 0.3),
			facing(Vector3.new(w.X, 1.7, w.Z), toward),
			Palette.WoodDark,
			Enum.Material.SmoothPlastic,
			{
				attrs = {
					SignText = "← 🌲 통나무 길",
					SignSub = "조금 멀고 같이 들어요",
					SignLight = true,
					SignBothSides = true,
				},
			}
		)
	end
end

-- ===== 침투 훈련 (14_INFILTRATION_CAMP): 사격장 · 길 장애물 · 탐조등 · 탈출 문 =====
-- a → b 의 t 자리와 진행 방향 (옛 obst() 는 OBST 트리거도 만들었다 — 마감 패스 2026-10-21 에 트리거는 없애고 소품 자리 계산만 남김)
local function pointOn(a: Vector3, b: Vector3, t: number): (Vector3, Vector3)
	return a:Lerp(b, t), (b - a).Unit
end

-- 종이 원형 표적 (사람·동물 모양 없음): 기둥 + 흰 원판 + 빨간 가운데. 원판이 Kind=TARGET (눌러서 맞힘)
local function target(group: string, index: number, pos: Vector3, faceDir: Vector3)
	local id = string.format("TGT_%s_%d", group, index)
	box(
		id .. "_Post",
		"TerrainProps",
		Vector3.new(0.4, 2.4, 0.4),
		CFrame.new(pos.X, 1.2, pos.Z),
		Palette.WoodDark,
		Enum.Material.Wood
	)
	box(
		id,
		"Triggers",
		Vector3.new(0.25, 2.8, 2.8),
		CFrame.lookAt(Vector3.new(pos.X, 3.6, pos.Z), Vector3.new(pos.X, 3.6, pos.Z) + faceDir)
			* CFrame.Angles(0, math.rad(90), 0),
		Palette.Cream,
		Enum.Material.SmoothPlastic,
		{
			shape = Enum.PartType.Cylinder,
			canCollide = true,
			attrs = { Kind = K.TARGET or "TARGET", Group = group, TargetIndex = index },
		}
	)
end

local function buildInfiltration()
	-- 1) 기지 모의 사격장 (체력단련장 동쪽). 플레이어는 남쪽 발판에서 북쪽(-Z) 표적을 본다
	table.insert(segLines, { a = Vector3.new(128, 0, 30), b = Vector3.new(128, 0, -12), w = 26, lane = true }) -- 사격장 안에 나무가 서지 않게
	box("Range_Slab", "TerrainProps", Vector3.new(26, 0.3, 40), at(128, 0.15, 8), Palette.Sand, Enum.Material.Sand)
	box("Range_Berm", "TerrainProps", Vector3.new(30, 6, 3), at(128, 3, -14), Palette.Khaki, Enum.Material.Sand)
	deco("Range_Sign", Vector3.new(7, 2.2, 0.3), at(128, 3.6, 31), Palette.Red, Enum.Material.SmoothPlastic, {
		attrs = { SignText = "🎯 모의 사격", SignSub = "종이 표적 · 사격" },
	})
	deco(
		"Range_Bench",
		Vector3.new(8, 1.2, 1.4),
		at(128, 0.9, 22),
		Palette.Wood,
		Enum.Material.Wood,
		{ canCollide = true }
	)
	add({
		id = "TRAIN_RANGE",
		folder = "Triggers",
		size = Vector3.new(6, 6, 6),
		cframe = facing(Vector3.new(128, 3.3, 25), NZ),
		transparency = 1,
		canCollide = false,
		attrs = { Kind = K.TRAIN or "TRAIN", TrainId = "RANGE" },
	})
	deco(
		"TrainMark_RANGE",
		Vector3.new(0.2, 4.5, 4.5),
		CFrame.new(128, 0.63, 25) * CFrame.Angles(0, 0, math.rad(90)),
		Palette.Yellow,
		Enum.Material.SmoothPlastic,
		{ shape = Enum.PartType.Cylinder, transparency = 0.45 }
	)
	for i = 1, 5 do
		target("RANGE", i, Vector3.new(118 + (i - 1) * 5, 0, -6 - (i % 2) * 3), PZ)
	end

	-- 1-1) 기지 수료 기록판 게시판 (15_RECORDS): 유보트 주차 자리 왼쪽, 앞면(+X)에 클라이언트가 상위 5 를 그린다
	box(
		"Board_Grad",
		"Buildings",
		Vector3.new(10, 6.5, 0.4),
		facing(Vector3.new(-18, 4.6 + Y_OFFSET, 24), PX),
		Palette.WoodDark,
		Enum.Material.Wood,
		{
			attrs = { LeaderboardBoard = "GRAD" },
		}
	)
	for i, dz in ipairs({ -4.6, 4.6 }) do
		box(
			"Board_GradPost" .. i,
			"Buildings",
			Vector3.new(0.6, 8, 0.6),
			at(-18.4, 4, 24 + dz),
			Palette.WoodDark,
			Enum.Material.Wood
		)
	end

	-- 3) 5일차 야간: 쓰러진 나무(낮은 가로대) + 탐조등 두 곳
	do
		local a, b = Vector3.new(-170, 0, -880), Vector3.new(-176, 0, -700)
		local p, dir = pointOn(a, b, 0.5)
		local right = dir:Cross(Vector3.yAxis)
		deco(
			"D5_FallenTree",
			Vector3.new(16, 1.6, 1.6),
			CFrame.lookAt(Vector3.new(p.X, 7.6, p.Z), Vector3.new(p.X, 7.6, p.Z) + right)
				* CFrame.Angles(0, math.rad(90), 0),
			Palette.WoodDark,
			Enum.Material.Wood,
			{ shape = Enum.PartType.Cylinder, onPath = true }
		)
		for i, sx in ipairs({ -1, 1 }) do
			box(
				"D5_FallenProp" .. i,
				"TerrainProps",
				Vector3.new(1, 7, 1),
				CFrame.new(p.X + right.X * sx * 7.5, 3.5, p.Z + right.Z * sx * 7.5),
				Palette.WoodDark,
				Enum.Material.Wood,
				{ canCollide = false }
			)
		end
		for i, s in ipairs({
			{ Vector3.new(-150, 0, -1040), Vector3.new(-170, 0, -900), 0.5 },
			{ Vector3.new(-190, 0, -500), Vector3.new(-200, 0, -318), 0.45 },
		}) do
			local sp, sdir = pointOn(s[1], s[2], s[3])
			local sr = sdir:Cross(Vector3.yAxis)
			local tower = sp + sr * 16
			box(
				"D5_SearchTower" .. i,
				"Buildings",
				Vector3.new(3, 12, 3),
				CFrame.new(tower.X, 6, tower.Z),
				Palette.Stone,
				Enum.Material.Metal,
				{ canCollide = true }
			)
			deco(
				"D5_SearchLamp" .. i,
				Vector3.new(2, 2, 2),
				CFrame.new(tower.X, 12.8, tower.Z),
				Palette.Cream,
				Enum.Material.Neon,
				{
					attrs = { SearchLamp = "D5_SEARCH" .. i },
					light = { color = Color3.fromRGB(255, 244, 200), range = 18, brightness = 2 },
				}
			)
		end
	end

	-- 4) 5일차(안 번호 6) 탈출 길목 문 둘 (22 v2 자유 스테이지): 표적을 다 맞혀야 열린다. 길마다 하나 —
	--    🎯 표적 문 길(갈림길→합류 대각선)과 🌲 통나무 길(동쪽으로 돌아 남쪽). 문 양옆은 밧줄 울타리로 막아 돌아가지 못한다
	local function escapeGate(id: string, group: string, a: Vector3, b: Vector3, t: number, nTargets: number)
		local dir = (b - a).Unit
		local p = a:Lerp(b, t)
		local right = dir:Cross(Vector3.yAxis)
		for i, sx in ipairs({ -1, 1 }) do
			box(
				id .. "_Post" .. i,
				"Buildings",
				Vector3.new(1.2, 9, 1.2),
				CFrame.new(p.X + right.X * sx * 6.5, 4.5, p.Z + right.Z * sx * 6.5),
				Palette.Stone,
				Enum.Material.Metal,
				{ canCollide = false }
			)
		end
		deco(
			id .. "_Bar",
			Vector3.new(13, 0.8, 0.8),
			CFrame.lookAt(Vector3.new(p.X, 6.5, p.Z), Vector3.new(p.X, 6.5, p.Z) + right)
				* CFrame.Angles(0, math.rad(90), 0),
			Palette.Red,
			Enum.Material.SmoothPlastic,
			{ attrs = { GateBar = id }, onPath = true }
		)
		for i = 1, nTargets do
			local tp = p + dir * 10 + right * (7 + (i - 1) * 3.5)
			target(group, i, Vector3.new(tp.X, 0, tp.Z), -dir)
		end
		-- 보이지 않는 벽(문 열리면 서버가 CanCollide 를 끈다) + 양옆 울타리 15
		zone(id, 6, "GATE", facing(Vector3.new(p.X, 6, p.Z), dir), Vector3.new(14, 12, 2), { GateGroup = group })
		for i, sx in ipairs({ -1, 1 }) do
			local fc = p + right * (sx * (7 + 15))
			add({
				id = id .. "_Fence" .. i,
				folder = "Triggers",
				size = Vector3.new(30, 14, 1),
				cframe = facing(Vector3.new(fc.X, 7, fc.Z), dir),
				transparency = 1,
				canCollide = true,
			})
			for j = 0, 3 do
				local pp = p + right * (sx * (7.5 + j * 9))
				deco(
					string.format("%s_FencePost%d_%d", id, i, j),
					Vector3.new(0.35, 2.4, 0.35),
					at(pp.X, 1.2, pp.Z),
					Palette.WoodDark,
					Enum.Material.Wood
				)
			end
			local rp = p + right * (sx * (7.5 + 13.5))
			deco(
				id .. "_FenceRope" .. i,
				Vector3.new(27.5, 0.15, 0.15),
				facing(Vector3.new(rp.X, 2.1, rp.Z), dir) * CFrame.Angles(0, math.rad(90), 0),
				Palette.Rope,
				Enum.Material.Fabric,
				{ attrs = { Rope = true } }
			)
		end
	end
	escapeGate("D6_GATE", "GATE", Vector3.new(D6_FORK.X, 0, D6_FORK.Z), Vector3.new(D6_MERGE.X, 0, D6_MERGE.Z), 0.62, 5)
	escapeGate(
		"D6_GATE_B",
		"GATEB",
		Vector3.new(D6_LOGS[2].X, 0, D6_LOGS[2].Z),
		Vector3.new(D6_MERGE.X, 0, D6_MERGE.Z),
		0.3,
		5
	)
end

-- ===== 운반 길 검사 (2026-10-19 2차: 무대·가로등·갈림길 표지·촛불·부표가 길 위) =====
-- 유보트 폭 7(±3.5) + 사람·흔들림 1 → 가운데 선에서 4.5 안, 그 길 바닥 위 0.4~9 높이에 몸이 걸치면 "길 위".
-- 하루의 첫 조각은 뒤로, 마지막 조각은 앞으로 7.5 늘린다 (출발·도착 때 유보트 꼬리·코)
local PATH_HALF, PATH_LOW, PATH_HIGH, PATH_END = 4.5, 0.4, 9, 7.5
local pathReport: { string } = {}
local pathFixed: { string } = {}

local function cross2(o: Vector2, a: Vector2, b: Vector2): number
	return (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X)
end

-- 볼록 껍질 (반시계)
local function hull2(pts: { Vector2 }): { Vector2 }
	table.sort(pts, function(p: Vector2, q: Vector2): boolean
		return p.X < q.X or (p.X == q.X and p.Y < q.Y)
	end)
	local lower: { Vector2 } = {}
	local upper: { Vector2 } = {}
	for _, p in ipairs(pts) do
		while #lower >= 2 and cross2(lower[#lower - 1], lower[#lower], p) <= 0 do
			table.remove(lower)
		end
		table.insert(lower, p)
	end
	for i = #pts, 1, -1 do
		local p = pts[i]
		while #upper >= 2 and cross2(upper[#upper - 1], upper[#upper], p) <= 0 do
			table.remove(upper)
		end
		table.insert(upper, p)
	end
	table.remove(lower)
	table.remove(upper)
	for _, p in ipairs(upper) do
		table.insert(lower, p)
	end
	return lower
end

local function pointSegDist(p: Vector2, a: Vector2, b: Vector2): number
	local ab = b - a
	local l2 = ab:Dot(ab)
	local u = if l2 > 0 then math.clamp((p - a):Dot(ab) / l2, 0, 1) else 0
	return (p - (a + ab * u)).Magnitude
end

-- 선분 a-b 와 볼록 다각형 사이 거리 (겹치면 0)
local function polySegDist(poly: { Vector2 }, a: Vector2, b: Vector2): number
	local n = #poly
	if n < 3 then
		local best = math.huge
		for _, p in ipairs(poly) do
			best = math.min(best, pointSegDist(p, a, b))
		end
		return best
	end
	local inside = true
	for i = 1, n do
		if cross2(poly[i], poly[i % n + 1], a) < 0 then
			inside = false
			break
		end
	end
	if inside then
		return 0
	end
	local best = math.huge
	for i = 1, n do
		local p, q = poly[i], poly[i % n + 1]
		local d1, d2 = cross2(a, b, p), cross2(a, b, q)
		local d3, d4 = cross2(p, q, a), cross2(p, q, b)
		if (d1 > 0) ~= (d2 > 0) and (d3 > 0) ~= (d4 > 0) then
			return 0
		end
		best = math.min(best, pointSegDist(p, a, b), pointSegDist(a, p, q), pointSegDist(b, p, q))
	end
	return best
end

-- 부품의 바닥 그림자(회전 반영 볼록 다각형)와 높이 범위
local function footprint(s: Spec): ({ Vector2 }, number, number)
	local h = s.size / 2
	local pts: { Vector2 } = {}
	local lo, hi = math.huge, -math.huge
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local w = s.cframe:PointToWorldSpace(Vector3.new(sx * h.X, sy * h.Y, sz * h.Z))
				table.insert(pts, Vector2.new(w.X, w.Z))
				lo = math.min(lo, w.Y)
				hi = math.max(hi, w.Y)
			end
		end
	end
	return hull2(pts), lo, hi
end

type PathLine = { a: Vector2, b: Vector2, id: string, ground: number }
local function pathLines(): { PathLine }
	local byDay: { [number]: { SegLine } } = {}
	for _, s in ipairs(segLines) do
		local d = s.day
		if d and not s.lane then
			byDay[d] = byDay[d] or {}
			table.insert(byDay[d], s)
		end
	end
	local out: { PathLine } = {}
	for _, list in pairs(byDay) do
		for i, s in ipairs(list) do
			local a = Vector2.new(s.a.X, s.a.Z)
			local b = Vector2.new(s.b.X, s.b.Z)
			local dir = if (b - a).Magnitude > 0.01 then (b - a).Unit else Vector2.new(0, -1)
			if i == 1 then
				a -= dir * PATH_END
			end
			if i == #list then
				b += dir * PATH_END
			end
			table.insert(out, { a = a, b = b, id = s.id or "?", ground = s.ground or 0 })
		end
	end
	return out
end

local SKIP_FOLDER = { Triggers = true, Spawns = true, Roads = true }

-- 가장 가까운 길 조각과 거리 (높이가 겹칠 때만)
local function nearestHit(s: Spec, lines: { PathLine }): (PathLine?, number)
	local poly, lo, hi = footprint(s)
	local best: PathLine? = nil
	local bestD = math.huge
	for _, l in ipairs(lines) do
		if hi > l.ground + PATH_LOW and lo < l.ground + PATH_HIGH then
			local d = polySegDist(poly, l.a, l.b)
			if d < bestD then
				best, bestD = l, d
			end
		end
	end
	return best, bestD
end

local function clearCorridors()
	table.clear(pathReport)
	table.clear(pathFixed)
	local lines = pathLines()
	-- 1) 고리 장식(clear="drop")은 길 위 것만 뺀다
	local kept: { Spec } = {}
	for _, s in ipairs(specs) do
		if s.clear == "drop" and not SKIP_FOLDER[s.folder] then
			local l, d = nearestHit(s, lines)
			if l and d < PATH_HALF then
				ids[s.id] = nil
				table.insert(pathFixed, string.format("drop %s (%s %.1f)", s.id, l.id, d))
				continue
			end
		end
		table.insert(kept, s)
	end
	table.clear(specs)
	for _, s in ipairs(kept) do
		table.insert(specs, s)
	end
	-- 2) clear="push" 묶음(가로등 기둥+전구)은 묶음째 길 밖으로 민다
	local groups: { [string]: { Spec } } = {}
	for _, s in ipairs(specs) do
		if s.clear == "push" then
			local g = s.group or s.id
			groups[g] = groups[g] or {}
			table.insert(groups[g], s)
		end
	end
	for g, members in pairs(groups) do
		for _ = 1, 3 do
			local hitLine: PathLine? = nil
			for _, s in ipairs(members) do
				local l, d = nearestHit(s, lines)
				if l and d < PATH_HALF then
					hitLine = l
					break
				end
			end
			if not hitLine then
				break
			end
			local l = hitLine :: PathLine
			local c = Vector2.zero
			for _, s in ipairs(members) do
				c += Vector2.new(s.cframe.Position.X, s.cframe.Position.Z)
			end
			c /= #members
			local r = 0
			for _, s in ipairs(members) do
				for _, p in ipairs((footprint(s))) do
					r = math.max(r, (p - c).Magnitude)
				end
			end
			local ab = l.b - l.a
			local l2 = ab:Dot(ab)
			local u = if l2 > 0 then math.clamp((c - l.a):Dot(ab) / l2, 0, 1) else 0
			local near = l.a + ab * u
			local off = c - near
			local dir = if off.Magnitude > 0.1
				then off.Unit
				else (if l2 > 0 then Vector2.new(-ab.Unit.Y, ab.Unit.X) else Vector2.new(1, 0))
			local move = near + dir * (PATH_HALF + r + 0.5) - c
			for _, s in ipairs(members) do
				s.cframe = CFrame.new(move.X, 0, move.Y) * s.cframe
			end
			table.insert(pathFixed, string.format("push %s %.1f (%s)", g, move.Magnitude, l.id))
		end
	end
	-- 3) 나머지는 보고만 한다 (길 위에 있어야 하는 장애물은 onPath)
	for _, s in ipairs(specs) do
		if not s.onPath and not SKIP_FOLDER[s.folder] then
			local l, d = nearestHit(s, lines)
			if l and d < PATH_HALF then
				table.insert(pathReport, string.format("%s ↔ %s %.1f", s.id, l.id, d))
			end
		end
	end
end

local function buildSpecs()
	table.clear(specs)
	table.clear(ids)
	table.clear(corridorCounter)
	table.clear(pendingTrees)
	table.clear(segLines)
	buildBase()
	buildDay1()
	buildDay2()
	buildDay4()
	buildDay5()
	buildDay6()
	buildInfiltration()
	for _, s in ipairs(CampRideCourse.specs()) do
		add(s :: any)
	end
	for _, s in ipairs(CampArt.specs()) do
		add(s :: any)
	end
	-- 나무는 운반 길(유보트 ±3.5 + 사람 + 잎 반지름) 밖으로 민 뒤에 만든다
	local droppedTrees: { string } = {}
	for _, t in ipairs(pendingTrees) do
		local p = Vector3.new(t.x, 0, t.z)
		for _ = 1, 3 do
			local moved = false
			for _, s in ipairs(segLines) do
				local ab = s.b - s.a
				local len2 = ab:Dot(ab)
				local u = if len2 > 0 then math.clamp((p - s.a):Dot(ab) / len2, 0, 1) else 0
				local near = s.a + ab * u
				local off = p - near
				local need = math.max(s.w / 2, 6) + 3.5 * t.scale + 1
				if off.Magnitude < need then
					local dir = if off.Magnitude > 0.1
						then off.Unit
						else (if len2 > 0 then ab.Unit:Cross(Vector3.yAxis) else Vector3.xAxis)
					p = near + dir * need
					moved = true
				end
			end
			if not moved then
				break
			end
		end
		-- 세 번 밀어도 다른 길에 걸리면(두 길 사이 좁은 곳, 5일차 갈림길 뒤) 그 나무는 만들지 않는다 (20_DAYS_UNIFY)
		local stillOn = false
		for _, s in ipairs(segLines) do
			local ab = s.b - s.a
			local len2 = ab:Dot(ab)
			local u = if len2 > 0 then math.clamp((p - s.a):Dot(ab) / len2, 0, 1) else 0
			if (p - (s.a + ab * u)).Magnitude < math.max(s.w / 2, 6) + 3.5 * t.scale then
				stillOn = true
				break
			end
		end
		if stillOn then
			table.insert(droppedTrees, string.format("drop tree %s (두 길 사이)", t.id))
			continue
		end
		emitTree(t.id, p.X, p.Z, t.scale, t.leaf)
	end
	clearCorridors()
	CampArt.restyle(specs :: any)
	for _, line in ipairs(droppedTrees) do
		table.insert(pathFixed, line)
	end
end

-- ===== Terrain (FillBlock 만 쓴다. Clear 없음) =====
-- Studio 2026-10-18 실측: 땅 표면은 FillBlock 윗면보다 2 stud 높게 잡힌다(-5..0 채움 → 표면 y=2). 그래서 땅은 윗면 -2 로 채워 표면을 y=0 에 맞춘다. 물은 그대로(-1).
local function fillTerrain()
	local T = workspace.Terrain
	-- 바닥 풀 (전체)
	T:FillBlock(CFrame.new(0, -4.5, -480), Vector3.new(760, 5, 1500), Enum.Material.Grass)
	-- 연병장 주변 모래
	T:FillBlock(CFrame.new(0, -4.3, 0), Vector3.new(230, 4.6, 230), Enum.Material.Sand)
	-- 바다: 파내고 바닥 모래 + 물 (수면 y = -1)
	T:FillBlock(CFrame.new(0, -3, -890), Vector3.new(280, 8, 360), Enum.Material.Air)
	T:FillBlock(CFrame.new(0, -7.5, -890), Vector3.new(280, 3, 360), Enum.Material.Sand)
	T:FillBlock(CFrame.new(0, -3.5, -890), Vector3.new(280, 5, 360), Enum.Material.Water)
	-- 섬 (CP4)
	T:FillBlock(CFrame.new(0, -3.7, -1045), Vector3.new(60, 5.4, 44), Enum.Material.Sand) -- 윗면 -1 → 표면 y=1
	-- 숲길 흙
	T:FillBlock(CFrame.new(-183, -4.1, -680), Vector3.new(90, 4.2, 760), Enum.Material.Ground)
	CampRideCourse.terrain()
	CampArt.terrain()
end

-- ===== 빛·공기 (19_UI_MAP_STYLE §4): 맑은 오후, 따뜻한 모래빛 공기 =====
-- 그림자로 높낮이·실루엣을 읽게 하고(GlobalShadows), 먼 곳은 옅게(Atmosphere) 해서 북문·망루가 앞에 선다.
-- 빛 번짐은 네온(밤 전구·장애물 표시)에만 조금. 폰: 그림자 지도 1개(ShadowMap) + 효과 3개(공기·색 보정·번짐).
-- 밤(CourseFx.setNight)은 이 값을 저장해 두었다가 어둡게 바꾸고 아침에 되돌린다.
local LOOK = {
	lighting = {
		ClockTime = 14.6,
		Brightness = 2.2,
		Ambient = Color3.fromRGB(86, 82, 76),
		OutdoorAmbient = Color3.fromRGB(128, 122, 112),
		EnvironmentDiffuseScale = 0.45,
		EnvironmentSpecularScale = 0.2,
		GlobalShadows = true,
		ShadowSoftness = 0.3,
		ExposureCompensation = 0,
		FogEnd = 100000,
	} :: { [string]: any },
	atmosphere = {
		Density = 0.3,
		Offset = 0.1,
		Color = Color3.fromRGB(212, 200, 176),
		Decay = Color3.fromRGB(116, 124, 138),
		Glare = 0,
		Haze = 1,
	} :: { [string]: any },
	grade = {
		Brightness = 0.01,
		Contrast = 0.08,
		Saturation = 0.06,
		TintColor = Color3.fromRGB(255, 250, 242),
	} :: { [string]: any },
	bloom = { Intensity = 0.3, Size = 18, Threshold = 1.7 } :: { [string]: any },
}

local function ensureEffect(L: Instance, className: string, name: string): Instance
	local e = L:FindFirstChild(name)
	if e and e.ClassName == className then
		return e
	end
	-- 같은 종류가 이름만 다르게 하나 있으면 그것을 쓴다 (Studio 기본 Bloom 등)
	local any = L:FindFirstChildOfClass(className :: any)
	if any then
		any.Name = name
		return any
	end
	local n = Instance.new(className :: any)
	n.Name = name
	n.Parent = L
	return n
end

local function applyLook(): string
	local L = game:GetService("Lighting")
	local want = table.clone(LOOK.lighting)
	for k, v in pairs((CampArt :: any).LIGHT or {}) do -- 때깔 패스가 apply 끝에 덮어쓴 값이 기준
		want[k] = v
	end
	for k, v in pairs(want) do
		(L :: any)[k] = v
	end
	local tech = pcall(function()
		(L :: any).Technology = Enum.Technology.ShadowMap
	end)
	for _, pair in ipairs({
		{ "Atmosphere", "CampAtmosphere", LOOK.atmosphere },
		{ "ColorCorrectionEffect", "CampGrade", LOOK.grade },
		{ "BloomEffect", "Bloom", LOOK.bloom },
	}) do
		local e = ensureEffect(L, pair[1], pair[2])
		for k, v in pairs(pair[3]) do
			(e :: any)[k] = v
		end
		e:SetAttribute("ProjectId", PROJECT)
	end
	local art = CampArt.lighting()
	return "LOOK 적용 (Technology "
		.. (if tech then "ShadowMap" else "그대로 — 권한 없음")
		.. ")"
		.. (if art ~= "" then " + " .. art else "")
end

local function lookStatus(): string
	local L = game:GetService("Lighting")
	local diffs = {}
	local want = table.clone(LOOK.lighting)
	for k, v in pairs((CampArt :: any).LIGHT or {}) do -- 때깔 패스가 apply 끝에 덮어쓴 값이 기준
		want[k] = v
	end
	for k, v in pairs(want) do
		local cur = (L :: any)[k]
		if typeof(v) == "number" then
			if math.abs(cur - v) > 0.01 then
				table.insert(diffs, k)
			end
		elseif cur ~= v then
			table.insert(diffs, k)
		end
	end
	for _, n in ipairs({ "CampAtmosphere", "CampGrade", "Bloom" }) do
		if not L:FindFirstChild(n) then
			table.insert(diffs, "없음:" .. n)
		end
	end
	return if #diffs == 0 then "LOOK ok" else "LOOK 다름: " .. table.concat(diffs, ", ")
end

-- ===== 생성기 =====
local FOLDER_PATHS = {
	Buildings = SceneBindings.Paths.Buildings,
	TerrainProps = SceneBindings.Paths.TerrainProps,
	Decorations = SceneBindings.Paths.Decorations,
	Roads = SceneBindings.Paths.Roads,
	Triggers = SceneBindings.Paths.Triggers,
	Spawns = SceneBindings.Paths.Spawns,
	LightingParts = SceneBindings.Paths.LightingParts,
}

local function assertEditMode()
	if RunService:IsRunning() then
		error("CampSceneBootstrap: Studio 편집 모드에서만 실행합니다 (플레이/운영 서버 거부)")
	end
end

local function ensureFolder(path: { string }, create: boolean): Instance?
	local cur: Instance = workspace
	for _, name in ipairs(path) do
		local nxt = cur:FindFirstChild(name)
		if not nxt then
			if not create then
				return nil
			end
			nxt = Instance.new("Folder")
			nxt.Name = name
			nxt.Parent = cur
		end
		cur = nxt
	end
	return cur
end

local function findOwned(folder: Instance, specId: string): Instance?
	for _, child in ipairs(folder:GetChildren()) do
		if
			child:GetAttribute("ProjectId") == PROJECT
			and (child:GetAttribute("SpecId") == specId or child.Name == specId)
		then
			return child
		end
	end
	return nil
end

local function applySpec(inst: BasePart, s: Spec)
	inst.Name = s.id
	inst.Size = s.size
	inst.CFrame = s.cframe
	inst.Anchored = true
	inst.Color = s.color or Palette.Stone
	inst.Material = s.material or Enum.Material.SmoothPlastic
	inst.Transparency = s.transparency or 0
	inst.CanCollide = if s.canCollide == nil then true else s.canCollide
	inst.CanTouch = true
	inst.CanQuery = inst.CanCollide
	inst.TopSurface = Enum.SurfaceType.Smooth
	inst.BottomSurface = Enum.SurfaceType.Smooth
	if inst:IsA("Part") and s.shape then
		inst.Shape = s.shape
	end
	if inst.Transparency >= 1 or not inst.CanCollide then
		inst.CastShadow = inst.Transparency < 1 and inst.Size.Magnitude > 3
	end
	if s.light then
		local l = inst:FindFirstChildOfClass("PointLight") or Instance.new("PointLight")
		l.Color = s.light.color
		l.Range = s.light.range
		l.Brightness = s.light.brightness
		l.Parent = inst
	end
	inst:SetAttribute("ProjectId", PROJECT)
	inst:SetAttribute("SceneSchemaVersion", SCHEMA)
	inst:SetAttribute("SpecId", s.id)
	inst:SetAttribute("StableId", s.id)
	for k, v in pairs(s.attrs or {}) do
		inst:SetAttribute(k, v)
	end
end

type Plan = { add: { string }, update: { string }, keep: { string }, conflict: { string } }

local function plan(createFolders: boolean): (Plan, { [string]: Instance })
	buildSpecs()
	local p: Plan = { add = {}, update = {}, keep = {}, conflict = {} }
	local folders: { [string]: Instance } = {}
	for key, path in pairs(FOLDER_PATHS) do
		local f = ensureFolder(path, createFolders)
		if f then
			folders[key] = f
		end
	end
	for _, s in ipairs(specs) do
		local folder = folders[s.folder]
		if not folder then
			table.insert(p.add, s.id)
			continue
		end
		local owned = findOwned(folder, s.id)
		if owned then
			local same = owned:IsA("BasePart")
				and (owned :: BasePart).Size == s.size
				and ((owned :: BasePart).CFrame.Position - s.cframe.Position).Magnitude < 0.01
				and ((owned :: BasePart).CFrame.LookVector - s.cframe.LookVector).Magnitude < 0.001 -- 돌리기만 한 것도 UPDATE 로
				and ((owned :: BasePart).CFrame.UpVector - s.cframe.UpVector).Magnitude < 0.001
				and owned.ClassName == (s.class or "Part")
			table.insert(if same then p.keep else p.update, s.id)
		else
			local other = folder:FindFirstChild(s.id)
			if other and other:GetAttribute("ProjectId") ~= PROJECT then
				table.insert(p.conflict, s.id .. " (소유 속성 없는 같은 이름 개체)")
			else
				table.insert(p.add, s.id)
			end
		end
	end
	return p, folders
end

local function planToString(p: Plan): string
	return string.format(
		"add=%d update=%d keep=%d conflict=%d\nADD: %s\nUPDATE: %s\nCONFLICT: %s\nPATH 고침 %d · 길 위 %d: %s",
		#p.add,
		#p.update,
		#p.keep,
		#p.conflict,
		if #p.add > 40 then string.format("(%d개)", #p.add) else table.concat(p.add, ", "),
		table.concat(p.update, ", "),
		table.concat(p.conflict, "; "),
		#pathFixed,
		#pathReport,
		table.concat(pathReport, ", ")
	)
end

function Bootstrap.dryRun(): string
	assertEditMode()
	local p = plan(false)
	return "[DRY_RUN]\n" .. planToString(p)
end

function Bootstrap.apply(): string
	assertEditMode()
	local p, folders = plan(true)
	if #p.conflict > 0 then
		return "[APPLY 중단] 충돌 개체를 먼저 확인하세요.\n" .. planToString(p)
	end
	local ChangeHistoryService = game:GetService("ChangeHistoryService")
	local recording = ChangeHistoryService:TryBeginRecording("Camp scene apply")
	local count = 0
	for _, s in ipairs(specs) do
		local folder = folders[s.folder]
		local inst = findOwned(folder, s.id)
		local wantClass = s.class or "Part"
		if inst and inst.ClassName ~= wantClass then
			inst:Destroy()
			inst = nil
		end
		if not inst then
			inst = Instance.new(wantClass)
			inst.Parent = folder
		end
		applySpec(inst :: BasePart, s)
		count += 1
		if count % 30 == 0 then
			task.wait()
		end
	end
	local stale = {}
	local live: { [string]: boolean } = {}
	for _, s in ipairs(specs) do
		live[s.id] = true
	end
	for _, folder in pairs(folders) do
		for _, child in ipairs(folder:GetChildren()) do
			local sid = child:GetAttribute("SpecId")
			if child:GetAttribute("ProjectId") == PROJECT and typeof(sid) == "string" and not live[sid] then
				table.insert(stale, child:GetFullName())
			end
		end
	end
	fillTerrain()
	local look = applyLook() .. "\n" .. CampAssets.dress() -- 에셋 1차 (Terrain 을 채운 뒤: 땅 높이에 붙인다)
	SceneBindings.ensureRuntimeFolder()
	if recording then
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end
	return string.format(
		"[APPLY] %d 개체 갱신 + Terrain 채움 + %s (Ctrl+Z 로 되돌릴 수 있음)\n%s\nSTALE(삭제하지 않음): %s",
		count,
		look,
		planToString(p),
		table.concat(stale, ", ")
	)
end

-- 빛·공기만 다시 맞춘다 (맵은 그대로)
function Bootstrap.look(): string
	assertEditMode()
	return applyLook()
end

function Bootstrap.check(): string
	local r = SceneBindings.resolve()
	local lines = { "[CHECK] ok=" .. tostring(r.ok) }
	for _, m in ipairs(r.missing) do
		table.insert(lines, "  MISSING " .. m)
	end
	for _, id in ipairs({ "CP0", "CP1", "CP2", "CP4", "CP5", "CP6" }) do -- CP3 갯벌은 뺐다 (2026-10-20)
		local c = r.cps[id]
		if c then
			table.insert(
				lines,
				string.format("  %s at (%.0f, %.0f, %.0f)", id, c.part.Position.X, c.part.Position.Y, c.part.Position.Z)
			)
		end
	end
	local flagN, zoneN = {}, {}
	for _, day in ipairs({ 2, 5, 6 }) do
		table.insert(flagN, string.format("D%d %d", day, #((r.flagsByDay or {})[day] or {})))
		table.insert(zoneN, string.format("D%d %d", day, #((r.zonesByDay or {})[day] or {})))
	end
	table.insert(
		lines,
		string.format(
			"  pads=%d falls=%d grad=%d spawn=%s · flags %s · zones %s",
			#(r.padsByDay[2] or {}),
			#r.falls,
			#r.gradSpots,
			tostring(r.spawn ~= nil),
			table.concat(flagN, " "),
			table.concat(zoneN, " ")
		)
	)
	-- 모닥불 허브 (1단계): 밤마다 FIRE 1 + Seat 4, 날마다 줍기(장작·물통)
	local campLines = {}
	for _, day in ipairs({ 1, 2, 4, 5 }) do
		local f = (r.firesByDay or {})[day] -- Edit 모드 require 캐시(옛 SceneBindings) 대비
		local seats = if f then #((r.seatsByFire or {})[f.id] or {}) else 0
		table.insert(campLines, string.format("D%d %s/%d", day, if f then "fire" else "NOFIRE", seats))
	end
	local pickByDay: { [number]: { number } } = {}
	for _, pk in ipairs(r.pickups or {}) do
		pickByDay[pk.day] = pickByDay[pk.day] or { 0, 0 }
		pickByDay[pk.day][if pk.pickType == "WATER" then 2 else 1] += 1
	end
	for _, day in ipairs({ 1, 2, 4, 5, 6 }) do
		local c = pickByDay[day] or { 0, 0 }
		table.insert(campLines, string.format("D%d wood %d water %d", day, c[1], c[2]))
	end
	table.insert(lines, "  camp: " .. table.concat(campLines, " · "))
	-- 유보트 꾸미기 (3단계): 더미 9 + 출발 1, 자리 발판 4, 거치대 1 (Edit 모드 캐시로 옛 SceneBindings 면 0 — 서버 resolve 로 확인)
	local pileTypes = {}
	for _, pl in ipairs(r.piles or {}) do
		table.insert(pileTypes, pl.partType)
	end
	local padN = 0
	for _ in pairs(r.seatPads or {}) do
		padN += 1
	end
	table.insert(
		lines,
		string.format(
			"  build: piles %d (%s) · seatPads %d · rack %s",
			#pileTypes,
			table.concat(pileTypes, ","),
			padN,
			tostring(r.buildRack ~= nil)
		)
	)
	table.insert(lines, "  " .. CampAssets.coverage()) -- 에셋 1차
	table.insert(lines, "  " .. lookStatus())
	return table.concat(lines, "\n")
end

-- 생성기 소유(ProjectId = RobMarin.Camp)이고 SpecId 가 있는데 지금 스펙에 없는 파트만 지운다 (apply 의 STALE 목록).
-- 소유 속성이 없는 개체·Dressing 복제본(CampAssets 가 따로 관리)·Runtime 은 건드리지 않는다. Ctrl+Z 로 되돌릴 수 있다
function Bootstrap.prune(): string
	assertEditMode()
	buildSpecs()
	local live: { [string]: boolean } = {}
	for _, s in ipairs(specs) do
		live[s.id] = true
	end
	local ChangeHistoryService = game:GetService("ChangeHistoryService")
	local recording = ChangeHistoryService:TryBeginRecording("Camp scene prune")
	local removed: { string } = {}
	for _, path in pairs(FOLDER_PATHS) do
		local folder = ensureFolder(path, false)
		if not folder then
			continue
		end
		for _, child in ipairs(folder:GetChildren()) do
			local sid = child:GetAttribute("SpecId")
			if child:GetAttribute("ProjectId") == PROJECT and typeof(sid) == "string" and not live[sid] then
				table.insert(removed, sid)
				child:Destroy()
			end
		end
	end
	if recording then
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end
	table.sort(removed)
	return string.format("[PRUNE] %d 지움: %s", #removed, table.concat(removed, ", "))
end

function Bootstrap.specCount(): number
	buildSpecs()
	return #specs
end

-- 운반 길 위 소품 목록 (생성기 기준, Studio 상태와 무관)
function Bootstrap.pathCheck(): string
	buildSpecs()
	return string.format(
		"[PATH] 고침 %d · 길 위 %d\n%s\n%s",
		#pathFixed,
		#pathReport,
		table.concat(pathFixed, "\n"),
		table.concat(pathReport, "\n")
	)
end

return Bootstrap
