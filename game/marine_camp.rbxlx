      <Item class="ModuleScript" referent="6199">
        <Properties>
          <string name="Name">BeatPatterns</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{23FBC30E-102B-4AD2-B18C-35D13A9FD7F5}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[--!strict
-- 박자 패턴 — 기지 체력단련장 박자 기구 전용 (07_PHASE2 §2 → 10_TAP_ONLY). 낮 작전에는 박자가 없다 (27 §1 조작 셋, 6단계).
-- 누르는 형태는 "탭" 하나뿐. 변주는 템포·쉼(빈칸)·금색 "악!" 음표로만 만든다.
-- 키: SPACE(빨간 점) | SHOUT(금색 "악!" 점 — Space 탭) | A | D(파란 점 — 트랙 발) | REST(빈칸: 누르면 실수)
local BeatPatterns = {}

export type Key = "SPACE" | "SHOUT" | "A" | "D" | "REST"
export type Pattern = {
	id: string,
	keys: { Key },
	tempo: number, -- 기본 bpm 배율
	hintKo: string,
	callKo: { [number]: string }?, -- 그 박자에 교관이 외치는 말 (패턴 인덱스 → 글)
}

BeatPatterns.Patterns = {
	FLAT = { id = "FLAT", keys = { "SPACE" }, tempo = 1.0, hintKo = "빨간 점이 가운데 올 때 Space" }, -- 기구 밖 기본값
	PULLUP = { id = "PULLUP", keys = { "SPACE", "REST" }, tempo = 0.7, hintKo = "당겨! … 쉬고" },
	TRACK = { id = "TRACK", keys = { "A", "D" }, tempo = 1.5, hintKo = "A D A D 달려!" },
	ROPE = { id = "ROPE", keys = { "SPACE", "SPACE", "REST" }, tempo = 1.0, hintKo = "영차 영차 … 쉬고" },
	TIRE = {
		id = "TIRE",
		keys = { "SPACE", "SPACE", "REST", "SHOUT" },
		tempo = 0.8,
		hintKo = "둘 밀고 쉬고 금색에 뒤집기!",
	},
} :: { [string]: Pattern }

function BeatPatterns.get(id: string): Pattern?
	return BeatPatterns.Patterns[id]
end

-- 박자 n(0 기준) 의 기대 키
function BeatPatterns.expected(p: Pattern, beatN: number): Key
	local len = #p.keys
	return p.keys[(beatN % len) + 1]
end

return BeatPatterns
]]></string>
          <int64 name="SourceAssetId">-1</int64>
