          </Item>
          <Item class="ModuleScript" referent="6146">
            <Properties>
              <string name="Name">StoryController</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{71C1ADBC-2739-41E1-9F38-1E02E94D91D3}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- 자막(기본 켜짐)·조작 카드(첫 입소)·흔적 살펴보기. 탭으로 다음 줄, 길게(0.6초) 건너뛰기. 진행 판정 권한 없음.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProtocolTypes = require(Shared:WaitForChild("ProtocolTypes"))
local CampScript = require(Shared:WaitForChild("CampScript"))
local SquadCatalog = require(Shared:WaitForChild("SquadCatalog"))
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(script.Parent.Net)
local UiKit = require(script.Parent.UiKit)
local SquadPresence = require(script.Parent.SquadPresence)
local InputController = require(script.Parent.InputController)
local KoreanText = require(Shared:WaitForChild("KoreanText"))

local StoryController = {}
local C2S = ProtocolTypes.ClientToServer
local player = Players.LocalPlayer

local gui = UiKit.screen("CampStory", 30)
-- 자막은 박자 칸(높이 128) 위로
local caption = UiKit.paper(gui, "Caption", UDim2.fromOffset(470, 0), UDim2.new(0.5, 0, 1, -158), Vector2.new(0.5, 1))
caption.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(caption, 12)
UiKit.list(caption, nil, 4)
local speaker = UiKit.label(caption, "", 14, true, Palette.Red)
local line = UiKit.label(caption, "", 18)
local skipHint = UiKit.label(caption, CampScript.UI.tapNext, 12, false, Palette.WoodDark)
skipHint.TextXAlignment = Enum.TextXAlignment.Right
caption.Visible = false

-- 탭 영역은 자막 카드 밖(별도 화면)에서 카드를 따라간다 (안에 두면 레이아웃이 자람)
local tapGui = Instance.new("ScreenGui")
tapGui.Name = "CampCaptionTap"
tapGui.ResetOnSpawn = false
tapGui.DisplayOrder = 31
tapGui.Parent = player:WaitForChild("PlayerGui")
local tapArea = Instance.new("TextButton")
tapArea.BackgroundTransparency = 1
tapArea.Text = ""
tapArea.Visible = false
tapArea.Parent = tapGui

local captionsOn = true
local captionToken = 0
local queue: { { who: string, text: string, sec: number } } = {}
local busyUntil = 0

local function nameOf(who: string): string
	if who == "KANG" then
		return SquadCatalog.Instructor.emoji .. " " .. SquadCatalog.Instructor.nameKo
	elseif who == "SYSTEM" or who == "" then
		return "안내"
	elseif who == "TRACE" then
		return "👀 살펴보기"
	end
	local m = SquadCatalog.get(who)
	return if m then m.emoji .. " " .. m.nameKo else who
end

local function colorOf(who: string): Color3
	if who == "KANG" then
		return Palette.Red
	elseif who == "SYSTEM" then
		return Palette.Olive
	end
	return (Palette.Member :: any)[who] or Palette.Ink
end

local function showNow(who: string, text: string, seconds: number)
	if who == "DURI" or who == "SAN" or who == "MIR" then
		SquadPresence.say(who, text, seconds)
	end
	if not captionsOn then
		return
	end
	speaker.Text = nameOf(who)
	speaker.TextColor3 = colorOf(who)
	line.Text = KoreanText.keysFor(text, InputController.CurrentInputType)
	caption.Visible = true
	captionToken += 1
	local token = captionToken
	task.delay(seconds, function()
		if captionToken == token then
			caption.Visible = false
		end
	end)
end

local function pump()
	local now = os.clock()
	if now < busyUntil or #queue == 0 then
		return
	end
	while #queue > 20 do
		table.remove(queue, 1)
	end
	local item = table.remove(queue, 1) :: { who: string, text: string, sec: number }
	busyUntil = now + item.sec + 0.25
	showNow(item.who, item.text, item.sec)
	skipHint.Text = if #queue > 0 then CampScript.UI.tapSkip else CampScript.UI.tapNext
end

local pressAt: number? = nil
tapArea.MouseButton1Down:Connect(function()
	pressAt = os.clock()
end)
tapArea.MouseButton1Up:Connect(function()
	local held = pressAt ~= nil and os.clock() - (pressAt :: number) >= 0.6
	pressAt = nil
	if held then
		table.clear(queue)
	end
	busyUntil = 0
	captionToken += 1
	caption.Visible = false
	pump()
end)

local function enqueue(who: string, text: string, seconds: number)
	table.insert(queue, { who = who, text = text, sec = seconds })
	pump()
end

-- ===== 튜토리얼 카드 (압정 쪽지, ●○) =====
-- 왼쪽 열: Roblox 위 막대 아래에서 시작 (UiKit.topbar — 폰에서 Roblox 메뉴 버튼과 겹쳤다)
local tut = UiKit.paper(
	gui,
	"Tutorial",
	UDim2.fromOffset(340, 0),
	UDim2.fromOffset(16, UiKit.topbar().below),
	Vector2.new(0, 0)
)
UiKit.LayoutChanged:Connect(function()
	tut.Position = UDim2.fromOffset(16, UiKit.topbar().below)
end)
tut.AutomaticSize = Enum.AutomaticSize.Y
UiKit.pad(tut, 14)
UiKit.list(tut, nil, 6)
tut.Visible = false
local tutTitle = UiKit.label(tut, "", 20, true)
local tutBody = UiKit.label(tut, "", 16)
local tutDots = UiKit.label(tut, "●○", 16, true, Palette.Red)
local tutCards: { any } = {}
local tutIdx = 1
local tutFrom: Vector3? = nil -- 첫 1분: 카드가 뜬(또는 스폰) 자리 — 여기서 8 넘게 걸으면 카드가 접힌다
local function myPos(): Vector3?
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	return if hrp and hrp:IsA("BasePart") then hrp.Position else nil
end
local function renderTut()
	local c = tutCards[tutIdx]
	if not c then
		tut.Visible = false
		return
	end
	tutTitle.Text = c.title
	-- 기기마다 다른 글 (bodyTouch·bodyPad 가 있으면 그것, 없으면 키 이름 바꾸기)
	local it = InputController.CurrentInputType
	local body = if it == "TOUCH" and c.bodyTouch
		then c.bodyTouch
		elseif it == "GAMEPAD" and c.bodyPad then c.bodyPad
		else KoreanText.keysFor(c.body, it)
	tutBody.Text = body
	local s = ""
	for i = 1, #tutCards do
		s ..= if i == tutIdx then "●" else "○"
	end
	tutDots.Text = if #tutCards > 1 then s .. "   👉 탭" else "👉 눌러서 닫기"
	tut.Visible = true
end
local tutBtn = Instance.new("TextButton")
tutBtn.BackgroundTransparency = 1
tutBtn.Text = ""
tutBtn.Size = UDim2.fromScale(1, 1)
-- 스케일 크기 버튼이 UIListLayout 항목으로 끼면 AutomaticSize 카드가 화면 높이까지 자란다 (Studio 2026-10-18) → Folder 로 분리
local tutOverlay = Instance.new("Folder")
tutOverlay.Name = "TapOverlay"
tutOverlay.Parent = tut
tutBtn.Parent = tutOverlay
tutBtn.Activated:Connect(function()
	tutIdx += 1
	renderTut()
	if tutIdx > #tutCards then
		Net.request(C2S.FlowRequest, { op = ProtocolTypes.FlowOp.SKIP_TUTORIAL })
	end
end)

function StoryController.setCaptions(on: boolean)
	captionsOn = on
	if not on then
		caption.Visible = false
	end
end

function StoryController.start()
	-- 새 날이 시작되면 전날 자막 줄은 버린다 (7차: 4일차에 1일차 구호가 늦게 뜸)
	Net.FxCue:Connect(function(c)
		if c.kind == "DAY_START" or c.kind == "NIGHT" or c.kind == "GRADUATE" then
			table.clear(queue)
			busyUntil = 0
			captionToken += 1
			caption.Visible = false
		end
	end)
	Net.StoryCue:Connect(function(c)
		if c.kind == "LINE" then
			enqueue(tostring(c.who), tostring(c.text), tonumber(c.sec) or 2.5)
		elseif c.kind == "LINES" then
			for _, l in ipairs(c.lines or {}) do
				enqueue(tostring(l.who), tostring(l.text), tonumber(l.sec) or 2.5)
			end
		elseif c.kind == "TRACE" then
			enqueue("TRACE", tostring(c.text), 5)
		elseif c.kind == "TUTORIAL" then
			-- 첫 1분 (28 §7): 이미 걷고 있으면(스폰에서 10 넘게) 카드를 안 띄운다 — 조작을 벌써 안다
			local here = myPos()
			if tutFrom and here and (here - tutFrom :: Vector3).Magnitude > 10 then
				return
			end
			tutCards = c.cards or {}
			tutIdx = 1
			tutFrom = here
			renderTut()
		end
	end)
	InputController.InputTypeChanged:Connect(function()
		if tut.Visible then
			renderTut()
		end
	end)
	Net.SnapshotChanged:Connect(function(snap)
		captionsOn = snap.settings.captions ~= false
		if tut.Visible and (snap.tutorialDone or snap.state ~= ProtocolTypes.SessionState.CAMP) then
			tut.Visible = false -- 훈련장에 나가면 기지 카드는 닫는다 (Studio 2026-10-20: 6일차까지 남아 있었다)
		end
	end)
	-- 첫 1분: 조작 카드는 한 번 걸어 보면(8 stud) 할 일을 다 했다 → 스스로 접힌다 (눌러서 닫기도 그대로)
	player.CharacterAdded:Connect(function()
		tutFrom = nil
	end)
	RunService.Heartbeat:Connect(function()
		-- 줄 차례: 앞 줄 시간이 끝나면 다음 줄 (예전엔 새 줄이 오거나 탭해야만 넘어가서, 꾸미기 시작 교관 줄이
		-- 12초 늦게 떴다 — 첫 1분 Studio 자막 기록 2026-10-21). pump 는 busyUntil 전엔 아무것도 안 한다
		if #queue > 0 then
			pump()
		end
		local here = myPos()
		if not tutFrom and here and Net.Snapshot and Net.Snapshot.state == ProtocolTypes.SessionState.CAMP then
			tutFrom = here -- 스폰 자리 (카드가 오기 전에 걸었는지 재는 기준)
		end
		if tut.Visible and tutFrom and here and (here - tutFrom :: Vector3).Magnitude > 8 then
			tut.Visible = false
		end
	end)
	RunService.RenderStepped:Connect(function()
		tapArea.Visible = caption.Visible
		if caption.Visible then
			tapArea.Position = UDim2.fromOffset(caption.AbsolutePosition.X, caption.AbsolutePosition.Y)
			tapArea.Size = UDim2.fromOffset(caption.AbsoluteSize.X, caption.AbsoluteSize.Y)
		end
	end)
end

return StoryController
]]></string>
              <int64 name="SourceAssetId">-1</int64>
              <BinaryString name="Tags"></BinaryString>
              <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d00000405</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6147">
            <Properties>
              <string name="Name">UiKit</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{EE218CFC-16BC-44E4-B210-F4EED5F3F7E7}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!strict
-- UI 도우미. 룩: "캠프 천막" — 어두운 올리브 천 판(박음질 테두리), 빨간 명찰 주 버튼, 모래색 보조 버튼, 나무 간판(지금 할 일).
-- 기준: docs/design/19_UI_MAP_STYLE.md — 60 바탕 / 30 보조 / 10 강조(빨강 = 누를 것 하나, 노랑 = 볼 곳).
-- 색만으로 뜻을 주지 않는다(글자·이모지 병기). 56px 터치 영역. 작은 화면은 UIScale 로 줄인다.
-- 움직임: 누름 0.08초 · 창 열기 0.16초 · 닫기 0.1초 · 보상 0.28초. 계속 도는 장식 움직임은 없다.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Palette = require(Shared:WaitForChild("Palette"))
local Signal = require(Shared:WaitForChild("Signal"))

local UiKit = {}
local U = Palette.UI
-- 가운데 창(일지·배치·밤·편지·선택)이 열리고 닫힐 때: HUD 가 큰 버튼을 숨겨 할 일을 하나로 둔다
UiKit.ModalChanged = Signal.new() :: Signal.Signal<>

UiKit.Font = Enum.Font.GothamMedium
UiKit.FontBold = Enum.Font.GothamBold
UiKit.FontBlack = Enum.Font.GothamBlack

local scaledGuis: { ScreenGui } = {}
local function viewportScale(): number
	local cam = workspace.CurrentCamera
	local h = if cam then cam.ViewportSize.Y else 720
	return math.clamp(h / 620, 0.58, 1.0)
end
local function applyScale(gui: ScreenGui)
	local s = gui:FindFirstChild("AutoScale") :: UIScale?
	if not s then
		s = Instance.new("UIScale")
		s.Name = "AutoScale"
		s.Parent = gui
	end
	(s :: UIScale).Scale = viewportScale()
end
do
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			for _, g in ipairs(scaledGuis) do
				applyScale(g)
			end
		end)
	end
end

-- Roblox 위 막대 (2026-10-19 폰 실측: 높이 58, 왼쪽 0~164 는 Roblox 메뉴·채팅 버튼).
-- 우리 화면은 DeviceSafeInsets 라 맨 위부터 그린다 → 가운데·오른쪽 위는 막대 안 빈칸(TopbarInset)이라 써도 되고,
-- 왼쪽 위는 Roblox 버튼과 겹치므로 ⚙ 는 그 버튼 바로 오른쪽, 왼쪽 열 카드는 막대 아래에서 시작한다.
local GuiService = game:GetService("GuiService")
UiKit.LayoutChanged = Signal.new() :: Signal.Signal<>
type Topbar = { leftX: number, height: number, below: number }
-- 값은 이 화면 단위(AutoScale 전 오프셋)
function UiKit.topbar(): Topbar
	local inset = GuiService.TopbarInset
	local h = if inset.Max.Y > 0 then inset.Max.Y else 58
	local s = viewportScale()
	return { leftX = math.ceil(inset.Min.X / s), height = math.ceil(h / s), below = math.ceil(h / s) + 8 }
end
GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
	UiKit.LayoutChanged:Fire()
end)
do
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			UiKit.LayoutChanged:Fire()
		end)
	end
end

function UiKit.screen(name: string, order: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = order
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	applyScale(gui)
	table.insert(scaledGuis, gui)
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function UiKit.corner(parent: GuiObject, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or U.Corner)
	c.Parent = parent
end

function UiKit.pad(parent: GuiObject, px: number?)
	local p = Instance.new("UIPadding")
	local v = UDim.new(0, px or U.Padding)
	p.PaddingTop, p.PaddingBottom, p.PaddingLeft, p.PaddingRight = v, v, v, v
	p.Parent = parent
end

function UiKit.list(parent: GuiObject, dir: Enum.FillDirection?, gap: number?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap or U.Gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = parent
	return l
end

local function gradient(parent: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, top), ColorSequenceKeypoint.new(1, bottom) })
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

-- 위에서 빛: 흰색 → 회색 곱하기. UIGradient 는 그 개체의 배경과 "자기 글자"에 곱해지므로 색은 BackgroundColor3 에 두고
-- 그라데이션은 밝기만 바꾼다 (2026-10-19: 빨강→진빨강 그라데이션이 버튼 글자까지 빨갛게 만들어 "1일차 출발" 이 흐렸다)
local function shade(parent: GuiObject, bottom: number): UIGradient
	return gradient(parent, Color3.new(1, 1, 1), Color3.new(bottom, bottom, bottom))
end

local function stroke(parent: GuiObject, color: Color3, thickness: number, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- 장식은 Folder 아래에 둔다: UIListLayout 항목·AutomaticSize 계산에서 빠져야 하므로 (Studio 2026-10-18: 스케일 크기 장식이 목록에 끼어 패널이 1490px 까지 자람)
local function decoHolder(parent: GuiObject): Folder
	local d = parent:FindFirstChild("Deco")
	if d and d:IsA("Folder") then
		return d
	end
	local nd = Instance.new("Folder")
	nd.Name = "Deco"
	nd.Parent = parent
	return nd
end

-- 박음질: 테두리 안쪽에 점선처럼 보이는 얇은 줄 (천막 느낌)
local function stitch(parent: GuiObject)
	local f = Instance.new("Frame")
	f.Name = "Stitch"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.new(1, -10, 1, -10)
	f.BackgroundTransparency = 1
	f.ZIndex = parent.ZIndex
	UiKit.corner(f, 10)
	local s = stroke(f, Palette.Sand, 1.5, 0.45)
	s.LineJoinMode = Enum.LineJoinMode.Round
	f.Parent = decoHolder(parent)
end

-- ===== 움직임 (짧게, 계속 돌지 않게) =====
local function popScale(frame: GuiObject): UIScale
	local s = frame:FindFirstChild("Pop")
	if s and s:IsA("UIScale") then
		return s
	end
	local ns = Instance.new("UIScale")
	ns.Name = "Pop"
	ns.Parent = frame
	return ns
end
UiKit.popScale = popScale

-- 보상·새 할 일: 작게 → 살짝 크게 → 제자리 (0.28초)
function UiKit.pop(frame: GuiObject, from: number?)
	local s = popScale(frame)
	s.Scale = from or 0.7
	TweenService:Create(s, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- 창 열기: 보일 때마다 0.94 → 1 (0.16초). Visible 이 켜질 때와 화면(ScreenGui)이 켜질 때 둘 다
function UiKit.popOnShow(frame: GuiObject)
	local s = popScale(frame)
	local function play()
		local g = frame:FindFirstAncestorOfClass("ScreenGui")
		if not frame.Visible or (g and not g.Enabled) then
			return
		end
		s.Scale = 0.94
		TweenService:Create(s, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(play)
	task.defer(function()
		local g = frame:FindFirstAncestorOfClass("ScreenGui")
		if g then
			g:GetPropertyChangedSignal("Enabled"):Connect(play)
		end
	end)
end

-- 창 닫기: 0.1초 줄인 뒤 hide() (닫기 버튼에서 쓴다. 상태가 바뀌어 저절로 닫힐 때는 바로 끈다)
function UiKit.closeThen(frame: GuiObject, hide: () -> ())
	local s = popScale(frame)
	local tw =
		TweenService:Create(s, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.94 })
	tw.Completed:Connect(function()
		hide()
		s.Scale = 1
	end)
	tw:Play()
end

-- 가운데 창 목록: 하나라도 열려 있으면 HUD 는 큰 버튼·타일을 숨긴다 (할 일 하나, 가운데 비우기)
local modals: { GuiObject } = {}
function UiKit.registerModal(frame: GuiObject)
	table.insert(modals, frame)
	local function changed()
		UiKit.ModalChanged:Fire()
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(changed)
	task.defer(function()
		local g = frame:FindFirstAncestorOfClass("ScreenGui")
		if g then
			g:GetPropertyChangedSignal("Enabled"):Connect(changed)
		end
	end)
end
function UiKit.anyModalOpen(): boolean
	for _, f in ipairs(modals) do
		local g = f:FindFirstAncestorOfClass("ScreenGui")
		if f.Visible and g and g.Enabled then
			return true
		end
	end
	return false
end

-- 누를 수 있는 것: 올리면 살짝 커지고 누르면 작아진다 (0.08초)
local function pressable(b: GuiButton)
	local scale = Instance.new("UIScale")
	scale.Name = "Press"
	scale.Parent = b
	local function tweenScale(v: number)
		TweenService:Create(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = v })
			:Play()
	end
	b.MouseEnter:Connect(function()
		if b.Active then
			tweenScale(1.03)
		end
	end)
	b.MouseLeave:Connect(function()
		tweenScale(1)
	end)
	b.MouseButton1Down:Connect(function()
		if b.Active then
			tweenScale(0.96)
		end
	end)
	b.MouseButton1Up:Connect(function()
		tweenScale(if b.Active then 1.03 else 1)
	end)
end

-- 버튼 아래 어두운 띠: 눌리는 단추처럼 보이게 (모든 버튼·타일 같은 모양)
local function lip(b: GuiObject, color: Color3)
	local l = Instance.new("Frame")
	l.Name = "Lip"
	l.AnchorPoint = Vector2.new(0.5, 1)
	l.Position = UDim2.new(0.5, 0, 1, -1)
	l.Size = UDim2.new(1, -10, 0, 3)
	l.BackgroundColor3 = color
	l.BackgroundTransparency = 0.25
	l.BorderSizePixel = 0
	UiKit.corner(l, 2)
	l.Parent = b
end

-- 노란 테이프 조각
local function tape(parent: GuiObject, xScale: number, rotation: number, width: number)
	local t = Instance.new("Frame")
	t.Name = "Tape"
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.new(xScale, 0, 0, -4)
	t.Size = UDim2.fromOffset(width, 13)
	t.Rotation = rotation
	t.BackgroundColor3 = Palette.Yellow
	t.BackgroundTransparency = 0.15
	t.BorderSizePixel = 0
	t.ZIndex = parent.ZIndex + 2
	stroke(t, Palette.Ink, 1, 0.7)
	t.Parent = decoHolder(parent)
	return t
end

-- 패널: 어두운 올리브 천 + 박음질 (60 바탕. 테이프는 종이에만)
function UiKit.panel(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = U.PanelTop
	f.BorderSizePixel = 0
	UiKit.corner(f, U.PanelCorner)
	shade(f, 0.66)
	stroke(f, U.PanelLine, 2, 0.05)
	stitch(f)
	f.Parent = parent
	return f
end

-- 밝은 종이 패널 (일지·편지·자막)
function UiKit.paper(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = Palette.Cream
	f.BorderSizePixel = 0
	UiKit.corner(f, U.PanelCorner)
	gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(226, 216, 190))
	stroke(f, Palette.WoodDark, 2, 0.3)
	tape(f, 0.5, 4, 44)
	f.Parent = parent
	return f
end

-- 스크롤 영역 (긴 패널)
function UiKit.scroll(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): ScrollingFrame
	local f = Instance.new("ScrollingFrame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = Palette.Cream
	f.BackgroundTransparency = 0.03
	f.BorderSizePixel = 0
	f.ScrollBarThickness = 8
	f.ScrollBarImageColor3 = Palette.Olive
	f.AutomaticCanvasSize = Enum.AutomaticSize.Y
	f.CanvasSize = UDim2.new(0, 0, 0, 0)
	f.ScrollingDirection = Enum.ScrollingDirection.Y
	UiKit.corner(f, U.PanelCorner)
	gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(226, 216, 190))
	stroke(f, Palette.OliveDark, 2.5, 0.15)
	f.Parent = parent
	return f
end

-- 가운데 뜨는 창: 내용만큼 자라다가 화면 92% 를 넘으면 스크롤
function UiKit.modal(parent: Instance, name: string, width: number): ScrollingFrame
	local f = UiKit.scroll(parent, name, UDim2.fromOffset(width, 0), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local pop = popScale(f)
	local function fit()
		local cam = workspace.CurrentCamera
		local h = if cam then cam.ViewportSize.Y else 720
		-- 여는 움직임(Pop 0.94→1) 중에도 자식 크기는 줄어든 채로 잡히므로 같이 나눈다
		local s = viewportScale() * math.max(pop.Scale, 0.5)
		f.AutomaticSize = Enum.AutomaticSize.None
		-- AutomaticCanvasSize 는 Visible=false 자식까지 세어 창이 내용보다 길어진다 (Studio 2026-10-19: 편지 창 774px) → 보이는 자식만 합산
		local content = 0
		local n = 0
		for _, c in ipairs(f:GetChildren()) do
			if c:IsA("GuiObject") and c.Visible then
				content += c.AbsoluteSize.Y / s
				n += 1
			end
		end
		local list = f:FindFirstChildOfClass("UIListLayout")
		if list and n > 1 then
			content += list.Padding.Offset * (n - 1)
		end
		local padding = f:FindFirstChildOfClass("UIPadding")
		if padding then
			content += padding.PaddingTop.Offset + padding.PaddingBottom.Offset
		end
		if content <= 0 then
			content = f.AbsoluteCanvasSize.Y / s
		end
		local target = math.floor(math.min(content, h * 0.92 / viewportScale()))
		if math.abs(f.Size.Y.Offset - target) > 1 then
			f.Size = UDim2.fromOffset(width, target)
		end
	end
	f:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(fit)
	f.ChildAdded:Connect(function(c)
		if c:IsA("GuiObject") then
			c:GetPropertyChangedSignal("Visible"):Connect(function()
				task.defer(fit)
			end)
		end
		task.defer(fit)
	end)
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	task.defer(fit)
	tape(f, 0.2, -8, 48)
	UiKit.popOnShow(f)
	UiKit.registerModal(f)
	return f
end

-- 나무 간판 (상단 상태 바): 밧줄 두 가닥에 매달린 판자
function UiKit.woodSign(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = Color3.fromRGB(156, 118, 72)
	f.BorderSizePixel = 0
	UiKit.corner(f, U.ButtonCorner)
	shade(f, 0.72)
	stroke(f, Palette.WoodDark, 3, 0)
	for _, x in ipairs({ 0.08, 0.92 }) do
		local r = Instance.new("Frame")
		r.Name = "Rope"
		r.AnchorPoint = Vector2.new(0.5, 1)
		r.Position = UDim2.new(x, 0, 0, 2)
		r.Size = UDim2.fromOffset(3, 40)
		r.BackgroundColor3 = Palette.Rope
		r.BorderSizePixel = 0
		r.ZIndex = f.ZIndex - 1
		r.Parent = decoHolder(f)
	end
	f.Parent = parent
	return f
end

function UiKit.label(parent: Instance, text: string, size: number?, bold: boolean?, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = if bold then UiKit.FontBold else UiKit.Font
	l.TextSize = size or U.BodyText
	l.TextColor3 = color or Palette.Ink
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Size = UDim2.new(1, 0, 0, (size or U.BodyText) + 8)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Parent = parent
	return l
end

-- 버튼: primary = 빨간 명찰(그 화면에서 누를 것 하나), 아니면 모래색 보조 버튼. 모서리·띠·누름 움직임은 같다
function UiKit.button(parent: Instance, text: string, onClick: () -> (), primary: boolean?): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, U.ButtonMin)
	b.Font = UiKit.FontBold
	b.TextSize = U.BodyText
	b.Text = text
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Selectable = true
	UiKit.corner(b, U.ButtonCorner)
	if primary then
		b.BackgroundColor3 = Color3.fromRGB(226, 72, 74)
		b.TextColor3 = Palette.Cream
		shade(b, 0.78)
		stroke(b, Palette.Ink, 2, 0.3)
		b.TextStrokeColor3 = Palette.Ink
		b.TextStrokeTransparency = 0.6
		-- 명찰 핀 2개
		for _, x in ipairs({ 0.06, 0.94 }) do
			local n = Instance.new("Frame")
			n.Name = "Pin"
			n.AnchorPoint = Vector2.new(0.5, 0.5)
			n.Position = UDim2.fromScale(x, 0.5)
			n.Size = UDim2.fromOffset(7, 7)
			n.BackgroundColor3 = Palette.Cream
			n.BackgroundTransparency = 0.3
			n.BorderSizePixel = 0
			UiKit.corner(n, 99)
			n.Parent = b
		end
		lip(b, Color3.fromRGB(110, 22, 26))
	else
		b.BackgroundColor3 = Color3.fromRGB(242, 228, 194)
		b.TextColor3 = Palette.Ink
		shade(b, 0.86)
		stroke(b, Palette.WoodDark, 1.5, 0.35)
		lip(b, Color3.fromRGB(150, 128, 92))
	end
	pressable(b)
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

-- 아이콘 타일 (오른쪽 위): 이모지 + 짧은 이름. 보조 행동만 — 주 행동은 아래 가운데 큰 빨간 버튼 하나
function UiKit.tile(parent: Instance, icon: string, label: string, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(U.Tile + 8, U.Tile + 8)
	b.Text = ""
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Selectable = true
	b.BackgroundColor3 = Color3.fromRGB(242, 228, 194)
	UiKit.corner(b, U.ButtonCorner)
	shade(b, 0.86)
	stroke(b, Palette.WoodDark, 2, 0.25)
	lip(b, Color3.fromRGB(150, 128, 92))
	local ic = Instance.new("TextLabel")
	ic.Name = "Icon"
	ic.BackgroundTransparency = 1
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 6)
	ic.Size = UDim2.new(1, 0, 0, 34)
	ic.Font = UiKit.FontBold
	ic.TextSize = 28
	ic.TextColor3 = Palette.Ink
	ic.Text = icon
	ic.Parent = b
	local lb = Instance.new("TextLabel")
	lb.Name = "Label"
	lb.BackgroundTransparency = 1
	lb.AnchorPoint = Vector2.new(0.5, 1)
	lb.Position = UDim2.new(0.5, 0, 1, -8)
	lb.Size = UDim2.new(1, -4, 0, 16)
	lb.Font = UiKit.FontBold
	lb.TextSize = 14
	lb.TextColor3 = Palette.Ink
	lb.Text = label
	lb.Parent = b
	pressable(b)
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

-- 알약: 작은 정보(기수·배지·⏱). 어두운 바탕 + 크림 글자, 끝까지 둥글게
function UiKit.pill(parent: Instance, name: string, textSize: number?): TextLabel
	local size = textSize or 16
	local l = Instance.new("TextLabel")
	l.Name = name
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, size + 14)
	l.BackgroundColor3 = U.PanelBottom
	l.BackgroundTransparency = 0.1
	l.BorderSizePixel = 0
	l.Font = UiKit.FontBold
	l.TextSize = size
	l.TextColor3 = Palette.Cream
	l.Text = ""
	UiKit.corner(l, 999)
	stroke(l, U.PanelLine, 1.5, 0.1)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 12)
	p.PaddingRight = UDim.new(0, 12)
	p.Parent = l
	l.Parent = parent
	return l
end

function UiKit.setEnabled(b: TextButton, enabled: boolean)
	b.Active = enabled
	b.Selectable = enabled
	b.BackgroundTransparency = if enabled then 0 else 0.5
	b.TextTransparency = if enabled then 0 else 0.45
end

-- 칩: 작은 토글 버튼 (편지·배치). selected 면 빨간 테두리
function UiKit.chip(parent: Instance, text: string, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.AutomaticSize = Enum.AutomaticSize.X
	b.Size = UDim2.fromOffset(0, 40)
	b.Font = UiKit.FontBold
	b.TextSize = U.SmallText
	b.Text = text
	b.TextColor3 = Palette.Ink
	b.BackgroundColor3 = Palette.Cream
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	UiKit.corner(b, 20)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = b
	local s = stroke(b, Palette.WoodDark, 1.5, 0.4)
	s.Name = "ChipStroke"
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

function UiKit.setChipSelected(b: TextButton, selected: boolean)
	local s = b:FindFirstChild("ChipStroke") :: UIStroke?
	if s then
		s.Color = if selected then Palette.Red else Palette.WoodDark
		s.Thickness = if selected then 3 else 1.5
		s.Transparency = if selected then 0 else 0.4
	end
	b.BackgroundColor3 = if selected then Palette.Yellow else Palette.Cream
end

-- 토스트: 오른쪽 위 타일 아래로 밀려 들어온다 (가운데·아래 박자 칸을 가리지 않게). reward 면 톡 튄다
local toastGui: ScreenGui? = nil
local toastLabel: TextLabel? = nil
local toastFrame: Frame? = nil
local toastToken = 0
local TOAST_Y = 176 -- 기수 알약(44) + 타일 줄(80~152) 아래
function UiKit.toast(text: string, seconds: number?, reward: boolean?)
	if not toastGui then
		toastGui = UiKit.screen("CampToast", 50)
		local f = UiKit.paper(
			toastGui :: ScreenGui,
			"Toast",
			UDim2.fromOffset(330, 0),
			UDim2.new(1, -U.Edge, 0, TOAST_Y),
			Vector2.new(1, 0)
		)
		f.AutomaticSize = Enum.AutomaticSize.Y
		UiKit.pad(f, 12)
		toastLabel = UiKit.label(f, text, 18, true)
		toastFrame = f
	end
	local gui = toastGui :: ScreenGui
	local label = toastLabel :: TextLabel
	local f = toastFrame :: Frame
	label.Text = text
	gui.Enabled = true
	f.Position = UDim2.new(1, 40, 0, TOAST_Y)
	TweenService:Create(f, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -U.Edge, 0, TOAST_Y),
	}):Play()
	if reward then
		UiKit.pop(f, 0.8)
	end
	toastToken += 1
	local token = toastToken
	task.delay(seconds or 2.5, function()
		if toastToken == token then
			gui.Enabled = false
		end
	end)
end

UiKit.Palette = Palette
UiKit.gradient = gradient
UiKit.stroke = stroke

return UiKit
