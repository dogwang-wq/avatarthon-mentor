				at(ox + 10 + sx * 1.2, 9.9, -294 - (j - 1) * 9.3),
				Palette.WoodDark,
				Enum.Material.Wood
			)
		end
	end
	deco(
		"D2_Net",
		Vector3.new(10, 0.3, 32),
		at(ox + 10, 1.2, -308),
		Palette.Rope,
		Enum.Material.Fabric,
		{ transparency = 0.35 }
	)
	fall("RopeNet", Vector3.new(ox + 10, 1.5, -308), Vector3.new(14, 2, 32))
	box(
		"D2_RopeLandB",
		"TerrainProps",
		Vector3.new(6, 8, 4),
		at(ox + 10, 4, -325),
		Palette.WoodDark,
		Enum.Material.WoodPlanks
	)
	pad("P2", 2, Vector3.new(ox + 10, 8.5, -325), NZ)
	add({
		id = "D2_RopeDown",
		folder = "TerrainProps",
		class = "WedgePart",
		size = Vector3.new(6, 8, 12),
		cframe = CFrame.new(ox + 10, 4, -333),
