	climbed = { DURI = "헉헉… 혼자 올라왔어", SAN = "됐다.", MIR = "으, 혼자 올라왔어" } :: { [string]: string },
	waveWarn = { L = "왼쪽에서 파도!", R = "오른쪽에서 파도!" } :: { [string]: string },
	seaCheer = { "하나 둘! 하나 둘!", "저기 부표!", "섬이 보인다!" },
	aak = "악!", -- 출발 순간 분대원 셋
	-- 할 일 판 (CampHud): 아이콘 · 한 줄 · 보조 줄 (ride.cue / 매달린 사람)
