      </Properties>
      <Item class="Folder" referent="6203">
        <Properties>
          <string name="Name">Dev</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <Content name="ExplorerIconContent">
            <null>
            </null>
          </Content>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <Color3 name="IconTint">
            <R>0</R>
            <G>0</G>
            <B>0</B>
          </Color3>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
          <UniqueId name="UniqueId">0fc86b07ca8791280ae6671d000003e3</UniqueId>
        </Properties>
        <Item class="ModuleScript" referent="6204">
          <Properties>
            <string name="Name">DevApi</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{2A1BD768-7E39-490C-810D-2E1BAFD47086}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!strict
-- Studio 전용 개발 API. Play 중 명령창/MCP 에서 game.ServerStorage.CampDevApi:Invoke("session") 처럼 쓴다. 운영 서버에는 없다.
--   "session"            현재 세션 요약
--   "startDay", day      그날을 바로 시작 (저장 day 도 맞춤)
--   "finishDay"          지금 날을 건너뛰고 체크포인트 도착 (OBBY 깃발 다 찍은 것으로 · RIDE 도착점 앞 · BUILD 출발). 작전 기록 무효
--   "autohit", on        체력단련장 박자 기구에서 내 자리도 서버가 기대 키를 친다 (혼자 검증용)
--   "train", stationId   체력단련장 기구 시작 (기구 앞에서)
--   "loadout", seatKey, memberId
--   "obby"               자유 스테이지 상태 (깃발·문·발각·탈출 남은 초)
--   "gate"               6일차 사격 문 상태 (맞힌 수·내가 맞힌 수·분대원 다음 사격·표적 HitBy) · "gate","near" 문 앞으로
--   "shot", group, index 표적 하나 맞힘 (내 클릭과 같은 서버 길)
--   "letter", toId, chips, freeText   편지 보내기 (LETTER 상태)
--   "settings", key, value           설정 바꾸기
--   "camp" · "rescue" · "build" · "ride"  각 단계 시험 (아래 설명)
--   "mute", bool · "mockStore" · "save" · "flow", op, choiceId · "tp", Vector3 · "walk", Vector3
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local SessionService = require(script.Parent.Parent.Services.SessionService)
local ProfileStoreService = require(script.Parent.Parent.Services.ProfileStoreService)
local RhythmService = require(script.Parent.Parent.Services.RhythmService)
local BoatService = require(script.Parent.Parent.Services.BoatService)
local CampfireService = require(script.Parent.Parent.Services.CampfireService)
local RescueService = require(script.Parent.Parent.Services.RescueService)
local BoatBuildService = require(script.Parent.Parent.Services.BoatBuildService)
local WelcomeService = require(script.Parent.Parent.Services.WelcomeService)
local RideService = require(script.Parent.Parent.Services.RideService)
local GameConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("GameConfig"))
local BeatPatterns = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("BeatPatterns"))

local DevApi = {}
local autohit: { [number]: RBXScriptConnection } = {}

local function firstSession(): SessionService.Session
	local p = Players:GetPlayers()[1]
	assert(p, "no player")
	local s = SessionService.get(p.UserId)
	assert(s, "no session")
	return s
end

local function summary(s: SessionService.Session): { [string]: any }
	local p = s.handle.profile.progress
	local o = s.obby
	return {
		state = s.state,
		day = s.day,
		highest = p.highestCp,
		resume = p.resumeCp,
		entry = p.entryCount,
		mode = s.handle.mode,
		dirty = s.handle.dirty,
		seats = s.loadout.seats,
		cargo = table.concat(s.loadout.cargo, ","),
		oar = s.loadout.oar,
		-- 균형 측정 (16 §3): 마지막 작전 기록·탈출 남은 초
		lastStage = s.lastStage,
		escapeLeft = if o and o.escapeDeadline then o.escapeDeadline - os.clock() else nil,
		drops = p.drops,
		flashlight = s.flashlight,
		tutorialDone = p.tutorialDone,
		pattern = s.pattern.id,
		bpm = s.beat.bpm,
		stickers = table.concat(p.stickers, ","),
		badges = table.concat(p.badges, ","),
		bestTotal = p.bestTotal, -- 수료 기록 합 (M057 검수: 3일차 없는 목록으로 남는지)
		pos = s.boat.root.Position,
		stats = p.stats,
		trainedDay = p.trainedDay,
		rel = s.rel,
		rec = s.rec,
	}
end

-- 클라이언트 소유 캐릭터를 서버에서 옮기면 되돌아올 수 있다(2026-10-21 2단계: 서버 PivotTo 뒤 88 stud 되돌아감) →
-- 잠깐 서버 소유로 바꿔 놓고 옮긴 뒤 돌려준다
function DevApi.teleport(ch: Model, cf: CFrame)
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	local player = Players:GetPlayerFromCharacter(ch)
	if hrp and hrp:IsA("BasePart") and player then
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
		ch:PivotTo(cf)
		task.delay(0.4, function()
			if hrp.Parent and player.Parent then
				pcall(function()
					hrp:SetNetworkOwner(player)
				end)
			end
		end)
	else
		ch:PivotTo(cf)
	end
end

function DevApi.install()
	assert(RunService:IsStudio(), "DevApi is Studio-only")
	local existing = ServerStorage:FindFirstChild("CampDevApi")
	if existing then
		existing:Destroy()
	end
	local bf = Instance.new("BindableFunction")
	bf.Name = "CampDevApi"
	bf.OnInvoke = function(cmd: string, ...: any)
		local args = { ... }
		if cmd == "session" then
			return summary(firstSession())
		elseif cmd == "startDay" then
			local s = firstSession()
			local day = tonumber(args[1]) or 1
			s.handle.profile.progress.day = day - 1
			SessionService.startDay(s, day)
			return summary(s)
		elseif cmd == "finishDay" then
			-- 지금 날 건너뛰기 (작전 기록 무효): OBBY 깃발 다 찍은 것으로 도착 · RIDE 도착점 앞 · BUILD 출발
			local s = firstSession()
			s.timingInvalid = true
			if s.state == "OBBY" then
				SessionService.devArrive(s)
			elseif s.state == "RIDE" and s.ride then
				RideService.devSeek(s.ride, s.ride.finishS - 14)
			elseif s.state == "BUILD" then
				BoatBuildService.go(s, false)
			end
			return summary(s)
		elseif cmd == "autohit" then
			-- 체력단련장 박자 기구: 박자마다 기대 키를 서버가 대신 누른다 (REST 는 안 누름)
			local s = firstSession()
			local on = args[1] ~= false
			if autohit[s.userId] then
				autohit[s.userId]:Disconnect()
				autohit[s.userId] = nil
			end
			if on then
				local lastBeat = -1
				autohit[s.userId] = RunService.Heartbeat:Connect(function()
					local b = RhythmService.currentBeat(s.beat)
					if b ~= lastBeat then
						lastBeat = b
						local expected = BeatPatterns.expected(s.pattern, b)
						if expected ~= "REST" then
							SessionService.handleBeat(s, workspace:GetServerTimeNow(), expected)
						end
					end
				end)
			end
			return on
		elseif cmd == "gate" then
			-- 6일차 사격 문 (6단계): "gate" 상태 · "gate","near", id? 그 문 앞(분대원이 서는 쪽)으로 순간이동
			local s = firstSession()
			local o = s.obby
			if not o then
				return { state = s.state, obby = false }
			end
			if args[1] == "near" then
				for id, g in pairs(o.gates) do
					if args[2] == nil or args[2] == id then
						-- 표적 가운데를 보며 문 앞 12 에 선다 (사격 시험·캡처용)
						local sum, n = Vector3.zero, 0
						for _, d in ipairs(workspace:GetDescendants()) do
							if
								d:IsA("BasePart")
								and d:GetAttribute("Kind") == "TARGET"
								and d:GetAttribute("Group") == g.group
							then
								sum += d.Position
								n += 1
							end
						end
						local aim = if n > 0 then sum / n else g.part.Position
						local look = g.part.CFrame.LookVector
						local at = g.part.Position - look * 12
						local ch = s.player.Character
						if ch then
							DevApi.teleport(ch, CFrame.lookAt(Vector3.new(at.X, 4, at.Z), Vector3.new(aim.X, 4, aim.Z)))
						end
						return { id = id, at = at }
					end
				end
				return "no gate"
			end
			local out = {}
			for id, g in pairs(o.gates) do
				local holes = {}
				for _, d in ipairs(workspace:GetDescendants()) do
					if
						d:IsA("BasePart")
						and d:GetAttribute("Kind") == "TARGET"
						and d:GetAttribute("Group") == g.group
					then
						table.insert(
							holes,
							string.format(
								"%s:%s%s",
								tostring(d:GetAttribute("TargetIndex")),
								tostring(d:GetAttribute("HitBy") or "-"),
								if d:GetAttribute("Up") == true then "↑" else "↓"
							)
						)
					end
				end
				out[id] = {
					group = g.group,
					hits = g.hits,
					need = g.need,
					mine = g.mine,
					open = g.open,
					targets = table.concat(holes, " "),
				}
			end
			local nexts = {}
			for mid, t in pairs(o.gateSquadNext) do
				table.insert(nexts, string.format("%s %.1f", mid, t - os.clock()))
			end
			return {
				gates = out,
				gateAt = o.gateAt,
				squadNext = table.concat(nexts, " · "),
				recGateMine = s.rec.gateMine,
			}
		elseif cmd == "loadout" then
			local s = firstSession()
			SessionService.handleLoadout(s, "dev", "SEAT", { seatKey = args[1], memberId = args[2] })
			return summary(s)
		elseif cmd == "obby" then
			-- 자유 스테이지 상태 (발판 번호·추락·산 대기·깃발·문)
			local s = firstSession()
			local o = s.obby
			local san = s.members.SAN
			local gates = {}
			if o then
				for id, g in pairs(o.gates) do
					table.insert(
						gates,
						string.format("%s(%s %d/%d %s)", id, g.group, g.hits, g.need, if g.open then "OPEN" else "shut")
					)
				end
			end
			local ch = s.player.Character
			return {
				state = s.state,
				padIdx = if o then o.padIdx else nil,
				falls = if o then o.falls else nil,
				bellRung = if o then o.bellRung else nil,
				sanWaiting = if san then san.waiting else nil,
				-- 자유 스테이지 (22 v2)
				flags = if o then o.flagsDone else nil,
				need = if o then o.flagsNeed else nil,
				gates = table.concat(gates, ","),
				spotCount = if o then o.spotCount else nil,
				escapeLeft = if o and o.escapeDeadline then o.escapeDeadline - os.clock() else nil,
				respawn = if o then o.respawn else nil,
				me = if ch then ch:GetPivot().Position else nil,
				boat = s.boat.root.Position,
			}
		elseif cmd == "letter" then
			-- 편지 보내기: "letter", toId, {chipId...}, freeText?
			local s = firstSession()
			SessionService.handleLetter(s, "dev", args[1], args[2], args[3])
			local r = summary(s)
			r.letterDone = s.letterDone
			r.letters = #s.handle.profile.progress.letters
			return r
		elseif cmd == "settings" then
			-- "settings", key, value
			local s = firstSession()
			SessionService.handleSettings(s, "dev", args[1], args[2])
			return s.handle.profile.settings
		elseif cmd == "train" then
			-- 체력단련장 미니게임 시작 (기구 앞에 있어야 함). 끝내려면 "flow","TRAIN_STOP"
			local s = firstSession()
			SessionService.handleFlow(s, "dev", "TRAIN_START", tostring(args[1] or "PULLUP"))
			return summary(s)
		elseif cmd == "setRun" then
			-- 이번 입소 작전 기록을 직접 넣기 (수료 기록판 시험용, Studio 전용): "setRun", { ["1"]=cs, ... }
			local s = firstSession()
			local p = s.handle.profile.progress
			if typeof(args[1]) == "table" then
				for k, v in pairs(args[1]) do
					p.runTimes[tostring(k)] = tonumber(v)
				end
			end
			return p.runTimes
		elseif cmd == "stats" then
			-- 능력치 직접 넣기 (균형 측정용, Studio 전용): "stats", { strength=, speed=, stamina=, aim= }
			local s = firstSession()
			local st = s.handle.profile.progress.stats
			if typeof(args[1]) == "table" then
				for _, k in ipairs({ "strength", "speed", "stamina", "aim" }) do
					local v = tonumber(args[1][k])
					if v then
						(st :: any)[k] = math.clamp(math.floor(v), 0, 99)
					end
				end
			end
			return st
		elseif cmd == "letterChips" then
			-- 지금 기록으로 만들어지는 퇴소 편지 칩 (Studio 확인용)
			local out = {}
			for _, c in ipairs(SessionService.letterChips(firstSession())) do
				table.insert(out, c.id .. "=" .. c.label)
			end
			return table.concat(out, " | ")
		elseif cmd == "shot" then
			-- 표적 하나 맞힘 (group, index) — 자유 스테이지 사격 문(22 v2) 서버 판정 시험용
			local s = firstSession()
			SessionService.handleRangeShot(s, tostring(args[1] or "GATE"), tonumber(args[2]) or 1)
			return summary(s)
		elseif cmd == "boat" then
			-- 유보트 선체 어긋남(0 에 가까워야) · 모드 · Root 위치 (2026-10-20 선체 분리 버그 검증용)
			local s = firstSession()
			return {
				drift = BoatService.hullDrift(s.boat),
				mode = s.boat.mode,
				root = s.boat.root.Position,
			}
		elseif cmd == "resetChar" then
			-- 캐릭터 리셋(죽음 → 리스폰): 유보트에 붙은 채 리스폰돼도 선체가 안 갈라지는지 시험
			local s = firstSession()
			local ch = s.player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
			end
			return summary(s)
		elseif cmd == "mute" then
			workspace:SetAttribute("Camp_DevMute", args[1] ~= false)
			return workspace:GetAttribute("Camp_DevMute")
		elseif cmd == "mockStore" then
			ProfileStoreService.setStore(ProfileStoreService.newMockStore())
			return "mock store set (새 플레이어부터 적용)"
		elseif cmd == "save" then
			local s = firstSession()
			return ProfileStoreService.save(s.handle, false)
		elseif cmd == "flow" then
			local s = firstSession()
			SessionService.handleFlow(s, "dev", args[1], args[2])
			return summary(s)
		elseif cmd == "camp" then
			-- 모닥불 허브 (1단계) 시험용:
			--   "camp"                       상태(주운 것·불 크기·프롬프트·분대원 역할·줍기 수)
			--   "camp","wood"|"water", n     주머니 직접 채우기
			--   "camp","feed"                E 넣기        "camp","give", memberId   E 나누기
			--   "camp","sit", memberId       앉기(그 사람 이야기)  "camp","pick", pickId    줍기(서버 판정만, 거리 무관)
			--   "camp","near"                내 자리에서 가까운 오늘 줍을 것   "camp","goto", pickId   그 옆으로 순간이동 (프롬프트 E 시험)
			--   "camp","seat", memberId      그 사람 통나무 의자 위로 순간이동 (Seat 에 닿아 앉는다)
			local s = firstSession()
			local sub = args[1]
			if sub == "wood" or sub == "water" then
				CampfireService.devSet(s, sub, tonumber(args[2]) or 0)
			elseif sub == "feed" then
				return { ok = CampfireService.feed(s), camp = CampfireService.debug(s) }
			elseif sub == "give" then
				return { ok = CampfireService.give(s, tostring(args[2] or "DURI")), camp = CampfireService.debug(s) }
			elseif sub == "sit" then
				return { ok = CampfireService.sit(s, tostring(args[2] or "DURI")), camp = CampfireService.debug(s) }
			elseif sub == "pick" then
				return { ok = CampfireService.pick(s, tostring(args[2] or "")), camp = CampfireService.debug(s) }
			elseif sub == "near" then
				local ch = s.player.Character
				local pos = if ch then ch:GetPivot().Position else Vector3.zero
				local out = {}
				for i, p in ipairs(CampfireService.pickupsNear(pos, s.day)) do
					if i > 8 then
						break
					end
					table.insert(out, string.format("%s %.0f%s", p.id, p.d, if p.taken then " (taken)" else ""))
				end
				return table.concat(out, " | ")
			elseif sub == "goto" then
				local ch = s.player.Character
				local list = CampfireService.pickupsNear(Vector3.zero, nil)
				for _, p in ipairs(list) do
					if p.id == args[2] and ch then
						local trig = workspace:FindFirstChild(p.id, true) -- 트리거 파트 (이름 = PickId)
						if trig and trig:IsA("BasePart") then
							local tp = trig.Position
							ch:PivotTo(CFrame.lookAt(tp + Vector3.new(3, 2.5, 0), tp))
							return tp
						end
					end
				end
				return "no pickup " .. tostring(args[2])
			elseif sub == "seat" then
				local ch = s.player.Character
				local sp = CampfireService.seatPosition(s, tostring(args[2] or "DURI"))
				if ch and sp then
					ch:PivotTo(CFrame.new(sp + Vector3.new(0, 2.2, 0)))
					return sp
				end
				return "no seat"
			end
			local out = CampfireService.debug(s)
			local j = s.handle.profile.progress.journal
			out.journalLast = if j[#j] then j[#j].day .. " · " .. j[#j].text else nil
			out.recFireFed = s.rec.fireFed
			out.recGaveTo = s.rec.gaveTo
			return out
		elseif cmd == "rescue" then
			-- 살리기 (2단계) 시험용 (OBBY 상태에서):
			--   "rescue"                      상태(넘어진·언 사람, 내 얼음, 남은 넘어짐, 오늘 살린 사람)
			--   "rescue","fall", memberId?    분대원 넘어뜨리기 (나→다음 깃발 사이)   "rescue","revive"   E 일으키기 (거리 무관)
			--   "rescue","freezeMe"           나 얼음 (분대원이 달려와 땡)            "rescue","freeze", memberId?   분대원 얼음
			--   "rescue","thaw"               E 풀어 주기 (거리 무관)                 "rescue","near"     넘어진/언 사람 옆으로 순간이동 (진짜 E 시험)
			local s = firstSession()
			local sub = args[1]
			if sub == "fall" then
				return { ok = RescueService.fall(s, args[2]), rescue = RescueService.debug(s) }
			elseif sub == "revive" then
				return { ok = RescueService.revive(s, true), rescue = RescueService.debug(s) }
			elseif sub == "freezeMe" then
				return { ok = RescueService.freezeMe(s, nil), rescue = RescueService.debug(s) }
			elseif sub == "freeze" then
				return { ok = RescueService.freezeNpc(s, args[2]), rescue = RescueService.debug(s) }
			elseif sub == "thaw" then
				return { ok = RescueService.thaw(s, true), rescue = RescueService.debug(s) }
			elseif sub == "near" then
				local ch = s.player.Character
				local tp = RescueService.targetPosition(s)
				if ch and tp then
					DevApi.teleport(ch, CFrame.lookAt(tp + Vector3.new(3, 2.5, 0), tp))
					return tp
				end
				return "no one down/frozen"
			end
			return RescueService.debug(s)
		elseif cmd == "welcome" then
			-- 첫 1분 (28 §7): 단계(WAIT_CHAR/INTRO/AK/AK_SAID/RUN/THERE/NONE)·들어와서 몇 초·마당에 닿은 초·입구 상자 안인가
			local s = firstSession()
			local d = WelcomeService.debug(s)
			d.state = s.state
			return d
		elseif cmd == "build" then
			-- 유보트 꾸미기 (3단계) 시험용 (BUILD 상태에서):
			--   "build"                       상태(든 것·짐·노·자리·분대원 내밀기 단계·켜진 프롬프트)
			--   "build","pick", partType      더미에서 집기 (서버 판정만, 거리 무관)      "build","attach"   유보트에 싣기/붙이기/빼기
			--   "build","seat", key           자리 발판 (FL/FR/BL/BR)                       "build","accept", memberId   내민 것 받기
			--   "build","go"                  출발!                                         "build","auto"     교관 "출발!" (시간 다 됨)
			--   "build","goto", what          더미(PartType)·발판(FL..)·분대원(DURI..)·"BOAT" 옆으로 순간이동 (진짜 E 시험)
			--   "build","cfg", key, value     GameConfig.Build 값 바꾸기 (예: "AutoDepartSec", 8)
			--   "build","replay"              밤 "한 번 더" 처럼 1일차 꾸미기를 다시 (지난번 판)   "build","flip", bool   유보트 뒤집기(뱃머리 깃발 숨김)
			local s = firstSession()
			local sub = args[1]
			if sub == "pick" then
				return { ok = BoatBuildService.pick(s, tostring(args[2] or "")), build = BoatBuildService.debug(s) }
			elseif sub == "attach" then
				return { ok = BoatBuildService.attach(s), build = BoatBuildService.debug(s) }
			elseif sub == "seat" then
				return { ok = BoatBuildService.seat(s, tostring(args[2] or "")), build = BoatBuildService.debug(s) }
			elseif sub == "accept" then
				return {
					ok = BoatBuildService.accept(s, tostring(args[2] or "DURI")),
					build = BoatBuildService.debug(s),
				}
			elseif sub == "go" or sub == "auto" then
				local ok = BoatBuildService.go(s, sub == "auto")
				local r = summary(s)
				r.ok = ok
				r.loadoutDay1 = s.handle.profile.progress.loadoutByDay["1"]
				return r
			elseif sub == "goto" then
				local ch = s.player.Character
				local spot = BoatBuildService.spotOf(s, tostring(args[2] or "BOAT"))
				if ch and spot then
					local from = spot + Vector3.new(0, 0, 2.5)
					DevApi.teleport(ch, CFrame.lookAt(from + Vector3.new(0, 3, 0), spot + Vector3.new(0, 3, 0)))
					return spot
				end
				return "no spot " .. tostring(args[2])
			elseif sub == "replay" then
				-- 밤 "🔁 한 번 더" 와 같은 길: 직전 1일차 배치를 "지난번" 으로 두고 1일차(꾸미기)를 다시 (지난번 판 시험)
				local p = s.handle.profile.progress
				local before = p.loadoutByDay["1"] or s.loadout
				s.lastAttempt = {
					seats = table.clone(before.seats),
					cargo = table.clone(before.cargo),
					oar = before.oar,
					revision = before.revision,
				}
				p.day = 0
				SessionService.startDay(s, 1)
				task.wait(0.5)
				return BoatBuildService.debug(s)
			elseif sub == "flip" then
				-- 밤처럼 유보트를 뒤집어 본다 (뱃머리 깃발 숨김 확인): "build","flip", true|false
				BoatService.setMode(s.boat, if args[2] == false then "PARK" else "FLIP")
				local f = s.boat.model:FindFirstChild("BowFlag")
				local t = {}
				if f then
					for _, c in ipairs(f:GetChildren()) do
						if c:IsA("BasePart") then
							table.insert(t, c.Name .. "=" .. c.Transparency)
						end
					end
				end
				return table.concat(t, ",")
			elseif sub == "cfg" then
				local key = tostring(args[2])
				local B = GameConfig.Build :: any
				if B[key] ~= nil and typeof(args[3]) == typeof(B[key]) then
					B[key] = args[3]
				end
				return B[key]
			end
			return BoatBuildService.debug(s)
		elseif cmd == "ride" then
			-- 탑승 (4·5단계) 시험용 (RIDE 상태에서):
			--   "ride"                        view + 상세(단계·s·속도·기울기·사람별 상태·장애물·사건 수)
			--   "ride","fall", who            그 사람을 지금 빠뜨린다 (ME | DURI | SAN | MIR)
			--   "ride","move", bool           바다: 앞으로(W) 누르고 있기 on/off
			--   "ride","finish"               도착점 앞으로 건너뛰기 (작전 기록 무효)   "ride","seek", s   그 거리로 건너뛰기
			--   "ride","near", x?, z?         갑판 그 자리(기본 꼬리 0,5.2)로 나를 옮김 — 매달린 사람 프롬프트 안 (진짜 E 시험)
			--   "ride","cfg", key, value      GameConfig.Ride 값 바꾸기 (예: "DebugAttrs", true)
			--   "ride","bot", mode            급류 2차 검증 봇 IDLE|LEAD|ITEMS (nil 이면 끔)   "ride","items"  줍기 상태
			local s = firstSession()
			local h = s.ride
			local sub = args[1]
			if sub == "cfg" then
				local key = tostring(args[2])
				local R = GameConfig.Ride :: any
				if R[key] ~= nil and typeof(args[3]) == typeof(R[key]) then
					R[key] = args[3]
				end
				return R[key]
			end
			if not h then
				return { ride = false, state = s.state, rideLog = s.rideLog }
			end
			if sub == "fall" then
				return { ok = RideService.devFall(h, tostring(args[2] or "DURI")), view = RideService.view(h) }
			elseif sub == "move" then
				RideService.setMove(h, args[2] ~= false)
				return RideService.view(h)
			elseif sub == "finish" or sub == "seek" then
				s.timingInvalid = true
				local target = if sub == "finish" then h.finishS - 14 else (tonumber(args[2]) or h.s)
				RideService.devSeek(h, target)
				return RideService.debug(h)
			elseif sub == "bot" then
				-- 급류 2차 검증 봇: "ride","bot", "IDLE"|"LEAD"|"ITEMS"|nil — 서버 MoveTo 로 갑판 위를 걷는다 (사람 손 아님)
				RideService.devBot(h, if typeof(args[2]) == "string" then args[2] else nil)
				return RideService.view(h)
			elseif sub == "items" then
				return RideService.devItems(h)
			elseif sub == "near" then
				-- 갑판 꼬리 (z 5.2, 난간 안) — 꼬리 밧줄에 매달린 사람(z 9.9)까지 5 안쪽
				return RideService.devPlaceMe(h, tonumber(args[2]) or 0, tonumber(args[3]) or 5.2)
			end
			local out = RideService.debug(h)
			out.view = RideService.view(h)
			out.pullLog = h.pullLog
			return out
		elseif cmd == "tp" then
			-- 내 캐릭터 순간이동 (봇 시험용): "tp", Vector3 (또는 x, y, z)
			local s = firstSession()
			local ch = s.player.Character
			local v = args[1]
			local pos = if typeof(v) == "Vector3"
				then v
				else Vector3.new(tonumber(args[1]) or 0, tonumber(args[2]) or 5, tonumber(args[3]) or 0)
			if ch then
				DevApi.teleport(ch, CFrame.new(pos))
			end
			return pos
		elseif cmd == "walk" then
			-- 내 캐릭터 걷기 (봇 시험용, 서버 MoveTo): "walk", Vector3
			local s = firstSession()
			local ch = s.player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local v = args[1]
			if hum and typeof(v) == "Vector3" then
				hum:MoveTo(v)
				return v
			end
			return "no humanoid"
		end
		return "unknown: " .. tostring(cmd)
	end
	bf.Parent = ServerStorage
end

return DevApi
]]></string>
