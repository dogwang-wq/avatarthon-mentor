	shelter("D2_Shelter", ox + 140, -518, "2")
	cp("CP2", 2, Vector3.new(ox + 140, 4, -506), NZ, Vector3.new(16, 8, 10))
	-- 2박 모닥불 허브 (1단계): 쉼터 서쪽, 벽 깃발 고리(남쪽 -502)와 벤치(x≥191) 사이
	fireRing("D2_Fire", ox + 125, -511, false, { day = 2, angles = { 45, 135, 225, 315 } })
	-- 2일차 줍기: 발판 옆 4 + 물통 1 + 모닥불 옆 2 (추락 영역 RopeNet x63~77 · Steps x89~131 밖)
	pickup("CF_W_D2_1", 2, "WOOD", ox - 6, -276, 30)
	pickup("CF_W_D2_2", 2, "WOOD", ox + 24, -348, -15)
	pickup("CF_W_D2_3", 2, "WOOD", ox + 80, -347, 40)
	pickup("CF_WT_D2", 2, "WATER", ox + 95, -386, 0)
	pickup("CF_W_D2_4", 2, "WOOD", ox + 116, -426, 60)
	pickup("CF_W_D2_F1", 2, "WOOD", ox + 119, -519, 15)
	pickup("CF_W_D2_F2", 2, "WOOD", ox + 118, -504, -40)
	for i, p in ipairs({
